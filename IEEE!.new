     <td>4378.450510</td>\n      <td>1292.903741</td>\n      <td>5626.493019</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>D7_I10_W</td>\n      <td>114.450388</td>\n      <td>105.183635</td>\n      <td>120.603586</td>\n      <td>4564.275888</td>\n      <td>1138.010041</td>\n      <td>6030.708311</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>D7_I210_E</td>\n      <td>113.490001</td>\n      <td>109.812137</td>\n      <td>117.085902</td>\n      <td>3857.303930</td>\n      <td>842.063137</td>\n      <td>4655.466873</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>D7_I210_W</td>\n      <td>115.183684</td>\n      <td>103.811126</td>\n      <td>120.750000</td>\n      <td>3856.450590</td>\n      <td>926.472133</td>\n      <td>4825.130529</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>D7_I405_N</td>\n      <td>113.014220</td>\n      <td>76.277838</td>\n      <td>116.507271</td>\n      <td>5007.131872</td>\n      <td>1228.163295</td>\n      <td>6605.267412</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>D7_I405_S</td>\n      <td>112.846949</td>\n      <td>105.336953</td>\n      <td>118.777709</td>\n      <td>4925.524393</td>\n      <td>1189.321738</td>\n      <td>6148.549656</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nEDA summaries saved under /kaggle/working/\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nCORRIDORS_ROOT = DATA_ROOT / \"corridors\"\n\ncorridors = sorted(\n    p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir()\n)\n\n# Target a reproducible sample across all weekdays.\nDAYS_PER_WEEKDAY = 2\nsample_frames = []\nsampling_audit = []\n\nfor panel in corridors:\n    mainline_dir = CORRIDORS_ROOT / panel / \"train\" / \"mainline_states\"\n    files = sorted(mainline_dir.rglob(\"*.parquet\"))\n\n    if not files:\n        print(f\"No mainline files found for {panel}\")\n        continue\n\n    # Read the actual date from each file's timestamp.\n    # Do not infer dates from filenames.\n    file_dates = []\n\n    for file_path in files:\n        date_values = pd.read_parquet(\n            file_path, columns=[\"timestamp\"]\n        )[\"timestamp\"]\n\n        timestamps = pd.to_datetime(\n            date_values, utc=True, errors=\"coerce\"\n        ).dropna()\n\n        if timestamps.empty:\n            continue\n\n        unique_dates = timestamps.dt.strftime(\"%Y-%m-%d\").unique()\n\n        if len(unique_dates) != 1:\n            print(\n                f\"Skipping file with multiple UTC dates: {file_path}\"\n            )\n            continue\n\n        file_dates.append((file_path, unique_dates[0]))\n\n    date_map = pd.DataFrame(file_dates, columns=[\"file_path\", \"date\"])\n    date_map[\"date\"] = pd.to_datetime(date_map[\"date\"], errors=\"raise\")\n    date_map = date_map.drop_duplicates(subset=[\"date\"]).sort_values(\"date\")\n    date_map[\"weekday\"] = date_map[\"date\"].dt.day_name()\n\n    # Select up to two dates per weekday, spread across that weekday's\n    # available dates. Actual coverage is reported below.\n    selected = []\n\n    for weekday_name, group in date_map.groupby(\"weekday\", sort=False):\n        group = group.sort_values(\"date\")\n        n = min(DAYS_PER_WEEKDAY, len(group))\n\n        positions = np.linspace(0, len(group) - 1, n, dtype=int)\n        selected.extend(group.iloc[positions].to_dict(\"records\"))\n\n    selected_df = pd.DataFrame(selected).sort_values(\"date\")\n\n    sampling_audit.append({\n        \"panel\": panel,\n        \"available_dates\": len(date_map),\n        \"selected_dates\": len(selected_df),\n        \"selected_weekdays\": \", \".join(\n            sorted(selected_df[\"weekday\"].unique())\n        ),\n        \"weekday_counts\": selected_df[\"weekday\"].value_counts().to_dict(),\n    })\n\n    for row in selected_df.itertuples(index=False):\n        df = pd.read_parquet(\n            row.file_path,\n            columns=[\n                \"timestamp\", \"speed_kmh\", \"flow_vph\",\n                \"is_score_eligible\"\n            ],\n        )\n        df[\"panel\"] = panel\n        sample_frames.append(df)\n\nif not sample_frames:\n    raise RuntimeError(\"No valid daily files were sampled.\")\n\neda_sample = pd.concat(sample_frames, ignore_index=True)\n\neda_sample[\"timestamp\"] = pd.to_datetime(\n    eda_sample[\"timestamp\"], utc=True, errors=\"coerce\"\n)\neda_sample = eda_sample.dropna(subset=[\"timestamp\"])\n\neda_sample[\"hour_utc\"] = eda_sample[\"timestamp\"].dt.hour\neda_sample[\"weekday_utc\"] = eda_sample[\"timestamp\"].dt.day_name()\n\nvalid = eda_sample.dropna(\n    subset=[\"speed_kmh\", \"flow_vph\"]\n).copy()\n\nprint(\"Sample rows:\", len(eda_sample))\nprint(\"Rows with speed and flow available:\", len(valid))\nprint(\"Panels represented:\", valid[\"panel\"].nunique())\n\nprint(\"\\n1. Sampling coverage by corridor\")\nsampling_audit_df = pd.DataFrame(sampling_audit)\ndisplay(sampling_audit_df)\n\nprint(\"\\n2. Actual weekday coverage in sampled traffic rows\")\nweekday_coverage = (\n    eda_sample.groupby([\"panel\", \"weekday_utc\"])\n    .size()\n    .rename(\"row_count\")\n    .reset_index()\n)\ndisplay(weekday_coverage)\n\nprint(\"\\n3. Average traffic by hour and corridor\")\nhourly = (\n    valid.groupby([\"panel\", \"hour_utc\"], as_index=False)\n    .agg(\n        mean_speed_kmh=(\"speed_kmh\", \"mean\"),\n        median_speed_kmh=(\"speed_kmh\", \"median\"),\n        mean_flow_vph=(\"flow_vph\", \"mean\"),\n        row_count=(\"speed_kmh\", \"size\"),\n    )\n)\ndisplay(hourly)\n\nprint(\"\\n4. Average traffic by weekday and corridor\")\nweekday_order = [\n    \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\",\n    \"Friday\", \"Saturday\", \"Sunday\"\n]\n\nweekday = (\n    valid.groupby([\"panel\", \"weekday_utc\"], as_index=False)\n    .agg(\n        mean_speed_kmh=(\"speed_kmh\", \"mean\"),\n        median_speed_kmh=(\"speed_kmh\", \"median\"),\n        mean_flow_vph=(\"flow_vph\", \"mean\"),\n        row_count=(\"speed_kmh\", \"size\"),\n    )\n)\n\nweekday[\"weekday_utc\"] = pd.Categorical(\n    weekday[\"weekday_utc\"],\n    categories=weekday_order,\n    ordered=True,\n)\nweekday = weekday.sort_values([\"panel\", \"weekday_utc\"])\ndisplay(weekday)\n\n# Save updated summaries and the sampling audit.\nhourly.to_csv(\"/kaggle/working/task1_eda_hourly.csv\", index=False)\nweekday.to_csv(\"/kaggle/working/task1_eda_weekday.csv\", index=False)\nsampling_audit_df.to_csv(\n    \"/kaggle/working/task1_eda_sampling_audit.csv\", index=False\n)\nweekday_coverage.to_csv(\n    \"/kaggle/working/task1_eda_weekday_coverage.csv\", index=False\n)\n\nprint(\"\\nSaved updated hourly, weekday, sampling-audit, \"\n      \"and weekday-coverage CSV files.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:42:56.884141Z","iopub.execute_input":"2026-10-19T19:42:56.884548Z","iopub.status.idle":"2026-10-19T19:56:51.358521Z","shell.execute_reply.started":"2026-10-19T19:42:56.884516Z","shell.execute_reply":"2026-10-19T19:56:51.357437Z"}},"outputs":[{"name":"stdout","text":"Sample rows: 6382656\nRows with speed and flow available: 5326604\nPanels represented: 10\n\n1. Sampling coverage by corridor\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"        panel  available_dates  selected_dates  \\\n0  D12_I405_N              273              14   \n1  D12_I405_S              273              14   \n2    D12_I5_N              273              14   \n3    D12_I5_S              273              14   \n4    D7_I10_E              273              14   \n5    D7_I10_W              273              14   \n6   D7_I210_E              273              14   \n7   D7_I210_W              273              14   \n8   D7_I405_N 