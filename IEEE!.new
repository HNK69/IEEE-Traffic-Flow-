/train\nsample_submission_state.csv | 114.620 MB\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D12_I405_N\"\nTRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\nTEMPLATE_PATH = (\n    DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n)\n\n# Pick one existing Parquet file from each source.\nsource_dirs = {\n    \"unmasked_mainline\": TRAIN_ROOT / \"mainline_states\",\n    \"masked_mainline_R1\": TRAIN_ROOT / \"mainline_states_masked\" / \"mask_regime=R1\",\n    \"ramp_states\": TRAIN_ROOT / \"ramp_states\",\n}\n\nfor source_name, source_dir in source_dirs.items():\n    if not source_dir.is_dir():\n        print(f\"\\n{source_name}: directory not found: {source_dir}\")\n        continue\n\n    parquet_files = sorted(source_dir.rglob(\"*.parquet\"))\n\n    print(f\"\\n{'=' * 70}\")\n    print(f\"SOURCE: {source_name}\")\n    print(f\"Directory: {source_dir}\")\n    print(f\"Parquet files found: {len(parquet_files)}\")\n\n    if not parquet_files:\n        continue\n\n    sample_path = parquet_files[0]\n    print(f\"Sample file: {sample_path.relative_to(DATA_ROOT)}\")\n\n    # Read a small number of rows, not the whole file.\n    sample_df = pd.read_parquet(sample_path).head(5)\n\n    print(\"\\nColumn names:\")\n    print(sample_df.columns.tolist())\n\n    print(\"\\nData types:\")\n    print(sample_df.dtypes.to_string())\n\n    print(\"\\nFirst 5 rows:\")\n    display(sample_df)\n\n# Inspect only a few rows of the Task 1 target template.\nprint(f\"\\n{'=' * 70}\")\nprint(\"TASK 1 SUBMISSION TEMPLATE\")\nprint(f\"Path: {TEMPLATE_PATH}\")\n\nif not TEMPLATE_PATH.is_file():\n    raise FileNotFoundError(f\"Template not found: {TEMPLATE_PATH}\")\n\ntemplate_sample = pd.read_csv(TEMPLATE_PATH, nrows=5)\n\nprint(\"\\nTemplate columns:\")\nprint(template_sample.columns.tolist())\n\nprint(\"\\nTemplate data types:\")\nprint(template_sample.dtypes.to_string())\n\nprint(\"\\nFirst 5 template rows:\")\ndisplay(template_sample)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:28:11.864489Z","iopub.execute_input":"2026-10-19T18:28:11.865402Z","iopub.status.idle":"2026-10-19T18:28:12.557912Z","shell.execute_reply.started":"2026-10-19T18:28:11.865364Z","shell.execute_reply":"2026-10-19T18:28:12.556865Z"}},"outputs":[{"name":"stdout","text":"\n======================================================================\nSOURCE: unmasked_mainline\nDirectory: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D12_I405_N/train/mainline_states\nParquet files found: 273\nSample file: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_01.parquet\n\nColumn names:\n['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n\nData types:\ncorridor_id                   object\ndate                          object\ntimestamp                     object\nstation_id                    object\nlink_id                       object\nmilepost                     float64\ndirection                     object\nspeed_kmh                    float64\nflow_vph                     float64\noccupancy                    float64\ndensity_occ_linear_vehpkm    float64\npct_observed                   int64\nis_observed                    int64\nis_imputed                     int64\nis_score_eligible              int64\nis_missing                     int64\n\nFirst 5 rows:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  corridor_id        date             timestamp           station_id  \\\n0  D12_I405_N  2030-06-01  2030-06-01T00:00:00Z 