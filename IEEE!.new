      <td>9664</td>\n      <td>9664</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":7},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D12_I405_N\"\nTRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\nTEMPLATE_PATH = DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTARGETS = [\"speed_kmh\", \"flow_vph\"]\n\ntemplate = pd.read_csv(TEMPLATE_PATH, dtype={\"timestamp\": str})\ntemplate[\"date_only\"] = template[\"timestamp\"].str[:10]\n\nresults = []\n\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    masked_dir = TRAIN_ROOT / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n    masked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\n    if not masked_files:\n        print(f\"No masked files found for {regime}\")\n        continue\n\n    # Use the same sample date as our previous validation.\n    masked_path = masked_files[0]\n    filename_date = masked_path.stem.replace(\"synthetic_mainline_\", \"\")\n    date_text = filename_date.replace(\"_\", \"-\")\n\n    truth_path = (\n        TRAIN_ROOT / \"mainline_states\" / f\"year_month={date_text[:7]}\"\n        / masked_path.name\n    )\n\n    if not truth_path.is_file():\n        print(f\"\\nGround-truth file not found: {truth_path}\")\n        continue\n\n    target_day = template[\n        (template[\"mask_regime\"] == regime)\n        & (template[\"date_only\"] == date_text)\n    ][KEYS].copy()\n\n    truth = pd.read_parquet(truth_path)\n\n    truth_cols = KEYS + TARGETS + [\n        \"pct_observed\",\n        \"is_score_eligible\",\n        \"is_observed\",\n        \"is_imputed\",\n        \"is_missing\",\n    ]\n    truth_cols = [c for c in truth_cols if c in truth.columns]\n    truth = truth[truth_cols].copy()\n\n    print(f\"\\n{'=' * 65}\")\n    print(f\"Regime: {regime} | Date: {date_text}\")\n    print(f\"Ground-truth file: {truth_path.relative_to(DATA_ROOT)}\")\n    print(\"Template target rows:\", len(target_day))\n    print(\"Ground-truth rows:\", len(truth))\n    print(\"Duplicate ground-truth keys:\", int(truth.duplicated(KEYS).sum()))\n\n    # Training labels come from unmasked truth, not masked input values.\n    matched = target_day.merge(\n        truth,\n        on=KEYS,\n        how=\"left\",\n        indicator=True,\n        validate=\"many_to_one\",\n    )\n\n    found = matched[\"_merge\"].eq(\"both\")\n    matched_truth = matched.loc[found]\n\n    print(\"Target keys found in ground truth:\", int(found.sum()))\n    print(\"Target keys absent from ground truth:\", int((~found).sum()))\n    print(\"Ground-truth speed nulls:\", int(matched_truth[\"speed_kmh\"].isna().sum()))\n    print(\"Ground-truth flow nulls:\", int(matched_truth[\"flow_vph\"].isna().sum()))\n\n    if \"is_score_eligible\" in matched_truth.columns:\n        print(\n            \"Ground-truth score-eligible rows:\",\n            int(matched_truth[\"is_score_eligible\"].eq(1).sum()),\n        )\n\n    if \"pct_observed\" in matched_truth.columns:\n        print(\n            \"Rows with pct_observed >= 75:\",\n            int(matched_truth[\"pct_observed\"].ge(75).sum()),\n        )\n\n    results.append({\n        \"regime\": regime,\n        \"date\": date_text,\n        \"template_rows\": len(target_day),\n        \"truth_rows\": len(truth),\n        \"truth_keys_found\": int(found.sum()),\n        \"truth_keys_missing\": int((~found).sum()),\n        \"truth_speed_nulls\": int(matched_truth[\"speed_kmh\"].isna().sum()),\n        \"truth_flow_nulls\": int(matched_truth[\"flow_vph\"].isna().sum()),\n        \"score_eligible\": (\n            int(matched_truth[\"is_score_eligible\"].eq(1).sum())\n            if \"is_score_eligible\" in matched_truth.columns else None\n        ),\n    })\n\nprint(\"\\nGROUND-TRUT