90001</td>\n","      <td>109.812137</td>\n","      <td>117.085902</td>\n","      <td>3857.303930</td>\n","      <td>842.063137</td>\n","      <td>4655.466873</td>\n","    </tr>\n","    <tr>\n","      <th>7</th>\n","      <td>D7_I210_W</td>\n","      <td>115.183684</td>\n","      <td>103.811126</td>\n","      <td>120.750000</td>\n","      <td>3856.450590</td>\n","      <td>926.472133</td>\n","      <td>4825.130529</td>\n","    </tr>\n","    <tr>\n","      <th>8</th>\n","      <td>D7_I405_N</td>\n","      <td>113.014220</td>\n","      <td>76.277838</td>\n","      <td>116.507271</td>\n","      <td>5007.131872</td>\n","      <td>1228.163295</td>\n","      <td>6605.267412</td>\n","    </tr>\n","    <tr>\n","      <th>9</th>\n","      <td>D7_I405_S</td>\n","      <td>112.846949</td>\n","      <td>105.336953</td>\n","      <td>118.777709</td>\n","      <td>4925.524393</td>\n","      <td>1189.321738</td>\n","      <td>6148.549656</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["        panel  sampled_speed_median  sampled_speed_p10  sampled_speed_p90  \\\n","0  D12_I405_N            115.270293         112.748334         117.816029   \n","1  D12_I405_S            114.945041         111.897720         119.091820   \n","2    D12_I5_N            117.375833         114.266397         119.574792   \n","3    D12_I5_S            117.525249         110.676962         120.750000   \n","4    D7_I10_E            112.776106         104.085849         117.674965   \n","5    D7_I10_W            114.450388         105.183635         120.603586   \n","6   D7_I210_E            113.490001         109.812137         117.085902   \n","7   D7_I210_W            115.183684         103.811126         120.750000   \n","8   D7_I405_N            113.014220          76.277838         116.507271   \n","9   D7_I405_S            112.846949         105.336953         118.777709   \n","\n","   sampled_flow_median  sampled_flow_p10  sampled_flow_p90  \n","0          4942.067624        711.646553       6347.035718  \n","1          5514.583724        921.220587       7672.636299  \n","2          4561.160426        885.647072       6422.469492  \n","3          4743.836631       1083.618976       6448.338147  \n","4          4378.450510       1292.903741       5626.493019  \n","5          4564.275888       1138.010041       6030.708311  \n","6          3857.303930        842.063137       4655.466873  \n","7          3856.450590        926.472133       4825.130529  \n","8          5007.131872       1228.163295       6605.267412  \n","9          4925.524393       1189.321738       6148.549656  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","EDA summaries saved under /kaggle/working/\n"]}],"source":["\n","from pathlib import Path\n","import pandas as pd\n","import numpy as np\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","\n","CORRIDORS_ROOT = DATA_ROOT / \"corridors\"\n","TASK1_ROOT = DATA_ROOT / \"task1\"\n","\n","corridors = sorted(p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir())\n","regimes = [\"R1\", \"R2\", \"R3\"]\n","\n","coverage_rows = []\n","traffic_rows = []\n","quality_rows = []\n","structure_rows = []\n","\n","for panel in corridors:\n","    print(f\"Analyzing {panel}...\")\n","\n","    train_root = CORRIDORS_ROOT / panel / \"train\"\n","    template_path = TASK1_ROOT / panel / \"train\" / \"sample_submission_state.csv\"\n","\n","    # A. Template coverage\n","    template = pd.read_csv(template_path, usecols=[\n","        \"panel\", \"timestamp\", \"station_id\", \"link_id\",\n","        \"mask_regime\", \"speed_kmh\", \"flow_vph\"\n","    ], dtype={\"timestamp\": str})\n","\n","    template[\"date\"] = template[\"timestamp\"].str[:10]\n","\n","    for regime, group in template.groupby(\"mask_regime\"):\n","        coverage_rows.append({\n","            \"panel\": panel,\n","            \"regime\": regime,\n","            \"target_rows\": len(group),\n","            \"unique_dates\": group[\"date\"].nunique(),\n","            \"unique_stations\": group[\"station_id\"].nunique(),\n","            \"unique_links\": group[\"link_id\"].nunique(),\n","        })\n","\n","    # B. Inspect unmasked training data, one daily file at a time\n","    mainline_dir = train_root / \"mainline_states\"\n","    station_ids = set()\n","    link_ids = set()\n","    observed_speed = []\n","    observed_flow = []\n","    missing_counts = {\n","        \"rows\": 0,\n","        \"speed_null\": 0,\n","        \"flow_null\": 0,\n","        \"both_null\": 0,\n","        \"eligible\": 0,\n","        \"observed\": 0,\n","        \"imputed\": 0,\n","    }\n","    date_values = set()\n","\n","    daily_files = sorted(mainline_dir.rglob(\"*.parquet\"))\n","\n","    for file_path in daily_files:\n","        df = pd.read_parquet(file_path)\n","\n","        date_values.update(df[\"date\"].dropna().astype(str).unique())\n","        station_ids.update(df[\"station_id\"].dropna().unique())\n","        link_ids.update(df[\"link_id\"].dropna().unique())\n","\n","        missing_counts[\"rows\"] += len(df)\n","        missing_counts[\"speed_null\"] += int(df[\"speed_kmh\"].isna().sum())\n","        missing_counts[\"flow_null\"] += int(df[\"flow_vph\"].isna().sum())\n","        missing_counts[\"both_null\"] += int(\n","            (df[\"speed_kmh\"].isna() & df[\"flow_vph\"].isna()).sum()\n","        )\n","        missing_counts[\"eligible\"] += int(df[\"is_score_eligible\"].eq(1).sum())\n","        missing_counts[\"observed\"] += int(df[\"is_observed\"].eq(1).sum())\n","        missing_counts[\"imputed\"] += int(df[\"is_imputed\"].eq(1).sum())\n","\n","        # Keep only a bounded sample of valid values for distribution summaries.\n","        # This is descriptive sampling, not training data.\n","        valid_speed = df[\"speed_kmh\"].dropna()\n","        valid_flow = df[\"flow_vph\"].dropna()\n","\n","        if len(valid_speed):\n","            observed_speed.extend(\n","                valid_speed.sample(min(500, len(valid_speed)), random_state=42).tolist()\n","            )\n","        if len(valid_flow):\n","            observed_flow.extend(\n","                valid_flow.sample(min(500, len(valid_flow)), random_state=42).tolist()\n","            )\n","\n","    structure_rows.append({\n","        \"panel\": panel,\n","        \"unmasked_daily_files\": len(daily_files),\n","        \"unique_dates\": len(date_values),\n","        \"unique_stations\": len(station_ids),\n","        \"unique_links\": len(link_ids),\n","        \"mainline_rows\": missing_counts[\"rows\"],\n","    })\n","\n","    quality_rows.append({\n","        \"panel\": panel,\n","        \"mainline_rows\": missing_counts[\"rows\"],\n","        \"speed_null_pct\": 100 * missing_counts[\"speed_null\"] / max(missing_counts[\"rows\"], 1),\n","        \"flow_null_pct\": 100 * missing_counts[\"flow_null\"] / max(missing_counts[\"rows\"], 1),\n","        \"both_null_pct\": 100 * missing_counts[\"both_null\"] / max(missing_counts[\"rows\"], 1),\n","        \"score_eligible_pct\": 100 * missing_counts[\"eligible\"] / max(missing_counts[\"rows\"], 1),\n","        \"observed_pct\": 100 * missing_counts[\"observed\"] / max(missing_counts[\"rows\"], 1),\n","        \"imputed_pct\": 100 * missing_counts[\"imputed\"] / max(missing_counts[\"rows\"], 1),\n","    })\n","\n","    traffic_rows.append({\n","        \"panel\": panel,\n","        \"sampled_speed_median\": float(np.median(observed_speed)) if observed_speed else np.nan,\n","        \"sampled_speed_p10\": float(np.percentile(observed_speed, 10)) if observed_speed else np.nan,\n","        \"sampled_speed_p90\": float(np.percentile(observed_speed, 90)) if observed_speed else np.nan,\n","        \"sampled_flow_median\": float(np.median(observed_flow)) if observed_flow else np.nan,\n","        \"sampled_flow_p10\": float(np.percentile(observed_flow, 10)) if observed_flow else np.nan,\n","        \"sampled_flow_p90\": float(np.percentile(observed_flow, 90)) if observed_flow else np.nan,\n","    })\n","\n","# C. Display compact global summaries\n","coverage_df = pd.DataFrame(coverage_rows)\n","structure_df = pd.DataFrame(structure_rows)\n","quality_df = pd.DataFrame(quality_rows)\n","traffic_df = pd.DataFrame(traffic_rows)\n","\n","print(\"\\n1. Target coverage by corridor and regime\")\n","display(coverage_df.sort_values([\"panel\", \"regime\"]).reset_index(drop=True))\n","\n","print(\"\\n2. Mainline structure\")\n","display(structure_df)\n","\n","print(\"\\n3. Missingness and observation flags\")\n","display(quality_df)\n","\n","print(\"\\n4. Sampled speed and flow distributions\")\n","display(traffic_df)\n","\n","# Save outputs for reproducible follow-up analysis.\n","coverage_df.to_csv(\"/kaggle/working/task1_eda_coverage.csv\", index=False)\n","structure_df.to_csv(\"/kaggle/working/task1_eda_structure.csv\", index=False)\n","quality_df.to_csv(\"/kaggle/working/task1_eda_quality.csv\", index=False)\n","traffic_df.to_csv(\"/kaggle/working/task1_eda_traffic.csv\", index=False)\n","\n","print(\"\\nEDA summaries saved under /kaggle/working/\")\n"]},{"cell_type":"code","execution_count":10,"id":"001d8a15","metadata":{"execution":{"iopub.execute_input":"2026-10-19T20:25:19.243118Z","iopub.status.busy":"2026-10-19T20:25:19.242503Z","iopub.status.idle":"2026-10-19T20:39:58.454654Z","shell.execute_reply":"2026-10-19T20:39:58.452703Z"},"papermill":{"duration":879.226336,"end_time":"2026-10-19T20:39:58.45809+00:00","exception":false,"start_time":"2026-10-19T20:25:19.231754+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Sample rows: 6382656\n","Rows with speed and flow available: 5326604\n","Panels represented: 10\n","\n","1. Sampling coverage by corridor\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vert