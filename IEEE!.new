, masked_speed_nonnull, masked_flow_nonnull, truth_keys_found, truth_keys_missing, truth_speed_null, truth_flow_null, truth_score_eligible]\nIndex: []","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>regime</th>\n      <th>date</th>\n      <th>status</th>\n      <th>target_rows</th>\n      <th>masked_keys_found</th>\n      <th>masked_keys_missing</th>\n      <th>masked_speed_nonnull</th>\n      <th>masked_flow_nonnull</th>\n      <th>truth_keys_found</th>\n      <th>truth_keys_missing</th>\n      <th>truth_speed_null</th>\n      <th>truth_flow_null</th>\n      <th>truth_score_eligible</th>\n    </tr>\n  </thead>\n  <tbody>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nTotal target rows in template: 1793853\nTotal target rows covered by checked daily files: 1793853\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nCORRIDORS_ROOT = DATA_ROOT / \"corridors\"\nTASK1_ROOT = DATA_ROOT / \"task1\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTARGETS = [\"speed_kmh\", \"flow_vph\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\ncorridors = sorted(\n    p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir()\n)\n\nprint(\"Corridors discovered:\", len(corridors))\nprint(corridors)\n\naudit_rows = []\nissue_rows = []\n\nfor panel in corridors:\n    print(f\"\\nAuditing {panel}...\")\n\n    train_root = CORRIDORS_ROOT / panel / \"train\"\n    template_path = TASK1_ROOT / panel / \"train\" / \"sample_submission_state.csv\"\n\n    if not train_root.is_dir() or not template_path.is_file():\n        issue_rows.append({\n            \"panel\": panel,\n            \"regime\": None,\n            \"date\": None,\n            \"issue\": \"missing_train_directory_or_template\",\n        })\n        continue\n\n    # Keep the template in memory; it is much smaller than all daily Parquet data combined.\n    template = pd.read_csv(template_path, dtype={\"timestamp\": str})\n    template[\"date_only\"] = template[\"timestamp\"].str[:10]\n\n    # Check duplicate template keys.\n    template_duplicate_count = int(\n        template.duplicated([\"panel\"] + KEYS + [\"mask_regime\"]).sum()\n    )\n\n    if template_duplicate_count:\n        issue_rows.append({\n            \"panel\": panel,\n            \"regime\": None,\n            \"date\": None,\n            \"issue\": f\"duplicate_template_keys:{template_duplicate_count}\",\n        })\n\n    for regime in REGIMES:\n        masked_dir = train_root / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n        masked_files = sorted(masked_dir.rglob(\"*.parquet\")) if masked_dir.is_dir() else []\n\n        regime_template = template[template[\"mask_regime\"] == regime]\n\n        if not masked_files:\n            issue_rows.append({\n                \"panel\": panel,\n                \"regime\": regime,\n                \"date\": None,\n                \"issue\": \"no_masked_parquet_files\",\n            })\n            continue\n\n        expected_dates = set(regime_template[\"date_only\"].unique())\n        available_dates = {\n            p.stem.replace(\"synthetic_mainline_\", \"\").replace(\"_\", \"-\")\n            for p in masked_files\n        }\n\n        for date in sorted(expected_dates - available_dates):\n            issue_rows.append({\n                \"panel\": panel,\n                \"regime\": regime,\n                \"date\": date,\n                \"issue\": \"template_date_missing_masked_file\",\n            })\n\n        for masked_path in masked_files:\n            date = masked_path.stem.replace(\"synthetic_mainline_\", \"\").replace(\"_\", \"-\")\n\n            targets_for_day = regime_template.loc[\n                regime_template[\"date_only\"] == date, KEYS\n            ].copy()\n\n            truth_path = (\n                train_root\n                / \"mainline_states\"\n                / f\"year_month={date[:7]}\"\n                / masked_path.name\n            )\n\n            if not truth_path.is_file():\n                issue_rows.append({\n                    \"panel\": panel,\n                    \"regime\": regime,\n                    \"date\": date,\n                    \"issue\": \"missing_ground_truth_file\",\n                })\n                continue\n\n            masked = pd.read_parquet(masked_path)\n            truth = pd.read_parquet(truth_path)\n\n            # Duplicate keys in source files can make joins ambiguous.\n            masked_duplicates = int(masked.duplicated(KEYS).sum())\n            truth_duplicates = int(truth.duplicated(KEYS).sum())\n\n            if masked_duplicates:\n                issue_rows.append({\n                    \"panel\": panel,\n                    \"regime\": regime,\n                    \"date\": date,\n                    \"issue\": f\"duplicate_masked_keys:{masked_duplicates}\",\n                })\n\n            if truth_duplicates:\n                issue_rows.append({\n                    \"panel\": panel,\n                    \"regime\": regime,\n                    \"date\": date,\n                    \"issue\": f\"duplicate_truth_keys:{truth_duplicates}\",\n                })\n\n            # Validate target keys against masked observations.\n            masked_match = targets_for_day.merge(\n                masked[KEYS + TARGETS],\n                on=KEYS,\n                how=\"left\",\n                indicator=True,\n                validate=\"many_to_one\",\n            )\n\n            masked_found = masked_match[\"_merge\"].eq(\"both\")\n            masked_values = masked_match.loc[masked_found]\n\n            # Validate target keys against unmasked ground truth.\n            truth_cols = KEYS + TARGETS + [\"is_score_eligible\"]\n            truth_cols = [c for c in truth_cols if c in truth.columns]\n\n            truth_match = targets_for_day.merge(\n                truth[truth_cols],\n                on=KEYS,\n                how=\"left\",\n                indicator=True,\n                validate=\"many_to_one\",\n            )\n\n            truth_found = truth_match[\"_merge\"].eq(\"both\")\n            truth_values = truth_match.loc[truth_found]\n\n            row = {\n                \"panel\": panel,\n                \"regime\": regime,\n                \"date\": date,\n                \"template_targets\": len(targets_for_day),\n                \"masked_keys_found\": int(masked_found.sum()),\n                \"masked_keys_missing\": int((~masked_found).sum()),\n                \"masked_speed_nonnull\": int(masked_values[\"speed_kmh\"].notna().sum()),\n                \"masked_flow_nonnull\": int(masked_values[\"flow_vph\"].notna().sum()),\n                \"truth_keys_found\": int(truth_found.sum()),\n                \"truth_keys_missing\": int((~truth_found).sum()),\n                \"truth_speed_null\": int(truth_values[\"speed_kmh\"].isna().sum()),\n                \"truth_flow_null\": int(truth_values[\"flow_vph\"].isna().sum()),\n                \"truth_ineligible\": (\n                    int(truth_values[\"is_score_eligible\"].ne(1).sum())\n                    if \"is_score_eligible\" in truth_values.columns else None\n                ),\n                \"masked_duplicate_keys\": masked_duplicates,\n                \"truth_duplicate_keys\": truth_duplicates,\n            }\n            audit_rows.append(row)\n\n            checks = [\n                (\"masked_keys_missing\", row[\"masked_keys_missing\"]),\n                (\"truth_keys_missing\", row[\"truth_keys_missing\"]),\n                (\"masked_speed_nonnull\", row[\"masked_speed_nonnull\"]),\n                (\"masked_flow_nonnull\", row[\"masked_flow_nonnull\"]),\n                (\"truth_speed_null\", row[\"truth_speed_null\"]),\n                (\"truth_flow_null\", row[\"truth_flow_null\"]),\n                (\"masked_duplicate_keys\", masked_duplicates),\n                (\"truth_duplicate_keys\", truth_duplicates),\n            ]\n\n            for check_name, count in checks:\n                if count:\n                    issue_rows.append({\n                        \"panel\": panel,\n                        \"regime\": regime,\n                        \"date\": date,\n                        \"issue\": f\"{check_name}:{count}\",\n                    })\n\n            if row[\"truth_ineligible\"] not in (None, 0):\n                issue_rows.append({\n                    \"panel\": panel,\n                    \"regime\": regime,\n                    \"date\": date,\n                    \"issue\": f\"truth_ineligible:{row['truth_ineligible']}\",\n                })\n\n    print(f\"Finished {panel}\")\n\naudit_df = pd.DataFrame(audit_rows)\nissues_df = pd.DataFrame(issue_rows)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"AUDIT SUMMARY BY CORRIDOR AND REGIME\")\n\nif not audit_df.empty:\n    summary = (\n        audit_df.groupby([\"panel\", \"regime\"], as_index=False)\n        .agg(\n            dates_checked=(\"date\", \"nunique\"),\n            target_rows=(\"template_targets\", \"sum\"),\n            masked_keys_missing=(\"masked_keys_missing\", \"sum\"),\n            truth_keys_missing=(\"truth_keys_missing\", \"sum\"),\n            masked_speed_nonnull=(\"masked_speed_nonnull\", \"sum\"),\n            masked_flow_nonnull=(\"masked_flow_nonnull\", \"sum\"),\n            truth_speed_null=(\"truth_speed_null\", \"sum\"),\n            truth_flow_null=(\"truth_flow_null\", \"sum\"),\n            truth_ineligible=(\"truth_ineligible\", \"sum\"),\n        )\n    )\n    display(summary)\n\n    print(\"\\nOverall totals:\")\n    display(\n        audit_df.select_dtypes(include=\"number\").sum().to_frame(\"total\")\n    )\n\nprint(\"\\nISSUES FOUND:\", len(issues_df))\ndisplay(issues_df)\n\n# Save detailed audit outputs to the writable Kaggle directory.\naudit_path = Path(\"/kaggle/working/task1_cross_corridor_audit.csv\")\nissues_path = Path(\"/kaggle/working/task1_cross_corridor_issues.csv\")\n\naudit_df.to_csv(audit_path, index=False)\nissues_df.to_csv(issues_path, index=False)\n\nprint(\"\\nSaved:\")\nprint(audit_path)\nprint(issues_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:51:32.903165Z","iopub.execute_input":"2026-10-19T18:51:32.903615Z","iopub.status.idle":"2026-10-19T19:11:47.342729Z","shell.execute_reply.started":"2026-10-19T18:51:32.903581Z","shell.execute_reply":"2026-10-19T19:11:47.339772Z"}},"outputs":[{"name":"stdout","text":"Corridors discovered: 10\n['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I405_N', 'D7_I405_S']\n\nAuditing D12_I405_N...\nFinished D12_I405_N\n\nAuditing D12_I405_S...\nFinished D12_I405_S\n\nAuditing D12_I5_N...\nFinished D12_I5_N\n\nAuditing D12_I5_S...\nFinished D12_I5_S\n\nAuditing D7_I10_E...\nFinished D7_I10_E\n\nAuditing D7_I10_W...\nFinished D7_I10_W\n\nAuditing D7_I210_E...\nFinished D7_I210_E\n\nAuditing D7_I210_W...\nFinished D7_I210_W\n\nAuditing D7_I405_N...\nFinished D7_I405_N\n\nAuditing D7_I405_S...\nFinished D7_I405_S\n\n======================================================================\nAUDIT SUMMARY BY CORRIDOR AND REGIME\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"         panel regime  dates_checked  target_rows  masked_keys_missing  \\\n0   D12_I405_N     R1             87       340450                    0   \n1   D12_I405_N     R2             94       551642                    0   \n2   D12_I405_N     R3             92       901