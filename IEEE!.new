PANEL / \"train\"\n","TEMPLATE_PATH = DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n","\n","KEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n","TARGETS = [\"speed_kmh\", \"flow_vph\"]\n","\n","template = pd.read_csv(TEMPLATE_PATH, dtype={\"timestamp\": str})\n","template[\"date_only\"] = template[\"timestamp\"].str[:10]\n","\n","results = []\n","\n","for regime in [\"R1\", \"R2\", \"R3\"]:\n","    masked_dir = TRAIN_ROOT / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n","    masked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n","\n","    print(f\"\\nChecking {regime}: {len(masked_files)} masked daily files\")\n","\n","    for i, masked_path in enumerate(masked_files, start=1):\n","        filename_date = masked_path.stem.replace(\"synthetic_mainline_\", \"\")\n","        date_text = filename_date.replace(\"_\", \"-\")\n","\n","        truth_path = (\n","            TRAIN_ROOT\n","            / \"mainline_states\"\n","            / f\"year_month={date_text[:7]}\"\n","            / masked_path.name\n","        )\n","\n","        target_day = template.loc[\n","            (template[\"mask_regime\"] == regime)\n","            & (template[\"date_only\"] == date_text),\n","            KEYS,\n","        ].copy()\n","\n","        if not truth_path.is_file():\n","            results.append({\n","                \"regime\": regime,\n","                \"date\": date_text,\n","                \"status\": \"missing_truth_file\",\n","                \"target_rows\": len(target_day),\n","            })\n","            continue\n","\n","        masked = pd.read_parquet(masked_path)\n","        truth = pd.read_parquet(truth_path)\n","\n","        # Confirm the target keys occur in the masked input.\n","        masked_match = target_day.merge(\n","            masked[KEYS + TARGETS],\n","            on=KEYS,\n","            how=\"left\",\n","            indicator=True,\n","            validate=\"many_to_one\",\n","        )\n","\n","        masked_found = masked_match[\"_merge\"].eq(\"both\")\n","        masked_values = masked_match.loc[masked_found]\n","\n","        # Confirm the same keys occur in unmasked ground truth.\n","        truth_cols = KEYS + TARGETS + [\"is_score_eligible\"]\n","        truth_match = target_day.merge(\n","            truth[truth_cols],\n","            on=KEYS,\n","            how=\"left\",\n","            indicator=True,\n","            validate=\"many_to_one\",\n","        )\n","\n","        truth_found = truth_match[\"_merge\"].eq(\"both\")\n","        truth_values = truth_match.loc[truth_found]\n","\n","        results.append({\n","            \"regime\": regime,\n","            \"date\": date_text,\n","            \"status\": \"ok\",\n","            \"target_rows\": len(target_day),\n","            \"masked_keys_found\": int(masked_found.sum()),\n","            \"masked_keys_missing\": int((~masked_found).sum()),\n","            \"masked_speed_nonnull\": int(masked_values[\"speed_kmh\"].notna().sum()),\n","            \"masked_flow_nonnull\": int(masked_values[\"flow_vph\"].notna().sum()),\n","            \"truth_keys_found\": int(truth_found.sum()),\n","            \"truth_keys_missing\": int((~truth_found).sum()),\n","            \"truth_speed_null\": int(truth_values[\"speed_kmh\"].isna().sum()),\n","            \"truth_flow_null\": int(truth_values[\"flow_vph\"].isna().sum()),\n","            \"truth_score_eligible\": int(\n","                truth_values[\"is_score_eligible\"].eq(1).sum()\n","            ),\n","        })\n","\n","        if i % 20 == 0 or i == len(masked_files):\n","            print(f\"  Processed {i}/{len(masked_files)} files\")\n","\n","results_df = pd.DataFrame(results)\n","\n","print(\"\\nPer-regime summary:\")\n","display(\n","    results_df.groupby([\"regime\", \"status\"], dropna=False)\n","    .agg(\n","        dates=(\"date\", \"count\"),\n","        target_rows=(\"target_rows\", \"sum\"),\n","        masked_keys_missing=(\"masked_keys_missing\", \"sum\"),\n","        truth_keys_missing=(\"truth_keys_missing\", \"sum\"),\n","        truth_speed_null=(\"truth_speed_null\", \"sum\"),\n","        truth_flow_null=(\"truth_flow_null\", \"sum\"),\n","        truth_score_eligible=(\"truth_score_eligible\", \"sum\"),\n","    )\n","    .reset_index()\n",")\n","\n","print(\"\\nDates with any issue:\")\n","issue_rows = results_df[\n","    (results_df[\"status\"] != \"ok\")\n","    | (results_df.get(\"masked_keys_missing\", 0) > 0)\n","    | (results_df.get(\"truth_keys_missing\", 0) > 0)\n","    | (results_df.get(\"truth_speed_null\", 0) > 0)\n","    | (results_df.get(\"truth_flow_null\", 0) > 0)\n","]\n","\n","display(issue_rows)\n","\n","print(\"\\nTotal target rows in template:\", len(template))\n","print(\"Total target rows covered by checked daily files:\",\n","      int(results_df.loc[results_df[\"status\"] == \"ok\", \"target_rows\"].sum()))\n"]},{"cell_type":"code","execution_count":8,"id":"22caa3aa","metadata":{"execution":{"iopub.execute_input":"2026-10-19T20:02:18.050574Z","iopub.status.busy":"2026-10-19T20:02:18.050172Z","iopub.status.idle":"2026-10-19T20:21:58.132534Z","shell.execute_reply":"2026-10-19T20:21:58.130975Z"},"papermill":{"duration":1180.094596,"end_time":"2026-10-19T20:21:58.136397+00:00","exception":false,"start_time":"2026-10-19T20:02:18.041801+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Corridors discovered: 10\n","['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I405_N', 'D7_I405_S']\n","\n","Auditing D12_I405_N...\n","Finished D12_I405_N\n","\n","Auditing D12_I405_S...\n","Finished D12_I405_S\n","\n","Auditing D12_I5_N...\n","Finished D12_I5_N\n","\n","Auditing D12_I5_S...\n","Finished D12_I5_S\n","\n","Auditing D7_I10_E...\n","Finished D7_I10_E\n","\n","Auditing D7_I10_W...\n","Finished D7_I10_W\n","\n","Auditing D7_I210_E...\n","Finished D7_I210_E\n","\n","Au