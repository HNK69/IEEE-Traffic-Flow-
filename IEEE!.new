flow-bench/kaggle_public\"\n",")\n","\n","PANEL = \"D12_I405_N\"\n","TRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\n","TEMPLATE_ROOT = DATA_ROOT / \"task1\" / PANEL / \"train\"\n","\n","if not TRAIN_ROOT.is_dir():\n","    raise FileNotFoundError(f\"Training directory not found: {TRAIN_ROOT}\")\n","\n","# 1. Inspect immediate entries in the training directory\n","print(f\"Training root: {TRAIN_ROOT}\")\n","print(\"\\nImmediate contents:\")\n","\n","for path in sorted(TRAIN_ROOT.iterdir()):\n","    kind = \"DIR \" if path.is_dir() else \"FILE\"\n","    print(f\"{kind}  {path.name}\")\n","\n","# 2. Inventory all files under this corridor's training directory\n","records = []\n","\n","for path in sorted(TRAIN_ROOT.rglob(\"*\")):\n","    if path.is_file():\n","        records.append({\n","            \"relative_path\": str(path.relative_to(TRAIN_ROOT)),\n","            \"parent_folder\": str(path.parent.relative_to(TRAIN_ROOT)),\n","            \"file_name\": path.name,\n","            \"extension\": path.suffix.lower(),\n","            \"size_mb\": round(path.stat().st_size / (1024 ** 2), 3),\n","        })\n","\n","panel_train_files = pd.DataFrame(records)\n","\n","print(f\"\\nTotal training files for {PANEL}: {len(panel_train_files)}\")\n","\n","# 3. Summarize files by their immediate parent folder\n","print(\"\\nFiles grouped by folder:\")\n","display(\n","    panel_train_files.groupby(\"parent_folder\")\n","    .agg(\n","        file_count=(\"file_name\", \"count\"),\n","        total_size_mb=(\"size_mb\", \"sum\"),\n","        examples=(\"file_name\", lambda x: \", \".join(x.head(3))),\n","    )\n","    .reset_index()\n","    .sort_values(\"parent_folder\")\n",")\n","\n","# 4. Inspect the exact file paths and filenames\n","print(\"\\nComplete training file inventory:\")\n","display(panel_train_files)\n","\n","# 5. Check the Task 1 template separately\n","print(f\"\\nTask 1 template directory: {TEMPLATE_ROOT}\")\n","\n","if TEMPLATE_ROOT.is_dir():\n","    for path in sorted(TEMPLATE_ROOT.iterdir()):\n","        if path.is_file():\n","            print(\n","                f\"{path.name} | \"\n","                f\"{path.stat().st_size / (1024 ** 2):.3f} MB\"\n","            )\n","else:\n","    print(\"Task 1 template directory not found.\")\n"]},{"cell_type":"code","execution_count":3,"id":"f3eebd53","metadata":{"execution":{"iopub.execute_input":"2026-10-19T19:59:42.44134Z","iopub.status.busy":"2026-10-19T19:59:42.440623Z","iopub.status.idle":"2026-10-19T19:59:42.850091Z","shell.execute_reply":"2026-10-19T19:59:42.849084Z"},"papermill":{"duration":0.416486,"end_time":"2026-10-19T19:59:42.852031+00:00","exception":false,"start_time":"2026-10-19T19:59:42.435545+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","======================================================================\n","SOURCE: unmasked_mainline\n","Directory: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D12_I405_N/train/mainline_states\n","Parquet files found: 273\n","Sample file: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_01.parquet\n","\n","Column names:\n","['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n","\n","Data types:\n","corridor_id                   object\n","date                          object\n","timestamp                     object\n","station_id                    object\n","link_id                       object\n","milepost                     float64\n","direction                     object\n","speed_kmh                    float64\n","flow_vph                     float64\n","occupancy                    float64\n","density_occ_linear_vehpkm    float64\n","pct_observed                   int64\n","is_observed