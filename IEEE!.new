64</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>29</th>\n      <td>D7_I405_S</td>\n      <td>R3</td>\n      <td>79</td>\n      <td>946996</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nOverall totals:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                          total\ntemplate_targets       31783763\nmasked_keys_found      31783763\nmasked_keys_missing           0\nmasked_speed_nonnull          0\nmasked_flow_nonnull           0\ntruth_keys_found       31783763\ntruth_keys_missing            0\ntruth_speed_null              0\ntruth_flow_null               0\ntruth_ineligible              0\nmasked_duplicate_keys         0\ntruth_duplicate_keys          0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>total</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>template_targets</th>\n      <td>31783763</td>\n    </tr>\n    <tr>\n      <th>masked_keys_found</th>\n      <td>31783763</td>\n    </tr>\n    <tr>\n      <th>masked_keys_missing</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>masked_speed_nonnull</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>masked_flow_nonnull</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>truth_keys_found</th>\n      <td>31783763</td>\n    </tr>\n    <tr>\n      <th>truth_keys_missing</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>truth_speed_null</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>truth_flow_null</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>truth_ineligible</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>masked_duplicate_keys</th>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>truth_duplicate_keys</th>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nISSUES FOUND: 0\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Empty DataFrame\nColumns: []\nIndex: []","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nSaved:\n/kaggle/working/task1_cross_corridor_audit.csv\n/kaggle/working/task1_cross_corridor_issues.csv\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nCORRIDORS_ROOT = DATA_ROOT / \"corridors\"\nTASK1_ROOT = DATA_ROOT / \"task1\"\n\ncorridors = sorted(p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir())\nregimes = [\"R1\", \"R2\", \"R3\"]\n\ncoverage_rows = []\ntraffic_rows = []\nquality_rows = []\nstructure_rows = []\n\nfor panel in corridors:\n    print(f\"Analyzing {panel}...\")\n\n    train_root = CORRIDORS_ROOT / panel / \"train\"\n    template_path = TASK1_ROOT / panel / \"train\" / \"sample_submission_state.csv\"\n\n    # A. Template coverage\n    template = pd.read_csv(template_path, usecols=[\n        \"panel\", \"timestamp\", \"station_id\", \"link_id\",\n        \"mask_regime\", \"speed_kmh\", \"flow_vph\"\n    ], dtype={\"timestamp\": str})\n\n    template[\"date\"] = template[\"timestamp\"].str[:10]\n\n    for regime, group in template.groupby(\"mask_regime\"):\n        coverage_rows.append({\n            \"panel\": panel,\n            \"regime\": regime,\n            \"target_rows\": len(group),\n            \"unique_dates\": group[\"date\"].nunique(),\n            \"unique_stations\": group[\"station_id\"].nunique(),\n            \"unique_links\": group[\"link_id\"].nunique(),\n        })\n\n    # B. Inspect unmasked training data, one daily file at a time\n    mainline_dir = train_root / \"mainline_states\"\n    station_ids = set()\n    link_ids = set()\n    observed_speed = []\n    observed_flow = []\n    missing_counts = {\n        \"rows\": 0,\n        \"speed_null\": 0,\n        \"flow_null\": 0,\n        \"both_null\": 0,\n        \"eligible\": 0,\n        \"observed\": 0,\n        \"imputed\": 0,\n    }\n    date_values = set()\n\n    daily_files = sorted(mainline_dir.rglob(\"*.parquet\"))\n\n    for file_path in daily_files:\n        df = pd.read_parquet(file_path)\n\n        date_values.update(df[\"date\"].dropna().astype(str).unique())\n        station_ids.update(df[\"station_id\"].dropna().unique())\n        link_ids.update(df[\"link_id\"].dropna().unique())\n\n        missing_counts[\"rows\"] += len(df)\n        missing_counts[\"speed_null\"] += int(df[\"speed_kmh\"].isna().sum())\n        missing_counts[\"flow_null\"] += int(df[\"flow_vph\"].isna().sum())\n        missing_counts[\"both_null\"] += int(\n            (df[\"speed_kmh\"].isna() & df[\"flow_vph\"].isna()).sum()\n        )\n        missing_counts[\"eligible\"] += int(df[\"is_score_eligible\"].eq(1).sum())\n        missing_counts[\"observed\"] += int(df[\"is_observed\"].eq(1).sum())\n        missing_counts[\"imputed\"] += int(df[\"is_imputed\"].eq(1).sum())\n\n        # Keep only a bounded sample of valid values for distribution summaries.\n        # This is descriptive sampling, not training data.\n        valid_speed = df[\"speed_kmh\"].dropna()\n        valid_flow = df[\"flow_vph\"].dropna()\n\n        if len(valid_speed):\n            observed_speed.extend(\n                valid_speed.sample(min(500, len(valid_speed)), random_state=42).tolist()\n            )\n        if len(valid_flow):\n            observed_flow.extend(\n                valid_flow.sample(min(500, len(valid_flow)), random_state=42).tolist()\n            )\n\n    structure_rows.append({\n        \"panel\": panel,\n        \"unmasked_daily_files\": len(daily_files),\n        \"unique_dates\": len(date_values),\n        \"unique_stations\": len(station_ids),\n        \"unique_links\": len(link_ids),\n        \"mainline_rows\": missing_counts[\"rows\"],\n    })\n\n    quality_rows.append({\n        \"panel\": panel,\n        \"mainline_rows\": missing_counts[\"rows\"],\n        \"speed_null_pct\": 100 * missing_counts[\"speed_null\"] / max(missing_counts[\"rows\"], 1),\n        \"flow_null_pct\": 100 * missing_counts[\"flow_null\"] / max(missing_counts[\"rows\"], 1),\n        \"both_null_pct\": 100 * missing_counts[\"both_null\"] / max(missing_counts[\"rows\"], 1),\n        \"score_eligible_pct\": 100 * missing_counts[\"eligible\"] / max(missing_counts[\"rows\"], 1),\n        \"observed_pct\": 100 * missing_counts[\"observed\"] / max(missing_counts[\"rows\"], 1),\n        \"imputed_pct\": 100 * missing_counts[\"imputed\"] / max(missing_counts[\"rows\"], 1),\n    })\n\n    traffic_rows.append({\n        \"panel\": panel,\n        \"sampled_speed_median\": float(np.median(observed_speed)) if observed_speed else np.nan,\n        \"sampled_speed_p10\": float(np.percentile(observed_speed, 10)) if observed_speed else np.nan,\n        \"sampled_speed_p90\": float(np.percentile(observed_speed, 90)) if observed_speed else np.nan,\n        \"sampled_flow_median\": float(np.median(observed_flow)) if observed_flow else np.nan,\n        \"sampled_flow_p10\": float(np.percentile(observed_flow, 10)) if observed_flow else np.nan,\n        \"sampled_flow_p90\": float(np.percentile(observed_flow, 90)) if observed_flow else np.nan,\n    })\n\n# C. Display compact global summaries\ncoverage_df = pd.DataFrame(coverage_rows)\nstructure_df = pd.DataFrame(structure_rows)\nquality_df = pd.DataFrame(quality_rows)\ntraffic_df = pd.DataFrame(traffic_rows)\n\nprint(\"\\n1. Target coverage by corridor and regime\")\ndisplay(coverage_df.sort_values([\"panel\", \"regime\"]).reset_index(drop=True))\n\nprint(\"\\n2. Mainline structure\")\ndisplay(structure_df)\n\nprint(\"\\n3. Missingness and observation flags\")\ndisplay(quality_df)\n\nprint(\"\\n4. Sampled speed and flow distributions\")\ndisplay(traffic_df)\n\n# Save outputs for reproducible follow-up analysis.\ncoverage_df.to_csv(\"/kaggle/working/task1_eda_coverage.csv\", index=False)\nstructure_df.to_csv(\"/kaggle/working/task1_eda_structure.csv\", index=False)\nquality_df.to_csv(\"/kaggle/working/task1_eda_quality.csv\", index=False)\ntraffic_df.to_csv(\"/kaggle/working/task1_eda_traffic.csv\", index=False)\n\nprint(\"\\nEDA summaries saved under /kaggle/working/\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:24:45.350905Z","iopub.execute_input":"2026-10-19T19:24:45.351778Z","iopub.status.idle":"2026-10-19T19:28:23.884193Z","shell.execute_reply.started":"2026-10-19T19:24:45.351733Z","shell.execute_reply":"2026-10-19T19:28:23.882783Z"}},"outputs":[{"name":"stdout","text":"Analyzing D12_I405_N...\nAnalyzing D12_I405_S...\nAnalyzing D12_I5_N...\nAnalyzing D12_I5_S...\nAnalyzing D7_I10_E...\nAnalyzing D7_I10_W...\nAnalyzing D7_I210_E...\nAnalyzing D7_I210_W...\nAnalyzing D7_I405_N...\nAnalyzing D7_I405_S...\n\n1. Target coverage by corridor and regime\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"         panel regime  target_rows  unique_dates  unique_stations  \\\n0   D12_I405_N     R1       340