n\ndate_to_file = {}\n\nfor source_name, source_dir in source_dirs.items():\n    files = sorted(source_dir.rglob(\"*.parquet\"))\n    mapping = {p.name: p for p in files}\n    date_to_file[source_name] = mapping\n\n    print(f\"\\n{source_name}: {len(files)} Parquet files\")\n    print(\"First 3 filenames:\", [p.name for p in files[:3]])\n\n# 3. Find a filename/date available in all four sources.\ncommon_names = set.intersection(\n    *(set(mapping.keys()) for mapping in date_to_file.values())\n)\n\nif common_names:\n    chosen_name = sorted(common_names)[0]\n    print(\"\\nCommon sample file:\", chosen_name)\nelse:\n    chosen_name = None\n    print(\"\\nNo common daily filename across all four sources.\")\n\n# 4. Compare the template with each regime's matching daily file.\nif chosen_name is not None:\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        print(f\"\\n{'=' * 60}\\nREGIME {regime}: {chosen_name}\")\n\n        masked = pd.read_parquet(date_to_file[regime][chosen_name])\n\n        # Use the timestamp and station/link identifiers to match records.\n        template_regime = template[\n            template[\"mask_regime\"] == regime\n        ].copy()\n\n        template_day = template_regime[\n            template_regime[\"timestamp\"].str[:10]\n            == chosen_name.replace(\"synthetic_mainline_\", \"\").replace(\".parquet\", \"\")\n        ]\n\n        print(\"Masked file rows:\", len(masked))\n        print(\"Template rows for this regime/date:\", len(template_day))\n\n        if template_day.empty:\n            print(\"No matching template rows for this date.\")\n            continue\n\n        # Check whether the requested template keys exist in the masked file.\n        matched = template_day[KEYS].merge(\n            masked[KEYS].drop_duplicates(),\n            on=KEYS,\n            how=\"left\",\n            indicator=True,\n        )\n\n        print(\"Template keys found in masked file:\",\n              int((matched[\"_merge\"] == \"both\").sum()))\n        print(\"Template keys absent from masked file:\",\n              int((matched[\"_merge\"] == \"left_only\").sum()))\n\n        # Inspect missingness and flags in the masked file.\n        print(\"\\nMasked file missing-value counts:\")\n        display(masked[VALUE_COLS].isna().sum().rename(\"null_count\").reset_index(\n            names=\"column\"\n        ))\n\n        print(\"\\nEligibility and observation flags:\")\n        flag_cols = [\n            c for c in [\n                \"pct_observed\", \"is_observed\", \"is_imputed\",\n                \"is_score_eligible\", \"is_missing\"\n            ] if c in masked.columns\n        ]\n        display(masked[flag_cols].describe().T)\n\n# 5. Inspect template rows by regime for the first few dates.\nprint(\"\\nTemplate date range by regime:\")\ntemplate[\"date_only\"] = template[\"timestamp\"].str[:10]\ndisplay(\n    template.groupby(\"mask_regime\")[\"date_only\"]\n    .agg([\"min\", \"max\", \"nunique\"])\n    .reset_index()\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:29:46.107472Z","iopub.execute_input":"2026-10-19T18:29:46.107955Z","iopub.status.idle":"2026-10-19T18:29:51.750249Z","shell.execute_reply.started":"2026-10-19T18:29:46.107923Z","shell.execute_reply":"2026-10-19T18:29:51.749183Z"}},"outputs":[{"name":"stdout","text":"Template rows: 1793853\n\nTarget rows by regime:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  mask_regime    rows\n0          R1  340450\n1          R2  551642\n2          R3  901761","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>mask_regime</th>\n      <th>rows</th>\n 