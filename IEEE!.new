{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":153956}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nCORRIDORS_ROOT = DATA_ROOT / \"corridors\"\n\nif not CORRIDORS_ROOT.exists():\n    raise FileNotFoundError(f\"Corridors directory not found: {CORRIDORS_ROOT}\")\n\n# Find files whose paths or names relate to Task 1 state reconstruction.\nkeywords = (\n    \"mainline_states\",\n    \"ramp\",\n    \"network\",\n    \"fd_parameters\",\n)\n\nrecords = []\n\nfor path in CORRIDORS_ROOT.rglob(\"*\"):\n    if not path.is_file():\n        continue\n\n    path_text = str(path.relative_to(DATA_ROOT)).lower()\n\n    if any(keyword in path_text for keyword in keywords):\n        records.append({\n            \"relative_path\": str(path.relative_to(DATA_ROOT)),\n            \"file_name\": path.name,\n            \"extension\": path.suffix.lower(),\n            \"size_mb\": round(path.stat().st_size / (1024 ** 2), 3),\n        })\n\nfiles_df = pd.DataFrame(records)\n\nprint(f\"Matching files found: {len(files_df)}\")\n\nif files_df.empty:\n    print(\"No matching files found. We will inspect the directory structure next.\")\nelse:\n    # Summarize file types without hiding the full path inventory.\n    print(\"\\nFile extensions:\")\n    display(files_df[\"extension\"].value_counts().rename_axis(\"extension\").to_frame(\"count\"))\n\n    print(\"\\nFile counts by filename:\")\n    display(\n        files_df.groupby(\"file_name\")\n        .agg(file_count=(\"relative_path\", \"count\"),\n             total_size_mb=(\"size_mb\", \"sum\"))\n        .sort_values(\"file_count\", ascending=False)\n        .reset_index()\n    )\n\n    print(\"\\nAll matching paths:\")\n    display(files_df.sort_values(\"relative_path\").reset_index(drop=True))\n\n# Also show the immediate structure under one corridor, if available.\npanels = sorted(p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir())\n\nprint(f\"\\nCorridor directories found: {len(panels)}\")\nprint(\"First corridor names:\", panels[:5])\n\nif panels:\n    example_panel = CORRIDORS_ROOT / panels[0]\n    print(f\"\\nImmediate structure under {example_panel.relative_to(DATA_ROOT)}:\")\n    for path in sorted(example_panel.iterdir()):\n        print((\"DIR \" if path.is_dir() else \"FILE\") + f\"  {path.name}\")\n","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:26:11.289952Z","iopub.execute_input":"2026-10-19T18:26:11.290473Z","iopub.status.idle":"2026-10-19T18:26:24.167259Z","shell.execute_reply.started":"2026-10-19T18:26:11.290435Z","shell.execute_reply":"2026-10-19T18:26:24.166184Z"}},"outputs":[{"name":"stdout","text":"Matching files found: 9490\n\nFile extensions:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           count\nextension       \n.parquet    9410\n.csv          70\n.json         10","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>count</th>\n    </tr>\n    <tr>\n      <th>extension</th