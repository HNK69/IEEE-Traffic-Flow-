N_0031</td>\n","      <td>L405N-011</td>\n","      <td>R2</td>\n","      <td>NaN</td>\n","      <td>NaN</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["        panel             timestamp           station_id    link_id  \\\n","0  D12_I405_N  2030-06-01T00:00:00Z  SYN_D12_I405_N_0084  L405N-001   \n","1  D12_I405_N  2030-06-01T00:00:00Z  SYN_D12_I405_N_0001  L405N-003   \n","2  D12_I405_N  2030-06-01T00:00:00Z  SYN_D12_I405_N_0081  L405N-009   \n","3  D12_I405_N  2030-06-01T00:00:00Z  SYN_D12_I405_N_0002  L405N-010   \n","4  D12_I405_N  2030-06-01T00:00:00Z  SYN_D12_I405_N_0031  L405N-011   \n","\n","  mask_regime  speed_kmh  flow_vph  \n","0          R2        NaN       NaN  \n","1          R2        NaN       NaN  \n","2          R2        NaN       NaN  \n","3          R2        NaN       NaN  \n","4          R2        NaN       NaN  "]},"metadata":{},"output_type":"display_data"}],"source":["\n","from pathlib import Path\n","import pandas as pd\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","\n","PANEL = \"D12_I405_N\"\n","TRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\n","TEMPLATE_PATH = (\n","    DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n",")\n","\n","# Pick one existing Parquet file from each source.\n","source_dirs = {\n","    \"unmasked_mainline\": TRAIN_ROOT / \"mainline_states\",\n","    \"masked_mainline_R1\": TRAIN_ROOT / \"mainline_states_masked\" / \"mask_regime=R1\",\n","    \"ramp_states\": TRAIN_ROOT / \"ramp_states\",\n","}\n","\n","for source_name, source_dir in source_dirs.items():\n","    if not source_dir.is_dir():\n","        print(f\"\\n{source_name}: directory not found: {source_dir}\")\n","        continue\n","\n","    parquet_files = sorted(source_dir.rglob(\"*.parquet\"))\n","\n","    print(f\"\\n{'=' * 70}\")\n","    print(f\"SOURCE: {source_name}\")\n","    print(f\"Directory: {source_dir}\")\n","    print(f\"Parquet files found: {len(parquet_files)}\")\n","\n","    if not parquet_files:\n","        continue\n","\n","    sample_path = parquet_files[0]\n","    print(f\"Sample file: {sample_path.relative_to(DATA_ROOT)}\")\n","\n","    # Read a small number of rows, not the whole file.\n","    sample_df = pd.read_parquet(sample_path).head(5)\n","\n","    print(\"\\nColumn names:\")\n","    print(sample_df.columns.tolist())\n","\n","    print(\"\\nData types:\")\n","    print(sample_df.dtypes.to_string())\n","\n","    print(\"\\nFirst 5 rows:\")\n","    display(sample_df)\n","\n","# Inspect only a few rows of the Task 1 target template.\n","print(f\"\\n{'=' * 70}\")\n","print(\"TASK 1 SUBMISSION TEMPLATE\")\n","print(f\"Path: {TEMPLATE_PATH}\")\n","\n","if not TEMPLATE_PATH.is_file():\n","    raise FileNotFoundError(f\"Template not found: {TEMPLATE_PATH}\")\n","\n","template_sample = pd.read_csv(TEMPLATE_PATH, nrows=5)\n","\n","print(\"\\nTemplate columns:\")\n","print(template_sample.columns.tolist())\n","\n","print(\"\\nTemplate data types:\")\n","print(template_sample.dtypes.to_string())\n","\n","print(\"\\nFirst 5 template rows:\")\n","display(template_sample)\n"]},{"cell_type":"code","execution_count":4,"id":"f56912c0","metadata":{"execution":{"iopub.execute_input":"2026-10-19T19:59:42.862615Z","iopub.status.busy":"2026-10-19T19:59:42.862193Z","iopub.status.idle":"2026-10-19T19:59:47.645657Z","shell.execute_reply":"2026-10-19T19:59:47.644889Z"},"papermill":{"duration":4.791475,"end_time":"2026-10-19T19:59:47.647791+00:00","exception":false,"start_time":"2026-10-19T19:59:42.856316+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Template rows: 1793853\n","\n","Target rows by regime:\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>mask_regime</th>\n","      <th>rows</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>R1</td>\n","      <td>340450</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>R2</td>\n","      <td>551642</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>R3</td>\n","      <td>901761</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["  mask_regime    rows\n","0          R1  340450\n","1          R2  551642\n","2          R3  901761"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Unique timestamps in template: 78624\n","Template duplicate keys: 0\n","\n","unmasked: 273 Parquet files\n","First 3 filenames: ['synthetic_mainline_2030_06_01.parquet', 'synthetic_mainline_2030_06_02.parquet', 'synthetic_mainline_2030_06_03.parquet']\n","\n","R1: 87 Parquet files\n","First 3 filenames: ['synthetic_mainline_2030_06_02.parquet', 'synthetic_mainline_2030_06_05.parquet', 'synthetic_mainline_2030_06_06.parquet']\n","\n","R2: 94 Parquet files\n","First 3 filenames: ['synthetic_mainline_2030_06_01.parquet', 'synthetic_mainline_2030_06_03.parquet', 'synthetic_mainline_2030_06_04.parquet']\n","\n","R3: 92 Parquet files\n","First 3 filenames: ['synthetic_mainline_2030_06_13.parquet', 'synthetic_mainline_2030_06_15.parquet', 'synthetic_mainline_2030_06_16.parquet']\n","\n","No common daily filename across all four sources.\n","\n","Template date range by regime:\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>mask_regime</th>\n","      <th>min</th>\n","      <th>max</th>\n","      <th>nunique</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>R1</td>\n","      <td>2030-06-02</td>\n","      <td>2031-02-11</td>\n","      <td>87</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>R2</td>\n","      <td>2030-06-01</td>\n","      <td>2031-02-25</td>\n","      <td>94</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>R3</td>\n","      <td>2030-06-13</td>\n","      <td>2031-02-28</td>\n","      <td>92</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["  mask_regime         min         max  nunique\n","0          R1  2030-06-02  2031-02-11       87\n","1          R2  2030-06-01  2031-02-25       94\n","2          R3  2030-06-13  2031-02-28       92"]},"metadata":{},"output_type":"display_data"}],"source":["\n","from pathlib import Path\n","import pandas as pd\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","\n","PANEL = \"D12_I405_N\"\n","TRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\n","TEMPLATE_PATH = (\n","    DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n",")\n","\n","KEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n","VALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n","\n","# 1. Load the template keys and count requested targets by regime.\n","template = pd.read_csv(TEMPLATE_PATH)\n","\n","print(\"Template rows:\", len(template))\n","print(\"\\nTarget rows by regime:\")\n","display(template.groupby(\"mask_regime\").size().rename(\"rows\").reset_index())\n","\n","print(\"\\nUnique timestamps in template:\", template[\"timestamp\"].nunique())\n","print(\"Template duplicate keys:\", template.duplicated(\n","    [\"panel\"] + KEYS + [\"mask_regime\"]\n",").sum())\n","\n","# 2. Identify available daily files in each source.\n","source_dirs = {\n","    \"unmasked\": TRAIN_ROOT / \"mainline_states\",\n","    \"R1\": TRAIN_ROOT / \"mainline_states_masked\" / \"mask_regime=R1\",\n","    \"R2\": TRAIN_ROOT / \"mainline_states_masked\" / \"mask_regime=R2\",\n","    \"R3\": TRAIN_ROOT / \"mainline_states_masked\" / \"mask_regime=R3\",\n","}\n","\n","date_to_file = {}\n","\n","for source_name, source_dir in source_dirs.items():\n","    files = sorted(source_dir.rglob(\"*.parquet\"))\n","    mapping = {p.name: p for p in files}\n","    date_to_file[source_name] = mapping\n","\n","    print(f\"\\n{source_name}: {len(files)} Parquet files\")\n","    print(\"First 3 filenames:\", [p.name for p in files[:3]])\n","\n","# 3. Find a filename/date available in all four sources.\n","common_names = set.intersection(\n","    *(set(mapping.keys()) for mapping in date_to_file.values())\n",")\n","\n","if common_names:\n","    chosen_name = sorted(common_names)[0]\n","    print(\"\\nCommon sample file:\", chosen_name)\n","else:\n","    chosen_name = None\n","    print(\"\\nNo common daily filename across all four sources.\")\n","\n","# 4. Compare the template with each regime's matching daily file.\n","if chosen_name is not None:\n","    for regime in [\"R1\", \"R2\", \"R3\"]:\n","        print(f\"\\n{'=' * 60}\\nREGIME {regime}: {chosen_name}\")\n","\n","        masked = pd.read_parquet(date_to_file[regime][chosen_name])\n","\n","        # Use the timestamp and station/link identifiers to match records.\n","        template_regime = template[\n","            template[\"mask_regime\"] == regime\n","        ].copy()\n","\n","        template_day = template_regime[\n","            template_regime[\"timestamp\"].str[:10]\n","            == chosen_name.replace(\"synthetic_mainline_\", \"\").replace(\".parquet\", \"\")\n","        ]\n","\n","        print(\"Masked file rows:\", len(masked))\n","        print(\"Template rows for this regime/date:\", len(template_day))\n","\n","        if template_day.empty:\n","            print(\"No matching template rows for this date.\")\n","            continue\n","\n","        # Check whether the requested template keys exist in the masked file.\n","        matched = template_day[KEYS].merge(\n","            masked[KEYS].drop_duplicates(),\n","            on=KEYS,\n","            how=\"left\",\n","            indicator=True,\n","        )\n","\n","        print(\"Template keys found in masked file:\",\n","              int((matched[\"_merge\"] == \"both\").sum()))\n","        print(\"Template keys absent from masked file:\",\n","              int((matched[\"_merge\"] == \"left_only\").sum()))\n","\n","        # Inspect missingness and flags in the masked file.\n","        print(\"\\nMasked file missing-value counts:\")\n","        display(masked[VALUE_COLS].isna().sum().rename(\"null_count\").reset_index(\n","            names=\"column\"\n","        ))\n","\n","        print(\"\\nEligibility and observation flags:\")\n","        flag_cols = [\n","            c for c in [\n","                \"pct_observed\", \"is_observed\", \"is_imputed\",\n","                \"is_score_eligible\", \"is_missing\"\n","            ] if c in masked.columns\n","        ]\n","        display(masked[flag_cols].describe().T)\n","\n","# 5. Inspect template rows by regime for the first few dates.\n","print(\"\\nTemplate date range by regime:\")\n","template[\"date_only\"] = template[\"timestamp\"].str[:10]\n","display(\n","    template.groupby(\"mask_regime\")[\"date_only\"]\n","    .agg([\"min\", \"max\", \"nunique\"])\n","    .reset_index()\n",")\n"]},{"cell_type":"code","execution_count":5,"id":"6a93e9c7","metadata":{"execution":{"iopub.execute_input":"2026-10-19T19:59:47.659248Z","iopub.status.busy":"2026-10-19T19:59:47.658882Z","iopub.status.idle":"2026-10-19T19:59:50.878674Z","shell.execute_reply":"202