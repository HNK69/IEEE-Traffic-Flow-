 print(\"Columns:\", df.columns.tolist())\n        display(df.head(5))\n\n        if filename == \"links.csv\":\n            network_summaries.append({\n                \"panel\": panel,\n                \"file\": filename,\n                \"rows\": len(df),\n                \"columns\": \", \".join(df.columns),\n            })\n\n        elif filename == \"lwr_mainline_topology.csv\":\n            network_summaries.append({\n                \"panel\": panel,\n                \"file\": filename,\n                \"rows\": len(df),\n                \"columns\": \", \".join(df.columns),\n            })\n\n        elif filename == \"fd_parameters.csv\":\n            fd_summaries.append({\n                \"panel\": panel,\n                \"rows\": len(df),\n                \"columns\": \", \".join(df.columns),\n            })\n\nprint(\"\\nNETWORK FILE SUMMARY\")\ndisplay(pd.DataFrame(network_summaries))\n\nprint(\"\\nFUNDAMENTAL DIAGRAM FILE SUMMARY\")\ndisplay(pd.DataFrame(fd_summaries))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:34:41.179396Z","iopub.execute_input":"2026-10-19T19:34:41.180669Z","iopub.status.idle":"2026-10-19T19:34:41.962514Z","shell.execute_reply.started":"2026-10-19T19:34:41.180617Z","shell.execute_reply":"2026-10-19T19:34:41.961103Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"\n======================================================================\nPANEL: D12_I405_N\n\nlinks.csv\nRows: 89\nColumns: ['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"     link_id  length_km  lanes  free_speed_kmh  capacity_vph\n0  L405N-003      0.699    3.0           111.7       8006.40\n1  L405N-010      0.156    3.0           115.4       6308.28\n2  L405N-013      0.216    5.0           116.8       8006.40\n3  L405N-030      0.363    6.0           115.6       8006.40\n4  L405N-029      0.024    6.0           115.4      1