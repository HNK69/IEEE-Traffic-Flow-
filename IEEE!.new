77.253396</td>\n","      <td>42908</td>\n","    </tr>\n","    <tr>\n","      <th>0</th>\n","      <td>D12_I405_N</td>\n","      <td>Friday</td>\n","      <td>113.377583</td>\n","      <td>115.246306</td>\n","      <td>4380.450495</td>\n","      <td>42743</td>\n","    </tr>\n","    <tr>\n","      <th>...</th>\n","      <td>...</td>\n","      <td>...</td>\n","      <td>...</td>\n","      <td>...</td>\n","      <td>...</td>\n","      <td>...</td>\n","    </tr>\n","    <tr>\n","      <th>69</th>\n","      <td>D7_I405_S</td>\n","      <td>Wednesday</td>\n","      <td>109.383571</td>\n","      <td>112.883791</td>\n","      <td>4036.418273</td>\n","      <td>52225</td>\n","    </tr>\n","    <tr>\n","      <th>67</th>\n","      <td>D7_I405_S</td>\n","      <td>Thursday</td>\n","      <td>109.384704</td>\n","      <td>112.923978</td>\n","      <td>4281.033784</td>\n","      <td>52421</td>\n","    </tr>\n","    <tr>\n","      <th>63</th>\n","      <td>D7_I405_S</td>\n","      <td>Friday</td>\n","      <td>112.511013</td>\n","      <td>113.064753</td>\n","      <td>4087.584972</td>\n","      <td>52522</td>\n","    </tr>\n","    <tr>\n","      <th>65</th>\n","      <td>D7_I405_S</td>\n","      <td>Saturday</td>\n","      <td>109.563283</td>\n","      <td>112.932278</td>\n","      <td>4129.572507</td>\n","      <td>52043</td>\n","    </tr>\n","    <tr>\n","      <th>66</th>\n","      <td>D7_I405_S</td>\n","      <td>Sunday</td>\n","      <td>105.563064</td>\n","      <td>112.626775</td>\n","      <td>4244.504585</td>\n","      <td>52143</td>\n","    </tr>\n","  </tbody>\n","</table>\n","<p>70 rows × 6 columns</p>\n","</div>"],"text/plain":["         panel weekday_utc  mean_speed_kmh  median_speed_kmh  mean_flow_vph  \\\n","1   D12_I405_N      Monday      114.479721        115.307921    3869.123177   \n","5   D12_I405_N     Tuesday      114.427732        115.255878    3893.183754   \n","6   D12_I405_N   Wednesday      114.720796        115.314663    3881.130171   \n","4   D12_I405_N    Thursday      113.348972        115.263223    4377.253396   \n","0   D12_I405_N      Friday      113.377583        115.246306    4380.450495   \n","..         ...         ...             ...               ...            ...   \n","69   D7_I405_S   Wednesday      109.383571        112.883791    4036.418273   \n","67   D7_I405_S    Thursday      109.384704        112.923978    4281.033784   \n","63   D7_I405_S      Friday      112.511013        113.064753    4087.584972   \n","65   D7_I405_S    Saturday      109.563283        112.932278    4129.572507   \n","66   D7_I405_S      Sunday      105.563064        112.626775    4244.504585   \n","\n","    row_count  \n","1       42794  \n","5       42855  \n","6       42826  \n","4       42908  \n","0       42743  \n","..        ...  \n","69      52225  \n","67      52421  \n","63      52522  \n","65      52043  \n","66      52143  \n","\n","[70 rows x 6 columns]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Saved updated hourly, weekday, sampling-audit, and weekday-coverage CSV files.\n"]}],"source":["\n","from pathlib import Path\n","import pandas as pd\n","import numpy as np\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","CORRIDORS_ROOT = DATA_ROOT / \"corridors\"\n","\n","corridors = sorted(\n","    p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir()\n",")\n","\n","# Target a reproducible sample across all weekdays.\n","DAYS_PER_WEEKDAY = 2\n","sample_frames = []\n","sampling_audit = []\n","\n","for panel in corridors:\n","    mainline_dir = CORRIDORS_ROOT / panel / \"train\" / \"mainline_states\"\n","    files = sorted(mainline_dir.rglob(\"*.parquet\"))\n","\n","    if not files:\n","        print(f\"No mainline files found for {panel}\")\n","        continue\n","\n","    # Read the actual date from each file's timestamp.\n","    # Do not infer dates from filenames.\n","    file_dates = []\n","\n","    for file_path in files:\n","        date_values = pd.read_parquet(\n","            file_path, columns=[\"timestamp\"]\n","        )[\"timestamp\"]\n","\n","        timestamps = pd.to_datetime(\n","            date_values, utc=True, errors=\"coerce\"\n","        ).dropna()\n","\n","        if timestamps.empty:\n","            continue\n","\n","        unique_dates = timestamps.dt.strftime(\"%Y-%m-%d\").unique()\n","\n","        if len(unique_dates) != 1:\n","            print(\n","                f\"Skipping file with multiple UTC dates: {file_path}\"\n","            )\n","            continue\n","\n","        file_dates.append((file_path, unique_dates[0]))\n","\n","    date_map = pd.DataFrame(file_dates, columns=[\"file_path\", \"date\"])\n","    date_map[\"date\"] = pd.to_datetime(date_map[\"date\"], errors=\"raise\")\n","    date_map = date_map.drop_duplicates(subset=[\"date\"]).sort_values(\"date\")\n","    date_map[\"weekday\"] = date_map[\"date\"].dt.day_name()\n","\n","    # Select up to two dates per weekday, spread across that weekday's\n","    # available dates. Actual coverage is reported below.\n","    selected = []\n","\n","    for weekday_name, group in date_map.groupby(\"weekday\", sort=False):\n","        group = group.sort_values(\"date\")\n","        n = min(DAYS_PER_WEEKDAY, len(group))\n","\n","        positions = np.linspace(0, len(group) - 1, n, dtype=int)\n","        selected.extend(group.iloc[positions].to_dict(\"records\"))\n","\n","    selected_df = pd.DataFrame(selected).sort_values(\"date\")\n","\n","    sampling_audit.append({\n","        \"panel\": panel,\n","        \"available_dates\": len(date_map),\n","        \"selected_dates\": len(selected_df),\n","        \"selected_weekdays\": \", \".join(\n","            sorted(selected_df[\"weekday\"].unique())\n","        ),\n","        \"weekday_counts\": selected_df[\"weekday\"].value_counts().to_dict(),\n","    })\n","\n","    for row in selected_df.itertuples(index=False):\n","        df = pd.read_parquet(\n","            row.file_path,\n","            columns=[\n","                \"timestamp\", \"speed_kmh\", \"flow_vph\",\n","                \"is_score_eligible\"\n","            ],\n","        )\n","        df[\"panel\"] = panel\n","        sample_frames.append(df)\n","\n","if not sample_frames:\n","    raise RuntimeError(\"No valid daily files were sampled.\")\n","\n","eda_sample = pd.concat(sample_frames, ignore_index=True)\n","\n","eda_sample[\"timestamp\"] = pd.to_datetime(\n","    eda_sample[\"timestamp\"], utc=True, errors=\"coerce\"\n",")\n","eda_sample = eda_sample.dropna(subset=[\"timestamp\"])\n","\n","eda_sample[\"hour_utc\"] = eda_sample[\"timestamp\"].dt.hour\n","eda_sample[\"weekday_utc\"] = eda_sample[\"timestamp\"].dt.day_name()\n","\n","valid = eda_sample.dropna(\n","    subset=[\"speed_kmh\", \"flow_vph\"]\n",").copy()\n","\n","print(\"Sample rows:\", len(eda_sample))\n","print(\"Rows with speed and flow available:\", len(valid))\n","print(\"Panels represented:\", valid[\"panel\"].nunique())\n","\n","print(\"\\n1. Sampling coverage by corridor\")\n","sampling_audit_df = pd.DataFrame(sampling_audit)\n","display(sampling_audit_df)\n","\n","print(\"\\n2. Actual weekday coverage in sampled traffic rows\")\n","weekday_coverage = (\n","    eda_sample.groupby([\"panel\", \"weekday_utc\"])\n","    .size()\n","    .rename(\"row_count\")\n","    .reset_index()\n",")\n","display(weekday_coverage)\n","\n","print(\"\\n3. Average traffic by hour and corridor\")\n","hourly = (\n","    valid.groupby([\"panel\", \"hour_utc\"], as_index=False)\n","    .agg(\n","        mean_speed_kmh=(\"speed_kmh\", \"mean\"),\n","        median_speed_kmh=(\"speed_kmh\", \"median\"),\n","        mean_flow_vph=(\"flow_vph\", \"mean\"),\n","        row_count=(\"speed_kmh\", \"size\"),\n","    )\n",")\n","display(hourly)\n","\n","print(\"\\n4. Average traffic by weekday and corridor\")\n","weekday_order = [\n","    \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\",\n","    \"Friday\", \"Saturday\", \"Sunday\"\n","]\n","\n","weekday = (\n","    valid.groupby([\"panel\", \"weekday_utc\"], as_index=False)\n","    .agg(\n","        mean_speed_kmh=(\"speed_kmh\", \"mean\"),\n","        median_speed_kmh=(\"speed_kmh\", \"median\"),\n","        mean_flow_vph=(\"flow_vph\", \"mean\"),\n","        row_count=(\"speed_kmh\", \"size\"),\n","    )\n",")\n","\n","weekday[\"weekday_utc\"] = pd.Categorical(\n","    weekday[\"weekday_utc\"],\n","    categories=weekday_order,\n","    ordered=True,\n",")\n","weekday = weekday.sort_values([\"panel\", \"weekday_utc\"])\n","display(weekday)\n","\n","# Save updated summaries and the sampling audit.\n","hourly.to_csv(\"/kaggle/working/task1_eda_hourly.csv\", index=False)\n","weekday.to_csv(\"/kaggle/working/task1_eda_weekday.csv\", index=False)\n","sampling_audit_df.to_csv(\n","    \"/kaggle/working/task1_eda_sampling_audit.csv\", index=False\n",")\n","weekday_coverage.to_csv(\n","    \"/kaggle/working/task1_eda_weekday_coverage.csv\", index=False\n",")\n","\n","print(\"\\nSaved updated hourly, weekday, sampling-audit, \"\n","      \"and weekday-coverage CSV files.\")\n"]},{"cell_type":"code","execution_count":11,"id":"44bf3909","metadata":{"execution":{"iopub.execute_input":"2026-10-19T20:39:58.480559Z","iopub.status.busy":"2026-10-19T20:39:58.480065Z","iopub.status.idle":"2026-10-19T20:39:59.225022Z","shell.execute_reply":"2026-10-19T20:39:59.223746Z"},"papermill":{"duration":0.760161,"end_time":"2026-10-19T20:39:59.227634+00:00","exception":false,"start_time":"2026-10-19T20:39:58.467473+00:00","status":"completed"},"scrolled":true,"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","======================================================================\n","PANEL: D12_I405_N\n","\n","links.csv\n","Rows: 89\n","Columns: ['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .