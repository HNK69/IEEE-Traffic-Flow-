td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":8},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D12_I405_N\"\nTRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\nTEMPLATE_PATH = DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTARGETS = [\"speed_kmh\", \"flow_vph\"]\n\ntemplate = pd.read_csv(TEMPLATE_PATH, dtype={\"timestamp\": str})\ntemplate[\"date_only\"] = template[\"timestamp\"].str[:10]\n\nresults = []\n\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    masked_dir = TRAIN_ROOT / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n    masked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\n    print(f\"\\nChecking {regime}: {len(masked_files)} masked daily files\")\n\n    for i, masked_path in enumerate(masked_files, start=1):\n        filename_date = masked_path.stem.replace(\"synthetic_mainline_\", \"\")\n        date_text = filename_date.replace(\"_\", \"-\")\n\n        truth_path = (\n            TRAIN_ROOT\n            / \"mainline_states\"\n            / f\"year_month={date_text[:7]}\"\n            / masked_path.name\n        )\n\n        target_day = template.loc[\n            (template[\"mask_regime\"] == regime)\n            & (template[\"date_only\"] == date_text),\n            KEYS,\n        ].copy()\n\n        if not truth_path.is_file():\n            results.append({\n                \"regime\": regime,\n                \"date\": date_text,\n                \"status\": \"missing_truth_file\",\n                \"target_rows\": len(target_day),\n            })\n            continue\n\n        masked = pd.read_parquet(masked_path)\n        truth = pd.read_parquet(truth_path)\n\n        # Confirm the target keys occur in the masked input.\n        masked_match = target_day.merge(\n            masked[KEYS + TARGETS],\n            on=KEYS,\n            how=\"left\",\n            indicator=True,\n            validate=\"many_to_one\",\n        )\n\n        masked_found = masked_match[\"_merge\"].eq(\"both\")\n        masked_values = masked_match.loc[masked_found]\n\n        # Confirm the same keys occur in unmasked ground truth.\n        truth_cols = KEYS + TARGETS + [\"is_score_eligible\"]\n        truth_match = target_day.merge(\n            truth[truth_cols],\n            on=KEYS,\n            how=\"left\",\n            indicator=True,\n            validate=\"many_to_one\",\n        )\n\n        truth_found = truth_match[\"_merge\"].eq(\"both\")\n        truth_values = truth_match.loc[truth_found]\n\n        results.append({\n            \"regime\": regime,\n            \"date\": date_text,\n            \"status\": \"ok\",\n            \"target_rows\": len(target_day),\n            \"masked_keys_found\": int(masked_found.sum()),\n            \"masked_keys_missing\": int((~masked_found).sum()),\n            \"masked_speed_nonnull\": int(masked_values[\"speed_kmh\"].notna().sum()),\n            \"masked_flow_nonnull\": int(masked_values[\"flow_vph\"].notna().sum()),\n            \"truth_keys_found\": int(truth_found.sum()),\n            \"truth_keys_missing\": int((~truth_found).sum()),\n            \"truth_speed_null\": int(truth_values[\"speed_kmh\"].isna().sum()),\n            \"truth_flow_null\": int(truth_values[\"flow_vph\"].isna().sum()),\n            \"truth_score_eligible\": int(\n                truth_values[\"is_score_eligible\"].eq(1).sum()\n            ),\n        })\n\n        if i % 20 == 0 or i == len(masked_files):\n            print(f\"  Processed {i}/{len(masked_files)} files\")\n\nresults_df = pd.DataFrame(results)\n\nprint(\"\\nPer-regime summary:\")\ndisplay(\n    results_df.groupby([\"regime\", \"status\"], dropna=False)\n    .agg(\n        dates=(\"date\", \"count\"),\n        target_rows=(\"target_rows\", \"sum\"),\n        masked_keys_missing=(\"masked_keys_missing\", \"sum\"),\n        truth_keys_missing=(\"truth_keys_missing\", \"sum\"),\n        truth_speed_null=(\"truth_speed_null\", \"sum\"),\n        truth_flow_null=(\"truth_flow_null\", \"sum\"),\n        truth_score_eligible=(\"truth_score_eligible\", \"sum\"),\n    )\n    .reset_index()\n)\n\nprint(\"\\nDates with any issue:\")\nissue_rows = results_df[\n    (results_df[\"status\"] != \"ok\")\n    | (results_df.get(\"masked_keys_missing\", 0) > 0)\n    | (results_df.get(\"truth_keys_missing\", 0) > 0)\n    | (results_df.get(\"truth_speed_null\", 0) > 0)\n    | (results_df.get(\"truth_flow_null\", 0) > 0)\n]\n\ndisplay(issue_rows)\n\nprint(\"\\nTotal target rows in template:\", len(template))\nprint(\"Total target rows covered by checked daily files:\",\n      int(results_df.loc[results_df[\"status\"] == \"ok\", \"target_rows\"].sum()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:33:13.627456Z","iopub.execute_input":"2026-10-19T18:33:13.627971Z","iopub.status.idle":"2026-10-19T18:35:49.07854Z","shell.execute_reply.started":"2026-10-19T18:33:13.627937Z","shell.execute_reply":"2026-10-19T18:35:49.077468Z"}},"outputs":[{"name":"stdout","text":"\nChecking R1: 87 masked daily files\n  Processed 20/87 files\n  Processed 40/87 files\n  Processed 60/87 files\n  Processed 80/87 files\n  Processed 87/87 files\n\nChecking R2: 94 masked daily files\n  Processed 20/94 files\n  Processed 40/94 files\n  Processed 60/94 files\n  Processed 80/94 files\n  Processed 94/94 files\n\nChecking R3: 92 masked daily files\n  Processed 20/92 files\n  Processed 40/92 files\n  Processed 60/92 files\n  Processed 80/92 files\n  Processed 92/92 files\n\nPer-regime summary:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  regime status  dates  target_rows  masked_keys_missing  truth_keys_missing  \\\n0     R1     ok     87       340450                    0                   0   \n1 