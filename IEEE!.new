 4 columns</p>\n","</div>"],"text/plain":["                                          relative_path  \\\n","0        corridors/D12_I405_N/network/fd_parameters.csv   \n","1                corridors/D12_I405_N/network/links.csv   \n","2     corridors/D12_I405_N/network/lwr_mainline_topo...   \n","3     corridors/D12_I405_N/network/path_link_inciden...   \n","4             corridors/D12_I405_N/network/path_set.csv   \n","...                                                 ...   \n","9485  corridors/D7_I405_S/validation/ramp_states/yea...   \n","9486  corridors/D7_I405_S/validation/ramp_states/yea...   \n","9487  corridors/D7_I405_S/validation/ramp_states/yea...   \n","9488  corridors/D7_I405_S/validation/ramp_states/yea...   \n","9489  corridors/D7_I405_S/validation/ramp_states/yea...   \n","\n","                              file_name extension  size_mb  \n","0                     fd_parameters.csv      .csv    0.005  \n","1                             links.csv      .csv    0.003  \n","2             lwr_mainline_topology.csv      .csv    0.013  \n","3               path_link_incidence.csv      .csv    0.734  \n","4                          path_set.csv      .csv    0.376  \n","...                                 ...       ...      ...  \n","9485  synthetic_ramp_2031_03_27.parquet  .parquet    0.289  \n","9486  synthetic_ramp_2031_03_28.parquet  .parquet    0.291  \n","9487  synthetic_ramp_2031_03_29.parquet  .parquet    0.288  \n","9488  synthetic_ramp_2031_03_30.parquet  .parquet    0.275  \n","9489  synthetic_ramp_2031_03_31.parquet  .parquet    0.273  \n","\n","[9490 rows x 4 columns]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Corridor directories found: 10\n","First corridor names: ['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I10_E']\n","\n","Immediate structure under corridors/D12_I405_N:\n","DIR   network\n","DIR   private\n","DIR   train\n","DIR   validation\n"]}],"source":["\n","from pathlib import Path\n","import pandas as pd\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","CORRIDORS_ROOT = DATA_ROOT / \"corridors\"\n","\n","if not CORRIDORS_ROOT.exists():\n","    raise FileNotFoundError(f\"Corridors directory not found: {CORRIDORS_ROOT}\")\n","\n","# Find files whose paths or names relate to Task 1 state reconstruction.\n","keywords = (\n","    \"mainline_states\",\n","    \"ramp\",\n","    \"network\",\n","    \"fd_parameters\",\n",")\n","\n","records = []\n","\n","for path in CORRIDORS_ROOT.rglob(\"*\"):\n","    if not path.is_file():\n","        continue\n","\n","    path_text = str(path.relative_to(DATA_ROOT)).lower()\n","\n","    if any(keyword in path_text for keyword in keywords):\n","        records.append({\n","            \"relative_path\": str(path.relative_to(DATA_ROOT)),\n","            \"file_name\": path.name,\n","            \"extension\": path.suffix.lower(),\n","            \"size_mb\": round(path.stat().st_size / (1024 ** 2), 3),\n","        })\n","\n","files_df = pd.DataFrame(records)\n","\n","print(f\"Matching files found: {len(files_df)}\")\n","\n","if files_df.empty:\n","    print(\"No matching files found. We will inspect the directory structure next.\")\n","else:\n","    # Summarize file types without hiding the full path inventory.\n","    print(\"\\nFile extensions:\")\n","    display(files_df[\"extension\"].value_counts().rename_axis(\"extension\").to_frame(\"count\"))\n","\n","    print(\"\\nFile counts by filename:\")\n","    display(\n","        files_df.groupby(\"file_name\")\n","        .agg(file_count=(\"relative_path\", \"count\"),\n","             total_size_mb=(\"size_mb\", \"sum\"))\n","        .sort_values(\"file_count\", ascending=False)\n","        .reset_index()\n","    )\n","\n","    print(\"\\nAll matching paths:\")\n","    display(files_df.sort_values(\"relative_path\").reset_index(drop=True))\n","\n","# Also show the immediate structure under one corridor, if available.\n","panels = sorted(p.name for p in CORRIDORS_ROOT.iterdir() if p.is_dir())\n","\n","print(f\"\\nCorridor directories found: {len(panels)}\")\n","print(\"First corridor names:\", panels[:5])\n","\n","if panels:\n","    example_panel = CORRIDORS_ROOT / panels[0]\n","    print(f\"\\nImmediate structure under {example_panel.relative_to(DATA_ROOT)}:\")\n","    for path in sorted(example_panel.iterdir()):\n","        print((\"DIR \" if path.is_dir() else \"FILE\") + f\"  {path.name}\")\n"]},{"cell_type":"code","execution_count":2,"id":"8bfd2bf4","metadata":{"execution":{"iopub.execute_input":"2026-10-19T19:59:42.238492Z","iopub.status.busy":"2026-10-19T19:59:42.23784Z","iopub.status.idle":"2026-10-19T19:59:42.429635Z","shell.execute_reply":"2026-10-19T19:59:42.428508Z"},"papermill":{"duration":0.198608,"end_time":"2026-10-19T19:59:42.431815+00:00","exception":false,"start_time":"2026-10-19T19:59:42.233207+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training root: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D12_I405_N/train\n","\n","Immediate contents:\n","DIR   mainline_states\n","DIR   mainline_states_masked\n","DIR   ramp_states\n","\n","Total training files for D12_I405_N: 819\n","\n","Files grouped by folder:\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>parent_folder</th>\n","      <th>file_count</th>\n","      <th>total_size_mb</th>\n","      <th>examples</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      