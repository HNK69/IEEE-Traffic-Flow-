h/kaggle_public\"\n)\n\nPANEL = \"D12_I405_N\"\nTRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\nTEMPLATE_ROOT = DATA_ROOT / \"task1\" / PANEL / \"train\"\n\nif not TRAIN_ROOT.is_dir():\n    raise FileNotFoundError(f\"Training directory not found: {TRAIN_ROOT}\")\n\n# 1. Inspect immediate entries in the training directory\nprint(f\"Training root: {TRAIN_ROOT}\")\nprint(\"\\nImmediate contents:\")\n\nfor path in sorted(TRAIN_ROOT.iterdir()):\n    kind = \"DIR \" if path.is_dir() else \"FILE\"\n    print(f\"{kind}  {path.name}\")\n\n# 2. Inventory all files under this corridor's training directory\nrecords = []\n\nfor path in sorted(TRAIN_ROOT.rglob(\"*\")):\n    if path.is_file():\n        records.append({\n            \"relative_path\": str(path.relative_to(TRAIN_ROOT)),\n            \"parent_folder\": str(path.parent.relative_to(TRAIN_ROOT)),\n            \"file_name\": path.name,\n            \"extension\": path.suffix.lower(),\n            \"size_mb\": round(path.stat().st_size / (1024 ** 2), 3),\n        })\n\npanel_train_files = pd.DataFrame(records)\n\nprint(f\"\\nTotal training files for {PANEL}: {len(panel_train_files)}\")\n\n# 3. Summarize files by their immediate parent folder\nprint(\"\\nFiles grouped by folder:\")\ndisplay(\n    panel_train_files.groupby(\"parent_folder\")\n    .agg(\n        file_count=(\"file_name\", \"count\"),\n        total_size_mb=(\"size_mb\", \"sum\"),\n        examples=(\"file_name\", lambda x: \", \".join(x.head(3))),\n    )\n    .reset_index()\n    .sort_values(\"parent_folder\")\n)\n\n# 4. Inspect the exact file paths and filenames\nprint(\"\\nComplete training file inventory:\")\ndisplay(panel_train_files)\n\n# 5. Check the Task 1 template separately\nprint(f\"\\nTask 1 template directory: {TEMPLATE_ROOT}\")\n\nif TEMPLATE_ROOT.is_dir():\n    for path in sorted(TEMPLATE_ROOT.iterdir()):\n        if path.is_file():\n            print(\n                f\"{path.name} | \"\n                f\"{path.stat().st_size / (1024 ** 2):.3f} MB\"\n            )\nelse:\n    print(\"Task 1 template directory not found.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:27:17.317819Z","iopub.execute_input":"2026-10-19T18:27:17.31834Z","iopub.status.idle":"2026-10-19T18:27:18.453193Z","shell.execute_reply.started":"2026-10-19T18:27:17.318309Z","shell.execute_reply":"2026-10-19T18:27:18.451777Z"}},"outputs":[{"name":"stdout","text":"Training root: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D12_I405_N/train\n\nImmediate contents:\nDIR   mainline_states\nDIR   mainline_states_masked\nDIR   ramp_states\n\nTotal training files for D12_I405_N: 819\n\nFiles grouped by folder:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                            parent_folder  file_count  total_size_mb  \\\n0      mainline_states/year_month=2030-06          30         25.908   \n1      mainline_states/year_month=2030-07          31         26.710   \n2      mainline_states/year_month=2030-08          31         26.782   \n3      mainline_states/year_month=2030-09          30         25.886   \n4      mainline_states/year_month=2030-10          31         26.734   \n5      mainline_states/year_month=2030-11          30         25.859   \n6      mainline_states/year_month=2030-12          31         26.783   \n7      mainline_states/year_month=2031-01          31         26.779   \n8      mainline_states/year_month=2031-02          28         24.208   \n9   mainline_states_masked/mask_regime=R1          87         61.762   \n10  mainline_states_masked/mask_regime=R2          94         59.625   \n11  mainline_states_masked/mask_regime=R3          92         45.012   \n12         ramp_states/year_month=2030-06          30          4.190   \n13         ramp_states/year_month=2030-07          31          4.329   \n14         ramp_states/year_month=2030-08          31          4.338   \n15         ramp_states/y