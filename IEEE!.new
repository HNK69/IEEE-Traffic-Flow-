\n","    files = sorted(regime_dir.rglob(\"*.parquet\"))\n","\n","    if not files:\n","        print(f\"No Parquet files found for {regime}\")\n","        continue\n","\n","    sample_path = files[0]\n","\n","    # Convert 2030_06_02 -> 2030-06-02\n","    filename_date = sample_path.stem.replace(\"synthetic_mainline_\", \"\")\n","    date_text = filename_date.replace(\"_\", \"-\")\n","\n","    print(f\"\\n{'=' * 60}\")\n","    print(f\"Regime: {regime} | Date: {date_text}\")\n","\n","    masked = pd.read_parquet(sample_path)\n","    target_day = template[\n","        (template[\"mask_regime\"] == regime)\n","        & (template[\"date_only\"] == date_text)\n","    ].copy()\n","\n","    print(\"Masked file rows:\", len(masked))\n","    print(\"Template target rows:\", len(target_day))\n","\n","    if target_day.empty:\n","        print(\"Still no target rows for this regime/date.\")\n","        continue\n","\n","    comparison = target_day[KEYS].merge(\n","        masked[KEYS + [\"speed_kmh\", \"flow_vph\"]],\n","        on=KEYS,\n","        how=\"left\",\n","        indicator=True,\n","        validate=\"many_to_one\",\n","    )\n","\n","    matched = comparison[\"_merge\"].eq(\"both\")\n","    matched_rows = comparison.loc[matched]\n","\n","    result = {\n","        \"regime\": regime,\n","        \"date\": date_text,\n","        \"masked_rows\": len(masked),\n","        \"target_rows\": len(target_day),\n","        \"matched_keys\": int(matched.sum()),\n","        \"unmatched_keys\": int((~matched).sum()),\n","        \"matched_null_speed\": int(matched_rows[\"speed_kmh\"].isna().sum()),\n","        \"matched_null_flow\": int(matched_rows[\"flow_vph\"].isna().sum()),\n","    }\n","    results.append(result)\n","\n","    print(\"Matched target keys:\", result[\"matched_keys\"])\n","    print(\"Unmatched target keys:\", result[\"unmatched_keys\"])\n","    print(\"Matched keys with null speed:\", result[\"matched_null_speed\"])\n","    print(\"Matched keys with null flow:\", result[\"matched_null_flow\"])\n","\n","print(\"\\nSUMMARY\")\n","display(pd.DataFrame(results))\n"]},{"cell_type":"code","execution_count":6,"id":"fd08027e","metadata":{"execution":{"iopub.execute_input":"2026-10-19T19:59:50.893145Z","iopub.status.busy":"2026-10-19T19:59:50.892778Z","iopub.status.idle":"2026-10-19T19:59:54.17943Z","shell.execute_reply":"2026-10-19T19:59:54.178489Z"},"papermill":{"duration":3.295248,"end_time":"2026-10-19T19:59:54.181443+00:00","exception":false,"start_time":"2026-10-19T19:59:50.886195+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=================================================================\n","Regime: R1 | Date: 2030-06-02\n","Ground-truth file: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_02.parquet\n","Template target rows: 3997\n","Ground-truth rows: 25632\n","Duplicate ground-truth keys: 0\n","Target keys found in ground truth: 3997\n","Target keys absent from ground truth: 0\n","Ground-truth speed nulls: 0\n","Ground-truth flow nulls: 0\n","Ground-truth score-eligible rows: 3997\n","Rows with pct_observed >= 75: 3997\n","\n","=================================================================\n","Regime: R2 | Date: 2030-06-01\n","Ground-truth file: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_01.parquet\n","Template target rows: 5907\n","Ground-truth rows: 25632\n","Duplicate ground-truth keys: 0\n","Target keys found in ground truth: 5907\n","Target keys absent from ground truth: 0\n","Ground-truth speed nulls: 0\n","Ground-truth flow nulls: 0\n","Ground-truth score-eligible rows: 5907\n","Rows with pct_observed >= 75: 5907\n","\n","=================================================================\n","Regime: R3 | Date: 2030-06-13\n","Ground-truth file: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_13.parquet\n","Template tar