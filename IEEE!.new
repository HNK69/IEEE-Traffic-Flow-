 <td>2030-06-02</td>\n      <td>2031-02-11</td>\n      <td>87</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>R2</td>\n      <td>2030-06-01</td>\n      <td>2031-02-25</td>\n      <td>94</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>R3</td>\n      <td>2030-06-13</td>\n      <td>2031-02-28</td>\n      <td>92</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":5},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D12_I405_N\"\nTRAIN_ROOT = DATA_ROOT / \"corridors\" / PANEL / \"train\"\nTEMPLATE_PATH = DATA_ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ntemplate = pd.read_csv(TEMPLATE_PATH, dtype={\"timestamp\": str})\ntemplate[\"date_only\"] = template[\"timestamp\"].str[:10]\n\nresults = []\n\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    regime_dir = TRAIN_ROOT / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n    files = sorted(regime_dir.rglob(\"*.parquet\"))\n\n    if not files:\n        print(f\"No Parquet files found for {regime}\")\n        continue\n\n    sample_path = files[0]\n\n    # Convert 2030_06_02 -> 2030-06-02\n    filename_date = sample_path.stem.replace(\"synthetic_mainline_\", \"\")\n    date_text = filename_date.replace(\"_\", \"-\")\n\n    print(f\"\\n{'=' * 60}\")\n    print(f\"Regime: {regime} | Date: {date_text}\")\n\n    masked = pd.read_parquet(sample_path)\n    target_day = template[\n        (template[\"mask_regime\"] == regime)\n        & (template[\"date_only\"] == date_text)\n    ].copy()\n\n    print(\"Masked file rows:\", len(masked))\n    print(\"Template target rows:\", len(target_day))\n\n    if target_day.empty:\n        print(\"Still no target rows for this regime/date.\")\n        continue\n\n    comparison = target_day[KEYS].merge(\n        masked[KEYS + [\"speed_kmh\", \"flow_vph\"]],\n        on=KEYS,\n        how=\"left\",\n        indicator=True,\n        validate=\"many_to_one\",\n    )\n\n    matched = comparison[\"_merge\"].eq(\"both\")\n    matched_rows = comparison.loc[matched]\n\n    result = {\n        \"regime\": regime,\n        \"date\": date_text,\n        \"masked_rows\": len(masked),\n        \"target_rows\": len(target_day),\n        \"matched_keys\": int(matched.sum()),\n        \"unmatched_keys\": int((~matched).sum()),\n        \"matched_null_speed\": int(matched_rows[\"speed_kmh\"].isna().sum()),\n        \"matched_null_flow\": int(matched_rows[\"flow_vph\"].isna().sum()),\n    }\n    results.append(result)\n\n    print(\"Matched target keys:\", result[\"matched_keys\"])\n    print(\"Unmatched target keys:\", result[\"unmatched_keys\"])\n    print(\"Matched keys with null speed:\", result[\"matched_null_speed\"])\n    print(\"Matched keys with null flow:\", result[\"matched_null_flow\"])\n\nprint(\"\\nSUMMARY\")\ndisplay(pd.DataFrame(results))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:31:26.091428Z","iopub.execute_input":"2026-10-19T18:31:26.09334Z","iopub.status.idle":"2026-10-19T18:31:30.201789Z","shell.execute_reply.started":"2026-10-19T18:31:26.093279Z","shell.execute_reply":"2026-10-19T18:31:30.200532Z"}},"outputs":[{"name":"stdout","text":"\n============================================================\nRegime: R1 | Date: 2030-06-02\nMasked file rows: 25632\nTemplate target rows: 3997\nMatched target keys: 3997\nUnmatched target keys: 0\nMatched keys with null speed: 3997\nMatched keys with null flow: 3997\n\n============================================================\nRegime: R2 | Date: 2030-06-01\nMasked file rows: 25632\nTemplate target rows: 5907\nMatched target keys: 5907\nUnmatched target keys: 0\nMatched keys with null speed: 5907\nMatched keys with null flow: 5907\n\n============================================================\nRegime: 