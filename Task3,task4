, \"mask_regime\"\n]\n\nif joined[natural_key].isna().any().any():\n    raise ValueError(\"Null values found in natural-key columns.\")\n\nif joined.duplicated(natural_key).any():\n    raise ValueError(\"Duplicate natural keys in evaluator input.\")\n\nrequired = {\n    \"panel\", \"timestamp\", \"station_id\", \"link_id\",\n    \"mask_regime\", \"speed_kmh\", \"flow_vph\",\n}\nif not required.issubset(joined.columns):\n    raise ValueError(\"Evaluator input is missing required columns.\")\n\n# Save only to /kaggle/working, never to the original dataset.\njoined.to_csv(STATE_OUT, index=False)\n\nprint(f\"Validated evaluator rows: {len(joined):,}\")\nprint(\"Evaluator input saved:\", STATE_OUT)\n\ndel key, pred, joined\n\n# ----------------------- RUN EVALUATOR ----------------------------\n\ncmd = [\n    sys.executable,\n    str(SCORER),\n    \"--state-submission\", str(STATE_OUT),\n    \"--release-root\", str(RELEASE),\n    \"--split\", \"validation\",\n    \"--modes-config\", str(MODES),\n    \"--output\", str(REPORT_OUT),\n]\n\nprint(\"\\nRunning public Task 3 evaluator...\")\nresult = subprocess.run(\n    cmd,\n    cwd=str(REPO),\n    text=True,\n    capture_output=True,\n)\n\nif result.stdout:\n    print(result.stdout[-12000:])\n\nif result.returncode != 0:\n    if result.stderr:\n        print(result.stderr[-12000:])\n    raise RuntimeError(\n        \"Task 3 evaluator failed. Do not interpret a partial report.\"\n    )\n\nif not REPORT_OUT.is_file():\n    raise FileNotFoundError(\n        f\"Evaluator completed but report was not created: {REPORT_OUT}\"\n    )\n\n# ----------------------- CHECK AND DISPLAY REPORT -----------------\n\nreport = pd.read_csv(REPORT_OUT)\n\nif report.empty:\n    raise ValueError(\"Evaluator report is empty.\")\n\nif not {\"level\", \"panel\", \"regime\", \"S_physics\"}.issubset(report.columns):\n    raise ValueError(\n        \"Report schema differs from expected public evaluator output. \"\n        f\"Actual columns: {report.colu