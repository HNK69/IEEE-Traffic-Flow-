= 1\n    mn, mx = int(ts.min()), int(ts.max())\n    if cnt[\"max_ns\"] is not None and mn < cnt[\"max_ns\"]:\n        cnt[\"ooo_chunks\"] += 1\n    cnt[\"min_ns\"] = mn if cnt[\"min_ns\"] is None else min(cnt[\"min_ns\"], mn)\n    cnt[\"max_ns\"] = mx if cnt[\"max_ns\"] is None else max(cnt[\"max_ns\"], mx)\n    cnt[\"rows\"] += out.num_rows; cnt[\"chunks\"] += 1\n    for c in SPD:\n        cnt[\"spd_null\"][c] += out[c].null_count\n    for c in ELG:\n        m = pc.min_max(out[c]); assert m[\"min\"].as_py() >= 0 and m[\"max\"].as_py() <= 1, f\"{c} not binary\"\n        cnt[\"elg_one\"][c] += int(pc.sum(out[c]).as_py() or 0)\n    for c in TGT:\n        m = pc.min_max(out[c])\n        if m[\"min\"].is_valid:\n            assert m[\"min\"].as_py() >= 0 and m[\"max\"].as_py() <= 1, f\"{c} outside {{0,1}}\"\n        cnt[\"tgt_null\"][c] += out[c].null_count\n        cnt[\"tgt_one\"][c] += int(pc.sum(out[c]).as_py() or 0)\n\ndef jsonable(cnt):\n    d = dict(cnt)\n    d[\"min_origin\"] = str(pd.Timestamp(cnt[\"min_ns\"], tz=\"UTC\"))\n    d[\"max_origin\"] = str(pd.Timestamp(cnt[\"max_ns\"], tz=\"UTC\"))\n    return d\n\ndef validate_existing(final, cjson, want_rows, want_chunks):\n    \"\"\"Metadata-level check only; the audit cell recomputes counts from the data.\"\"\"\n    if not (os.path.exists(final) and os.path.exists(cjson)):\n        return None, \"final file or counters JSON missing\"\n    try:\n        c = json.load(open(cjson))\n        if not REQUIRED_KEYS <= set(c): return None, \"counters JSON lacks required keys\"\n        if c[\"rows\"] != want_rows: return None, f\"counter rows {c['rows']} != {want_rows}\"\n        if c[\"chunks\"] != want_chunks: return None, f\"counter chunks {c['chunks']} != {want_chunks}\"\n        pf = pq.ParquetFile(final)\n        if pf.metadata.num_rows != want_rows: return None, f\"footer rows {pf.metadata.num_rows} != {want_rows}\"\n        if not pf.schema_arrow.equals(OUT_SCHEMA): return None, \"schema differs from OUT_SCHEMA\"\n    except Exception as e:\n        return None, f\"unreadable: {type(e).__name__}: {e}\"\n    return c, \"ok\"\n\ndef rm(p):\n    if os.path.exists(p):\n        os.remove(p); return True\n    return False\n\nos.makedirs(OUT, exist_ok=True)\nall_cnt, t0 = {}, time.time()\nprint(f\"free disk at start: {shutil.disk_usage(OUT).free/1e9:.1f} GB\")\nfor split in SPLITS:\n    os.makedirs(f\"{OUT}/{split}\", exist_ok=True)\n    for panel in sorted(LINKS):\n        final = f\"{OUT}/{split}/{panel}.parquet\"\n        cjson = f\"{OUT}/{split}/{panel}.counters.json\"\n        tmp, tmpj = final + \".tmp\", cjson + \".tmp\"\n        fps = sorted(glob.glob(f\"{ROOT}/{split}/{split}/*_{panel}_*_features.parquet\"))\n        assert fps, f\"no files for {panel} in {split}\"\n        want_rows = LINKS[panel] * ORIGINS[split]\n\n        if rm(tmp) | rm(tmpj):\n            print(f\"{split[:5]} {panel:<10} removed stale .tmp from an earlier failed run\")\n        c, why = validate_existing(final, cjson, want_rows, len(fps))\n        if c is not None:\n            all_cnt[(split, panel)] = c\n            print(f\"{split[:5]} {panel:<10} SKIP (existing output passed metadata validation)\"); continue\n        if os.path.exists(final) or os.path.exists(cjson):\n            print(f\"{split[:5]} {panel:<10} existing output rejected ({why}); deleting and rebuilding\")\n            rm(final); rm(cjson)\n\n        free = shutil.disk_usage(OUT).free          # checked immediately before this group is written\n        need_b = want_rows * BYTES_PER_ROW_PAD * DISK_MARGIN\n        assert free > need_b, f\"{split} {panel}: free {free/1e9:.1f} GB < required {need_b/1e9:.1f} GB\"\n\n        cnt, buf, buf_rows, writer = new_counters(), [], 0, None\n        try:\n            writer = pq.ParquetWriter(tmp, OUT_SCHEMA, compression=\"zstd\")\n            for fp in fps:\n                ft, tt, _ = load_pair(fp)\n                assert set(ft[\"panel\"].unique().to_pylist()) == {panel}, f\"panel mismatch: {fp}\"\n                out = transform(ft, tt)\n                verify(ft, tt, out)\n                update(cnt, out)\n                buf.append(out); buf_rows += out.num_rows\n                if buf_rows >= FLUSH_ROWS:\n                    writer.write_table(pa.concat_tables(buf)); buf, buf_rows = [], 0\n            if buf:\n                writer.write_table(pa.concat_tables(buf))\n            writer.close(); writer = None\n            assert cnt[\"rows\"] == want_rows, f\"{split} {panel}: rows {cnt['rows']} != {want_rows}\"\n            assert cnt[\"chunks\"] == len(fps), f\"{split} {panel}: chunks {cnt['chunks']} != {len(fps)}\"\n            with open(tmpj, \"w\") as f:\n                json.dump(jsonable(cnt), f, indent=1)\n            os.replace(tmp, final); os.replace(tmpj, cjson)\n        except BaseException:\n            if writer is not None:\n                try: writer.close()\n                except Exception: pass\n            rm(tmp); rm(tmpj)\n            print(f\"FAILED {split} {panel}: partial .tmp output removed\")\n            raise\n        all_cnt[(split, panel)] = jsonable(cnt)\n        print(f\"{split[:5]} {panel:<10} rows={cnt['rows']:>11,} chunks={cnt['chunks']:>5} \"\n              f\"ooo_chunks={cnt['ooo_chunks']} unsorted_in_chunk={cnt['unsorted_in_chunk']} \"\n              f\"size={os.path.getsize(final)/1e9:.2f} GB  free={shutil.disk_usage(OUT).free/1e9:.1f} GB \"\n              f\"[{time.time()-t0:.0f}s]\", flush=True)\n\ndef accept(split):\n    g = [all_cnt[(split, p)] for p in sorted(LINKS)]\n    P = PROFILE[split]\n    assert sum(x[\"chunks\"] for x in g) == EXPECT_FILES[split], f\"{split}: chunk total mismatch\"\n    rows = sum(x[\"rows\"] for x in g)\n    assert rows == P[\"rows\"], f\"{split}: rows {rows} != {P['rows']}\"\n    for c in SPD:\n        v = sum(x[\"spd_null\"][c] for x in g); assert v == P[\"spd_null\"][c], f\"{split} {c}: nulls {v} != {P['spd_null'][c]}\"\n    for c in ELG:\n        v = sum(x[\"elg_one\"][c] for x in g); assert v == P[\"elg_one\"][c], f\"{split} {c}: ones {v} != {P['elg_one'][c]}\"\n    for c in TGT:\n        nul = sum(x[\"tgt_null\"][c] for x in g); one = sum(x[\"tgt_one\"][c] for x in g)\n        assert nul == P[\"tgt_null\"][c], f\"{split} {c}: null {nul} != {P['tgt_null'][c]}\"\n        assert one == P[\"tgt_one\"][c], f\"{split} {c}: one {one} != {P['tgt_one'][c]}\"\n        assert rows - nul - one == P[\"tgt_zero\"][c], f\"{split} {c}: zero {rows-nul-one} != {P['tgt_zero'][c]}\"\n    print(f\"  {split}: ACCEPTED (12 speed-null, 12 eligibility-one, 6x null/0/1 counts all match the profile; \"\n          f\"ooo_chunks={sum(x['ooo_chunks'] for x in g)}, unsorted_in_chunk={sum(x['unsorted_in_chunk'] for x in g)})\")\n\npassed = []\nfor split in SPLITS:\n    accept(split); passed.append(split)\n\ntot = sum(os.path.getsize(f) for f in glob.glob(f\"{OUT}/*/*.parquet\"))\nprint(f\"\\nartifact total: {tot/1e9:.2f} GB   elapsed: {time.time()-t0:.0f}s\")\nif set(passed) == {\"train\", \"internal_validation\"}:\n    print(\"WRITE COMPLETE\")\nelse:\n    print(f\"PARTIAL: only {passed} accepted; not complete until both splits pass\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T06:05:42.495796Z","iopub.execute_input":"2026-10-13T06:05:42.501364Z","iopub.status.idle":"2026-10-13T06:24:16.363866Z","shell.execute_reply.started":"2026-10-13T06:05:42.50121Z","shell.execute_reply":"2026-10-13T06:24:16.361268Z"}},"outputs":[{"name":"stdout","text":"free disk at start: 20.9 GB\ntrain D12_I5_N   rows= 14,959,356 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.63 GB  free=20.3 GB [122s]\ntrain D12_I5_S   rows=  5,798,200 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.23 GB  free=20.1 GB [218s]\ntrain D7_I10_E   rows=  8,465,372 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.36 GB  free=19.7 GB [322s]\ntrain D7_I10_W   rows=  6,204,074 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.26 GB  free=19.5 GB [416s]\ntrain D7_I21