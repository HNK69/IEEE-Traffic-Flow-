 pa.int8()) for c in ELG]\n    + [(c, pa.int8()) for c in TGT])\n\n# Verified earlier: links per panel (constant per chunk) and origins per split (same for all panels)\nLINKS = {\"D12_I5_N\": 258, \"D12_I5_S\": 100, \"D7_I10_E\": 146, \"D7_I10_W\": 107,\n         \"D7_I210_E\": 297, \"D7_I210_W\": 81, \"D7_I405_N\": 352, \"D7_I405_S\": 109}\nORIGINS = {\"train\": 57_982, \"internal_validation\": 15_988}\nTOTAL_ROWS = 84_073_900 + 23_182_600\nassert sum(LINKS.values()) * ORIGINS[\"train\"] == 84_073_900\nassert sum(LINKS.values()) * ORIGINS[\"internal_validation\"] == 23_182_600\n\ndef load_pair(fp):\n    tp = fp.replace(\"_features.parquet\", \"_targets.parquet\")\n    ft, tt = pq.read_table(fp), pq.read_table(tp)\n    assert set(ft.column_names) == set(KEYS + SPD + ELG), f\"unexpected feature columns: {fp}\"\n    assert set(tt.column_names) == set(KEYS + TGT), f\"unexpected target columns: {tp}\"\n    for c in KEYS:                                   # metadata types checked, not assumed\n        want = OUT_SCHEMA.field(c).type\n        assert ft.schema.field(c).type == want, f\"feature '{c}' type {ft.schema.field(c).type} != {want}: {fp}\"\n        assert tt.schema.field(c).type == want, f\"target '{c}' type {tt.schema.field(c).type} != {want}: {tp}\"\n    assert ft.num_rows == tt.num_rows, f\"row count mismatch: {fp}\"\n    for c in KEYS:\n        assert ft[c].equals(tt[c]), f\"key '{c}' differs between feature and target file: {fp}\"\n    for c in TGT:\n        assert tt[c].type == pa.int8(), f\"{c} has type {tt[c].type}\"\n    for c in SPD:\n        assert ft[c].type == pa.float64(), f\"{c} has type {ft[c].type}\"\n    for c in ELG:\n        assert ft[c].type == pa.int64(), f\"{c} has type {ft[c].type}\"\n    return ft, tt, tp\n\ndef transform(ft, tt):\n    tbl = ft\n    for c in TGT:\n        tbl = tbl.append_column(c, tt[c])          # targets appended as-is: nulls untouched\n    return tbl.select(OUT_SCHEMA.names).cast(OUT_SCHEMA)   # safe cast: int64->int8 raises on overflow\n\ndef verify(ft, tt, out):\n    assert out.schema.equals(OUT_SCHEMA), \"output schema differs from OUT_SCHEMA\"\n    assert out.num_rows == ft.num_rows, \"row count changed\"\n    for c in KEYS:\n        assert out[c].equals(ft[c]), f\"metadata '{c}' changed\"\n    max_err = 0.0\n    for c in SPD:\n        assert pc.is_null(out[c]).equals(pc.is_null(ft[c])), f\"{c}: null positions changed\"\n        e = pc.max(pc.abs(pc.subtract(pc.cast(out[c], pa.float64()), ft[c]))).as_py()\n        max_err = max(max_err, e or 0.0)\n    assert max_err < 1e-5, f\"float32 cast error too large: {max_err}\"\n    for c in ELG:\n        assert out[c].null_count == 0, f\"{c}: nulls appeared\"\n        assert pc.all(pc.equal(pc.cast(out[c], pa.int64()), ft[c])).as_py(), f\"{c}: values changed\"\n    for c in TGT:\n        assert out[c].equals(tt[c]), f\"{c}: target changed (null/0/1 not preserved)\"\n    return max_err\n\nest_total, worst_err, n_pairs = 0.0, 0.0, 0\nfor split in [\"train\", \"internal_validation\"]:\n    print(f\"\\n== {split} ==\")\n    split_est = 0.0\n    for panel in sorted(LINKS):\n        fps = sorted(glob.glob(f\"{ROOT}/{split}/{split}/*_{panel}_*_features.parquet\"))\n        assert fps, f\"no files for {panel} in {split}\"\n        picks = sorted({fps[0], fps[len(fps) // 2], fps[-1]})\n        tables = []\n        for fp in picks:\n            ft, tt, _ = load_pair(fp)\n            assert set(ft[\"panel\"].unique().to_pylist()) == {panel}, f\"panel mismatch in {fp}\"\n            assert len(ft[\"link_id\"].unique()) == LINKS[panel], f\"link count differs in {fp}\"\n            out = transform(ft, tt)\n            worst_err = max(worst_err, verify(ft, tt, out))\n            tables.append(out); n_pairs += 1\n        big = pa.concat_tables(tables)\n        probe = \"/kaggle/working/_probe.parquet\"\n        pq.write_table(big, probe, compression=\"zstd\")\n        bpr = os.path.getsize(probe) / big.num_rows\n        os.remove(probe)\n        true_rows = LINKS[panel] * ORIGINS[split]\n        est = bpr * true_rows\n        split_est += est\n        print(f\"  {panel:<10} chunks={len(picks)} probe_rows={big.num_rows:>6} \"\n              f\"bytes/row={bpr:5.1f}  est_GB={est/1e9:5.2f}\")\n    print(f\"  {split} estimate: {split_est/1e9:.1f} GB\")\n    est_total += split_est\n\nfree = shutil.disk_usage(\"/kaggle/working\").free\nprint(f\"\\npairs verified: {n_pairs}   worst float32 error: {worst_err:.1e}\")\nprint(f\"rough artifact estimate: {est_total/1e9:.1f} GB (rows {TOTAL_ROWS:,})   free disk: {free/1e9:.1f} GB\")\nassert est_total * 1.3 < free, \"estimate x1.3 does not fit in free disk: decide on a smaller output before writing\"\nprint(\"UNIT CHECKS PASSED\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T05:47:25.698827Z","iopub.execute_input":"2026-10-13T05:47:25.699854Z","iopub.status.idle":"2026-10-13T05:47:28.684255Z","shell.execute_reply.started":"2026-10-13T05:47:25.699808Z","shell.execute_reply":"2026-10-13T05:47:28.683061Z"}},"outputs":[{"name":"stdout","text":"\n== train ==\n  D12_I5_N   chunks=3 probe_rows= 12900 bytes/row= 52.6  est_GB= 0.79\n  D12_I5_S   chunks=3 probe_rows=  5000 bytes/row= 47.0  est_GB= 0.27\n  D7_I10_E   chunks=3 probe_rows=  7300 bytes/row= 53.3  est_GB= 0.45\n  D7_I10_W   chunks=3 probe_rows=  5350 bytes/row= 51.4  est_GB= 0.32\n  D7_I210_E  chunks=3 probe_rows= 14850 bytes/row= 54.1  est_GB= 0.93\n  D7_I210_W  chunks=3 probe_rows=  4050 bytes/row= 49.9  est_GB= 0.23\n  D7_I405_N  chunks=3 probe_rows= 17600 bytes/row= 54.0  est_GB= 1.10\n  D7_I405_S  chunks=3 probe_rows=  5450 bytes/row= 53.1  est_GB= 0.34\n  train estimate: 4.4 GB\n\n== internal_validation ==\n  D12_I5_N   chunks=3 probe_rows= 13932 bytes/row= 53.3  est_GB= 0.22\n  D12_I5_S   chunks=3 probe_rows=  5400 bytes/row= 46.9  est_GB= 0.08\n  D7_I10_E   chunks=3 probe_rows=  7884 bytes/row= 52.3  est_GB= 0.12\n  D7_I10_W   chunks=3 probe_rows=  5778 bytes/row= 51.8  est_GB= 0.09\n  D7_