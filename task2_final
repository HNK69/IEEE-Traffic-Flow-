s_25min, eligible_t_minus_25min) AS lag_25,\n                (speed_t_minus_30min, eligible_t_minus_30min) AS lag_30,\n                (speed_t_minus_35min, eligible_t_minus_35min) AS lag_35,\n                (speed_t_minus_40min, eligible_t_minus_40min) AS lag_40,\n                (speed_t_minus_45min, eligible_t_minus_45min) AS lag_45,\n                (speed_t_minus_50min, eligible_t_minus_50min) AS lag_50,\n                (speed_t_minus_55min, eligible_t_minus_55min) AS lag_55,\n                (speed_t_minus_60min, eligible_t_minus_60min) AS lag_60\n            )\n        )\n        GROUP BY lag\n    )\n    SELECT\n        lag,\n        total_rows,\n        ROUND(100.0 * missing_speed / total_rows, 3)\n            AS missing_speed_pct,\n        ROUND(100.0 * eligible_rows / total_rows, 3)\n            AS eligible_pct,\n        speed_present_not_eligible,\n        speed_missing_but_eligible\n    FROM lag_stats\n    ORDER BY lag\n    \"\"\"\n\n    try:\n        result = con.execute(query, [glob]).df()\n        print(result.to_string(index=False))\n    except Exception as e:\n        print(\"Query failed:\", repr(e))\n        print(\n            \"Do not change the dataset. If this UNPIVOT syntax is \"\n            \"unsupported, I will provide a compatible query.\"\n        )\n        break\n\ncon.close()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:22:59.772428Z","iopub.execute_input":"2026-10-12T18:22:59.773638Z","iopub.status.idle":"2026-10-12T18:25:37.859497Z","shell.execute_reply.started":"2026-10-12T18:22:59.773593Z","shell.execute_reply":"2026-10-12T18:25:37.857722Z"}},"outputs":[{"name":"stdout","text":"\n--- TRAIN: FEATURE MISSINGNESS BY LAG ---\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"63acdae867de41ce