():\n    with open(\"/proc/self/status\") as f:\n        for line in f:\n            if line.startswith(\"VmRSS\"):\n                return int(line.split()[1]) / 1e6\n\nneed = [\"load_pair\", \"transform\", \"OUT_SCHEMA\", \"LINKS\", \"ORIGINS\", \"SPD\", \"ELG\", \"TGT\", \"KEYS\", \"ROOT\",\n        \"PROFILE\", \"EXPECT_FILES\", \"EXPECT_ROWS\"]\nassert all(n in globals() for n in need), \"re-run the earlier definition cells in this session first\"\n\nOUT = \"/kaggle/working/preprocessed\"\nSPLITS = [\"train\", \"internal_validation\"]\nPANELS = sorted(LINKS)\nCUTOFF = pd.Timestamp(\"2030-12-31T23:00:00+00:00\")\nVAL_START = pd.Timestamp(\"2031-01-01T00:00:00+00:00\")\n\n# 0. Directory contents: exactly the expected files, no leftovers\nexpected = set()\nfor s in SPLITS:\n    for p in PANELS:\n        expected |= {f\"{OUT}/{s}/{p}.parquet\", f\"{OUT}/{s}/{p}.counters.json\"}\nactual = {os.path.join(d, f) for d, _, fs in os.walk(OUT) for f in fs}\nassert actual == expected, f\"unexpected/missing files: extra={sorted(actual-expected)[:5]} missing={sorted(expected-actual)[:5]}\"\nprint(f\"directory OK: {len(actual)} files, no .tmp leftovers\")\n\nCOMPARE = [\"rows\", \"chunks\", \"min_ns\", \"max_ns\",\n           \"spd_null\", \"elg_one\", \"tgt_null\", \"tgt_one\"]\nA, t0 = {}, time.time()\nfor split in SPLITS:\n    for panel in PANELS:\n        final = f\"{OUT}/{split}/{panel}.parquet\"\n        fps = sorted(glob.glob(f\"{ROOT}/{split}/{split}/*_{panel}_*_features.parquet\"))\n        assert len(fps) == EXPECT_FILES[split] // len(PANELS)\n        tbl = pq.read_table(final)\n        assert tbl.schema.equals(OUT_SCHEMA), f\"{split} {panel}: schema differs\"\n        n = tbl.num_rows\n        assert n == LINKS[panel] * ORIGINS[split], f\"{split} {panel}: rows {n}\"\n\n        # --- recompute counters from the saved file\n        a = dict(rows=n, chunks=len(fps),\n                 spd_null={c: tbl[c].null_count for c in SPD},\n                 elg_one={c: int(pc.sum