unique().to_pylist()) == {panel}, f\"panel mismatch: {fp}\"\n                out = transform(ft, tt)\n                verify(ft, tt, out)\n                update(cnt, out)\n                buf.append(out); buf_rows += out.num_rows\n                if buf_rows >= FLUSH_ROWS:\n                    writer.write_table(pa.concat_tables(buf)); buf, buf_rows = [], 0\n            if buf:\n                writer.write_table(pa.concat_tables(buf))\n            writer.close(); writer = None\n            assert cnt[\"rows\"] == want_rows, f\"{split} {panel}: rows {cnt['rows']} != {want_rows}\"\n            assert cnt[\"chunks\"] == len(fps), f\"{split} {panel}: chunks {cnt['chunks']} != {len(fps)}\"\n            with open(tmpj, \"w\") as f:\n                json.dump(jsonable(cnt), f, indent=1)\n            os.replace(tmp, final); os.replace(tmpj, cjson)\n        except BaseException:\n            if writer is not None:\n                try: writer.close()\n                except Exception: pass\n            rm(tmp); rm(tmpj)\n            print(f\"FAILED {split} {panel}: partial .tmp output removed\")\n            raise\n        all_cnt[(split, panel)] = jsonable(cnt)\n        print(f\"{split[:5]} {panel:<10} rows={cnt['rows']:>11,} chunks={cnt['chunks']:>5} \"\n              f\"ooo_chunks={cnt['ooo_chunks']} unsorted_in_chunk={cnt['unsorted_in_chunk']} \"\n              f\"size={os.path.getsize(final)/1e9:.2f} GB  free={shutil.disk_usage(OUT).free/1e9:.1f} GB \"\n              f\"[{time.time()-t0:.0f}s]\", flush=True)\n\ndef accept(split):\n    g = [all_cnt[(split, p)] for p in sorted(LINKS)]\n    P = PROFILE[split]\n    assert sum(x[\"chunks\"] for x in g) == EXPECT_FILES[split], f\"{split}: chunk total mismatch\"\n    rows = sum(x[\"rows\"] for x in g)\n    assert rows == P[\"rows\"], f\"{split}: rows {rows} != {P['rows']}\"\n    for c in SPD:\n        v = sum(x[\"spd_null\"][c] for x in g); assert v == P[\"spd_null\"][c], f\"{split} {c}: nulls {v} != {P['spd_null'][c]}\"\n    for c in ELG:\n        v = sum(x[\"elg_one\"][c] for x in g); assert v == P[\"elg_one\"][c], f\"{split} {c}: ones {v} != {P['elg_one'][c]}\"\n    for c in TGT:\n        nul = sum(x[\"tgt_null\"][c] for x in g); one = sum(x[\"tgt_one\"][c] for x in g)\n        assert nul == P[\"tgt_null\"][c], f\"{split} {c}: null {nul} != {P['tgt_null'][c]}\"\n        assert one == P[\"tgt_one\"][c], f\"{split} {c}: one {one} != {P['tgt_one'][c]}\"\n        assert rows - nul - one == P[\"tgt_zero\"][c], f\"{split} {c}: zero {rows-nul-one} != {P['tgt_zero'][c]}\"\n    print(f\"  {split}: ACCEPTED (12 speed-null, 12 eligibility-one, 6x null/0/1 counts all match the profile; \"\n          f\"ooo_chunks={sum(x['ooo_chunks'] for x in g)}, unsorted_in_chunk={sum(x['unsorted_in_chunk'] for x in g)})\")\n\npassed = []\nfor split in SPLITS:\n    accept(split); passed.append(split)\n\ntot = sum(os.path.getsize(f) for f in glob.glob(f\"{OUT}/*/*.parquet\"))\nprint(f\"\\nartifact total: {tot/1e9:.2f} GB   elapsed: {time.time()-t0:.0f}s\")\nif set(passed) == {\"train\", \"internal_validation\"}:\n    print(\"WRITE COMPLETE\")\nelse:\n    print(f\"PARTIAL: only {passed} accepted; not complete until both splits pass\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T06:05:42.495796Z","iopub.execute_input":"2026-10-13T06:05:42.501364Z","iopub.status.idle":"2026-10-13T06:24:16.363866Z","shell.execute_reply.started":"2026-10-13T06:05:42.50121Z","shell.execute_reply":"2026-10-13T06:24:16.361268Z"}},"outputs":[{"name":"stdout","text":"free disk at start: 20.9 GB\ntrain D12_I5_N   rows= 14,959,356 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.63 GB  free=20.3 GB [122s]\ntrain D12_I5_S   rows=  5,798,200 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.23 GB  free=20.1 GB [218s]\ntrain D7_I10_E   rows=  8,465,372 chunks= 2567 ooo_chunks=0 unsorted_in_chunk=0 size=0.36 GB  free=19.7 GB [322s]\ntrain D7_I10_W   rows=  6,204,074 chunks= 2567 ooo_chunks=0 unsorted_in_chu