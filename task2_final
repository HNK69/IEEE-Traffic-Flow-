"stream"}],"execution_count":17},{"cell_type":"code","source":"from pathlib import Path\nimport duckdb\n\nROOT = Path(\n    \"/kaggle/input/datasets/krupaalhn/\"\n    \"trafficflowbench-expanded-task2/TrafficFlowBench_Backup\"\n)\n\nTRAIN_GLOB = str(ROOT / \"train\" / \"train\" / \"*_features.parquet\")\nVAL_GLOB = str(\n    ROOT / \"internal_validation\" /\n    \"internal_validation\" / \"*_features.parquet\"\n)\n\ncon = duckdb.connect()\ncon.execute(\"SET memory_limit = '4GB'\")\ncon.execute(\"SET threads = 4\")\ncon.execute(\"SET temp_directory = '/kaggle/working/duckdb_tmp'\")\n\n# 1. Panel coverage and date range per split.\ncoverage_sql = \"\"\"\nWITH features AS (\n    SELECT 'train' AS split, panel, forecast_origin, sample_id\n    FROM read_parquet(?, union_by_name = true)\n\n    UNION ALL\n\n    SELECT 'internal_validation' AS split,\n           panel, forecast_origin, sample_id\n    FROM read_parquet(?, union_by_name = true)\n)\nSELECT\n    split,\n    panel,\n    COUNT(*) AS feature_rows,\n    COUNT(DISTINCT sample_id) AS unique_samples,\n    MIN(forecast_origin) AS first_origin,\n    MAX(forecast_origin) AS last_origin\nFROM features\nGROUP BY split, panel\nORDER BY split, panel\n\"\"\"\n\ncoverage = con.execute(\n    coverage_sql, [TRAIN_GLOB, VAL_GLOB]\n).df()\n\nprint(\"=== PANEL COVERAGE ===\")\nprint(coverage.to_string(index=False))\n\n# 2. Monthly coverage per panel and split.\nmonthly_sql = \"\"\"\nWITH features AS (\n    SELECT 'train' AS split, panel, forecast_origin\n    FROM read_parquet(?, union_by_name = true)\n\n    UNION ALL\n\n    SELECT 'internal_validation' AS split,\n           panel, forecast_origin\n    FROM read_parquet(?, union_by_name = true)\n)\nSELECT\n    split,\n    panel,\n    DATE_TRUNC('month', forecast_origin) AS month,\n    COUNT(*) AS feature_rows,\n    COUNT(DISTINCT forecast_origin) AS unique_origins\nFROM features\nGROUP BY split, panel, month\nORDER BY split, panel, month\n\"\"\"\n\nmonthly = con.execute(\n    monthly_sql, [TRAIN_GLOB, VAL_GLOB]\n).df()\n\nprint(\"\\n=== MONTHLY COVERAGE ===\")\nprint(monthly.to_string(index=False))\n\n# 3. Hour-of-day coverage, by split.\nhourly_sql = \"\"\"\nWITH features AS (\n    SELECT 'train' AS split, forecast_origin\n    FROM read_parquet(?, union_by_name = true)\n\n    UNION ALL\n\n    SELECT 'internal_validation' AS split, forecast_origin\n    FROM read_parquet(?, union_by_name = true)\n)\nSELECT\n    split,\n    EXTRACT(HOUR FROM forecast_origin) AS utc_hour,\n    COUNT(DISTINCT forecast_origin) AS unique_origins\nFROM features\nGROUP BY split, utc_hour\nORDER BY split, utc_hour\n\"\"\"\n\nhourly = con.execute(\n    hourly_sql, [TRAIN_GLOB, VAL_GLOB]\n).df()\n\nprint(\"\\n=== UTC HOUR COVERAGE ===\")\nprint(hourly.to_string(index=False))\n\ncon.close()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T17:04:05.752046Z","iopub.execute_input":"2026-10-12T17:04:05.752891Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6ce14d9d6b95451090813fc709ff5e3e"}},"metadata":{}},{"name":"stdout","text":"=== PANEL COVERAGE ===\n              split     panel  feature_rows  unique_samples              first_origin               last_origin\ninternal_validation  D12_I5_N       4124904           15988 2031-01-01 01:00:00+00:00 2031-02-28 23:25:00+00:00\ninternal_validation  D12_I5_S       1598800           15988 2031-01-01 01:00:00+00:00 2031-02-28 23:25:00+00:00\ninternal_validation  D7_I10_E       2334248           15988 2031-01-01 01:00:00+00:00 2031-02-28 23:25:00+00:00\ninternal_validation  D7_I10_W       1710716           15988 2031-01-01 01:00:00+00:00 2031-02-28 23:25:00+00:00\ninternal_validation D7_I210_E       4748436           15988 2031-01-01 01:00:00+00:00 2031-02-28 23:25:00+00:00\ninternal_validation D7_I210_W  