iff(ts) >= 0):\n        cnt[\"unsorted_in_chunk\"] += 1\n    mn, mx = int(ts.min()), int(ts.max())\n    if cnt[\"max_ns\"] is not None and mn < cnt[\"max_ns\"]:\n        cnt[\"ooo_chunks\"] += 1\n    cnt[\"min_ns\"] = mn if cnt[\"min_ns\"] is None else min(cnt[\"min_ns\"], mn)\n    cnt[\"max_ns\"] = mx if cnt[\"max_ns\"] is None else max(cnt[\"max_ns\"], mx)\n    cnt[\"rows\"] += out.num_rows; cnt[\"chunks\"] += 1\n    for c in SPD:\n        cnt[\"spd_null\"][c] += out[c].null_count\n    for c in ELG:\n        m = pc.min_max(out[c]); assert m[\"min\"].as_py() >= 0 and m[\"max\"].as_py() <= 1, f\"{c} not binary\"\n        cnt[\"elg_one\"][c] += int(pc.sum(out[c]).as_py() or 0)\n    for c in TGT:\n        m = pc.min_max(out[c])\n        if m[\"min\"].is_valid:\n            assert m[\"min\"].as_py() >= 0 and m[\"max\"].as_py() <= 1, f\"{c} outside {{0,1}}\"\n        cnt[\"tgt_null\"][c] += out[c].null_count\n        cnt[\"tgt_one\"][c] += int(pc.sum(out[c]).as_py() or 0)\n\ndef jsonable(cnt):\n    d = dict(cnt)\n    d[\"min_origin\"] = str(pd.Timestamp(cnt[\"min_ns\"], tz=\"UTC\"))\n    d[\"max_origin\"] = str(pd.Timestamp(cnt[\"max_ns\"], tz=\"UTC\"))\n    return d\n\ndef validate_existing(final, cjson, want_rows, want_chunks):\n    \"\"\"Metadata-level check only; the audit cell recomputes counts from the data.\"\"\"\n    if not (os.path.exists(final) and os.path.exists(cjson)):\n        return None, \"final file or counters JSON missing\"\n    try:\n        c = json.load(open(cjson))\n        if not REQUIRED_KEYS <= set(c): return None, \"counters JSON lacks required keys\"\n        if c[\"rows\"] != want_rows: return None, f\"counter rows {c['rows']} != {want_rows}\"\n        if c[\"chunks\"] != want_chunks: return None, f\"counter chunks {c['chunks']} != {want_chunks}\"\n        pf = pq.ParquetFile(final)\n        if pf.metadata.num_rows != want_rows: return None, f\"footer rows {pf.metadata.num_rows} != {want_rows}\"\n        if not pf.schema_arrow.equals(OUT_SCH