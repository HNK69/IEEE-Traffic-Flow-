0\nMAX_CSV_FOR_TEXT = 200_000       # CSV/TSV only searched if small; large ones are listed, not read\n\n# Search terms (case-insensitive regexes), each reported separately\nTERMS = {\n    \"queue_true\": r\"queue_true\",\n    \"queue_targets\": r\"queue_targets\",\n    \"v_cut\": r\"v_cut\",\n    \"free_speed\": r\"free_speed\",\n    \"synthetic_mainline\": r\"synthetic_mainline\",\n    \"mainline_states\": r\"mainline_states\",\n    \"generator\": r\"generator|generate_|def generate|synthes\",\n    \"ground_truth\": r\"ground[_ ]?truth\",\n    \"target\": r\"\\btargets?\\b\",\n    \"label\": r\"\\blabels?\\b\",\n    \"speed <=\": r\"speed\\w*\\s*<=\",\n}\nPRIORITY_TERMS = [\"queue_true\", \"queue_targets\", \"v_cut\", \"synthetic_mainline\", \"generator\",\n                  \"ground_truth\", \"speed <=\"]\n# Rule-related terms for the \"documented rules\" question (eligibility, imputation, smoothing, duration, extent)\nRULE_RX = re.compile(\n    r\"is_score_eligible|eligib|imput|missing|smooth|minimum|min[_ ]?dur|duration|persist|consecutive|\"\n    r\"spatial|extent|contiguous|at least|underlying|noisy|observation|noise\", re.I)\n\n\ndef section(t):\n    print(f\"\\n{BAR}\\n{t}\\n{BAR}\")\n\n\ndef safe_read(p, limit=None):\n    \"\"\"Return (text, error). Never raises.\"\"\"\n    try:\n        if limit is not None and p.stat().st_size > limit:\n            return None, f\"skipped: size {p.stat().st_size:,} bytes > limit {limit:,}\"\n        return p.read_text(encoding=\"utf-8\", errors=\"replace\"), None\n    except Exception as e:\n        return None, f\"unreadable: {type(e).__name__}: {e}\"\n\n\ndef ipynb_to_lines(txt):\n    \"\"\"Flatten notebook cells to lines (source only; outputs ignored).\"\"\"\n    nb = json.loads(txt)\n    out = []\n    for i, c in enumerate(nb.get(\"cells\", [])):\n        out.append(f\"# --- notebook cell {i} ({c.get('cell_type')}) ---\")\n        src = c.get(\"source\", [])\n        out.extend((\"\".join(src) if isinstance(src, list) else str(src)).splitlines())\n    return out\n\n\ndef get_lines(p, limit):\n    txt, err = safe_read(p, limit)\n    if err:\n        return None, err\n    if p.suffix.lower() == \".ipynb\":\n        try:\n            return ipynb_to_lines(txt), None\n        except Exception as e:\n            return None, f\"notebook JSON unparseable: {e}\"\n    return txt.splitlines(), None\n\n\ndef show_context(lines, hit_idx, before=2, after=4, cap=60):\n    \"\"\"Print merged context blocks with 1-based line numbers; capped.\"\"\"\n    blocks = []\n    for i in hit_idx:\n        s, e = max(0, i - before), min(len(lines) - 1, i + after)\n        if blocks and s <= blocks[-1][1] + 1:\n            blocks[-1][1] = max(blocks[-1][1], e)\n        else:\n            blocks.append([s, e])\n    printed = 0\n    for s, e in blocks:\n        if printed + (e - s + 1) > cap:\n            print(f\"    ... output cap reached ({cap} lines); more matched blocks not shown\")\n            return\n        print(f\"    --- lines {s + 1}-{e + 1} ---\")\n        for k in range(s, e + 1):\n            print(f\"    {k + 1:5d}| {lines[k][:220]}\")\n        printed += e - s + 1\n\n\n# ---------------------------------------------------------------------------\n# 1. Existence summary\n# ---------------------------------------------------------------------------\nsection(\"1. Repository / release-root existence summary\")\nfor name, p in [(\"Repository\", REPO), (\"Release root\", RELEASE_ROOT)]:\n    print(f\"  [{'OK     ' if p.exists() else 'MISSING'}] {name}: {p}\")\nif not REPO.exists() and not RELEASE_ROOT.exists():\n    raise FileNotFoundError(\"Neither the repository nor the release root exists; nothing to inspect.\")\n\n# ---------------------------------------------------------------------------\n# 2. Repository inventory\n# ---------------------------------------------------------------------------\nsection(\"2. Repository inventory (excluding .git)\")\nrepo_files = []\nif REPO.exists():\n    for dp, dn, fn in os.walk(REPO):\n        dn[:] = [d for d in dn if d != \".git\"]\n        for f in fn:\n            repo_files.append(Path(dp) / f)\n    repo_files.sort()\n    ext_count = Counter(p.suffix.lower() or \"(none)\" for p in repo_files)\n    print(f\"  Total files (excluding .git): {len(repo_files)}\")\n    print(f\"  Extension counts: {dict(ext_count.most_common())}\")\n    top_dirs = Counter(p.relative_to(REPO).parts[0] if len(p.relative_to(REPO).parts) > 1 else \"(root)\"\n                       for p in repo_files)\n    print(f\"  Files per top-level entry: {dict(sorted(top_dirs.items()))}\")\n\n    def listing(title, exts):\n        sel = [p for p in repo_files if p.suffix.lower() in exts]\n        print(f\"\\n  {title} ({len(sel)}):\")\n        for p in sel[:80]:\n            print(f\"    {p.relative_to(REPO)}  [{p.stat().st_size:,} B]\")\n        if len(sel) > 80:\n            print(f\"    ... {len(sel) - 80} more not listed\")\n\n    listing(\"Python / notebook / shell scripts\", CODE_EXT)\n    listing(\"Config files (json/yaml/toml/cfg/ini)\", CONFIG_EXT)\n    listing(\"Docs (md/rst/txt)\", DOC_EXT)\n    other = [p for p in repo_files if p.suffix.lower() not in (CODE_EXT | CONFIG_EXT | DOC_EXT)]\n    print(f\"\\n  Other file types ({len(other)}); first 40:\")\n    for p in other[:40]:\n        print(f\"    {p.relative_to(REPO)}  [{p.stat().st_size:,} B]\")\nelse:\n    print(\"  Repository missing; skipping repo inventory.\")\n\n# ---------------------------------------------------------------------------\n# 3. Release-root metadata inventory (shallow; no parquet content is read)\n# ---------------------------------------------------------------------------\nsection(\"3. Release-root metadata inventory (bounded walk; Parquet contents NOT read)\")\nrelease_text_files, release_stats = [], Counter()\nWALK_FILE_CAP = 200_000\nwalked = 0\ntruncated_walk = False\nif RELEASE_ROOT.exists():\n    try:\n        print(\"  Top-level entries:\", sorted(p.name for p in RELEASE_ROOT.iterdir()))\n    except Exception as e:\n        print(f\"  Could not list release root: {e}\")\n    for dp, dn, fn in os.walk(RELEASE_ROOT):\n        for f in fn:\n            walked += 1\n            suf = Path(f).suffix.lower() or \"(none)\"\n            release_stats[suf] += 1\n            if suf in (CONFIG_EXT | DOC_EXT | CODE_EXT | {\".csv\", \".tsv\"}):\n                release_text_files.append(Path(dp) / f)\n            if walked >= WALK_FILE_CAP:\n                truncated_walk = True\n                break\n        if truncated_walk:\n            break\n    print(f\"  File names enumerated: {walked:,}{' (WALK CAPPED — inventory incomplete)' if truncated_walk else ''}\")\n    print(f\"  Extension counts: {dict(release_stats.most_common())}\")\n    # Non-parquet, non-csv metadata candidates\n    meta = [p for p in release_text_files if p.suffix.lower() not in {\".csv\", \".tsv\"}]\n    print(f\"\\n  Non-CSV text/config/doc/script files in release root ({len(meta)}):\")\n    for p in sorted(meta)[:80]:\n        print(f\"    {p.relative_to(RELEASE_ROOT)}  [{p.stat().st_size:,} B]\")\n    # Names suggestive of manifests/metadata (name only — contents inspected below, not inferred from name)\n    name_rx = re.compile(r\"manifest|metadata|meta|config|readme|schema|generat|label|target|queue|spec\", re.I)\n    cand = [p for p in release_text_files if name_rx.search(p.name)]\n    print(f\"\\n  Name-matched candidate metadata files (names alone prove nothing; contents searched in section 4): \"\n          f\"{len(cand)}\")\n    for p in sorted(cand)[:60]:\n        print(f\"    {p.relative_to(RELEASE_ROOT)}  [{p.stat().st_size:,} B]\")\n    # Directory listing of one panel's top level\n    pdir = RELEASE_ROOT / \"corridors\" / PANEL\n    if pdir.exists():\n        print(f\"\\n  {PANEL} top-level entries: {sorted(p.name for p in pdir.iterdir())}\")\n        for sub in sorted(pdir.iterdir()):\n            if sub.is_dir():\n                try:\n                    names = sorted(x.name for x in sub.iterdir())\n                    print(f\"    {sub.name}/ -> {len(names)} entries; first 8: {names[:8]}\")\n                except Exception as e:\n                    print(f\"    {sub.name}/ unreadable: {e}\")\nelse:\n    print(\"  Release root missing; skipping.\")\n\n# ---------------------------------------------------------------------------\n# 4. Term search across repo + release metadata files\n# ---------------------------------------------------------------------------\nsection(\"4. Term search (repo text files <=3 MB; release text/config/doc files <=1 MB; small CSVs only)\")\nsearch_targets = []\nskipped = []\nfor p in repo_files:\n    if p.suffix.lower() in TEXT_EXT and p.suffix.lower() not in {\".csv\", \".tsv\"}:\n        search_targets.append((\"repo\", p, REPO, MAX_TEXT_BYTES))\nfor p in release_text_files:\n    lim = MAX_CSV_FOR_TEXT if p.suffix.lower() in {\".csv\", \".tsv\"} else MAX_RELEASE_TEXT_BYTES\n    search_targets.append((\"release\", p, RELEASE_ROOT, lim))\n\ncompiled = {k: re.compile(v, re.I) for k, v in TERMS.items()}\nhits = defaultdict(lambda: defaultdict(list))   # term -> path -> [line idx]\nfile_lines = {}                                  # cache of matched files only\nunreadable = []\nsearched = 0\nfor origin, p, base, lim in search_targets:\n    lines, err = get_lines(p, lim)\n    if err:\n        skipped.append((origin, str(p.relative_to(base)), err))\n        continue\n    searched += 1\n    matched_any = False\n    for term, rx in compiled.items():\n        idx = [i for i, ln in enumerate(lines) if rx.search(ln)]\n        if idx:\n            hits[term][(origin, p)] = idx\n            matched_any = True\n    if matched_any:\n        file_lines[(origin, p)] = lines\n\nprint(f\"  Files searched: {searched:,} | skipped/unreadable: {len(skipped)}\")\nfor o, rel, err in skipped[:25]:\n    print(f\"    [{o}] {rel}: {err}\")\nif len(skipped) > 25:\n    print(f\"    ... {len(skippe