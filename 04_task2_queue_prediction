ort sys\nfrom collections import OrderedDict, defaultdict\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport pyarrow\nimport pyarrow.parquet as pq\n\n# =============================================================================\n# SECTION A — module-ready functions (no Kaggle-specific logic besides config defaults)\n# =============================================================================\n\n\n@dataclass(frozen=True)\nclass ProxyConfig:\n    release_root: Path = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\n    repo_root: Path = Path(\"/kaggle/working/trafficflowbench-public\")\n    out_dir: Path = Path(\"/kaggle/working/task2_proxy_labels\")\n    panels: tuple = (\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n                     \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\")\n    split: str = \"train\"\n    threshold_frac: float = 0.60\n    band_frac: float = 0.05\n    label_version: str = \"proxy_v1\"\n    label_source: str = \"proxy_threshold_on_train_states_v1\"\n    state_cache_size: int = 6\n    enforce_cell8_reconciliation: bool = True\n    # Explicit, logged exclusion from PRIMARY training only (rows stay in all output files).\n    excluded_windows: dict = field(default_factory=lambda: {\n        \"Q2_D12_I5_S_train_005\": (\"condition_conflict_no_visible_horizon_queue: official condition is queue_onset \"\n                                  \"but no proxy queue cell is visible in the horizon; any queue may sit in \"\n                                  \"unobservable cells, so its zeros may be false negatives\")})\n\n\nLABEL_CATS = [\"queue\", \"no_queue\", \"unknown\"]\nREASON_CATS = [\"\", \"ineligible\", \"speed_missing\", \"ineligible_and_speed_missing\", \"free_speed_invalid\"]\nQC_CATS = [\"ok\", \"condition_conflict_no_visible_horizon_queue\", \"onset_history_has_queue\",\n           \"ongoing_no_latest_history_queue\", \"unrecognized_condition\"]\nOPENED = []  # every input path opened by this cell (used by the split guard)\n\n\ndef track(p):\n    p = Path(p)\n    OPENED.append(str(p))\n    return p\n\n\ndef utc(s):\n    return pd.to_datetime(s, utc=True, errors=\"coerce\")\n\n\ndef cols_of(p):\n    p = Path(p)\n    return list(pq.read_schema(p).names) if p.suffix == \".parquet\" else list(pd.read_csv(p, nrows=0).columns)\n\n\ndef read_any(p, cols):\n    p = Path(p)\n    return pd.read_parquet(p, columns=cols) if p.suffix == \".parquet\" else pd.read_csv(p, usecols=cols)\n\n\ndef need(p, required, where):\n    p = Path(p)\n    if not p.exists():\n        raise FileNotFoundError(f\"[{where}] missing file: {p}\")\n    have = cols_of(p)\n    miss = [c for c in required if c not in have]\n    if miss:\n        raise ValueError(f\"[{where}] {p.name} missing columns {miss}. Columns present: {have}\")\n\n\ndef load_threshold_map(panel_dir, threshold_frac):\n    \"\"\"link_id -> v_cut. Released fd_parameters.csv v_cut wins where present; otherwise\n    threshold_frac * free_speed_kmh. Invalid free speed stays NaN (-> unknown), no guessed default.\"\"\"\n    links_p = track(Path(panel_dir) / \"network\" / \"links.csv\")\n    need(links_p, [\"link_id\", \"free_speed_kmh\"], f\"{Path(panel_dir).name} links\")\n    links = pd.read_csv(links_p, usecols=[\"link_id\", \"free_speed_kmh\"])\n    links[\"link_id\"] = links[\"link_id\"].astype(str)\n    links[\"free_speed_kmh\"] = pd.to_numeric(links[\"free_speed_kmh\"], errors=\"coerce\")\n    if links[\"link_id\"].duplicated().any():\n        raise ValueError(f\"{Path(panel_dir).name}: links.csv has duplicate link_id\")\n    fs = links[\"free_speed_kmh\"].where(links[\"free_speed_kmh\"] > 0)\n    vmap = dict(zip(links[\"link_id\"], (threshold_frac * fs).to_numpy(dtype=float)))\n    source, n_fd = f\"{threshold_frac:.2f}*free_speed_kmh (links.csv)\", 0\n    fd_p = Path(panel_dir) / \"network\" / \"fd_parameters.csv\"\n    if fd_p.exists():\n        track(fd_p)\n        if \"v_cut\" in cols_of(fd_p):\n            fd = pd.read_csv(fd_p, usecols=[\"link_id\", \"v_cut\"])\n            fd[\"link_id\"] = fd[\"link_id\"].astype(str)\n            fd[\"v_cut\"] = pd.to_numeric(fd[\"v_cut\"], errors=\"coerce\")\n            fd = fd.dropna(subset=[\"link_id\", \"v_cut\"])\n            for lid, v in zip(fd[\"link_id\"], fd[\"v_cut\"]):\n                vmap[lid] = float(v)\n            n_fd = len(fd)\n            source = f\"fd_parameters.csv v_cut ({n_fd} links) with links.csv fallback\"\n    return vmap, links, source, n_fd\n\n\nclass StateReader:\n    \"\"\"Reads daily train state files lazily (needed columns only) with a small LRU cache.\"\"\"\n    REQUIRED = [\"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"]\n\n    def __init__(self, sdir, cache_size):\n        sdir = Path(sdir)\n        if not sdir.is_dir():\n            raise FileNotFoundError(f\"missing state directory: {sdir}\")\n        self.idx = defaultdict(list)\n        for f in sorted(sdir.rglob(\"*.parquet\")):\n            m = re.search(r\"(\\d{4})_(\\d{2})_(\\d{2})\", f.name)\n            if m:\n                self.idx[pd.Timestamp(f\"{m[1]}-{m[2]}-{m[3]}\").date()].append(f)\n        if not self.idx:\n            raise FileNotFoundError(f\"no dated parquet files under {sdir}\")\n        self.cache, self.cache_size = OrderedDict(), cache_size\n\n    def day(self, d):\n        if d in self.cache:\n            self.cache.move_to_end(d)\n            return self.cache[d]\n        frames = []\n        for f in self.idx.get(d, []):\n            track(f)\n            have = cols_of(f)\n            miss = [c for c in self.REQUIRED if c not in have]\n            if miss:\n                raise ValueError(f\"{f.name} missing columns {miss}. Columns present: {have}\")\n            s = pd.read_parquet(f, columns=self.REQUIRED + ([\"milepost\"] if \"milepost\" in have else []))\n            s[\"timestamp\"] = utc(s[\"timestamp\"])\n            s[\"link_id\"] = s[\"link_id\"].astype(str)\n            s[\"speed_kmh\"] = pd.to_numeric(s[\"speed_kmh\"], errors=\"coerce\")\n            s[\"is_score_eligible\"] = pd.to_numeric(s[\"is_score_eligible\"], errors=\"coerce\")\n            frames.append(s)\n        self.cache[d] = pd.concat(frames, ignore_index=True) if frames else None\n        while len(self.cache) > self.cache_size:\n            self.cache.popitem(last=False)\n        return self.cache[d]\n\n    def window_states(self, tts):\n        days = pd.date_range(tts.min().normalize() - pd.Timedelta(days=1),\n                             tts.max().normalize() + pd.Timedelta(days=1), freq=\"D\")\n        frames = [f for f in (self.day(x.date()) for x in days) if f is not None]\n        if not frames:\n            return pd.DataFrame(columns=self.REQUIRED)\n        st = pd.concat(frames, ignore_index=True)\n        return st[st[\"timestamp\"].isin(tts)]\n\n\ndef assign_proxy_labels(df, band_frac):\n    \"\"\"Three-state PROXY label. known = eligible AND speed non-null AND v_cut valid.\n    Unknown cells get proxy_queue = <NA>; they are never converted to 0.\"\"\"\n    out = df.copy()\n    speed = pd.to_numeric(out[\"speed_kmh\"], errors=\"coerce\").to_numpy(dtype=float)\n    vcut = pd.to_numeric(out[\"vcut\"], errors=\"coerce\").to_numpy(dtype=float)\n    elig = pd.to_numeric(out[\"is_score_eligible\"], errors=\"coerce\").to_numpy(dtype=float) == 1\n    speed_ok = np.isfinite(speed)\n    vcut_ok = np.isfinite(vcut) & (vcut > 0)\n    known = elig & speed_ok & vcut_ok\n    with np.errstate(invalid=\"ignore\"):\n        below = speed <= vcut\n        near = known & (np.abs(speed - vcut) <= band_frac * vcut)\n        at_thr = known & (speed == vcut)\n    queue = known & below\n    status = np.where(queue, \"queue\", np.where(known, \"no_queue\", \"unknown\"))\n    reason = np.select([known, ~vcut_ok, ~elig & ~speed_ok, ~elig, ~speed_ok],\n                       [\"\", \"free_speed_invalid\", \"ineligible_and_speed_missing\", \"ineligible\", \"speed_missing\"],\n                       default=\"\")\n    out[\"label_status\"] = pd.Categorical(status, categories=LABEL_CATS)\n    out[\"proxy_queue\"] = pd.arrays.IntegerArray(queue.astype(\"int8\"), mask=~known)\n    out[\"unknown_reason\"] = pd.Categorical(reason, categories=REASON_CATS)\n    out[\"near_threshold\"], out[\"at_threshold\"] = near, at_thr\n    out[\"is_q\"], out[\"is_known\"], out[\"is_unknown\"] = queue, known, ~known\n    return out\n\n\ndef qc_flag(condition, hist_q_total, latest_q, horizon_q):\n    if condition == \"queue_onset\":\n        if hist_q_total > 0:\n            return \"onset_history_has_queue\"\n        return \"condition_conflict_no_visible_horizon_queue\" if horizon_q == 0 else \"ok\"\n    if condition == \"queue_ongoing\":\n        if latest_q == 0:\n            return \"ongoing_no_latest_history_queue\"\n        return \"condition_conflict_no_visible_horizon_queue\" if horizon_q == 0 else \"ok\"\n    return \"unrecognized_condition\"\n\n\ndef build_panel(cfg, panel, failures):\n    \"\"\"Build labelled target cells and labelled history rows for one panel (train split only).\"\"\"\n    task_dir = cfg.release_root / \"task2\" / panel / cfg.split\n    panel_dir = cfg.release_root / \"corridors\" / panel\n    wi_p, wh_p, tp_p = (track(task_dir / n) for n in\n                        [\"window_index.csv\", \"window_history.parquet\", \"sample_submission_queue.csv\"])\n    need(wi_p, [\"window_id\", \"condition\", \"forecast_origin\"], f\"{panel} window_index\")\n    need(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"], f\"{panel} history\")\n    need(tp_p, [\"window_id\", \"timestamp\", \"link_id\"], f\"{panel} template\")\n\n    wi = pd.read_csv(wi_p)\n    wi[\"window_id\"] = wi[\"window_id\"].astype(str)\n    wi[\"forecast_origin\"] = utc(wi[\"forecast_origin\"])\n    if wi[\"window_id\"].duplicated().any():\n        raise ValueError(f\"[{panel}] duplicate window_id in window_index\")\n    if \"split\" in wi.columns and not (wi[\"split\"].astype(str) == cfg.split).all():\n        raise ValueError(f\"[{panel}] window_index contains split values other than '{cfg.split}'\")\n\n    vmap, links, source, n_fd = load_threshold_map(panel_dir, cfg.threshold_frac)\n\n    hist = read_any(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"])\n    hist[\"window_id\"], hist[\"link_id\"] = hist[\"window_id\"].astype(str), hist[\"link_id\"].astype(str)\n    hist[\"timestamp\"] = utc(hist[\"timestamp\"])\n    hist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\n    hist[\"is_score_eligible\"] = pd.to_numeric(hist[\"is_score_eligible\"], errors=\"coerce\")\n    hist[\"vcut\"] = hist[\"link_id\"].map(vmap)\n    hist = assign_proxy_labels(hist, cfg.band_frac)\n    hist = hist[hist[\"window_id\"].isin(wi[\"window_id\"])]\n\n    tmpl = read_any(tp_p, [\"window_id\", \"timestamp\", \"link_id\"])\n    tmpl[\"window_id\"], tmpl[\"link_id\"] = tmpl[\"window_id\"].astype(str), tmpl[\"link_id\"].astype(str)\n    tmpl[\"timestamp\"] = utc(tmpl[\"timestamp\"])\n    tmpl_by = dict(tuple(tmpl.groupby(\"window_id\")))\n\n    reader = StateReader(panel_dir / cfg.split / \"mainline_states\", cfg.state_cache_size)\n    expected_offsets = np.arange(1, 7) * 5\n    parts = []\n    for w in wi.sort_values(\"window_id\").itertuples(index=False):\n        t = tmpl_by.get(w.window_id)\n        if t is None:\n            failures.append(f\"[{panel}] {w.window_id}: no template rows\")\n            continue\n        if t.duplicated([\"timestamp\", \"link_id\"]).any():\n            failures.append(f\"[{panel}] {w.window_id}: duplicate template keys\")\n        tts = pd.DatetimeIndex(t[\"timestamp\"].dropna().unique()).sort_values()\n        if len(tts) != 6 or pd.isna(w.forecast_origin) or \\\n                not np.array_equal(((tts - w.forecast_origin) / pd.Timedelta(minutes=1)).astype(int), expected_offsets):\n            failures.append(f\"[{panel}] {w.window_id}: target timestamps are not origin+5..+30 min \"\n                            f\"(n={len(tts)}, origin={w.forecast_origin})\")\n        st = reader.window_states(tts)\n        if st.duplicated([\"timestamp\", \"link_id\"]).any():\n            failures.append(f\"[{panel}] {w.window_id}: duplicate state keys at target timestamps\")\n            st = st.drop_duplicates([\"timestamp\", \"link_id\"])\n        tk = t[[\"timestamp\", \"link_id\"]].drop_duplicates().merge(\n            st, on=[\"timestamp\", \"link_id\"], how=\"left\", validate=\"one_to_one\", indicator=\"_m\")\n        n_nostate = int((tk[\"_m\"] == \"left_only\").sum())\n        if n_nostate:\n            failures.append(f\"[{panel}] {w.window_id}: {n_nostate} target keys have no state row\")\n        tk = tk.drop(columns=\"_m\")\n        tk[\"window_id\"], tk[\"panel\"], tk[\"condition\"] = w.window_id, panel, w.condition\n        tk[\"forecast_origin\"] = w.forecast_origin\n        tk[\"horizon_step\"] = (tts.get_indexer(pd.DatetimeIndex(tk[\"timestamp\"])) + 1).astype(\"int8\")\n        parts.append(tk)\n    if not parts:\n        raise RuntimeError(f\"[{panel}] no windows built\")\n    cells = pd.concat(parts, ignore_index=True)\n    cells[\"vcut\"] = cells[\"link_id\"].map(vmap)\n    cells[\"free_speed_kmh\"] = cells[\"link_id\"].map(links.set_index(\"link_id\")[\"free_speed_kmh\"])\n    cells = assign_proxy_labels(cells, cfg.band_frac)\n    art = dict(vmap=vmap, links=links, source=source, n_fd_vcut=n_fd, n_links=len(links), n_windows=len(wi))\n    return cells, hist, art\n\n\ndef summarize_windows(cells, hist, cfg):\n    g = cells.groupby(\"window_id\")\n    win = g.agg(panel=(\"panel\", \"first\"), condition=(\"condition\", \"first\"),\n                forecast_origin=(\"forecast_origin\", \"first\"), n_target_cells=(\"window_id\", \"size\"),\n                n_target_timestamps=(\"timestamp\", \"nunique\"), n_known=(\"is_known\", \"sum\"),\n                n_queue=(\"is_q\", \"sum\"), n_unknown=(\"is_unknown\", \"sum\"))\n    win[\"n_no_queue\"] = win[\"n_known\"] - win[\"n_queue\"]\n    hw = hist.groupby(\"window_id\").agg(hist_cells=(\"window_id\", \"size\"), hist_queue_cells=(\"is_q\", \"sum\"),\n                                       latest_hist_ts=(\"timestamp\", \"max\"),\n                                       n_hist_timestamps=(\"timestamp\", \"nunique\"))\n    lat = hist[hist[\"timestamp\"] == hist.groupby(\"window_id\")[\"timestamp\"].transform(\"max\")]\n    hl = lat.groupby(\"window_id\")[\"is_q\"].sum().rename(\"latest_hist_queue_cells\")\n    win = win.join(hw).join(hl)\n    win[\"origin_minus_latest_hist_min\"] = (win[\"forecast_origin\"] - win[\"latest_hist_ts\"]) / pd.Timedelta(minutes=1)\n    win[\"window_qc_flag\"] = [qc_flag(c, hq, lq, nq) for c, hq, lq, nq in\n                             zip(win[\"condition\"], win[\"hist_queue_cells\"], win[\"latest_hist_queue_cells\"], win[\"n_queue\"])]\n    win[\"exclude_from_primary_training\"] = win.index.isin(list(cfg.excluded_windows.keys()))\n    win[\"exclusion_reason\"] = pd.Series(win.index, index=win.index).map(cfg.excluded_windows).fillna(\"\")\n    return win.reset_index()\n\n\ndef known_mask(labels):\n    \"\"\"True where a proxy label exists. Loss and metrics must use only this mask.\"\"\"\n    return (labels[\"label_status\"] != \"unknown\").to_numpy()\n\n\ndef primary_training_mask(labels):\n    return known_mask(labels) & ~labels[\"exclude_from_primary_training\"].to_numpy(dtype=bool)\n\n\ndef labels_for_loss(labels, mask):\n    y = labels.loc[mask, \"proxy_queue\"]\n    if y.isna().any():\n        raise ValueError(\"Null proxy_queue reached the loss; unknown cells must be masked out, never filled with 0.\")\n    return y.astype(\"int8\").to_numpy()\n\n\ndef content_hash(df):\n    try:\n        h = pd.util.hash_pandas_object(df.reset_index(drop=True), index=False).to_numpy()\n        return hashlib.sha256(h.tobytes()).hexdigest()\n    except Exception:\n        return hashlib.sha256(df.to_csv(index=False).encode()).hexdigest()\n\n\ndef file_sha256(p):\n    h = hashlib.sha256()\n    with open(p, \"rb\") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef investigate_window(wid, cells, hist):\n    \"\"\"Evidence-only look at one window whose official condition the proxy cannot reproduce.\"\"\"\n    c = cells[cells[\"window_id\"] == wid].copy()\n    if c.empty:\n        print(f\"  window {wid} not found in built cells\")\n        return\n    h = hist[hist[\"window_id\"] == wid]\n    r0 = c.iloc[0]\n    print(f\"  window={wid} panel={r0['panel']} official condition={r0['condition']} origin={r0['forecast_origin']}\")\n    print(f\"  cells={len(c)} | label_status: {c['label_status'].value_counts().to_dict()}\")\n    print(f\"  unknown_reason (unknown cells only): \"\n          f\"{c.loc[c['is_unknown'], 'unknown_reason'].value_counts().to_dict()}\")\n    print(f\"  unknown cells per horizon step: {c.groupby('horizon_step')['is_unknown'].sum().to_dict()}\")\n    per_link = c.groupby(\"link_id\").agg(n_unknown=(\"is_unknown\", \"sum\"), n_known=(\"is_known\", \"sum\"))\n    print(f\"  links: {len(per_link)} | links with all six steps unknown: {int((per_link['n_unknown'] == 6).sum())} \"\n          f\"| links with no known cell: {int((per_link['n_known'] == 0).sum())}\")\n\n    latest = h[h[\"timestamp\"] == h[\"timestamp\"].max()].set_index(\"link_id\")\n    h_ratio = latest[\"speed_kmh\"] / latest[\"vcut\"]\n    top = per_link[per_link[\"n_unknown\"] > 0].sort_values(\"n_unknown\", ascending=False).head(15).copy()\n    top[\"last_hist_speed_over_vcut\"] = h_ratio.reindex(top.index)\n    print(\"\\n  Links with the most unknown horizon cells (last_hist_speed_over_vcut: any non-null speed at T-5):\")\n    print(top.to_string(float_format=lambda x: f\"{x:.3f}\"))\n\n    c[\"ratio\"] = c[\"speed_kmh\"] / c[\"vcut\"]\n    known = c[c[\"is_known\"]]\n    print(\"\\n  Closest approach to threshold among KNOWN horizon cells (speed / v_cut; <= 1 would be a queue):\")\n    print(known.nsmallest(5, \"ratio\")[[\"link_id\", \"horizon_step\", \"speed_kmh\", \"vcut\", \"ratio\"]]\n          .to_string(index=False, float_format=lambda x: f\"{x:.3f}\"))\n    print(f\"  min ratio per horizon step (known cells): \"\n          f\"{known.groupby('horizon_step')['ratio'].min().round(3).to_dict()}\")\n\n    anyv = c[c[\"speed_kmh\"].notna() & c[\"vcut\"].notna() & (c[\"vcut\"] > 0)]\n    print(f\"\\n  Variant B (any non-null speed, eligibility ignored): cells={len(anyv)}, \"\n          f\"speed <= v_cut: {int((anyv['speed_kmh'] <= anyv['vcut']).sum())}, \"\n          f\"ineligible-but-valid-speed cells: {int((anyv['is_score_eligible'] != 1).sum())}\")\n    hv = h[h[\"speed_kmh\"].notna() & h[\"vcut\"].notna() & (h[\"vcut\"] > 0)]\n    if len(hv):\n        print(f\"  History (12 timestamps) min speed/v_cut over non-null cells: {(hv['speed_kmh'] / hv['vcut']).min():.3f}\")\n\n    if \"milepost\" in c.columns and c[\"milepost\"].notna().any():\n        res = []\n        for _, g in c.groupby(\"horizon_step\"):\n            g = g.dropna(subset=[\"milepost\"]).sort_values(\"milepost\")\n            r = (g[\"speed_kmh\"] / g[\"vcut\"]).to_numpy(dtype=float)\n            miss, n = np.isnan(r), len(g)\n            idx = np.arange(n)\n            prev_v = np.maximum.accumulate(np.where(~miss, idx, -1))\n            next_v = np.minimum.accumulate(np.where(~miss, idx, n)[::-1])[::-1]\n            for i in np.where(miss)[0]:\n                cand = []\n                if prev_v[i] >= 0:\n                    cand.append(r[prev_v[i]])\n                if next_v[i] < n:\n                    cand.append(r[next_v[i]])\n                if cand:\n                    res.append(min(cand))\n        if res:\n            s = pd.Series(res)\n            print(f\"\\n  Missing-speed cells ({len(s)} with a milepost neighbour): nearest-neighbour speed/v_cut \"\n                  f\"min={s.min():.3f}, p25={s.quantile(.25):.3f}, median={s.median():.3f}, p75={s.quantile(.75):.3f}\")\n        else:\n            print(\"\\n  No missing-speed cells with a usable milepost neighbour.\")\n    else:\n        print(\"\\n  milepost not available in the state files; neighbour analysis skipped.\")\n    print(\"  NOTE: this is evidence only. It cannot show whether a queue exists in hidden cells.\")\n\n\n# =============================================================================\n# SECTION B — Kaggle driver\n# =============================================================================\nBAR = \"=\" * 100\n\n\ndef section(t):\n    print(f\"\\n{BAR}\\n{t}\\n{BAR}\")\n\n\n# Reconciliation targets copied from the Cell 8 output: (panel, condition) -> (queue, known, unknown)\nEXPECTED = {\n    (\"D12_I5_N\", \"queue_ongoing\"): (1692, 5909, 1831), (\"D12_I5_N\", \"queue_onset\"): (12, 5911, 1829),\n    (\"D12_I5_S\", \"queue_ongoing\"): (466, 2263, 737), (\"D12_I5_S\", \"queue_onset\"): (15, 2327, 673),\n    (\"D7_I10_E\", \"queue_ongoing\"): (776, 3341, 1039), (\"D7_I10_E\", \"queue_onset\"): (24, 3369, 1011),\n    (\"D7_I10_W\", \"queue_ongoing\"): (138, 2471, 739), (\"D7_I10_W\", \"queue_onset\"): (5, 2509, 701),\n    (\"D7_I210_E\", \"queue_ongoing\"): (100, 6857, 2053), (\"D7_I210_E\", \"queue_onset\"): (19, 6860, 2050),\n    (\"D7_I210_W\", \"queue_ongoing\"): (362, 1878, 552), (\"D7_I210_W\", \"queue_onset\"): (11, 1868, 562),\n    (\"D7_I405_N\", \"queue_ongoing\"): (2390, 8044, 2516), (\"D7_I405_N\", \"queue_onset\"): (15, 8036, 2524),\n    (\"D7_I405_S\", \"queue_ongoing\"): (409, 2521, 749), (\"D7_I405_S\", \"queue_onset\"): (23, 2454, 816),\n}\n\ncfg = ProxyConfig()\nsection(\"1. Configuration (PROXY labels; train split only)\")\nprint(f\"  release_root={cfg.release_root}\\n  out_dir={cfg.out_dir}\\n  split={cfg.split} | \"\n      f\"threshold