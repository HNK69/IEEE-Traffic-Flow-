  queue_onset         12            6                  6          654                     0                       0                       120                           0              472                    472              0                 1103                      0\n\n====================================================================================================\n6. Confirmed findings vs assumptions\n====================================================================================================\nCONFIRMED (observed in the files read by this cell, train split only):\n  - Training metadata/history/template found for panels: ['D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I405_N', 'D7_I405_S', 'D12_I5_N', 'D12_I5_S']; 80 training windows in window_index.\n  - Windows checked: 80 of 80 attempted.\n  - Target rows (template, deduplicated): 87,000; with no matching state key: 0; duplicate state keys at targets: 0; template duplicate keys: 0.\n  - Target cells with missing state speed: 14,317; rows with missing/invalid free speed: 0; eligible target cells: 66,618 (0.7657 of target rows).\n  - History vs state: rows 174,000, no state match 0, max |speed difference| on compared cells = 0.0.\n    Interpretation guard: an exact history/state match would suggest these train states are observation-level values, not a separate clean latent state; this cell cannot confirm what 'underlying' means officially.\n\nASSUMPTIONS / LIMITS (not confirmed):\n  - All timestamps (windows, template, states) were parsed with pandas utc=True; raw formats are printed in 3a.\n  - Target timestamps are taken from each panel's train sample_submission_queue.csv; forecast_origin offsets above are measured, not assumed.\n  - Only filename-dated state files within +/-1 day of each window were read; files with undated names are not used.\n  - Official queue_true labels are withheld; no labels, features, models, or files were created, and no validation windows were used.\n","output_type":"stream"}],"execution_count":29},{"cell_type":"code","source":"# Cell 8 — Check whether threshold-derived proxy flags reproduce Task 2 window conditions (train windows only)\n\nimport re\nfrom pathlib import Path\nfrom collections import OrderedDict, defaultdict\nimport numpy as np\nimport pandas as pd\nimport pyarrow.parquet as pq\n\nRELEASE_ROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nTASK2, CORR = RELEASE_ROOT / \"task2\", RELEASE_ROOT / \"corridors\"\nPANELS = [\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n          \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\"]\nTHRESHOLD_FRAC = 0.60\nBAND_FRAC = 0.05            # \"near-threshold\" band: |speed - v_cut| <= 5% of v_cut (noise indicator only)\nSTATE_CACHE_SIZE = 6\nMAX_FAILURES_PRINTED = 25\nBAR = \"=\" * 100\nSTATE_COLS = [\"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"]\n\n\ndef section(t):\n    print(f\"\\n{BAR}\\n{t}\\n{BAR}\")\n\n\ndef utc(s):\n    return pd.to_datetime(s, utc=True, errors=\"coerce\")\n\n\ndef cols_of(p):\n    p = Path(p)\n    return list(pq.read_schema(p).names) if p.suffix == \".parquet\" else list(pd.read_csv(p, nrows=0).columns)\n\n\ndef read_any(p, cols):\n    p = Path(p)\n    return pd.read_parquet(p, columns=cols) if p.suffix == \".parquet\" else pd.read_csv(p, usecols=cols)\n\n\ndef need(path, required, where):\n    if not Path(path).exists():\n        raise FileNotFoundError(f\"[{where}] missing file: {path}\")\n    have = cols_of(path)\n    miss = [c for c in required if c not in have]\n    if miss:\n        raise ValueError(f\"[{where}] {Path(path).name} missing columns {miss}. Columns: {have}\")\n\n\ndef flag(df, vcut_map):\n    \"\"\"Add proxy flags. A = eligible-only (is_score_eligible==1, speed non-null, valid v_cut);\n    B = any non-null speed with valid v_cut (ignores eligibility). Cells not valid under a variant are\n    'unknown' there, never 0.\"\"\"\n    d = df.copy()\n    d[\"vcut\"] = d[\"link_id\"].map(vcut_map)\n    vv = d[\"vcut\"].notna() & (d[\"vcut\"] > 0)\n    spd = d[\"speed_kmh\"].notna()\n    elig = d[\"is_score_eligible\"] == 1\n    d[\"validA\"] = elig & spd & vv\n    d[\"validB\"] = spd & vv\n    below = d[\"speed_kmh\"] <= d[\"vcut\"]\n    d[\"qA\"] = d[\"validA\"] & below\n    d[\"qB\"] = d[\"validB\"] & below\n    d[\"band\"] = d[\"validA\"] & ((d[\"speed_kmh\"] - d[\"vcut\"]).abs() <= BAND_FRAC * d[\"vcut\"])\n    return d\n\n\nrecords, panel_info, panel_errors = [], {}, {}\n\nfor panel in PANELS:\n    try:\n        wi_p = TASK2 / panel / \"train\" / \"window_index.csv\"\n        wh_p = TASK2 / panel / \"train\" / \"window_history.parquet\"\n        tp_p = TASK2 / panel / \"train\" / \"sample_submission_queue.csv\"\n        links_p = CORR / panel / \"network\" / \"links.csv\"\n        fd_p = CORR / panel / \"network\" / \"fd_parameters.csv\"\n        need(wi_p, [\"window_id\", \"condition\", \"forecast_origin\"], f\"{panel} window_index\")\n        need(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"], f\"{panel} history\")\n        need(tp_p, [\"window_id\", \"timestamp\", \"link_id\"], f\"{panel} template\")\n        need(links_p, [\"link_id\", \"free_speed_kmh\"], f\"{panel} links\")\n\n        wi = pd.read_csv(wi_p)\n        wi[\"window_id\"] = wi[\"window_id\"].astype(str)\n        wi[\"forecast_origin\"] = utc(wi[\"forecast_origin\"])\n        if wi[\"window_id\"].duplicated().any():\n            raise ValueError(\"duplicate window_id in window_index\")\n\n        links = pd.read_csv(links_p, usecols=[\"link_id\", \"free_speed_kmh\"])\n        links[\"link_id\"] = links[\"link_id\"].astype(str)\n        links[\"free_speed_kmh\"] = pd.to_numeric(links[\"free_speed_kmh\"], errors=\"coerce\")\n        if links[\"link_id\"].duplicated().any():\n            raise ValueError(\"links.csv duplicate link_id\")\n        vcut = dict(zip(links[\"link_id\"], THRESHOLD_FRAC * links[\"free_speed_kmh\"]))\n        src = f\"{THRESHOLD_FRAC}*free_speed_kmh (links.csv)\"\n        if fd_p.exists() and \"v_cut\" in cols_of(fd_p):\n            fd = pd.read_csv(fd_p, usecols=[\"link_id\", \"v_cut\"]).dropna()\n            vcut.update(dict(zip(fd[\"link_id\"].astype(str), pd.to_numeric(fd[\"v_cut\"], errors=\"coerce\"))))\n            src = \"fd_parameters.csv v_cut with links.csv fallback\"\n        panel_info[panel] = dict(threshold_source=src, n_links=len(links))\n\n        hist = read_any(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"])\n        hist[\"window_id\"] = hist[\"window_id\"].astype(str)\n        hist[\"link_id\"] = hist[\"link_id\"].astype(str)\n        hist[\"timestamp\"] = utc(hist[\"timestamp\"])\n        hist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\n        hist[\"is_score_eligible\"] = pd.to_numeric(hist[\"is_score_eligible\"], errors=\"coerce\")\n        tmpl = read_any(tp_p, [\"window_id\", \"timestamp\", \"link_id\"])\n        tmpl[\"window_id\"] = tmpl[\"window_id\"].astype(str)\n        tmpl[\"link_id\"] = tmpl[\"link_id\"].astype(str)\n        tmpl[\"timestamp\"] = utc(tmpl[\"timestamp\"])\n        hist_by, tmpl_by = dict(tuple(hist.groupby(\"window_id\"))), dict(tuple(tmpl.groupby(\"window_id\")))\n\n        sdir = CORR / panel / \"train\" / \"mainline_states\"\n        if not sdir.is_dir():\n            raise FileNotFoundError(f\"missing {sdir}\")\n        idx = defaultdict(list)\n        for f in sorted(sdir.rglob(\"*.parquet\")):\n            m = re.search(r\"(\\d{4})_(\\d{2})_(\\d{2})\", f.name)\n            if m:\n                idx[pd.Timestamp(f\"{m[1]}-{m[2]}-{m[3]}\").date()].append(f)\n        cache = OrderedDict()\n\n        def load_day(day):\n            if day in cache:\n                cache.move_to_end(day)\n                return cache[day]\n            frames = []\n            for f in idx.get(day, []):\n                have = cols_of(f)\n                miss = [c for c in STATE_COLS if c not in have]\n                if miss:\n                    raise ValueError(f\"{f.name} missing {miss}\")\n                s = pd.read_parquet(f, columns=STATE_COLS)\n                s[\"timestamp\"] = utc(s[\"timestamp\"])\n                s[\"link_id\"] = s[\"link_id\"].astype(str)\n                s[\"speed_kmh\"] = pd.to_numeric(s[\"speed_kmh\"], errors=\"coerce\")\n                s[\"is_score_eligible\"] = pd.to_numeric(s[\"is_score_eligible\"], errors=\"coerce\")\n                frames.append(s)\n            cache[day] = pd.concat(frames, ignore_index=True) if frames else None\n            while len(cache) > STATE_CACHE_SIZE:\n                cache.popitem(last=False)\n            return cache[day]\n\n        for w in wi.sort_values(\"window_id\").itertuples(index=False):\n            h, t = hist_by.get(w.window_id), tmpl_by.get(w.window_id)\n            rec = dict(panel=panel, window_id=w.window_id, condition=w.condition)\n            if h is None or t is None or pd.isna(w.forecast_origin):\n                rec[\"status\"] = \"missing history/template/origin\"\n                records.append(rec)\n                continue\n            origin = w.forecast_origin\n            tts = pd.DatetimeIndex(np.sort(t.timestamp.dropna().unique()))\n            latest = h.timestamp.max()\n\n            # ---- history flags (history parquet values; Cell 7 showed they equal the state values)\n            hf = flag(h, vcut)\n            last = hf[hf.timestamp == latest]\n            rec.update(hist_cells=len(hf),\n                       hist_qA_total=int(hf.qA.sum()), hist_qB_total=int(hf.qB.sum()),\n                       hist_qA_last=int(last.qA.sum()), hist_qB_last=int(last.qB.sum()),\n                       hist_validA_last=int(last.validA.sum()),\n                       origin_minus_latest_min=(origin - latest) / pd.Timedelta(minutes=1))\n\n            # ---- states at origin T and at the six targets\n            days = pd.date_range(origin.normalize() - pd.Timedelta(days=1), tts.max().normalize() + pd.Timedelta(days=1), freq=\"D\")\n            frames = [f for f in (load_day(x.date()) for x in days) if f is not None]\n            if not frames:\n                rec[\"status\"] = \"no state files for window dates\"\n                records.append(rec)\n                continue\n            st = pd.concat(frames, ignore_index=True)\n            st = st[st.timestamp.isin(tts.union(pd.DatetimeIndex([origin])))]\n            rec[\"state_dup_keys\"] = int(st.duplicated([\"timestamp\", \"link_id\"]).sum())\n            st = st.drop_duplicates([\"timestamp\", \"link_id\"])\n\n            of = flag(st[st.timestamp == origin], vcut)\n            rec.update(origin_state_rows=len(of), origin_qA=int(of.qA.sum()), origin_qB=int(of.qB.sum()),\n                       origin_validA=int(of.validA.sum()))\n\n            tk = t[[\"timestamp\", \"link_id\"]].drop_duplicates().merge(\n                st, on=[\"timestamp\", \"link_id\"], how=\"left\", indicator=True, validate=\"one_to_one\")\n            rec[\"target_rows_no_state\"] = int((tk[\"_merge\"] == \"left_only\").sum())\n            tf = flag(tk.drop(columns=\"_merge\"), vcut)\n            rec.update(target_rows=len(tf), hz_validA=int(tf.validA.sum()),\n                       hz_unknownA=int((~tf.validA).sum()),\n                       hz_qA=int(tf.qA.sum()), hz_qB=int(tf.qB.sum()), hz_band=int(tf.band.sum()),\n                       hz_qA_by_step=tuple(int(tf[tf.timestamp == ts].qA.sum()) for ts in tts))\n            rec[\"status\"] = \"ok\"\n            records.append(rec)\n    except Exception as e:\n        panel_errors[panel] = f\"{type(e).__name__}: {e}\"\n        print(f\"[{panel}] ERROR (panel skipped): {panel_errors[panel]}\")\n\nres = pd.DataFrame(records)\nif res.empty or \"status\" not in res or not (res.status == \"ok\").any():\n    raise RuntimeError(f\"No windows checked. Panel errors: {panel_errors}\")\nok = res[res.status == \"ok\"].copy()\n\n# ---------------------------------------------------------------------------\nsection(\"1. Setup notes (actual values read from the files)\")\nfor p, i in panel_info.items():\n    print(f\"  [{p}] threshold source: {i['threshold_source']} | links: {i['n_links']}\")\nprint(f\"  Windows attempted: {len(res)} | checked ok: {len(ok)} | statuses: {res.status.value_counts().to_dict()}\")\nprint(f\"  origin - latest history ts (min), all windows: {sorted(ok.origin_minus_latest_min.unique())}\")\nprint(f\"  Windows with origin state rows missing: {int((ok.origin_state_rows == 0).sum())} | \"\n      f\"target rows without state: {int(ok.target_rows_no_state.sum())} | duplicate state keys: {int(ok.state_dup_keys.sum())}\")\nprint(\"  Variants: A = eligible cells only; B = any non-null speed (ignores eligibility). \"\n      \"'last' = latest history timestamp (T-5); 'origin' = state at forecast origin T (not part of released history; \"\n      \"used here only to test the definition on TRAIN windows).\")\n\n# ---------------------------------------------------------------------------\nsection(\"2. Rule checks per window\")\n# onset rule: no queue anywhere in history AND queue in horizon\nfor v in [\"A\", \"B\"]:\n    ok[f\"onset_rule_{v}\"] = (ok[f\"hist_q{v}_total\"] == 0) & (ok[f\"hz_q{v}\"] > 0)\n    ok[f\"ongoing_last_{v}\"] = (ok[f\"hist_q{v}_last\"] > 0) & (ok[f\"hz_q{v}\"] > 0)\n    ok[f\"ongoing_origin_{v}\"] = (ok[f\"origin_q{v}\"] > 0) & (ok[f\"hz_q{v}\"] > 0)\n    ok[f\"hist_any_{v}\"] = ok[f\"hist_q{v}_total\"] > 0\n    ok[f\"hz_any_{v}\"] = ok[f\"hz_q{v}\"] > 0\n\non, og = ok[ok.condition == \"queue_onset\"], ok[ok.condition == \"queue_ongoing\"]\nprint(f\"  queue_onset windows: {len(on)} | queue_ongoing windows: {len(og)}\")\nrows = []\nfor v in [\"A\", \"B\"]:\n    rows.append(dict(variant=v, rule=\"onset: no history queue AND horizon queue\", windows=len(on),\n                     passed=int(on[f\"onset_rule_{v}\"].sum()),\n                     history_clean=int((~on[f\"hist_any_{v}\"]).sum()), horizon_has_queue=int(on[f\"hz_any_{v}\"].sum())))\n    rows.append(dict(variant=v, rule=\"ongoing: queue at latest history ts AND horizon queue\", windows=len(og),\n                     passed=int(og[f\"ongoing_last_{v}\"].sum()),\n                     history_clean=int((og[f\"hist_q{v}_last\"] > 0).sum()), horizon_has_queue=int(og[f\"hz_any_{v}\"].sum())))\n    rows.append(dict(variant=v, rule=\"ongoing: queue at origin state AND horizon queue\", windows=len(og),\n                     passed=int(og[f\"ongoing_origin_{v}\"].sum()),\n                     history_clean=int((og[f\"origin_q{v}\"] > 0).sum()), horizon_has_queue=int(og[f\"hz_any_{v}\"].sum())))\nchk = pd.DataFrame(rows).rename(columns={\"history_clean\": \"first_part_ok\", \"horizon_has_queue\": \"horizon_queue_ok\"})\nwith pd.option_context(\"display.width\", 250, \"display.max_colwidth\", 70):\n    print(chk.to_string(index=False))\nprint(\"  (first_part_ok = onset: history has no queue; ongoing: queue present at the stated timestamp)\")\n\n# ---------------------------------------------------------------------------\nsection(\"3. Pass/fail by panel and condition (variant A = eligible only; primary)\")\nok[\"pass_primary_A_last\"] = np.where(ok.condition == \"queue_onset\", ok.onset_rule_A, ok.ongoing_last_A)\nok[\"pass_primary_A_origin\"] = np.where(ok.condition == \"queue_onset\", ok.onset_rule_A, ok.ongoing_origin_A)\npt = ok.groupby([\"panel\", \"condition\"]).agg(windows=(\"window_id\", \"size\"),\n                                            pass_A_last=(\"pass_primary_A_last\", \"sum\"),\n                                            pass_A_origin=(\"pass_primary_A_origin\", \"sum\"),\n                                            hz_qA_cells=(\"hz_qA\", \"sum\"),\n                                            hz_validA_cells=(\"hz_validA\", \"sum\"),\n                                            hz_unknown_cells=(\"hz_unknownA\", \"sum\"))\npt[\"hz_qA_rate_of_valid\"] = pt.hz_qA_cells / pt.hz_validA_cells\nprint(pt.to_string(float_format=lambda x: f\"{x:.4f}\"))\n\n# ---------------------------------------------------------------------------\nsection(\"4. Proxy-derived condition vs official window_index condition (confusion tables)\")\n\n\ndef derive(df, v, ongoing_when):\n    q_on = df[f\"{ongoing_when}_q{v}\"] > 0\n    hz = df[f\"hz_q{v}\"] > 0\n    clean = df[f\"hist_q{v}_total\"] == 0\n    return np.where(q_on & hz, \"queue_ongoing\", np.where(clean & hz, \"queue_onset\", \"neither\"))\n\n\nfor v, when, label in [(\"A\", \"hist\", None)]:\n    pass\nfor v in [\"A\", \"B\"]:\n    for when, nm in [(\"hist_last\", \"latest history ts\"), (\"origin\", \"origin state\")]:\n        col = f\"hist_q{v}_last\" if when == \"hist_last\" else f\"origin_q{v}\"\n        q_on = ok[col] > 0\n        hz = ok[f\"hz_q{v}\"] > 0\n        clean = ok[f\"hist_q{v}_total\"] == 0\n        derived = np.where(q_on & hz, \"queue_ongoing\", np.where(clean & hz, \"queue_onset\", \"neither\"))\n        print(f\"\\n  Variant {v}, ongoing tested at {nm}:  rows = official condition, columns = proxy-derived\")\n        print(pd.crosstab(ok.condition, pd.Series(derived, index=ok.index, name=\"proxy\"), margins=True).to_string())\n\n# ---------------------------------------------------------------------------\nsection(f\"5. First failures of the primary variant A (latest-history ongoing test), up to {MAX_FAILURES_PRINTED}\")\nfails = ok[~ok.pass_primary_A_last].sort_values([\"condition\", \"panel\", \"window_id\"])\nshow = [\"window_id\", \"condition\", \"hist_qA_total\", \"hist_qA_last\", \"origin_qA\", \"hz_qA\", \"hz_validA\", \"hist_qB_total\",\n        \"hist_qB_last\", \"origin_qB\", \"hz_qB\", \"hz_qA_by_step\"]\nif fails.empty:\n    print(\"  No failures for variant A (latest-history test).\")\nelse:\n    print(f\"  Failures: {len(fails)} of {len(ok)}\")\n    with pd.option_context(\"display.width\", 300, \"display.max_columns\", None, \"display.max_colwidth\", 40):\n        print(fails[show].head(MAX_FAILURES_PRINTED).to_string(index=False))\n\n# ---------------------------------------------------------------------------\nsection(\"6. Proxy cell counts and near-threshold noise indicator (variant A, six target timestamps)\")\ntot_valid, tot_q, tot_unk, tot_band = (int(ok.hz_validA.sum()), int(ok.hz_qA.sum()),\n                                       int(ok.hz_unknownA.sum()), int(ok.hz_band.sum()))\nprint(f\"  Target cells: {int(ok.target_rows.sum()):,} | valid (eligible, non-null speed): {tot_valid:,} | \"\n      f\"unknown (excluded, NOT 0): {tot_unk:,}\")\nprint(f\"  Proxy queue=1 cells: {tot_q:,} ({tot_q / max(tot_valid, 1):.4%} of valid) | proxy 0 cells: {tot_valid - tot_q:,}\")\nprint(f\"  Valid cells within +/-{BAND_FRAC:.0%} of v_cut: {tot_band:,} ({tot_band / max(tot_valid, 1):.4%} of valid)\")\nfor c in [\"queue_onset\", \"queue_ongoing\"]:\n    x = ok[ok.condition == c]\n    print(f\"    {c}: valid={int(x.hz_validA.sum()):,}, proxy queue cells={int(x.hz_qA.sum()):,} \"\n          f\"({x.hz_qA.sum() / max(x.hz_validA.sum(), 1):.4%}), unknown={int(x.hz_unknownA.sum()):,}\")\n\n# ---------------------------------------------------------------------------\nsection(\"7. Reading these results\")\npa = int(ok.pass_primary_A_last.sum())\nprint(f\"  Variant A (eligible only), latest-history test: {pa}/{len(ok)} windows consistent with their official condition.\")\nprint(f\"  Variant A (eligible only), origin-state test:   {int(ok.pass_primary_A_origin.sum())}/{len(ok)}.\")\nprint(\"  Agreement is consistency evidence for the condition definition on these train windows only. It does not show that\")\nprint(\"  proxy cell labels equal the official queue_true cells (withheld). The train states equal the released history,\")\nprint(\"  so they are observation-level values, not a verified latent state.\")\nif panel_errors:\n    print(f\"  Panels with errors (not checked): {panel_errors}\")\nprint(\