  queue_onset         12            6                  6          654                     0                       0                       120                           0              472                    472              0                 1103                      0\n\n====================================================================================================\n6. Confirmed findings vs assumptions\n====================================================================================================\nCONFIRMED (observed in the files read by this cell, train split only):\n  - Training metadata/history/template found for panels: ['D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I405_N', 'D7_I405_S', 'D12_I5_N', 'D12_I5_S']; 80 training windows in window_index.\n  - Windows checked: 80 of 80 attempted.\n  - Target rows (template, deduplicated): 87,000; with no matching state key: 0; duplicate state keys at targets: 0; template duplicate keys: 0.\n  - Target cells with missing state speed: 14,317; rows with missing/invalid free speed: 0; eligible target cells: 66,618 (0.7657 of target rows).\n  - History vs state: rows 174,000, no state match 0, max |speed difference| on compared cells = 0.0.\n    Interpretation guard: an exact history/state match would suggest these train states are observation-level values, not a separate clean latent state; this cell cannot confirm what 'underlying' means officially.\n\nASSUMPTIONS / LIMITS (not confirmed):\n  - All timestamps (windows, template, states) were parsed with pandas utc=True; raw formats are printed in 3a.\n  - Target timestamps are taken from each panel's train sample_submission_queue.csv; forecast_origin offsets above are measured, not assumed.\n  - Only filename-dated state files within +/-1 day of each window were read; files with undated names are not used.\n  - Official queue_true labels are withheld; no labels, features, models, or files were created, and no validation windows were used.\n","output_type":"stream"}],"execution_count":29},{"cell_type":"code","source":"# Cell 8 — Check whether threshold-derived proxy flags reproduce Task 2 window conditions (train windows only)\n\nimport re\nfrom pathlib import Path\nfrom collections import OrderedDict, defaultdict\nimport numpy as np\nimport pandas as pd\nimport pyarrow.parquet as pq\n\nRELEASE_ROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nTASK2, CORR = RELEASE_ROOT / \"task2\", RELEASE_ROOT / \"corridors\"\nPANELS = [\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n          \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\"]\nTHRESHOLD_FRAC = 0.60\nBAND_FRAC = 0.05            # \"near-threshold\" band: |speed - v_cut| <= 5% of v_cut (noise indicator only)\nSTATE_CACHE_SIZE = 6\nMAX_FAILURES_PRINTED = 25\nBAR = \"=\" * 100\nSTATE_COLS = [\"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"]\n\n\ndef section(t):\n    print(f\"\\n{BAR}\\n{t}\\n{BAR}\")\n\n\ndef utc(s):\n    return pd.to_datetime(s, utc=True, errors=\"coerce\")\n\n\ndef cols_of(p):\n    p = Path(p)\n    return list(pq.read_schema(p).names) if p.suffix == \".parquet\" else list(pd.read_csv(p, nrows=0).columns)\n\n\ndef read_any(p, cols):\n    p = Path(p)\n    return pd.read_parquet(p, columns=cols) if p.suffix == \".parquet\" else pd.read_csv(p, usecols=cols)\n\n\ndef need(path, required, where):\n    if not Path(path).exists():\n        raise FileNotFoundError(f\"[{where}] missing file: {path}\")\n    have = cols_of(path)\n    miss = [c for c in required if c not in have]\n    if miss:\n        raise ValueError(f\"[{where}] {Path(path).name} missing columns {miss}. Columns: {have}\")\n\n\ndef flag(df, vcut_map):\n    \"\"\"Add proxy flags. A = eligible-only (is_score_eligible==1, speed non-null, valid v_cut);\n    B = any non-null speed with valid v_cut (ignores eligibility). Cells not valid under a variant are\n    'unknown' there, never 0.\"\"\"\n    d = df.copy()\n    d[\"vcut\"] = d[\"link_id\"].map(vcut_map)\n    vv = d[\"vcut\"].notna() & (d[\"vcut\"] > 0)\n    spd = d[\"speed_kmh\"].notna()\n    elig = d[\"is_score_eligible\"] == 1\n    d[\"validA\"] = elig & spd & vv\n    d[\"validB\"] = spd & vv\n    below = d[\"speed_kmh\"] <= d[\"vcut\"]\n    d[\"qA\"] = d[\"validA\"] & below\n    d[\"qB\"] = d[\"validB\"] & below\n    d[\"band\"] = d[\"validA\"] & ((d[\"speed_kmh\"] - d[\"vcut\"]).abs() <= BAND_FRAC * d[\"vcut\"])\n    return d\n\n\nrecords, panel_info, panel_errors = [], {}, {}\n\nfor panel in PANELS:\n    try:\n        wi_p = TASK2 / panel / \"train\" / \"window_index.csv\"\n        wh_p = TASK2 / panel / \"train\" / \"window_history.parquet\"\n        tp_p = TASK2 / panel / \"train\" / \"sample_submission_queue.csv\"\n        links_p = CORR / panel / \"network\" / \"links.csv\"\n        fd_p = CORR / panel / \"network\" / \"fd_parameters.csv\"\n        need(wi_p, [\"window_id\", \"condition\", \"forecast_origin\"], f\"{panel} window_index\")\n        need(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"], f\"{panel} history\")\n        need(tp_p, [\"window_id\", \"timestamp\", \"link_id\"], f\"{panel} template\")\n        need(links_p, [\"link_id\", \"free_speed_kmh\"], f\"{panel} links\")\n\n        wi = pd.read_csv(wi_p)\n        wi[\"window_id\"] = wi[\"window_id\"].astype(str)\n        wi[\"forecast_origin\"] = utc(wi[\"forecast_origin\"])\n        if wi[\"window_id\"].duplicated().any():\n            raise ValueError(\"duplicate window_id in window_index\")\n\n        links = pd.read_csv(links_p, usecols=[\"link_id\", \"free_speed_kmh\"])\n        links[\"link_id\"] = links[\"link_id\"].astype(str)\n        links[\"free_speed_kmh\"] = pd.to_numeric(links[\"free_speed_kmh\"], errors=\"coerce\")\n        if links[\"link_id\"].duplicated().any():\n            raise ValueError(\"links.csv duplicate link_id\")\n        vcut = dict(zip(links[\"link_id\"], THRESHOLD_FRAC * links[\"free_speed_kmh\"]))\n        src = f\"{THRESHOLD_FRAC}*free_speed_kmh (links.csv)\"\n        if fd_p.exists() and \"v_cut\" in cols_of(fd_p):\n            fd = pd.read_csv(fd_p, usecols=[\"link_id\", \"v_cut\"]).dropna()\n            vcut.update(dict(zip(fd[\"link_id\"].astype(str), pd.to_numeric(fd[\"v_cut\"], errors=\"coerce\"))))\n            src = \"fd_parameters.csv v_cut with links.csv fallback\"\n        panel_info[panel] = dict(threshold_source=src, n_links=len(links))\n\n        hist = read_any(wh_p, [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"])\n        hist[\"window_id\"] = hist[\"window_id\"].astype(str)\n        hist[\"link_id\"] = hist[\"link_id\"].astype(str)\n        hist[\"timestamp\"] = utc(hist[\"timestamp\"])\n        hist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\n        hist[\"is_score_eligible\"] = pd.to_numeric(hist[\"is_score_eligible\"], errors=\"coerce\")\n        tmpl = read_any(tp_p, [\"window_id\", \"timestamp\", \"link_id\"])\n        tmpl[\"window_id\"] = tmpl[\"window_id\"].astype(str)\n        tmpl[\"link_id\"] = tmpl[\"link_id\"].astype(str)\n        tmpl[\"timestamp\"] = utc(tmpl[\"timestamp\"])\n        hist_by, tmpl_by = dict(tuple(hist.groupby(\"window_id\"))), dict(tuple(tmpl.groupby(\"window_id\")))\n\n        sdir = CORR / panel / \"train\" / \"mainline_states\"\n        if not sdir.is_dir():\n            raise FileNotFoundError(f\"missing {sdir}\")\n        idx = defaultdict(list)\n        for f in sorted(sdir.rglob(\"*.parquet\")):\n            m = re.search(r\"(\\d{4})_(\\d{2})_(\\d{2})\", f.name)\n            if m:\n                idx[pd.Timestamp(f\"{m[1]}-{m[2]}-{m[3]}\").date()].append(f)\n        cache = OrderedDict()\n\n        def load_day(day):\n            if day in cache:\n                cache.move_to_end(day)\n                return cache[day]\n            frames = []\n            for f in idx.get(day, []):\n                have = cols_of(f)\n                miss = [c for c in STATE_COLS if c not in have]\n                if miss:\n                    raise ValueError(f\"{f.name} missing {miss}\")\n                s = pd.read_parquet(f, columns=STATE_COLS)\n                s[\"timestamp\"] = utc(s[\"timestamp\"])\n                s[\"link_id\"] = s[\"link_id\"].astype(str)\n                s[\"speed_kmh\"] = pd.to_numeric(s[\"speed_kmh\"], errors=\"coerce\")\n                s[\"is_score_eligible\"] = pd.to_numeric(s[\"is_score_eligible\"], errors=\"coerce\")\n                frames.append(s)\n            cache[day] = pd.concat(frames, ignore_index=True) if frames else None\n            while len(cache) > STATE_CACHE_SIZE:\n                cache.popitem(last=False)\n            return cache[day]\n\n        for w in wi.sort_values(\"window_id\").itertuples(index=False):\n            h, t = hist_by.get(w.window_id), tmpl_by.get(w.window_id)\n            rec = dict(panel=panel, window_id=w.window_id, condition=w.condition)\n            if h is None or t is None or pd.isna(w.forecast_origin):\n                rec[\"status\"] = \"missing history/template/origin\"\n                records.append(rec)\n                continue\n            origin = w.forecast_origin\n            tts = pd.DatetimeIndex(np.sort(t.timestamp.dropna().unique()))\n            latest = h.timestamp.max()\n\n            # ---- history flags (history parquet values; Cell 7 showed they equal the state values)\n            hf = flag(h, vcut)\n            last = hf[hf.timestamp == latest]\n            rec.update(hist_cells=len(hf),\n                       hist_qA_total=int(hf.qA.sum()), hist_qB_total=int(hf.qB.sum()),\n                       hist_qA_last=int(last.qA.sum()), hist_qB_last=int(last.qB.sum()),\n                       hist_validA_last=int(last.validA.sum()),\n                       origin_minus_latest_min=(origin - latest) / pd.Timedelta(minutes=1))\n\n            # ---- states at origin T and at the six targets\n            days = pd.date_range(origin.normalize() - pd.Timedelta(days=1), tts.max().normalize() + pd.Timedelta(days=1), freq=\"D\")\n            frames = [f for f in (load_day(x.date()) for x in days) if f is not None]\n            if not frames:\n                rec[\"status\"] = \"no state files for window dates\"\n                records.append(rec)\n                continue\n            st = pd.concat(frames, ignore_index=True)\n            st = st[st.timestamp.isin(tts.union(pd.DatetimeIndex([origin])))]\n            rec[\"state_dup_keys\"] = int(st.duplicated([\"timestamp\", \"link_id\"]).sum())\n            st = st.drop_duplicates([\"timestamp\", \"link_id\"])\n\n            of = flag(st[st.timestamp == origin], vcut)\n            rec.update(origin_state_rows=len(of), origin_qA=int(of.qA.sum()), origin_qB=int(of.qB.sum()),\n                       origin_validA=int(of.validA.sum()))\n\n            tk = t[[\"timestamp\", \"link_id\"]].drop_duplicates().merge(\n                st, on=[\"timestamp\", \"link_id\"], how=\"left\", indicator=True, validate=\"one_to_one\")\n            rec[\"target_rows_no_state\"] = int((tk[\"_merge\"] == \"left_only\").sum())\n            tf = flag(tk.drop(columns=\"_merge\"), vcut)\n            rec.update(target_rows=len(tf), hz_validA=int(tf.validA.sum()),\n                       hz_unknownA=int((~tf.validA).sum()),\n                       hz_qA=int(tf.qA.sum()), hz_qB=int(tf.qB.sum()), hz_band=int(tf.band.sum()),\n                       hz_qA_by_step=tuple(int(tf[tf.timestamp == ts].qA.sum()) for ts in tts))\n            rec[\"status\"] = \"ok\"\n            records.append(rec)\n    except Exception as e:\n        panel_errors[panel] = f\"{type(e).__name__}: {e}\"\n        print(f\"[{panel}] ERROR (panel skipped): {panel_errors[panel]}\")\n\nres = pd.DataFrame(records)\nif res.empty or \"status\" not in res or not (res.status == \"ok\").any():\n    raise RuntimeError(f\"No windows checked. Panel errors: {panel_errors}\")\nok = res[res.status ==