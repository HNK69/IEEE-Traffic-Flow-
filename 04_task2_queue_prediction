ist(pq.read_schema(path).names)\n    return list(pd.read_csv(path, nrows=0).columns)\n\n\ndef read_table(path, cols=None):\n    path = Path(path)\n    if path.suffix.lower() == \".parquet\":\n        return pd.read_parquet(path, columns=cols)\n    return pd.read_csv(path, usecols=cols)\n\n\ndef utc(s):\n    return pd.to_datetime(s, utc=True, errors=\"coerce\")\n\n\n# ---------------------------------------------------------------------------\n# 1. Discover training-window metadata / history / template files (TRAIN split only)\n# ---------------------------------------------------------------------------\nsection(\"1. Discovery of Task 2 TRAIN files (nothing assumed; listings are actual)\")\nfor name, p in [(\"Release root\", RELEASE_ROOT), (\"task2 dir\", TASK2), (\"corridors dir\", CORR)]:\n    print(f\"  [{'OK     ' if p.exists() else 'MISSING'}] {name}: {p}\")\nif not TASK2.is_dir():\n    raise FileNotFoundError(f\"Task 2 directory not found: {TASK2}\")\n\nfound = {}\nsearched = []\nfor panel in PANELS:\n    tdir = TASK2 / panel / \"train\"\n    searched.append(str(tdir))\n    if not tdir.is_dir():\n        print(f\"  [{panel}] train directory MISSING: {tdir}\")\n        continue\n    entries = sorted(p.name for p in tdir.iterdir())\n    print(f\"  [{panel}] entries in {tdir.relative_to(RELEASE_ROOT)}: {entries}\")\n\n    def pick(pattern):\n        m = sorted(tdir.glob(pattern)) or sorted(tdir.rglob(pattern))\n        if len(m) > 1:\n            print(f\"    NOTE: {len(m)} matches for '{pattern}' -> using first: {[x.name for x in m]}\")\n        return m[0] if m else None\n\n    found[panel] = {\"window_index\": pick(\"window_index*\"),\n                    \"window_history\": pick(\"window_history*\"),\n                    \"template\": pick(\"*sample_submission*queue*\")}\n    for k, v in found[panel].items():\n        print(f\"    {k}: {v.relative_to(RELEASE_ROOT) if v else 'NOT FOUND'}\")\n\nusable = [p for p, d in found.items() if d[\"window_index\"] and d[\"window_history\"] and d[\"template\"]]\nif not usable:\n    print(\"\\nSEARCHED (train dirs, patterns window_index*, window_history*, *sample_submission*queue*, \"\n          \"direct glob then recursive glob):\")\n    for s in searched:\n        print(f\"  - {s}\")\n    other = sorted(str(p.relative_to(RELEASE_ROOT)) for p in TASK2.rglob(\"window_index*\"))[:40]\n    print(f\"Any window_index* anywhere under task2 (first 40): {other}\")\n    raise RuntimeError(\"Training-window metadata/history/template not found for any panel; stopping \"\n                       \"without inventing a substitute.\")\nprint(f\"\\nPanels with window_index + window_history + template: {usable}\")\nmissing_panels = [p for p in PANELS if p not in usable]\nif missing_panels:\n    print(f\"Panels lacking at least one of the three files (skipped): {missing_panels}\")\n\n# ---------------------------------------------------------------------------\n# 2. Window metadata: counts by panel and condition\n# ---------------------------------------------------------------------------\nsection(\"2. Training windows by panel and condition (from window_index)\")\nmeta_parts, meta_schema = [], {}\nfor panel in usable:\n    p = found[panel][\"window_index\"]\n    wi = read_table(p)\n    meta_schema[panel] = list(wi.columns)\n    if \"window_id\" not in wi.columns:\n        raise ValueError(f\"[{panel}] {p.name} has no 'window_id'. Columns: {list(wi.columns)}\")\n    if wi[\"window_id\"].duplicated().any():\n        raise ValueError(f\"[{panel}] duplicate window_id values in {p.name}\")\n    wi = wi.copy()\n    wi[\"window_id\"] = wi[\"window_id\"].astype(str)\n    wi[\"panel\"] = panel\n    if \"condition\" not in wi.columns:\n        print(f\"  [{panel}] WARNING: no 'condition' column; columns: {list(wi.columns)}\")\n        wi[\"condition\"] = \"(no condition column)\"\n    wi[\"forecast_origin\"] = utc(wi[\"forecast_origin\"]) if \"forecast_origin\" in wi.columns else pd.NaT\n    meta_parts.append(wi)\nmeta = pd.concat(meta_parts, ignore_index=True)\nprint(f\"  window_index columns (first panel {usable[0]}): {meta_schema[usable[0]]}\")\nprint(f\"  forecast_origin present in all panels: \"\n      f\"{all('forecast_origin' in c for c in meta_schema.values())}\")\nprint(f\"\\n  Total training windows: {len(meta)}\")\nprint(pd.crosstab(meta[\"panel\"], meta[\"condition\"], margins=True).to_string())\n\n# ---------------------------------------------------------------------------\n# 3. Per-panel alignment checks\n# ---------------------------------------------------------------------------\nsection(\"3. Per-panel alignment checks (history + template targets vs unmasked mainline_states)\")\nSTATE_COLS_REQUIRED = [\"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"]\nrows, step_rows, raw_info, panel_notes, panel_errors = [], [], {}, {}, {}\n\nfor panel in usable:\n    try:\n        d = found[panel]\n        # ---- network free speed\n        links_path = CORR / panel / \"network\" / \"links.csv\"\n        if not links_path.exists():\n            raise FileNotFoundError(f\"missing {links_path}\")\n        links = pd.read_csv(links_path, usecols=[\"link_id\", \"free_speed_kmh\"])\n        links[\"link_id\"] = links[\"link_id\"].astype(str)\n        links[\"free_speed_kmh\"] = pd.to_numeric(links[\"free_speed_kmh\"], errors=\"coerce\")\n        if links[\"link_id\"].duplicated().any():\n            raise ValueError(\"links.csv has duplicate link_id\")\n\n        # ---- history (only needed columns)\n        hcols_all = table_cols(d[\"window_history\"])\n        for c in [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\"]:\n            if c not in hcols_all:\n                raise ValueError(f\"window_history missing '{c}'. Columns: {hcols_all}\")\n        hcols = [c for c in [\"window_id\", \"timestamp\", \"link_id\", \"speed_kmh\", \"is_score_eligible\"] if c in hcols_all]\n        hist = read_table(d[\"window_history\"], hcols)\n        raw_hist_ts = hist[\"timestamp\"].iloc[0]\n        hist[\"window_id\"] = hist[\"window_id\"].astype(str)\n        hist[\"link_id\"] = hist[\"link_id\"].astype(str)\n        hist[\"timestamp\"] = utc(hist[\"timestamp\"])\n        hist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\n        has_h_elig = \"is_score_eligible\" in hist.columns\n        if has_h_elig:\n            hist[\"is_score_eligible\"] = pd.to_numeric(hist[\"is_score_eligible\"], errors=\"coerce\")\n\n        # ---- template (defines target timestamps/links actually requested)\n        tcols_all = table_cols(d[\"template\"])\n        for c in [\"window_id\", \"timestamp\", \"link_id\"]:\n            if c not in tcols_all:\n                raise ValueError(f\"template missing '{c}'. Columns: {tcols_all}\")\n        tmpl = read_table(d[\"template\"], [\"window_id\", \"timestamp\", \"link_id\"])\n        raw_tmpl_ts = tmpl[\"timestamp\"].iloc[0]\n        tmpl[\"window_id\"] = tmpl[\"window_id\"].astype(str)\n        tmpl[\"link_id\"] = tmpl[\"link_id\"].astype(str)\n        tmpl[\"timestamp\"] = utc(tmpl[\"timestamp\"])\n\n        pm = meta[meta.panel == panel].sort_values(\"window_id\")\n        if MAX_WINDOWS_PER_PANEL:\n            pm = pm.head(MAX_WINDOWS_PER_PANEL)\n        extra_t = set(tmpl.window_id) - set(meta.loc[meta.panel == panel, \"window_id\"])\n        extra_h = set(hist.window_id) - set(meta.loc[meta.panel == panel, \"window_id\"])\n        miss_t = set(pm.window_id) - set(tmpl.window_id)\n        miss_h = set(pm.window_id) - set(hist.window_id)\n        panel_notes[panel] = dict(template_windows_not_in_index=len(extra_t),\n                                  history_windows_not_in_index=len(extra_h),\n                                  index_windows_without_template=len(miss_t),\n                                  index_windows_without_history=len(miss_h),\n                                  raw_history_ts=repr(raw_hist_ts), raw_template_ts=repr(raw_tmpl_ts))\n        hist_by = {k: v for k, v in hist.groupby(\"window_id\")}\n        tmpl_by = {k: v for k, v in tmpl.groupby(\"window_id\")}\n\n        # ---- state-file index (filename dates only; no data read)\n        sdir = CORR / panel / \"train\" / \"mainline_states\"\n        if not sdir.is_dir():\n            raise FileNotFoundError(f\"missing {sdir}\")\n        idx, bad_names = defaultdict(list), []\n        for f in sorted(sdir.rglob(\"*.parquet\")):\n            m = re.search(r\"(\\d{4})_(\\d{2})_(\\d{2})\", f.name)\n            if m:\n                idx[pd.Timestamp(f\"{m[1]}-{m[2]}-{m[3]}\").date()].append(f)\n            else:\n                bad_names.append(f.name)\n        if not idx:\n            raise FileNotFoundError(f\"no dated parquet files under {sdir}\")\n        panel_notes[panel].update(n_state_files=sum(len(v) for v in idx.values()),\n                                  state_date_min=str(min(idx)), state_date_max=str(max(idx)),\n                                  state_files_without_date_in_name=len(bad_names),\n                                  dates_with_multiple_files=sum(1 for v in idx.values() if len(v) > 1))\n        cache = OrderedDict()\n\n        def load_day(day):\n            if day in cache:\n                cache.move_to_end(day)\n                return cache[day]\n            frames = []\n            for f in idx.get(day, []):\n                sc = table_cols(f)\n                miss = [c for c in STATE_COLS_REQUIRED if c not in sc]\n                if miss:\n                    raise ValueError(f\"{f.name} missing columns {miss}; columns: {sc}\")\n                s = pd.read_parquet(f, columns=STATE_COLS_REQUIRED)\n                if \"state_raw_ts\" not in panel_notes[panel]:\n                    panel_notes[panel][\"state_raw_ts\"] = repr(s[\"timestamp\"].iloc[0])\n                    panel_notes[panel][\"state_timestamp_dtype\"] = str(s[\"timestamp\"].dtype)\n                s[\"timestamp\"] = utc(s[\"timestamp\"])\n                s[\"link_id\