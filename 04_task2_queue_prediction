SKED_DIR = RELEASE_ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\n\nBAR = \"=\" * 100\n\n\ndef section(title):\n    print(f\"\\n{BAR}\\n{title}\\n{BAR}\")\n\n\ndef read_text(p):\n    return Path(p).read_text(encoding=\"utf-8\", errors=\"replace\")\n\n\ndef print_numbered(lines, start=1):\n    for i, ln in enumerate(lines, start=start):\n        print(f\"{i:5d}| {ln}\")\n\n\ndef print_full(p, max_lines=600):\n    lines = read_text(p).splitlines()\n    print(f\"[{p}] {len(lines)} lines\")\n    print_numbered(lines[:max_lines])\n    if len(lines) > max_lines:\n        print(f\"... truncated: {len(lines) - max_lines} more lines not shown\")\n\n\ndef grep_context(p, pattern, before=3, after=6, max_blocks=40, max_lines_total=400):\n    \"\"\"Print line blocks (with original line numbers) around regex matches; merges overlaps.\"\"\"\n    lines = read_text(p).splitlines()\n    rx = re.compile(pattern, re.IGNORECASE)\n    hits = [i for i, ln in enumerate(lines) if rx.search(ln)]\n    if not hits:\n        print(f\"[{p.name}] no lines match /{pattern}/\")\n        return hits\n    blocks = []\n    for i in hits:\n        s, e = max(0, i - before), min(len(lines) - 1, i + after)\n        if blocks and s <= blocks[-1][1] + 1:\n            blocks[-1][1] = max(blocks[-1][1], e)\n        else:\n            blocks.append([s, e])\n    print(f\"[{p.name}] {len(hits)} matching line(s), {len(blocks)} block(s) for /{pattern}/\")\n    shown = 0\n    for b, (s, e) in enumerate(blocks[:max_blocks], 1):\n        if shown + (e - s + 1) > max_lines_total:\n            print(f\"... output cap reached; {len(blocks) - b + 1} block(s) not shown\")\n            break\n        print(f\"--- block {b}: lines {s + 1}-{e + 1} ---\")\n        print_numbered(lines[s:e + 1], start=s + 1)\n        shown += e - s + 1\n    return hits\n\n\n# ---------------------------------------------------------------------------\n# 1. Existence checks\n# -------------------------------------------