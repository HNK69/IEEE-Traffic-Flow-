nmatched, \"window_id\"].drop_duplicates().head(10).tolist())\n\nmatched = merged.loc[~unmatched].drop(columns=\"_merge\").copy()\nif matched.empty:\n    raise ValueError(\"No prediction rows matched any validation window. Cannot summarize by condition.\")\n\n# Ensure queue_pred is numeric binary before aggregating\nmatched[\"queue_pred\"] = pd.to_numeric(matched[\"queue_pred\"], errors=\"coerce\")\nbad_pred = matched[\"queue_pred\"].isna() | ~matched[\"queue_pred\"].isin([0, 1])\nif bad_pred.any():\n    raise ValueError(f\"queue_pred contains {int(bad_pred.sum())} non-binary/invalid values among matched rows.\")\nmatched[\"queue_pred\"] = matched[\"queue_pred\"].astype(int)\n\n# Warn if condition has missing values after join\nn_missing_cond = int(matched[\"condition\"].isna().sum())\nif n_missing_cond:\n    print(f\"\\nWARNING: {n_missing_cond:,} matched rows have missing 'condition'; they appear as NaN groups below.\")\n\n# ---- 6. Prediction counts by condition ----\nprint(\"\\n=== Prediction row counts by condition ===\")\nprint(matched[\"condition\"].value_counts(dropna=False).to_string())\n\n# ---- 7/8. Queue prediction statistics ----\ndef queue_stats(df, by):\n    g = df.groupby(by, dropna=False)\n    out = g.agg(\n        total_cells=(\"queue_pred\", \"size\"),\n        predicted_queue_cells=(\"queue_pred\", \"sum\"),\n        unique_windows=(\"window_id\", \"nunique\"),\n    )\n    out[\"queue_prediction_rate\"] = out[\"predicted_queue_cells\"] / out[\"total_cells\"]\n    return out[[\"total_cells\", \"predicted_queue_cells\", \"queue_prediction_rate\", \"unique_windows\"]]\n\nwith pd.option_context(\"display.max_rows\", None, \"display.max_columns\", None, \"display.width\", 200):\n    print(\"\\n=== Queue prediction statistics by condition ===\")\n    print(queue_stats(matched, \"condition\").to_string(float_format=lambda x: f\"{x:.6f}\"))\n\n    print(\"\\n=== Queue prediction statistics by (panel, condition) ===\")\n    print(queue_stats(matched, [\"p