 — Compare onset and ongoing history features\n\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport pyarrow.parquet as pq\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nTASK2_ROOT = ROOT / \"task2\"\nCORRIDORS_ROOT = ROOT / \"corridors\"\nPANELS = [\"D12_I5_N\", \"D12_I5_S\", \"D7_I10_E\", \"D7_I10_W\",\n          \"D7_I210_E\", \"D7_I210_W\", \"D7_I405_N\", \"D7_I405_S\"]\nTHRESHOLD_FRAC = 0.60\n\n# Column names are resolved at runtime from the first matching candidate, and the resolved\n# mapping is printed. Verified window_history.parquet columns:\n#   window_id, timestamp, link_id, speed_kmh, flow_vph, occupancy, pct_observed, is_score_eligible\n# `is_score_eligible` is REQUIRED: eligibility is never substituted with \"speed is nonmissing\".\nCANDIDATES = {\n    \"timestamp\": [\"timestamp\"],\n    \"speed\": [\"speed_kmh\"],\n    \"flow\": [\"flow_vph\", \"flow\", \"flow_veh_h\", \"volume\"],\n    \"occupancy\": [\"occupancy\", \"occ\"],\n    \"eligible\": [\"is_score_eligible\"],\n    \"free_speed\": [\"free_speed_kmh\"],\n}\n\n\ndef resolve(kind, columns, required=True, where=\"\"):\n    for c in CANDIDATES[kind]:\n        if c in columns:\n            return c\n    if required:\n        raise ValueError(f\"[{where}] No column found for '{kind}'. Tried {CANDIDATES[kind]}. \"\n                         f\"Columns present: {list(columns)}\")\n    return None\n\n\ndef require_file(p):\n    if not Path(p).is_file():\n        raise FileNotFoundError(f\"Missing file: {p}\")\n    return Path(p)\n\n\ndef mean_or_nan(s):\n    return float(s.mean()) if s.notna().any() else np.nan\n\n\ndef window_features(h, ts_col, spd, flw, occ, elig_flag, fs):\n    \"\"\"h: history rows of one window (already merged with free speed).\"\"\"\n    ts_sorted = np.sort(h[ts_col].dropna().unique())\n    if len(ts_sorted) == 0:\n        raise ValueError(\"Window has no valid history timestamps.\")\n    latest, earliest = ts_sorted[-1], ts_sorted[0]\n\n    # Eligible row = is_score_eligible == 1 AND speed nonmissing AND valid (>0) free speed\n    elig = (\n        (pd.to_numeric(h[elig_flag], errors=\"coerce\") == 1)\n        & h[spd].notna()\n        & h[fs].notna()\n        & (h[fs] > 0)\n    )\n    h = h.assign(_elig=elig)\n\n    last = h[(h[ts_col] == latest) & h[\"_elig\"]]\n    below = (last[spd] <= THRESHOLD_FRAC * last[fs])\n    n_elig = int(len(last))\n\n    first3 = h[h[ts_col].isin(ts_sorted[:3]) & h[\"_elig\"]]\n    last3 = h[h[ts_col].isin(ts_sorted[-3:]) & h[\"_elig\"]]\n\n    out = {\n        \"latest_history_ts\": pd.Timestamp(latest),\n        \"earliest_history_ts\": pd.Timestamp(earliest),\n        \"n_history_timestamps\": int(len(ts_sorted)),\n        \"n_eligible_links\": n_elig,\n        \"elig_mean_speed\": mean_or_nan(last[spd]),\n        \"elig_mean_flow\": mean_or_nan(last[flw]),\n        \"elig_mean_occupancy\": mean_or_nan(last[occ]),\n        \"n_links_below_thresh\": int(below.sum()),\n        \"frac_links_below_thresh\": float(below.sum() / n_elig) if n_elig else np.nan,\n        \"speed_first3\": mean_or_nan(first3[spd]),\n        \"speed_last3\": mean_or_nan(last3[spd]),\n        \"flow_first3\": mean_or_nan(first3[flw]),\n        \"flow_last3\": mean_or_nan(last3[flw]),\n    }\n    out[\"speed_diff_last_minus_first\"] = out[\"speed_last3\"] - out[\"speed_first3\"]\n    out[\"flow_diff_last_minus_first\"] = out[\"flow_last3\"] - out[\"flow_first3\"]\n    return out\n\n\nfeature_tables = []\norigin_checks = []\nresolved_report = {}\n\nfor panel in PANELS:\n    wi_path = require_file(TASK2_ROOT / panel / \"validation\" / \"window_index.csv\")\n    wh_path = require_file(TASK2_ROOT / panel / \"validation\" / \"window_history.parquet\")\n    links_path = require_file(CORRIDORS_ROOT / panel / \"network\" / \"links.csv\")\n\n    # ---- window_index ----\n    wi = pd.read_csv(wi_path)\n    for c in [\"window_id\", \"condition\"]:\n        if c not in w