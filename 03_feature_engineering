emporal_only\": TEMPORAL_FEATURES,\n\n    \"physical_availability\": (\n        PHYSICAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n\n    \"physical_temporal\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n    ),\n\n    \"all_features\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n}\n\n\n# ------------------------------------------------------------\n# 2. Fixed model configuration\n# ------------------------------------------------------------\n\nMODEL_PARAMS_MULTI = {\n    \"n_estimators\": 300,\n    \"max_depth\": 8,\n    \"learning_rate\": 0.05,\n    \"subsample\": 0.8,\n    \"colsample_bytree\": 0.8,\n    \"objective\": \"reg:squarederror\",\n    \"tree_method\": \"hist\",\n    \"random_state\": 42,\n    \"n_jobs\": -1,\n}\n\n\n# ------------------------------------------------------------\n# 3. Evaluation function\n# ------------------------------------------------------------\n\ndef evaluate_task1(\n    y_true,\n    pred_speed,\n    pred_flow,\n    lanes\n):\n\n    speed_rmse = np.sqrt(\n        mean_squared_error(\n            y_true[\"target_speed\"],\n            pred_speed\n        )\n    )\n\n    flow_true_per_lane = (\n        y_true[\"target_flow\"].to_numpy()\n        / lanes\n    )\n\n    flow_pred_per_lane = (\n        pred_flow\n        / lanes\n    )\n\n    flow_rmse_per_lane = np.sqrt(\n        mean_squared_error(\n            flow_true_per_lane,\n            flow_pred_per_lane\n        )\n    )\n\n    speed_score = max(\n        0.0,\n        1.0 - speed_rmse / 25.0\n    )\n\n    flow_score = max(\n        0.0,\n        1.0 - flow_rmse_per_lane / 600.0\n    )\n\n    state_score = (\n        0.54 * speed_score\n        + 0.46 * flow_score\n    )\n\n    return {\n        \"speed_rmse\": speed_rmse,\n        \"flow_rmse_per_lane\": flow_rmse_per_lane,\n        \"speed_score\": speed_score,\n        \"flow_score\": flow_score,\n        \"state_score\": state_score,\n    }\n