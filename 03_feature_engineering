n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>traffic_state</th>\n      <th>n_targets</th>\n      <th>q25_low_speed_rate</th>\n      <th>q10_very_low_speed_rate</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>congested</td>\n      <td>381</td>\n      <td>0.367454</td>\n      <td>0.792651</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>moderate</td>\n      <td>29</td>\n      <td>0.379310</td>\n      <td>0.896552</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>free_flow</td>\n      <td>6802</td>\n      <td>0.060129</td>\n      <td>0.129815</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n================================================================================\nCELL 16B CHECKPOINT\n================================================================================\n✓ Same-timestamp cross-link aggregates created\n✓ Target truth correlations calculated\n✓ Traffic-state separation measured\n✓ Severe congestion signal measured\n✓ No target traffic value used in aggregate\n\nCELL 16B COMPLETE\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# ============================================================\n# CELL 16C — CROSS-LINK SIGNAL UNDER MISSING TARGET HISTORY\n# ============================================================\n\nprint(\"=\" * 80)\nprint(\"CELL 16C — CROSS-LINK SIGNAL WHEN TARGET LAG-1 IS MISSING\")\nprint(\"=\" * 80)\n\n\n# ------------------------------------------------------------\n# 1. Normalize timestamp dtype in cross_signal\n# ------------------------------------------------------------\n\ncross_signal[\"timestamp\"] = pd.to_datetime(\n    cross_signal[\"timestamp\"],\n    utc=True\n)\n\n\n# ------------------------------------------------------------\n# 2. Recover target-link temporal history from masked data\n# ------------------------------------------------------------\n\nmasked_hist = masked[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh\",\n        \"flow_vph\",\n    ]\n].copy()\n\nmasked_hist[\"timestamp\"] = pd.to_datetime(\n    masked_hist[\"timestamp\"],\n    utc=True\n)\n\nmasked_hist = masked_hist.sort_values(\n    [\"link_id\", \"timestamp\"]\n)\n\n\n# Previous timestep = lag 1\nmasked_hist[\"speed_lag_1\"] = (\n    masked_hist\n    .groupby(\"link_id\")[\"speed_kmh\"]\n    .shift(1)\n)\n\nmasked_hist[\"flow_lag_1\"] = (\n    masked_hist\n    .groupby(\"link_id\")[\"flow_vph\"]\n    .shift(1)\n)\n\n\n# ------------------------------------------------------------\n# 3. Merge lag-1 information\n# ------------------------------------------------------------\n\ncross_signal = cross_signal.merge(\n    masked_hist[\n        [\n            \"timestamp\",\n            \"link_id\",\n            \"speed_lag_1\",\n            \"flow_lag_1\",\n        ]\n    ],\n    on=[\"timestamp\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\n\n# ------------------------------------------------------------\n# 4. Identify missing target lag-1\n# ------------------------------------------------------------\n\ncross_signal[\"lag1_speed_missing\"] = (\n    cross_signal[\"speed_lag_1\"].isna()\n)\n\ncross_signal[\"lag1_flow_missing\"] = (\n    cross_signal[\"flow_lag_1\"].isna()\n)\n\n\nanalysis = cross_signal.loc[\n    cross_signal[\"lag1_speed_missing\"]\n].copy()\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LAG-1 MISSING SUBSET\")\nprint(\"=\" * 80)\n\nprint(\"Total targets:\", len(cross_signal))\nprint(\"Lag-1 missing:\", len(analysis))\nprint(\n    \"Lag-1 missing rate:\",\n    len(analysis) / len(cross_signal)\n)\n\n\n# ------------------------------------------------------------\n# 5. Define target traffic state\n# ------------------------------------------------------------\n\nanalysis[\"traffic_state\"] = pd.cut(\n    analysis[\"speed_kmh_truth\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf,\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\",\n    ],\n)\n\n\n# ------------------------------------------------------------\n# 6. Compare cross-link signals by traffic state\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CROSS-LINK SIGNAL — LAG-1 MISSING\")\nprint(\"=\" * 80)\n\nstate_summary = (\n    analysis\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\n            \"speed_kmh_truth\",\n            \"size\"\n        ),\n\n        target_speed=(\n            \"speed_kmh_truth\",\n            \"mean\"\n        ),\n\n        cross_mean_speed=(\n            \"mean_speed\",\n            \"mean\"\n        ),\n\n        cross_q25_speed=(\n            \"q25_speed\",\n            \"mean\"\n        ),\n\n        cross_q10_speed=(\n            \"q10_speed\",\n            \"mean\"\n        ),\n\n        cross_min_speed=(\n            \"min_speed\",\n            \"mean\"\n        ),\n\n        cross_mean_flow=(\n            \"mean_flow\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(state_summary)\n\n\n# ------------------------------------------------------------\n# 7. Correlations specifically on lag-1 missing targets\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CORRELATIONS — LAG-1 MISSING\")\nprint(\"=\" * 80)\n\nsignal_columns = [\n    \"mean_speed\",\n    \"median_speed\",\n    \"min_speed\",\n    \"q25_speed\",\n    \"q10_speed\",\n    \"mean_flow\",\n    \"median_flow\",\n    \"max_flow\",\n]\n\ncorr_rows = []\n\nfor feature in signal_columns:\n\n    speed_corr = (\n        analysis[\n            [\n                feature,\n                \"speed_kmh_truth\",\n            ]\n        ]\n        .dropna()\n        .corr()\n        .iloc[0, 1]\n    )\n\n    flow_corr = (\n        analysis[\n            [\n                feature,\n                \"flow_vph_truth\",\n            ]\n        ]\n        .dropna()\n        .corr()\n        .iloc[0, 1]\n    )\n\n    corr_rows.append(\n        {\n            \"feature\": feature,\n            \"speed_correlation\": speed_corr,\n            \"flow_correlation\": flow_corr,\n        }\n    )\n\ncorr_missing = pd.DataFrame(\n    corr_rows\n)\n\ndisplay(corr_missing)\n\n\n# ------------------------------------------------------------\n# 8. Congestion indicators\n# ------------------------------------------------------------\n\nanalysis[\"cross_q10_below_50\"] = (\n    analysis[\"q10_speed\"] < 50\n)\n\nanalysis[\"cross_q25_below_70\"] = (\n    analysis[\"q25_speed\"] < 70\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CONGESTION INDICATORS — LAG-1 MISSING\")\nprint(\"=\" * 80)\n\nindicator_summary = (\n    analysis\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\n            \"speed_kmh_truth\",\n            \"size\"\n        ),\n\n        q25_below_70_rate=(\n            \"cross_q25_below_70\",\n            \"mean\"\n        ),\n\n        q10_below_50_rate=(\n            \"cross_q10_below_50\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(indicator_summary)\n\n\n# ------------------------------------------------------------\n# 9. Lag-1 missing + congested targets\n# ------------------------------------------------------------\n\ncongested = (\n    analysis[\"speed_kmh_truth\"] < 70\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LAG-1 MISSING + CONGESTED TARGETS\")\nprint(\"=\" * 80)\n\nprint(\n    \"Count:\",\n    congested.sum()\n)\n\nif congested.sum() > 0:\n\n    display(\n        analysis.loc[\n            congested,\n            [\n                \"speed_kmh_truth\",\n                \"mean_speed\",\n                \"median_speed\",\n                \"q25_speed\",\n                \"q10_speed\",\n                \"min_speed\",\n                \"mean_flow\",\n                \"observed_links\",\n                \"cross_q25_below_70\",\n                \"cross_q10_below_50\",\n            ]\n        ].describe()\n    )\n\n\n# ------------------------------------------------------------\n# 10. Congested vs free-flow\n# ------------------------------------------------------------\n\nfree_flow = (\n    analysis[\"speed_kmh_truth\"] >= 100\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CONGESTED VS FREE-FLOW — LAG-1 MISSING\")\nprint(\"=\" * 80)\n\ncomparison = pd.DataFrame(\n    {\n        \"group\": [\n            \"congested\",\n            \"free_flow\",\n        ],\n\n        \"n\": [\n            congested.sum(),\n            free_flow.sum(),\n        ],\n\n        \"target_speed_mean\": [\n            analysis.loc[\n                congested,\n                \"speed_kmh_truth\"\n            ].mean(),\n\n            analysis.loc[\n                free_flow,\n                \"speed_kmh_truth\"\n            ].mean(),\n        ],\n\n        \"cross_mean_speed\": [\n            analysis.loc[\n                congested,\n                \"mean_speed\"\n            ].mean(),\n\n            analysis.loc[\n                free_flow,\n                \"mean_speed\"\n            ].mean(),\n        ],\n\n        \"cross_q10_speed\": [\n            analysis.loc[\n                congested,\n                \"q10_speed\"\n            ].mean(),\n\n            analysis.loc[\n                free_flow,\n                \"q10_speed\"\n            ].mean(),\n        ],\n\n        \"cross_mean_flow\": [\n            analysis.loc[\n                congested,\n                \"mean_flow\"\n            ].mean(),\n\n            analysis.loc[\n                free_flow,\n                \"mean_flow\"\n            ].mean(),\n        ],\n    }\n)\n\ndisplay(comparison)\n\n\n# ------------------------------------------------------------\n# 11. Final checkpoint\n# ------------------------------------------------------------\n\nassert len(analysis) > 0\nassert \"lag1_speed_missing\" in cross_signal.columns\nassert \"mean_speed\" in analysis.columns\nassert \"q10_speed\" in analysis.columns\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 16C CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\"✓ Timestamp dtypes normalized\")\nprint(\"✓ Target lag-1 availability recovered\")\nprint(\"✓ Lag-1 missing subset isolated\")\nprint(\"✓ Cross-link signal tested on difficult subset\")\nprint(\"✓ Congested vs free-flow separation measured\")\nprint(\"✓ No target truth used as a feature\")\n\nprint(\"\\nCELL 16C COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-08T18:18:20.879349Z","iopub.execute_input":"2026-10-08T18:18:20.88005Z","iopub.status.idle":"2026-10-08T18:18:21.063652Z","shell.execute_reply.started":"2026-10-08T18:18:20.880015Z","shell.execute_reply":"2026-10-08T18:18:21.062102Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nCELL 16C — CROSS-LINK SIGNAL WHEN TARGET LAG-1 IS MISSING\n================================================================================\n\n================================================================================\nLAG-1 MISSING SUBSET\n================================================================================\nTotal targets: 7212\nLag-1 missing: 2710\nLag-1 missing rate: 0.3757626178591237\n\n================================================================================\nCROSS-LINK SIGNAL — LAG-1 MISSING\n================================================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  traffic_state  n_targets  target_speed  cross_mean_speed  cross_q25_speed  \\\n0     congested        143     38.912335         97.2