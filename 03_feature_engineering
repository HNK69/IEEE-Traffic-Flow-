n\nprint(\n    \"\\nCELL 12 COMPLETE\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T19:13:56.497373Z","iopub.execute_input":"2026-10-07T19:13:56.497618Z","iopub.status.idle":"2026-10-07T19:14:59.536212Z","shell.execute_reply.started":"2026-10-07T19:13:56.497599Z","shell.execute_reply":"2026-10-07T19:14:59.535583Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 13 — STAGE 3 CHECKPOINT / SESSION HANDOFF\n# ============================================================\n\nimport os\nimport json\nimport joblib\nfrom pathlib import Path\n\nCHECKPOINT_DIR = Path(\n    \"/kaggle/working/stage3_checkpoint\"\n)\n\nCHECKPOINT_DIR.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\n\n# ------------------------------------------------------------\n# 1. Save feature datasets\n# ------------------------------------------------------------\n\nprint(\"=\" * 80)\nprint(\"SAVING STAGE 3 DATASETS\")\nprint(\"=\" * 80)\n\nX_train_multi.to_parquet(\n    CHECKPOINT_DIR / \"X_train_multi.parquet\",\n    index=False\n)\n\nX_valid_multi.to_parquet(\n    CHECKPOINT_DIR / \"X_valid_multi.parquet\",\n    index=False\n)\n\ny_train_multi.to_parquet(\n    CHECKPOINT_DIR / \"y_train_multi.parquet\",\n    index=False\n)\n\ny_valid_multi.to_parquet(\n    CHECKPOINT_DIR / \"y_valid_multi.parquet\",\n    index=False\n)\n\nvalid_multi.to_parquet(\n    CHECKPOINT_DIR / \"valid_multi.parquet\",\n    index=False\n)\n\nerror_df.to_parquet(\n    CHECKPOINT_DIR / \"error_df.parquet\",\n    index=False\n)\n\nprint(\"✓ Feature datasets saved\")\n\n\n# ------------------------------------------------------------\n# 2. Save trained models\n# ------------------------------------------------------------\n\njoblib.dump(\n    speed_model_error,\n    CHECKPOINT_DIR / \"stage3_speed_model.joblib\"\n)\n\njoblib.dump(\n    flow_model_error,\n    CHECKPOINT_DIR / \"stage3_flow_model.joblib\"\n)\n\nprin