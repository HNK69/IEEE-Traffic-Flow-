      <td>2012.624155</td>\n      <td>72</td>\n      <td>72</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n================================================================================\nCELL 16A CHECKPOINT\n================================================================================\n✓ Correct train masked file loaded\n✓ Corresponding unmasked truth loaded\n✓ Masking verified\n✓ Same-timestamp cross-link availability measured\n✓ No topology assumptions made\n\nCELL 16A COMPLETE\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# ============================================================\n# CELL 16B — CROSS-LINK SIGNAL\n# ============================================================\n\nprint(\"=\" * 80)\nprint(\"CELL 16B — SAME-TIMESTAMP CROSS-LINK SIGNAL\")\nprint(\"=\" * 80)\n\n\n# ------------------------------------------------------------\n# 1. Build observed-link table\n# ------------------------------------------------------------\n\nobserved = masked[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh\",\n        \"flow_vph\",\n    ]\n].copy()\n\n\n# ------------------------------------------------------------\n# 2. Build target lookup\n# ------------------------------------------------------------\n\ntarget_lookup = targets[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh_truth\",\n        \"flow_vph_truth\",\n    ]\n].copy()\n\n\n# ------------------------------------------------------------\n# 3. For every timestamp calculate aggregate traffic\n#    across OTHER observed links.\n# ------------------------------------------------------------\n\ntimestamp_agg = (\n    observed\n    .groupby(\"timestamp\")\n    .agg(\n        mean_speed=(\"speed_kmh\", \"mean\"),\n        median_speed=(\"speed_kmh\", \"median\"),\n        min_speed=(\"speed_kmh\", \"min\"),\n        q25_speed=(\n            \"speed_kmh\",\n            lambda x: x.quantile(0.25)\n        ),\n        q10_speed=(\n            \"speed_kmh\",\n            lambda x: x.quantile(0.10)\n        ),\n\n        mean_flow=(\"flow_vph\", \"mean\"),\n        median_flow=(\"flow_vph\", \"median\"),\n        max_flow=(\"flow_vph\", \"max\"),\n\n        observed_links=(\n            \"speed_kmh\",\n            lambda x: x.notna().sum()\n        ),\n    )\n    .reset_index()\n)\n\n\n# ------------------------------------------------------------\n# 4. Join aggregate signal to targets\n# ------------------------------------------------------------\n\ncross_signal = target_lookup.merge(\n    timestamp_agg,\n    on=\"timestamp\",\n    how=\"left\",\n)\n\n\n# ------------------------------------------------------------\n# 5. IMPORTANT:\n#    The target itself is masked, so it cannot contribute to\n#    these aggregates. However, verify this explicitly.\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CROSS-LINK SIGNAL SUMMARY\")\nprint(\"=\" * 80)\n\nprint(\n    \"Target rows:\",\n    len(cross_signal)\n)\n\nprint(\n    \"Mean observed links:\",\n    cross_signal[\n        \"observed_links\"\n    ].mean()\n)\n\nprint(\n    \"Mean speed:\",\n    cross_signal[\n        \"mean_speed\"\n    ].mean()\n)\n\nprint(\n    \"Mean flow:\",\n    cross_signal[\n        \"mean_flow\"\n    ].mean()\n)\n\n\n# ------------------------------------------------------------\n# 6. Correlation with target truth\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CORRELATION WITH TARGET TRUTH\")\nprint(\"=\" * 80)\n\nsignal_columns = [\n    \"mean_speed\",\n    \"median_speed\",\n    \"min_speed\",\n    \"q25_speed\",\n    \"q10_speed\",\n    \"mean_flow\",\n    \"median_flow\",\n    \"max_flow\",\n]\n\ncorrelation_rows = []\n\nfor feature in signal_columns:\n\n    speed_corr = (\n        cross_signal[\n            [\n                feature,\n                \"speed_kmh_truth\",\n            ]\n        ]\n        .dropna()\n        .corr()\n        .iloc[0, 1]\n    )\n\n    flow_corr = (\n        cross_signal[\n            [\n                feature,\n                \"flow_vph_truth\",\n            ]\n        ]\n        .dropna()\n        .corr()\n        .iloc[0, 1]\n    )\n\n    correlation_rows.append(\n        {\n            \"feature\": feature,\n            \"speed_correlation\": speed_corr,\n            \"flow_correlation\": flow_corr,\n        }\n    )\n\n\ncorrelation_df = pd.DataFrame(\n    correlation_rows\n)\n\ndisplay(correlation_df)\n\n\n# ------------------------------------------------------------\n# 7. Define traffic state from TRUE target\n# ------------------------------------------------------------\n\ncross_signal[\"traffic_state\"] = pd.cut(\n    cross_signal[\"speed_kmh_truth\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf,\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\",\n    ],\n)\n\n\n# ------------------------------------------------------------\n# 8. Compare cross-link speed by traffic state\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CROSS-LINK SPEED BY TARGET TRAFFIC STATE\")\nprint(\"=\" * 80)\n\nstate_signal = (\n    cross_signal\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\n            \"speed_kmh_truth\",\n            \"size\"\n        ),\n\n        target_speed_mean=(\n            \"speed_kmh_truth\",\n            \"mean\"\n        ),\n\n        cross_mean_speed=(\n            \"mean_speed\",\n            \"mean\"\n        ),\n\n        cross_median_speed=(\n            \"median_speed\",\n            \"mean\"\n        ),\n\n        cross_q25_speed=(\n            \"q25_speed\",\n            \"mean\"\n        ),\n\n        cross_q10_speed=(\n            \"q10_speed\",\n            \"mean\"\n        ),\n\n        cross_min_speed=(\n            \"min_speed\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(state_signal)\n\n\n# ------------------------------------------------------------\n# 9. Critical test:\n#    congested target + cross-link signal\n# ------------------------------------------------------------\n\ncongested = (\n    cross_signal[\"traffic_state\"]\n    == \"congested\"\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CONGESTED TARGETS — CROSS-LINK SIGNAL\")\nprint(\"=\" * 80)\n\nprint(\n    \"Congested targets:\",\n    congested.sum()\n)\n\ndisplay(\n    cross_signal.loc[\n        congested,\n        [\n            \"speed_kmh_truth\",\n            \"mean_speed\",\n            \"median_speed\",\n            \"q25_speed\",\n            \"q10_speed\",\n            \"min_speed\",\n            \"mean_flow\",\n            \"observed_links\",\n        ]\n    ].describe()\n)\n\n\n# ------------------------------------------------------------\n# 10. Compare severe congestion\n# ------------------------------------------------------------\n\nsevere_congestion = (\n    cross_signal[\"speed_kmh_truth\"] < 30\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"SEVERE CONGESTION — CROSS-LINK SIGNAL\")\nprint(\"=\" * 80)\n\nprint(\n    \"Severely congested targets:\",\n    severe_congestion.sum()\n)\n\nif severe_congestion.sum() > 0:\n\n    display(\n        cross_signal.loc[\n            severe_congestion,\n            [\n                \"speed_kmh_truth\",\n                \"mean_speed\",\n                \"median_speed\",\n                \"q25_speed\",\n                \"q10_speed\",\n                \"min_speed\",\n                \"mean_flow\",\n                \"observed_links\",\n            ]\n        ].describe()\n    )\n\n\n# ------------------------------------------------------------\n# 11. Strongest simple congestion indicator\n# ------------------------------------------------------------\n# How often do OTHER links also show low speed?\n\ncross_signal[\"other_links_low_speed\"] = (\n    cross_signal[\"q25_speed\"] < 70\n)\n\ncross_signal[\"other_links_very_low_speed\"] = (\n    cross_signal[\"q10_speed\"] < 50\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CROSS-LINK CONGESTION INDICATORS\")\nprint(\"=\" * 80)\n\nindicator_summary = (\n    cross_signal\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\n            \"speed_kmh_truth\",\n            \"size\"\n        ),\n\n        q25_low_speed_rate=(\n            \"other_links_low_speed\",\n            \"mean\"\n        ),\n\n        q10_very_low_speed_rate=(\n            \"other_links_very_low_speed\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(indicator_summary)\n\n\n# ------------------------------------------------------------\n# 12. Final checkpoint\n# ------------------------------------------------------------\n\nassert len(cross_signal) == len(targets)\n\nassert (\n    cross_signal[\n        \"mean_speed\"\n    ].notna().all()\n)\n\nassert (\n    correlation_df.shape[0]\n    == len(signal_columns)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 16B CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\"✓ Same-timestamp cross-link aggregates created\")\nprint(\"✓ Target truth correlations calculated\")\nprint(\"✓ Traffic-state separation measured\")\nprint(\"✓ Severe congestion signal measured\")\nprint(\"✓ No target traffic value used in aggregate\")\nprint(\"\\nCELL 16B COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-08T18:12:16.664671Z","iopub.execute_input":"2026-10-08T18:12:16.665438Z","iopub.status.idle":"2026-10-08T18:12:17.181572Z","shell.execute_reply.started":"2026-10-08T18:12:16.665402Z","shell.execute_reply":"2026-10-08T18:12:17.18057Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nCELL 16B — SAME-TIMESTAMP CROSS-LINK SIGNAL\n=========================