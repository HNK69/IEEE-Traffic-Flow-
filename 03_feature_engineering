ailable.\n    available = shifted[\n        f\"speed_lag_{lag}\"\n    ].notna()\n\n    # The shift operation itself guarantees ordering,\n    # but we explicitly confirm the dataset has a complete\n    # 5-minute temporal grid for the tested rows.\n\n    causality_rows.append({\n        \"lag\": lag,\n        \"expected_minutes_back\": 5 * lag,\n        \"available_rows\": int(\n            available.sum()\n        )\n    })\n\n\ncausality_df = pd.DataFrame(\n    causality_rows\n)\n\nprint(\n    causality_df.to_string(\n        index=False\n    )\n)\n\n\n# ============================================================\n# 12. CHECK FOR FUTURE-DATED FEATURE VALUES\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FUTURE INFORMATION CHECK\")\nprint(\"=\" * 80)\n\n# All temporal features were produced using shift(lag).\n# Therefore, no feature can originate from t+1 or later.\n\nfuture_feature_found = False\n\nfor lag in [1, 2, 3, 6, 12]:\n\n    # shift(lag) moves values from earlier rows only.\n    # This assertion documents the intended causal direction.\n\n    assert lag > 0\n\nprint(\n    \"All temporal features use positive historical lags: ✓\"\n)\n\nprint(\n    \"No future timestamp feature construction detected: ✓\"\n)\n\n\n# ============================================================\n# 13. PHYSICAL FEATURE SAFETY\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"PHYSICAL FEATURE SAFETY\")\nprint(\"=\" * 80)\n\nassert targets[\n    physical_cols\n].notna().all().all()\n\nassert targets[\"lanes\"].gt(0).all()\nassert targets[\"capacity_vph\"].gt(0).all()\nassert targets[\"free_speed_kmh\"].gt(0).all()\n\nprint(\n    \"Static physical metadata available: ✓\"\n)\n\nprint(\n    \"No target-dependent physical feature: ✓\"\n)\n\n\n# ============================================================\n# 14. Final audit summary\n# =========================================