rix\n# ------------------------------------------------------------\n\nX_valid_multi = pd.read_parquet(\n    CHECKPOINT_DIR / \"X_valid_multi.parquet\"\n)\n\nprint(\n    \"\\nX_valid_multi:\",\n    X_valid_multi.shape\n)\n\n\n# ------------------------------------------------------------\n# 3. Load validation targets\n# ------------------------------------------------------------\n\ny_valid_multi = pd.read_parquet(\n    CHECKPOINT_DIR / \"y_valid_multi.parquet\"\n)\n\nprint(\n    \"y_valid_multi:\",\n    y_valid_multi.shape\n)\n\n\n# ------------------------------------------------------------\n# 4. Load validation metadata\n# ------------------------------------------------------------\n\nvalid_multi = pd.read_parquet(\n    CHECKPOINT_DIR / \"valid_multi.parquet\"\n)\n\nprint(\n    \"valid_multi:\",\n    valid_multi.shape\n)\n\n\n# ------------------------------------------------------------\n# 5. Load previous error analysis\n# ------------------------------------------------------------\n\nerror_df = pd.read_parquet(\n    CHECKPOINT_DIR / \"error_df.parquet\"\n)\n\nprint(\n    \"error_df:\",\n    error_df.shape\n)\n\n\n# ------------------------------------------------------------\n# 6. Restore feature definitions\n# ------------------------------------------------------------\n\nPHYSICAL_FEATURES = [\n    \"length_km\",\n    \"lanes\",\n    \"free_speed_kmh\",\n    \"capacity_vph\",\n    \"capacity_per_lane\",\n]\n\nTEMPORAL_FEATURES = [\n    \"speed_lag_1\",\n    \"flow_lag_1\",\n    \"speed_lag_2\",\n    \"flow_lag_2\",\n    \"speed_lag_3\",\n    \"flow_lag_3\",\n    \"speed_lag_6\",\n    \"flow_lag_6\",\n    \"speed_lag_12\",\n    \"flow_lag_12\",\n]\n\nSELECTED_FEATURES = (\n    PHYSICAL_FEATURES\n    + TEMPORAL_FEATURES\n)\n\n\n# ------------------------------------------------------------\n# 7. Restore target names\n# ------------------------------------------------------------\n\nassert \"target_speed\" in y_valid_multi.columns\nassert \"target_flow\" in y_valid_multi.columns\n\nassert len(X_valid_multi) == len(y_valid_multi)\nassert len(X_valid_multi) == len(valid_multi)\nassert len(X_valid_multi) == len(error_df)\n\n\n# ------------------------------------------------------------\n# 8. Basic integrity checks\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"RESTORE CHECK\")\nprint(\"=\" * 80)\n\nprint(\n    \"Validation rows:\",\n    len(X_valid_multi)\n)\n\nprint(\n    \"Selected features:\",\n    len(SELECTED_FEATURES)\n)\n\nprint(\n    \"Target columns:\",\n    list(y_valid_multi.columns)\n)\n\nprint(\n    \"Mask regimes:\",\n    valid_multi[\"mask_regime\"]\n    .value_counts()\n    .sort_index()\n    .to_dict()\n)\n\nprint(\n    \"✓ Checkpoint restored successfully\"\n)\n\nprint(\n    \"\\nReady for CELL 14 — Missing-History + Congestion Investigation\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-08T17:48:17.239967Z","iopub.execute_input":"2026-10-08T17:48:17.240356Z","iopub.status.idle":"2026-10-08T17:48:17.544758Z","shell.execute_reply.started":"2026-10-08T17:48:17.240325Z","shell.execute_reply":"2026-10-08T17:48:17.543875Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nRESTORING STAGE 3 CHECKPOINT\n================================================================================\n✓ X_valid_multi.parquet\n✓ y_valid_multi.parquet\n✓ valid_multi.parquet\n✓ error_df.parquet\n\nX_valid_multi: (257027, 25)\ny_valid_multi: (257027, 2)\nvalid_multi: (257027, 31)\nerror_df: (257027, 16)\n\n================================================================================\nRESTORE CHECK\n================================================================================\nValidation rows: 257027\nSelected features: 15\nTarget columns: ['target_speed', 'target_flow']\nMask regimes: {'R1': 19157, 'R2': 129646, 'R3': 108224}\n✓ Checkpoint restored successfully\n\nReady for CELL 14 — Missing-History + Congestion Investigation\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# ============================================================\n# CELL 14 — MISSING-HISTORY + CONGESTION INVESTIGATION\n# ============================================================\n\nimport numpy as np\nimport pandas as pd\n\n\nprint(\"=\" * 80)\nprint(\"CELL 14 — MISSING-HISTORY + CONGESTION INVESTIGATION\")\nprint(\"=\" * 80)\n\n\n# ------------------------------------------------------------\n# 1. Build analysis dataframe\n# ------------------------------------------------------------\n\nanalysis_df = valid_multi[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"mask_regime\",\n        \"target_speed\",\n        \"target_flow\",\n    ]\n].copy()\n\n# Add model predictions and errors from previous checkpoint.\nanalysis_df[\"pred_speed\"] = (\n    error_df[\"pred_speed\"].values\n)\n\nanalysis_df[\"pred_flow\"] = (\n    error_df[\"pred_flow\"].values\n)\n\nanalysis_df[\"abs_speed_error\"] = (\n    error_df[\"abs_speed_error\"].values\n)\n\nanalysis_df[\"abs_flow_error\"] = (\n    error_df[\"abs_flow_error\"].values\n)\n\n\n# ------------------------------------------------------------\n# 2. Add temporal-history availability\n# ------------------------------------------------------------\n\nLAG_COLUMNS = [\n    \"speed_lag_1\",\n    \"speed_lag_2\",\n    \"speed_lag_3\",\n    \"speed_lag_6\",\n    \"speed_lag_12\",\n]\n\nfor lag in LAG_COLUMNS:\n\n    analysis_df[f\"{lag}_available\"] = (\n        X_valid_multi[lag]\n        .notna()\n        .values\n    )\n\n\n# ------------------------------------------------------------\n# 3. Count available speed lags\n# ------------------------------------------------------------\n\nanalysis_df[\"n_speed_lags_available\"] = (\n    analysis_df[\n        [\n            f\"{lag}_available\"\n            for lag in LAG_COLUMNS\n        ]\n    ]\n    .sum(axis=1)\n)\n\n\n# ------------------------------------------------------------\n# 4. Define TRUE traffic state\n# ------------------------------------------------------------\n\nanalysis_df[\"traffic_state\"] = pd.cut(\n    analysis_df[\"target_speed\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf,\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\",\n    ],\n)\n\n\n# ------------------------------------------------------------\n# 5. Define catastrophic speed errors\n# ------------------------------------------------------------\n\nanalysis_df[\"catastrophic_speed_error\"] = (\n    analysis_df[\"abs_speed_error\"] >= 50\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BASIC DISTRIBUTION\")\nprint(\"=\" * 80)\n\nprint(\n    \"Total validation targets:\",\n    len(analysis_df)\n)\n\nprint(\n    \"Catastrophic speed errors:\",\n    analysis_df[\n        \"catastrophic_speed_error\"\n    ].sum()\n)\n\nprint(\n    \"Catastrophic error rate:\",\n    analysis_df[\n        \"catastrophic_speed_error\"\n    ].mean()\n)\n\n\n# ------------------------------------------------------------\n# 6. Error vs number of available speed lags\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR VS NUMBER OF AVAILABLE SPEED LAGS\")\nprint(\"=\" * 80)\n\nlag_count_error = (\n    analysis_df\n    .groupby(\n        \"n_speed_lags_available\"\n    )\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n\n        speed_mae=(\n            \"abs_speed_error\",\n            \"mean\"\n        ),\n\n        speed_rmse=(\n            \"abs_speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n\n        flow_mae=(\n            \"abs_flow_error\",\n            \"mean\"\n        ),\n\n        catastrophic_rate=(\n            \"catastrophic_speed_error\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(lag_count_error)\n\n\n# ------------------------------------------------------------\n# 7. Congestion + history interaction\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TRAFFIC STATE × HISTORY AVAILABILITY\")\nprint(\"=\" * 80)\n\nstate_history = (\n    analysis_df\n    .groupby(\n        [\n            \"traffic_state\",\n            \"n_speed_lags_available\",\n        ],\n        observed=True,\n    )\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n\n        speed_mae=(\n            \"abs_speed_error\",\n            \"mean\"\n        ),\n\n        speed_rmse=(\n            \"abs_speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n\n        flow_mae=(\n            \"abs_flow_error\",\n            \"mean\"\n        ),\n\n        catastrophic_rate=(\n            \"catastrophic_speed_error\",\n            \"mean\"\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(state_history)\n\n\n# ------------------------------------------------------------\n# 8. How often is ALL recent history missing?\n# ------------------------------------------------------------\n\nall_history_missing = (\n    analysis_df[\n        \"n_speed_lags_available\"\n    ] == 0\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ALL SPEED HISTORY MISSING\")\nprint(\"=\" * 80)\n\nprint(\n    \"Targets with zero available speed lags:\",\n    all_history_missing.sum()\n)\n\nprint(\n    \"Percentage:\",\n    100 * all_history_missing.mean()\n)\n\n\n# ------------------------------------------------------------\n# 9. Congested cases with missing lag-1\n# ------------------------------------------------------------\n\ncongested = (\n    analysis_df[\"traffic_state\"]\n    == \"congested\"\n)\n\nlag1_missing = (\n    ~analysis_df[\"speed_lag_1_available\"]\n)\n\ncongested_lag1_missing = (\n    congested\n    & lag1_missing\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CONGESTED + LAG-1 MISSING\")\nprint(\"=\" * 80)\n\nprint(\n    \"Targets:\",\n    congested_lag1_missing.sum()\n)\n\nprint(\n    \"Percentage of all targets:\",\n    100 * congested_lag1_missing.mean()\n)\n\nif congested_lag1_missing.sum() > 0:\n\n    print(\n        \"Speed MAE:\",\n        analysis_df.loc[\n            congested_lag1_missing,\n            \"abs_speed_error\"\n        ].mean()\n    )\n\n    print(\n        \"Speed RMSE:\",\n        np.sqrt(\n            np.mean(\n                analysis_df.loc[\n                    congested_lag1_missing,\n                    \"abs_speed_error\"\n                ] ** 2\n            )\n        )\n    )\n\n    print(\n        \"Catastrophic rate:\",\n        analysis_df.loc[\n            congested_lag1_missing,\n            \"catastrophic_speed_error\"\n        ].mean()\n    )\n\n\n# ------------------------------------------------------------\n# 10. Catastrophic errors — available history\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CATASTROPHIC ERRORS BY HISTORY\")\nprint(\"=\" * 80)\n\ncatastrophic_history = (\n    analysis_df[\n        analysis_df[\n            \"catastrophic_speed_error\"\n        ]\n    ]\n    .groupby(\n        \"n_speed_lags_available\"\n    )\n    .size()\n    .reset_index(\n        name=\"catastrophic_errors\"\n    )\n)\n\ndisplay(\n    catastrophic_history\n)\n\n\n# ------------------------------------------------------------\n# 11. Inspect worst congested cases\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"WORST CONGESTED CASES\")\nprint(\"=\" * 80)\n\nworst_congested = (\n    analysis_df[\n        congested\n    ]\n    .sort_values(\n        \"abs_speed_error\",\n        ascending=False,\n    )\n    .head(25)\n)\n\ndisplay(\n    worst_congested[\n        [\n            \"timestamp\",\n            \"link_id\",\n            \"mask_regime\",\n            \"target_speed\",\n            \"pred_speed\",\n            \"abs_speed_error\",\n            \"target_flow\",\n            \"n_speed_lags_available\",\n            \"speed_lag_1_available\",\n            \"speed_lag_2_available\",\n            \"speed_lag_3_available\",\n            \"speed_lag_6_available\",\n            \"speed_lag_12_available\",\n        ]\n    ]\n)\n\n\n# ------------------------------------------------------------\n# 12. Inspect repeated difficult links\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LINKS WITH HIGHEST SPEED ERROR\")\nprint(\"=\" * 80)\n\nlink_error = (\n    analysis_df\n    .groupby(\"link_id\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n\n        speed_mae=(\n            \"abs_speed_error\",\n            \"mean\"\n        ),\n\n        speed_rmse=(\n            \"abs_speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n\n        catastrophic_rate=(\n            \"catastrophic_speed_error\",\n            \"mean\"\n        ),\n\n        congestion_rate=(\n            \"traffic_state\",\n            lambda x: (\n                x == \"congested\"\n            ).mean()\n        ),\n    )\n    .reset_index()\n    .sort_values(\n        \"speed_rmse\",\n        ascending=False,\n    )\n)\n\ndisplay(\n    link_error.head(20)\n)\n\n\n# ------------------------------------------------------------\n# 13. Final checkpoint\n# ------------------------------------------------------------\n\nassert len(analysis_df) == len(\n    X_valid_multi\n)\n\nassert (\n    analysis_df[\n        \"n_speed_lags_available\"\n    ].between(0, 5).all()\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 14 CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\n    \"✓ History availability quantified\"\n)\n\nprint(\n    \"✓ History depth vs error measured\"\n)\n\nprint(\n    \"✓ Congestion × history interaction measured\"\n)\n\nprint(\n    \"✓ Catastrophic errors isolated\"\n)\n\nprint(\n    \"✓ Worst co