--------------------\n# 12. Feature construction\n# ------------------------------------------------------------\n\ndef build_masked_day_features(\n    date,\n    regime,\n    masked_path,\n    truth_path,\n    links\n):\n    \"\"\"\n    Construct model features for one actual\n    competition masked file.\n\n    Traffic features:\n        masked file only.\n\n    Physical features:\n        static network metadata.\n\n    Ground truth:\n        used only to construct targets.\n    \"\"\"\n\n    masked = pd.read_parquet(\n        masked_path\n    )\n\n    truth = pd.read_parquet(\n        truth_path\n    )\n\n    masked[\"timestamp\"] = pd.to_datetime(\n        masked[\"timestamp\"]\n    )\n\n    truth[\"timestamp\"] = pd.to_datetime(\n        truth[\"timestamp\"]\n    )\n\n    masked[\"link_id\"] = (\n        masked[\"link_id\"].astype(str)\n    )\n\n    truth[\"link_id\"] = (\n        truth[\"link_id\"].astype(str)\n    )\n\n    KEYS_DAY = [\n        \"timestamp\",\n        \"station_id\",\n        \"link_id\"\n    ]\n\n    # --------------------------------------------------------\n    # Temporal features\n    # --------------------------------------------------------\n\n    masked = masked.sort_values(\n        [\"link_id\", \"timestamp\"]\n    ).reset_index(drop=True)\n\n    grouped = masked.groupby(\n        \"link_id\",\n        sort=False\n    )\n\n    for lag in [1, 2, 3, 6, 12]:\n\n        masked[\n            f\"speed_lag_{lag}\"\n        ] = grouped[\n            \"speed_kmh\"\n        ].shift(lag)\n\n        masked[\n            f\"flow_lag_{lag}\"\n        ] = grouped[\n            \"flow_vph\"\n        ].shift(lag)\n\n        masked[\n            f\"speed_lag_{lag}_available\"\n        ] = (\n            masked[\n                f\"speed_lag_{lag}\"\n            ]\n            .notna()\n            .astype(\"int8\")\n        )\n\n        masked[\n            f\"flow_lag_{lag}_available\"\n        ] = (\n            masked[\n                f\"flow_lag