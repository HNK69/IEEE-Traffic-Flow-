OGY LINK REFERENCE CHECK\")\nprint(\"=\" * 70)\n\nfor col in topology.columns:\n\n    values = topology[col].dropna()\n\n    if len(values) == 0:\n        continue\n\n    overlap = values.isin(link_ids).mean()\n\n    print(\n        f\"{col:30s} \"\n        f\"overlap_with_link_ids={overlap:.4f}\"\n    )\n\n\n# ------------------------------------------------------------\n# 8. Inspect spatial metadata\n# ------------------------------------------------------------\n\nspatial_candidates = [\n    col for col in [\n        \"milepost\",\n        \"length_mi\",\n        \"length\",\n        \"lanes\",\n        \"free_speed_kmh\",\n        \"capacity_vph\",\n    ]\n    if col in links.columns\n]\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"AVAILABLE SPATIAL / PHYSICAL FEATURES\")\nprint(\"=\" * 70)\n\nprint(spatial_candidates)\n\nif spatial_candidates:\n    print(\n        links[\n            [\"link_id\"] + spatial_candidates\n        ].head(15).to_string(index=False)\n    )\n\n\n# ------------------------------------------------------------\n# 9. Final checkpoint\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"CELL 03 COMPLETE\")\nprint(\"=\" * 70)\n\nprint(\n    \"Next step: identify the exact upstream/downstream columns \"\n    \"from the topology output before creating spatial features.\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T18:47:29.656535Z","iopub.execute_input":"2026-10-07T18:47:29.656797Z","iopub.status.idle":"2026-10-07T18:47:29.71591Z","shell.execute_reply.started":"2026-10-07T18:47:29.656776Z","shell.execute_reply":"2026-10-07T18:47:29.715231Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 04 — SPATIAL FEATURE SIGNAL\n# ============================================================\n\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\n\n# ------------------------------------------------------------\n# 1. Configuration\n# ------------------------------------------------------------\n\nDATA_ROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public\"\n)\n\nPANEL = \"D7_I405_S\"\nDATE = \"2030_06_01\"\nREGIME = \"R3\"\n\nNETWORK_DIR = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n    / \"network\"\n)\n\nmasked_dir = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n    / \"train\"\n    / \"mainline_states_masked\"\n    / f\"mask_regime={REGIME}\"\n)\n\ntruth_dir = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n    / \"train\"\n    / \"mainline_states\"\n    / \"year_month=2030-06\"\n)\n\nmasked_path = list(\n    masked_dir.glob(f\"*{DATE}*.parquet\")\n)[0]\n\ntruth_path = list(\n    truth_dir.glob(f\"*{DATE}*.parquet\")\n)[0]\n\ntopology_path = NETWORK_DIR / \"lwr_mainline_topology.csv\"\n\n\n# ------------------------------------------------------------\n# 2. Load data\n# ------------------------------------------------------------\n\nmasked = pd.read_parquet(masked_path)\ntruth = pd.read_parquet(truth_path)\ntopology = pd.read_csv(topology_path)\n\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"])\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"])\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n\n# ------------------------------------------------------------\n# 3. Parse topology lists\n# ------------------------------------------------------------\n\ndef parse_link_list(value):\n\n    if pd.isna(value):\n        return []\n\n    return [\n        x.strip()\n        for x in str(value).split(\";\")\n        if x.strip()\n    ]\n\n\nmainline_ids = set(\n    topology[\"mainline_link_id\"].astype(str)\n)\n\nupstream_map = {}\ndownstream_map = {}\n\nfor _, row in topology.iterrows():\n\n    link = str(row[\"mainline_link_id\"])\n\n    incoming = [\n        x\n        for x in parse_link_list(row[\"incoming_link_ids\"])\n        if x in 