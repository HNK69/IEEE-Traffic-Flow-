ured\n\nCELL 16D COMPLETE\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"# ============================================================\n# CELL 16E — UPSTREAM vs DOWNSTREAM CROSS-LINK SIGNAL\n# ============================================================\n\nprint(\"=\" * 80)\nprint(\"CELL 16E — UPSTREAM vs DOWNSTREAM CROSS-LINK SIGNAL\")\nprint(\"=\" * 80)\n\n\n# ------------------------------------------------------------\n# 1. Prepare observed links\n# ------------------------------------------------------------\n\nobs = masked[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"milepost\",\n        \"speed_kmh\",\n        \"flow_vph\",\n    ]\n].copy()\n\nobs[\"timestamp\"] = pd.to_datetime(\n    obs[\"timestamp\"],\n    utc=True\n)\n\n\n# ------------------------------------------------------------\n# 2. Build target table + milepost\n# ------------------------------------------------------------\n\ntarget_base = targets[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh_truth\",\n        \"flow_vph_truth\",\n    ]\n].copy()\n\ntarget_base[\"timestamp\"] = pd.to_datetime(\n    target_base[\"timestamp\"],\n    utc=True\n)\n\nlink_milepost = (\n    obs[\n        [\n            \"link_id\",\n            \"milepost\",\n        ]\n    ]\n    .drop_duplicates(\"link_id\")\n)\n\ntargets_e = target_base.merge(\n    link_milepost,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nassert targets_e[\"milepost\"].notna().all()\n\n\n# ------------------------------------------------------------\n# 3. Recover target lag-1 and isolate difficult cases\n# ------------------------------------------------------------\n\nhist = obs[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh\",\n    ]\n].copy()\n\nhist = hist.sort_values(\n    [\n        \"link_id\",\n        \"timestamp\",\n    ]\n)\n\nhist[\"speed_lag_1\"] = (\n    hist\n    .groupby(\"link_id\")[\"speed_kmh\"]\n    .shift(1)\n)\n\ntargets_e = targets_e.merge(\n    hist[\n        [\n            \"timestamp\",\n            \"link_id\",\n            \"speed_lag_1\",\n        ]\n    ],\n    on=[\n        \"timestamp\",\n        \"link_id\",\n    ],\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\ntargets_e = targets_e[\n    targets_e[\"speed_lag_1\"].isna()\n].copy()\n\n\nprint(\"\\nLag-1 missing targets:\", len(targets_e))\n\n\n# ------------------------------------------------------------\n# 4. Determine actual spatial direction\n#\n# We do NOT assume that increasing milepost means\n# upstream/downstream.\n#\n# Check whether link order follows increasing or decreasing\n# milepost through time-independent physical ordering.\n# ------------------------------------------------------------\n\nlink_positions = (\n    obs[\n        [\n            \"link_id\",\n            \"milepost\",\n        ]\n    ]\n    .drop_duplicates(\"link_id\")\n    .sort_values(\"milepost\")\n    .reset_index(drop=True)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"MILEPOST RANGE\")\nprint(\"=\" * 80)\n\nprint(\n    \"Minimum milepost:\",\n    link_positions[\"milepost\"].min()\n)\n\nprint(\n    \"Maximum milepost:\",\n    link_positions[\"milepost\"].max()\n)\n\nprint(\n    \"Unique links:\",\n    len(link_positions)\n)\n\n\n# ------------------------------------------------------------\n# 5. Construct target-observation pairs\n# ------------------------------------------------------------\n\npairs = targets_e.merge(\n    obs,\n    on=\"timestamp\",\n    how=\"left\",\n    suffixes=(\"_target\", \"_obs\"),\n)\n\n# Exclude target itself.\npairs = pairs[\n    pairs[\"link_id_target\"]\n    != pairs[\"link_id_obs\"]\n].copy()\n\n\n# Signed spatial displacement:\n#\n# positive = observed link has larger milepost\n# negative = observed link has smaller milepost\n#\n# We keep these labels as \"higher_milepost\" and\n# \"lower_milepost\" until physical direction is established.\n\npairs[\"signed_milepost\"] = (\n    pairs[\"milepost_obs\"]\n    - pairs[\"milepost_target\"]\n)\n\npairs[\"distance_km\"] = (\n    pairs[\"signed_milepost\"].abs()\n)\n\npairs = pairs[\n    pairs[\"speed_kmh\"].notna()\n].copy()\n\n\n# ------------------------------------------------------------\n# 6. Analyze both spatial directions\n# ------------------------------------------------------------\n\nbands = {\n    \"lower_0_1km\": (\n        pairs[\"signed_milepost\"] < 0\n    )\n    & (\n        pairs[\"distance_km\"] <= 1.0\n    ),\n\n    \"higher_0_1km\": (\n        pairs[\"signed_milepost\"] > 0\n    )\n    & (\n        pairs[\"distance_km\"] <= 1.0\n    ),\n\n    \"lower_1_2km\": (\n        pairs[\"signed_milepost\"] < 0\n    )\n    & (\n        pairs[\"distance_km\"] > 1.0\n    )\n    & (\n        pairs[\"distance_km\"] <= 2.0\n    ),\n\n    \"higher_1_2km\": (\n        pairs[\"signed_milepost\"] > 0\n    )\n    & (\n        pairs[\"distance_km\"] > 1.0\n    )\n    & (\n        pairs[\"distance_km\"] <= 2.0\n    ),\n}\n\n\n# ------------------------------------------------------------\n# 7. Build directional aggregate features\n# ------------------------------------------------------------\n\ndirectional = targets_e[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh_truth\",\n        \"flow_vph_truth\",\n    ]\n].copy()\n\n\nfor name, mask in bands.items():\n\n    subset = pairs.loc[mask]\n\n    grouped = (\n        subset\n        .groupby(\n            [\n                \"timestamp\",\n                \"link_id_target\",\n            ]\n        )\n        .agg(\n            speed_mean=(\n                \"speed_kmh\",\n                \"mean\"\n            ),\n\n            speed_q10=(\n                \"speed_kmh\",\n                lambda x: x.quantile(0.10)\n            ),\n\n            speed_q25=(\n                \"speed_kmh\",\n                lambda x: x.quantile(0.25)\n            ),\n\n            flow_mean=(\n                \"flow_vph\",\n                \"mean\"\n            ),\n\n            n_links=(\n                \"speed_kmh\",\n                \"count\"\n            ),\n        )\n        .reset_index()\n        .rename(\n            columns={\n                \"link_id_target\": \"link_id\"\n            }\n        )\n    )\n\n    grouped = grouped.rename(\n        columns={\n            \"speed_mean\":\n                f\"{name}_speed_mean\",\n\n            \"speed_q10\":\n                f\"{name}_speed_q10\",\n\n            \"speed_q25\":\n                f\"{name}_speed_q25\",\n\n            \"flow_mean\":\n                f\"{name}_flow_mean\",\n\n            \"n_links\":\n                f\"{name}_n_links\",\n        }\n    )\n\n    directional = directional.merge(\n        grouped,\n        on=[\n            \"timestamp\",\n            \"link_id\",\n        ],\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n\n# ------------------------------------------------------------\n# 8. Correlation table\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DIRECTIONAL SPEED CORRELATION\")\nprint(\"=\" * 80)\n\ncorr_rows = []\n\nfor name in bands:\n\n    feature = f\"{name}_speed_mean\"\n\n    valid = directional[\n        [\n            feature,\n            \"speed_kmh_truth\",\n        ]\n    ].dropna()\n\n    corr_rows.append(\n        {\n            \"region\": name,\n            \"speed_correlation\":\n                valid.corr().iloc[0, 1]\n                if len(valid) > 1\n                else np.nan,\n            \"valid_targets\": len(valid),\n        }\n    )\n\ndisplay(\n    pd.DataFrame(corr_rows)\n)\n\n\n# ------------------------------------------------------------\n# 9. Flow correlation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DIRECTIONAL FLOW CORRELATION\")\nprint(\"=\" * 80)\n\nflow_rows = []\n\nfor name in bands:\n\n    feature = f\"{name}_flow_mean\"\n\n    valid = directional[\n        [\n            feature,\n            \"flow_vph_truth\",\n        ]\n    ].dropna()\n\n    flow_rows.append(\n        {\n            \"region\": name,\n            \"flow_correlation\":\n                valid.corr().iloc[0, 1]\n                if len(valid) > 1\n                else np.nan,\n            \"valid_targets\": len(valid),\n        }\n    )\n\ndisplay(\n    pd.DataFrame(flow_rows)\n)\n\n\n# ------------------------------------------------------------\n# 10. Congestion separation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DIRECTIONAL CONGESTION SIGNAL\")\nprint(\"=\" * 80)\n\ndirectional[\"traffic_state\"] = pd.cut(\n    directional[\"speed_kmh_truth\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf,\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\",\n    ],\n)\n\ncongested = (\n    directional[\"speed_kmh_truth\"] < 70\n)\n\nfree_flow = (\n    directional[\"speed_kmh_truth\"] >= 100\n)\n\nrows = []\n\nfor name in bands:\n\n    feature = f\"{name}_speed_q10\"\n\n    rows.append(\n        {\n            \"region\": name,\n\n            \"congested_q10_mean\":\n                directional.loc[\n                    congested,\n                    feature\n                ].mean(),\n\n            \"free_flow_q10_mean\":\n                directional.loc[\n                    free_flow,\n                    feature\n                ].mean(),\n\n            \"congested_low_speed_rate\":\n                (\n                    directional.loc[\n                        congested,\n                        feature\n                    ] < 50\n                ).mean(),\n\n            \"free_flow_low_speed_rate\":\n                (\n                    directional.loc[\n                        free_flow,\n                        feature\n                    ] < 50\n                ).mean(),\n        }\n    )\n\ndisplay(\n    pd.DataFrame(rows)\n)\n\n\n# ------------------------------------------------------------\n# 11. Coverage\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DIRECTIONAL COVERAGE\")\nprint(\"=\" * 80)\n\ncoverage_rows = []\n\nfor name in bands:\n\n    feature = f\"{name}_n_links\"\n\n    coverage_rows.append(\n        {\n            \"region\": name,\n\n            \"mean_links\":\n                directional[feature].mean(),\n\n            \"median_links\":\n                directional[feature].median(),\n\n            \"zero_rate\":\n                (\n                    directional[feature]\n                    .fillna(0)\n                    == 0\n                ).mean(),\n\n            \"at_least_one_rate\":\n                (\n                    directional[feature]\n                    .fillna(0)\n                    > 0\n                ).mean(),\n        }\n    )\n\ndisplay(\n    pd.DataFrame(coverage_rows)\n)\n\n\n# ------------------------------------------------------------\n# 12. Checkpoint\n# ------------------------------------------------------------\n\nassert len(directional) == len(targets_e)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 16E CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\"✓ Lag-1-missing targets isolated\")\nprint(\"✓ Signed milepost direction tested\")\nprint(\"✓ Lower/higher milepost neighborhoods compared\")\nprint(\"✓ Speed and flow correlations measured\")\nprint(\"✓ Directional congestion signal measured\")\nprint(\"✓ Directional feature coverage measured\")\n\nprint(\"\\nCELL 16E COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-08T18:22:51.998631Z","iopub.execute_input":"2026-10-08T18:22:51.999003Z","iopub.status.idle":"2026-10-08T18:23:00.270531Z","shell.execute_reply.started":"2026-10-08T18:22:51.998976Z","shell.execute_reply":"2026-10-08T18:23:00.269523Z"}},"outputs":[{"name":"stdout","text":"=================