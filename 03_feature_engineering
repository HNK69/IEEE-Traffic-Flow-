ON_CONFIGS = {\n\n    # A — physical/network information only\n    \"physical_only\": PHYSICAL_FEATURES,\n\n    # B — temporal information only\n    \"temporal_only\": TEMPORAL_FEATURES,\n\n    # C — physical + availability information\n    \"physical_availability\": (\n        PHYSICAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n\n    # D — physical + temporal information\n    \"physical_temporal\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n    ),\n\n    # E — everything\n    \"all_features\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n}\n\n\n# ------------------------------------------------------------\n# 3. Validate feature definitions\n# ------------------------------------------------------------\n\nall_defined_features = set(\n    TEMPORAL_FEATURES\n    + AVAILABILITY_FEATURES\n    + PHYSICAL_FEATURES\n)\n\nassert all_defined_features == set(FEATURE_COLS)\n\nfor name, features in ABLATION_CONFIGS.items():\n\n    assert len(features) > 0\n\n    missing = set(features) - set(X.columns)\n\n    assert not missing, (\n        f\"{name} contains missing features: {missing}\"\n    )\n\n\n# ------------------------------------------------------------\n# 4. Inspect configurations\n# ------------------------------------------------------------\n\nprint(\"=\" * 80)\nprint(\"ABLATION CONFIGURATIONS\")\nprint(\"=\" * 80)\n\nfor name, features in ABLATION_CONFIGS.items():\n\n    print(\n        f\"{name:25s} -> \"\n        f\"{len(features):2d} features\"\n    )\n\n\n# ------------------------------------------------------------\n# 5. Target summary\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TARGET SUMMARY\")\nprint(\"=\" * 80)\n\nprint(\n    y.describe().T\n)\n\n\n# ------------------------------------------------------------\n# 6. Feature-group summary\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FEATURE GROUPS\")\nprint(\"=\" * 80)\n\nprint(\n    f\"Temporal features:      {len(TEMPORAL_FEATURES)}\"\n)\n\nprint(\n    f\"Availability features:  {len(AVAILABILITY_FEATURES)}\"\n)\n\nprint(\n    f\"Physical features:      {len(PHYSICAL_FEATURES)}\"\n)\n\nprint(\n    f\"Total features:          {len(FEATURE_COLS)}\"\n)\n\n\n# ------------------------------------------------------------\n# 7. Checkpoint\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 08 CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\"✓ Five controlled feature configurations defined\")\nprint(\"✓ All features accounted for exactly once\")\nprint(\"✓ No unknown features\")\nprint(\"✓ Targets separated from features\")\n\nprint(\"\\nCELL 08 COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T18:56:26.655942Z","iopub.execute_input":"2026-10-07T18:56:26.656263Z","iopub.status.idle":"2026-10-07T18:56:26.673643Z","shell.execute_reply.started":"2026-10-07T18:56:26.656238Z","shell.execute_reply":"2026-10-07T18:56:26.672925Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nABLATION CONFIGURATIONS\n================================================================================\nphysical_only             ->  5 features\ntemporal_only             -> 10 features\nphysical_availability     -> 15 features\nphysical_temporal         -> 15 features\nall_features              -> 25 features\n\n================================================================================\nTARGET SUMMARY\n================================================================================\n                count         mean          std         min          25%  \\\ntarget_speed  11523.0   112.376344     8.530193   18.995260   110.963959   \ntarget_flow   11523.0  3814.497449  1718.230020  800.938318  2169.441931   \n\n                      50%          75%          max  \ntarget_speed   113.065360   115.308412   120.750000  \ntarget_flow   4064.665859  5270.320010  8050.320789  \n\n================================================================================\nFEATURE GROUPS\n================================================================================\nTemporal features:      10\nAvailability features:  10\nPhysical features:      5\nTotal features:          25\n\n================================================================================\nCELL 08 CHECKPOINT\n================================================================================\n✓ Five controlled feature configurations defined\n✓ All features accounted for exactly once\n✓ No unknown features\n✓ Targets separated from features\n\nCELL 08 COMPLETE\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"# ============================================================\n# CELL 09 — FIRST ABLATION MODEL\n# ============================================================\n\nfrom xgboost import XGBRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n\n# ------------------------------------------------------------\n# 1. Create chronological train/validation split\n# ------------------------------------------------------------\n# We must NOT randomly split individual rows.\n# Traffic observations are time-dependent.\n\nunique_times = np.sort(\n    feature_matrix[\"timestamp\"].unique()\n)\n\nsplit_idx = int(\n    len(unique_times) * 0.80\n)\n\ntrain_times = unique_times[:split_idx]\nvalid_times = unique_times[split_idx:]\n\ntrain_mask = feature_matrix[\n    \"timestamp\"\n].isin(train_times)\n\nvalid_mask = feature_matrix[\n    \"timestamp\"\n].isin(valid_times)\n\nprint(\"=\" * 80)\nprint(\"CHRONOLOGICAL SPLIT\")\nprint(\"=\" * 80)\n\nprint(\"Train timestamps:\", len(train_times))\nprint(\"Validation timestamps:\", len(valid_times))\n\nprint(\n    \"Train period:\",\n    pd.Timestamp(train_times[0]),\n    \"->\",\n    pd.Timestamp(train_times[-1])\n)\n\nprint(\n    \"Validation period:\",\n    pd.Timestamp(valid_times[0]),\n    \"->\",\n    pd.Timestamp(valid_times[-1])\n)\n\n\n# ------------------------------------------------------------\n# 2. Build train / validation targets\n# ------------------------------------------------------------\n\ny_train = y.loc[train_mask].copy()\ny_valid = y.loc[valid_mask].copy()\n\nprint(\"\\nTrain rows:\", len(y_train))\nprint(\"Validation rows:\", len(y_valid))\n\n\n# ------------------------------------------------------------\n# 3. Evaluation function\n# ------------------------------------------------------------\n\ndef evaluate_predictions(\n    y_true,\n    pred_speed,\n    pred_flow,\n    lanes\n):\n    \"\"\"\n    Calculate the local Task 1 scoring components.\n\n    Speed:\n        RMSE normalized by 25 km/h.\n\n    Flow:\n        RMSE per lane normalized by 600 vph/lane.\n\n    State:\n        0.54 * speed score\n        + 0.46 * flow score\n    \"\"\"\n\n    speed_rmse = np.sqrt(\n        mean_squared_error(\n            y_true[\"target_speed\"],\n            pred_speed\n        )\n    )\n\n    flow_per_lane_true = (\n        y_true[\"target_flow\"].to_numpy()\n        / lanes\n    )\n\n    flow_per_lane_pred = (\n        pred_flow\n        / lanes\n    )\n\n    flow_rmse_per_lane = np.sqrt(\n        mean_squared_error(\n            flow_per_lane_true,\n            flow_per_lane_pred\n        )\n    )\n\n    speed_score = max(\n        0.0,\n        1.0 - speed_rmse / 25.0\n    )\n\n    flow_score = max(\n        0.0,\n        1.0 - flow_rmse_per_lane / 600.0\n    )\n\n    state_score = (\n        0.54 * speed_score\n        + 0.46 * flow_score\n    )\n\n    return {\n        \"speed_rmse\": speed_rmse,\n        \"flow_rmse_per_lane\": flow_rmse_per_lane,\n        \"speed_score\": speed_score,\n        \"flow_score\": flow_score,\n        \"state_score\": state_score,\n    }\n\n\n# ------------------------------------------------------------\n# 4. Fixed model configuration\n# ------------------------------------------------------------\n\nMODEL_PARAMS = {\n    \"n_estimators\": 300,\n    \"max_depth\": 8,\n    \"learning_rate\": 0.05,\n    \"subsample\": 0.8,\n    \"colsample_bytree\": 0.8,\n    \"objective\": \"reg:squarederror\",\n    \"tree_method\": \"hist\",\n    \"random_state\": 42,\n    \"n_jobs\": -1,\n}\n\n\n# ------------------------------------------------------------\n# 5. Run ablation experiments\n# ------------------------------------------------------------\n\nresults = []\n\nfor config_name, features in ABLATION_CONFIGS.items():\n\n    print(\"\\n\" + \"=\" * 80)\n    print(f\"RUNNING: {config_name}\")\n    print(\"=\" * 80)\n\n    X_train = X.loc[\n        train_mask,\n        features\n    ]\n\n    X_valid = X.loc[\n        valid_mask,\n        features\n    ]\n\n    # Separate model for speed\n    speed_model = XGBRegressor(\n        **MODEL_PARAMS\n    )\n\n    # Separate model for flow\n    flow_model = XGBRegressor(\n        **MODEL_PARAMS\n    )\n\n    print(\n        f\"Features: {len(features)} | \"\n        f\"Train: {len(X_train)} | \"\n        f\"Valid: {len(X_valid)}\"\n    )\n\n    # --------------------------------------------------------\n    # Train speed model\n    # --------------------------------------------------------\n\n    speed_model.fit(\n        X_train,\n        y_train[\"target_speed\"],\n        verbose=False\n    )\n\n    pred_speed = speed_model.predict(\n        X_valid\n    )\n\n    # --------------------------------------------------------\n    # Train flow model\n    # --------------------------------------------------------\n\n    flow_model.fit(\n        X_train,\n        y_train[\"target_flow\"],\n        verbose=False\n    )\n\n    pred_flow = flow_model.predict(\n        X_valid\n    )\n\n    # --------------------------------------------------------\n    # Evaluate\n    # --------------------------------------------------------\n\n    lanes_valid = X.loc[\n        valid_mask,\n        \"lanes\"\n    ].to_numpy()\n\n    metrics = evaluate_predictions(\n        y_valid,\n        pred_speed,\n        pred_flow,\n        lanes_valid\n    )\n\n    metrics[\"configuration\"] = config_name\n    metrics[\"n_features\"] = len(features)\n\n    results.append(metrics)\n\n    print(\n        f\"Speed RMSE:          \"\n        f\"{metrics['speed_rmse']:.4f}\"\n    )\n\n    print(\n        f\"Flow RMSE / lane:    \"\n        f\"{metrics['flow_rmse_per_lane']:.4f}\"\n    )\n\n    print(\n        f\"Speed score:         \"\n        f\"{metrics['speed_score']:.4f}\"\n    )\n\n    print(\n        f\"Flow score:          \"\n        f\"{metrics['flow_score']:.4f}\"\n    )\n\n    print(\n        f\"State score:         \"\n        f\"{metrics['state_score']:.4f}\"\n    )\n\n\n# ------------------------------------------------------------\n# 6. Results table\n# ------------------------------------------------------------\n\nresults_df = (\n    pd.DataFrame(results)\n    .sort_values(\n        \"state_score\",\n        ascending=False\n    )\n    .reset_index(drop=True)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ABLATION RESULTS\")\nprint(\"=\" * 80)\n\ndisplay(\n    results_df[\n        [\n            \"configuration\",\n            \"n_features\",\n            \"speed_rmse\",\n            \"flow_rmse_per_lane\",\n            \"speed_score\",\n            \"flow_score\",\n            \"state_score\",\n        ]\n    ]\n)\n\n\n# ------------------------------------------------------------\n# 7. Checkpoint\n# ------------------------------------------------------------\n\nassert len(results_df) == 5\nassert results_df[\"state_score\"].notna().all()\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 09 COMPLETE\")\nprint(\"=\" * 80)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T18:58:17.299999Z","iopub.execute_input":"2026-10-07T18:58:17.300347Z","iopub.status.i