gets\n# ------------------------------------------------------------\n\ntarget_mask = (\n    feature_matrix[\"speed_kmh\"].isna()\n    & feature_matrix[\"flow_vph\"].isna()\n    & feature_matrix[\"target_speed\"].notna()\n    & feature_matrix[\"target_flow\"].notna()\n)\n\nfeature_matrix = feature_matrix.loc[\n    target_mask\n].copy()\n\n\n# ------------------------------------------------------------\n# 7. Define final candidate feature columns\n# ------------------------------------------------------------\n\nFEATURE_COLS = [\n    # Temporal history\n    \"speed_lag_1\",\n    \"flow_lag_1\",\n    \"speed_lag_2\",\n    \"flow_lag_2\",\n    \"speed_lag_3\",\n    \"flow_lag_3\",\n    \"speed_lag_6\",\n    \"flow_lag_6\",\n    \"speed_lag_12\",\n    \"flow_lag_12\",\n\n    # Temporal availability\n    \"speed_lag_1_available\",\n    \"flow_lag_1_available\",\n    \"speed_lag_2_available\",\n    \"flow_lag_2_available\",\n    \"speed_lag_3_available\",\n    \"flow_lag_3_available\",\n    \"speed_lag_6_available\",\n    \"flow_lag_6_available\",\n    \"speed_lag_12_available\",\n    \"flow_lag_12_available\",\n\n    # Physical\n    \"length_km\",\n    \"lanes\",\n    \"free_speed_kmh\",\n    \"capacity_vph\",\n    \"capacity_per_lane\"\n]\n\nTARGET_COLS = [\n    \"target_speed\",\n    \"target_flow\"\n]\n\n\n# ------------------------------------------------------------\n# 8. Final matrix\n# ------------------------------------------------------------\n\nX = feature_matrix[\n    FEATURE_COLS\n].copy()\n\ny = feature_matrix[\n    TARGET_COLS\n].copy()\n\n\n# ------------------------------------------------------------\n# 9. Structural checks\n# ------------------------------------------------------------\n\nprint(\"=\" * 80)\nprint(\"FEATURE MATRIX STRUCTURE\")\nprint(\"=\" * 80)\n\nprint(\"Rows:\", len(X))\nprint(\"Features:\", len(X.columns))\nprint(\"Targets:\", len(y.columns))\n\nprint(\"\\nExpected:\")\nprint(\"  Rows:\", len(feature_matrix))\nprint(\"  Features: 25\")\nprint(\"  Targets: 2\")\n\n\nassert len(X) == len(y)\nassert len(X.columns) == 25\nassert len(y.columns) == 2\n\n\n# ------------------------------------------------------------\n# 10. Check target validity\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TARGET VALIDITY\")\nprint(\"=\" * 80)\n\nprint(\n    \"Missing target_speed:\",\n    y[\"target_speed\"].isna().sum()\n)\n\nprint(\n    \"Missing target_flow:\",\n    y[\"target_flow\"].isna().sum()\n)\n\nassert y[\"target_speed\"].notna().all()\nassert y[\"target_flow\"].notna().all()\n\n\n# ------------------------------------------------------------\n# 11. Feature missingness\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FEATURE MISSINGNESS\")\nprint(\"=\" * 80)\n\nmissingness = (\n    X.isna()\n    .mean()\n    .sort_values(ascending=False)\n)\n\nprint(\n    missingness.to_string(\n        header=[\"missing_fraction\"]\n    )\n)\n\n\n# ------------------------------------------------------------\n# 12. Verify availability indicators\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"AVAILABILITY INDICATOR CONSISTENCY\")\nprint(\"=\" * 80)\n\nfor lag in [1, 2, 3, 6, 12]:\n\n    speed_expected = (\n        X[f\"speed_lag_{lag}\"]\n        .notna()\n        .astype(\"int8\")\n    )\n\n    flow_expected = (\n        X[f\"flow_lag_{lag}\"]\n        .notna()\n        .astype(\"int8\")\n    )\n\n    speed_actual = X[\n        f\"speed_lag_{lag}_available\"\n    ]\n\n    flow_actual = X[\n        f\"flow_lag_{lag}_available\"\n    ]\n\n    assert (\n        speed_expected.values\n        == speed_actual.values\n    ).all()\n\n    assert (\n        flow_expected.values\n        == flow_actual.values\n    ).all()\n\nprint(\n    \"All availability indicators match actual feature availability: ✓\"\n)\n\n\n# -----------------------------------------------