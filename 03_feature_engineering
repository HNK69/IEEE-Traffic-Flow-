adata":{}},{"name":"stdout","text":"\n================================================================================\nCELL 11 CHECKPOINT\n================================================================================\n✓ Five feature configurations evaluated\n✓ Same model configuration used for all\n✓ Chronological validation preserved\n✓ Overall Task 1 metrics calculated\n✓ R1/R2/R3 metrics calculated\n✓ Current best configuration: all_features\n✓ Current best state score: 0.811989\n\nCELL 11 COMPLETE\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"# ============================================================\n# CELL 12 — ERROR ANALYSIS\n# ============================================================\n\nfrom xgboost import XGBRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n\n# ------------------------------------------------------------\n# 1. Selected feature set\n# ------------------------------------------------------------\n\nSELECTED_FEATURES = (\n    PHYSICAL_FEATURES\n    + TEMPORAL_FEATURES\n)\n\nprint(\"=\" * 80)\nprint(\"SELECTED FEATURE SET\")\nprint(\"=\" * 80)\n\nprint(\"Number of features:\", len(SELECTED_FEATURES))\n\nprint(SELECTED_FEATURES)\n\n\n# ------------------------------------------------------------\n# 2. Train selected baseline\n# ------------------------------------------------------------\n\nMODEL_PARAMS_ERROR = {\n    \"n_estimators\": 300,\n    \"max_depth\": 8,\n    \"learning_rate\": 0.05,\n    \"subsample\": 0.8,\n    \"colsample_bytree\": 0.8,\n    \"objective\": \"reg:squarederror\",\n    \"tree_method\": \"hist\",\n    \"random_state\": 42,\n    \"n_jobs\": -1,\n}\n\n\nX_train_error = X_train_multi[\n    SELECTED_FEATURES\n]\n\nX_valid_error = X_valid_multi[\n    SELECTED_FEATURES\n]\n\n\nprint(\"\\nTraining speed model...\")\n\nspeed_model_error = XGBRegressor(\n    **MODEL_PARAMS_ERROR\n)\n\nspeed_model_error.fit(\n    X_train_error,\n    y_train_multi[\"target_speed\"],\n    verbose=False\n)\n\npred_speed_error = (\n    speed_model_error.predict(\n        X_valid_error\n    )\n)\n\n\nprint(\"Training flow model...\")\n\nflow_model_error = XGBRegressor(\n    **MODEL_PARAMS_ERROR\n)\n\nflow_model_error.fit(\n    X_train_error,\n    y_train_multi[\"target_flow\"],\n    verbose=False\n)\n\npred_flow_error = (\n    flow_model_error.predict(\n        X_valid_error\n    )\n)\n\n\n# ------------------------------------------------------------\n# 3. Build error-analysis dataframe\n# ------------------------------------------------------------\n\nerror_df = valid_multi[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"mask_regime\",\n        \"target_speed\",\n        \"target_flow\",\n        \"lanes\",\n        \"free_speed_kmh\",\n        \"capacity_vph\",\n    ]\n].copy()\n\nerror_df[\"pred_speed\"] = (\n    pred_speed_error\n)\n\nerror_df[\"pred_flow\"] = (\n    pred_flow_error\n)\n\nerror_df[\"speed_error\"] = (\n    error_df[\"pred_speed\"]\n    - error_df[\"target_speed\"]\n)\n\nerror_df[\"flow_error\"] = (\n    error_df[\"pred_flow\"]\n    - error_df[\"target_flow\"]\n)\n\nerror_df[\"abs_speed_error\"] = (\n    error_df[\"speed_error\"]\n    .abs()\n)\n\nerror_df[\"abs_flow_error\"] = (\n    error_df[\"flow_error\"]\n    .abs()\n)\n\n\n# ------------------------------------------------------------\n# 4. Overall error summary\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"OVERALL ERROR SUMMARY\")\nprint(\"=\" * 80)\n\nprint(\n    \"Speed MAE:\",\n    error_df[\"abs_speed_error\"].mean()\n)\n\nprint(\n    \"Speed RMSE:\",\n    np.sqrt(\n        np.mean(\n            error_df[\"speed_error\"] ** 2\n        )\n    )\n)\n\nprint(\n    \"Flow MAE:\",\n    error_df[\"abs_flow_error\"].mean()\n)\n\nprint(\n    \"Flow RMSE:\",\n    np.sqrt(\n        np.mean(\n            error_df[\"flow_error\"] ** 2\n        )\n    )\n)\n\n\n# ------------------------------------------------------------\n# 5. Error by mask regime\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY MASK REGIME\")\nprint(\"=\" * 80)\n\nregime_error = (\n    error_df\n    .groupby(\"mask_regime\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(regime_error)\n\n\n# ------------------------------------------------------------\n# 6. Error by speed regime\n# ------------------------------------------------------------\n# We use the TRUE speed to distinguish:\n# free-flow / moderate / congested conditions.\n\nerror_df[\"traffic_state\"] = pd.cut(\n    error_df[\"target_speed\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\"\n    ]\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY TRAFFIC STATE\")\nprint(\"=\" * 80)\n\ntraffic_state_error = (\n    error_df\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(traffic_state_error)\n\n\n# ------------------------------------------------------------\n# 7. Error by history availability\n# ------------------------------------------------------------\n# Lag-1 is our strongest temporal feature.\n# We test whether errors increase when it is unavailable.\n\nlag1_available = (\n    X_valid_multi[\n        \"speed_lag_1\"\n    ].notna()\n)\n\nerror_df[\"lag1_history\"] = np.where(\n    lag1_available,\n    \"available\",\n    \"missing\"\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY LAG-1 AVAILABILITY\")\nprint(\"=\" * 80)\n\nhistory_error = (\n    error_df\n    .groupby(\"lag1_history\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(history_error)\n\n\n# ------------------------------------------------------------\n# 8. Error by lane count\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY LANE COUNT\")\nprint(\"=\" * 80)\n\nlane_error = (\n    error_df\n    .groupby(\"lanes\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(lane_error)\n\n\n# ============================================================\n# FIX — WOR