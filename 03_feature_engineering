ETS\")\nprint(\"=\" * 80)\n\nX_train_multi.to_parquet(\n    CHECKPOINT_DIR / \"X_train_multi.parquet\",\n    index=False\n)\n\nX_valid_multi.to_parquet(\n    CHECKPOINT_DIR / \"X_valid_multi.parquet\",\n    index=False\n)\n\ny_train_multi.to_parquet(\n    CHECKPOINT_DIR / \"y_train_multi.parquet\",\n    index=False\n)\n\ny_valid_multi.to_parquet(\n    CHECKPOINT_DIR / \"y_valid_multi.parquet\",\n    index=False\n)\n\nvalid_multi.to_parquet(\n    CHECKPOINT_DIR / \"valid_multi.parquet\",\n    index=False\n)\n\nerror_df.to_parquet(\n    CHECKPOINT_DIR / \"error_df.parquet\",\n    index=False\n)\n\nprint(\"✓ Feature datasets saved\")\n\n\n# ------------------------------------------------------------\n# 2. Save trained models\n# ------------------------------------------------------------\n\njoblib.dump(\n    speed_model_error,\n    CHECKPOINT_DIR / \"stage3_speed_model.joblib\"\n)\n\njoblib.dump(\n    flow_model_error,\n    CHECKPOINT_DIR / \"stage3_flow_model.joblib\"\n)\n\nprint(\"✓ Speed model saved\")\nprint(\"✓ Flow model saved\")\n\n\n# ------------------------------------------------------------\n# 3. Save feature configuration\n# ------------------------------------------------------------\n\nstage3_config = {\n    \"panel\": PANEL,\n\n    \"train_start\": str(\n        TRAIN_START\n    ),\n\n    \"train_end\": str(\n        TRAIN_END\n    ),\n\n    \"valid_start\": str(\n        VALID_START\n    ),\n\n    \"valid_end\": str(\n        VALID_END\n    ),\n\n    \"selected_features\": SELECTED_FEATURES,\n\n    \"physical_features\": PHYSICAL_FEATURES,\n\n    \"temporal_features\": TEMPORAL_FEATURES,\n\n    \"model_parameters\": MODEL_PARAMS_ERROR,\n\n    \"n_train_rows\": int(\n        len(X_train_multi)\n    ),\n\n    \"n_valid_rows\": int(\n        len(X_valid_multi)\n    ),\n}\n\nwith open(\n    CHECKPOINT_DIR / \"stage3_config.json\",\n    \"w\"\n) as f:\n    json.dump(\n        stage3_config,\n        f,\n        indent=2\n    )\n\nprint(\"✓ Configuration saved\")\n\n\n# ------------------------------------------------------------\n# 4. Save important experimental results\n# ------------------------------------------------------------\n\nstage3_results = {\n    \"cell_11_ablation\": {\n        \"physical_only\": 0.294339,\n        \"temporal_only\": 0.806878,\n        \"physical_availability\": 0.294828,\n        \"physical_temporal\": 0.811922,\n        \"all_features\": 0.811989,\n    },\n\n    \"cell_12_overall\": {\n        \"speed_mae\": 1.8304783115077017,\n        \"speed_rmse\": 5.222684050623777,\n        \"flow_mae\": 213.79142978962147,\n        \"flow_rmse\": 413.51837682588047,\n    },\n\n    \"cell_12_regime\": {\n        \"R1\": {\n            \"speed_rmse\": 4.061436,\n            \"flow_rmse\": 294.432456,\n        },\n        \"R2\": {\n            \"speed_rmse\": 4.298802,\n            \"flow_rmse\": 323.953505,\n        },\n        \"R3\": {\n            \"speed_rmse\": 6.302603,\n            \"flow_rmse\": 514.826909,\n        },\n    },\n\n    \"cell_12_history\": {\n        \"lag1_available\": {\n            \"speed_rmse\": 3.145628,\n            \"flow_rmse\": 193.171128,\n        },\n        \"lag1_missing\": {\n            \"speed_rmse\": 7.055457,\n            \"flow_rmse\": 586.575199,\n        },\n    },\n\n    \"cell_12_traffic_state\": {\n        \"congested\": {\n            \"speed_rmse\": 16.647867,\n            \"flow_rmse\": 510.625322,\n        },\n        \"moderate\": {\n            \"speed_rmse\": 14.132079,\n            \"flow_rmse\": 868.398751,\n        },\n        \"free_flow\": {\n            \"speed_rmse\": 3.214202,\n            \"flow_rmse\": 404.022489,\n        },\n    },\n}\n\nwith open(\n    CHECKPOINT_DIR / \"stage3_results.json\",\n    \"w\"\n) as f:\n    json.dump(\n        stage3_results,\n        f,\n        indent=2\n    )\n\nprint(\"✓ Results saved\")\n\n\n# ------------------------------------------------------------\n# 5. Human-readable handoff document\n# ------------------------------------------------------------\n\nhandoff = \"\"\"\n# TrafficFlowBench — Stage 3 Handoff\n\n## Current Stage\n\nStage 3 — Feature Engineering\n\nCompleted cells:\n- CELL 01 — Temporal Feature Availability\n- CELL 02 — Temporal Feature Signal\n- CELL 03 — Spatial Topology Inspection\n- CELL 05 — Physical Feature Signal\n- CELL 06 — Feature Availability + Leakage Audit\n- CELL 07 — First Complete Feature Matrix\n- CELL 08 — Ablation Experiment Setup\n- CELL 09 — Same-Day Ablation\n- CELL 10 — Multi-Regime Chronological Dataset\n- CELL 11 — Proper Multi-Regime Ablation\n- CELL 12 — Error Analysis\n\nNext cell:\n- CELL 14 — Investigate Missing-History + Congestion Failure Mode\n\n\n## Dataset\n\nPanel:\nD7_I405_S\n\nTraining:\n2030-06-01 → 2031-01-28\n\nValidation:\n2031-01-29 → 2031-02-28\n\nTraining target rows:\n1,870,910\n\nValidation target rows:\n257,027\n\n\n## Selected Feature Set\n\n15 features:\n\nPhysical:\n- length_km\n- lanes\n- free_speed_kmh\n- capacity_vph\n- capacity_per_lane\n\nTemporal:\n- speed_lag_1\n- flow_lag_1\n- speed_lag_2\n- flow_lag_2\n- speed_lag_3\n- flow_lag_3\n- speed_lag_6\n- flow_lag_6\n- speed_lag_12\n- flow_lag_12\n\nAvailability indicators were tested but contributed almost nothing.\n\n\n## CELL 11 — Ablation Conclusion\n\nPhysical only:\n0.294339\n\nTemporal only:\n0.806878\n\nPhysical + temporal:\n0.811922\n\nAll features:\n0.811989\n\nConclusion:\nTemporal history is overwhelmingly dominant.\nPhysical features provide a small but measurable improvement.\nAvailability indicators provide negligible additional benefit.\n\n\n## CELL 12 — Main Error Findings\n\nOverall:\nSpeed RMSE = 5.222684\nFlow RMSE = 413.518377\n\nBy regime:\n\nR1:\nSpeed RMSE = 4.061436\nFlow RMSE = 294.432456\n\nR2:\nSpeed RMSE = 4.298802\nFlow RMSE = 323.953505\n\nR3:\nSpeed RMSE = 6.302603\nFlow RMSE = 514.826909\n\n\n## Critical Failure Mode\n\nLag-1 available:\n\nSpeed RMSE = 3.145628\nFlow RMSE = 193.171128\n\nLag-1 missing:\n\nSpeed RMSE = 7.055457\nFlow RMSE = 586.575199\n\nTherefore missing recent temporal history is the strongest identified failure mode.\n\n\n## Traffic-State Failure\n\nCongested:\n\nSpeed RMSE = 16.647867\nFlow RMSE = 510.625322\n\nFree flow:\n\nSpeed RMSE = 3.214202\nFlow RMSE = 404.022489\n\nThe model performs much worse during congestion.\n\n\n## Important Worst-Case Pattern\n\nSeveral catastrophic predictions have:\n\nTrue speed ≈ 15–20 km/h\nPredicted speed ≈ 115–122 km/h\n\nThis means the model sometimes predicts free-flow traffic when the true state is severely congested.\n\nRepeated difficult links include:\n- L405S-336\n- L405S-254\n- L405S-001\n- L405S-124\n- L405S-052\n\n\n## Spatial Finding\n\nDirect observed-to-observed topology from the supplied topology file is sparse.\n\nDo NOT fabricate spatial neighbors using:\n- row order\n- link ID order\n- order_index\n\nSpatial topology was therefore not used as a core feature.\n\n\n## Temporal Finding\n\nLag 1 is the strongest temporal feature.\n\nTemporal availability is limited because masked traffic history can itself be missing.\n\nCurrent feature construction was performed per daily masked file.\n\nPotential future investigation:\nCarry legitimate temporal history across day boundaries instead of resetting lags at midnight.\n\n\n## Validation Warning\n\nCELL 11 overall displayed scores were row-weighted.\nOfficial Task 1 scoring averages regime scores.\n\nFuture official-style evaluation should use:\nmean(R1 score, R2 score, R3 score)\n\nDo not confuse row-weighted and regime-averaged scores.\n\n\n## NEXT STEP\n\nDo NOT immediately perform blind hyperparameter tuning.\n\nFirst investigate:\n\n1. Why catastrophic congestion cases occur.\n2. Whether lag-1 is missing in those cases.\n3. What other lag/history information is available.\n4. Whether cross-day temporal history can be carried safely.\n5. Whether traffic-state/context features can identify congestion when recent history is unavailable.\n6. Whether repeated difficult links have systematic behavior.\n\nOnly after this investigation should model tuning or feature redesign be performed.\n\n\n## Checkpoint Status\n\nStage 3 Feature Engineering:\nIN PROGRESS\n\nCells 01–12:\nCOMPLETE\n\nCurrent best working model:\nXGBoost\nPhysical + temporal features\n\nNext:\nCELL 14 — Missing-History + Congestion Investigation\n\"\"\"\n\nwith open(\n    CHECKPOINT_DIR / \"STAGE3_HANDOFF.md\",\n    \"w\",\n    encoding=\"utf-8\"\n) as f:\n    f.write(handoff)\n\nprint(\"✓ Handoff document saved\")\n\n\n# ------------------------------------------------------------\n# 6. List checkpoint files and sizes\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CHECKPOINT ARTIFACTS\")\nprint(\"=\" * 80)\n\nfor path in sorted(CHECKPOINT_DIR.iterdir()):\n    size_mb = path.stat().st_size / (1024 ** 2)\n\n    print(\n        f\"{path.name:<35} \"\n        f\"{size_mb:>10.2f} MB\"\n    )\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 13 CHECKPOINT COMPLETE\")\nprint(\"=\" * 80)\n\nprint(\n    \"✓ Datasets persisted\"\n)\n\nprint(\n    \"✓ Models persisted\"\n)\n\nprint(\n    \"✓ Configuration persisted\"\n)\n\nprint(\n    \"✓ Experimental results persisted\"\n)\n\nprint(\n    \"✓ Human-readable handoff persisted\"\n)\n\nprint(\n    \"\\nIMPORTANT:\"\n)\n\nprint(\n    \"Save/commit this Kaggle notebook version \"\n    \"with its output files before closing the session.\"\n)\n\nprint(\n    \"\\nTomorrow resume from:\"\n)\n\nprint(\n    \"CELL 14 — Missing-History + Congestion Investigation\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T19:16:53.994698Z","iopub.execute_input":"2026-10-07T19:16:53.994966Z","iopub.status.idle":"2026-10-07T19:16:56.201804Z","shell.execute_reply.started":"2026-10-07T19:16:53.994946Z","shell.execute_reply":"2026-10-07T19:16:56.201077Z"}},"outputs":[{"name":"stdout","text":"================================================================