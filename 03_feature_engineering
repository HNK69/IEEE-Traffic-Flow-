ysical metadata merged safely\"\n)\n\nprint(\n    \"\\nCELL 10 COMPLETE\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T19:02:57.647778Z","iopub.execute_input":"2026-10-07T19:02:57.648153Z","iopub.status.idle":"2026-10-07T19:03:28.953493Z","shell.execute_reply.started":"2026-10-07T19:02:57.648132Z","shell.execute_reply":"2026-10-07T19:03:28.952515Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 11 — PROPER MULTI-REGIME ABLATION\n# ============================================================\n\nfrom xgboost import XGBRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n\n# ------------------------------------------------------------\n# 1. Ablation configurations\n# ------------------------------------------------------------\n\nABLATION_CONFIGS_MULTI = {\n\n    \"physical_only\": PHYSICAL_FEATURES,\n\n    \"temporal_only\": TEMPORAL_FEATURES,\n\n    \"physical_availability\": (\n        PHYSICAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n\n    \"physical_temporal\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n    ),\n\n    \"all_features\": (\n        PHYSICAL_FEATURES\n        + TEMPORAL_FEATURES\n        + AVAILABILITY_FEATURES\n    ),\n}\n\n\n# ------------------------------------------------------------\n# 2. Fixed model configuration\n# ------------------------------------------------------------\n\nMODEL_PARAMS_MULTI = {\n    \"n_estimators\": 300,\n    \"max_depth\": 8,\n    \"learning_rate\": 0.05,\n    \"subsample\": 0.8,\n    \"colsample_bytree\": 0.8,\n    \"objective\": \"reg:squarederror\",\n    \"tree_method\": \"hist\",\n    \"random_state\": 42,\n    \"n_jobs\": -1,\n}\n\n\n# ------------------------------------------------------------\n# 3. Evaluation function\n# ------------------------------------------------------------\n\ndef evaluate_task1(\n    y_true,\n    pred_speed,\n    pred_flow,\n    lanes\n):\n\n    speed_rmse = np.sqrt(\n        mean_squared_error(\n            y_true[\"target_speed\"],\n            pred_speed\n        )\n    )\n\n    flow_true_per_lane = (\n        y_true[\"target_flow\"].to_numpy()\n        / lanes\n    )\n\n    flow_pred_per_lane = (\n        pred_flow\n        / lanes\n    )\n\n    flow_rmse_per_lane = np.sqrt(\n        mean_squared_error(\n            flow_true_per_lane,\n            flow_pred_per_lane\n        )\n    )\n\n    speed_score = max(\n        0.0,\n        1.0 - speed_rmse / 25.0\n    )\n\n    flow_score = max(\n        0.0,\n        1.0 - flow_rmse_per_lane / 600.0\n    )\n\n    state_score = (\n        0.54 * speed_score\n        + 0.46 * flow_score\n    )\n\n    return {\n        \"speed_rmse\": speed_rmse,\n        \"flow_rmse_per_lane\": flow_rmse_per_lane,\n        \"speed_score\": speed_score,\n        \"flow_score\": flow_score,\n        \"state_score\": state_score,\n    }\n\n\n# ------------------------------------------------------------\n# 4. Per-regime evaluation helper\n# ------------------------------------------------------------\n\ndef evaluate_by_regime(\n    valid_df,\n    pred_speed,\n    pred_flow\n):\n\n    regime_results = []\n\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n\n        mask = (\n            valid_df[\"mask_regime\"]\n            == regime\n        )\n\n        if mask.sum() == 0:\n            continue\n\n        regime_y = valid_df.loc[\n            mask,\n            [\n                \"target_speed\",\n                \"target_flow\"\n            ]\n        ]\n\n        regime_lanes = valid_df.loc[\n            mask,\n            \"lanes\"\n        ].to_numpy()\n\n        metrics = evaluate_task1(\n            regime_y,\n            pred_speed[mask.to_numpy()],\n            pred_flow[mask.to_numpy()],\n            regime_lanes\n        )\n\n        metrics[\"regime\"] = regime\n        metrics[\"n_targets\"] = int(\n            mask.sum()\n        )\n\n        regime_results.append(\n            metrics\n        )\n\n    return pd.DataFrame(\n        regime_results\n    )\n\n\n# ------------------------------------------------------------\n# 5. Run ablations\n# ------------------------------------------------------------\n\noverall_results = []\nregime_results = []\n\nfor config_name, features in ABLATION_CONFIGS_MULTI.items():\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\n        f\"RUNNING ABLATION: {config_name}\"\n    )\n    print(\"=\" * 80)\n\n    print(\n        \"Features:\",\n        len(features)\n    )\n\n    X_train_cfg = X_train_multi[\n        features\n    ]\n\n    X_valid_cfg = X_valid_multi[\n        features\n    ]\n\n    # --------------------------------------------------------\n    # Speed model\n    # --------------------------------------------------------\n\n    print(\"\\nTraining speed model...\")\n\n    speed_model = XGBRegressor(\n        **MODEL_PARAMS_MULTI\n    )\n\n    speed_model.fit(\n        X_train_cfg,\n        y_train_multi[\"target_speed\"],\n        eval_set=[\n            (\n                X_valid_cfg,\n                y_valid_multi[\"target_speed\"]\n            )\n        ],\n        verbose=False\n    )\n\n    pred_speed = speed_model.predict(\n        X_valid_cfg\n    )\n\n    # --------------------------------------------------------\n    # Flow model\n    # --------------------------------------------------------\n\n    print(\"Training flow model...\")\n\n    flow_model = XGBRegressor(\n        **MODEL_PARAMS_MULTI\n    )\n\n    flow_model.fit(\n        X_train_cfg,\n        y_train_multi[\"target_flow\"],\n        eval_set=[\n            (\n                X_valid_cfg,\n                y_valid_multi[\"target_flow\"]\n            )\n        ],\n        verbose=False\n    )\n\n    pred_flow = flow_model.predict(\n        X_valid_cfg\n    )\n\n    # --------------------------------------------------------\n    # Overall evaluation\n    # --------------------------------------------------------\n\n    lanes_valid = X_valid_multi[\n        \"lanes\"\n    ].to_numpy()\n\n    metrics = evaluate_task1(\n        y_valid_multi,\n        pred_speed,\n        pred_flow,\n        lanes_valid\n    )\n\n    metrics[\"configuration\"] = config_name\n    metrics[\"n_features\"] = len(features)\n    metrics[\"n_targets\"] = len(\n        y_valid_multi\n    )\n\n    overall_results.append(\n        metrics\n    )\n\n    print(\n        f\"\\nOverall State Score: \"\n        f\"{metrics['state_score']:.6f}\"\n    )\n\n    print(\n        f\"Speed RMSE: \"\n        f\"{metrics['speed_rmse']:.4f}\"\n    )\n\n    print(\n        f\"Flow RMSE/lane: \"\n        f\"{metrics['flow_rmse_per_lane']:.4f}\"\n    )\n\n    # --------------------------------------------------------\n    # Per-regime evaluation\n    # --------------------------------------------------------\n\n    regime_df = evaluate_by_regime(\n        valid_multi,\n        pred_speed,\n        pred_flow\n    )\n\n    regime_df[\"configuration\"] = (\n        config_name\n    )\n\n    regime_results.append(\n        regime_df\n    )\n\n    print(\"\\nPer-regime State Scores:\")\n\n    display(\n        regime_df[\n            [\n                \"regime\",\n                \"n_targets\",\n                \"speed_rmse\",\n                \"flow_rmse_per_lane\",\n                \"state_score\"\n            ]\n        ]\n    )\n\n\n# ------------------------------------------------------------\n# 6. Overall results\n# ------------------------------------------------------------\n\noverall_results_df = (\n    pd.DataFrame(\n        overall_results\n    )\n    .sort_values(\n        \"state_score\",\n        ascending=False\n    )\n    .reset_index(drop=True)\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"OVERALL ABLATION RESULTS\")\nprint(\"=\" * 80)\n\ndisplay(\n    overall_results_df[\n        [\n            \"configuration\",\n            \"n_features\",\n            \"n_targets\",\n            \"speed_rmse\",\n            \"flow_rmse_per_lane\",\n            \"speed_score\",\n            \"flow_score\",\n            \"state_score\",\n        ]\n    ]\n)\n\n\n# ------------------------------------------------------------\n# 7. Per-regime results\n# ------------------------------------------------------------\n\nregime_results_df = pd.concat(\n    regime_results,\n    ignore_index=True\n)\n\nregime_results_df = regime_results_df[\n    [\n        \"configuration\",\n        \"regime\",\n        \"n_targets\",\n        \"speed_rmse\",\n        \"flow_rmse_per_lane\",\n        \"speed_score\",\n        \"flow_score\",\n        \"state_score\",\n    ]\n]\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"PER-REGIME ABLATION RESULTS\")\nprint(\"=\" * 80)\n\ndisplay(\n    regime_results_df.sort_values(\n        [\n            \"configuration\",\n            \"regime\"\n        ]\n    )\n)\n\n\n# ------------------------------------------------------------\n# 8. Sanity checks\n# ------------------------------------------------------------\n\nassert len(\n    overall_results_df\n) == 5\n\nassert (\n    overall_results_df[\n        \"state_score\"\n    ].notna().all()\n)\n\nassert set(\n    regime_results_df[\"regime\"]\n) == {\n    \"R1\",\n    \"R2\",\n    \"R3\"\n}\n\n\n# ------------------------------------------------------------\n# 9. Checkpoint\n# ------------------------------------------------------------\n\nbest_config = (\n    overall_results_df\n    .iloc[0][\"configuration\"]\n)\n\nbest_score = (\n    overall_results_df\n    .iloc[0][\"state_score\"]\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 11 CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\n    \"✓ Five feature configurations evaluated\"\n)\n\nprint(\n    \"✓ Same model configuration used for all\"\n)\n\nprint(\n    \"✓ Chronological validation preserved\"\n)\n\nprint(\n    \"✓ Overall Task 1 metrics calculated\"\n)\n\nprint(\n    \"✓ R1/R2/R3 metrics calculated\"\n)\n\nprint(\n    f\"✓ Current best configuration: \"\n    f\"{best_config}\"\n)\n\nprint(\n    f\"✓ Current best state score: \"\n    f\"{best_score:.6f}\"\n)\n\nprint(\"\\nCELL 11 COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T19:04:38.487003Z","iopub.execute_input":"2026-10-07T19:04:38.487285Z","iopub.status.idle":"2026-10-07T19:10:08.781254Z","shell.execute_reply.started":"2026-10-07T19:04:38.487266Z","shell.execute_reply":"2026-10-07T19:10:08.780577Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 12 — ERROR ANALYSIS\n# ============================================================\n\nfrom xgboost import XGBRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n\n# ------------------------------------------------------------\n# 1. Selected feature set\n# ------------------------------------------------------------\n\nSELECTED_FEATURES = (\n    PHYSICAL_FEATURES\n    + TEMPORAL_FEATURES\n)\n\nprint(\"=\" * 80)\nprint(\"SELECTED FEATURE SET\")\nprint(\"=\" * 80)\n\nprint(\"Number of features:\", len(SELECTED_FEATURES))\n\nprint(SELECTED_FEATURES)\n\n\n# ------------------------------------------------------------\n# 2. Train selected baseline\n# ------------------------------------------------------------\n\nMODEL_PARAMS_ERROR = {\n    \"n_estimators\": 300,\n    \"max_depth\": 8,\n    \"learning_rate\": 0.05,\n    \"subsample\": 0.8,\n    \"colsample_bytree\": 0.8,\n    \"objective\": \"reg:squarederror\",\n    \"tree_method\": \"hist\",\n    \"random_state\": 42,\n    \"n_jobs\": -1,\n}\n\n\nX_train_error = X_train_multi[\n    SELECTED_FEATURES\n]\n\nX_valid_error = X_valid_multi[\n    SELECTED_FEATURES\n]\n\n\nprint(\"\\nTraining speed model...\")\n\nspeed_model_error = XGBRegressor(\n    **MODEL_PARAMS_ERROR\n)\n\nspeed_model_error.fit(\n    X_train_error,\n    y_train_multi[\"target_speed\"],\n    verbose=False\n)\n\npred_speed_error = (\n    speed_model_error.predict(\n        X_valid_error\n    )\n)\n\n\nprint(\"Training flow model...\")\n\nflow_model_error = XGBRegressor(\n    **MODEL_PARAMS_ERROR\n)\n\nflow_model_error.fit(\n    X_train_error,\n    y_train_multi[\"target_flow\"],\n    verbose=False\n)\n\npred_flow_error = (\n    flow_model_error.predict(\n        X_valid_error\n    )\n)\n\n\n# ------------------------------------------------------------\n# 3. Build error-analysis dataframe\n# ------------------------------------------------------------\n\nerror_df = valid_multi[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"mask_regime\",\n        \"target_speed\",\n        \"target_flow\",\n        \"lanes\",\n        \"free_speed_kmh\",\n        \"capacity_vph\",\n    ]\n].copy()\n\nerror_df[\"pred_speed\"] = (\n    pred_speed_error\n)\n\nerror_df[\"pred_flow\"] = (\n    pred_flow_error\n)\n\nerror_df[\"speed_error\"] = (\n    error_df[\"pred_speed\"]\n    - error_df[\"target_speed\"]\n)\n\nerror_df[\"flow_error\"] = (\n    error_df[\"pred_flow\"]\n    - error_df[\"target_flow\"]\n)\n\nerror_df[\"abs_speed_error\"] = (\n    error_df[\"speed_error\"]\n    .abs()\n)\n\nerror_df[\"abs_flow_error\"] = (\n    error_df[\"flow_error\"]\n    .abs()\n)\n\n\n# ------------------------------------------------------------\n# 4. Overall error summary\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"OVERALL ERROR SUMMARY\")\nprint(\"=\" * 80)\n\nprint(\n    \"Speed MAE:\",\n    error_df[\"abs_speed_error\"].mean()\n)\n\nprint(\n    \"Speed RMSE:\",\n    np.sqrt(\n        np.mean(\n            error_df[\"speed_error\"] ** 2\n        )\n    )\n)\n\nprint(\n    \"Flow MAE:\",\n    error_df[\"abs_flow_error\"].mean()\n)\n\nprint(\n    \"Flow RMSE:\",\n    np.sqrt(\n        np.mean(\n            error_df[\"flow_error\"] ** 2\n        )\n    )\n)\n\n\n# ------------------------------------------------------------\n# 5. Error by mask regime\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY MASK REGIME\")\nprint(\"=\" * 80)\n\nregime_error = (\n    error_df\n    .groupby(\"mask_regime\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(regime_error)\n\n\n# ------------------------------------------------------------\n# 6. Error by speed regime\n# ------------------------------------------------------------\n# We use the TRUE speed to distinguish:\n# free-flow / moderate / congested conditions.\n\nerror_df[\"traffic_state\"] = pd.cut(\n    error_df[\"target_speed\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\"\n    ]\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY TRAFFIC STATE\")\nprint(\"=\" * 80)\n\ntraffic_state_error = (\n    error_df\n    .groupby(\n        \"traffic_state\",\n        observed=True\n    )\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(traffic_state_error)\n\n\n# ------------------------------------------------------------\n# 7. Error by history availability\n# ------------------------------------------------------------\n# Lag-1 is our strongest temporal feature.\n# We test whether errors increase when it is unavailable.\n\nlag1_available = (\n    X_valid_multi[\n        \"speed_lag_1\"\n    ].notna()\n)\n\nerror_df[\"lag1_history\"] = np.where(\n    lag1_available,\n    \"available\",\n    \"missing\"\n)\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY LAG-1 AVAILABILITY\")\nprint(\"=\" * 80)\n\nhistory_error = (\n    error_df\n    .groupby(\"lag1_history\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(history_error)\n\n\n# ------------------------------------------------------------\n# 8. Error by lane count\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ERROR BY LANE COUNT\")\nprint(\"=\" * 80)\n\nlane_error = (\n    error_df\n    .groupby(\"lanes\")\n    .agg(\n        n_targets=(\"target_speed\", \"size\"),\n        speed_mae=(\"abs_speed_error\", \"mean\"),\n        speed_rmse=(\n            \"speed_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n        flow_mae=(\"abs_flow_error\", \"mean\"),\n        flow_rmse=(\n            \"flow_error\",\n            lambda x: np.sqrt(\n                np.mean(x ** 2)\n            )\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(lane_error)\n\n\n# ============================================================\n# FIX — WORST PREDICTIONS\n# =============================