=======================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"       group     n  target_speed_mean  cross_mean_speed  cross_q10_speed  \\\n0  congested   143          38.912335         97.200260        49.265130   \n1  free_flow  2559         113.007935        110.045958        97.442917   \n\n   cross_mean_flow  \n0      6017.478304  \n1      4283.320014  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>group</th>\n      <th>n</th>\n      <th>target_speed_mean</th>\n      <th>cross_mean_speed</th>\n      <th>cross_q10_speed</th>\n      <th>cross_mean_flow</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>congested</td>\n      <td>143</td>\n      <td>38.912335</td>\n      <td>97.200260</td>\n      <td>49.265130</td>\n      <td>6017.478304</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>free_flow</td>\n      <td>2559</td>\n      <td>113.007935</td>\n      <td>110.045958</td>\n      <td>97.442917</td>\n      <td>4283.320014</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n================================================================================\nCELL 16C CHECKPOINT\n================================================================================\n✓ Timestamp dtypes normalized\n✓ Target lag-1 availability recovered\n✓ Lag-1 missing subset isolated\n✓ Cross-link signal tested on difficult subset\n✓ Congested vs free-flow separation measured\n✓ No target truth used as a feature\n\nCELL 16C COMPLETE\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# ============================================================\n# CELL 16D — LOCAL VS GLOBAL CROSS-LINK SIGNAL\n# ============================================================\n\nprint(\"=\" * 80)\nprint(\"CELL 16D — LOCAL VS GLOBAL CROSS-LINK SIGNAL\")\nprint(\"=\" * 80)\n\n\n# ------------------------------------------------------------\n# 1. Prepare masked observations\n# ------------------------------------------------------------\n\nobs = masked[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"milepost\",\n        \"speed_kmh\",\n        \"flow_vph\",\n    ]\n].copy()\n\nobs[\"timestamp\"] = pd.to_datetime(\n    obs[\"timestamp\"],\n    utc=True\n)\n\n\n# ------------------------------------------------------------\n# 2. Build target table with milepost from masked data\n# ------------------------------------------------------------\n\ntarget_base = targets[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh_truth\",\n        \"flow_vph_truth\",\n    ]\n].copy()\n\ntarget_base[\"timestamp\"] = pd.to_datetime(\n    target_base[\"timestamp\"],\n    utc=True\n)\n\n# One milepost per link.\nlink_milepost = (\n    obs[\n        [\n            \"link_id\",\n            \"milepost\",\n        ]\n    ]\n    .drop_duplicates(\"link_id\")\n)\n\nassert (\n    link_milepost[\"link_id\"].nunique()\n    == len(link_milepost)\n)\n\ntargets_d = target_base.merge(\n    link_milepost,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nassert targets_d[\"milepost\"].notna().all()\n\n\n# ------------------------------------------------------------\n# 3. Same-timestamp target × observed-link pairs\n# ------------------------------------------------------------\n\npairs = targets_d.merge(\n    obs,\n    on=\"timestamp\",\n    how=\"left\",\n    suffixes=(\"_target\", \"_obs\"),\n)\n\n\n# Exclude the target link itself.\npairs = pairs[\n    pairs[\"link_id_target\"]\n    != pairs[\"link_id_obs\"]\n].copy()\n\n\n# Distance using physical milepost.\npairs[\"distance_km\"] = (\n    pairs[\"milepost_target\"]\n    - pairs[\"milepost_obs\"]\n).abs()\n\n\n# Only observed speed contributes.\npairs = pairs[\n    pairs[\"speed_kmh\"].notna()\n].copy()\n\n\nprint(\"\\nTarget-observation pairs:\", len(pairs))\n\n\n# ------------------------------------------------------------\n# 4. Build local features\n# ------------------------------------------------------------\n\nradii = [0.5, 1.0, 2.0, 5.0]\n\nlocal_results = targets_d[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh_truth\",\n        \"flow_vph_truth\",\n    ]\n].copy()\n\n\nfor radius in radii:\n\n    local = pairs[\n        pairs[\"distance_km\"] <= radius\n    ]\n\n    grouped = (\n        local\n        .groupby(\n            [\n                \"timestamp\",\n                \"link_id_target\",\n            ]\n        )\n        .agg(\n            **{\n                f\"speed_mean_{radius}km\":\n                    (\"speed_kmh\", \"mean\"),\n\n                f\"speed_q10_{radius}km\":\n                    (\n                        \"speed_kmh\",\n                        lambda x: x.quantile(0.10)\n                    ),\n\n                f\"speed_q25_{radius}km\":\n                    (\n                        \"speed_kmh\",\n                        lambda x: x.quantile(0.25)\n                    ),\n\n                f\"flow_mean_{radius}km\":\n                    (\"flow_vph\", \"mean\"),\n\n                f\"n_links_{radius}km\":\n                    (\"speed_kmh\", \"count\"),\n            }\n        )\n        .reset_index()\n        .rename(\n            columns={\n                \"link_id_target\": \"link_id\"\n            }\n        )\n    )\n\n    local_results = local_results.merge(\n        grouped,\n        on=[\n            \"timestamp\",\n            \"link_id\",\n        ],\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n\n# ------------------------------------------------------------\n# 5. Add global signal from Cell 16B\n# ------------------------------------------------------------\n\nglobal_signal = cross_signal[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"mean_speed\",\n        \"q10_speed\",\n        \"q25_speed\",\n        \"mean_flow\",\n    ]\n].copy()\n\nglobal_signal[\"timestamp\"] = pd.to_datetime(\n    global_signal[\"timestamp\"],\n    utc=True\n)\n\nlocal_results = local_results.merge(\n    global_signal,\n    on=[\n        \"timestamp\",\n        \"link_id\",\n    ],\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\n\n# ------------------------------------------------------------\n# 6. Recover target lag-1 availability\n# ------------------------------------------------------------\n\nlag1 = masked[\n    [\n        \"timestamp\",\n        \"link_id\",\n        \"speed_kmh\",\n    ]\n].copy()\n\nlag1[\"timestamp\"] = pd.to_datetime(\n    lag1[\"timestamp\"],\n    utc=True\n)\n\nlag1 = lag1.sort_values(\n    [\n        \"link_id\",\n        \"timestamp\",\n    ]\n)\n\nlag1[\"speed_lag_1\"] = (\n    lag1\n    .groupby(\"link_id\")[\"speed_kmh\"]\n    .shift(1)\n)\n\nlocal_results = local_results.merge(\n    lag1[\n        [\n            \"timestamp\",\n            \"link_id\",\n            \"speed_lag_1\",\n        ]\n    ],\n    on=[\n        \"timestamp\",\n        \"link_id\",\n    ],\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\n\n# ------------------------------------------------------------\n# 7. Restrict to lag-1 missing targets\n# ------------------------------------------------------------\n\nlocal_results = local_results[\n    local_results[\"speed_lag_1\"].isna()\n].copy()\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LAG-1 MISSING DATASET\")\nprint(\"=\" * 80)\n\nprint(\"Rows:\", len(local_results))\n\n\n# ------------------------------------------------------------\n# 8. Define traffic state\n# ------------------------------------------------------------\n\nlocal_results[\"traffic_state\"] = pd.cut(\n    local_results[\"speed_kmh_truth\"],\n    bins=[\n        -np.inf,\n        70,\n        100,\n        np.inf,\n    ],\n    labels=[\n        \"congested\",\n        \"moderate\",\n        \"free_flow\",\n    ],\n)\n\n\n# ------------------------------------------------------------\n# 9. Speed correlation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"SPEED CORRELATION BY SPATIAL RADIUS\")\nprint(\"=\" * 80)\n\ncorr_rows = []\n\nfor radius in radii:\n\n    feature = f\"speed_mean_{radius}km\"\n\n    valid = local_results[\n        [\n            feature,\n            \"speed_kmh_truth\",\n        ]\n    ].dropna()\n\n    corr_rows.append(\n        {\n            \"radius_km\": radius,\n            \"speed_mean_correlation\":\n                valid.corr().iloc[0, 1],\n            \"valid_targets\":\n                len(valid),\n        }\n    )\n\n\n# Global reference\nvalid = local_results[\n    [\n        \"mean_speed\",\n        \"speed_kmh_truth\",\n    ]\n].dropna()\n\ncorr_rows.append(\n    {\n        \"radius_km\": \"GLOBAL\",\n        \"speed_mean_correlation\":\n            valid.corr().iloc[0, 1],\n        \"valid_targets\":\n            len(valid),\n    }\n)\n\ndisplay(\n    pd.DataFrame(corr_rows)\n)\n\n\n# ------------------------------------------------------------\n# 10. Flow correlation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FLOW CORRELATION BY SPATIAL RADIUS\")\nprint(\"=\" * 80)\n\nflow_rows = []\n\nfor radius in radii:\n\n    feature = f\"flow_mean_{radius}km\"\n\n    valid = local_results[\n        [\n            feature,\n            \"flow_vph_truth\",\n        ]\n    ].dropna()\n\n    flow_rows.append(\n        {\n            \"radius_km\": radius,\n            \"flow_mean_correlation\":\n                valid.corr().iloc[0, 1],\n            \"valid_targets\":\n                len(valid),\n        }\n    )\n\n\nvalid = local_results[\n    [\n        \"mean_flow\",\n        \"flow_vph_truth\",\n    ]\n].dropna()\n\nflow_rows.append(\n    {\n        \"radius_km\": \"GLOBAL\",\n        \"flow_mean_correlation\":\n            valid.corr().iloc[0, 1],\n        \"valid_targets\":\n            len(valid),\n    }\n)\n\ndisplay(\n    pd.DataFrame(flow_rows)\n)\n\n\n# ------------------------------------------------------------\n# 11. Congestion separation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CONGESTED VS FREE-FLOW — LOCAL SIGNAL\")\nprint(\"=\" * 80)\n\ncongested = (\n    local_results[\"speed_kmh_truth\"] < 70\n)\n\nfree_flow = (\n    local_results[\"speed_kmh_truth\"] >= 100\n)\n\ncomparison_rows = []\n\nfor radius in radii:\n\n    feature = f\"speed_q10_{radius}km\"\n\n    comparison_rows.append(\n        {\n            \"radius_km\": radius,\n\n            \"congested_n\":\n                congested.sum(),\n\n            \"free_flow_n\":\n                free_flow.sum(),\n\n            \"congested_q10_mean\":\n                local_results.loc[\n                    congested,\n                    feature\n                ].mean(),\n\n            \"free_flow_q10_mean\":\n                local_results.loc[\n                    free_flow,\n                    feature\n                ].mean(),\n\n            \"congested_low_speed_rate\":\n                (\n                    local_results.loc[\n                        congested,\n                        feature\n                    ] < 50\n                ).mean(),\n\n            \"free_flow_low_speed_rate\":\n                (\n                    local_results.loc[\n                        free_flow,\n                        feature\n                    ] < 50\n                ).mean(),\n        }\n    )\n\n\n# Global reference\ncomparison_rows.append(\n    {\n        \"radius_km\": \"GLOBAL\",\n\n        \"congested_n\":\n            congested.sum(),\n\n        \"free_flow_n\":\n            free_flow.sum(),\n\n        \"congested_q10_mean\":\n            local_results.loc[\n                congested,\n                \"q10_speed\"\n            ].mean(),\n\n        \"free_flow_q10_mean\":\n            local_results.loc[\n                free_flow,\n                \"q10_speed\"\n            ].mean(),\n\n        \"congested_low_speed_rate\":\n            (\n                local_results.loc[\n                    congested,\n                    \"q10_speed\"\n                ] < 50\n            ).mean(),\n\n        \"free_flow_low_speed_rate\":\n            (\n                local_results.loc[\n                    free_flow,\n                    \"q10_speed\"\n                ] < 50\n            ).mean(),\n    }\n)\n\ndisplay(\n    pd.DataFrame(comparison_rows)\n)\n\n\n# ------------------------------------------------------------\n# 12. Local coverage\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"LOCAL SIGNAL COVERAGE\")\nprint(\"=\" * 80)\n\ncoverage_rows = []\n\nfor radius in radii:\n\n    feature = f\"n_links_{radius}km\"\n\n    coverage_rows.append(\n        {\n            \"radius_km\": radius,\n\n            \"mean_observed_links\":\n                local_results[feature].mean(),\n\n            \"median_observed_links\":\n                local_results[feature].median(),\n\n            \"zero_available_rate\":\n                (\n                    local_results[feature].fillna(0)\n                    == 0\n                ).mean(),\n\n            \"at_least_one_rate\":\n                (\n                    local_results[feature].fillna(0)\n                    > 0\n                ).mean(),\n        }\n    )\n\ndisplay(\n    pd.DataFrame(coverage_rows)\n)\n\n\n# ------------------------------------------------------------\n# 13. Checkpoint\n# ------------------------------------------------------------\n\nassert len(local_results) > 0\nassert local_results[\"milepost\"].isna().sum() == 0 \\\n    if \"milepost\" in local_results.columns else True\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"CELL 16D CHECKPOINT\")\nprint(\"=\" * 80)\n\nprint(\"✓ Milepost recovered from masked data\")\nprint(\"✓ Target link excluded\")\nprint(\"✓ Local spatial radii tested\")\nprint(\"✓ Global signal retained as reference\")\nprint(\"✓ Speed and flow correlations measured\")\nprint(\"✓ Congestion separation measured\")\nprint(\"✓ Local coverage measured\")\n\nprint(\"\\nCELL 16D COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-08T18:20:10.882849Z","iopub.execute_input":"2026-10-08T18:20:10.883187Z","iopub.status.idle":"2026-10-08T18:20:36.9265Z","shell.execute_reply.started":"2026-10-08T18:20:10.88316Z","shell.execute_reply":"2026-10-08T18:20:36.925541Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nCELL 16D — LOCAL VS GLOBAL CROSS-LINK SIGNAL\n================================================================================\n\nTarget-observation pairs: 472094\n\n================================================================================\nLAG-1 MISSING DATASET\n================================================================================\nRows: 2710\n\n================================================================================\nSPEED CORRELATION BY SPATIAL RADIUS\n================================================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  radius_km  speed_mean_correlation  valid_targets\n0       0.5                0.838903           2169\n1       1.0                0.848786           2608\n2       2.0                0.800963           2701\n3       5.0                0.575651           2710\n4    GLOBAL                0.386475           2710","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middl