amples\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"RECOVERED ADJACENCY EXAMPLES\")\nprint(\"=\" * 80)\n\nexample_rows = []\n\nfor link in sorted(observed_links):\n\n    example_rows.append({\n        \"link\": link,\n        \"upstream\": upstream_map.get(\n            link, []\n        ),\n        \"downstream\": downstream_map.get(\n            link, []\n        )\n    })\n\nprint(\n    pd.DataFrame(example_rows)\n    .head(30)\n    .to_string(index=False)\n)\n\n\n# ------------------------------------------------------------\n# 8. Direct vs recovered adjacency\n# ------------------------------------------------------------\n\ndirect_upstream = 0\ndirect_downstream = 0\n\nfor link in observed_links:\n\n    if any(\n        x in observed_links\n        for x in incoming_refs[link]\n    ):\n        direct_upstream += 1\n\n    if any(\n        x in observed_links\n        for x in outgoing_refs[link]\n    ):\n        direct_downstream += 1\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DIRECT VS RECOVERED\")\nprint(\"=\" * 80)\n\nprint(\n    \"Direct upstream coverage:\",\n    direct_upstream\n)\n\nprint(\n    \"Recovered upstream coverage:\",\n    len(upstream_map)\n)\n\nprint(\n    \"Direct downstream coverage:\",\n    direct_downstream\n)\n\nprint(\n    \"Recovered downstream coverage:\",\n    len(downstream_map)\n)\n\n\nprint(\"\\nCELL 04 TOPOLOGY RECOVERY COMPLETE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T18:51:41.772278Z","iopub.execute_input":"2026-10-07T18:51:41.772518Z","iopub.status.idle":"2026-10-07T18:51:41.807961Z","shell.execute_reply.started":"2026-10-07T18:51:41.7725Z","shell.execute_reply":"2026-10-07T18:51:41.807382Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 05 — PHYSICAL FEATURE SIGNAL\n# ============================================================\n\nimport panda