\n    \"kaggle_public\"\n)\n\nPANEL = \"D7_I405_S\"\n\nCORRIDOR_DIR = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n)\n\nMASKED_ROOT = (\n    CORRIDOR_DIR\n    / \"train\"\n    / \"mainline_states_masked\"\n)\n\nTRUTH_ROOT = (\n    CORRIDOR_DIR\n    / \"train\"\n    / \"mainline_states\"\n)\n\nLINKS_PATH = (\n    CORRIDOR_DIR\n    / \"network\"\n    / \"links.csv\"\n)\n\n\n# ------------------------------------------------------------\n# 2. Stage 2 chronological split\n# ------------------------------------------------------------\n\nTRAIN_START = pd.Timestamp(\n    \"2030-06-01\",\n    tz=\"UTC\"\n)\n\nTRAIN_END = pd.Timestamp(\n    \"2031-01-28\",\n    tz=\"UTC\"\n)\n\nVALID_START = pd.Timestamp(\n    \"2031-01-29\",\n    tz=\"UTC\"\n)\n\nVALID_END = pd.Timestamp(\n    \"2031-02-28\",\n    tz=\"UTC\"\n)\n\n\n# ------------------------------------------------------------\n# 3. Feature definitions\n# ------------------------------------------------------------\n\nTEMPORAL_FEATURES = [\n    \"speed_lag_1\",\n    \"flow_lag_1\",\n    \"speed_lag_2\",\n    \"flow_lag_2\",\n    \"speed_lag_3\",\n    \"flow_lag_3\",\n    \"speed_lag_6\",\n    \"flow_lag_6\",\n    \"speed_lag_12\",\n    \"flow_lag_12\",\n]\n\nAVAILABILITY_FEATURES = [\n    \"speed_lag_1_available\",\n    \"flow_lag_1_available\",\n    \"speed_lag_2_available\",\n    \"flow_lag_2_available\",\n    \"speed_lag_3_available\",\n    \"flow_lag_3_available\",\n    \"speed_lag_6_available\",\n    \"flow_lag_6_available\",\n    \"speed_lag_12_available\",\n    \"flow_lag_12_available\",\n]\n\nPHYSICAL_FEATURES = [\n    \"length_km\",\n    \"lanes\",\n    \"free_speed_kmh\",\n    \"capacity_vph\",\n    \"capacity_per_lane\",\n]\n\n\n# ------------------------------------------------------------\n# 4. Load physical metadata\n# ------------------------------------------------------------\n\nlinks = pd.read_csv(\n    LINKS_PATH\n)\n\nlinks[\"link_id\"] = (\n    links[\"link_id\"].astype(str)\n)\n\nlinks = links[\n    [\n        \"link_id\",\n        \"length_km\",\n        \"lanes\",\n        \"free_speed_kmh\",\n        \"capacity_vph\",\n    ]\n].copy()\n\nlinks[\"capacity_per_lane\"] = (\n    links[\"capacity_vph\"]\n    / links[\"lanes\"]\n)\n\n\n# ------------------------------------------------------------\n# 5. Discover ALL masked files\n# ------------------------------------------------------------\n\nprint(\"=\" * 80)\nprint(\"DISCOVERING MASKED FILES\")\nprint(\"=\" * 80)\n\nmasked_file_records = []\n\nfor regime_dir in sorted(\n    MASKED_ROOT.glob(\"mask_regime=*\")\n):\n\n    regime = regime_dir.name.replace(\n        \"mask_regime=\",\n        \"\"\n    )\n\n    for path in sorted(\n        regime_dir.glob(\"*.parquet\")\n    ):\n\n        # Read only timestamp to determine actual date.\n        head = pd.read_parquet(\n            path,\n            columns=[\"timestamp\"]\n        )\n\n        timestamps = pd.to_datetime(\n            head[\"timestamp\"]\n        )\n\n        unique_dates = (\n            timestamps\n            .dt.normalize()\n            .unique()\n        )\n\n        assert len(unique_dates) == 1, (\n            f\"Multiple dates found in: {path}\"\n        )\n\n        date = pd.Timestamp(\n            unique_dates[0]\n        )\n\n        masked_file_records.append({\n            \"date\": date,\n            \"regime\": regime,\n            \"path\": path,\n        })\n\n\nmasked_inventory = pd.DataFrame(\n    masked_file_records\n)\n\n\n# ------------------------------------------------------------\n# 6. Discover truth files\n# ------------------------------------------------------------\n\nprint(\"=\" * 80)\nprint(\"DISCOVERING TRUTH FILES\")\nprint(\"=\" * 80)\n\ntruth_files = sorted(\n    TRUTH_ROOT.glob(\n        \"**/*.parquet\"\n    )\n)\n\ntruth_file_records = []\n\nfor path in truth_files:\n\n    head = pd.read_parquet(\n        path,\n        columns=[\"timestamp\"]\n    )\n\n    timestamps = pd.to_datetime(\n        head[\"timestamp\"]\n    )\n\n    unique_dates = (\n        timestamps\n        .dt.normalize()\n        .unique()\n    )\n\n    assert len(unique_dates) == 1, (\n        f\"Multiple dates found in: {path}\"\n    )\n\n    date = pd.Timestamp(\n        unique_dates[0]\n    )\n\n    truth_file_records.append({\n        \"date\": date,\n        \"path\": path,\n    })\n\n\ntruth_inventory = pd.DataFrame(\n    truth_file_records\n)\n\n\n# ------------------------------------------------------------\n# 7. Inventory summary\n# ------------------------------------------------------------\n\nprint(\n    \"Total masked files:\",\n    len(masked_inventory)\n)\n\nprint(\n    \"Total truth files:\",\n    len(truth_inventory)\n)\n\nprint(\"\\nMasked files by regime:\")\n\nprint(\n    masked_inventory[\n        \"regime\"\n    ].value_counts()\n    .sort_index()\n)\n\n\n# ------------------------------------------------------------\n# 8. Build date ranges\n# ------------------------------------------------------------\n\ntrain_dates = pd.date_range(\n    TRAIN_START.normalize(),\n    TRAIN_END.normalize(),\n    freq=\"D\"\n)\n\nvalid_dates = pd.date_range(\n    VALID_START.normalize(),\n    VALID_END.normalize(),\n    freq=\"D\"\n)\n\ntrain_date_set = set(\n    train_dates\n)\n\nvalid_date_set = set(\n    valid_dates\n)\n\n\n# ------------------------------------------------------------\n# 9. Determine actual masked coverage\n# ------------------------------------------------------------\n\nmasked_inventory[\"split\"] = np.where(\n    masked_inventory[\"date\"].isin(\n        train_date_set\n    ),\n    \"train\",\n    np.where(\n        masked_inventory[\"date\"].isin(\n            valid_date_set\n        ),\n        \"validation\",\n        \"outside\"\n    )\n)\n\ncoverage = (\n    masked_inventory[\n        masked_inventory[\"split\"] != \"outside\"\n    ]\n    .groupby(\n        [\"split\", \"regime\"]\n    )\n    .agg(\n        days=(\"date\", \"nunique\"),\n        files=(\"path\", \"count\")\n    )\n    .reset_index()\n)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"ACTUAL MASK COVERAGE\")\nprint(\"=\" * 80)\n\ndisplay(coverage)\n\n\n# ------------------------------------------------------------\n# 10. Check truth coverage\n# ------------------------------------------------------------\n\ntruth_dates = set(\n    truth_inventory[\"date\"]\n)\n\nmissing_truth_train = [\n    d for d in train_dates\n    if d not in truth_dates\n]\n\nmissing_truth_valid = [\n    d for d in valid_dates\n    if d not in truth_dates\n]\n\nprint(\n    \"\\nMissing train truth dates:\",\n    len(missing_truth_train)\n)\n\nprint(\n    \"Missing validation truth dates:\",\n    len(missing_truth_valid)\n)\n\nassert not missing_truth_train\nassert not missing_truth_valid\n\nprint(\n    \"Truth coverage: ✓\"\n)\n\n\n# ------------------------------------------------------------\n# 11. Build lookup dictionaries\n# ------------------------------------------------------------\n\ntruth_file_map = dict(\n    zip(\n        truth_inventory[\"date\"],\n        truth_inventory[\"path\"]\n    )\n)\n\nmasked_records = (\n    masked_inventory[\n        masked_inventory[\"split\"].isin(\n            [\"train\", \"validation\"]\n        )\n    ]\n    .sort_values(\n        [\"date\", \"regime\"]\n    )\n)\n\n\n# ------------------------------------------------------------\n# 12. Feature construction\n# ------------------------------------------------------------\n\ndef build_masked_day_features(\n    date,\n    regime,\n    masked_path,\n    truth_path,\n    links\n):\n    \"\"\"\n    Construct model features for one actual\n    competition masked file.\n\n    Traffic features:\n        masked file only.\n\n    Physical features:\n        static network metadata.\n\n    Ground truth:\n        used only to construct targets.\n    \"\"\"\n\n    masked = pd.read_parquet(\n        masked_path\n    )\n\n    truth = pd.read_parquet(\n        truth_path\n    )\n\n    masked[\"timestamp\"] = pd.to_datetime(\n        masked[\"timestamp\"]\n    )\n\n    truth[\"timestamp\"] = pd.to_datetime(\n        truth[\"timestamp\"]\n    )\n\n    masked[\"link_id\"] = (\n        masked[\"link_id\"].astype(str)\n    )\n\n    truth[\"link_id\"] = (\n        truth[\"link_id\"].astype(str)\n    )\n\n    KEYS_DAY = [\n        \"timestamp\",\n        \"station_id\",\n        \"link_id\"\n    ]\n\n    # --------------------------------------------------------\n    # Temporal features\n    # --------------------------------------------------------\n\n    masked = masked.sort_values(\n        [\"link_id\", \"timestamp\"]\n    ).reset_index(drop=True)\n\n    grouped = masked.groupby(\n        \"link_id\",\n        sort=False\n    )\n\n    for lag in [1, 2, 3, 6, 12]:\n\n        masked[\n            f\"speed_lag_{lag}\"\n        ] = grouped[\n            \"speed_kmh\"\n        ].shift(lag)\n\n        masked[\n            f\"flow_lag_{lag}\"\n        ] = grouped[\n            \"flow_vph\"\n        ].shift(lag)\n\n        masked[\n            f\"speed_lag_{lag}_available\"\n        ] = (\n            masked[\n                f\"speed_lag_{lag}\"\n            ]\n            .notna()\n            .astype(\"int8\")\n        )\n\n        masked[\n            f\"flow_lag_{lag}_available\"\n        ] = (\n            masked[\n                f\"flow_lag_{lag}\"\n            ]\n            .notna()\n            .astype(\"int8\")\n        )\n\n    # --------------------------------------------------------\n    # Physical features\n    # --------------------------------------------------------\n\n    masked = masked.merge(\n        links,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\"\n    )\n\n    # --------------------------------------------------------\n    # Ground truth\n    # --------------------------------------------------------\n\n    truth_targets = truth[\n        KEYS_DAY\n        + [\n            \"speed_kmh\",\n            \"flow_vph\"\n        ]\n    ].rename(\n        columns={\n            \"speed_kmh\": \"target_speed\",\n            \"flow_vph\": \"target_flow\"\n        }\n    )\n\n    result = masked.merge(\n        truth_targets,\n        on=KEYS_DAY,\n        how=\"left\"\n    )\n\n    # --------------------------------------------------------\n    # Actual masked targets\n    # --------------------------------------------------------\n\n    target_mask = (\n        result[\"speed_kmh\"].isna()\n        & result[\"flow_vph\"].isna()\n        & result[\"target_speed\"].notna()\n        & result[\"target_flow\"].notna()\n    )\n\n    result = result.loc[\n        target_mask\n    ].copy()\n\n    # --------------------------------------------------------\n    # Add regime as metadata\n    # --------------------------------------------------------\n\n    result[\"mask_regime\"] = regime\n\n    # --------------------------------------------------------\n    # Final columns\n    # --------------------------------------------------------\n\n    feature_cols = (\n        TEMPORAL_FEATURES\n        + AVAILABILITY_FEATURES\n        + PHYSICAL_FEATURES\n    )\n\n    result = result[\n        KEYS_DAY\n        + [\"mask_regime\"]\n        + feature_cols\n        + [\n            \"target_speed\",\n            \"target_flow\"\n        ]\n    ]\n\n    return result\n\n\n# ------------------------------------------------------------\n# 13. Build training data\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BUILDING TRAINING DATA\")\nprint(\"=\" * 80)\n\ntrain_records = masked_records[\n    masked_records[\"split\"] == \"train\"\n]\n\ntrain_parts = []\n\nfor i, row in enumerate(\n    train_records.itertuples(index=False),\n    start=1\n):\n\n    day_df = build_masked_day_features(\n        row.date,\n        row.regime,\n        row.path,\n        truth_file_map[row.date],\n        links\n    )\n\n    train_parts.append(\n        day_df\n    )\n\n    if (\n        i % 20 == 0\n        or i == len(train_records)\n    ):\n\n        print(\n            f\"Train masked files: \"\n            f\"{i}/{len(train_records)} | \"\n            f\"rows: \"\n            f\"{sum(len(x) for x in train_parts):,}\"\n        )\n\n\ntrain_multi = pd.concat(\n    train_parts,\n    ignore_index=True\n)\n\ndel train_parts\n\n\n# ------------------------------------------------------------\n# 14. Build validation data\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"BUILDING VALIDATION DATA\")\nprint(\"=\" * 80)\n\nvalid_records = masked_records[\n    masked_records[\"split\"] == \"validation\"\n]\n\nvalid_parts = []\n\nfor i, row in enumerate(\n    valid_records.itertuples(index=False),\n    start=1\n):\n\n    day_df = build_masked_day_features(\n        row.date,\n        row.regime,\n        row.path,\n        truth_file_map[row.date],\n        links\n    )\n\n    valid_parts.append(\n        day_df\n    )\n\n    if (\n        i % 20 == 0\n        or i == len(valid_records)\n    ):\n\n        print(\n            f\"Validation masked files: \"\n            f\"{i}/{len(valid_records)} | \"\n            f\"rows: \"\n            f\"{sum(len(x) for x in valid_parts):,}\"\n        )\n\n\nvalid_multi = pd.concat(\n    valid_parts,\n    ignore_index=True\n)\n\ndel valid_parts\n\n\n# ------------------------------------------------------------\n# 15. Final feature matrices\n# ------------------------------------------------------------\n\nABLATION_FEATURES = (\n    TEMPORAL_FEATURES\n    + AVAILABILITY_FEATURES\n    + PHYSICAL_FEATURES\n)\n\nX_train_multi = train_multi[\n    ABLATION_FEATURES\n].copy()\n\ny_train_multi = train_multi[\n    [\n        \"target_speed\",\n        \"target_flow\"\n    ]\n].copy()\n\nX_valid_multi = valid_multi[\n    ABLATION_FEATURES\n].copy()\n\ny_valid_multi = valid_multi[\n    [\n        \"target_speed\",\n        \"target_flow\"\n    ]\n].copy()\n\n\n# -----