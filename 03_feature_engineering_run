\n","================================================================================\n","✓ Timestamp dtypes normalized\n","✓ Target lag-1 availability recovered\n","✓ Lag-1 missing subset isolated\n","✓ Cross-link signal tested on difficult subset\n","✓ Congested vs free-flow separation measured\n","✓ No target truth used as a feature\n","\n","CELL 16C COMPLETE\n"]}],"source":["# ============================================================\n","# CELL 16C — CROSS-LINK SIGNAL UNDER MISSING TARGET HISTORY\n","# ============================================================\n","\n","print(\"=\" * 80)\n","print(\"CELL 16C — CROSS-LINK SIGNAL WHEN TARGET LAG-1 IS MISSING\")\n","print(\"=\" * 80)\n","\n","\n","# ------------------------------------------------------------\n","# 1. Normalize timestamp dtype in cross_signal\n","# ------------------------------------------------------------\n","\n","cross_signal[\"timestamp\"] = pd.to_datetime(\n","    cross_signal[\"timestamp\"],\n","    utc=True\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2. Recover target-link temporal history from masked data\n","# ------------------------------------------------------------\n","\n","masked_hist = masked[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","].copy()\n","\n","masked_hist[\"timestamp\"] = pd.to_datetime(\n","    masked_hist[\"timestamp\"],\n","    utc=True\n",")\n","\n","masked_hist = masked_hist.sort_values(\n","    [\"link_id\", \"timestamp\"]\n",")\n","\n","\n","# Previous timestep = lag 1\n","masked_hist[\"speed_lag_1\"] = (\n","    masked_hist\n","    .groupby(\"link_id\")[\"speed_kmh\"]\n","    .shift(1)\n",")\n","\n","masked_hist[\"flow_lag_1\"] = (\n","    masked_hist\n","    .groupby(\"link_id\")[\"flow_vph\"]\n","    .shift(1)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3. Merge lag-1 information\n","# ------------------------------------------------------------\n","\n","cross_signal = cross_signal.merge(\n","    masked_hist[\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"speed_lag_1\",\n","            \"flow_lag_1\",\n","        ]\n","    ],\n","    on=[\"timestamp\", \"link_id\"],\n","    how=\"left\",\n","    validate=\"one_to_one\",\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Identify missing target lag-1\n","# ------------------------------------------------------------\n","\n","cross_signal[\"lag1_speed_missing\"] = (\n","    cross_signal[\"speed_lag_1\"].isna()\n",")\n","\n","cross_signal[\"lag1_flow_missing\"] = (\n","    cross_signal[\"flow_lag_1\"].isna()\n",")\n","\n","\n","analysis = cross_signal.loc[\n","    cross_signal[\"lag1_speed_missing\"]\n","].copy()\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"LAG-1 MISSING SUBSET\")\n","print(\"=\" * 80)\n","\n","print(\"Total targets:\", len(cross_signal))\n","print(\"Lag-1 missing:\", len(analysis))\n","print(\n","    \"Lag-1 missing rate:\",\n","    len(analysis) / len(cross_signal)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Define target traffic state\n","# ------------------------------------------------------------\n","\n","analysis[\"traffic_state\"] = pd.cut(\n","    analysis[\"speed_kmh_truth\"],\n","    bins=[\n","        -np.inf,\n","        70,\n","        100,\n","        np.inf,\n","    ],\n","    labels=[\n","        \"congested\",\n","        \"moderate\",\n","        \"free_flow\",\n","    ],\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Compare cross-link signals by traffic state\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CROSS-LINK SIGNAL — LAG-1 MISSING\")\n","print(\"=\" * 80)\n","\n","state_summary = (\n","    analysis\n"