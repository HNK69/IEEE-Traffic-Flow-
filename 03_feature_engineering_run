Jobs recorded: 610\n","Failures: 0\n","Output folder: /kaggle/working/trafficflowbench_task1_v2\n","No failures recorded.\n"]}],"source":["from pathlib import Path\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import warnings\n","\n","# ============================================================\n","# 1. VERIFIED CONFIGURATION\n","# ============================================================\n","ROOT = Path(\n","    \"/kaggle/input/competitions/\"\n","    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n",")\n","MODEL_DIR = Path(\n","    \"/kaggle/input/datasets/krupaalhn/trafficflowbench-spatial-models\"\n",")\n","OUT = Path(\"/kaggle/working/trafficflowbench_task1_v2\")\n","OUT.mkdir(parents=True, exist_ok=True)\n","\n","PANELS = [\n","    \"D12_I405_N\", \"D12_I405_S\",\n","    \"D12_I5_N\", \"D12_I5_S\",\n","    \"D7_I10_E\", \"D7_I10_W\",\n","    \"D7_I210_E\", \"D7_I210_W\",\n","    \"D7_I405_N\", \"D7_I405_S\",\n","]\n","SPLITS = [\"validation\", \"private\"]\n","\n","FEATURES = [\n","    \"length_km\", \"lanes\", \"free_speed_kmh\",\n","    \"capacity_vph\", \"capacity_per_lane\",\n","    \"speed_lag_1\", \"flow_lag_1\",\n","    \"speed_lag_2\", \"flow_lag_2\",\n","    \"speed_lag_3\", \"flow_lag_3\",\n","    \"speed_lag_6\", \"flow_lag_6\",\n","    \"speed_lag_12\", \"flow_lag_12\",\n","    \"local_1km_speed_mean\", \"local_1km_speed_q10\",\n","    \"local_1km_speed_q25\", \"local_1km_flow_mean\",\n","]\n","JOIN_KEYS = [\n","    \"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n","]\n","PHYSICAL = [\n","    \"length_km\", \"lanes\", \"free_speed_kmh\",\n","    \"capacity_vph\", \"capacity_per_lane\",\n","]\n","SPATIAL = [\n","    \"local_1km_speed_mean\",\n","    \"local_1km_speed_q10\",\n","    \"local_1km_speed_q25\",\n","    \"local_1km_flow_mean\",\n","]\n","\n","speed_model = joblib.load(\n","    MODEL_DIR / \"spatial19_speed_kmh_target.joblib\"\n",")\n","flow_model = joblib.load(\n","    MODEL_DIR / \"spatial19_flow_vph_target.joblib\"\n",")\n","\n","assert speed_model.n_features_in_ == 19\n","assert flow_model.n_features_in_ == 19\n","\n","print(\"Loaded both 19-feature models.\")\n","\n","# ============================================================\n","# 2. INDEX THE ACTUAL MASKED FILES\n","#    Use actual file dates; do not assume daily files exist.\n","# ============================================================\n","def index_masked_files(panel):\n","    indexed = {}\n","\n","    for split in [\"train\", \"validation\", \"private\"]:\n","        folder = (\n","            ROOT / \"corridors\" / panel / split\n","            / \"mainline_states_masked\"\n","        )\n","        if not folder.exists():\n","            continue\n","\n","        for path in folder.rglob(\"synthetic_mainline_*.parquet\"):\n","            token = path.stem.replace(\"synthetic_mainline_\", \"\")\n","            date = pd.to_datetime(\n","                token, format=\"%Y_%m_%d\", errors=\"coerce\"\n","            )\n","            if pd.isna(date):\n","                continue\n","\n","            key = date.strftime(\"%Y-%m-%d\")\n","            if key in indexed:\n","                raise RuntimeError(\n","                    f\"Multiple masked files for {panel} on {key}: \"\n","                    f\"{indexed[key]} and {path}\"\n","                )\n","            indexed[key] = path\n","\n","    return indexed\n","\n","\n","# ============================================================\n","# 3. SPATIAL FEATURES\n","#    Exclude self. Require BOTH speed and flow, matching the\n","#    original Stage 3 feature-building rule.\n","#    No nanmean/nanquantile calls on empty arrays.\n","# ============================================================\n","def add_spatial_features(day):\n","    day = day.copy()\n","\n","    for col in SPATIAL:\n","        day[col] = np.nan\n","\n","    for _, group in day.groupby(\"timestamp\", sort=False):\n","        idx = group.index.to_numpy()\n","        mileposts = group[\"milepost\"].to_numpy(dtype=float)\n","        link_ids = group[\"link_id\"].to_numpy()\n","        speeds = group[\"speed_kmh\"].to_numpy(dtype=float)\n","        flows = group[\"flow_vph\"].to_numpy(dtype=float)\n","\n","        # Same 1-milepost-unit neighborhood rule as the source.\n","        distance = np.abs(mileposts[:, None] - mileposts[None, :])\n","        neighbor_mask = (\n","            (distance <= 1.0)\n","            & (distance > 0.0)\n","            & (link_ids[:, None] != link_ids[None, :])\n","        )\n","\n","        # Original rule: neighbor must have both valid speed and flow.\n","        valid_neighbor = np.isfinite(speeds) & np.isfinite(flows)\n","\n","        for i, row_idx in enumerate(idx):\n","            selected = neighbor_mask[i] & valid_neighbor\n","            if not selected.any():\n","                continue\n","\n","            neighbor_speeds = speeds[selected]\n","            neighbor_flows = flows[selected]\n","\n","            day.at[row_idx, \"local_1km_speed_mean\"] = (\n","                neighbor_speeds.mean()\n","            )\n","            day.at[row_idx, \"local_1km_speed_q10\"] = (\n","                np.quantile(neighbor_speeds, 0.10)\n","            )\n","            day.at[row_idx, \"local_1km_speed_q25\"] = (\n","                np.quantile(neighbor_speeds, 0.25)\n","            )\n","            day.at[row_idx, \"local_1km_flow_mean\"] = (\n","                neighbor_flows.mean()\n","            )\n","\n","    return day\n","\n","\n","# ============================================================\n","# 4. LOAD TARGET TABLES ONCE\n","# ============================================================\n","target_tables = {}\n","\n","for panel in PANELS:\n","    for split in SPLITS:\n","        path = (\n","            ROOT / \"task1\" / panel / split\n","            / \"sample_submission_state.csv\"\n","        )\n","        if not path.exists():\n","            raise FileNotFoundError(path)\n","\n","        targets = pd.read_csv(path)\n","        targets[\"timestamp\"] = pd.to_datetime(\n","            targets[\"timestamp\"], utc=True\n","        )\n","        targets[\"station_id\"] = targets[\"station_id\"].astype(str)\n","        targets[\"link_id\"] = targets[\"link_id\"].astype(str)\n","        targets[\"mask_regime\"] = targets[\"mask_regime\"].astype(str)\n","\n","        target_tables[(panel, split)] = targets\n","\n","print(\"Loaded all 20 Task 1 target tables.\")\n","\n","# ============================================================\n","# 5. PROCESS ONE PANEL / SPLIT / DATE\n","# ============================================================\n","def predict_one_date(panel, split, date, file_index, links):\n","    output_path = OUT / split / panel / f\"{date}.csv\"\n","    output_path.parent.mkdir(parents=True, exist_ok=True)\n","\n","    if output_path.exists():\n","        print(f\"  SKIP existing: {date}\")\n","        return \"skipped\"\n","\n","    if date not in file_index:\n","        raise FileNotFoundError(\n","            f\"No masked parquet for target date {date}, panel={panel}\"\n","        )\n","\n","    current_path = file_index[date]\n","\n","    # Cell 9 uses the most recent earlier available file for lag history.\n","    previous_dates = sorted(d for d in file_index if d < date)\n","    if not previous_dates:\n","        raise RuntimeError(\n","            f\"No earlier masked file available for {panel}, {date}\"\n","        )\n","\n","    previous_date = previous_dates[-1]\n","    previous_path = file_index[previous_date]\n","\n","    previous = pd.read_parquet(previous_path)\n","    current = pd.read_parquet(current_path)\n","\n","    data = pd.concat([previous, current], ignore_index=True)\n","    data[\"timestamp\"] = pd.to_datetime(data[\"timestamp\"], utc=True)\n","    data[\"station_id\"] = data[\"station_id\"].astype(str)\n","    data[\"link_id\"] = data[\"link_id\"].astype(str)\n","    data[\"mask_regime\"] = data[\"mask_regime\"].astype(str)\n","\n","    data = data.sort_values(\n","        [\"station_id\", \"timestamp\"]\n","    ).reset_index(drop=True)\n","\n","    data = data.merge(\n","        links,\n","        on=\"link_id\",\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","    )\n","\n","    # Preserve Cell 9's row-based lag definition.\n","    for lag in [1, 2, 3, 6, 12]:\n","        data[f\"speed_lag_{lag}\"] = (\n","            data.groupby(\"station_id\", sort=False)[\"speed_kmh\"]\n","            .shift(lag)\n","        )\n","        data[f\"flow_lag_{lag}\"] = (\n","            data.groupby(\"station_id\", sort=False)[\"flow_vph\"]\n","            .shift(lag)\n","        )\n","\n","    today = data[data[\"date\"].astype(str).eq(date)].copy()\n","    if today.empty:\n","        raise RuntimeError(\n","            f\"No rows in masked parquet for {panel}, {date}\"\n","        )\n","\n","    today = add_spatial_features(today)\n","    today[\"panel\"] = panel\n","\n","    targets = target_tables[(panel, split)]\n","    targets_day = targets[\n","        targets[\"timestamp\"].dt.strftime(\"%Y-%m-%d\").eq(date)\n","    ].copy()\n","\n","    if targets_day.empty:\n","        return \"no_targets\"\n","\n","    features = targets_day[JOIN_KEYS].merge(\n","        today[JOIN_KEYS + FEATURES],\n","        on=JOIN_KEYS,\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","\n","    if len(features) != len(targets_day):\n","        raise RuntimeError(\"Feature join changed the target row count.\")\n","\n","    if features[PHYSICAL].isna().any().any():\n","        raise RuntimeError(\n","            f\"Missing physical features for {panel}, {date}\"\n","        )\n","\n","    X = features[FEATURES]\n","    features[\"pred_speed_kmh\"] = np.clip(\n","        speed_model.predict(X), 0, 150\n","    )\n","    features[\"pred_flow_vph\"] = np.clip(\n","        flow_model.predict(X), 0, None\n","    )\n","\n","    # Save atomically so interrupted writes don't look complete.\n","    tmp_path = output_path.with_suffix(\".tmp\")\n","    features[\n","        JOIN_KEYS + FEATURES\n","        + [\"pred_speed_kmh\", \"pred_flow_vph\"]\n","    ].to_csv(tmp_path, index=False)\n","    tmp_path.replace(output_path)\n","\n","    complete_pct = X.notna().all(axis=1).mean() * 100\n","    print(\n","        f\"  SAVED {panel} | {split} | {date} | \"\n","        f\"rows={len(features):,} | \"\n","        f\"all-19-features-complete={complete_pct:.2f}%\"\n","    )\n","\n","    return \"saved\"\n","\n","\n","# ============================================================\n","# 6. RUN ALL TARGET DATES WITH CHECKPOINTS\n","# ============================================================\n","summary = []\n","errors = []\n","\n","for panel in PANELS:\n","    print(f\"\\n{'=' * 72}\\nPANEL: {panel}\\n{'=' * 72}\")\n","\n","    file_index = index_masked_files(panel)\n","\n","    links_path = ROOT / \"corridors\" / panel / \"network\" / \"links.csv\"\n","    links = pd.read_csv(links_path)\n","    links[\"link_id\"] = links[\"link_id\"].astype(str)\n","    links[\"capacity_per_lane\"] = (\n","        links[\"capacity_vph\"] / links[\"lanes\"]\n","    )\n","    links = links[\n","        [\n","            \"link_id\", \"length_km\", \"lanes\",\n","            \"free_speed_kmh\", \"capacity_vph\",\n","            \"capacity_per_lane\",\n","        ]\n","    ]\n","\n","    for split in SPLITS:\n","        targets = target_tables[(panel, split)]\n","        dates = sorted(\n","            targets[\"timestamp\"].dt.strftime(\"%Y-%m-%d\").unique()\n","        )\n","\n","        print(f\"\\n{split.upper()}: {len(dates)} target dates\")\n","\n","        for date in dates:\n","            try:\n","                status = predict_one_date(\n","                    panel, split, date, file_index, links\n","                )\n","                summary.append(\n","                    {\n","                        \"panel\": panel,\n","                        \"split\": split,\n","                        \"date\": date,\n","                        \"status\": status,\n","                    }\n","                )\n","            except Exception as exc:\n","                errors.append(\n","                    {\n","                        \"panel\": panel,\n","                        \"split\": split,\n","                        \"date\": date,\n","                        \"error\": repr(exc),\n","                    }\n","                )\n","                print(\n","                    f\"  FAILED {panel} | {split} | {date}: {exc}\"\n","                )\n","\n","    # Save progress after each panel.\n","    pd.DataFrame(summary).to_csv(\n","        OUT / \"task1_progress.csv\", index=False\n","    )\n","    pd.DataFrame(errors).to_csv(\n","        OUT / \"task1_errors.csv\", index=False\n","    )\n","\n","print(\"\\n\" + \"=\" * 72)\n","print(\"TASK 1 INFERENCE FINISHED\")\n","print(\"=\" * 72)\n","print(\"Jobs recorded:\", len(summary))\n","print(\"Failures:\", len(errors))\n","print(\"Output folder:\", OUT)\n","\n","if errors:\n","    print(\"\\nFailures:\")\n","    print(pd.DataFrame(errors).to_string(index=False))\n","else:\n","    print(\"No failures recorded.\")"]},{"cell_type":"code","execution_count":30,"id":"a51b4ef7","metadata":{"execution":{"iopub.execute_input":"2026-10-10T00:19:36.381285Z","iopub.status.busy":"2026-10-10T00:19:36.38071Z","iopub.status.idle":"2026-10-10T00:23:14.66171Z","shell.execute_reply":"2026-10-10T00:23:14.660293Z"},"papermill":{"duration":218.374498,"end_time":"2026-10-10T00:23:14.719153+00:00","exception":false,"start_time":"2026-10-10T00:19:36.344655+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Daily files: 610\n","Combined rows: 6,735,795\n","Panels: 10\n","Missing predictions:\n","pred_speed_kmh    0\n","pred_flow_vph     0\n","dtype: int64\n","Infinite predictions:\n","pred_speed_kmh 