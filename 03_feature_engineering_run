  valid_multi[\"timestamp\"].max()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 17. Regime distribution in model data\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"TARGET ROWS BY REGIME\")\n","print(\"=\" * 80)\n","\n","print(\n","    train_multi[\"mask_regime\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","print(\"\\nValidation:\")\n","\n","print(\n","    valid_multi[\"mask_regime\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 18. Leakage checks\n","# ------------------------------------------------------------\n","\n","assert (\n","    train_multi[\"timestamp\"].max()\n","    < valid_multi[\"timestamp\"].min()\n",")\n","\n","assert (\n","    \"target_speed\"\n","    not in X_train_multi.columns\n",")\n","\n","assert (\n","    \"target_flow\"\n","    not in X_train_multi.columns\n",")\n","\n","assert (\n","    \"target_speed\"\n","    not in X_valid_multi.columns\n",")\n","\n","assert (\n","    \"target_flow\"\n","    not in X_valid_multi.columns\n",")\n","\n","assert y_train_multi.notna().all().all()\n","assert y_valid_multi.notna().all().all()\n","\n","\n","# ------------------------------------------------------------\n","# 19. Physical feature availability\n","# ------------------------------------------------------------\n","\n","physical_availability = (\n","    X_train_multi[\n","        PHYSICAL_FEATURES\n","    ]\n","    .notna()\n","    .mean()\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"PHYSICAL FEATURE AVAILABILITY\")\n","print(\"=\" * 80)\n","\n","print(\n","    physical_availability\n",")\n","\n","\n","assert (\n","    physical_availability == 1.0\n",").all()\n","\n","\n","# ------------------------------------------------------------\n","# 20. Temporal feature availability\n","# --------------------------------------------