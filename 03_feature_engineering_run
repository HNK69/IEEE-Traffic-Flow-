=================================================\n","# CELL 09 — FIRST ABLATION MODEL\n","# ============================================================\n","\n","from xgboost import XGBRegressor\n","from sklearn.metrics import mean_squared_error\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ------------------------------------------------------------\n","# 1. Create chronological train/validation split\n","# ------------------------------------------------------------\n","# We must NOT randomly split individual rows.\n","# Traffic observations are time-dependent.\n","\n","unique_times = np.sort(\n","    feature_matrix[\"timestamp\"].unique()\n",")\n","\n","split_idx = int(\n","    len(unique_times) * 0.80\n",")\n","\n","train_times = unique_times[:split_idx]\n","valid_times = unique_times[split_idx:]\n","\n","train_mask = feature_matrix[\n","    \"timestamp\"\n","].isin(train_times)\n","\n","valid_mask = feature_matrix[\n","    \"timestamp\"\n","].isin(valid_times)\n","\n","print(\"=\" * 80)\n","print(\"CHRONOLOGICAL SPLIT\")\n","print(\"=\" * 80)\n","\n","print(\"Train timestamps:\", len(train_times))\n","print(\"Validation timestamps:\", len(valid_times))\n","\n","print(\n","    \"Train period:\",\n","    pd.Timestamp(train_times[0]),\n","    \"->\",\n","    pd.Timestamp(train_times[-1])\n",")\n","\n","print(\n","    \"Validation period:\",\n","    pd.Timestamp(valid_times[0]),\n","    \"->\",\n","    pd.Timestamp(valid_times[-1])\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2. Build train / validation targets\n","# ------------------------------------------------------------\n","\n","y_train = y.loc[train_mask].copy()\n","y_valid = y.loc[valid_mask].copy()\n","\n","print(\"\\nTrain rows:\", len(y_train))\n","print(\"Validation rows:\", len(y_valid))\n","\n","\n","# ------------------------------------------------------------\n","# 3. Evaluation function\n","# ------------------------------------------------------------\n","\n","def evaluate_predictions(\n","    y_true,\n","    pred_speed,\n","    pred_flow,\n","    lanes\n","):\n","    \"\"\"\n","    Calculate the local Task 1 scoring components.\n","\n","    Speed:\n","        RMSE normalized by 25 km/h.\n","\n","    Flow:\n","        RMSE per lane normalized by 600 vph/lane.\n","\n","    State:\n","        0.54 * speed score\n","        + 0.46 * flow score\n","    \"\"\"\n","\n","    speed_rmse = np.sqrt(\n","        mean_squared_error(\n","            y_true[\"target_speed\"],\n","            pred_speed\n","        )\n","    )\n","\n","    flow_per_lane_true = (\n","        y_true[\"target_flow\"].to_numpy()\n","        / lanes\n","    )\n","\n","    flow_per_lane_pred = (\n","        pred_flow\n","        / lanes\n","    )\n","\n","    flow_rmse_per_lane = np.sqrt(\n","        mean_squared_error(\n","            flow_per_lane_true,\n","            flow_per_lane_pred\n","        )\n","    )\n","\n","    speed_score = max(\n","        0.0,\n","        1.0 - speed_rmse / 25.0\n","    )\n","\n","    flow_score = max(\n","        0.0,\n","        1.0 - flow_rmse_per_lane / 600.0\n","    )\n","\n","    state_score = (\n","        0.54 * speed_score\n","        + 0.46 * flow_score\n","    )\n","\n","    return {\n","        \"speed_rmse\": speed_rmse,\n","        \"flow_rmse_per_lane\": flow_rmse_per_lane,\n","        \"speed_score\": speed_score,\n","        \"flow_score\": flow_score,\n","        \"state_score\": state_score,\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 4. Fixed model configuration\n","# ------------------------------------------------------------\n","\n","MODEL_PARAMS = {\n","    \"n_estimators\": 300,\n","    \"max_depth\": 8,\n","    \"learning_rate\": 0.05,\n","    \"subsample\": 0.8,\n","    \"colsample_bytree\": 0.8,\n","    \"objective\": \"reg:squarederror\",\n","    \"tree_method\": \"hist\",\n","    \"random_state\": 42,\n","    \"n_jobs\": -1,\n","}\n","\n","\n","# ------------------------------------------------------------\n","# 5. Run ablation experiments\n","# ------------------------------------------------------------\n","\n","results = []\n","\n","for config_name, features in ABLATION_CONFIGS.items():\n","\n","    print(\"\\n\" + \"=\" * 80)\n","    print(f\"RUNNING: {config_name}\")\n","    print(\"=\" * 80)\n","\n","    X_train = X.loc[\n","        train_mask,\n","        features\n","    ]\n","\n","    X_valid = X.loc[\n","        valid_mask,\n","        features\n","    ]\n","\n","    # Separate model for speed\n","    speed_model = XGBRegressor(\n","        **MODEL_PARAMS\n","    )\n","\n","    # Separate model for flow\n","    flow_model = XGBRegressor(\n","        **MODEL_PARAMS\n","    )\n","\n","    print(\n","        f\"Features: {len(features)} | \"\n","        f\"Train: {len(X_train)} | \"\n","        f\"Valid: {len(X_valid)}\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Train speed model\n","    # --------------------------------------------------------\n","\n","    speed_model.fit(\n","        X_train,\n","        y_train[\"target_speed\"],\n","        verbose=False\n","    )\n","\n","    pred_speed = speed_model.predict(\n","        X_valid\n","    )\n","\n","    # --------------------------------------------------------\n","    # Train flow model\n","    # --------------------------------------------------------\n","\n","    flow_model.fit(\n","        X_train,\n","        y_train[\"target_flow\"],\n","        verbose=False\n","    )\n","\n","    pred_flow = flow_model.predict(\n","        X_valid\n","    )\n","\n","    # --------------------------------------------------------\n","    # Evaluate\n","    # --------------------------------------------------------\n","\n","    lanes_valid = X.loc[\n","        valid_mask,\n","        \"lanes\"\n","    ].to_numpy()\n","\n","    metrics = evaluate_predictions(\n","        y_valid,\n","        pred_speed,\n","        pred_flow,\n","        lanes_valid\n","    )\n","\n","    metrics[\"configuration\"] = config_name\n","    metrics[\"n_features\"] = len(features)\n","\n","    results.append(metrics)\n","\n","    print(\n","        f\"Speed RMSE:          \"\n","        f\"{metrics['speed_rmse']:.4f}\"\n","    )\n","\n","    print(\n","        f\"Flow RMSE / lane:    \"\n","        f\"{metrics['flow_rmse_per_lane']:.4f}\"\n","    )\n","\n","    print(\n","        f\"Speed score:         \"\n","        f\"{metrics['speed_score']:.4f}\"\n","    )\n","\n","    print(\n","        f\"Flow score:          \"\n","        f\"{metrics['flow_score']:.4f}\"\n","    )\n","\n","    print(\n","        f\"State score:         \"\n","        f\"{metrics['state_score']:.4f}\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 6. Results table\n","# ------------------------------------------------------------\n","\n","results_df = (\n","    pd.DataFrame(results)\n","    .sort_values(\n","        \"state_score\",\n","        ascending=False\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"ABLATION RESULTS\")\n","print(\"=\" * 80)\n","\n","display(\n","    results_df[\n","        [\n","            \"configuration\",\n","            \"n_features\",\n","            \"speed_rmse\",\n","            \"flow_rmse_per_lane\",\n","            \"speed_score\",\n","            \"flow_score\",\n","            \"state_score\",\n","        ]\n","    ]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Checkpoint\n","# ------------------------------------------------------------\n","\n","assert len(results_df) == 5\n","assert results_df[\"state_score\"].notna().all()\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CELL 09 COMPLETE\")\n","print(\"=\" * 80)"]},{"cell_type":"code","execution_count":11,"id":"a79fdc2f","metadata":{"execution":{"iopub.execute_i