\n","1-KM SPATIAL FEATURE AVAILABILITY\n","======================================================================\n","local_1km_speed_mean          0.939022\n","local_1km_speed_q10           0.939022\n","local_1km_speed_q25           0.939022\n","local_1km_flow_mean           0.939022\n","\n","Saved: /kaggle/working/trafficflowbench_stage3/X_train_spatial_1km.parquet\n","Saved: /kaggle/working/trafficflowbench_stage3/X_valid_spatial_1km.parquet\n","\n","======================================================================\n","CELL 17C CHECKPOINT PASSED\n","======================================================================\n","Baseline features: 15\n","Spatial model features: 19\n","Physical source: network/links.csv\n","Temporal source: masked observations\n","Spatial source: same-timestamp masked neighbors\n","Labels: unmasked truth\n","Natural missing excluded: True\n","Self-inclusion: 0\n","Train rows: 1870910\n","Validation rows: 257027\n"]}],"source":["# ============================================================\n","# STAGE 3 — CELL 17C\n","# Multi-day 1-km spatial feature construction\n","#\n","# IMPORTANT:\n","#   Only artificially masked cells are Task 1 targets.\n","#   Natural missing cells are NOT targets.\n","#\n","# BASELINE:\n","#   5 physical + 10 temporal = 15 features\n","#\n","# SPATIAL MODEL:\n","#   baseline + 4 local 1-km features = 19 features\n","#\n","# FEATURE SOURCES\n","#   Physical -> network/links.csv\n","#   Temporal -> masked traffic observations only\n","#   Spatial  -> same-timestamp masked observations only\n","#   Targets  -> masked + unmasked truth alignment\n","#\n","# TRUTH IS NEVER USED TO CREATE FEATURES.\n","# ============================================================\n","\n","import pandas as pd\n","import numpy as np\n","from pathlib import Path\n","import gc\n","\n","# ============================================================\n","# 1. CONFIGURATION\n","# ============================================================\n","\n","PANEL = \"D7_I405_S\"\n","\n","TRAIN_START = pd.Timestamp(\n","    \"2030-06-01\",\n","    tz=\"UTC\"\n",")\n","\n","TRAIN_END = pd.Timestamp(\n","    \"2031-01-28\",\n","    tz=\"UTC\"\n",")\n","\n","VALID_START = pd.Timestamp(\n","    \"2031-01-29\",\n","    tz=\"UTC\"\n",")\n","\n","VALID_END = pd.Timestamp(\n","    \"2031-02-28\",\n","    tz=\"UTC\"\n",")\n","\n","ROOT = Path(\n","    \"/kaggle/input/competitions/\"\n","    \"2026-ieee-big-data-traffic-flow-bench/\"\n","    \"kaggle_public\"\n",")\n","\n","CORRIDOR_ROOT = ROOT / \"corridors\" / PANEL\n","\n","MASKED_ROOT = (\n","    CORRIDOR_ROOT\n","    / \"train\"\n","    / \"mainline_states_masked\"\n",")\n","\n","TRUTH_ROOT = (\n","    CORRIDOR_ROOT\n","    / \"train\"\n","    / \"mainline_states\"\n",")\n","\n","NETWORK_ROOT = (\n","    CORRIDOR_ROOT\n","    / \"network\"\n",")\n","\n","# ============================================================\n","# 2. FEATURE DEFINITIONS\n","# ============================================================\n","\n","TEMPORAL_FEATURES = [\n","    \"speed_lag_1\",\n","    \"flow_lag_1\",\n","    \"speed_lag_2\",\n","    \"flow_lag_2\",\n","    \"speed_lag_3\",\n","    \"flow_lag_3\",\n","    \"speed_lag_6\",\n","    \"flow_lag_6\",\n","    \"speed_lag_12\",\n","    \"flow_lag_12\",\n","]\n","\n","PHYSICAL_FEATURES = [\n","    \"length_km\",\n","    \"lanes\",\n","    \"free_speed_kmh\",\n","    \"capacity_vph\",\n","    \"capacity_per_lane\",\n","]\n","\n","SPATIAL_FEATURES = [\n","    \"local_1km_speed_mean\",\n","    \"local_1km_speed_q10\",\n","    \"local_1km_speed_q25\",\n","    \"local_1km_flow_mean\",\n","]\n","\n","BASELINE_FEATURES = (\n","    PHYSICAL_FEATURES\n","    + TEMPORAL_FEATURES\n",")\n","\n","SPATIAL_MODEL_FEATURES = (\n","    BASELINE_FEATURES\n","    + SPATIAL_FEATURES\n",")\n","\n","assert len(BASELINE_FEATURES) == 15\n","assert len(SPATIAL_MODEL_FEATURES) == 19\n","\n","# ============================================================\n","# 3. LOAD VERIFIED NETWORK METADATA\n","# ============================================================\n","\n","LINKS_PATH = NETWORK_ROOT / \"links.csv\"\n","\n","links = pd.read_csv(\n","    LINKS_PATH\n",")\n","\n","EXPECTED_LINK_COLUMNS = [\n","    \"link_id\",\n","    \"length_km\",\n","    \"lanes\",\n","    \"free_speed_kmh\",\n","    \"capacity_vph\",\n","]\n","\n","assert links.columns.tolist() == (\n","    EXPECTED_LINK_COLUMNS\n",")\n","\n","assert links[\"link_id\"].is_unique\n","assert len(links) == 109\n","\n","links[\"capacity_per_lane\"] = (\n","    links[\"capacity_vph\"]\n","    / links[\"lanes\"].replace(0, np.nan)\n",")\n","\n","assert (\n","    links[PHYSICAL_FEATURES]\n","    .notna()\n","    .all()\n","    .all()\n",")\n","\n","print(\n","    \"Network links:\",\n","    links.shape\n",")\n","\n","# ============================================================\n","# 4. BUILD 1-KM NEIGHBOR MAP\n","# ============================================================\n","\n","sample_files = []\n","\n","for regime_dir in sorted(\n","    MASKED_ROOT.glob(\"mask_regime=*\")\n","):\n","\n","    candidates = sorted(\n","        regime_dir.glob(\n","            \"synthetic_mainline_*.parquet\"\n","        )\n","    )\n","\n","    if len(candidates) > 0:\n","\n","        sample_files.append(\n","            candidates[0]\n","        )\n","\n","        break\n","\n","assert len(sample_files) == 1\n","\n","sample_masked = pd.read_parquet(\n","    sample_files[0],\n","    columns=[\n","        \"link_id\",\n","        \"milepost\",\n","    ]\n",")\n","\n","milepost_map = (\n","    sample_masked[\n","        [\"link_id\", \"milepost\"]\n","    ]\n","    .drop_duplicates(\"link_id\")\n",")\n","\n","assert milepost_map[\"link_id\"].is_unique\n","assert len(milepost_map) == 109\n","\n","link_meta = links.merge(\n","    milepost_map,\n","    on=\"link_id\",\n","    how=\"inner\",\n","    validate=\"one_to_one\"\n",")\n","\n","assert len(link_meta) == 109\n","\n","link_meta = (\n","    link_meta\n","    .sort_values(\"milepost\")\n","    .reset_index(drop=True)\n",")\n","\n","link_ids = (\n","    link_meta[\"link_id\"]\n","    .to_numpy()\n",")\n","\n","mileposts = (\n","    link_meta[\"milepost\"]\n","    .to_numpy()\n",")\n","\n","neighbor_map = {}\n","\n","for i, link_id in enumerate(link_ids):\n","\n","    distances = np.abs(\n","        mileposts - mileposts[i]\n","    )\n","\n","    valid = (\n","        (distances <= 1.0)\n","        &\n","        (distances > 0)\n","    )\n","\n","    neighbor_map[link_id] = (\n","        link_ids[valid].tolist()\n","    )\n","\n","neighbor_counts = pd.Series(\n","    {\n","        link_id: len(neighbors)\n","        for link_id, neighbors\n","        in neighbor_map.items()\n","    }\n",")\n","\n","print(\n","    \"\\n1-km neighbor statistics:\"\n",")\n","\n","print(\n","    neighbor_counts.describe()\n",")\n","\n","# ============================================================\n","# 5. DISCOVER MASKED FILES\n","# ============================================================\n","\n","def get_masked_files(\n","    start_date,\n","    end_date\n","):\n","\n","    files = []\n","\n","    for regime_dir in sorted(\n","        MASKED_ROOT.glob(\"mask_regime=*\")\n","    ):\n","\n","        regime = (\n","            regime_dir.name\n","            .split(\"=\")[1]\n","        )\n","\n","        for path in sorted(\n","            regime_dir.glob(\n","                \"synthetic_mainline_*.parquet\"\n","            )\n","        ):\n","\n","            date_str = (\n","                path.stem\n","                .replace(\n","                    \"synthetic_mainline_\",\n","                    \"\"\n","                )\n","            )\n","\n","            date = pd.Timestamp(\n","                date_str.replace(\"_\", \"-\"),\n","                tz=\"UTC\"\n","            )\n","\n","            if (\n","                start_date\n","                <= date\n","                <= end_date\n","            ):\n","\n","                files.append(\n","                    (\n","                        date,\n","                        regime,\n","                        path\n","                    )\n","                )\n","\n","    return sorted(files)\n","\n","\n","# ============================================================\n","# 6. TRUTH PATH\n","# ============================================================\n","\n","def truth_path_for_date(date):\n","\n","    month = date.strftime(\n","        \"%Y-%m\"\n","    )\n","\n","    date_str = date.strftime(\n","        \"%Y_%m_%d\"\n","    )\n","\n","    return (\n","        TRUTH_ROOT\n","        / f\"year_month={month}\"\n","        / (\n","            \"synthetic_mainline_\"\n","            f\"{date_str}.parquet\"\n","        )\n","    )\n","\n","\n","# ============================================================\n","# 7. DAILY DATASET BUILDER\n","# ============================================================\n","\n","def build_daily_dataset(\n","    masked_path,\n","    truth_path,\n","    regime\n","):\n","\n","    # --------------------------------------------------------\n","    # A. LOAD MASKED DATA\n","    # --------------------------------------------------------\n","\n","    masked = pd.read_parquet(\n","        masked_path\n","    )\n","\n","    masked[\"timestamp\"] = pd.to_datetime(\n","        masked[\"timestamp\"],\n","        utc=True\n","    )\n","\n","    # --------------------------------------------------------\n","    # B. LOAD TRUTH\n","    #\n","    # Used ONLY to:\n","    #   1. identify genuine artificial mask targets\n","    #   2. provide labels\n","    #\n","    # It is NEVER used as a feature.\n","    # --------------------------------------------------------\n","\n","    truth = pd.read_parquet(\n","        truth_path,\n","        columns=[\n","            \"timestamp\",\n","            \"station_id\",\n","            \"link_id\",\n","            \"speed_kmh\",\n","            \"flow_vph\",\n","        ]\n","    )\n","\n","    truth[\"timestamp\"] = pd.to_datetime(\n","        truth[\"timestamp\"],\n","        utc=True\n","    )\n","\n","    truth = truth.rename(\n","        columns={\n","            \"speed_kmh\":\n","                \"speed_kmh_target\",\n","            \"flow_vph\":\n","                \"flow_vph_target\",\n","        }\n","    )\n","\n","    KEY_COLUMNS = [\n","        \"timestamp\",\n","        \"station_id\",\n","        \"link_id\",\n","    ]\n","\n","    assert not truth.duplicated(\n","        KEY_COLUMNS\n","    ).any()\n","\n","    # --------------------------------------------------------\n","    # C. IDENTIFY GENUINE ARTIFICIAL TARGETS\n","    #\n","    # A cell is a Task 1 target iff:\n","    #\n","    #   masked speed = missing\n","    #   masked flow  = missing\n","    #   truth speed  = available\n","    #   truth flow   = available\n","    #\n","    # This automatically excludes natural missingness.\n","    # --------------------------------------------------------\n","\n","    masked_target_keys = masked.loc[\n","        masked[\"speed_kmh\"].isna()\n","        &\n","        masked[\"flow_vph\"].isna(),\n","        KEY_COLUMNS\n","    ].copy()\n","\n","    target_candidates = (\n","        masked_target_keys.merge(\n","            truth[\n","                KEY_COLUMNS\n","                + [\n","                    \"speed_kmh_target\",\n","                    \"flow_vph_target\",\n","                ]\n","            ],\n","            on=KEY_COLUMNS,\n","            how=\"inner\",\n","            validate=\"one_to_one\"\n","        )\n","    )\n","\n","    # Only genuine scored targets remain.\n","    target_candidates = target_candidates[\n","        target_candidates[\n","            \"speed_kmh_target\"\n","        ].notna()\n","        &\n","        target_candidates[\n","            \"flow_vph_target\"\n","        ].notna()\n","    ].copy()\n","\n","    # --------------------------------------------------------\n","    # D. TARGET AUDIT\n","    # --------------------------------------------------------\n","\n","    raw_null_targets = len(\n","        masked_target_keys\n","    )\n","\n","    genuine_targets = len(\n","        target_candidates\n","    )\n","\n","    natural_missing = (\n","        raw_null_targets\n","        - genuine_targets\n","    )\n","\n","    # Natural missing is expected.\n","    # It must NOT enter training/evaluation.\n","\n","    # --------------------------------------------------------\n","    # E. BUILD FEATURE FRAME\n","    # --------------------------------------------------------\n","\n","    targets = target_candidates[\n","        KEY_COLUMNS\n","        + [\n","            \"speed_kmh_target\",\n","            \"flow_vph_target\",\n","        ]\n","    ].copy()\n","\n","    # --------------------------------------------------------\n","    # F. PHYSICAL FEATURES\n","    #\n","    # Source = network/links.csv\n","    # --------------------------------------------------------\n","\n","    targets = targets.merge(\n","        links,\n","        on=\"link_id\",\n","        how=\"left\",\n","        validate=\"many_to_one\"\n","    )\n","\n","    assert len(targets) == genuine_targets\n","\n","    assert (\n","        targets[PHYSICAL_FEATURES]\n","        .notna()\n","        .all()\n","        .all()\n","    )\n","\n","    # --------------------------------------------------------\n","    # G. TEMPORAL FEATURES\n","    #\n","    # Source = MASKED DATA ONLY\n","    # --------------------------------------------------------\n","\n","    masked_sorted = (\n","        masked\n","        .sort_values(\n","            [\n","                \"link_id\",\n","                \"timestamp\"\n","            ]\n","        )\n","        .copy()\n","    )\n","\n","    for lag in [\n","        1,\n","        2,\n","        3,\n","        6,\n","        12\n","    ]:\n","\n","        masked_sorted[\n","            f\"speed_lag_{lag}\"\n","        ] = (\n","            masked_sorted\n","            .groupby(\"link_id\")[\n","                \"speed_kmh\"\n","            ]\n","            .shift(lag)\n","        )\n","\n","        masked_sorted[\n","            f\"flow_lag_{lag}\"\n","        ] = (\n","            masked_sorted\n","            .groupby(\"link_id\")[\n","                \"flow_vph\"\n","            ]\n","            .shift(lag)\n","        )\n","\n","    temporal = masked_sorted[\n","        KEY_COLUMNS\n","        + TEMPORAL_FEATURES\n","    ].copy()\n","\n","    assert not temporal.duplicated(\n","        KEY_COLUMNS\n","    ).any()\n","\n","    targets = targets.merge(\n","        temporal,\n","        on=KEY_COLUMNS,\n","        how=\"left\",\n","        validate=\"one_to_one\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # H. SAME-TIMESTAMP 1-KM SPATIAL FEATURES\n","    #\n","    # Source = observed MASKED values only.\n","    #\n","    # Target link itself is excluded.\n","    # --------------------------------------------------------\n","\n","    observed = masked.loc[\n","        masked[\"speed_kmh\"].notna()\n","        &\n","        masked[\"flow_vph\"].notna(),\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"speed_kmh\",\n","            \"flow_vph\",\n","        ]\n","    ].copy()\n","\n","    timestamp_groups = {\n","        timestamp: group.set_index(\n","            \"link_id\"\n","        )\n","        for timestamp, group\n","        in observed.groupby(\n","            \"timestamp\",\n","            sort=False\n","        )\n","    }\n","\n","    spatial_rows = []\n","\n","    for row in targets[\n","        KEY_COLUMNS\n","    ].itertuples(\n","        index=False\n","    ):\n","\n","        timestamp = row.timestamp\n","        target_link = row.link_id\n","\n","        neighbors = neighbor_map.get(\n","            target_link,\n","            []\n","        )\n","\n","        current = timestamp_groups.get(\n","            timestamp\n","        )\n","\n","        if current is None:\n","            continue\n","\n","        available = current.loc[\n","            current.index.intersection(\n","                neighbors\n","            )\n","        ]\n","\n","        if len(available) == 0:\n","            continue\n","\n","        speeds = (\n","            available[\"speed_kmh\"]\n","            .to_numpy()\n","        )\n","\n","        flows = (\n","            available[\"flow_vph\"]\n","            .to_numpy()\n","        )\n","\n","        spatial_rows.append(\n","            {\n","                \"timestamp\":\n","                    timestamp,\n","\n","                \"station_id\":\n","                    row.station_id,\n","\n","                \"link_id\":\n","                    target_link,\n","\n","                \"local_1km_speed_mean\":\n","                    np.mean(speeds),\n","\n","                \"local_1km_speed_q10\":\n","                    np.quantile(\n","                        speeds,\n","                        0.10\n","                    ),\n","\n","                \"local_1km_speed_q25\":\n","                    np.quantile(\n","                        speeds,\n","                        0.25\n","                    ),\n","\n","                \"local_1km_flow_mean\":\n","                    np.mean(flows),\n","            }\n","        )\n","\n","    if len(spatial_rows) > 0:\n","\n","        spatial = pd.DataFrame(\n","            spatial_rows\n","        )\n","\n","        assert not spatial.duplicated(\n","            KEY_COLUMNS\n","        ).any()\n","\n","        targets = targets.merge(\n","            spatial,\n","            on=KEY_COLUMNS,\n","            how=\"left\",\n","            validate=\"one_to_one\"\n","        )\n","\n","    else:\n","\n","        for feature in SPATIAL_FEATURES:\n","            targets[feature] = np.nan\n","\n","    # --------------------------------------------------------\n","    # I. FINAL DAILY AUDIT\n","    # --------------------------------------------------------\n","\n","    assert len(targets) == genuine_targets\n","\n","    assert (\n","        targets[\n","            [\n","                \"speed_kmh_target\",\n","                \"flow_vph_target\",\n","            ]\n","        ]\n","        .notna()\n","        .all()\n","        .all()\n","    )\n","\n","    targets[\"panel\"] = PANEL\n","    targets[\"mask_regime\"] = regime\n","\n","    # Store diagnostic counts as attributes.\n","    targets.attrs[\"raw_null_targets\"] = (\n","        raw_null_targets\n","    )\n","\n","    targets.attrs[\"genuine_targets\"] = (\n","        genuine_targets\n","    )\n","\n","    targets.attrs[\"natural_missing\"] = (\n","        natural_missing\n","    )\n","\n","    return targets\n","\n","\n","# ============================================================\n","# 8. DISCOVER TRAIN / VALIDATION FILES\n","# ============================================================\n","\n","train_files = get_masked_files(\n","    TRAIN_START,\n","    TRAIN_END\n",")\n","\n","valid_files = get_masked_files(\n","    VALID_START,\n","    VALID_END\n",")\n","\n","print(\n","    \"\\nTrain masked files:\",\n","    len(train_files)\n",")\n","\n","print(\n","    \"Validation masked files:\",\n","    len(valid_files)\n",")\n","\n","assert len(train_files) == 242\n","assert len(valid_files) == 31\n","\n","\n","# ============================================================\n","# 9. BUILD TRAIN\n","# ============================================================\n","\n","train_parts = []\n","\n","train_raw_null = 0\n","train_genuine = 0\n","train_natural = 0\n","\n","for i, (\n","    date,\n","    regime,\n","    masked_path\n",") in enumerate(\n","    train_files,\n","    start=1\n","):\n","\n","    truth_path = truth_path_for_date(\n","        date\n","    )\n","\n","    assert truth_path.exists(), (\n","        f\"Missing truth: {truth_path}\"\n","    )\n","\n","    part = build_daily_dataset(\n","        masked_path,\n","        truth_path,\n","        regime\n","    )\n","\n","    if part is not None:\n","\n","        train_parts.append(part)\n","\n","        train_raw_null += (\n","            part.attrs[\n","                \"raw_null_targets\"\n","            ]\n","        )\n","\n","        train_genuine += (\n","            part.attrs[\n","                \"genuine_targets\"\n","            ]\n","        )\n","\n","        train_natural += (\n","            part.attrs[\n","                \"natural_missing\"\n","            ]\n","        )\n","\n","    if (\n","        i % 20 == 0\n","        or i == len(train_files)\n","    ):\n","\n","        print(\n","            f\"Train progress: \"\n","            f\"{i}/{len(train_files)}\"\n","        )\n","\n","    gc.collect()\n","\n","\n","# ============================================================\n","# 10. BUILD VALIDATION\n","# ============================================================\n","\n","valid_parts = []\n","\n","valid_raw_null = 0\n","valid_genuine = 0\n","valid_natural = 0\n","\n","for i, (\n","    date,\n","    regime,\n","    masked_path\n",") in enumerate(\n","    valid_files,\n","    start=1\n","):\n","\n","    truth_path = truth_path_for_date(\n","        date\n","    )\n","\n","    assert truth_path.exists(), (\n","        f\"Missing truth: {truth_path}\"\n","    )\n","\n","    part = build_daily_dataset(\n","        masked_path,\n","        truth_path,\n","        regime\n","    )\n","\n","    if part is not None:\n","\n","        valid_parts.append(part)\n","\n","        valid_raw_null += (\n","            part.attrs[\n","                \"raw_null_targets\"\n","            ]\n","        )\n","\n","        valid_genuine += (\n","            part.attrs[\n","                \"genuine_targets\"\n","            ]\n","        )\n","\n","        valid_natural += (\n","            part.attrs[\n","                \"natural_missing\"\n","            ]\n","        )\n","\n","    if (\n","        i % 10 == 0\n","        or i == len(valid_files)\n","    ):\n","\n","        print(\n","            f\"Validation progress: \"\n","            f\"{i}/{len(valid_files)}\"\n","        )\n","\n","    gc.collect()\n","\n","\n","# ============================================================\n","# 11. COMBINE\n","# ============================================================\n","\n","assert len(train_parts) > 0\n","assert len(valid_parts) > 0\n","\n","train_spatial = pd.concat(\n","    train_parts,\n","    ignore_index=True\n",")\n","\n","valid_spatial = pd.concat(\n","    valid_parts,\n","    ignore_index=True\n",")\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"MULTI-DAY SPATIAL DATASET\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"Train shape:\",\n","    train_spatial.shape\n",")\n","\n","print(\n","    \"Validation shape:\",\n","    valid_spatial.shape\n",")\n","\n","# ============================================================\n","# 12. TARGET AUDIT\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"TARGET AUDIT\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"Train raw null cells:\",\n","    train_raw_null\n",")\n","\n","print(\n","    \"Train genuine masked targets:\",\n","    train_genuine\n",")\n","\n","print(\n","    \"Train natural missing:\",\n","    train_natural\n",")\n","\n","print(\n","    \"\\nValidation raw null cells:\",\n","    valid_raw_null\n",")\n","\n","print(\n","    \"Validation genuine masked targets:\",\n","    valid_genuine\n",")\n","\n","print(\n","    \"Validation natural missing:\",\n","    valid_natural\n",")\n","\n","print(\n","    \"\\nValidation target rows by regime:\"\n",")\n","\n","print(\n","    valid_spatial[\n","        \"mask_regime\"\n","    ]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","# ============================================================\n","# 13. SPATIAL FEATURE AVAILABILITY\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"1-KM SPATIAL FEATURE AVAILABILITY\")\n","print(\"=\" * 70)\n","\n","for feature in SPATIAL_FEATURES:\n","\n","    availability = (\n","        valid_spatial[feature]\n","        .notna()\n","        .mean()\n","    )\n","\n","    print(\n","        f\"{feature:30s}\"\n","        f\"{availability:.6f}\"\n","    )\n","\n","# ============================================================\n","# 14. FEATURE SCHEMA AUDIT\n","# ============================================================\n","\n","required_columns = (\n","    SPATIAL_MODEL_FEATURES\n","    + [\n","        \"speed_kmh_target\",\n","        \"flow_vph_target\",\n","        \"mask_regime\",\n","    ]\n",")\n","\n","missing_columns = [\n","    col\n","    for col in required_columns\n","    if col not in valid_spatial.columns\n","]\n","\n","assert not missing_columns, (\n","    f\"Missing columns: {missing_columns}\"\n",")\n","\n","# ============================================================\n","# 15. PHYSICAL FEATURE AUDIT\n","# ============================================================\n","\n","assert (\n","    valid_spatial[\n","        PHYSICAL_FEATURES\n","    ]\n","    .notna()\n","    .all()\n","    .all()\n",")\n","\n","# ============================================================\n","# 16. TARGET AUDIT\n","# ============================================================\n","\n","assert (\n","    valid_spatial[\n","        [\n","            \"speed_kmh_target\",\n","            \"flow_vph_target\",\n","        ]\n","    ]\n","    .notna()\n","    .all()\n","    .all()\n",")\n","\n","# ============================================================\n","# 17. KEY UNIQUENESS\n","# ============================================================\n","\n","KEY_COLUMNS = [\n","    \"timestamp\",\n","    \"station_id\",\n","    \"link_id\",\n","]\n","\n","assert not train_spatial.duplicated(\n