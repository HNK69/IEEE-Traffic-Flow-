yle=\"text-align: right;\">\n","      <th></th>\n","      <th>traffic_state</th>\n","      <th>n_targets</th>\n","      <th>q25_low_speed_rate</th>\n","      <th>q10_very_low_speed_rate</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>congested</td>\n","      <td>381</td>\n","      <td>0.367454</td>\n","      <td>0.792651</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>moderate</td>\n","      <td>29</td>\n","      <td>0.379310</td>\n","      <td>0.896552</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>free_flow</td>\n","      <td>6802</td>\n","      <td>0.060129</td>\n","      <td>0.129815</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["  traffic_state  n_targets  q25_low_speed_rate  q10_very_low_speed_rate\n","0     congested        381            0.367454                 0.792651\n","1      moderate         29            0.379310                 0.896552\n","2     free_flow       6802            0.060129                 0.129815"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","================================================================================\n","CELL 16B CHECKPOINT\n","================================================================================\n","✓ Same-timestamp cross-link aggregates created\n","✓ Target truth correlations calculated\n","✓ Traffic-state separation measured\n","✓ Severe congestion signal measured\n","✓ No target traffic value used in aggregate\n","\n","CELL 16B COMPLETE\n"]}],"source":["# ============================================================\n","# CELL 16B — CROSS-LINK SIGNAL\n","# ============================================================\n","\n","print(\"=\" * 80)\n","print(\"CELL 16B — SAME-TIMESTAMP CROSS-LINK SIGNAL\")\n","print(\"=\" * 80)\n","\n","\n","# ------------------------------------------------------------\n","# 1. Build observed-link table\n","# ------------------------------------------------------------\n","\n","observed = masked[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# 2. Build target lookup\n","# ------------------------------------------------------------\n","\n","target_lookup = targets[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh_truth\",\n","        \"flow_vph_truth\",\n","    ]\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# 3. For every timestamp calculate aggregate traffic\n","#    across OTHER observed links.\n","# ------------------------------------------------------------\n","\n","timestamp_agg = (\n","    observed\n","    .groupby(\"timestamp\")\n","    .agg(\n","        mean_speed=(\"speed_kmh\", \"mean\"),\n","        median_speed=(\"speed_kmh\", \"median\"),\n","        min_speed=(\"speed_kmh\", \"min\"),\n","        q25_speed=(\n","            \"speed_kmh\",\n","            lambda x: x.quantile(0.25)\n","        ),\n","        q10_speed=(\n","            \"speed_kmh\",\n","            lambda x: x.quantile(0.10)\n","        ),\n","\n","        mean_flow=(\"flow_vph\", \"mean\"),\n","        median_flow=(\"flow_vph\", \"median\"),\n","        max_flow=(\"flow_vph\", \"max\"),\n","\n","        observed_links=(\n","            \"speed_kmh\",\n","            lambda x: x.notna().sum()\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Join aggregate signal to targets\n","# ------------------------------------------------------------\n","\n","cross_signal = target_lookup.merge(\n","    timestamp_agg,\n","    on=\"timestamp\",\n","    how=\"left\",\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. IMPORTANT:\n","#    The target itself is masked, so it cannot contribute to\n","#    these aggregates. However, verify this explicitly.\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CROSS-LINK SIGNAL SUMMARY\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Target rows:\",\n","    len(cross_signal)\n",")\n","\n","print(\n","    \"Mean observed links:\",\n","    cross_signal[\n","        \"observed_links\"\n","    ].mean()\n",")\n","\n","print(\n","    \"Mean speed:\",\n","    cross_signal[\n","        \"mean_speed\"\n","    ].mean()\n",")\n","\n","print(\n","    \"Mean flow:\",\n","    cross_signal[\n","        \"mean_flow\"\n","    ].mean()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Correlation with target truth\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CORRELATION WITH TARGET TRUTH\")\n","print(\"=\" * 80)\n","\n","signal_columns = [\n","    \"mean_speed\",\n","    \"median_speed\",\n","    \"min_speed\",\n","    \"q25_speed\",\n","    \"q10_speed\",\n","    \"mean_flow\",\n","    \"median_flow\",\n","    \"max_flow\",\n","]\n","\n","correlation_rows = []\n","\n","for feature in signal_columns:\n","\n","    speed_corr = (\n","        cross_signal[\n","            [\n","                feature,\n","                \"speed_kmh_truth\",\n","            ]\n","        ]\n","        .dropna()\n","        .corr()\n","        .iloc[0, 1]\n","    )\n","\n","    flow_corr = (\n","        cross_signal[\n","            [\n","                feature,\n","                \"flow_vph_truth\",\n","            ]\n","        ]\n","        .dropna()\n","        .corr()\n","        .iloc[0, 1]\n","    )\n","\n","    correlation_rows.append(\n","        {\n","            \"feature\": feature,\n","            \"speed_correlation\": speed_corr,\n","            \"flow_correlation\": flow_corr,\n","        }\n","    )\n","\n","\n","correlation_df = pd.DataFrame(\n","    correlation_rows\n",")\n","\n","display(correlation_df)\n","\n","\n","# ------------------------------------------------------------\n","# 7. Define traffic state from TRUE target\n","# ------------------------------------------------------------\n","\n","cross_signal[\"traffic_state\"] = pd.cut(\n","    cross_signal[\"speed_kmh_truth\"],\n","    bins=[\n","        -np.inf,\n","        70,\n","        100,\n","        np.inf,\n","    ],\n","    labels=[\n","        \"congested\",\n","        \"moderate\",\n","        \"free_flow\",\n","    ],\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 8. Compare cross-link speed by traffic state\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CROSS-LINK SPEED BY TARGET TRAFFIC STATE\")\n","print(\"=\" * 80)\n","\n","state_signal = (\n","    cross_signal\n","    .groupby(\n","        \"traffic_state\",\n","        observed=True\n","    )\n","    .agg(\n","        n_targets=(\n","            \"speed_kmh_truth\",\n","            \"size\"\n","        ),\n","\n","        target_speed_mean=(\n","            \"speed_kmh_truth\",\n","            \"mean\"\n","        ),\n","\n","        cross_mean_speed=(\n","            \"mean_speed\",\n","            \"mean\"\n","        ),\n","\n","        cross_median_speed=(\n","            \"median_speed\",\n","            \"mean\"\n","        ),\n","\n","        cross_q25_speed=(\n","            \"q25_speed\",\n","            \"mean\"\n","        ),\n","\n","        cross_q10_speed=(\n","            \"q10_speed\",\n","            \"mean\"\n","        ),\n","\n","        cross_min_speed=(\n","            \"min_speed\",\n","            \"mean\"\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","display(state_signal)\n","\n","\n","# ------------------------------------------------------------\n","# 9. Critical test:\n","#    congested target + cross-link signal\n","# ------------------------------------------------------------\n","\n","congested = (\n","    cross_signal[\"traffic_state\"]\n","    == \"congested\"\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CONGESTED TARGETS — CROSS-LINK SIGNAL\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Congested targets:\",\n","    congested.sum()\n",")\n","\n","display(\n","    cross_signal.loc[\n","        congested,\n","        [\n","            \"speed_kmh_truth\",\n","            \"mean_speed\",\n","            \"median_speed\",\n","            \"q25_speed\",\n","            \"q10_speed\",\n","            \"min_speed\",\n","            \"mean_flow\",\n","            \"observed_links\",\n","        ]\n","    ].describe()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 10. Compare severe congestion\n","# ------------------------------------------------------------\n","\n","severe_congestion = (\n","    cross_signal[\"speed_kmh_truth\"] < 30\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"SEVERE CONGESTION — CROSS-LINK SIGNAL\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Severely congested targets:\",\n","    severe_congestion.sum()\n",")\n","\n","if severe_congestion.sum() > 0:\n","\n","    display(\n","        cross_signal.loc[\n","            severe_congestion,\n","            [\n","                \"speed_kmh_truth\",\n","                \"mean_speed\",\n","                \"median_speed\",\n","                \"q25_speed\",\n","                \"q10_speed\",\n","                \"min_speed\",\n","                \"mean_flow\",\n","                \"observed_links\",\n","            ]\n","        ].describe()\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 11. Strongest simple congestion indicator\n","# ------------------------------------------------------------\n","# How often do OTHER links also show low speed?\n","\n","cross_signal[\"other_links_low_speed\"] = (\n","    cross_signal[\"q25_speed\"] < 70\n",")\n","\n","cross_signal[\"other_links_very_low_speed\"] = (\n","    cross_signal[\"q10_speed\"] < 50\n",")\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CROSS-LINK CONGESTION INDICATORS\")\n","print(\"=\" * 80)\n","\n","indicator_summary = (\n","    cross_signal\n","    .groupby(\n","        \"traffic_state\",\n","        observed=True\n","    )\n","    .agg(\n","        n_targets=(\n","            \"speed_kmh_truth\",\n","            \"size\"\n","        ),\n","\n","        q25_low_speed_rate=(\n","            \"other_links_low_speed\",\n","            \"mean\"\n","        ),\n","\n","        q10_very_low_speed_rate=(\n","            \"other_links_very_low_speed\",\n","            \"mean\"\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","display(indicator_summary)\n","\n","\n","# ------------------------------------------------------------\n","# 12. Final checkpoint\n","# ------------------------------------------------------------\n","\n","assert len(cross_signal) == len(targets)\n","\n","assert (\n","    cross_signal[\n","        \"mean_speed\"\n","    ].notna().all()\n",")\n","\n","assert (\n","    correlation_df.shape[0]\n","    == len(signal_columns)\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CELL 16B CHECKPOINT\")\n","print(\"=\" * 80)\n","\n","print(\"✓ Same-timestamp cross-link aggregates created\")\n","print(\"✓ Target truth correlations calculated\")\n","print(\"✓ Traffic-state separation measured\")\n","print(\"✓ Severe congestion signal measured\")\n","print(\"✓ No target traffic value used in aggregate\")\n","print(\"\\nCELL 16B COMPLETE\")"]},{"cell_type":"code","execution_count":20,"id":"71d0b7dd","metadata":{"execution":{"iopub.execute_input":"2026-10-09T21:15:42.300558Z","iopub.status.busy":"2026-10-09T21:15:42.30028Z","iopub.status.idle":"2026-10-09T21:15:42.431339Z","shell.execute_reply":"2026-10-09T21:15:42.430493Z