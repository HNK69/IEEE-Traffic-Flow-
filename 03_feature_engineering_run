   0.828048    0.871280     0.847935  \n","11     0.747896    0.796599     0.770299  \n","3      0.829609    0.885056     0.855115  \n","4      0.820456    0.871318     0.843852  \n","5      0.736679    0.796438     0.764168  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","================================================================================\n","CELL 11 CHECKPOINT\n","================================================================================\n","✓ Five feature configurations evaluated\n","✓ Same model configuration used for all\n","✓ Chronological validation preserved\n","✓ Overall Task 1 metrics calculated\n","✓ R1/R2/R3 metrics calculated\n","✓ Current best configuration: all_features\n","✓ Current best state score: 0.811989\n","\n","CELL 11 COMPLETE\n"]}],"source":["# ============================================================\n","# CELL 11 — PROPER MULTI-REGIME ABLATION\n","# ============================================================\n","\n","from xgboost import XGBRegressor\n","from sklearn.metrics import mean_squared_error\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ------------------------------------------------------------\n","# 1. Ablation configurations\n","# ------------------------------------------------------------\n","\n","ABLATION_CONFIGS_MULTI = {\n","\n","    \"physical_only\": PHYSICAL_FEATURES,\n","\n","    \"temporal_only\": TEMPORAL_FEATURES,\n","\n","    \"physical_availability\": (\n","        PHYSICAL_FEATURES\n","        + AVAILABILITY_FEATURES\n","    ),\n","\n","    \"physical_temporal\": (\n","        PHYSICAL_FEATURES\n","        + TEMPORAL_FEATURES\n","    ),\n","\n","    \"all_features\": (\n","        PHYSICAL_FEATURES\n","        + TEMPORAL_FEATURES\n","        + AVAILABILITY_FEATURES\n","    ),\n","}\n","\n","\n","# ------------------------------------------------------------\n","# 2. Fixed model configuration\n","# ------------------------------------------------------------\n","\n","MODEL_PARAMS_MULTI = {\n","    \"n_estimators\": 300,\n","    \"max_depth\": 8,\n","    \"learning_rate\": 0.05,\n","    \"subsample\": 0.8,\n","    \"colsample_bytree\": 0.8,\n","    \"objective\": \"reg:squarederror\",\n","    \"tree_method\": \"hist\",\n","    \"random_state\": 42,\n","    \"n_jobs\": -1,\n","}\n","\n","\n","# ------------------------------------------------------------\n","# 3. Evaluation function\n","# ------------------------------------------------------------\n","\n","def evaluate_task1(\n","    y_true,\n","    pred_speed,\n","    pred_flow,\n","    lanes\n","):\n","\n","    speed_rmse = np.sqrt(\n","        mean_squared_error(\n","            y_true[\"target_speed\"],\n","            pred_speed\n","        )\n","    )\n","\n","    flow_true_per_lane = (\n","        y_true[\"target_flow\"].to_numpy()\n","        / lanes\n","    )\n","\n","    flow_pred_per_lane = (\n","        pred_flow\n","        / lanes\n","    )\n","\n","    flow_rmse_per_lane = np.sqrt(\n","        mean_squared_error(\n","            flow_true_per_lane,\n","            flow_pred_per_lane\n","        )\n","    )\n","\n","    speed_score = max(\n","        0.0,\n","        1.0 - speed_rmse / 25.0\n","    )\n","\n","    flow_score = max(\n","        0.0,\n","        1.0 - flow_rmse_per_lane / 600.0\n","    )\n","\n","    state_score = (\n","        0.54 * speed_score\n","        + 0.46 * flow_score\n","    )\n","\n","    return {\n","        \"speed_rmse\": speed_rmse,\n","        \"flow_rmse_per_lane\": flow_rmse_per_lane,\n","        \"speed_score\": speed_score,\n","        \"flow_score\": flow_score,\n","        \"state_score\": state_score,\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 4. Per-regime evaluation helper\n","# ------------------------------------------------------------\n","\n","def evaluate_by_regime(\n","    valid_df,\n","    pred_speed,\n","    pred_flow\n","):\n","\n","    regime_results = []\n","\n","    for regime in [\"R1\", \"R2\", \"R3\"]:\n","\n","        mask = (\n","            valid_df[\"mask_regime\"]\n","            == regime\n","        )\n","\n","        if mask.sum() == 0:\n","            continue\n","\n","        regime_y = valid_df.loc[\n","            mask,\n","            [\n","                \"target_speed\",\n","                \"target_flow\"\n","            ]\n","        ]\n","\n","        regime_lanes = valid_df.loc[\n","            mask,\n","            \"lanes\"\n","        ].to_numpy()\n","\n","        metrics = evaluate_task1(\n","            regime_y,\n","            pred_speed[mask.to_numpy()],\n","            pred_flow[mask.to_numpy()],\n","            regime_lanes\n","        )\n","\n","        metrics[\"regime\"] = regime\n","        metrics[\"n_targets\"] = int(\n","            mask.sum()\n","        )\n","\n","        regime_results.append(\n","            metrics\n","        )\n","\n","    return pd.DataFrame(\n","        regime_results\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 5. Run ablations\n","# ------------------------------------------------------------\n","\n","overall_results = []\n","regime_results = []\n","\n","for config_name, features in ABLATION_CONFIGS_MULTI.items():\n","\n","    print(\"\\n\" + \"=\" * 80)\n","    print(\n","        f\"RUNNING ABLATION: {config_name}\"\n","    )\n","    print(\"=\" * 80)\n","\n","    print(\n","        \"Features:\",\n","        len(features)\n","    )\n","\n","    X_train_cfg = X_train_multi[\n","        features\n","    ]\n","\n","    X_valid_cfg = X_valid_multi[\n","        features\n","    ]\n","\n","    # --------------------------------------------------------\n","    # Speed model\n","    # --------------------------------------------------------\n","\n","    print(\"\\nTraining speed model...\")\n","\n","    speed_model = XGBRegressor(\n","        **MODEL_PARAMS_MULTI\n","    )\n","\n","    speed_model.fit(\n","        X_train_cfg,\n","        y_train_multi[\"target_speed\"],\n","        eval_set=[\n","            (\n","                X_valid_cfg,\n","                y_valid_multi[\"target_speed\"]\n","            )\n","        ],\n","        verbose=False\n","    )\n","\n","    pred_speed = speed_model.predict(\n","        X_valid_cfg\n","    )\n","\n","    # --------------------------------------------------------\n","    # Flow model\n","    # --------------------------------------------------------\n","\n","    print(\"Training flow model...\")\n","\n","    flow_model = XGBRegressor(\n","        **MODEL_PARAMS_MULTI\n","    )\n","\n","    flow_model.fit(\n","        X_train_cfg,\n","        y_train_multi[\"target_flow\"],\n","        eval_set=[\n","            (\n","                X_valid_cfg,\n","                y_valid_multi[\"target_flow\"]\n","            )\n","        ],\n","        verbose=False\n","    )\n","\n","    pred_flow = flow_model.predict(\n","        X_valid_cfg\n","    )\n","\n","    # --------------------------------------------------------\n","    # Overall evaluation\n","    # --------------------------------------------------------\n","\n","    lanes_valid = X_valid_multi[\n","        \"lanes\"\n","    ].to_numpy()\n","\n","    metrics = evaluate_task1(\n","        y_valid_multi,\n","        pred_speed,\n","        pred_flow,\n","        lanes_valid\n","    )\n","\n","    metrics[\"configuration\"] = config_name\n","    metrics[\"n_features\"] = len(features)\n","    metrics[\"n_targets\"] = len(\n","        y_valid_multi\n","    )\n","\n","    overall_results.append(\n","        metrics\n","    )\n","\n","    print(\n","        f\"\\nOverall State Score: \"\n","        f\"{metrics['state_score']:.6f}\"\n","    )\n","\n","    print(\n","        f\"Speed RMSE: \"\n","        f\"{metrics['speed_rmse']:.4f}\"\n","    )\n","\n","    print(\n","        f\"Flow RMSE/lane: \"\n","        f\"{metrics['flow_rmse_per_lane']:.4f}\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Per-regime evaluation\n","    # --------------------------------------------------------\n","\n","    regime_df = evaluate_by_regime(\n","        valid_multi,\n","        pred_speed,\n","        pred_flow\n","    )\n","\n","    regime_df[\"configuration\"] = (\n","        config_name\n","    )\n","\n","    regime_results.append(\n","        regime_df\n","    )\n","\n","    print(\"\\nPer-regime State Scores:\")\n","\n","    display(\n","        regime_df[\n","            [\n","                \"regime\",\n","                \"n_targets\",\n","                \"speed_rmse\",\n","                \"flow_rmse_per_lane\",\n","                \"state_score\"\n","            ]\n","        ]\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 6. Overall results\n","# ------------------------------------------------------------\n","\n","overall_results_df = (\n","    pd.DataFrame(\n","        overall_results\n","    )\n","    .sort_values(\n","        \"state_score\",\n","        ascending=False\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"OVERALL ABLATION RESULTS\")\n","print(\"=\" * 80)\n","\n","display(\n","    overall_results_df[\n","        [\n","            \"configuration\",\n","            \"n_features\",\n","            \"n_targets\",\n","            \"speed_rmse\",\n","            \"flow_rmse_per_lane\",\n","            \"speed_score\",\n","            \"flow_score\",\n","            \"state_score\",\n","        ]\n","    ]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Per-regime results\n","# ------------------------------------------------------------\n","\n","regime_results_df = pd.concat(\n","    regime_results,\n","    ignore_index=True\n",")\n","\n","regime_results_df = regime_results_df[\n","    [\n","        \"configura