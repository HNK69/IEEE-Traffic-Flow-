 PANEL / \"train\" /\n","    \"mainline_states_masked\" /\n","    f\"mask_regime={REGIME}\" /\n","    f\"synthetic_mainline_{DATE.replace('-', '_')}.parquet\"\n",")\n","\n","TRUTH_PATH = (\n","    ROOT / \"corridors\" / PANEL / \"train\" /\n","    \"mainline_states\" /\n","    \"year_month=2031-01\" /\n","    f\"synthetic_mainline_{DATE.replace('-', '_')}.parquet\"\n",")\n","\n","# ------------------------------------------------------------\n","# 2. Load masked + truth\n","# ------------------------------------------------------------\n","\n","masked = pd.read_parquet(MASKED_PATH)\n","\n","truth = pd.read_parquet(\n","    TRUTH_PATH,\n","    columns=[\n","        \"timestamp\",\n","        \"station_id\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n",")\n","\n","masked[\"timestamp\"] = pd.to_datetime(\n","    masked[\"timestamp\"],\n","    utc=True\n",")\n","\n","truth[\"timestamp\"] = pd.to_datetime(\n","    truth[\"timestamp\"],\n","    utc=True\n",")\n","\n","print(\"Masked:\", masked.shape)\n","print(\"Truth :\", truth.shape)\n","\n","# ------------------------------------------------------------\n","# 3. Verify target rows\n","# ------------------------------------------------------------\n","\n","target_mask = (\n","    masked[\"speed_kmh\"].isna()\n","    & masked[\"flow_vph\"].isna()\n",")\n","\n","targets = masked.loc[\n","    target_mask,\n","    [\n","        \"timestamp\",\n","        \"station_id\",\n","        \"link_id\",\n","    ]\n","].copy()\n","\n","print(\"\\nTarget rows:\", len(targets))\n","\n","# ------------------------------------------------------------\n","# 4. Recover milepost from MASKED data\n","# ------------------------------------------------------------\n","\n","link_meta = (\n","    masked[\n","        [\"link_id\", \"milepost\"]\n","    ]\n","    .drop_duplicates(\"link_id\")\n",")\n","\n","assert link_meta[\"link_id\"].is_unique\n","\n","# ------------------------------------------------------------\n","# 5. Build 1-km neighbor map\n","# ------------------------------------------------------------\n","\n","neighbor_map = {}\n","\n","for row in link_meta.itertuples(index=False):\n","\n","    target_link = row.link_id\n","    target_mp = row.milepost\n","\n","    neighbors = link_meta.loc[\n","        (\n","            link_meta[\"link_id\"] != target_link\n","        )\n","        &\n","        (\n","            (\n","                link_meta[\"milepost\"]\n","                - target_mp\n","            ).abs() <= 1.0\n","        ),\n","        \"link_id\"\n","    ].tolist()\n","\n","    neighbor_map[target_link] = neighbors\n","\n","# ------------------------------------------------------------\n","# 6. Build spatial features from MASKED data only\n","# ------------------------------------------------------------\n","\n","observed = masked.loc[\n","    masked[\"speed_kmh\"].notna()\n","    & masked[\"flow_vph\"].notna(),\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","].copy()\n","\n","observed_groups = {\n","    ts: g.set_index(\"link_id\")\n","    for ts, g in observed.groupby(\"timestamp\")\n","}\n","\n","spatial_rows = []\n","\n","for row in targets.itertuples(index=False):\n","\n","    ts = row.timestamp\n","    target_link = row.link_id\n","\n","    neighbors = neighbor_map[target_link]\n","\n","    if ts not in observed_groups:\n","        continue\n","\n","    current = observed_groups[ts]\n","\n","    available = current.loc[\n","        current.index.intersection(neighbors)\n","    ]\n","\n","    if len(available) == 0:\n","        continue\n","\n","    speeds = available[\"speed_kmh\"].to_numpy()\n","    flows = available[\"flow_vph\"].to_numpy()\n","\n","    spatial_rows.append(\n","        {\n","            \"timestamp\": ts,\n","            \"station_id\": row.station_id,\n","            \"link_id\": target_link,\n","\n","            \"local_1km_speed_mean\":\n","                np.mean(speeds),\n","\n","            \"local_1km_speed_q10\":\n","                np.quantile(speeds, 0.10),\n","\n","            \"local_1km_speed_q25\":\n","                np.quantile(speeds, 0.25),\n","\n","            \"local_1km_flow_mean\":\n","                np.mean(flows),\n","\n","            \"local_1km_observed_link_count\":\n","                len(available),\n","        }\n","    )\n","\n","spatial_eval = pd.DataFrame(spatial_rows)\n","\n","print(\n","    \"\\nSpatial feature rows:\",\n","    len(spatial_eval)\n",")\n","\n","# ============================================================\n","# 7. Diagnose target ↔ truth key matching\n","# ============================================================\n","\n","KEYS = [\n","    \"timestamp\",\n","    \"station_id\",\n","    \"link_id\",\n","]\n","\n","truth_target = targets.merge(\n","    truth,\n","    on=KEYS,\n","    how=\"left\",\n","    validate=\"one_to_one\"\n",")\n","\n","missing_truth = truth_target[\n","    truth_target[\"speed_kmh\"].isna()\n","    | truth_target[\"flow_vph\"].isna()\n","]\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"TARGET ↔ TRUTH JOIN AUDIT\")\n","print(\"=\" * 70)\n","\n","print(\"Target rows:\", len(targets))\n","print(\"Truth rows :\", len(truth))\n","print(\"Matched    :\", len(truth_target) - len(missing_truth))\n","print(\"Unmatched  :\", len(missing_truth))\n","\n","if len(missing_truth) > 0:\n","    print(\"\\nExample unmatched keys:\")\n","    print(missing_truth[KEYS].head(10))\n","\n","    # Check whether the issue is timestamp representation\n","    print(\"\\nTimestamp dtypes:\")\n","    print(\"masked:\", masked[\"timestamp\"].dtype)\n","    print(\"truth :\", truth[\"timestamp\"].dtype)\n","\n","# ------------------------------------------------------------\n","# 8. Keep only rows with valid ground truth\n","# ------------------------------------------------------------\n","\n","truth_target = truth_target[\n","    truth_target[\"speed_kmh\"].notna()\n","    & truth_target[\"flow_vph\"].notna()\n","].copy()\n","\n","print(\n","    \"\\nValid truth evaluation rows:\",\n","    len(truth_target)\n",")\n","\n","# ------------------------------------------------------------\n","# 9. Attach spatial features to valid truth rows\n","# ------------------------------------------------------------\n","\n","analysis = spatial_eval.merge(\n","    truth_target,\n","    on=KEYS,\n","    how=\"inner\",\n","    validate=\"one_to_one\"\n",")\n","\n","print(\n","    \"Spatial + truth evaluation rows:\",\n","    len(analysis)\n",")\n","\n","# ------------------------------------------------------------\n","# 10. Correlation helper\n","# ------------------------------------------------------------\n","\n","def corr(a, b):\n","\n","    valid = (\n","        a.notna()\n","        & b.notna()\n","    )\n","\n","    if valid.sum() < 2:\n","        return np.nan\n","\n","    return np.corrcoef(\n","        a[valid],\n","        b[valid]\n","    )[0, 1]\n","\n","# ------------------------------------------------------------\n","# 11. Overall spatial signal\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"OVERALL SPATIAL SIGNAL\")\n","print(\"=\" * 70)\n","\n","speed_features = [\n","    \"local_1km_speed_mean\",\n","    \"local_1km_speed_q10\",\n","    \"local_1km_speed_q25\",\n","]\n","\n","for feature in speed_features:\n","\n","    print(\n","        f\"{feature:30s}\",\n","        f\"→ target speed corr = \"\n","        f\"{corr(analysis[feature], analysis['speed_kmh']):.6f}\"\n","    )\n","\n","print(\n","    f\"{'local_1km_flow_mean':30s}\",\n","    f\"→ target flow corr = \"\n","    f\"{corr(analysis['local_1km_flow_mean'], analysis['flow_vph']):.6f}\"\n",")\n","\n","# ------------------------------------------------------------\n","# 12. Reconstruct lag-1 availability\n","# ------------------------------------------------------------\n","\n","masked_sorted = masked.sort_values(\n","    [\"link_id\", \"timestamp\"]\n",").copy()\n","\n","masked_sorted[\"speed_lag_1\"] = (\n","    masked_sorted\n","    .groupby(\"link_id\")[\"speed_kmh\"]\n","    .shift(1)\n",")\n","\n","lag1 = masked_sorted[\n","    KEYS + [\"speed_lag_1\"]\n","]\n","\n","analysis = analysis.merge(\n","    lag1,\n","    on=KEYS,\n","    how=\"left\",\n","    validate=\"one_to_one\"\n",")\n","\n","analysis[\"lag1_missing\"] = (\n","    analysis[\"speed_lag_1\"].isna()\n",")\n","\n","# ------------------------------------------------------------\n","# 13. Spatial signal × lag-1 availability\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SPATIAL SIGNAL × LAG-1 AVAILABILITY\")\n","print(\"=\" * 70)\n","\n","for status, group in analysis.groupby(\"lag1_missing\"):\n","\n","    label = (\n","        \"LAG-1 MISSING\"\n","        if status\n","        else \"LAG-1 AVAILABLE\"\n","    )\n","\n","    print(f\"\\n{label}\")\n","    print(\"n =\", len(group))\n","\n","    for feature in speed_features:\n","\n","        print(\n","            f\"{feature:30s}\",\n","            f\"{corr(group[feature], group['speed_kmh']):.6f}\"\n","        )\n","\n","    print(\n","        f\"{'local_1km_flow_mean':30s}\",\n","        f\"{corr(group['local_1km_flow_mean'], group['flow_vph']):.6f}\"\n","    )\n","\n","# ------------------------------------------------------------\n","# 14. Traffic-state diagnostic\n","# ------------------------------------------------------------\n","\n","analysis[\"traffic_state\"] = np.select(\n","    [\n","        analysis[\"speed_kmh\"] < 70,\n","        analysis[\"speed_kmh\"] < 100,\n","    ],\n","    [\n","        \"congested\",\n","        \"moderate\",\n","    ],\n","    default=\"free_flow\"\n",")\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SPATIAL SIGNAL × TRAFFIC STATE\")\n","print(\"=\" * 70)\n","\n","for state, group in analysis.groupby(\"traffic_state\"):\n","\n","    print(f\"\\n{state}\")\n","    print(\"n =\", len(group))\n","\n","    for feature in speed_features:\n","\n","        print(\n","            f\"{feature:30s}\",\n","            f\"{corr(group[feature], group['speed_kmh']):.6f}\"\n","        )\n","\n","    print(\n","        f\"{'local_1km_flow_mean':30s}\",\n","        f\"{corr(group['local_1km_flow_mean'], group['flow_vph']):.6f}\"\n","    )\n","\n","# ------------------------------------------------------------\n","# 15. Local congestion signal\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"LOCAL q10 CONGESTION SIGNAL\")\n","print(\"=\" * 70)\n","\n","for state in [\"congested\", \"free_flow\"]:\n","\n","    group = analysis[\n","        analysis[\"traffic_state\"] == state\n","    ]\n","\n","    if len(group) == 0:\n","        continue\n","\n","    print(f\"\\n{state}\")\n","    print(\"n =\", len(group))\n","\n","    print(\n","        \"Local q10 < 50 km/h:\",\n","        (\n","            group[\"local_1km_speed_q10\"] < 50\n","        ).mean()\n","    )\n","\n","    print(\n","        \"Local q25 < 70 km/h:\",\n","        (\n","            group[\"local_1km_speed_q25\"] < 70\n","        ).mean()\n","    )\n","\n","# ------------------------------------------------------------\n","# 16. Final checkpoint\n","# ------------------------------------------------------------\n","\n","assert len(analysis) > 0\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"CELL 17B CHECKPOINT PASSED\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"Spatial features were constructed exclusively \"\n","    \"from masked observations.\"\n",")\n","\n","print(\n","    \"Ground truth was used only for evaluation.\"\n",")"]},{"cell_type":"code","execution_count":25,"id":"20af845e","metadata":{"execution":{"iopub.execute_input":"2026-10-09T21:16:22.272655Z","iopub.status.busy":"2026-10-09T21:16:22.272353Z","iopub.status.idle":"2026-10-09T21:40:09.9