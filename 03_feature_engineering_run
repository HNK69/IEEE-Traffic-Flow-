==============\n","✓ History availability quantified\n","✓ History depth vs error measured\n","✓ Congestion × history interaction measured\n","✓ Catastrophic errors isolated\n","✓ Worst congested cases inspected\n","✓ Difficult links identified\n","\n","CELL 14 COMPLETE\n"]}],"source":["# ============================================================\n","# CELL 14 — MISSING-HISTORY + CONGESTION INVESTIGATION\n","# ============================================================\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","print(\"=\" * 80)\n","print(\"CELL 14 — MISSING-HISTORY + CONGESTION INVESTIGATION\")\n","print(\"=\" * 80)\n","\n","\n","# ------------------------------------------------------------\n","# 1. Build analysis dataframe\n","# ------------------------------------------------------------\n","\n","analysis_df = valid_multi[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"mask_regime\",\n","        \"target_speed\",\n","        \"target_flow\",\n","    ]\n","].copy()\n","\n","# Add model predictions and errors from previous checkpoint.\n","analysis_df[\"pred_speed\"] = (\n","    error_df[\"pred_speed\"].values\n",")\n","\n","analysis_df[\"pred_flow\"] = (\n","    error_df[\"pred_flow\"].values\n",")\n","\n","analysis_df[\"abs_speed_error\"] = (\n","    error_df[\"abs_speed_error\"].values\n",")\n","\n","analysis_df[\"abs_flow_error\"] = (\n","    error_df[\"abs_flow_error\"].values\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2. Add temporal-history availability\n","# ------------------------------------------------------------\n","\n","LAG_COLUMNS = [\n","    \"speed_lag_1\",\n","    \"speed_lag_2\",\n","    \"speed_lag_3\",\n","    \"speed_lag_6\",\n","    \"speed_lag_12\",\n","]\n","\n","for lag in LAG_COLUMNS:\n","\n","    analysis_df[f\"{lag}_available\"] = (\n","        X_valid_multi[lag]\n","        .notna()\n","        .values\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 3. Count available speed lags\n","# ------------------------------------------------------------\n","\n","analysis_df[\"n_speed_lags_available\"] = (\n","    analysis_df[\n","        [\n","            f\"{lag}_available\"\n","            for lag in LAG_COLUMNS\n","        ]\n","    ]\n","    .sum(axis=1)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Define TRUE traffic state\n","# ------------------------------------------------------------\n","\n","analysis_df[\"traffic_state\"] = pd.cut(\n","    analysis_df[\"target_speed\"],\n","    bins=[\n","        -np.inf,\n","        70,\n","        100,\n","        np.inf,\n","    ],\n","    labels=[\n","        \"congested\",\n","        \"moderate\",\n","        \"free_flow\",\n","    ],\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Define catastrophic speed errors\n","# ------------------------------------------------------------\n","\n","analysis_df[\"catastrophic_speed_error\"] = (\n","    analysis_df[\"abs_speed_error\"] >= 50\n",")\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"BASIC DISTRIBUTION\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Total validation targets:\",\n","    len(analysis_df)\n",")\n","\n","print(\n","    \"Catastrophic speed errors:\",\n","    analysis_df[\n","        \"catastrophic_speed_error\"\n","    ].sum()\n",")\n","\n","print(\n","    \"Catastrophic error rate:\",\n","    analysis_df[\n","        \"catastrophic_speed_error\"\n","    ].mean()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Error vs number of available speed lags\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"ERROR VS NUMBER OF AVAILABLE SPEED LAGS\")\n","print(\"=\" * 80)\n","\n","lag_count_error = (\n","    analysis_df\n","    .groupby(\n","        \"n_speed_lags_available\"\n","    )\n","    .agg(\n","        n_targets=(\"target_speed\", \"size\"),\n","\n","        speed_mae=(\n","            \"abs_speed_error\",\n","            \"mean\"\n","        ),\n","\n","        speed_rmse=(\n","            \"abs_speed_error\",\n","            lambda x: np.sqrt(\n","                np.mean(x ** 2)\n","            )\n","        ),\n","\n","        flow_mae=(\n","            \"abs_flow_error\",\n","            \"mean\"\n","        ),\n","\n","        catastrophic_rate=(\n","            \"catastrophic_speed_error\",\n","            \"mean\"\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","display(lag_count_error)\n","\n","\n","# ------------------------------------------------------------\n","# 7. Congestion + history interaction\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"TRAFFIC STATE × HISTORY AVAILABILITY\")\n","print(\"=\" * 80)\n","\n","state_history = (\n","    analysis_df\n","    .groupby(\n","        [\n","            \"traffic_state\",\n","            \"n_speed_lags_available\",\n","        ],\n","        observed=True,\n","    )\n","    .agg(\n","        n_targets=(\"target_speed\", \"size\"),\n","\n","        speed_mae=(\n","            \"abs_speed_error\",\n","            \"mean\"\n","        ),\n","\n","        speed_rmse=(\n","            \"abs_speed_error\",\n","            lambda x: np.sqrt(\n","                np.mean(x ** 2)\n","            )\n","        ),\n","\n","        flow_mae=(\n","            \"abs_flow_error\",\n","            \"mean\"\n","        ),\n","\n","        catastrophic_rate=(\n","            \"catastrophic_speed_error\",\n","            \"mean\"\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","display(state_history)\n","\n","\n","# ------------------------------------------------------------\n","# 8. How often is ALL recent history missing?\n","# ------------------------------------------------------------\n","\n","all_history_missing = (\n","    analysis_df[\n","        \"n_speed_lags_available\"\n","    ] == 0\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"ALL SPEED HISTORY MISSING\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Targets with zero available speed lags:\",\n","    all_history_missing.sum()\n",")\n","\n","print(\n","    \"Percentage:\",\n","    100 * all_history_missing.mean()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 9. Congested cases with missing lag-1\n","# ------------------------------------------------------------\n","\n","congested = (\n","    analysis_df[\"traffic_state\"]\n","    == \"congested\"\n",")\n","\n","lag1_missing = (\n","    ~analysis_df[\"speed_lag_1_available\"]\n",")\n","\n","congested_lag1_missing = (\n","    congested\n","    & lag1_missing\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CONGESTED + LAG-1 MISSING\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Targets:\",\n","    congested_lag1_missing.sum()\n",")\n","\n","print(\n","    \"Percentage of all targets:\",\n","    100 * congested_lag1_missing.mean()\n",")\n","\n","if congested_lag1_missing.sum() > 0:\n","\n","    print(\n","        \"Speed MAE:\",\n","        analysis_df.loc[\n","            congested_lag1_missing,\n","            \"abs_speed_error\"\n","        ].mean()\n","    )\n","\n","    print(\n","        \"Speed RMSE:\",\n","        np.sqrt(\n","            np.mean(\n","                analysis_df.loc[\n","                    congested_lag1_missing,\n","                    \"abs_speed_error\"\n","                ] ** 2\n","            )\n","        )\n","    )\n","\n","    print(\n","        \"Catastrophic rate:\",\n","        analysis_df.loc[\n","            congested_lag1_missing,\n","            \"catastrophic_speed_error\"\n","        ].mean()\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 10. Catastrophic errors — available history\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CATASTROPHIC ERRORS BY HISTORY\")\n","print(\"=\" * 80)\n","\n","catastrophic_history = (\n","    analysis_df[\n","        analysis_df[\n","            \"catastrophic_speed_error\"\n","        ]\n","    ]\n","    .groupby(\n","        \"n_speed_lags_available\"\n","    )\n","    .size()\n","    .reset_index(\n","        name=\"catastrophic_errors\"\n","    )\n",")\n","\n","display(\n","    catastrophic_history\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 11. Inspect worst congested cases\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"WORST CONGESTED CASES\")\n","print(\"=\" * 80)\n","\n","worst_congested = (\n","    analysis_df[\n","        congested\n","    ]\n","    .sort_values(\n","        \"abs_speed_error\",\n","        ascending=False,\n","    )\n","    .head(25)\n",")\n","\n","display(\n","    worst_congested[\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"mask_regime\",\n","            \"target_speed\",\n","            \"pred_speed\",\n","            \"abs_speed_error\",\n","            \"target_flow\",\n","            \"n_speed_lags_available\",\n","            \"speed_lag_1_available\",\n","            \"speed_lag_2_available\",\n","            \"speed_lag_3_available\",\n","            \"speed_lag_6_available\",\n","            \"speed_lag_12_available\",\n","        ]\n","    ]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Inspect repeated difficult links\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"LINKS WITH HIGHEST SPEED ERROR\")\n","print(\"=\" * 80)\n","\n","link_error = (\n","    analysis_df\n","    .groupby(\"link_id\")\n","    .agg(\n","        n_targets=(\"target_speed\", \"size\"),\n","\n","        speed_mae=(\n","            \"abs_speed_error\",\n","            \"mean\"\n","        ),\n","\n","        speed_rmse=(\n","            \"abs_speed_error\",\n","            lambda x: np.sqrt(\n","                np.mean(x ** 2)\n","            )\n","        ),\n","\n","        catastrophic_rate=(\n","            \"catastrophic_speed_error\",\n","            \"mean\"\n","        ),\n","\n","        congestion_rate=(\n","            \"traffic_state\",\n","            lambda x: (\n","                x == \"congested\"\n","            ).mean()\n","        ),\n","    )\n","    .reset_index()\n","    .sort_values(\n","        \"speed_rmse\",\n","        ascending=False,\n","    )\n",")\n","\n","display(\n","    link_error.head(20)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 13. Final checkpoint\n","# ------------------------------------------------------------\n","\n","assert len(analysis_df) == len(\n","    X_valid_multi\n",")\n","\n","assert (\n","    analysis_df[\n","        \"n_speed_lags_available\"\n","    ].between(0, 5).all()\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CELL 14 CHECKPOINT\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"✓ History availability quantified\"\n",")\n","\n","print(\n","    \"✓ History depth vs error measured\"\n",")\n","\n","print(\n","    \"✓ Congestion × history interaction measured\"\n",")\n","\n","print(\n","    \"✓ Catastrophic errors isolated\"\n",")\n","\n","print(\n","    \"✓ Worst congested cases inspected\"\n",")\n","\n","print(\n","    \"✓ Difficult links identified\"\n",")\n","\n","print(\n","    \"\\nCELL 14 COMPLETE\"\n",")"]},{"cell_type":"code","execution_count":17,"id":"6151b4fe","metadata":{"execution":{"iopub.execute_input":"2026-10-09T21:15:41.646855Z","iopub.status.busy":"2026-10-09T21:15:41.646478Z","iopub.status.idle":"2026-10-09T21:15:41.668884Z","shell.execute_reply":"2026-10-09T21:15:41.668151Z"},"paper