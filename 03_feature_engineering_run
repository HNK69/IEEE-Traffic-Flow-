","    y_train_multi[\"target_flow\"],\n","    verbose=False\n",")\n","\n","pred_flow_error = (\n","    flow_model_error.predict(\n","        X_valid_error\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3. Build error-analysis dataframe\n","# ------------------------------------------------------------\n","\n","error_df = valid_multi[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"mask_regime\",\n","        \"target_speed\",\n","        \"target_flow\",\n","        \"lanes\",\n","        \"free_speed_kmh\",\n","        \"capacity_vph\",\n","    ]\n","].copy()\n","\n","error_df[\"pred_speed\"] = (\n","    pred_speed_error\n",")\n","\n","error_df[\"pred_flow\"] = (\n","    pred_flow_error\n",")\n","\n","error_df[\"speed_error\"] = (\n","    error_df[\"pred_speed\"]\n","    - error_df[\"target_speed\"]\n",")\n","\n","error_df[\"flow_error\"] = (\n","    error_df[\"pred_flow\"]\n","    - error_df[\"target_flow\"]\n",")\n","\n","error_df[\"abs_speed_error\"] = (\n","    error_df[\"speed_error\"]\n","    .abs()\n",")\n","\n","error_df[\"abs_flow_error\"] = (\n","    error_df[\"flow_error\"]\n","    .abs()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Overall error summary\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"OVERALL ERROR SUMMARY\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Speed MAE:\",\n","    error_df[\"abs_speed_error\"].mean()\n",")\n","\n","print(\n","    \"Speed RMSE:\",\n","    np.sqrt(\n","        np.mean(\n","            error_df[\"speed_error\"] ** 2\n","        )\n","    )\n",")\n","\n","print(\n","    \"Flow MAE:\",\n","    error_df[\"abs_flow_error\"].mean()\n",")\n","\n","print(\n","    \"Flow RMSE:\",\n","    np.sqrt(\n","        np.mean(\n","            error_df[\"flow_error\"] ** 2\n","        )\n","    )\n",")\n","\n","\n","# -------------------