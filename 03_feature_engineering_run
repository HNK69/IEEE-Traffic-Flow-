)\n","\n","\n","# ------------------------------------------------------------\n","# 1. Prepare masked observations\n","# ------------------------------------------------------------\n","\n","obs = masked[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"milepost\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","].copy()\n","\n","obs[\"timestamp\"] = pd.to_datetime(\n","    obs[\"timestamp\"],\n","    utc=True\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2. Build target table with milepost from masked data\n","# ------------------------------------------------------------\n","\n","target_base = targets[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh_truth\",\n","        \"flow_vph_truth\",\n","    ]\n","].copy()\n","\n","target_base[\"timestamp\"] = pd.to_datetime(\n","    target_base[\"timestamp\"],\n","    utc=True\n",")\n","\n","# One milepost per link.\n","link_milepost = (\n","    obs[\n","        [\n","            \"link_id\",\n","            \"milepost\",\n","        ]\n","    ]\n","    .drop_duplicates(\"link_id\")\n",")\n","\n","assert (\n","    link_milepost[\"link_id\"].nunique()\n","    == len(link_milepost)\n",")\n","\n","targets_d = target_base.merge(\n","    link_milepost,\n","    on=\"link_id\",\n","    how=\"left\",\n","    validate=\"many_to_one\",\n",")\n","\n","assert targets_d[\"milepost\"].notna().all()\n","\n","\n","# ------------------------------------------------------------\n","# 3. Same-timestamp target × observed-link pairs\n","# ------------------------------------------------------------\n","\n","pairs = targets_d.merge(\n","    obs,\n","    on=\"timestamp\",\n","    how=\"left\",\n","    suffixes=(\"_target\", \"_obs\"),\n",")\n","\n","\n","# Exclude the target link itself.\n","pairs = pairs[\n","    pairs[\"link_id_target\"]\n","    != pairs[\"link_id_obs\"]\n","].copy()\n","\n","\n","# Distance using physical milepost.\n","pairs[\"distance_km\"] = (\n","    pairs[\"milepost_target\"]\n","    - pairs[\"milepost_obs\"]\n",").abs()\n","\n","\n","# Only observed speed contributes.\n","pairs = pairs[\n","    pairs[\"speed_kmh\"].notna()\n","].copy()\n","\n","\n","print(\"\\nTarget-observation pairs:\", len(pairs))\n","\n","\n","# ------------------------------------------------------------\n","# 4. Build local features\n","# ------------------------------------------------------------\n","\n","radii = [0.5, 1.0, 2.0, 5.0]\n","\n","local_results = targets_d[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh_truth\",\n","        \"flow_vph_truth\",\n","    ]\n","].copy()\n","\n","\n","for radius in radii:\n","\n","    local = pairs[\n","        pairs[\"distance_km\"] <= radius\n","    ]\n","\n","    grouped = (\n","        local\n","        .groupby(\n","            [\n","                \"timestamp\",\n","                \"link_id_target\",\n","            ]\n","        )\n","        .agg(\n","            **{\n","                f\"speed_mean_{radius}km\":\n","                    (\"speed_kmh\", \"mean\"),\n","\n","                f\"speed_q10_{radius}km\":\n","                    (\n","                        \"speed_kmh\",\n","                        lambda x: x.quantile(0.10)\n","                    ),\n","\n","                f\"speed_q25_{radius}km\":\n","                    (\n","                        \"speed_kmh\",\n","                        lambda x: x.quantile(0.25)\n","                    ),\n","\n","                f\"flow_mean_{radius}km\":\n","                    (\"flow_vph\", \"mean\"),\n","\n","                f\"n_links_{radius}km\":\n","                    (\"speed_kmh\", \"count\"),\n","            }\n","        )\n","        .reset_index()\n","        .rename(\n","            columns={\n","                \"link_id_target\": \"link_id\"\n","            }\n","        )\n","    )\n","\n","    local_results = local_results.merge(\n","        grouped,\n","        on=[\n","            \"timestamp\",\n","            \"link_id\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 5. Add global signal from Cell 16B\n","# ------------------------------------------------------------\n","\n","global_signal = cross_signal[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"mean_speed\",\n","        \"q10_speed\",\n","        \"q25_speed\",\n","        \"mean_flow\",\n","    ]\n","].copy()\n","\n","global_signal[\"timestamp\"] = pd.to_datetime(\n","    global_signal[\"timestamp\"],\n","    utc=True\n",")\n","\n","local_results = local_results.merge(\n","    global_signal,\n","    on=[\n","        \"timestamp\",\n","        \"link_id\",\n","    ],\n","    how=\"left\",\n","    validate=\"one_to_one\",\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Recover target lag-1 availability\n","# ------------------------------------------------------------\n","\n","lag1 = masked[\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","    ]\n","].copy()\n","\n","lag1[\"timestamp\"] = pd.to_datetime(\n","    lag1[\"timestamp\"],\n","    utc=True\n",")\n","\n","lag1 = lag1.sort_values(\n","    [\n","        \"link_id\",\n","        \"timestamp\",\n","    ]\n",")\n","\n","lag1[\"speed_lag_1\"] = (\n","    lag1\n","    .groupby(\"link_id\")[\"speed_kmh\"]\n","    .shift(1)\n",")\n","\n","local_results = local_results.merge(\n","    lag1[\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"speed_lag_1\",\n","        ]\n","    ],\n","    on=[\n","        \"timestamp\",\n","        \"link_id\",\n","    ],\n","    how=\"left\",\n","    validate=\"one_to_one\",\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Restrict to lag-1 missing targets\n","# ------------------------------------------------------------\n","\n","local_results = local_results[\n","    local_results[\"speed_lag_1\"].isna()\n","].copy()\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"LAG-1 MISSING DATASET\")\n","print(\"=\" * 80)\n","\n","print(\"Rows:\", len(local_results))\n","\n","\n","# ------------------------------------------------------------\n","# 8. Define traffic state\n","# ------------------------------------------------------------\n","\n","local_results[\"traffic_state\"] = pd.cut(\n","    local_results[\"speed_kmh_truth\"],\n","    bins=[\n","        -np.inf,\n","        70,\n","        100,\n","        np.inf,\n","    ],\n","    labels=[\n","        \"congested\",\n","        \"moderate\",\n","        \"free_flow\",\n","    ],\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 9. Speed correlation\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"SPEED CORRELATION BY SPATIAL RADIUS\")\n","print(\"=\" * 80)\n","\n","corr_rows = []\n","\n","for radius in radii:\n","\n","    feature = f\"speed_mean_{radius}km\"\n","\n","    valid = local_results[\n","        [\n","            feature,\n","            \"speed_kmh_truth\",\n","        ]\n","    ].dropna()\n","\n","    corr_rows.append(\n","        {\n","            \"radius_km\": radius,\n","            \"speed_mean_correlation\":\n","                valid.corr().iloc[0, 1],\n","            \"valid_targets\":\n","                len(valid),\n","        }\n","    )\n","\n","\n","# Global reference\n","valid = local_results[\n","    [\n","        \"mean_speed\",\n","        \"speed_kmh_truth\",\n","    ]\n","].dropna()\n","\n","corr_rows.append(\n","    {\n","        \"radius_km\": \"GLOBAL\",\n","        \"speed_mean_correlation\":\n","            valid.corr().iloc[0, 1],\n","        \"valid_targets\":\n","            len(valid),\n","    }\n",")\n","\n","display(\n","    pd.DataFrame(corr_rows)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 10. Flow correlation\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"FLOW CORRELATION BY SPATIAL RADIUS\")\n","print(\"=\" * 80)\n","\n","flow_rows = []\n","\n","for radius in radii:\n","\n","    feature = f\"flow_mean_{radius}km\"\n","\n","    valid = local_results[\n","        [\n","            feature,\n","            \"flow_vph_truth\",\n","        ]\n","    ].dropna()\n","\n","    flow_rows.append(\n","        {\n","            \"radius_km\": radius,\n","            \"flow_mean_correlation\":\n","                valid.corr().iloc[0, 1],\n","            \"valid_targets\":\n","                len(valid),\n","        }\n","    )\n","\n","\n","valid = local_results[\n","    [\n","        \"mean_flow\",\n","        \"flow_vph_truth\",\n","    ]\n","].dropna()\n","\n","flow_rows.append(\n","    {\n","        \"radius_km\": \"GLOBAL\",\n","        \"flow_mean_correlation\":\n","            valid.corr().iloc[0, 1],\n","        \"valid_targets\":\n","            len(valid),\n","    }\n",")\n","\n","display(\n","    pd.DataFrame(flow_rows)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 11. Congestion separation\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CONGESTED VS FREE-FLOW — LOCAL SIGNAL\")\n","print(\"=\" * 80)\n","\n","congested = (\n","    local_results[\"speed_kmh_truth\"] < 70\n",")\n","\n","free_flow = (\n","    local_results[\"speed_kmh_truth\"] >= 100\n",")\n","\n","comparison_rows = []\n","\n","for radius in radii:\n","\n","    feature = f\"speed_q10_{radius}km\"\n","\n","    comparison_rows.append(\n","        {\n","            \"radius_km\": radius,\n","\n","            \"congested_n\":\n","                congested.sum(),\n","\n","            \"free_flow_n\":\n","                free_flow.sum(),\n","\n","            \"congested_q10_mean\":\n","                local_results.loc[\n","                    congested,\n","                    feature\n","                ].mean(),\n","\n","            \"free_flow_q10_mean\":\n","                local_results.loc[\n","                    free_flow,\n","                    feature\n","                ].mean(),\n","\n","            \"congested_low_speed_rate\":\n","                (\n","                    local_results.loc[\n","                        congested,\n","                        feature\n","                    ] < 50\n","                ).mean(),\n","\n","            \"free_flow_low_speed_rate\":\n","                (\n","                    local_results.loc[\n","                        free_flow,\n","                        feature\n","                    ] < 50\n","                ).mean(),\n","        }\n","    )\n","\n","\n","# Global reference\n","comparison_rows.append(\n","    {\n","        \"radius_km\": \"GLOBAL\",\n","\n","        \"congested_n\":\n","            congested.sum(),\n","\n","        \"free_flow_n\":\n","            free_flow.sum(),\n","\n","        \"congested_q10_mean\":\n","            local_results.loc[\n","                congested,\n","                \"q10_speed\"\n","            ].mean(),\n","\n","        \"free_flow_q10_mean\":\n","            local_results.loc[\n","                free_flow,\n","                \"q10_speed\"\n","            ].mean(),\n","\n","        \"congested_low_speed_rate\":\n","            (\n","                local_results.loc[\n","                    congested,\n","                    \"q10_speed\"\n","                ] < 50\n","            ).mean(),\n","\n","        \"free_flow_low_speed_rate\":\n","            (\n","                local_results.loc[\n","                    free_flow,\n","                    \"q10_speed\"\n","                ] < 50\n","            ).mean(),\n","    }\n",")\n","\n","display(\n","    pd.DataFrame(comparison_rows)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Local coverage\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"LOCAL SIGNAL COVERAGE\")\n","print(\"=\" * 80)\n","\n","coverage_rows = []\n","\n","for radius in radii:\n","\n","    feature = f\"n_links_{radius}km\"\n","\n","    coverage_rows.append(\n","        {\n","            \"radius_km\": radius,\n","\n","            \"mean_observed_links\":\n","                local_results[feature].mean(),\n","\n","            \"median_observed_links\":\n","                local_results[feature].median(),\n","\n","            \"zero_available_rate\":\n","                (\n","                    local_results[feature].fillna(0)\n","                    == 0\n","                ).mean(),\n","\n","            \"at_least_one_rate\":\n","                (\n","                    local_results[feature].fillna(0)\n","                    > 0\n","                ).mean(),\n","        }\n","    )\n","\n","display(\n","    pd.DataFrame(coverage_rows)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 13. Checkpoint\n","# ------------------------------------------------------------\n","\n","assert len(local_results) > 0\n","assert local_results[\"milepost\"].isna().sum() == 0 \\\n","    if \"milepost\" in local_results.columns else True\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CELL 16D CHECKPOINT\")\n","print(\"=\" * 80)\n","\n","print(\"✓ Milepost recovered from masked data\")\n","print(\"✓ Target link excluded\")\n","print(\"✓ Local spatial radii tested\")\n","print(\"✓ Global signal retained as reference\")\n","print(\"✓ Speed and flow correlations measured\")\n","print(\"✓ Congestion separation measured\")\n","print(\"✓ Local coverage measured\")\n","\n","print(\"\\nCELL 16D COMPLETE\")"]},{"cell_type":"code",