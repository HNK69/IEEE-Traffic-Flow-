       3  \n","4                              4  \n","5                              6  \n","6                              3  \n","7                              5  \n","8                              2  \n","9                              4  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","======================================================================\n","CELL 17A CHECKPOINT PASSED\n","======================================================================\n","1-km spatial features built exclusively from same-timestamp observed values in the masked input.\n"]}],"source":["# ============================================================\n","# STAGE 3 — CELL 17A\n","# VERIFIED 1-KM LOCAL SPATIAL FEATURES\n","#\n","# Uses:\n","#   - masked traffic values\n","#   - milepost already present in masked file\n","#\n","# NEVER uses target truth values.\n","# ============================================================\n","\n","import pandas as pd\n","import numpy as np\n","from pathlib import Path\n","\n","# ------------------------------------------------------------\n","# 1. Configuration\n","# ------------------------------------------------------------\n","\n","PANEL = \"D7_I405_S\"\n","DATE = \"2031-01-29\"\n","REGIME = \"R2\"\n","\n","ROOT = Path(\n","    \"/kaggle/input/competitions/\"\n","    \"2026-ieee-big-data-traffic-flow-bench/\"\n","    \"kaggle_public\"\n",")\n","\n","MASKED_PATH = (\n","    ROOT\n","    / \"corridors\"\n","    / PANEL\n","    / \"train\"\n","    / \"mainline_states_masked\"\n","    / f\"mask_regime={REGIME}\"\n","    / f\"synthetic_mainline_{DATE.replace('-', '_')}.parquet\"\n",")\n","\n","# ------------------------------------------------------------\n","# 2. Load masked data\n","# ------------------------------------------------------------\n","\n","print(\"Masked file:\")\n","print(MASKED_PATH)\n","\n","assert MASKED_PATH.exists()\n","\n","df = pd.read_parquet(MASKED_PATH)\n","\n","df[\"timestamp\"] = pd.to_datetime(\n","    df[\"timestamp\"],\n","    utc=True\n",")\n","\n","print(\"\\nMasked shape:\", df.shape)\n","print(\"\\nRelevant columns:\")\n","\n","print([\n","    c for c in\n","    [\n","        \"timestamp\",\n","        \"station_id\",\n","        \"link_id\",\n","        \"milepost\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","    if c in df.columns\n","])\n","\n","# ------------------------------------------------------------\n","# 3. Validate known schema\n","# ------------------------------------------------------------\n","\n","required = [\n","    \"timestamp\",\n","    \"link_id\",\n","    \"milepost\",\n","    \"speed_kmh\",\n","    \"flow_vph\",\n","]\n","\n","missing = [\n","    c for c in required\n","    if c not in df.columns\n","]\n","\n","assert not missing, (\n","    f\"Expected columns missing: {missing}\"\n",")\n","\n","assert df[\"milepost\"].notna().all()\n","\n","print(\n","    \"\\nUnique links:\",\n","    df[\"link_id\"].nunique()\n",")\n","\n","print(\n","    \"Milepost range:\",\n","    df[\"milepost\"].min(),\n","    \"to\",\n","    df[\"milepost\"].max()\n",")\n","\n","# ------------------------------------------------------------\n","# 4. Identify Task 1 target rows\n","# ------------------------------------------------------------\n","\n","target_mask = (\n","    df[\"speed_kmh\"].isna()\n","    & df[\"flow_vph\"].isna()\n",")\n","\n","targets = df.loc[\n","    target_mask,\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"milepost\",\n","    ]\n","].copy()\n","\n","print(\"\\nTarget rows:\", len(targets))\n","\n","print(\n","    \"Target percentage:\",\n","    f\"{100 * len(targets) / len(df):.3f}%\"\n",")\n","\n","# ------------------------------------------------------------\n","# 5. Build verified 1-km neighbor map\n","#\n","# Distance is based ONLY on milepost.\n","#\n","# The target link itself is explicitly excluded.\n","# ------------------------------------------------------------\n","\n","link_meta = (\n","    df[\n","        [\"link_id\", \"milepost\"]\n","    ]\n","    .drop_duplicates(\"link_id\")\n","    .sort_values(\"milepost\")\n","    .reset_index(drop=True)\n",")\n","\n","assert len(link_meta) == 109\n","\n","neighbor_map = {}\n","\n","for row in link_meta.itertuples(index=False):\n","\n","    target_link = row.link_id\n","    target_milepost = row.milepost\n","\n","    neighbors = link_meta.loc[\n","        (\n","            link_meta[\"link_id\"] != target_link\n","        )\n","        &\n","        (\n","            (\n","                link_meta[\"milepost\"]\n","                - target_milepost\n","            ).abs() <= 1.0\n","        ),\n","        \"link_id\"\n","    ].tolist()\n","\n","    neighbor_map[target_link] = neighbors\n","\n","# ------------------------------------------------------------\n","# 6. Neighbor statistics\n","# ------------------------------------------------------------\n","\n","neighbor_counts = np.array([\n","    len(neighbors)\n","    for neighbors in neighbor_map.values()\n","])\n","\n","print(\"\\n1-km neighbor statistics:\")\n","print(\n","    pd.Series(neighbor_counts).describe()\n",")\n","\n","# Explicit self-inclusion test\n","self_inclusion = sum(\n","    link_id in neighbors\n","    for link_id, neighbors\n","    in neighbor_map.items()\n",")\n","\n","print(\n","    \"Self-inclusion count:\",\n","    self_inclusion\n",")\n","\n","assert self_inclusion == 0\n","\n","# ------------------------------------------------------------\n","# 7. Simultaneously observed traffic\n","#\n","# IMPORTANT:\n","# These values come ONLY from the MASKED file.\n","# Therefore masked target cells cannot leak into features.\n","# ------------------------------------------------------------\n","\n","observed = df.loc[\n","    df[\"speed_kmh\"].notna()\n","    & df[\"flow_vph\"].notna(),\n","    [\n","        \"timestamp\",\n","        \"link_id\",\n","        \"speed_kmh\",\n","        \"flow_vph\",\n","    ]\n","].copy()\n","\n","print(\n","    \"\\nObserved traffic rows:\",\n","    len(observed)\n",")\n","\n","# Group simultaneously observed links by timestamp\n","observed_groups = {\n","    timestamp: group.set_index(\"link_id\")\n","    for timestamp, group\n","    in observed.groupby(\"timestamp\")\n","}\n","\n","# ------------------------------------------------------------\n","# 8. Construct local 1-km features\n","# ------------------------------------------------------------\n","\n","results = []\n","\n","for row in targets.itertuples(index=False):\n","\n","    timestamp = row.timestamp\n","    target_link = row.link_id\n","\n","    neighbors = neighbor_map[target_link]\n","\n","    if timestamp not in observed_groups:\n","\n","        results.append(\n","            (\n","                timestamp,\n","                target_link,\n","                np.nan,\n","                np.nan,\n","                np.nan,\n","                np.nan,\n","                0,\n","            )\n","        )\n","\n","        continue\n","\n","    observed_at_time = observed_groups[timestamp]\n","\n","    # Intersection guarantees:\n","    # only observed neighboring links are used.\n","    available = observed_at_time.loc[\n","        observed_at_time.index.intersection(neighbors)\n","    ]\n","\n","    if len(available) == 0:\n","\n","        results.append(\n","            (\n","                timestamp,\n","                target_link,\n","                np.nan,\n","                np.nan,\n","                np.nan,\n","                np.nan,\n","                0,\n","            )\n","        )\n","\n","        continue\n","\n","    speeds = available[\"speed_kmh\"].to_numpy()\n","    flows = available[\"flow_vph\"].to_numpy()\n","\n","    results.append(\n","        (\n","            timestamp,\n","            target_link,\n","            float(np.mean(speeds)),\n","            float(np.quantile(speeds, 0.10)),\n","            float(np.quantile(speeds, 0.25)),\n","            float(np.mean(flows)),\n","            int(len(available)),\n","        )\n","    )\n","\n","# ------------------------------------------------------------\n","# 9. Feature dataframe\n","# ------------------------------------------------------------\n","\n","spatial = pd.DataFrame(\n","    results,\n","    columns=[\n","        \"timestamp\",\n","        \"link_id\",\n","        \"local_1km_speed_mean\",\n","        \"local_1km_speed_q10\",\n","        \"local_1km_speed_q25\",\n","        \"local_1km_flow_mean\",\n","        \"local_1km_observed_link_count\",\n","    ]\n",")\n","\n","# ------------------------------------------------------------\n","# 10. Structural checks\n","# ------------------------------------------------------------\n","\n","assert len(spatial) == len(targets)\n","\n","assert spatial[\"link_id\"].notna().all()\n","\n","assert (\n","    spatial[\n","        \"local_1km_observed_link_count\"\n","    ] >= 0\n",").all()\n","\n","# ------------------------------------------------------------\n","# 11. Diagnostics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"CELL 17A — DIAGNOSTICS\")\n","print(\"=\" * 70)\n","\n","print(\"\\nSpatial feature missingness:\")\n","\n","print(\n","    spatial[\n","        [\n","            \"local_1km_speed_mean\",\n","            \"local_1km_speed_q10\",\n","            \"local_1km_speed_q25\",\n","            \"local_1km_flow_mean\",\n","        ]\n","    ].isna().mean()\n",")\n","\n","print(\"\\nObserved neighboring-link count:\")\n","\n","print(\n","    spatial[\n","        \"local_1km_observed_link_count\"\n","    ].describe()\n",")\n","\n","zero_rate = (\n","    spatial[\n","        \"local_1km_observed_link_count\"\n","    ].eq(0).mean()\n",")\n","\n","coverage_rate = (\n","    spatial[\n","        \"local_1km_observed_link_count\"\n","    ].gt(0).mean()\n",")\n","\n","print(\n","    \"\\nZero-ne