(\n","            \"speed_error\",\n","            lambda x: np.sqrt(\n","                np.mean(x ** 2)\n","            )\n","        ),\n","        flow_mae=(\"abs_flow_error\", \"mean\"),\n","        flow_rmse=(\n","            \"flow_error\",\n","            lambda x: np.sqrt(\n","                np.mean(x ** 2)\n","            )\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","display(lane_error)\n","\n","\n","# ============================================================\n","# FIX — WORST PREDICTIONS\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"WORST SPEED PREDICTIONS\")\n","print(\"=\" * 80)\n","\n","worst_speed = (\n","    error_df\n","    .sort_values(\n","        \"abs_speed_error\",\n","        ascending=False\n","    )\n","    [\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"mask_regime\",\n","            \"target_speed\",\n","            \"pred_speed\",\n","            \"speed_error\",\n","            \"abs_speed_error\",\n","            \"target_flow\",\n","        ]\n","    ]\n","    .head(20)\n",")\n","\n","display(worst_speed)\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"WORST FLOW PREDICTIONS\")\n","print(\"=\" * 80)\n","\n","worst_flow = (\n","    error_df\n","    .sort_values(\n","        \"abs_flow_error\",\n","        ascending=False\n","    )\n","    [\n","        [\n","            \"timestamp\",\n","            \"link_id\",\n","            \"mask_regime\",\n","            \"target_flow\",\n","            \"pred_flow\",\n","            \"flow_error\",\n","            \"abs_flow_error\",\n","            \"target_speed\",\n","        ]\n","    ]\n","    .head(20)\n",")\n","\n","display(worst_flow)\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"CELL 12 ERROR ANALYSIS COMPLETE\")\n","print(\"=\" * 80)\n","\n","# ------------------------------------------------------------\n","# 10. Final checkpoint\n","