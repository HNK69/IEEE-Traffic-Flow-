d_spatial_1km.parquet\"\n",")\n","\n","print(\"Train:\", train.shape)\n","print(\"Validation:\", valid.shape)\n","\n","# ------------------------------------------------------------\n","# 2. Feature definitions — locked from Stage 3\n","# ------------------------------------------------------------\n","\n","PHYSICAL_FEATURES = [\n","    \"length_km\",\n","    \"lanes\",\n","    \"free_speed_kmh\",\n","    \"capacity_vph\",\n","    \"capacity_per_lane\",\n","]\n","\n","TEMPORAL_FEATURES = [\n","    \"speed_lag_1\", \"flow_lag_1\",\n","    \"speed_lag_2\", \"flow_lag_2\",\n","    \"speed_lag_3\", \"flow_lag_3\",\n","    \"speed_lag_6\", \"flow_lag_6\",\n","    \"speed_lag_12\", \"flow_lag_12\",\n","]\n","\n","SPATIAL_FEATURES = [\n","    \"local_1km_speed_mean\",\n","    \"local_1km_speed_q10\",\n","    \"local_1km_speed_q25\",\n","    \"local_1km_flow_mean\",\n","]\n","\n","BASELINE_FEATURES = PHYSICAL_FEATURES + TEMPORAL_FEATURES\n","SPATIAL_MODEL_FEATURES = BASELINE_FEATURES + SPATIAL_FEATURES\n","\n","TARGETS = {\n","    \"speed\": \"speed_kmh_target\",\n","    \"flow\": \"flow_vph_target\",\n","}\n","\n","assert len(BASELINE_FEATURES) == 15\n","assert len(SPATIAL_MODEL_FEATURES) == 19\n","assert len(train) == 1_870_910\n","assert len(valid) == 257_027\n","\n","required = (\n","    SPATIAL_MODEL_FEATURES\n","    + list(TARGETS.values())\n","    + [\"mask_regime\"]\n",")\n","\n","missing = sorted(set(required) - set(train.columns))\n","missing += sorted(set(required) - set(valid.columns))\n","assert not missing, f\"Missing required columns: {sorted(set(missing))}\"\n","\n","assert train[list(TARGETS.values())].notna().all().all()\n","assert valid[list(TARGETS.values())].notna().all().all()\n","\n","# Confirm both feature sets use exactly the same rows.\n","print(\n","    \"Validation spatial availability:\",\n","    round(valid[SPATIAL_FEATURES[0]].notna().mean(), 4)\n",")\n","\n","# ------------------------------------------------------------\n","# 3. Fixed XGBoos