    \"local_1km_speed_q25\", \"local_1km_flow_mean\",\n","]\n","\n","# ------------------------------------------------------------\n","# 2. Find the masked Parquet file for a date\n","# ------------------------------------------------------------\n","def find_date_file(split, date):\n","    folder = (\n","        ROOT / \"corridors\" / PANEL / split\n","        / \"mainline_states_masked\"\n","    )\n","    token = date.replace(\"-\", \"_\")\n","\n","    if not folder.exists():\n","        return []\n","\n","    return sorted(\n","        p for p in folder.rglob(\"*.parquet\")\n","        if token in p.name\n","    )\n","\n","previous_date = (\n","    pd.Timestamp(DATE) - pd.Timedelta(days=1)\n",").strftime(\"%Y-%m-%d\")\n","\n","previous_files = (\n","    find_date_file(\"train\", previous_date)\n","    + find_date_file(\"validation\", previous_date)\n","    + find_date_file(\"private\", previous_date)\n",")\n","current_files = find_date_file(\"validation\", DATE)\n","\n","print(\"Previous-day files:\", [str(p) for p in previous_files])\n","print(\"Target-day files:\", [str(p) for p in current_files])\n","\n","if len(previous_files) != 1:\n","    raise RuntimeError(\n","        f\"Expected one file for {previous_date}; \"\n","        f\"found {len(previous_files)}\"\n","    )\n","\n","if len(current_files) != 1:\n","    raise RuntimeError(\n","        f\"Expected one file for {DATE}; found {len(current_files)}\"\n","    )\n","\n","previous = pd.read_parquet(previous_files[0])\n","current = pd.read_parquet(current_files[0])\n","\n","data = pd.concat([previous, current], ignore_index=True)\n","data[\"timestamp\"] = pd.to_datetime(data[\"timestamp\"], utc=True)\n","data = data.sort_values(\n","    [\"station_id\", \"timestamp\"]\n",").reset_index(drop=True)\n","\n","print(\"Combined masked rows:\", len(data))\n","print(\"Dates:\", data[\"date\"].astype(str).unique())\n","\n","# ------------------------------------------------------------\n","# 3. Add physical/network features\n","# ------------------------------------------------------------\n","links_path = ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\n","links = pd.read_csv(links_path)\n","links[\"capacity_per_lane\"] = (\n","    links[\"capacity_vph\"] / links[\"lanes\"]\n",")\n","\n","data = data.merge(\n","    links[\n","        [\n","            \"link_id\", \"length_km\", \"lanes\",\n","            \"free_speed_kmh\", \"capacity_vph\",\n","            \"capacity_per_lane\",\n","        ]\n","    ],\n","    on=\"link_id\",\n","    how=\"left\",\n","    validate=\"many_to_one\",\n",")\n","\n","# ------------------------------------------------------------\n","# 4. Temporal lags: use masked observations only\n","# ------------------------------------------------------------\n","for lag in [1, 2, 3, 6, 12]:\n","    data[f\"speed_lag_{lag}\"] = (\n","        data.groupby(\"station_id\", sort=False)[\"speed_kmh\"]\n","        .shift(lag)\n","    )\n","    data[f\"flow_lag_{lag}\"] = (\n","        data.groupby(\"station_id\", sort=False)[\"flow_vph\"]\n","        .shift(lag)\n","    )\n","\n","# ------------------------------------------------------------\n","# 5. Spatial features within 1 km\n","# Exclude the target link itself\n","# ------------------------------------------------------------\n","def add_spatial_features(day):\n","    day = day.copy()\n","\n","    spatial_cols = [\n","        \"local_1km_speed_mean\",\n","        \"local_1km_speed_q10\",\n","        \"local_1km_speed_q25\",\n","        \"local_1km_flow_mean\",\n","    ]\n","    for col in spatial_cols:\n","        day[col] = np.nan\n","\n","    for _, group in day.groupby(\"timestamp\", sort=False):\n","        idx = group.index.to_numpy()\n","        mileposts = group[\"milepost\"].to_numpy(dtype=float)\n","        speeds = group[\"speed_kmh\"].to_numpy(dtype=float)\n","        flows = group[\"flow_vph\"].to_numpy(dtype=float)\n","        link_ids = group[\"link_id\"].to_numpy()\n","\n","        for pos, row_idx in enumerate(idx):\n","            neighbor_mask = (\n","                (np.abs(mileposts - mileposts[pos]) <= 1.0)\n","                & (link_ids != link_ids[pos])\n","            )\n","\n","            neighbor_speeds = speeds[neighbor_mask]\n","            neighbor_flows = flows[neighbor_mask]\n","\n","            valid_speeds = neighbor_speeds[\n","                np.isfinite(neighbor_speeds)\n","            ]\n","            valid_flows = neighbor_flows[\n","                np.isfinite(neighbor_flows)\n","            ]\n","\n","            if len(valid_speeds):\n","                day.loc[row_idx, \"local_1km_speed_mean\"] = (\n","                    valid_speeds.mean()\n","                )\n","                day.loc[row_idx, \"local_1km_speed_q10\"] = (\n","                    np.quantile(valid_speeds, 0.10)\n","                )\n","                day.loc[row_idx, \"local_1km_speed_q25\"] = (\n","                    np.quantile(valid_speeds, 0.25)\n","                )\n","\n","            if len(valid_flows):\n","                day.loc[row_idx, \"local_1km_flow_mean\"] = (\n","                    valid_flows.mean()\n","                )\n","\n","    return day\n","\n","today = data[\n","    data[\"date\"].astype(str).eq(DATE)\n","].copy()\n","\n","today = add_spatial_features(today)\n","today[\"panel\"] = PANEL\n","\n","# ------------------------------------------------------------\n","# 6. Load Task 1 target rows for the date\n","# ------------------------------------------------------------\n","target_path = (\n","    ROOT / \"task1\" / PANEL / \"validation\"\n","    / \"sample_submission_state.csv\"\n",")\n","targets = pd.read_csv(target_path)\n","targets[\"timestamp\"] = pd.to_datetime(\n","    targets[\"timestamp\"], utc=True\n",")\n","\n","targets_day = targets[\n","    targets[\"timestamp\"].dt.strftime(\"%Y-%m-%d\").eq(DATE)\n","].copy()\n","\n","join_keys = [\n","    \"panel\", \"timestamp\", \"station_id\",\n","    \"link_id\", \"mask_regime\",\n","]\n","\n","features = targets_day[join_keys].merge(\n","    today[join_keys + FEATURES],\n","    on=join_keys,\n","    how=\"left\",\n","    validate=\"one_to_one\",\n",")\n","\n","print(\"\\nTarget rows:\", len(targets_day))\n","print(\"Feature rows:\", len(features))\n","print(\n","    \"Rows with all features missing:\",\n","    features[FEATURES].isna().all(axis=1).sum(),\n",")\n","print(\n","    \"Complete feature coverage:\",\n","    f\"{features[FEATURES].notna().all(axis=1).mean():.2%}\",\n",")\n","\n","if features[\n","    [\n","        \"length_km\", \"lanes\", \"free_speed_kmh\",\n","        \"capacity_vph\", \"capacity_per_lane\",\n","    ]\n","].isna().any().any():\n","    raise RuntimeError(\"Physical feature join has missing values.\")\n","\n","# ------------------------------------------------------------\n","# 7. Predict\n","# ------------------------------------------------------------\n","X = features[FEATURES]\n","\n","features[\"pred_speed_kmh\"] = speed_model.predict(X)\n","features[\"pred_flow_vph\"] = flow_model.predict(X)\n","\n","# Basic physical bounds\n","features[\"pred_speed_kmh\"] = features[\n","    \"pred_speed_kmh\"\n","].clip(lower=0, upper=150)\n","\n","features[\"pred_flow_vph\"] = features[\n","    \"pred_flow_vph\"\n","].clip(lower=0)\n","\n","# ------------------------------------------------------------\n","# 8. Save diagnostic predictions\n","# ------------------------------------------------------------\n","output_path = OUT / \"cell9_D7_I405_S_2031-03-01.csv\"\n","\n","features[\n","    join_keys + FEATURES\n","    + [\"pred_speed_kmh\", \"pred_flow_vph\"]\n","].to_csv(output_path, index=False)\n","\n","print(\"\\nSaved:\", output_path)\n","print(\n","    features[\n","        [\"pred_speed_kmh\", \"pred_flow_vph\"]\n","    ].describe()\n",")\n","print(\"\\nCell 9 complete. No final submission was created.\")\n"]},{"cell_type":"code","execution_count":29,"id":"fb2c1203","metadata":{"execution":{"i