================================================\n","BUILDING VALIDATION DATA\n","================================================================================\n","Validation masked files: 20/31 | rows: 166,021\n","Validation masked files: 31/31 | rows: 257,027\n","\n","================================================================================\n","MULTI-REGIME DATASET SUMMARY\n","================================================================================\n","Training rows: 1870910\n","Validation rows: 257027\n","Features: 25\n","Training date range: 2030-06-01 00:00:00+00:00 -> 2031-01-28 23:55:00+00:00\n","Validation date range: 2031-01-29 00:00:00+00:00 -> 2031-02-28 23:55:00+00:00\n","\n","================================================================================\n","TARGET ROWS BY REGIME\n","================================================================================\n","mask_regime\n","R1    408020\n","R2    624118\n","R3    838772\n","Name: count, dtype: int64\n","\n","Validation:\n","mask_regime\n","R1     19157\n","R2    129646\n","R3    108224\n","Name: count, dtype: int64\n","\n","================================================================================\n","PHYSICAL FEATURE AVAILABILITY\n","================================================================================\n","length_km            1.0\n","lanes                1.0\n","free_speed_kmh       1.0\n","capacity_vph         1.0\n","capacity_per_lane    1.0\n","dtype: float64\n","\n","================================================================================\n","TEMPORAL FEATURE AVAILABILITY\n","================================================================================\n","speed_lag_1     0.571999\n","flow_lag_1      0.571999\n","speed_lag_2     0.566486\n","flow_lag_2      0.566486\n","speed_lag_3     0.561764\n","flow_lag_3      0.561764\n","speed_lag_6     0.548621\n","flow_lag_6      0.548621\n","speed_lag_12    0.531294\n","flow_lag_12     0.531294\n","dtype: float64\n","\n","================================================================================\n","CELL 10 CHECKPOINT\n","================================================================================\n","✓ All actual masked regimes discovered\n","✓ Mask coverage measured before modeling\n","✓ Truth coverage verified\n","✓ Multi-regime chronological dataset constructed\n","✓ Train/validation dates strictly separated\n","✓ Features generated from masked observations only\n","✓ Ground truth used only as targets\n","✓ Physical metadata merged safely\n","\n","CELL 10 COMPLETE\n"]}],"source":["# ============================================================\n","# CELL 10 — MULTI-REGIME CHRONOLOGICAL ABLATION DATASET\n","# ============================================================\n","\n","from pathlib import Path\n","import pandas as pd\n","import numpy as np\n","\n","\n","# ------------------------------------------------------------\n","# 1. Configuration\n","# ------------------------------------------------------------\n","\n","DATA_ROOT = Path(\n","    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n","    \"kaggle_public\"\n",")\n","\n","PANEL = \"D7_I405_S\"\n","\n","CORRIDOR_DIR = (\n","    DATA_ROOT\n","    / \"corridors\"\n","    / PANEL\n",")\n","\n","MASKED_ROOT = (\n","    CORRIDOR_DIR\n","    / \"train\"\n","    / \"mainline_states_masked\"\n",")\n","\n","TRUTH_ROOT = (\n","    CORRIDOR_DIR\n","    / \"train\"\n","    / \"mainline_states\"\n",")\n","\n","LINKS_PATH = (\n","    CORRIDOR_DIR\n","    / \"network\"\n","    / \"links.csv\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2. Stage 2 chronological split\n","# ------------------------------------------------------------\n","\n","TRAIN_START = pd.Timestamp(\n","    \"2030-06-01\",\n","    tz=\"UTC\"\n",")\n","\n","TRAIN_END = pd.Timestamp(\n","    \"2031-01-28\",\n","    tz=\"UTC\"\n",")\n","\n","VALID_START = pd.Timestamp(\n","    \"2031-01-29\",\n","    tz=\"UTC\"\n",")\n","\n","VALID_END = pd.Timestamp(\n","    \"2031-02-28\",\n","    tz=\"UTC\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3. Feature definitions\n","# ------------------------------------------------------------\n","\n","TEMPORAL_FEATURES = [\n","    \"speed_lag_1\",\n","    \"flow_lag_1\",\n","    \"speed_lag_2\",\n","    \"flow_lag_2\",\n","    \"speed_lag_3\",\n","    \"flow_lag_3\",\n","    \"speed_lag_6\",\n","    \"flow_lag_6\",\n","    \"speed_lag_12\",\n","    \"flow_lag_12\",\n","]\n","\n","AVAILABILITY_FEATURES = [\n","    \"speed_lag_1_available\",\n","    \"flow_lag_1_available\",\n","    \"speed_lag_2_available\",\n","    \"flow_lag_2_available\",\n","    \"speed_lag_3_available\",\n","    \"flow_lag_3_available\",\n","    \"speed_lag_6_available\",\n","    \"flow_lag_6_available\",\n","    \"speed_lag_12_available\",\n","    \"flow_lag_12_available\",\n","]\n","\n","PHYSICAL_FEATURES = [\n","    \"length_km\",\n","    \"lanes\",\n","    \"free_speed_kmh\",\n","    \"capacity_vph\",\n","    \"capacity_per_lane\",\n","]\n","\n","\n","# ------------------------------------------------------------\n","# 4. Load physical metadata\n","# ------------------------------------------------------------\n","\n","links = pd.read_csv(\n","    LINKS_PATH\n",")\n","\n","links[\"link_id\"] = (\n","    links[\"link_id\"].astype(str)\n",")\n","\n","links = links[\n","    [\n","        \"link_id\",\n","        \"length_km\",\n","        \"lanes\",\n","        \"free_speed_kmh\",\n","        \"capacity_vph\",\n","    ]\n","].copy()\n","\n","links[\"capacity_per_lane\"] = (\n","    links[\"capacity_vph\"]\n","    / links[\"lanes\"]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Discover ALL masked files\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 80)\n","print(\"DISCOVERING MASKED FILES\")\n","print(\"=\" * 80)\n","\n","masked_file_records = []\n","\n","for regime_dir in sorted(\n","    MASKED_ROOT.glob(\"mask_regime=*\")\n","):\n","\n","    regime = regime_dir.name.replace(\n","        \"mask_regime=\",\n","        \"\"\n","    )\n","\n","    for path in sorted(\n","        regime_dir.glob(\"*.parquet\")\n","    ):\n","\n","        # Read only timestamp to determine actual date.\n","        head = pd.read_parquet(\n","            path,\n","            columns=[\"timestamp\"]\n","        )\n","\n","        timestamps = pd.to_datetime(\n","            head[\"timestamp\"]\n","        )\n","\n","        unique_dates = (\n","            timestamps\n","            .dt.normalize()\n","            .unique()\n","        )\n","\n","        assert len(unique_dates) == 1, (\n","            f\"Multiple dates found in: {path}\"\n","        )\n","\n","        date = pd.Timestamp(\n","            unique_dates[0]\n","        )\n","\n","        masked_file_records.append({\n","            \"date\": date,\n","            \"regime\": regime,\n","            \"path\": path,\n","        })\n","\n","\n","masked_inventory = pd.DataFrame(\n","    masked_file_records\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Discover truth files\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 80)\n","print(\"DISCOVERING TRUTH FILES\")\n","print(\"=\" * 80)\n","\n","truth_files = sorted(\n","    TRUTH_ROOT.glob(\n","        \"**/*.parquet\"\n","    )\n",")\n","\n","truth_file_records = []\n","\n","for path in truth_files:\n","\n","    head = pd.read_parquet(\n","        path,\n","        columns=[\"timestamp\"]\n","    )\n","\n","    timestamps = pd.to_datetime(\n","        head[\"timestamp\"]\n","    )\n","\n","    unique_dates = (\n","        timestamps\n","        .dt.normalize()\n","        .unique()\n","    )\n","\n","    assert len(unique_dates) == 1, (\n","        f\"Multiple dates found in: {path}\"\n","    )\n","\n","    date = pd.Timestamp(\n","        unique_dates[0]\n","    )\n","\n","    truth_file_records.append({\n","        \"date\": date,\n","        \"path\": path,\n","    })\n","\n","\n","truth_inventory = pd.DataFrame(\n","    truth_file_records\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Inventory summary\n","# ------------------------------------------------------------\n","\n","print(\n","    \"Total masked files:\",\n","    len(masked_inventory)\n",")\n","\n","print(\n","    \"Total truth files:\",\n","    len(truth_inventory)\n",")\n","\n","print(\"\\nMasked files by regime:\")\n","\n","print(\n","    masked_inventory[\n","        \"regime\"\n","    ].value_counts()\n","    .sort_index()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 8. Build date ranges\n","# ------------------------------------------------------------\n","\n","train_dates = pd.date_range(\n","    TRAIN_START.normalize(),\n","    TRAIN_END.normalize(),\n","    freq=\"D\"\n",")\n","\n","valid_dates = pd.date_range(\n","    VALID_START.normalize(),\n","    VALID_END.normalize(),\n","    freq=\"D\"\n",")\n","\n","train_date_set = set(\n","    train_dates\n",")\n","\n","valid_date_set = set(\n","    valid_dates\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 9. Determine actual masked coverage\n","# ------------------------------------------------------------\n","\n","masked_inventory[\"split\"] = np.where(\n","    masked_inventory[\"date\"].isin(\n","        train_date_set\n","    ),\n","    \"train\",\n","    np.where(\n","        masked_inventory[\"date\"].isin(\n","            valid_date_set\n","        ),\n","        \"validation\",\n","        \"outside\"\n","    )\n",")\n","\n","coverage = (\n","    masked_inventory[\n","        masked_inventory[\"split\"] != \"outside\"\n","    ]\n","    .groupby(\n","        [\"split\", \"regime\"]\n","    )\n","    .agg(\n","        days=(\"date\", \"nunique\"),\n","        files=(\"path\", \"count\")\n","    )\n","    .reset_index()\n",")\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"ACTUAL MASK COVERAGE\")\n","print(\"=\" * 80)\n","\n","display(coverage)\n","\n","\n","# ------------------------------------------------------------\n","# 10. Check truth coverage\n","# ------------------------------------------------------------\n","\n","truth_dates = set(\n","    truth_inventory[\"date\"]\n",")\n","\n","missing_truth_train = [\n","    d for d in train_dates\n","    if d not in truth_dates\n","]\n","\n","missing_truth_valid = [\n","    d for d in valid_dates\n","    if d not in truth_dates\n","]\n","\n","print(\n","    \"\\nMissing train truth dates:\",\n","    len(missing_truth_train)\n",")\n","\n","print(\n","    \"Missing validation truth dates:\",\n","    len(missing_truth_valid)\n",")\n","\n","assert not missing_truth_train\n","assert not missing_truth_valid\n","\n","print(\n","    \"Truth coverage: ✓\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 11. Build lookup dictionaries\n","# ------------------------------------------------------------\n","\n","truth_file_map = dict(\n","    zip(\n","        truth_inventory[\"date\"],\n","        truth_inventory[\"path\"]\n","    )\n",")\n","\n","masked_records = (\n","    masked_inventory[\n","        masked_inventory[\"split\"].isin(\n","            [\"train\", \"validation\"]\n","        )\n","    ]\n","    .sort_values(\n","        [\"date\", \"regime\"]\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Feature construction\n","# ------------------------------------------------------------\n","\n","def build_masked_day_features(\n","    date,\n","    regime,\n","    masked_path,\n","    truth_path,\n","    links\n","):\n","    \"\"\"\n","    Construct model features for one actual\n","    competition masked file.\n","\n","    Traffic features:\n","        masked file only.\n","\n","    Physical features:\n","        static network metadata.\n","\n","    Ground truth:\n","        used only to construct targets.\n","    \"\"\"\n","\n","    masked = pd.read_parquet(\n","        masked_path\n","    )\n","\n","    truth = pd.read_parquet(\n","        truth_path\n","    )\n","\n","    masked[\"timestamp\"] = pd.to_datetime(\n","        masked[\"timestamp\"]\n","    )\n","\n","    truth[\"timestamp\"] = pd.to_datetime(\n","        truth[\"timestamp\"]\n","    )\n","\n","    masked[\"link_id\"] = (\n","        masked[\"link_id\"].astype(str)\n","    )\n","\n","    truth[\"link_id\"] = (\n","        truth[\"link_id\"].astype(str)\n","    )\n","\n","    KEYS_DAY = [\n","        \"timestamp\",\n","        \"station_id\",\n","        \"link_id\"\n","    ]\n","\n","    # --------------------------------------------------------\n","    # Temporal features\n","    # --------------------------------------------------------\n","\n","    masked = masked.sort_values(\n","        [\"link_id\", \"timestamp\"]\n","    ).reset_index(drop=True)\n","\n","    grouped = masked.groupby(\n","        \"link_id\",\n","        sort=False\n","    )\n","\n","    for lag in [1, 2, 3, 6, 12]:\n","\n","        masked[\n","            f\"speed_lag_{lag}\"\n","        ] = grouped[\n","            \"speed_kmh\"\n","        ].shift(lag)\n","\n","        masked[\n","            f\"flow_lag_{lag}\"\n","        ] = grouped[\n","            \"flow_vph\"\n","        ].shift(lag)\n","\n","        masked[\n","            f\"speed_lag_{lag}_available\"\n","        ] = (\n","            masked[\n","                f\"speed_lag_{lag}\"\n","            ]\n","            .notna()\n","            .astype(\"int8\")\n","        )\n","\n","        masked[\n","            f\"flow_lag_{lag}_available\"\n","        ] = (\n","            masked[\n","                f\"flow_lag_{lag}\"\n","            ]\n","            .notna()\n","            .astype(\"int8\")\n","        )\n","\n","    # --------------------------------------------------------\n","    # Physical features\n","    # --------------------------------------------------------\n","\n","    masked = masked.merge(\n","        links,\n","        on=\"link_id\",\n","        how=\"left\",\n","        validate=\"many_to_one\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Ground truth\n","    # --------------------------------------------------------\n","\n","    truth_targets = truth[\n","        KEYS_DAY\n","        + [\n","            \"speed_kmh\",\n","            \"flow_vph\"\n","        ]\n","    ].rename(\n","        columns={\n","            \"speed_kmh\": \"target_speed\",\n","            \"flow_vph\": \"target_flow\"\n","        }\n","    )\n","\n","    result = masked.merge(\n","        truth_targets,\n","        on=KEYS_DAY,\n","        how=\"left\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Actual masked targets\n","    # --------------------------------------------------------\n","\n","    target_mask = (\n","        result[\"speed_kmh\"].isna()\n","        & result[\"flow_vph\"].isna()\n","        & result[\"target_speed\"].notna()\n","        & result[\"target_flow\"].notna()\n","    )\n","\n","    result = result.loc[\n","        target_mask\n","    ].copy()\n","\n","    # --------------------------------------------------------\n","    # Add regime as metadata\n","    # --------------------------------------------------------\n","\n","    result[\"mask_regime\"] = regime\n","\n","    # --------------------------------------------------------\n","    # Final columns\n","    # --------------------------------------------------------\n","\n","    feature_cols = (\n","        TEMPORAL_FEATURES\n","        + AVAILABILITY_FEATURES\n","        + PHYSICAL_FEATURES\n","    )\n","\n","    result = result[\n","        KEYS_DAY\n","        + [\"mask_regime\"]\n","        + feature_cols\n","        + [\n","            \"target_speed\",\n","            \"target_flow\"\n","        ]\n","    ]\n","\n","    return result\n","\n","\n","# ------------------------------------------------------------\n","# 13. Build training data\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"BUILDING TRAINING DATA\")\n","print(\"=\" * 80)\n","\n","train_records = masked_records[\n","    masked_records[\"split\"] == \"train\"\n","]\n","\n","train_parts = []\n","\n","for i, row in enumerate(\n","    train_records.itertuples(index=False),\n","    start=1\n","):\n","\n","    day_df = build_masked_day_features(\n","        row.date,\n","        row.regime,\n","        row.path,\n","        truth_file_map[row.date],\n","        links\n","    )\n","\n","    train_parts.append(\n","        day_df\n","    )\n","\n","    if (\n","        i % 20 == 0\n","        or i == len(train_records)\n","    ):\n","\n","        print(\n","            f\"Train masked files: \"\n","            f\"{i}/{len(train_records)} | \"\n","            f\"rows: \"\n","            f\"{sum(len(x) for x in train_parts):,}\"\n","        )\n","\n","\n","train_multi = pd.concat(\n","    train_parts,\n","    ignore_index=True\n",")\n","\n","del train_parts\n","\n","\n","# ------------------------------------------------------------\n","# 14. Build validation data\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"BUILDING VALIDATION DATA\")\n","print(\"=\" * 80)\n","\n","valid_records = masked_records[\n","    masked_records[\"split\"] == \"validation\"\n","]\n","\n","valid_parts = []\n","\n","for i, row in enumerate(\n","    valid_records.itertuples(index=False),\n","    start=1\n","):\n","\n","    day_df = build_masked_day_features(\n","        row.date,\n","        row.regime,\n","        row.path,\n","        truth_file_map[row.date],\n","     