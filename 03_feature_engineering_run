S].itertuples(\n","            index=False,\n","            name=None\n","        )\n","    )\n",")\n","\n","truth_keys = set(\n","    map(\n","        tuple,\n","        truth[KEYS].itertuples(\n","            index=False,\n","            name=None\n","        )\n","    )\n",")\n","\n","assert masked_keys == truth_keys\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"GRID\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Unique timestamps:\",\n","    masked[\"timestamp\"].nunique()\n",")\n","\n","print(\n","    \"Unique links:\",\n","    masked[\"link_id\"].nunique()\n",")\n","\n","print(\n","    \"Unique stations:\",\n","    masked[\"station_id\"].nunique()\n",")\n","\n","print(\n","    \"Grid rows:\",\n","    len(masked)\n",")\n","\n","print(\n","    \"✓ Masked and truth grids match\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6. Identify deliberately masked target cells\n","# ------------------------------------------------------------\n","\n","merged = masked[\n","    KEYS + TARGET_COLUMNS\n","].merge(\n","    truth[\n","        KEYS + TARGET_COLUMNS\n","    ],\n","    on=KEYS,\n","    how=\"inner\",\n","    suffixes=(\n","        \"_masked\",\n","        \"_truth\"\n","    )\n",")\n","\n","target_mask = (\n","    merged[\"speed_kmh_masked\"].isna()\n","    & merged[\"flow_vph_masked\"].isna()\n","    & merged[\"speed_kmh_truth\"].notna()\n","    & merged[\"flow_vph_truth\"].notna()\n",")\n","\n","targets = merged[\n","    target_mask\n","].copy()\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"TARGET CELLS\")\n","print(\"=\" * 80)\n","\n","print(\n","    \"Masked target rows:\",\n","    len(targets)\n",")\n","\n","print(\n","    \"Total rows:\",\n","    len(merged)\n",")\n","\n","print(\n","    \"Target percentage:\",\n","    100 * len(targets) / len(merged)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Simultaneous observed links\n","# ---------------------