nDATE_FILE = DATE.replace(\"-\", \"_\")\n\nmasked_path = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n    / \"train\"\n    / \"mainline_states_masked\"\n    / f\"mask_regime={MASK_REGIME}\"\n    / f\"synthetic_mainline_{DATE_FILE}.parquet\"\n)\n\noriginal_path = (\n    DATA_ROOT\n    / \"corridors\"\n    / PANEL\n    / \"train\"\n    / \"mainline_states\"\n    / f\"year_month={DATE[:7]}\"\n    / f\"synthetic_mainline_{DATE_FILE}.parquet\"\n)\n\nassert masked_path.exists()\nassert original_path.exists()\n\noriginal = pd.read_parquet(original_path)\nmasked = pd.read_parquet(masked_path)\n\noriginal[\"timestamp\"] = pd.to_datetime(\n    original[\"timestamp\"],\n    utc=True\n)\n\nmasked[\"timestamp\"] = pd.to_datetime(\n    masked[\"timestamp\"],\n    utc=True\n)\n\nOBS_KEY = [\n    \"timestamp\",\n    \"station_id\",\n    \"link_id\"\n]\n\ncomparison = original[\n    OBS_KEY + [\"speed_kmh\", \"flow_vph\"]\n].rename(\n    columns={\n        \"speed_kmh\": \"speed_original\",\n        \"flow_vph\": \"flow_original\"\n    }\n).merge(\n    masked[\n        OBS_KEY + [\"speed_kmh\", \"flow_vph\"]\n    ].rename(\n        columns={\n            \"speed_kmh\": \"speed_masked\",\n            \"flow_vph\": \"flow_masked\"\n        }\n    ),\n    on=OBS_KEY,\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\nassert len(comparison) == len(original)\n\n# ------------------------------------------------------------\n# Define genuine competition targets\n# ------------------------------------------------------------\n\noriginally_observed = (\n    comparison[\"speed_original\"].notna()\n    & comparison[\"flow_original\"].notna()\n)\n\ncompetition_masked = (\n    originally_observed\n    & comparison[\"speed_masked\"].isna()\n    & comparison[\"flow_masked\"].isna()\n)\n\ntargets = comparison.loc[\n    competition_masked\n].copy()\n\nprint(\"=\" * 60)\nprint(\"COMPETITION MASK STRUCTURE\")\nprint(\"=\" * 60)\n\nprint(\"Panel:\", PANEL)\nprint(\"Date:\", DATE)\nprint(\"Regime:\", MASK_REGIME)\nprint(\"Competition target rows:\", len(targets))\n\n\n# ------------------------------------------------------------\n# 1. Targets per timestamp\n# ------------------------------------------------------------\n\ntimestamp_counts = (\n    targets\n    .groupby(\"timestamp\")\n    .size()\n)\n\nprint(\"\\n========== TARGETS PER TIMESTAMP ==========\")\n\nprint(\n    \"Min:\",\n    timestamp_counts.min()\n)\n\nprint(\n    \"Max:\",\n    timestamp_counts.max()\n)\n\nprint(\n    \"Mean:\",\n    timestamp_counts.mean()\n)\n\nprint(\n    \"Median:\",\n    timestamp_counts.median()\n)\n\n\n# ------------------------------------------------------------\n# 2. Fraction of eligible cells masked at each timestamp\n# ------------------------------------------------------------\n\noriginally_observed_df = comparison.loc[\n    originally_observed\n].copy()\n\neligible_per_timestamp = (\n    originally_observed_df\n    .groupby(\"timestamp\")\n    .size()\n)\n\nmasked_per_timestamp = (\n    targets\n    .groupby(\"timestamp\")\n    .size()\n)\n\ntimestamp_mask_rate = (\n    masked_per_timestamp\n    .reindex(\n        eligible_per_timestamp.index,\n        fill_value=0\n    )\n    / eligible_per_timestamp\n    * 100\n)\n\nprint(\"\\n========== MASK RATE BY TIMESTAMP ==========\")\n\nprint(\n    \"Minimum:\",\n    timestamp_mask_rate.min()\n)\n\nprint(\n    \"Maximum:\",\n    timestamp_mask_rate.max()\n)\n\nprint(\n    \"Mean:\",\n    timestamp_mask_rate.mean()\n)\n\nprint(\n    \"Median:\",\n    timestamp_mask_rate.median()\n)\n\n\n# ------------------------------------------------------------\n# 3. Distribution of timestamp-level masking rates\n# ------------------------------------------------------------\n\nprint(\"\\n========== MASK RATE QUANTILES ==========\")\n\nprint(\n    timestamp_mask_rate.quantile(\n        [0.00, 0.25, 0.50, 0.75, 1.00]\n    )\n)\n\n\n# ------------------------------------------------------------\n# 4. Targets per link\n# ------------------------------------------------------------\n\nlink_counts = (\n    targets\n    .groupby(\"link_id\")\n    .size()\n)\n\nprint(\"\\n========== TARGETS PER LINK ==========\")\n\nprint(\n    \"Min:\",\n    link_counts.min()\n)\n\nprint(\n    \"Max:\",\n    link_counts.max()\n)\n\nprint(\n    \"Mean:\",\n    link_counts.mean()\n)\n\nprint(\n    \"Median:\",\n    link_counts.median()\n)\n\n\n# ------------------------------------------------------------\n# 5. Final\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"CELL 06 COMPLETE\")\nprint(\"=\" * 60)\n\nprint(\n    \"We have measured how competition masking is distributed \"\n    \"across time and links.\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T17:59:58.013852Z","iopub.execute_input":"2026-10-07T17:59:58.01442Z","iopub.status.idle":"2026-10-07T17:59:58.152397Z","shell.execute_reply.started":"2026-10-07T17:59:58.014259Z","shell.execute_reply":"2026-10-07T17:59:58.151194Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"============================================================\nCOMPETITION MASK STRUCTURE\n============================================================\nPanel: D7_I405_S\nDate: 2031-02-26\nRegime: R3\nCompetition target rows: 11902\n\n========== TARGETS PER TIMESTAMP ==========\nMin: 28\nMax: 54\nMean: 41.326388888888886\nMedian: 41.0\n\n========== MASK RATE BY TIMESTAMP ==========\nMinimum: 32.22222222222222\nMaximum: 60.67415730337079\nMean: 45.54504945907495\nMedian: 45.45454545454545\n\n========== MASK RATE QUANTILES ==========\n0.00    32.222222\n0.25    42.391304\n0.50    45.454545\n0.75    49.094244\n1.00    60.674157\ndtype: float64\n\n========== TARGETS PER LINK ==========\nMin: 79\nMax: 137\nMean: 109.19266055045871\nMedian: 109.0\n\n============================================================\nCELL 06 COMPLETE\n============================================================\nWe have measured how competition masking is distributed across time and links.\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"# ============================================================\n# STAGE 2 — VALIDATION STRATEGY\n# CHECKPOINT 2.2 — MASK SIMULATION\n# CELL 07 — MASK DEPENDENCE ANALYSIS\n# ============================================================\n\n# Reuse:\n# comparison\n# competition_masked\n# originally_observed\n\nanalysis = comparison.copy()\n\nanalysis[\"originally_observed\"] = originally_observed\nanalysis[\"competition_masked\"] = competition_masked\n\n# ------------------------------------------------------------\n# 1. Mask rate by timestamp\n# ------------------------------------------------------------\n\ntimestamp_mask_rate = (\n    analysis.loc[analysis[\"originally_observed\"]]\n    .groupby(\"timestamp\")[\"competition_masked\"]\n    .mean()\n)\n\n# ------------------------------------------------------------\n# 2. Mask rate by link\n# ------------------------------------------------------------\n\nlink_mask_rate = (\n    analysis.loc[analysis[\"originally_observed\"]]\n    .groupby(\"link_id\")[\"competition_masked\"]\n    .mean()\n)\n\nprint(\"=\" * 60)\nprint(\"MASK DEPENDENCE ANALYSIS\")\nprint(\"=\" * 60)\n\nprint(\"\\nTimestamp mask-rate std:\")\nprint(timestamp_mask_rate.std())\n\nprint(\"\\nLink mask-rate std:\")\nprint(link_mask_rate.std())\n\n\n# ------------------------------------------------------------\n# 3. Consecutive temporal masking\n# ------------------------------------------------------------\n\nanalysis = analysis.sort_values(\n    [\"link_id\", \"timestamp\"]\n).copy()\n\nanalysis[\"prev_masked\"] = (\n    analysis\n    .groupby(\"link_id\")[\"competition_masked\"]\n    .shift(1)\n)\n\nanalysis[\"next_masked\"] = (\n    analysis\n    .groupby(\"link_id\")[\"competition_masked\"]\n    .shift(-1)\n)\n\nvalid_prev = analysis[\n    analysis[\"originally_observed\"]\n    & analysis[\"prev_masked\"].notna