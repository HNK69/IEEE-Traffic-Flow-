9</td>\n      <td>20.906600</td>\n      <td>61.987130</td>\n      <td>6563</td>\n    </tr>\n    <tr>\n      <th>29</th>\n      <td>D7_I405_S</td>\n      <td>R3</td>\n      <td>2030_06_01</td>\n      <td>31392</td>\n      <td>17.185907</td>\n      <td>36.706804</td>\n      <td>46.107288</td>\n      <td>11523</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n========== GLOBAL SUMMARY ==========\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                           metric          value\n0         Panel × regime examples      30.000000\n1          Mean natural missing %      16.588241\n2       Mean competition masked %      24.410130\n3          Mean still available %      59.001629\n4  Total valid validation targets  330356.000000","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>metric</th>\n      <th>value</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Panel × regime examples</td>\n      <td>30.000000</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Mean natural missing %</td>\n      <td>16.588241</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Mean competition masked %</td>\n      <td>24.410130</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>Mean still available %</td>\n      <td>59.001629</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>Total valid validation targets</td>\n      <td>330356.000000</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n============================================================\nCELL 04 — GLOBAL TARGET AUDIT COMPLETE\n============================================================\nAcross all panel × regime examples, originally observed cells hidden by the competition mask provide valid ground-truth validation targets.\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# ============================================================\n# STAGE 2 — VALIDATION STRATEGY\n# CHECKPOINT 2.1 — TARGET CONSTRUCTION\n# CELL 05 — COMPETITION MASKING RATE AUDIT\n# ============================================================\n\nPANELS = sorted([\n    p.name\n    for p in (DATA_ROOT / \"corridors\").iterdir()\n    if p.is_dir()\n])\n\nMASK_REGIMES = [\"R1\", \"R2\", \"R3\"]\n\nOBS_KEY = [\n    \"timestamp\",\n    \"station_id\",\n    \"link_id\"\n]\n\nTARGET_COLUMNS = [\n    \"speed_kmh\",\n    \"flow_vph\"\n]\n\nresults = []\n\n\n# ------------------------------------------------------------\n# 1. Use the already established train structure\n# ------------------------------------------------------------\n\nfor panel in PANELS:\n\n    masked_root = (\n        DATA_ROOT\n        / \"corridors\"\n        / panel\n        / \"train\"\n        / \"mainline_states_masked\"\n    )\n\n    original_root = (\n        DATA_ROOT\n        / \"corridors\"\n        / panel\n        / \"train\"\n        / \"mainline_states\"\n    )\n\n    for regime in MASK_REGIMES:\n\n        masked_files = sorted(\n            (\n                masked_root / f\"mask_regime={regime}\"\n            ).glob(\"*.parquet\")\n        )\n\n        assert masked_files, (\n            f\"No files found: {panel} {regime}\"\n        )\n\n        # Use the same controlled first file strategy\n        masked_path = masked_files[0]\n\n        filename = masked_path.name\n\n        date_part = (\n            filename\n            .replace(\"synthetic_mainline_\", \"\")\n            .replace(\".parquet\", \"\")\n        )\n\n        original_month = date_part[:7].replace(\"_\", \"-\")\n\n        original_path = (\n            original_root\n            / f\"year_month={original_month}\"\n            / filename\n        )\n\n        assert original_path.exists(), (\n            f\"Original file not found:\\n{original_path}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 2. Load traffic targets\n        # ----------------------------------------------------\n\n        original = pd.read_parquet(\n            original_path,\n            columns=OBS_KEY + TARGET_COLUMNS\n        )\n\n        masked = pd.read_parquet(\n            masked_path,\n            columns=OBS_KEY + TARGET_COLUMNS\n        )\n\n\n        # ----------------------------------------------------\n        # 3. Normalize timestamps\n        # ----------------------------------------------------\n\n        original[\"timestamp\"] = pd.to_datetime(\n            original[\"timestamp\"],\n            utc=True\n        )\n\n        masked[\"timestamp\"] = pd.to_datetime(\n            masked[\"timestamp\"],\n            utc=True\n        )\n\n\n        # ----------------------------------------------------\n        # 4. Rename target columns\n        # ----------------------------------------------------\n\n        original = original.rename(\n            columns={\n                \"speed_kmh\": \"speed_original\",\n                \"flow_vph\": \"flow_original\"\n            }\n        )\n\n        masked = masked.rename(\n            columns={\n                \"speed_kmh\": \"speed_masked\",\n                \"flow_vph\": \"flow_masked\"\n            }\n        )\n\n\n        # ----------------------------------------------------\n        # 5. Join original and masked data\n        # ----------------------------------------------------\n\n        comparison = original.merge(\n            masked,\n            on=OBS_KEY,\n            how=\"inner\",\n            validate=\"one_to_one\"\n        )\n\n        assert len(comparison) == len(original), (\n            f\"Join mismatch: {panel} {regime}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 6. Define originally observed cells\n        # ----------------------------------------------------\n\n        originally_observed = (\n            comparison[\"speed_original\"].notna()\n            & comparison[\"flow_original\"].notna()\n        )\n\n\n        # ----------------------------------------------------\n        # 7. Define cells hidden by competition\n        # ----------------------------------------------------\n\n        competition_masked = (\n            comparison[\"speed_masked\"].isna()\n            & comparison[\"flow_masked\"].isna()\n        )\n\n\n        # ----------------------------------------------------\n        # 8. Compute conditional masking rate\n        # ----------------------------------------------------\n\n        observed_count = originally_observed.sum()\n\n        masked_observed_count = (\n            originally_observed\n            & competition_masked\n        ).sum()\n\n        assert observed_count > 0\n\n        masking_rate = (\n            masked_observed_count\n            / observed_count\n            * 100\n        )\n\n\n        # ----------------------------------------------------\n        # 9. Store result\n        # ----------------------------------------------------\n\n        results.append({\n            \"panel\": panel,\n            \"mask_regime\": regime,\n            \"total_rows\": len(comparison),\n            \"originally_observed_rows\": int(observed_count),\n            \"competition_masked_rows\": int(\n                masked_observed_count\n            ),\n            \"masking_rate_on_observed_pct\": masking_rate\n        })\n\n\n# ------------------------------------------------------------\n# 10. Display results\n# ------------------------------------------------------------\n\nmask_audit = pd.DataFrame(results)\n\nprint(\"=\" * 60)\nprint(\"COMPETITION MASKING RATE ON ORIGINALLY OBSERVED CELLS\")\nprint(\"=\" * 60)\n\ndisplay(\n    mask_audit.sort_values(\n        [\"mask_regime\", \"panel\"]\n    ).reset_index(drop=True)\n)\n\n\n# ------------------------------------------------------------\n# 11. Regime summary\n# ------------------------------------------------------------\n\nregime_summary = (\n    mask_audit\n    .groupby(\"mask_regime\")\n    .agg(\n        mean_masking_rate_pct=(\n            \"masking_rate_on_observed_pct\",\n            \"mean\"\n        ),\n        min_masking_rate_pct=(\n            \"masking_rate_on_observed_pct\",\n            \"min\"\n        ),\n        max_masking_rate_pct=(\n            \"masking_rate_on_observed_pct\",\n            \"max\"\n        )\n    )\n    .reset_index()\n)\n\nprint(\"\\n========== REGIME SUMMARY ==========\")\n\ndisplay(regime_summary)\n\n\n# ------------------------------------------------------------\n# 12. Final interpretation\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"CELL 05 COMPLETE\")\nprint(\"=\" * 60)\n\nprint(\n    \"The reported rates represent the fraction of originally \"\n    \"observed traffic cells that the competition hides under \"\n    \"each mask regime.\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-07T17:58:08.848829Z","iopub.execute_input":"2026-10-07T17:58:08.850878Z","iopub.status.idle":"2026-10-07T17:58:11.870482Z","shell.execute_reply.started":"2026-10-07T17:58:08.850836Z","shell.execute_reply":"2026-10-07T17:58:11.869162Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"============================================================\nCOMPETITION MASKING RATE ON ORIGINALLY OBSERVED CELLS\n============================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"         panel mask_regime  total_rows  originally_observed_rows  \\\n0   D12_I405_N          R1       25632                     21464   \n1   D12_I405_S      