idors\"\n        / panel\n        / \"train\"\n        / \"mainline_states\"\n    )\n\n    assert masked_root.exists(), (\n        f\"Missing masked train directory: {masked_root}\"\n    )\n\n    assert original_root.exists(), (\n        f\"Missing original train directory: {original_root}\"\n    )\n\n    for regime in MASK_REGIMES:\n\n        regime_files = sorted(\n            (\n                masked_root / f\"mask_regime={regime}\"\n            ).glob(\"*.parquet\")\n        )\n\n        assert regime_files, (\n            f\"No files found for {panel}, {regime}\"\n        )\n\n        # Use the first available day as a controlled example.\n        masked_path = regime_files[0]\n\n        filename = masked_path.name\n\n        # Extract YYYY_MM_DD from:\n        # synthetic_mainline_YYYY_MM_DD.parquet\n        date_part = filename.replace(\n            \"synthetic_mainline_\", \"\"\n        ).replace(\n            \".parquet\", \"\"\n        )\n\n        original_month = date_part[:7].replace(\"_\", \"-\")\n\n        original_path = (\n            original_root\n            / f\"year_month={original_month}\"\n            / filename\n        )\n\n        assert original_path.exists(), (\n            f\"Original counterpart not found:\\n\"\n            f\"{original_path}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 2. Load required columns only\n        # ----------------------------------------------------\n\n        original = pd.read_parquet(\n            original_path,\n            columns=OBS_KEY + TARGET_COLUMNS\n        )\n\n        masked = pd.read_parquet(\n            masked_path,\n            columns=OBS_KEY + TARGET_COLUMNS\n        )\n\n\n        # ----------------------------------------------------\n        # 3. Normalize timestamps\n        # ----------------------------------------------------\n\n        original[\"timestamp\"] = pd.to_datetime(\n            original[\"timestamp\"],\n            utc=True\n        )\n\n        masked[\"timestamp\"] = pd.to_datetime(\n            masked[\"timestamp\"],\n            utc=True\n        )\n\n\n        # ----------------------------------------------------\n        # 4. Validate keys\n        # ----------------------------------------------------\n\n        assert not original.duplicated(OBS_KEY).any(), (\n            f\"Duplicate original keys: {panel} {regime}\"\n        )\n\n        assert not masked.duplicated(OBS_KEY).any(), (\n            f\"Duplicate masked keys: {panel} {regime}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 5. Join original and masked values\n        # ----------------------------------------------------\n\n        original = original.rename(\n            columns={\n                \"speed_kmh\": \"speed_original\",\n                \"flow_vph\": \"flow_original\"\n            }\n        )\n\n        masked = masked.rename(\n            columns={\n                \"speed_kmh\": \"speed_masked\",\n                \"flow_vph\": \"flow_masked\"\n            }\n        )\n\n        comparison = original.merge(\n            masked,\n            on=OBS_KEY,\n            how=\"inner\",\n            validate=\"one_to_one\"\n        )\n\n        assert len(comparison) == len(original), (\n            f\"Key mismatch: {panel} {regime}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 6. Decompose missingness\n        # ----------------------------------------------------\n\n        natural_missing = (\n            comparison[\"speed_original\"].isna()\n            | comparison[\"flow_original\"].isna()\n        )\n\n        masked_missing = (\n            comparison[\"speed_masked\"].isna()\n            | comparison[\"flow_masked\"].isna()\n        )\n\n        competition_masked = (\n            ~natural_missing\n            & masked_missing\n        )\n\n        still_available = (\n            ~natural_missing\n            & ~masked_missing\n        )\n\n        total = len(comparison)\n\n\n        # ----------------------------------------------------\n        # 7. Verify complete partition\n        # ----------------------------------------------------\n\n        assert (\n            natural_missing.sum()\n            + competition_masked.sum()\n            + still_available.sum()\n            == total\n        ), (\n            f\"Partition failure: {panel} {regime}\"\n        )\n\n\n        # ----------------------------------------------------\n        # 8. Verify valid targets have ground truth\n        # ----------------------------------------------------\n\n        assert comparison.loc[\n            competition_masked,\n            \"speed_original\"\n        ].notna().all()\n\n        assert comparison.loc[\n            competition_masked,\n            \"flow_original\"\n        ].notna().all()\n\n\n        # ----------------------------------------------------\n        # 9. Store results\n        # ----------------------------------------------------\n\n        results.append({\n            \"panel\": panel,\n            \"mask_regime\": regime,\n            \"date\": date_part,\n            \"rows\": total,\n            \"natural_missing_pct\":\n                natural_missing.mean() * 100,\n            \"competition_masked_pct\":\n                competition_masked.mean() * 100,\n            \"still_available_pct\":\n                still_available.mean() * 100,\n            \"valid_target_rows\":\n                int(competition_masked.sum())\n        })\n\n\n# ------------------------------------------------------------\n# 10. Display results\n# ------------------------------------------------------------\n\naudit_df = pd.DataFrame(results)\n\nprint(\"\\n========== PANEL × REGIME RESULTS ==========\")\n\ndisplay(\n    audit_df.sort_values(\n        [\"panel\", \"mask_regime\"]\n    ).reset_index(drop=True)\n)\n\n\n# ------------------------------------------