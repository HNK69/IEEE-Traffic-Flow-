{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":153956},{"sourceType":"datasetVersion","sourceId":21148729},{"sourceType":"datasetVersion","sourceId":21208953}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I10_E\"\n\nwi = pd.read_csv(\n    ROOT / \"task2\" / PANEL / \"train\" / \"window_index.csv\"\n)\nw = wi.iloc[0]\norigin = pd.to_datetime(w[\"forecast_origin\"], utc=True)\n\nfolder = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\ndate = origin.strftime(\"%Y_%m_%d\")\n\nfiles = list(folder.rglob(f\"synthetic_mainline_{date}.parquet\"))\nprint(\"Origin:\", origin)\nprint(\"Matching daily files:\", len(files))\n\nif files:\n    state = pd.concat([\n        pd.read_parquet(f, columns=[\"timestamp\", \"link_id\", \"speed_kmh\"])\n        for f in files\n    ], ignore_index=True)\n\n    state[\"timestamp\"] = pd.to_datetime(state[\"timestamp\"], utc=True)\n    at_origin = state[state[\"timestamp\"] == origin]\n\n    print(\"State rows at T:\", len(at_origin))\n    print(\"Unique links at T:\", at_origin[\"link_id\"].nunique())\n    print(\"Non-null speeds at T:\", at_origin[\"speed_kmh\"].notna().sum())\nelse:\n    print(\"No daily file found for the origin date.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:13:20.72678Z","iopub.execute_input":"2026-10-24T08:13:20.727088Z","iopub.status.idle":"2026-10-24T08:13:20.777826Z","shell.execute_reply.started":"2026-10-24T08:13:20.727065Z","shell.execute_reply":"2026-10-24T08:13:20.776948Z"}},"outputs":[{"name":"stdout","text":"Origin: 2030-06-01 09:05:00+00:00\nMatching daily files: 1\nState rows at T: 146\nUnique links at T: 146\nNon-null speeds at T: 116\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nall_labels = []\n\nfor panel in PANELS:\n    print(f\"Building labels: {panel}\")\n\n    base = ROOT / \"task2\" / panel / \"train\"\n    wi = pd.read_csv(base / \"window_index.csv\")\n    wi[\"origin\"] = pd.to_datetime(wi[\"forecast_origin\"], utc=True)\n\n    # Six future timestamps per training window\n    horizon = []\n    for _, w in wi.iterrows():\n        for step in range(1, 7):\n            horizon.append({\n                \"window_id\": w[\"window_id\"],\n                \"panel\": panel,\n                \"condition\": w[\"condition\"],\n                \"forecast_origin\": w[\"origin\"],\n                \"timestamp\": w[\"origin\"] + pd.Timedelta(minutes=5 * step),\n                \"horizon_step\": step,\n            })\n\n    horizon = pd.DataFrame(horizon)\n    target_times = set(horizon[\"timestamp\"])\n    target_dates = {t.strftime(\"%Y_%m_%d\") for t in target_times}\n\n    folder = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n    files = [\n        f for f in folder.rglob(\"*.parquet\")\n        if any(f\"synthetic_mainline_{d}\" in f.name for d in target_dates)\n    ]\n    if not files:\n        raise RuntimeError(f\"No target state files found for {panel}\")\n\n    parts = [\n        pd.read_parquet(\n            f,\n            columns=[\n                \"timestamp\", \"link_id\", \"speed_kmh\",\n                \"is_score_eligible\", \"is_imputed\", \"is_missing\",\n            ],\n        )\n        for f in files\n    ]\n    states = pd.concat(parts, ignore_index=True)\n    states[\"timestamp\"] = pd.to_datetime(states[\"timestamp\"], utc=True)\n    states = states[states[\"timestamp\"].isin(target_times)].copy()\n\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )[[\"link_id\", \"free_speed_kmh\"]]\n\n    states = states.merge(\n        fd, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    states[\"speed_kmh\"] = pd.to_numeric(states[\"speed_kmh\"], errors=\"coerce\")\n\n    states[\"label_valid\"] = (\n        states[\"is_score_eligible\"].eq(1)\n        & states[\"is_imputed\"].eq(0)\n        & states[\"is_missing\"].eq(0)\n        & states[\"speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].gt(0)\n    )\n\n    states[\"queue_label\"] = (\n        states[\"speed_kmh\"] <= 0.60 * states[\"free_speed_kmh\"]\n    ).astype(\"int8\")\n\n    labels = horizon.merge(\n        fd[[\"link_id\"]], how=\"cross\"\n    ).merge(\n        states[[\n            \"timestamp\", \"link_id\", \"speed_kmh\",\n            \"free_speed_kmh\", \"label_valid\", \"queue_label\",\n        ]],\n        on=[\"timestamp\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    labels[\"label_valid\"] = labels[\"label_valid\"].fillna(False)\n    labels.loc[~labels[\"label_valid\"], \"queue_label\"] = np.nan\n    labels[\"panel\"] = panel\n\n    # One CSV per panel, including invalid cells marked by label_valid=False\n    labels.to_csv(OUT / f\"{panel}_train_labels.csv\", index=False)\n    all_labels.append(labels)\n\n    print(\n        f\"  Cells: {len(labels):,} | \"\n        f\"Valid: {int(labels['label_valid'].sum()):,} | \"\n        f\"Coverage: {labels['label_valid'].mean():.1%}\"\n    )\n\ncombined = pd.concat(all_labels, ignore_index=True)\ncombined.to_csv(OUT / \"all_panels_train_labels.csv\", index=False)\n\nprint(\"\\n=== PHASE 2 SUMMARY ===\")\nprint(\"Total label cells:\", f\"{len(combined):,}\")\nprint(\"Valid label cells:\", f\"{int(combined['label_valid'].sum()):,}\")\nprint(\"Invalid/missing cells:\", f\"{int((~combined['label_valid']).sum()):,}\")\nprint(\"Saved to:\", OUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:13:45.781228Z","iopub.execute_input":"2026-10-24T08:13:45.781485Z","iopub.status.idle":"2026-10-24T08:13:48.840656Z","shell.execute_reply.started":"2026-10-24T08:13:45.781466Z","shell.execute_reply":"2026-10-24T08:13:48.839581Z"}},"outputs":[{"name":"stdout","text":"Building labels: D7_I10_E\n  Cells: 8,760 | Valid: 5,533 | Coverage: 63.2%\nBuilding labels: D7_I10_W\n  Cells: 6,420 | Valid: 4,149 | Coverage: 64.6%\nBuilding labels: D7_I210_E\n  Cells: 17,820 | Valid: 11,421 | Coverage: 64.1%\nBuilding labels: D7_I210_W\n  Cells: 4,860 | Valid: 3,068 | Coverage: 63.1%\nBuilding labels: D7_I405_N\n  Cells: 21,120 | Valid: 13,325 | Coverage: 63.1%\nBuilding labels: D7_I405_S\n  Cells: 6,540 | Valid: 4,144 | Coverage: 63.4%\nBuilding labels: D12_I5_N\n  Cells: 15,480 | Valid: 9,882 | Coverage: 63.8%\nBuilding labels: D12_I5_S\n  Cells: 6,000 | Valid: 3,840 | Coverage: 64.0%\n\n=== PHASE 2 SUMMARY ===\nTotal label cells: 87,000\nValid label cells: 55,362\nInvalid/missing cells: 31,638\nSaved to: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\n\nbase = ROOT / \"task2\" / PANEL / \"train\"\n\n# Load released history, window metadata, network free-flow speeds, and labels\nhistory = pd.read_parquet(base / \"window_history.parquet\")\nwindows = pd.read_csv(base / \"window_index.csv\")\nlabels = pd.read_csv(OUT / f\"{PANEL}_train_labels.csv\")\nfd = pd.read_csv(\n    ROOT / \"corridors\" / PANEL / \"network\" / \"fd_parameters.csv\"\n)\n\nhistory[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\nwindows[\"origin\"] = pd.to_datetime(windows[\"forecast_origin\"], utc=True)\n\nhistory = history.merge(\n    fd[[\"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\"]],\n    on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nhistory = history.merge(\n    windows[[\"window_id\", \"origin\"]],\n    on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n)\n\n# Only history at or before T-5 is actually present in the released file.\nhistory[\"minutes_before_origin\"] = (\n    history[\"origin\"] - history[\"timestamp\"]\n).dt.total_seconds() / 60\n\n# Derive normalized speed and flow.\nhistory[\"speed_kmh\"] = pd.to_numeric(history[\"speed_kmh\"], errors=\"coerce\")\nhistory[\"flow_vph\"] = pd.to_numeric(history[\"flow_vph\"], errors=\"coerce\")\nhistory[\"occupancy\"] = pd.to_numeric(history[\"occupancy\"], errors=\"coerce\")\n\nhistory[\"speed_ratio\"] = (\n    history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n)\nhistory[\"flow_ratio\"] = (\n    history[\"flow_vph\"] / history[\"capacity_vph\"]\n)\n\n# Explicitly order time within each window/link.\nhistory = history.sort_values(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).copy()\n\ngroup_cols = [\"window_id\", \"link_id\"]\ng = history.groupby(group_cols, sort=False)\n\n# Latest observed history row (normally T-5).\nlatest = history.groupby(group_cols, sort=False).tail(1).copy()\nlatest = latest.rename(columns={\n    \"speed_ratio\": \"speed_ratio_latest\",\n    \"flow_ratio\": \"flow_ratio_latest\",\n    \"occupancy\": \"occupancy_latest\",\n    \"speed_kmh\": \"speed_latest\",\n    \"flow_vph\": \"flow_latest\",\n    \"pct_observed\": \"pct_observed_latest\",\n    \"is_score_eligible\": \"eligible_latest\",\n})\n\n# Aggregates over the latest 3 and 6 history steps.\nfeatures = latest[\n    [\"window_id\", \"link_id\", \"free_speed_kmh\", \"capacity_vph\",\n     \"length_km\", \"lanes\", \"speed_ratio_latest\", \"flow_ratio_latest\",\n     \"occupancy_latest\", \"speed_latest\", \"flow_latest\",\n     \"pct_observed_latest\", \"eligible_latest\"]\n].copy()\n\nfor n_steps, prefix in [(3, \"last3\"), (6, \"last6\")]:\n    recent = history.groupby(group_cols, sort=False).tail(n_steps)\n    agg = recent.groupby(group_cols).agg(\n        speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n        speed_ratio_std=(\"speed_ratio\", \"std\"),\n        flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n        occupancy_mean=(\"occupancy\", \"mean\"),\n        pct_observed_mean=(\"pct_observed\", \"mean\"),\n        eligible_fraction=(\"is_score_eligible\", \"mean\"),\n        observed_speed_fraction=(\"speed_kmh\", lambda x: x.notna().mean()),\n    ).reset_index()\n\n    agg = agg.rename(columns={\n        c: f\"{prefix}_{c}\" for c in agg.columns\n        if c not in group_cols\n    })\n    features = features.merge(\n        agg, on=group_cols, how=\"left\", validate=\"one_to_one\"\n    )\n\n# Trend: change in normalized speed from the first to latest history row.\nfirst = history.groupby(group_cols, sort=False).head(1)[\n    group_cols + [\"speed_ratio\"]\n].rename(columns={\"speed_ratio\": \"speed_ratio_first\"})\n\nfeatures = features.merge(\n    first, on=group_cols, how=\"left\", validate=\"one_to_one\"\n)\nfeatures[\"speed_ratio_change\"] = (\n    features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n)\n\n# Expand features over the six forecast steps.\nfeatures[\"key\"] = 1\nsteps = pd.DataFrame({\"horizon_step\": range(1, 7), \"key\": [1] * 6})\nfeatures = features.merge(steps, on=\"key\").drop(columns=\"key\")\n\n# Attach labels using the exact window/link/time key.\nlabels[\"timestamp\"] = pd.to_datetime(labels[\"timestamp\"], utc=True)\nfeatures = features.merge(\n    labels[[\n        \"window_id\", \"link_id\", \"timestamp\", \"horizon_step\",\n        \"queue_label\", \"label_valid\", \"condition\"\n    ]],\n    on=[\"window_id\", \"link_id\", \"horizon_step\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\n# Audit: label timestamp must equal origin + 5 * horizon_step minutes.\norigin_map = windows.set_index(\"window_id\")[\"origin\"]\nfeatures[\"expected_timestamp\"] = (\n    features[\"window_id\"].map(origin_map)\n    + pd.to_timedelta(features[\"horizon_step\"] * 5, unit=\"min\")\n)\n\nassert features[\"timestamp\"].equals(features[\"expected_timestamp\"]), (\n    \"Label timestamp mismatch: stop and investigate.\"\n)\nassert not features.duplicated(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).any(), \"Duplicate feature/label keys found.\"\n\nout_file = OUT / f\"{PANEL}_train_features.csv\"\nfeatures.to_csv(out_file, index=False)\n\nprint(\"Feature rows:\", len(features))\nprint(\"Unique links per window:\", features.groupby(\"window_id\")[\"link_id\"].nunique().to_dict())\nprint(\"Valid labels:\", int(features[\"label_valid\"].fillna(False).sum()))\nprint(\"Feature columns:\", len(features.columns))\nprint(\"Missing feature values (top 10):\")\nprint(features.isna().sum().sort_values(ascending=False).head(10).to_string())\nprint(\"Saved:\", out_file)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:44:56.760848Z","iopub.execute_input":"2026-10-24T08:44:56.761269Z","iopub.status.idle":"2026-10-24T08:44:57.507766Z","shell.execute_reply.started":"2026-10-24T08:44:56.761246Z","shell.execute_reply":"2026-10-24T08:44:57.506874Z"}},"outputs":[{"name":"stdout","text":"Feature rows: 8760\nUnique links per window: {'Q2_D7_I10_E_train_001': 146, 'Q2_D7_I10_E_train_002': 146, 'Q2_D7_I10_E_train_003': 146, 'Q2_D7_I10_E_train_004': 146, 'Q2_D7_I10_E_train_005': 146, 'Q2_D7_I10_E_train_006': 146, 'Q2_D7_I10_E_train_007': 146, 'Q2_D7_I10_E_train_008': 146, 'Q2_D7_I10_E_train_009': 146, 'Q2_D7_I10_E_train_010': 146}\nValid labels: 5533\nFeature columns: 35\nMissing feature values (top 10):\nqueue_label               3227\nspeed_ratio_change        2700\nspeed_ratio_latest        1518\nflow_latest               1518\nflow_ratio_latest         1518\noccupancy_latest          1518\nspeed_latest              1518\nspeed_ratio_first         1470\nlast3_speed_ratio_std      900\nlast3_speed_ratio_mean     396\nSaved: /kaggle/working/task2_training_labels/D7_I10_E_train_features.csv\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# Rebuild the feature-label join with the exact timestamp key.\n# Uses existing features, labels, and windows from the previous cell.\n\nlabel_cols = [\n    \"window_id\", \"link_id\", \"timestamp\",\n    \"horizon_step\", \"queue_label\", \"label_valid\", \"condition\"\n]\n\nlabels_check = labels[label_cols].copy()\nlabels_check[\"timestamp\"] = pd.to_datetime(\n    labels_check[\"timestamp\"], utc=True\n)\n\nbase_features = features.drop(\n    columns=[\n        \"timestamp\", \"horizon_step\", \"queue_label\",\n        \"label_valid\", \"condition\", \"expected_timestamp\"\n    ],\n    errors=\"ignore\"\n).copy()\n\nbase_features[\"origin\"] = base_features[\"window_id\"].map(\n    windows.set_index(\"window_id\")[\"origin\"]\n)\n\nbase_features[\"horizon_step\"] = features[\"horizon_step\"].to_numpy()\nbase_features[\"timestamp\"] = (\n    base_features[\"origin\"]\n    + pd.to_timedelta(base_features[\"horizon_step\"] * 5, unit=\"min\")\n)\n\ncorrected = base_features.merge(\n    labels_check,\n    on=[\"window_id\", \"link_id\", \"timestamp\", \"horizon_step\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nprint(\"Corrected rows:\", len(corrected))\nprint(\"Missing label matches:\", int(corrected[\"label_valid\"].isna().sum()))\nprint(\"Valid labels:\", int(corrected[\"label_valid\"].fillna(False).sum()))\nprint(\"Duplicate keys:\", int(\n    corrected.duplicated([\"window_id\", \"link_id\", \"timestamp\"]).sum()\n))\n\nassert len(corrected) == 8760\nassert corrected[\"label_valid\"].notna().all(), (\n    \"Some feature rows failed to match labels.\"\n)\nassert not corrected.duplicated(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).any()\n\nout_file = OUT / f\"{PANEL}_train_features.csv\"\ncorrected.to_csv(out_file, index=False)\nprint(\"Saved corrected features:\", out_file)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:45:49.953872Z","iopub.execute_input":"2026-10-24T08:45:49.954181Z","iopub.status.idle":"2026-10-24T08:45:50.331739Z","shell.execute_reply.started":"2026-10-24T08:45:49.954159Z","shell.execute_reply":"2026-10-24T08:45:50.331023Z"}},"outputs":[{"name":"stdout","text":"Corrected rows: 8760\nMissing label matches: 0\nValid labels: 5533\nDuplicate keys: 0\nSaved corrected features: /kaggle/working/task2_training_labels/D7_I10_E_train_features.csv\n","output_type":"stream"}],"execution_count":29},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport joblib\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.ensemble import HistGradientBoostingClassifier\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\ndf = pd.read_csv(OUT / f\"{PANEL}_train_features.csv\")\n\n# Keep only rows with valid supervised labels.\ndf = df[df[\"label_valid\"].eq(True)].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# Hold out whole windows, not individual rows.\n# Use two ongoing windows and one onset window for validation.\nvalid_windows = [\n    \"Q2_D7_I10_E_train_003\",\n    \"Q2_D7_I10_E_train_007\",\n    \"Q2_D7_I10_E_train_009\",\n]\ntrain = df[~df[\"window_id\"].isin(valid_windows)].copy()\nvalid = df[df[\"window_id\"].isin(valid_windows)].copy()\n\n# Remove identifiers, target fields, timestamps, and strings from predictors.\ndrop_cols = {\n    \"window_id\", \"panel\", \"condition\", \"forecast_origin\", \"timestamp\",\n    \"expected_timestamp\", \"queue_label\", \"label_valid\", \"origin\",\n    \"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\",\n}\nfeature_cols = [\n    c for c in df.columns\n    if c not in drop_cols and pd.api.types.is_numeric_dtype(df[c])\n]\n\nX_train = train[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_train = train[\"queue_label\"]\nX_valid = valid[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_valid = valid[\"queue_label\"]\n\nprint(\"Train rows:\", len(train), \"| Validation rows:\", len(valid))\nprint(\"Training queue prevalence:\", round(float(y_train.mean()), 4))\nprint(\"Validation queue prevalence:\", round(float(y_valid.mean()), 4))\nprint(\"Features:\", len(feature_cols))\nprint(\"Training windows:\", sorted(train[\"window_id\"].unique()))\nprint(\"Validation windows:\", sorted(valid[\"window_id\"].unique()))\n\nif y_train.nunique() < 2:\n    raise ValueError(\"Training split contains only one class.\")\n\nmodel = Pipeline([\n    (\"imputer\", SimpleImputer(strategy=\"median\", add_indicator=True)),\n    (\"classifier\", HistGradientBoostingClassifier(\n        max_iter=150,\n        learning_rate=0.08,\n        max_leaf_nodes=15,\n        l2_regularization=2.0,\n        random_state=42,\n    )),\n])\n\nmodel.fit(X_train, y_train)\nprob = model.predict_proba(X_valid)[:, 1]\n\ndef mean_window_iou(y, p, window_ids, threshold):\n    scores = []\n    for window_id in pd.unique(window_ids):\n        mask = np.asarray(window_ids == window_id)\n        yt = np.asarray(y)[mask].astype(bool)\n        yp = (np.asarray(p)[mask] >= threshold)\n        union = np.logical_or(yt, yp).sum()\n        inter = np.logical_and(yt, yp).sum()\n        scores.append(inter / union if union else 1.0)\n    return float(np.mean(scores)), scores\n\nthresholds = np.arange(0.05, 0.81, 0.025)\nresults = []\nfor threshold in thresholds:\n    score, per_window = mean_window_iou(\n        y_valid.to_numpy(),\n        prob,\n        valid[\"window_id\"].to_numpy(),\n        threshold,\n    )\n    results.append((score, threshold, per_window))\n\nbest_score, best_threshold, best_per_window = max(\n    results, key=lambda x: x[0]\n)\n\nprint(\"\\n=== VALIDATION RESULTS ===\")\nprint(\"Mean per-window IoU:\", round(best_score, 4))\nprint(\"Selected threshold:\", round(float(best_threshold), 3))\n\nfor wid, score in zip(pd.unique(valid[\"window_id\"]), best_per_window):\n    condition = valid.loc[valid[\"window_id\"] == wid, \"condition\"].iloc[0]\n    print(wid, \"|\", condition, \"| IoU:\", round(score, 4))\n\nif y_valid.nunique() > 1:\n    print(\"ROC-AUC:\", round(roc_auc_score(y_valid, prob), 4))\n    print(\"PR-AUC:\", round(average_precision_score(y_valid, prob), 4))\n\nartifact = {\n    \"model\": model,\n    \"feature_cols\": feature_cols,\n    \"threshold\": float(best_threshold),\n    \"panel\": PANEL,\n    \"validation_windows\": valid_windows,\n}\njoblib.dump(artifact, OUT / f\"{PANEL}_baseline.joblib\")\n\nreport = {\n    \"panel\": PANEL,\n    \"train_rows\": len(train),\n    \"validation_rows\": len(valid),\n    \"feature_count\": len(feature_cols),\n    \"validation_windows\": valid_windows,\n    \"mean_window_iou\": best_score,\n    \"threshold\": float(best_threshold),\n    \"per_window_iou\": {\n        wid: float(score)\n        for wid, score in zip(pd.unique(valid[\"window_id\"]), best_per_window)\n    },\n}\n(OUT / f\"{PANEL}_baseline_report.json\").write_text(\n    json.dumps(report, indent=2)\n)\n\nprint(\"\\nSaved model:\", OUT / f\"{PANEL}_baseline.joblib\")\nprint(\"Saved report:\", OUT / f\"{PANEL}_baseline_report.json\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:46:33.850533Z","iopub.execute_input":"2026-10-24T08:46:33.850814Z","iopub.status.idle":"2026-10-24T08:46:38.207708Z","shell.execute_reply.started":"2026-10-24T08:46:33.850793Z","shell.execute_reply":"2026-10-24T08:46:38.20616Z"}},"outputs":[{"name":"stdout","text":"Train rows: 3888 | Validation rows: 1645\nTraining queue prevalence: 0.0571\nValidation queue prevalence: 0.2553\nFeatures: 24\nTraining windows: ['Q2_D7_I10_E_train_001', 'Q2_D7_I10_E_train_002', 'Q2_D7_I10_E_train_004', 'Q2_D7_I10_E_train_005', 'Q2_D7_I10_E_train_006', 'Q2_D7_I10_E_train_008', 'Q2_D7_I10_E_train_010']\nValidation windows: ['Q2_D7_I10_E_train_003', 'Q2_D7_I10_E_train_007', 'Q2_D7_I10_E_train_009']\n\n=== VALIDATION RESULTS ===\nMean per-window IoU: 0.5951\nSelected threshold: 0.725\nQ2_D7_I10_E_train_003 | queue_onset | IoU: 0.0\nQ2_D7_I10_E_train_007 | queue_ongoing | IoU: 0.9107\nQ2_D7_I10_E_train_009 | queue_ongoing | IoU: 0.8746\nROC-AUC: 0.9901\nPR-AUC: 0.9798\n\nSaved model: /kaggle/working/task2_training_labels/D7_I10_E_baseline.joblib\nSaved report: /kaggle/working/task2_training_labels/D7_I10_E_baseline_report.json\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\n# Inspect all validation predictions by window and forecast horizon.\nonset_id = \"Q2_D7_I10_E_train_003\"\nmask = valid[\"window_id\"].to_numpy() == onset_id\n\nonset = valid.loc[mask].copy()\nonset[\"y_true\"] = y_valid.to_numpy()[mask]\nonset[\"probability\"] = prob[mask]\n\nprint(\n    onset.groupby(\"horizon_step\").agg(\n        rows=(\"y_true\", \"size\"),\n        queued=(\"y_true\", \"sum\"),\n        max_probability=(\"probability\", \"max\"),\n        mean_probability=(\"probability\", \"mean\"),\n    ).round(4).to_string()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:48:19.240572Z","iopub.execute_input":"2026-10-24T08:48:19.240854Z","iopub.status.idle":"2026-10-24T08:48:19.259428Z","shell.execute_reply.started":"2026-10-24T08:48:19.240832Z","shell.execute_reply":"2026-10-24T08:48:19.258444Z"}},"outputs":[{"name":"stdout","text":"              rows  queued  max_probability  mean_probability\nhorizon_step                                                 \n1               95       0           0.0027            0.0002\n2               90       0           0.0027            0.0002\n3               91       0           0.0016            0.0002\n4               93       0           0.0034            0.0003\n5               95       0           0.0037            0.0003\n6               92       3           0.0300            0.0017\n","output_type":"stream"}],"execution_count":34},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\n# Explicitly exclude labels, target speed, identifiers, and timestamps.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in train.columns\n    if c not in exclude\n    and c in valid.columns\n    and pd.api.types.is_numeric_dtype(train[c])\n]\n\n# Use only rows with known labels.\ntr = train.loc[train[\"queue_label\"].notna()].copy()\nva = valid.loc[valid[\"queue_label\"].notna()].copy()\n\nX_train = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_train = tr[\"queue_label\"].astype(int)\n\nX_valid = va[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_valid_lgb = va[\"queue_label\"].astype(int)\n\n# Give the rare positive class more weight.\nn_pos = int(y_train.sum())\nn_neg = len(y_train) - n_pos\nscale_pos_weight = n_neg / max(n_pos, 1)\n\nmodel_lgb = lgb.LGBMClassifier(\n    n_estimators=500,\n    learning_rate=0.03,\n    num_leaves=15,\n    max_depth=-1,\n    min_child_samples=30,\n    colsample_bytree=0.9,\n    subsample=0.9,\n    reg_lambda=2.0,\n    scale_pos_weight=scale_pos_weight,\n    random_state=42,\n    verbosity=-1,\n)\n\nmodel_lgb.fit(X_train, y_train)\n\nvalid_prob_lgb = model_lgb.predict_proba(X_valid)[:, 1]\n\nprint(\"Features:\", len(feature_cols))\nprint(\"Positive-class weight:\", round(scale_pos_weight, 2))\nprint(\"Validation ROC-AUC:\", round(\n    roc_auc_score(y_valid_lgb, valid_prob_lgb), 4\n))\nprint(\"Validation PR-AUC:\", round(\n    average_precision_score(y_valid_lgb, valid_prob_lgb), 4\n))\n\n# Score each complete validation window separately.\nresults = []\nfor wid in va[\"window_id\"].unique():\n    m = va[\"window_id\"].to_numpy() == wid\n    yt = y_valid_lgb.to_numpy()[m]\n    yp = valid_prob_lgb[m] >= 0.5\n\n    intersection = np.sum(yt * yp)\n    union = np.sum((yt == 1) | yp)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": va.loc[m, \"condition\"].iloc[0],\n        \"queued_true\": int(yt.sum()),\n        \"queued_pred\": int(yp.sum()),\n        \"IoU_at_0.5\": round(float(iou), 4),\n    })\n\nresults_df = pd.DataFrame(results)\nprint(\"\\n\", results_df.to_string(index=False))\nprint(\n    \"\\nMean per-window IoU @ 0.5:\",\n    round(results_df[\"IoU_at_0.5\"].mean(), 4)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:50:38.937546Z","iopub.execute_input":"2026-10-24T08:50:38.937855Z","iopub.status.idle":"2026-10-24T08:50:42.502378Z","shell.execute_reply.started":"2026-10-24T08:50:38.937832Z","shell.execute_reply":"2026-10-24T08:50:42.501672Z"}},"outputs":[{"name":"stdout","text":"Features: 24\nPositive-class weight: 16.51\nValidation ROC-AUC: 0.9887\nValidation PR-AUC: 0.9736\n\n             window_id     condition  queued_true  queued_pred  IoU_at_0.5\nQ2_D7_I10_E_train_003   queue_onset            3            0      0.0000\nQ2_D7_I10_E_train_007 queue_ongoing          109          112      0.9217\nQ2_D7_I10_E_train_009 queue_ongoing          308          354      0.8389\n\nMean per-window IoU @ 0.5: 0.5869\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"import numpy as np\n\nbest_score = -1\nbest_threshold = None\n\nfor threshold in np.arange(0.01, 0.96, 0.01):\n    scores = []\n\n    for wid in va[\"window_id\"].unique():\n        m = va[\"window_id\"].to_numpy() == wid\n        y = y_valid_lgb.to_numpy()[m]\n        pred = valid_prob_lgb[m] >= threshold\n\n        union = np.sum((y == 1) | pred)\n        intersection = np.sum((y == 1) & pred)\n        scores.append(intersection / union if union else 1.0)\n\n    mean_iou = float(np.mean(scores))\n\n    if mean_iou > best_score:\n        best_score = mean_iou\n        best_threshold = float(threshold)\n\nprint(\"Best threshold:\", round(best_threshold, 2))\nprint(\"Best mean per-window IoU:\", round(best_score, 4))\n\nfor wid in va[\"window_id\"].unique():\n    m = va[\"window_id\"].to_numpy() == wid\n    y = y_valid_lgb.to_numpy()[m]\n    pred = valid_prob_lgb[m] >= best_threshold\n    union = np.sum((y == 1) | pred)\n    intersection = np.sum((y == 1) & pred)\n    iou = intersection / union if union else 1.0\n    print(wid, \"| predicted:\", int(pred.sum()), \"| IoU:\", round(float(iou), 4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:51:28.24556Z","iopub.execute_input":"2026-10-24T08:51:28.24614Z","iopub.status.idle":"2026-10-24T08:51:28.283791Z","shell.execute_reply.started":"2026-10-24T08:51:28.246117Z","shell.execute_reply":"2026-10-24T08:51:28.283026Z"}},"outputs":[{"name":"stdout","text":"Best threshold: 0.66\nBest mean per-window IoU: 0.5959\nQ2_D7_I10_E_train_003 | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_007 | predicted: 109 | IoU: 0.9464\nQ2_D7_I10_E_train_009 | predicted: 353 | IoU: 0.8412\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\n# Load the existing feature + label dataset for D7_I10_E.\nDATA_PATH = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features.csv\"\n)\ndf = pd.read_csv(DATA_PATH)\n\n# Keep only rows with valid labels.\ndf = df[df[\"label_valid\"].astype(bool)].copy()\ndf = df[df[\"queue_label\"].notna()].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# Never use target-derived values or identifiers as model features.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\n# Report label coverage before training.\nprint(\"Valid labelled rows:\", len(df))\nprint(\"Features:\", len(feature_cols))\nprint(\"\\nWindow label counts:\")\nprint(\n    df.groupby([\"window_id\", \"condition\"])[\"queue_label\"]\n      .agg(rows=\"size\", queued=\"sum\", prevalence=\"mean\")\n      .round(4)\n      .to_string()\n)\n\n# Leave one complete window out per fold.\nwindows = sorted(df[\"window_id\"].unique())\noof_parts = []\n\nfor i, heldout_window in enumerate(windows, start=1):\n    train_fold = df[df[\"window_id\"] != heldout_window]\n    val_fold = df[df[\"window_id\"] == heldout_window]\n\n    X_train = train_fold[feature_cols].replace(\n        [np.inf, -np.inf], np.nan\n    )\n    y_train = train_fold[\"queue_label\"]\n\n    X_val = val_fold[feature_cols].replace(\n        [np.inf, -np.inf], np.nan\n    )\n    y_val = val_fold[\"queue_label\"].to_numpy()\n\n    positives = int(y_train.sum())\n    negatives = len(y_train) - positives\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / max(positives, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X_train, y_train)\n\n    fold_out = val_fold[\n        [\"window_id\", \"condition\", \"horizon_step\", \"queue_label\"]\n    ].copy()\n    fold_out[\"probability\"] = model.predict_proba(X_val)[:, 1]\n    oof_parts.append(fold_out)\n\n    print(f\"Completed fold {i}/{len(windows)}: {heldout_window}\")\n\n# Combine out-of-fold predictions.\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_lightgbm_oof.csv\",\n    index=False,\n)\n\n# Evaluate each held-out window at a fixed threshold of 0.5.\nresults = []\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU_at_0.5\": round(float(iou), 4),\n    })\n\nresults_df = pd.DataFrame(results)\nprint(\"\\n=== LEAVE-ONE-WINDOW-OUT RESULTS ===\")\nprint(results_df.to_string(index=False))\nprint(\n    \"\\nMean per-window IoU @ 0.5:\",\n    round(results_df[\"IoU_at_0.5\"].mean(), 4),\n)\n\nprint(\"\\nMean IoU by condition:\")\nprint(results_df.groupby(\"condition\")[\"IoU_at_0.5\"].mean().round(4))\n\nprint(\"\\nSaved OOF predictions to D7_I10_E_lightgbm_oof.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:53:57.840425Z","iopub.execute_input":"2026-10-24T08:53:57.840772Z","iopub.status.idle":"2026-10-24T08:54:01.301754Z","shell.execute_reply.started":"2026-10-24T08:53:57.840749Z","shell.execute_reply":"2026-10-24T08:54:01.300823Z"}},"outputs":[{"name":"stdout","text":"Valid labelled rows: 5533\nFeatures: 24\n\nWindow label counts:\n                                     rows  queued  prevalence\nwindow_id             condition                              \nQ2_D7_I10_E_train_001 queue_onset     564       4      0.0071\nQ2_D7_I10_E_train_002 queue_onset     561       6      0.0107\nQ2_D7_I10_E_train_003 queue_onset     556       3      0.0054\nQ2_D7_I10_E_train_004 queue_onset     553       2      0.0036\nQ2_D7_I10_E_train_005 queue_onset     558       3      0.0054\nQ2_D7_I10_E_train_006 queue_ongoing   571     113      0.1979\nQ2_D7_I10_E_train_007 queue_ongoing   548     109      0.1989\nQ2_D7_I10_E_train_008 queue_ongoing   531      69      0.1299\nQ2_D7_I10_E_train_009 queue_ongoing   541     308      0.5693\nQ2_D7_I10_E_train_010 queue_ongoing   550      25      0.0455\nCompleted fold 1/10: Q2_D7_I10_E_train_001\nCompleted fold 2/10: Q2_D7_I10_E_train_002\nCompleted fold 3/10: Q2_D7_I10_E_train_003\nCompleted fold 4/10: Q2_D7_I10_E_train_004\nCompleted fold 5/10: Q2_D7_I10_E_train_005\nCompleted fold 6/10: Q2_D7_I10_E_train_006\nCompleted fold 7/10: Q2_D7_I10_E_train_007\nCompleted fold 8/10: Q2_D7_I10_E_train_008\nCompleted fold 9/10: Q2_D7_I10_E_train_009\nCompleted fold 10/10: Q2_D7_I10_E_train_010\n\n=== LEAVE-ONE-WINDOW-OUT RESULTS ===\n            window_id     condition  true_queued  predicted_queued  IoU_at_0.5\nQ2_D7_I10_E_train_001   queue_onset            4                 5      0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 6      0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0      0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8      0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0      0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               138      0.7552\nQ2_D7_I10_E_train_007 queue_ongoing          109               121      0.7969\nQ2_D7_I10_E_train_008 queue_ongoing           69                31      0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354      0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                28      0.7097\n\nMean per-window IoU @ 0.5: 0.3661\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7100\nqueue_onset      0.0222\nName: IoU_at_0.5, dtype: float64\n\nSaved OOF predictions to D7_I10_E_lightgbm_oof.csv\n","output_type":"stream"}],"execution_count":37},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nbase = \"/kaggle/working/task2_training_labels/\"\n\nfeatures = pd.read_csv(base + \"D7_I10_E_train_features.csv\")\noof = pd.read_csv(base + \"D7_I10_E_lightgbm_oof.csv\")\n\nonset_ids = [\n    f\"Q2_D7_I10_E_train_{i:03d}\"\n    for i in range(1, 6)\n]\n\n# Look at the features of the rare positive onset cells.\nonset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n    & (features[\"queue_label\"] == 1)\n].copy()\n\nprint(\"Valid onset queue cells:\", len(onset))\n\n# Show which predictors are available and compare positive-cell\n# values against all valid onset cells.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nnumeric_features = [\n    c for c in features.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(features[c])\n]\n\nall_onset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n].copy()\n\nsummary = pd.DataFrame({\n    \"queue_cells_mean\": onset[numeric_features].mean(),\n    \"nonqueue_cells_mean\": all_onset.loc[\n        all_onset[\"queue_label\"] == 0, numeric_features\n    ].mean(),\n})\n\nsummary[\"difference\"] = (\n    summary[\"queue_cells_mean\"] - summary[\"nonqueue_cells_mean\"]\n)\n\nprint(summary.round(4).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:54:33.489742Z","iopub.execute_input":"2026-10-24T08:54:33.490056Z","iopub.status.idle":"2026-10-24T08:54:33.558917Z","shell.execute_reply.started":"2026-10-24T08:54:33.490034Z","shell.execute_reply":"2026-10-24T08:54:33.55824Z"}},"outputs":[{"name":"stdout","text":"Valid onset queue cells: 18\n                               queue_cells_mean  nonqueue_cells_mean  difference\nspeed_ratio_latest                       1.0020               0.9920      0.0100\nflow_ratio_latest                        0.5854               0.5676      0.0177\noccupancy_latest                         0.1514               0.1392      0.0122\nspeed_latest                           111.5693             112.4239     -0.8546\nflow_latest                           4756.1829            4489.8774    266.3054\npct_observed_latest                     80.8333              78.3136      2.5197\neligible_latest                          0.8333               0.7722      0.0612\nlast3_speed_ratio_mean                   1.0000               0.9922      0.0078\nlast3_speed_ratio_std                    0.0112               0.0092      0.0020\nlast3_flow_ratio_mean                    0.5954               0.5622      0.0333\nlast3_occupancy_mean                     0.1510               0.1379      0.0131\nlast3_pct_observed_mean                 76.3148              77.0204     -0.7056\nlast3_eligible_fraction                  0.7963               0.7641      0.0322\nlast3_observed_speed_fraction            0.8148               0.8274     -0.0126\nlast6_speed_ratio_mean                   1.0004               0.9923      0.0080\nlast6_speed_ratio_std                    0.0119               0.0102      0.0018\nlast6_flow_ratio_mean                    0.5896               0.5470      0.0426\nlast6_occupancy_mean                     0.1500               0.1340      0.0160\nlast6_pct_observed_mean                 72.8333              76.8184     -3.9851\nlast6_eligible_fraction                  0.7315               0.7617     -0.0302\nlast6_observed_speed_fraction            0.8056               0.8276     -0.0220\nspeed_ratio_first                        1.0003               0.9889      0.0115\nspeed_ratio_change                       0.0012               0.0031     -0.0019\nhorizon_step                             6.0000               3.4996      2.5004\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ninput_path = base / \"D7_I10_E_train_features.csv\"\noutput_path = base / \"D7_I10_E_train_features_temporal.csv\"\n\ndf = pd.read_csv(input_path)\n\n# Add temporal-change features from existing history summaries.\n# These are differences between historical summary windows, not target values.\nrequired = [\n    \"last3_speed_ratio_mean\", \"last6_speed_ratio_mean\",\n    \"last3_flow_ratio_mean\", \"last6_flow_ratio_mean\",\n    \"last3_occupancy_mean\", \"last6_occupancy_mean\",\n    \"speed_ratio_latest\", \"speed_ratio_first\",\n]\n\nmissing = [c for c in required if c not in df.columns]\nif missing:\n    raise ValueError(f\"Missing expected columns: {missing}\")\n\ndf[\"speed_ratio_recent_vs_long\"] = (\n    df[\"last3_speed_ratio_mean\"] - df[\"last6_speed_ratio_mean\"]\n)\ndf[\"flow_ratio_recent_vs_long\"] = (\n    df[\"last3_flow_ratio_mean\"] - df[\"last6_flow_ratio_mean\"]\n)\ndf[\"occupancy_recent_vs_long\"] = (\n    df[\"last3_occupancy_mean\"] - df[\"last6_occupancy_mean\"]\n)\ndf[\"speed_ratio_recent_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"last3_speed_ratio_mean\"]\n)\ndf[\"speed_ratio_overall_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"speed_ratio_first\"]\n)\n\n# Change in variability between recent and longer history.\nif \"last3_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_recent\"] = df[\"last3_speed_ratio_std\"]\n\nif \"last6_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_long\"] = df[\"last6_speed_ratio_std\"]\n    if \"last3_speed_ratio_std\" in df.columns:\n        df[\"speed_variability_change\"] = (\n            df[\"last3_speed_ratio_std\"] - df[\"last6_speed_ratio_std\"]\n        )\n\ndf.to_csv(output_path, index=False)\n\nnew_cols = [c for c in df.columns if c not in pd.read_csv(input_path, nrows=0).columns]\nprint(\"Saved:\", output_path)\nprint(\"Rows:\", len(df))\nprint(\"New temporal features:\", new_cols)\nprint(df[new_cols].describe().round(4).to_string())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:55:16.123105Z","iopub.execute_input":"2026-10-24T08:55:16.123425Z","iopub.status.idle":"2026-10-24T08:55:16.630565Z","shell.execute_reply.started":"2026-10-24T08:55:16.123401Z","shell.execute_reply":"2026-10-24T08:55:16.629715Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/task2_training_labels/D7_I10_E_train_features_temporal.csv\nRows: 8760\nNew temporal features: ['speed_ratio_recent_vs_long', 'flow_ratio_recent_vs_long', 'occupancy_recent_vs_long', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change']\n       speed_ratio_recent_vs_long  flow_ratio_recent_vs_long  occupancy_recent_vs_long  speed_ratio_recent_change  speed_ratio_overall_change  speed_variability_recent  speed_variability_long  speed_variability_change\ncount                   8364.0000                  8364.0000                 8364.0000                  7242.0000                   6060.0000                 7860.0000               8490.0000                 7860.0000\nmean                      -0.0047                     0.0084                    0.0042                    -0.0015                     -0.0182                    0.0106                  0.0167                   -0.0061\nstd                        0.0382                     0.0178                    0.0233                     0.0217                      0.1268                    0.0182                  0.0445                    0.0405\nmin                       -0.4524                    -0.0864                   -0.0639                    -0.4279                     -0.8614                    0.0000                  0.0000                   -0.4484\n25%                       -0.0031                    -0.0020                   -0.0004                    -0.0053                     -0.0089                    0.0044                  0.0070                   -0.0041\n50%                        0.0000                     0.0047                    0.0011                     0.0000                      0.0008                    0.0083                  0.0103                   -0.0004\n75%                        0.0029                     0.0159                    0.0038                     0.0053                      0.0131                    0.0132                  0.0137                    0.0018\nmax                        0.0456                     0.1107                    0.2316                     0.0239                      0.2055                    0.3706                  0.4484                    0.0848\n","output_type":"stream"}],"execution_count":39},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\n\n# 1. Load the NEW temporal feature file\npath = (\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features_temporal.csv\"\n)\ndf = pd.read_csv(path)\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# 2. Select features without target leakage\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\n# 3. Leave one entire window out at a time\noof_parts = []\nwindows = sorted(df[\"window_id\"].unique())\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    X_train = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    y_train = tr[\"queue_label\"]\n\n    X_val = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n\n    n_pos = int(y_train.sum())\n    n_neg = len(y_train) - n_pos\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=n_neg / max(n_pos, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X_train, y_train)\n\n    out = va[\n        [\"window_id\", \"condition\", \"queue_label\"]\n    ].copy()\n    out[\"probability\"] = model.predict_proba(X_val)[:, 1]\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\n# 4. Evaluate at the same fixed threshold: 0.5\noof = pd.concat(oof_parts, ignore_index=True)\nresults = []\n\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\nresults = pd.DataFrame(results)\n\nprint(\"\\n=== TEMPORAL FEATURES: RESULTS ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\n\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n\noof.to_csv(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_temporal_oof.csv\",\n    index=False,\n)\nprint(\"\\nSaved temporal OOF predictions.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:56:36.402537Z","iopub.execute_input":"2026-10-24T08:56:36.402841Z","iopub.status.idle":"2026-10-24T08:56:40.759159Z","shell.execute_reply.started":"2026-10-24T08:56:36.402809Z","shell.execute_reply":"2026-10-24T08:56:40.758076Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== TEMPORAL FEATURES: RESULTS ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 5 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               131 0.7941\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3909\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7597\nqueue_onset      0.0222\nName: IoU, dtype: float64\n\nSaved temporal OOF predictions.\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\ntry:\n    from catboost import CatBoostClassifier\nexcept ImportError:\n    print(\"CatBoost is not installed. Run: !pip -q install catboost\")\n    raise\n\npath = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features_temporal.csv\"\n)\n\ndf = pd.read_csv(path)\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeatures = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nwindows = sorted(df[\"window_id\"].unique())\nfold_results = []\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[features].replace([np.inf, -np.inf], np.nan)\n    Xva = va[features].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].to_numpy()\n\n    # CatBoost can handle missing numerical values.\n    pos = max(int(ytr.sum()), 1)\n    neg = len(ytr) - int(ytr.sum())\n\n    model = CatBoostClassifier(\n        iterations=300,\n        depth=5,\n        learning_rate=0.03,\n        loss_function=\"Logloss\",\n        eval_metric=\"PRAUC\",\n        class_weights=[1.0, neg / pos],\n        random_seed=42,\n        verbose=False,\n        allow_writing_files=False,\n        thread_count=-1,\n    )\n\n    model.fit(Xtr, ytr)\n    prob = model.predict_proba(Xva)[:, 1]\n    pred = prob >= 0.5\n    y = va[\"queue_label\"].to_numpy().astype(bool)\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    fold_results.append({\n        \"window_id\": wid,\n        \"condition\": va[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\nresults = pd.DataFrame(fold_results)\nprint(\"\\n=== CATBOOST OOF RESULTS ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:57:12.381841Z","iopub.execute_input":"2026-10-24T08:57:12.38217Z","iopub.status.idle":"2026-10-24T08:57:23.651476Z","shell.execute_reply.started":"2026-10-24T08:57:12.382148Z","shell.execute_reply":"2026-10-24T08:57:23.650833Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== CATBOOST OOF RESULTS ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 2 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.8370\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3952\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7683\nqueue_onset      0.0222\nName: IoU, dtype: float64\n","output_type":"stream"}],"execution_count":42},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\nfrom catboost import CatBoostClassifier\nfrom pathlib import Path\n\n# 1. Load the same temporal feature dataset\nbase = Path(\"/kaggle/working/task2_training_labels\")\ndf = pd.read_csv(base / \"D7_I10_E_train_features_temporal.csv\")\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# 2. Exclude labels, target-derived columns, and identifiers\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeatures = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nwindows = sorted(df[\"window_id\"].unique())\noof_parts = []\n\n# 3. Train both models while holding out one entire window per fold\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[features].replace([np.inf, -np.inf], np.nan)\n    Xva = va[features].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].astype(int).to_numpy()\n    yva = va[\"queue_label\"].astype(int).to_numpy()\n\n    positives = max(int(ytr.sum()), 1)\n    negatives = len(ytr) - int(ytr.sum())\n    pos_weight = negatives / positives\n\n    # LightGBM\n    lgb_model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=pos_weight,\n        random_state=42,\n        verbosity=-1,\n    )\n    lgb_model.fit(Xtr, ytr)\n    p_lgb = lgb_model.predict_proba(Xva)[:, 1]\n\n    # CatBoost\n    cat_model = CatBoostClassifier(\n        iterations=300,\n        depth=5,\n        learning_rate=0.03,\n        loss_function=\"Logloss\",\n        class_weights=[1.0, pos_weight],\n        random_seed=42,\n        verbose=False,\n        allow_writing_files=False,\n        thread_count=-1,\n    )\n    cat_model.fit(Xtr, ytr)\n    p_cat = cat_model.predict_proba(Xva)[:, 1]\n\n    out = va[\n        [\"window_id\", \"condition\", \"queue_label\", \"horizon_step\"]\n    ].copy()\n    out[\"p_lightgbm\"] = p_lgb\n    out[\"p_catboost\"] = p_cat\n    out[\"p_ensemble\"] = (p_lgb + p_cat) / 2\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\n# 4. Save all aligned out-of-fold probabilities\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(base / \"D7_I10_E_ensemble_oof.csv\", index=False)\n\n# 5. Score each method with equal weight per window\ndef score_method(data, probability_column, threshold=0.5):\n    rows = []\n\n    for wid, group in data.groupby(\"window_id\", sort=True):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = group[probability_column].to_numpy() >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n        iou = intersection / union if union else 1.0\n\n        rows.append({\n            \"window_id\": wid,\n            \"condition\": group[\"condition\"].iloc[0],\n            \"true_queued\": int(y.sum()),\n            \"predicted_queued\": int(pred.sum()),\n            \"IoU\": float(iou),\n        })\n\n    result = pd.DataFrame(rows)\n    return result, result[\"IoU\"].mean()\n\nfor method in [\"p_lightgbm\", \"p_catboost\", \"p_ensemble\"]:\n    result, mean_iou = score_method(oof, method, threshold=0.5)\n    print(f\"\\n=== {method} ===\")\n    print(result.round(4).to_string(index=False))\n    print(\"Overall mean per-window IoU:\", round(mean_iou, 4))\n    print(\n        \"Mean IoU by condition:\",\n        result.groupby(\"condition\")[\"IoU\"].mean().round(4).to_dict()\n    )\n\nprint(\"\\nSaved OOF probabilities:\", base / \"D7_I10_E_ensemble_oof.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:59:00.185332Z","iopub.execute_input":"2026-10-24T08:59:00.185612Z","iopub.status.idle":"2026-10-24T08:59:12.567543Z","shell.execute_reply.started":"2026-10-24T08:59:00.185593Z","shell.execute_reply":"2026-10-24T08:59:12.566823Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== p_lightgbm ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 5 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               131 0.7941\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3909\nMean IoU by condition: {'queue_ongoing': 0.7597, 'queue_onset': 0.0222}\n\n=== p_catboost ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 2 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.8370\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3952\nMean IoU by condition: {'queue_ongoing': 0.7683, 'queue_onset': 0.0222}\n\n=== p_ensemble ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 3 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.7714\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3887\nMean IoU by condition: {'queue_ongoing': 0.7551, 'queue_onset': 0.0222}\n\nSaved OOF probabilities: /kaggle/working/task2_training_labels/D7_I10_E_ensemble_oof.csv\n","output_type":"stream"}],"execution_count":43},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\npath = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_ensemble_oof.csv\"\n)\noof = pd.read_csv(path)\n\ndef evaluate(prob, threshold):\n    scores = []\n    for _, group in oof.groupby(\"window_id\", sort=True):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = prob[group.index.to_numpy()] >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n        scores.append(intersection / union if union else 1.0)\n\n    return float(np.mean(scores)), scores\n\nbest = None\nresults = []\n\n# Weight = share assigned to CatBoost.\nfor cat_weight in np.arange(0.0, 1.01, 0.1):\n    prob = (\n        (1 - cat_weight) * oof[\"p_lightgbm\"].to_numpy()\n        + cat_weight * oof[\"p_catboost\"].to_numpy()\n    )\n\n    for threshold in np.arange(0.10, 0.96, 0.02):\n        mean_iou, scores = evaluate(prob, threshold)\n        results.append((mean_iou, cat_weight, threshold, scores))\n\n        if best is None or mean_iou > best[0]:\n            best = (mean_iou, cat_weight, threshold, scores)\n\nprint(\"Best mean per-window IoU:\", round(best[0], 4))\nprint(\"CatBoost weight:\", round(best[1], 2))\nprint(\"LightGBM weight:\", round(1 - best[1], 2))\nprint(\"Threshold:\", round(best[2], 2))\n\n# Show each window's score at the best setting.\nbest_prob = (\n    (1 - best[1]) * oof[\"p_lightgbm\"].to_numpy()\n    + best[1] * oof[\"p_catboost\"].to_numpy()\n)\nbest_threshold = best[2]\n\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    idx = group.index.to_numpy()\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = best_prob[idx] >= best_threshold\n    union = np.sum(y | pred)\n    intersection = np.sum(y & pred)\n    iou = intersection / union if union else 1.0\n    print(\n        wid,\n        \"| condition:\", group[\"condition\"].iloc[0],\n        \"| predicted:\", int(pred.sum()),\n        \"| IoU:\", round(float(iou), 4),\n    )\n\nprint(\"\\nNote: weights and threshold are tuned on these same 10 OOF windows.\")\nprint(\"Treat this as exploratory; the best score may be optimistic.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:00:35.654105Z","iopub.execute_input":"2026-10-24T09:00:35.654712Z","iopub.status.idle":"2026-10-24T09:00:36.32182Z","shell.execute_reply.started":"2026-10-24T09:00:35.654692Z","shell.execute_reply":"2026-10-24T09:00:36.321137Z"}},"outputs":[{"name":"stdout","text":"Best mean per-window IoU: 0.3994\nCatBoost weight: 0.1\nLightGBM weight: 0.9\nThreshold: 0.74\nQ2_D7_I10_E_train_001 | condition: queue_onset | predicted: 1 | IoU: 0.0\nQ2_D7_I10_E_train_002 | condition: queue_onset | predicted: 4 | IoU: 0.0\nQ2_D7_I10_E_train_003 | condition: queue_onset | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_004 | condition: queue_onset | predicted: 6 | IoU: 0.1429\nQ2_D7_I10_E_train_005 | condition: queue_onset | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_006 | condition: queue_ongoing | predicted: 111 | IoU: 0.8512\nQ2_D7_I10_E_train_007 | condition: queue_ongoing | predicted: 105 | IoU: 0.8609\nQ2_D7_I10_E_train_008 | condition: queue_ongoing | predicted: 29 | IoU: 0.4203\nQ2_D7_I10_E_train_009 | condition: queue_ongoing | predicted: 354 | IoU: 0.8389\nQ2_D7_I10_E_train_010 | condition: queue_ongoing | predicted: 22 | IoU: 0.88\n\nNote: weights and threshold are tuned on these same 10 OOF windows.\nTreat this as exploratory; the best score may be optimistic.\n","output_type":"stream"}],"execution_count":44},{"cell_type":"code","source":"\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D7_I10_E\"\npanel_dir = ROOT / \"corridors\" / panel\n\nprint(\"Panel directory exists:\", panel_dir.exists())\nprint(\"\\nNetwork files:\")\n\nnetwork_dir = panel_dir / \"network\"\n\nif network_dir.exists():\n    for path in sorted(network_dir.rglob(\"*\")):\n        if path.is_file():\n            print(path.relative_to(panel_dir), \"|\", path.stat().st_size, \"bytes\")\nelse:\n    print(\"No network directory found.\")\n    print(\"\\nNearby files containing 'network' or 'link':\")\n    for path in panel_dir.rglob(\"*\"):\n        if path.is_file() and (\n            \"network\" in path.name.lower()\n            or \"link\" in path.name.lower()\n        ):\n            print(path.relative_to(panel_dir))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:02:36.158929Z","iopub.execute_input":"2026-10-24T09:02:36.159264Z","iopub.status.idle":"2026-10-24T09:02:36.200066Z","shell.execute_reply.started":"2026-10-24T09:02:36.159241Z","shell.execute_reply":"2026-10-24T09:02:36.199378Z"}},"outputs":[{"name":"stdout","text":"Panel directory exists: True\n\nNetwork files:\nnetwork/fd_parameters.csv | 8439 bytes\nnetwork/links.csv | 4956 bytes\nnetwork/lwr_mainline_topology.csv | 22063 bytes\nnetwork/path_link_incidence.csv | 8038841 bytes\nnetwork/path_set.csv | 3846393 bytes\nnetwork/ramp_attachment_map.csv | 4108 bytes\nnetwork/synthetic_network_manifest.json | 383 bytes\nnetwork/synthetic_ramp_attachment_map.csv | 4108 bytes\n","output_type":"stream"}],"execution_count":45},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nnetwork_dir = (\n    ROOT / \"corridors\" / \"D7_I10_E\" / \"network\"\n)\n\nfiles = [\n    \"lwr_mainline_topology.csv\",\n    \"links.csv\",\n    \"ramp_attachment_map.csv\",\n]\n\nfor filename in files:\n    path = network_dir / filename\n    print(f\"\\n{'=' * 20} {filename} {'=' * 20}\")\n\n    df_top = pd.read_csv(path)\n    print(\"Shape:\", df_top.shape)\n    print(\"Columns:\", df_top.columns.tolist())\n    print(df_top.head(5).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:04:10.706783Z","iopub.execute_input":"2026-10-24T09:04:10.707481Z","iopub.status.idle":"2026-10-24T09:04:10.747668Z","shell.execute_reply.started":"2026-10-24T09:04:10.707454Z","shell.execute_reply":"2026-10-24T09:04:10.746905Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"\n==================== lwr_mainline_topology.csv ====================\nShape: (146, 22)\nColumns: ['mainline_link_id', 'incoming_link_ids', 'outgoing_link_ids', 'on_ramp_link_ids', 'off_ramp_link_ids', 'incoming_has_sensor', 'outgoing_has_sensor', 'lanes', 'length_km', 'capacity_vph', 'free_speed_kmh', 'order_index', 'link_id', 'from_node', 'to_node', 'has_sensor', 'detector_id', 'n_incoming', 'n_outgoing', 'n_incoming_no_sensor', 'n_outgoing_no_sensor', 'free_flow_speed_kmh']\nmainline_link_id    incoming_link_ids     outgoing_link_ids       on_ramp_link_ids off_ramp_link_ids incoming_has_sensor outgoing_has_sensor  lanes  length_km  capacity_vph  free_speed_kmh  order_index  link_id  from_node  to_node  has_sensor       detector_id  n_incoming  n_outgoing  n_incoming_no_sensor  n_outgoing_no_sensor  free_flow_speed_kmh\n        L10E-166          CONN-417-IN L10E-147;CONN-456-OUT SYN_RAMP_D7_I10_E_0051               NaN                   0                 1;0      3      0.414        6000.0           105.0            0 L10E-166        147      211           1 SYN_D7_I10_E_0001           1           2                     1                     1                105.0\n        L10E-147 L10E-166;CONN-456-IN L10E-209;CONN-457-OUT                    NaN               NaN                 1;0                 1;0      3      0.448        6000.0           105.0            1 L10E-147        211      212           1 SYN_D7_I10_E_0002           2           2                     1                     1                105.0\n        L10E-209 L10E-147;CONN-457-IN L10E-171;CONN-475-OUT SYN_RAMP_D7_I10_E_0086               NaN                 1;0                 0;0      3      1.424        6000.0           105.0            2 L10E-209        212      239           1 SYN_D7_I10_E_0003           2           2                     1                     2                105.0\n        L10E-171 L10E-209;CONN-475-IN              L10E-043                    NaN               NaN                 1;0                   0      4      0.120        8000.0           105.0            3 L10E-171        239       66           0 SYN_D7_I10_E_0004           2           1                     1                     1                105.0\n        L10E-043             L10E-171 L10E-180;CONN-383-OUT                    NaN               NaN                   0                 1;0      4      0.041        8000.0           105.0            4 L10E-043         66       67           0 SYN_D7_I10_E_0005           1           2                     1                     1                105.0\n\n==================== links.csv ====================\nShape: (146, 5)\nColumns: ['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n link_id  length_km  lanes  free_speed_kmh  capacity_vph\nL10E-166      0.414    3.0           105.4        5756.4\nL10E-147      0.448    3.0           105.4        5756.4\nL10E-209      1.424    3.0           105.4        5756.4\nL10E-171      0.120    3.0           113.0        5756.4\nL10E-043      0.041    4.0           113.0        7675.2\n\n==================== ramp_attachment_map.csv ====================\nShape: (116, 3)\nColumns: ['ramp_link_id', 'ramp_type', 'nearest_mainline_link_id']\n          ramp_link_id ramp_type nearest_mainline_link_id\nSYN_RAMP_D7_I10_E_0001        OR                 L10E-208\nSYN_RAMP_D7_I10_E_0002        OR                 L10E-126\nSYN_RAMP_D7_I10_E_0003        OR                 L10E-078\nSYN_RAMP_D7_I10_E_0004        OR                 L10E-023\nSYN_RAMP_D7_I10_E_0005        OR                 L10E-021\n","output_type":"stream"}],"execution_count":46},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\n\nhistory_path = ROOT / \"task2\" / PANEL / \"train\" / \"window_history.parquet\"\nnetwork_dir = ROOT / \"corridors\" / PANEL / \"network\"\ntemporal_path = BASE / f\"{PANEL}_train_features_temporal.csv\"\n\n# Verify paths and required columns.\nassert history_path.exists(), f\"History not found: {history_path}\"\nassert temporal_path.exists(), f\"Feature file not found: {temporal_path}\"\n\nhistory = pd.read_parquet(history_path)\ntopology = pd.read_csv(network_dir / \"lwr_mainline_topology.csv\")\nfeatures = pd.read_csv(temporal_path)\n\nrequired = {\n    \"window_id\", \"timestamp\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"occupancy\"\n}\nassert required.issubset(history.columns), (\n    f\"History columns missing: {required - set(history.columns)}\"\n)\n\nprint(\"History shape:\", history.shape)\nprint(\"History windows:\", history[\"window_id\"].nunique())\nprint(\"Feature rows:\", len(features))\n\n# Calculate the latest available observation per link in each window.\nhistory[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\nhistory = history.sort_values(\"timestamp\")\nlatest = history.groupby(\n    [\"window_id\", \"link_id\"], as_index=False\n).tail(1).copy()\n\n# Normalize speed using the topology's static free-flow speed.\ntopology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\ntopology[\"free_speed_kmh\"] = pd.to_numeric(\n    topology[\"free_speed_kmh\"], errors=\"coerce\"\n)\nfree_speed = topology.set_index(\"mainline_link_id\")[\"free_speed_kmh\"]\n\nlatest[\"link_id\"] = latest[\"link_id\"].astype(str)\nlatest[\"neighbor_free_speed\"] = latest[\"link_id\"].map(free_speed)\nlatest[\"neighbor_speed_ratio\"] = (\n    latest[\"speed_kmh\"] / latest[\"neighbor_free_speed\"]\n)\n\n# Keep only mainline neighbors explicitly listed in topology.\nmainline_ids = set(topology[\"mainline_link_id\"])\n\ndef parse_neighbors(value):\n    if pd.isna(value):\n        return []\n    return [\n        x.strip() for x in str(value).split(\";\")\n        if x.strip() in mainline_ids\n    ]\n\nincoming = {\n    r[\"mainline_link_id\"]: parse_neighbors(r[\"incoming_link_ids\"])\n    for _, r in topology.iterrows()\n}\noutgoing = {\n    r[\"mainline_link_id\"]: parse_neighbors(r[\"outgoing_link_ids\"])\n    for _, r in topology.iterrows()\n}\n\n# Lookup keyed by (window, link); use only released history.\nlookup = latest.set_index([\"window_id\", \"link_id\"])\nspatial_rows = []\n\nfor window_id, group in latest.groupby(\"window_id\", sort=False):\n    for link_id in group[\"link_id\"].unique():\n        row = {\"window_id\": window_id, \"link_id\": link_id}\n\n        for direction, mapping in [\n            (\"upstream\", incoming),\n            (\"downstream\", outgoing),\n        ]:\n            neighbors = mapping.get(link_id, [])\n            vals = []\n\n            for neighbor_id in neighbors:\n                key = (window_id, neighbor_id)\n                if key not in lookup.index:\n                    continue\n\n                item = lookup.loc[key]\n                if isinstance(item, pd.DataFrame):\n                    item = item.iloc[-1]\n                vals.append(item)\n\n            ratios = [\n                float(v[\"neighbor_speed_ratio\"])\n                for v in vals\n                if pd.notna(v[\"neighbor_speed_ratio\"])\n            ]\n            flows = [\n                float(v[\"flow_vph\"]) for v in vals\n                if pd.notna(v[\"flow_vph\"])\n            ]\n            occs = [\n                float(v[\"occupancy\"]) for v in vals\n                if pd.notna(v[\"occupancy\"])\n            ]\n\n            row[f\"{direction}_neighbor_count\"] = len(neighbors)\n            row[f\"{direction}_valid_speed_count\"] = len(ratios)\n            row[f\"{direction}_mean_speed_ratio\"] = (\n                np.mean(ratios) if ratios else np.nan\n            )\n            row[f\"{direction}_min_speed_ratio\"] = (\n                np.min(ratios) if ratios else np.nan\n            )\n            row[f\"{direction}_slow_neighbor_fraction\"] = (\n                np.mean(np.array(ratios) <= 0.6) if ratios else np.nan\n            )\n            row[f\"{direction}_mean_flow\"] = (\n                np.mean(flows) if flows else np.nan\n            )\n            row[f\"{direction}_mean_occupancy\"] = (\n                np.mean(occs) if occs else np.nan\n            )\n\n        spatial_rows.append(row)\n\nspatial = pd.DataFrame(spatial_rows)\n\nif spatial.empty:\n    raise ValueError(\n        \"Spatial features are empty. Stop here; do not merge.\"\n    )\n\nprint(\"Spatial rows:\", len(spatial))\nprint(\"Spatial columns:\", len(spatial.columns))\nprint(\"Example spatial rows:\")\nprint(spatial.head().to_string(index=False))\n\n# Confirm feature keys are compatible before merging.\nassert {\"window_id\", \"link_id\"}.issubset(features.columns)\nassert {\"window_id\", \"link_id\"}.issubset(spatial.columns)\n\nmerged = features.merge(\n    spatial,\n    on=[\"window_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nassert len(merged) == len(features), \"Row count changed after merge\"\nout_path = BASE / f\"{PANEL}_train_features_spatial.csv\"\nmerged.to_csv(out_path, index=False)\n\nprint(\"\\nSaved:\", out_path)\nprint(\"Merged rows:\", len(merged))\nprint(\"New spatial features:\", len(spatial.columns) - 2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:06:26.767139Z","iopub.execute_input":"2026-10-24T09:06:26.767433Z","iopub.status.idle":"2026-10-24T09:06:31.071799Z","shell.execute_reply.started":"2026-10-24T09:06:26.767411Z","shell.execute_reply":"2026-10-24T09:06:31.070241Z"}},"outputs":[{"name":"stdout","text":"History shape: (17520, 8)\nHistory windows: 10\nFeature rows: 8760\nSpatial rows: 1460\nSpatial columns: 16\nExample spatial rows:\n            window_id  link_id  upstream_neighbor_count  upstream_valid_speed_count  upstream_mean_speed_ratio  upstream_min_speed_ratio  upstream_slow_neighbor_fraction  upstream_mean_flow  upstream_mean_occupancy  downstream_neighbor_count  downstream_valid_speed_count  downstream_mean_speed_ratio  downstream_min_speed_ratio  downstream_slow_neighbor_fraction  downstream_mean_flow  downstream_mean_occupancy\nQ2_D7_I10_E_train_001 L10E-209                        1                           1                   1.010456                  1.010456                              0.0         5245.081162                 0.168196                          1                             1                     1.095342                    1.095342                                0.0           5137.084214                   0.157930\nQ2_D7_I10_E_train_001 L10E-208                        1                           0                        NaN                       NaN                              NaN                 NaN                      NaN                          1                             0                          NaN                         NaN                                NaN                   NaN                        NaN\nQ2_D7_I10_E_train_001 L10E-224                        0                           0                        NaN                       NaN                              NaN                 NaN                      NaN                          0                             0                          NaN                         NaN                                NaN                   NaN                        NaN\nQ2_D7_I10_E_train_001 L10E-206                        1                           1                   1.075870                  1.075870                              0.0         5048.593071                 0.148785                          1                             1                     1.080564                    1.080564                                0.0           4999.566281                   0.151581\nQ2_D7_I10_E_train_001 L10E-205                        1                           1                   1.061144                  1.061144                              0.0         4861.795378                 0.151595                          1                             1                     1.088100                    1.088100                                0.0           5024.146187                   0.156122\n\nSaved: /kaggle/working/task2_training_labels/D7_I10_E_train_features_spatial.csv\nMerged rows: 8760\nNew spatial features: 14\n","output_type":"stream"}],"execution_count":49},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ndf = pd.read_csv(base / \"D7_I10_E_train_features_spatial.csv\")\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nprint(\"Valid rows:\", len(df))\nprint(\"Features:\", len(feature_cols))\nprint(\"Spatial features:\", [\n    c for c in feature_cols\n    if c.startswith((\"upstream_\", \"downstream_\"))\n])\n\noof_parts = []\nwindows = sorted(df[\"window_id\"].unique())\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    Xva = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].astype(int)\n\n    positives = max(int(ytr.sum()), 1)\n    negatives = len(ytr) - int(ytr.sum())\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / positives,\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(Xtr, ytr)\n\n    out = va[[\"window_id\", \"condition\", \"queue_label\"]].copy()\n    out[\"probability\"] = model.predict_proba(Xva)[:, 1]\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(base / \"D7_I10_E_spatial_oof.csv\", index=False)\n\nresults = []\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\nresults = pd.DataFrame(results)\nprint(\"\\n=== LIGHTGBM + TEMPORAL + SPATIAL ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:06:48.201388Z","iopub.execute_input":"2026-10-24T09:06:48.201662Z","iopub.status.idle":"2026-10-24T09:06:53.452219Z","shell.execute_reply.started":"2026-10-24T09:06:48.201641Z","shell.exe