on_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD7_I210_E | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD7_I210_W | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD7_I405_N | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD7_I405_S | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD12_I5_N | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n\nD12_I5_S | exists=True\n  sample_submission_queue.csv (file)\n  window_history.parquet (file)\n  window_index.csv (file)\n","output_type":"stream"}],"execution_count":67},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nresults = []\n\nfor panel in panels:\n    path = BASE / f\"{panel}_train_labels.csv\"\n    assert path.exists(), f\"Missing verified label file: {path}\"\n\n    labels = pd.read_csv(path)\n\n    d = labels[\n        (labels[\"condition\"] == \"queue_onset\")\n        & (labels[\"horizon_step\"] == 6)\n        & labels[\"label_valid\"].astype(bool)\n        & labels[\"queue_label\"].notna()\n    ].copy()\n\n    positives = d[d[\"queue_label\"] == 1]\n    recurrence = positives.groupby(\"link_id\")[\"window_id\"].nunique()\n\n    results.append({\n        \"panel\": panel,\n        \"valid_h6_cells\": len(d),\n        \"positive_cells\": len(positives),\n        \"positive_links\": positives[\"link_id\"].nunique(),\n        \"links_positive_in_multiple_windows\": int((recurrence > 1).sum()),\n        \"max_windows_for_one_positive_link\": (\n            int(recurrence.max()) if len(recurrence) else 0\n        ),\n        \"onset_queue_rate_pct\": round(100 * d[\"queue_label\"].mean(), 3)\n            if len(d) else float(\"nan\"),\n    })\n\nsummary = pd.DataFrame(results)\nprint(summary.to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:31:29.803603Z","iopub.execute_input":"2026-10-24T09:31:29.803869Z","iopub.status.idle":"2026-10-24T09:31:29.960112Z","shell.execute_reply.started":"2026-10-24T09:31:29.803849Z","shell.execute_reply":"2026-10-24T09:31:29.959282Z"}},"outputs":[{"name":"stdout","text":"    panel  valid_h6_cells  positive_cells  positive_links  links_positive_in_multiple_windows  max_windows_for_one_positive_link  onset_queue_rate_pct\n D7_I10_E             469              18               7                                   5                                  4                 3.838\n D7_I10_W             350               3               1                                   1                                  3                 0.857\nD7_I210_E             946              19               5                                   5                                  5                 2.008\nD7_I210_W             238               9               7                                   2                                  2                 3.782\nD7_I405_N            1108              12               8                                   2                                  3                 1.083\nD7_I405_S             336              20              10                                   7                                  3                 5.952\n D12_I5_N             839               9               6                                   2                                  3                 1.073\n D12_I5_S             315              10               7                                   2                                  3                 3.175\n","output_type":"stream"}],"execution_count":68},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nresults = []\n\nfor panel in panels:\n    path = BASE / f\"{panel}_train_labels.csv\"\n    labels = pd.read_csv(path)\n\n    d = labels[\n        (labels[\"condition\"] == \"queue_onset\")\n        & (labels[\"horizon_step\"] == 6)\n        & labels[\"label_valid\"].astype(bool)\n        & labels[\"queue_label\"].notna()\n    ].copy()\n\n    fold_ious = []\n\n    for wid in sorted(d[\"window_id\"].unique()):\n        train = d[d[\"window_id\"] != wid]\n        test = d[d[\"window_id\"] == wid]\n\n        positive_links = set(\n            train.loc[train[\"queue_label\"] == 1, \"link_id\"]\n        )\n        pred = test[\"link_id\"].isin(positive_links).to_numpy()\n        actual = test[\"queue_label\"].astype(bool).to_numpy()\n\n        union = (pred | actual).sum()\n        iou = (pred & actual).sum() / union if union else 1.0\n        fold_ious.append(iou)\n\n    results.append({\n        \"panel\": panel,\n        \"onset_windows\": len(fold_ious),\n        \"positive_cells\": int(d[\"queue_label\"].sum()),\n        \"mean_onset_IoU\": (\n            sum(fold_ious) / len(fold_ious) if fold_ious else float(\"nan\")\n        ),\n    })\n\nprint(pd.DataFrame(results).round(4).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:34:19.215937Z","iopub.execute_input":"2026-10-24T09:34:19.217124Z","iopub.status.idle":"2026-10-24T09:34:19.425493Z","shell.execute_reply.started":"2026-10-24T09:34:19.217079Z","shell.execute_reply":"2026-10-24T09:34:19.424456Z"}},"outputs":[{"name":"stdout","text":"    panel  onset_windows  positive_cells  mean_onset_IoU\n D7_I10_E              5              18          0.9333\n D7_I10_W              5               3          1.0000\nD7_I210_E              5              19          1.0000\nD7_I210_W              5               9          0.2133\nD7_I405_N              5              12          0.2105\nD7_I405_S              5              20          0.5286\n D12_I5_N              5               9          0.4067\n D12_I5_S              5              10          0.2305\n","output_type":"stream"}],"execution_count":69},{"cell_type":"code","source":"from pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in panels:\n    print(f\"\\n{panel}\")\n    for suffix in [\n        \"train_labels.csv\",\n        \"train_features.csv\",\n        \"train_features_temporal.csv\",\n        \"train_features_spatial.csv\",\n    ]:\n        path = base / f\"{panel}_{suffix}\"\n        print(f\"  {'EXISTS' if path.exists() else 'MISSING'}  {path.name}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:36:24.176521Z","iopub.execute_input":"2026-10-24T09:36:24.176812Z","iopub.status.idle":"2026-10-24T09:36:24.18491Z","shell.execute_reply.started":"2026-10-24T09:36:24.176787Z","shell.execute_reply":"2026-10-24T09:36:24.184219Z"}},"outputs":[{"name":"stdout","text":"\nD7_I10_E\n  EXISTS  D7_I10_E_train_labels.csv\n  EXISTS  D7_I10_E_train_features.csv\n  EXISTS  D7_I10_E_train_features_temporal.csv\n  EXISTS  D7_I10_E_train_features_spatial.csv\n\nD7_I10_W\n  EXISTS  D7_I10_W_train_labels.csv\n  MISSING  D7_I10_W_train_features.csv\n  MISSING  D7_I10_W_train_features_temporal.csv\n  MISSING  D7_I10_W_train_features_spatial.csv\n\nD7_I210_E\n  EXISTS  D7_I210_E_train_labels.csv\n  MISSING  D7_I210_E_train_features.csv\n  MISSING  D7_I210_E_train_features_temporal.csv\n  MISSING  D7_I210_E_train_features_spati