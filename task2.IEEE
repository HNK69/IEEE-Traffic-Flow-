:"stdout","text":"\nSaved audit: /kaggle/working/task2_training_labels/hybrid_onset_window_audit.csv\n","output_type":"stream"}],"execution_count":102},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\npred = pd.read_csv(BASE / \"link_history_experiment_predictions.csv\")\n\nRULE_PANELS = {\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\"}\n\npred[\"panel_hybrid_pred\"] = pred[\"baseline_pred\"]\n\n# Apply link history only to onset rows in the selected panels.\nmask = (\n    pred[\"panel\"].isin(RULE_PANELS)\n    & pred[\"condition\"].eq(\"queue_onset\")\n)\npred.loc[mask, \"panel_hybrid_pred\"] = pred.loc[mask, \"link_history_pred\"]\n\ndef evaluate(frame, pred_col):\n    rows = []\n    for (panel, window, condition), group in frame.groupby(\n        [\"panel\", \"window_id\", \"condition\"], dropna=False\n    ):\n        y = group[\"y_true\"].to_numpy()\n        p = group[pred_col].to_numpy()\n\n        tp = int(((y == 1) & (p == 1)).sum())\n        fp = int(((y == 0) & (p == 1)).sum())\n        fn = int(((y == 1) & (p == 0)).sum())\n        union = tp + fp + fn\n\n        rows.append({\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"tp\": tp,\n            \"fp\": fp,\n            \"fn\": fn,\n            \"iou\": tp / union if union else 1.0,\n        })\n\n    return pd.DataFrame(rows)\n\nsummaries = []\nfor name, col in [\n    (\"baseline\", \"baseline_pred\"),\n    (\"panel_specific_hybrid\", \"panel_hybrid_pred\"),\n]:\n    scores = evaluate(pred, col)\n    summaries.append({\n        \"model\": name,\n        \"overall_iou\": scores[\"iou\"].mean(),\n        \"onset_iou\": scores.loc[\n            scores[\"condition\"].eq(\"queue_onset\"), \"iou\"\n        ].mean(),\n        \"ongoing_iou\": scores.loc[\n            scores[\"condition\"].eq(\"queue_ongoing\"), \"iou\"\n        ].mean(),\n    })\n\n    print(f\"\\n{name.upper()} — ONSET BY PANEL\")\n    display(\n        scores[scores[\"condition\"].eq(\"queue_onset\")]\n        .groupby(\"panel\")\n        .agg(\n            mean_window_iou=(\"iou\", \"mean\"),\n            tp=(\"tp\", \"sum\"),\n            fp=(\"fp\", \"sum\"),\n            fn=(\"fn\", \"sum\"),\n        )\n        .round(4)\n    )\n\nprint(\"\\nOVERALL COMPARISON\")\ndisplay(pd.DataFrame(summaries).round(4))\n\npred.to_csv(BASE / \"panel_specific_hybrid_predictions.csv\", index=False)\nprint(\"Saved:\", BASE / \"panel_specific_hybrid_predictions.csv\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:50:49.830844Z","iopub.execute_input":"2026-10-24T10:50:49.831195Z","iopub.status.idle":"2026-10-24T10:50:50.064586Z","shell.execute_reply.started":"2026-10-24T10:50:49.831169Z","shell.execute_reply":"2026-10-24T10:50:50.063767Z"}},"outputs":[{"name":"stdout","text":"\nBASELINE — ONSET BY PANEL\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           mean_window_iou  tp  fp  fn\npanel                                 \nD12_I5_N            0.0000   0   6   9\nD12_I5_S            0.2000   0   0  10\nD7_I10_E            0.0000   0   6  18\nD7_I10_W            0.4000   0   0   3\nD7_I210_E           0.0400   1   4  18\nD7_I210_W           0.1000   1   3   8\nD7_I405_N           0.0400   1   7  11\nD7_I405_S           0.0333   1   6  19","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>mean_window_iou</th>\n      <th>tp</th>\n      <th>fp</th>\n      <th>fn</th>\n    </tr>\n    <tr>\n      <th>panel</th>\n      <th></th>\n      <th></th>\n      <th></th>\n  