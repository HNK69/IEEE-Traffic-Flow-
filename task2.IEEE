12      239           1 SYN_D7_I10_E_0003           2           2                     1                     2                105.0\n        L10E-171 L10E-209;CONN-475-IN              L10E-043                    NaN               NaN                 1;0                   0      4      0.120        8000.0           105.0            3 L10E-171        239       66           0 SYN_D7_I10_E_0004           2           1                     1                     1                105.0\n        L10E-043             L10E-171 L10E-180;CONN-383-OUT                    NaN               NaN                   0                 1;0      4      0.041        8000.0           105.0            4 L10E-043         66       67           0 SYN_D7_I10_E_0005           1           2                     1                     1                105.0\n\n==================== links.csv ====================\nShape: (146, 5)\nColumns: ['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n link_id  length_km  lanes  free_speed_kmh  capacity_vph\nL10E-166      0.414    3.0           105.4        5756.4\nL10E-147      0.448    3.0           105.4        5756.4\nL10E-209      1.424    3.0           105.4        5756.4\nL10E-171      0.120    3.0           113.0        5756.4\nL10E-043      0.041    4.0           113.0        7675.2\n\n==================== ramp_attachment_map.csv ====================\nShape: (116, 3)\nColumns: ['ramp_link_id', 'ramp_type', 'nearest_mainline_link_id']\n          ramp_link_id ramp_type nearest_mainline_link_id\nSYN_RAMP_D7_I10_E_0001        OR                 L10E-208\nSYN_RAMP_D7_I10_E_0002        OR                 L10E-126\nSYN_RAMP_D7_I10_E_0003        OR                 L10E-078\nSYN_RAMP_D7_I10_E_0004        OR                 L10E-023\nSYN_RAMP_D7_I10_E_0005        OR                 L10E-021\n","output_type":"stream"}],"execution_count":46},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\n\nhistory_path = ROOT / \"task2\" / PANEL / \"train\" / \"window_history.parquet\"\nnetwork_dir = ROOT / \"corridors\" / PANEL / \"network\"\ntemporal_path = BASE / f\"{PANEL}_train_features_temporal.csv\"\n\n# Verify paths and required columns.\nassert history_path.exists(), f\"History not found: {history_path}\"\nassert temporal_path.exists(), f\"Feature file not found: {temporal_path}\"\n\nhistory = pd.read_parquet(history_path)\ntopology = pd.read_csv(network_dir / \"lwr_mainline_topology.csv\")\nfeatures = pd.read_csv(temporal_path)\n\nrequired = {\n    \"window_id\", \"timestamp\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"occupancy\"\n}\nassert required.issubset(history.columns), (\n    f\"History columns missing: {required - set(history.columns)}\"\n)\n\nprint(\"History shape:\", history.shape)\nprint(\"History windows:\", history[\"window_id\"].nunique())\nprint(\"Feature rows:\", len(features))\n\n# Calculate the latest available observation per link in each window.\nhistory[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\nhistory = history.sort_values(\"timestamp\")\nlatest = history.groupby(\n    [\"window_id\", \"link_id\"], as_index=False\n).tail(1).copy()\n\n# Normalize speed using the topology's static free-flow speed.\ntopology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\ntopology[\"free_speed_kmh\"] = pd.to_numeric(\n    topology[\"free_speed_kmh\"], errors=\"coerce\"\n)\nfree_speed = topology.set_index(\"mainline_link_id\")[\"free_speed_kmh\"]\n\nlatest[\"link_id\"] = latest[\"link_id\"].astype(str)\nlatest[\"neighbor_free_speed\"] = latest[\"link_id\"].map(free_speed)\nlatest[\"neighbor_speed_ratio\"] = (\n    latest[\"speed_kmh\"] / latest[\"neighbor_free_speed\"]\n)\n\n# Keep only mainline neighbors explicitly listed in topology.\nmainline_ids = set(topology[\"mainline_link_id\"])\n\ndef parse_neighbors(value):\n    if pd.isna(value):\n        return []\n    return [\n        x.strip() for x in str(value).split(\";\")\n        if x.strip() in mainline_ids\n    ]\n\nincoming = {\n    r[\"mainline_link_id\"]: parse_neighbors(r[\"incoming_link_ids\"])\n    for _, r in topology.iterrows()\n}\noutgoing = {\n    r[\"mainline_link_id\"]: parse_neighbors(r[\"outgoing_link_ids\"])\n    for _, r in topology.iterrows()\n}\n\n# Lookup keyed by (window, link); use only released history.\nlookup = latest.set_index([\"window_id\", \"link_id\"])\nspatial_rows = []\n\nfor window_id, group in latest.groupby(\"window_id\", sort=False):\n    for link_id in group[\"link_id\"].unique():\n        row = {\"window_id\": window_id, \"link_id\": link_id}\n\n        for direction, mapping in [\n            (\"upstream\", incoming),\n            (\"downstream\", outgoing),\n        ]:\n            neighbors = mapping.get(link_id, [])\n            vals = []\n\n            for neighbor_id in neighbors:\n                key = (window_id, neighbor_id)\n                if key not in lookup.index:\n                    continue\n\n                item = lookup.loc[key]\n                if isinstance(item, pd.DataFrame):\n                    item = item.iloc[-1]\n                vals.append(item)\n\n            ratios = [\n                float(v[\"neighbor_speed_ratio\"])\n                for v in vals\n                if pd.notna(v[\"neighbor_speed_ratio\"])\n            ]\n            flows = [\n                float(v[\"flow_vph\"]) for v in vals\n                if pd.notna(v[\"flow_vph\"])\n            ]\n            occs = [\n                float(v[\"occupancy\"]) for v in vals\n                if pd.notna(v[\"occupancy\"])\n            ]\n\n            row[f\"{direction}_neighbor_count\"] = len(neighbors)\n            row[f\"{direction}_valid_speed_count\"] = len(ratios)\n            row[f\"{direction}_mean_speed_ratio\"] = (\n                np.mean(ratios) if ratios else np.nan\n            )\n            row[f\"{direction}_min_speed_ratio\"] = (\n                np.min(ratios) if ratios else np.nan\n            )\n            row[f\"{direction}_slow_neighbor_fraction\"] = (\n                np.mean(np.array(ratios) <= 0.6) if ratios else np.nan\n            )\n            row[f\"{direction}_mean_flow\"] = (\n                np.mean(flows) if flows else np.nan\n            )\n            row[f\"{direction}_mean_occupancy\"] = (\n                np.mean(occs) if occs else np.nan\n            )\n\n        spatial_rows.append(row)\n\nspatial = pd.DataFrame(spatial_rows)\n\nif spatial.empty:\n    raise ValueError(\n        \"Spatial features are empty. Stop here; do not merge.\"\n    )\n\nprint(\"Spatial rows:\", len(spatial))\nprint(\"Spatial columns:\", len(spatial.columns))\nprint(\"Example spatial rows:\")\nprint(spatial.head().to_string(index=False))\n\n# Confirm feature keys are compatible before merging.\nassert {\"window_id\", \"link_id\"}.issubset(features.columns)\nassert {\"window_id\", \"link_id\"}.issubset(spatial.columns)\n\nmerged = features.merge(\n    spatial,\n    on=[\"window_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nassert len(merged) == len(features), \"Row count changed after merge\"\nout_path = BASE / f\"{PANEL}_train_features_spatial.csv\"\nmerged.to_csv(out_path, index=False)\n\nprint(\"\\nSaved:\", out_path)\nprint(\"Merged rows:\", len(merged))\nprint(\"New spatial features:\", len(spatial.columns) - 2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:06:26.767139Z","iopub.execute_input":"2026-10-24T09:06:26.767433Z","iopub.status.idle":"2026-10-24T09:06:31.071799Z","shell.execute_reply.started":"2026-10-24T09:06:26.767411Z","shell.execute_reply":"2026-10-24T09:06:31.070241Z"}},"outputs":[{"name":"stdout","text":"History shape: (17520, 8)\nHistory windows: 10\nFeature rows: 8760\nSpatial rows: 1460\nSpatial columns: 16\nExample spatial rows:\n            window_id  link_id  upstream_neighbor_count  upstream_valid_speed_count  upstream_mean_speed_ratio  upstream_min_speed_ratio  upstream_slow_neighbor_fraction  upstream_mean_flow  upstream_mean_occupancy  downstream_neighbor_count  downstream_valid_speed_count  downstream_mean_speed_ratio  downstream_min_speed_ratio  downstream_slow_neighbor_fraction  downstream_mean_flow  downstream_mean_occupancy\nQ2_D7_I10_E_train_001 L10E-209                        1                           1                   1.010456                  1.010456                              0.0         5245.081162                 0.168196                          1                             1                     1.095342                    1.095342                                0.0           5137.084214                   0.157930\nQ2_D7_I10_E_train_001 L10E-208                        1                           0                        NaN                       NaN                              NaN                 NaN                      NaN                          1                             0                          NaN                         NaN                                NaN                   NaN                        NaN\nQ2_D7_I10_E_train_001 L10E-224                        0                           0                        NaN                       NaN                              NaN                 NaN                      NaN                          0                             0                          NaN                         NaN                                NaN                   NaN                        NaN\nQ2_D7_I10_E_train_001 L10E-206                        1                           1                   1.075870                  1.075870                              0.0         5048.593071                 0.148785                          1                             1                     1.080564                    1.080564                                0.0           4999.566281                   0.151581\nQ2_D7_I10_E_train_001 L10E-205                        1                           1                   1.061144                  1.061144                              0.0         4861.795378                 0.151595                          1                             1                     1.088100                    1.088100                                0.0           5024.146187                   0.156122\n\nSaved: /kaggle/working/task2_training_labels/D7_I10_E_train_features_spatial.csv\nMerged rows: 8760\nNew spatial features: 14\n","output_type":"stream"}],"execution_count":49},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ndf = pd.read_csv(base / \"D7_I10_E_train_features_spatial.csv\")\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nprint(\"Valid rows:\", len(df))\nprint(\"Features:\", len(feature_cols))\nprint(\"Spatial features:\", [\n    c for c in feature_cols\n    if c.startswith((\"upstream_\", \"downstream_\"))\n])\n\noof_parts = []\nwindows = sorted(df[\"window_id\"].unique())\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    Xva = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].astype(int)\n\n    positives = max(int(ytr.sum()), 1)\n    negatives = len(ytr) - int(ytr.sum())\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / positives,\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(Xtr, ytr)\n\n    out = va[[\"window_id\", \"condition\", \"queue_label\"]].copy()\n    out[\"probability\"] = model.predict_proba(Xva)[:, 1]\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(base / \"D7_I10_E_spatial_oof.csv\", index=False)\n\nresults = []\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\nresults = pd.DataFrame(results)\nprint(\"\\n=== LIGHTGBM + TEMPORAL + SPATIAL ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:06:48.201388Z","iopub.execute_input":"2026-10-24T09:06:48.201662Z","iopub.status.idle":"2026-10-24T09:06:53.452219Z","shell.execute_reply.started":"2026-10-24T09:06:48.201641Z","shell.execute_reply":"2026-10-24T09:06:53.451251Z"}},"outputs":[{"name":"stdout","text":"Valid rows: 5533\nFeatures: 46\nSpatial features: ['upstream_neighbor_count', 'upstream_valid_speed_count', 'upstream_mean_speed_ratio', 'upstream_min_speed_ratio', 'upstream_slow_neighbor_fraction', 'upstream_mean_flow', 'upstream_mean_occupancy', 'downstream_neighbor_count', 'downstream_valid_speed_count', 'downstream_mean_speed_ratio', 'downstream_min_speed_ratio', 'downstream_slow_neighbor_fraction', 'downstream_mean_flow', 'downstream_mean_occupancy']\nFold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== LIGHTGBM + TEMPORAL + SPATIAL ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 0 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 4 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 0 0.0000\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               126 0.7970\nQ2_D7_I10_E_train_007 queue_ongoing          109               110 0.8718\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3837\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7674\nqueue_onset      0.0000\nName: IoU, dtype: float64\n","output_type":"stream"}],"execution_count":50},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nfrom pathlib import Path\n\np = Path(\"/kaggle/working/task2_training_labels/D7_I10_E_spatial_oof.csv\")\noof = pd.read_csv(p)\n\nrows = []\n\nfor threshold in np.arange(0.05, 0.81, 0.05):\n    window_ious = []\n\n    for _, group in oof.groupby(\"window_id\"):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = group[\"probability\"].to_numpy() >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n\n        window_ious.append(intersection / union if union else 1.0)\n\n    rows.append({\n        \"threshold\": round(threshold, 2),\n        \"mean_IoU\": np.mean(window_ious),\n        \"onset_IoU\": np.mean([\n            window_ious[i]\n            for i, (_, g) in enumerate(oof.groupby(\"window_id\"))\n            if g[\"condition\"].iloc[0] == \"queue_onset\"\n        ]),\n        \"ongoing_IoU\": np.mean([\n            window_ious[i]\n            for i, (_, g) in enumerate(oof.groupby(\"window_id\"))\n            if g[\"condition\"].iloc[0] == \"queue_ongoing\"\n        ]),\n    })\n\nprint(pd.DataFrame(rows).round(4).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:07:33.862197Z","iopub.execute_input":"2026-10-24T09:07:33.862468Z","iopub.status.idle":"2026-10-24T09:07:33.942739Z","shell.execute_reply.started":"2026-10-24T09:07:33.862447Z","shell.execute_reply":"2026-10-24T09:07:33.941941Z"}},"outputs":[{"name":"stdout","text":" threshold  mean_IoU  onset_IoU  ongoing_IoU\n      0.05    0.2849      0.031       0.5389\n      0.10    0.2975      0.000       0.5951\n      0.15    0.3113      0.000       0.6226\n      0.20    0.3228      0.000       0.6456\n      0.25    0.3360      0.000       0.6720\n      0.30    0.3431      0.000       0.6862\n      0.35    0.3555      0.000       0.7110\n      0.40    0.3640      0.000       0.7279\n      0.45    0.3777      0.000       0.7553\n      0.50    0.3837      0.000       0.7674\n      0.55    0.3849      0.000       0.7698\n      0.60    0.3874      0.000       0.7749\n      0.65    0.3879      0.000       0.7757\n      0.70    0.3863      0.000       0.7726\n      0.75    0.3846    