ueue_ongoing        0.8752      0.8752\n          queue_onset          0.0400      0.0400\nD7_I405_S queue_ongoing        0.8286      0.8286\n          queue_onset          0.0667      0.0667\n\n=== OVERALL EQUAL-WEIGHT MEAN WINDOW IoU ===\nBaseline: 0.4417\nHybrid:   0.5938\n\nSaved summary: /kaggle/working/task2_training_labels/all_panels_hybrid_oof_summary.csv\nSaved predictions: /kaggle/working/task2_training_labels/all_panels_hybrid_oof_predictions.csv\n","output_type":"stream"}],"execution_count":77},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nLINK_RULE_PANELS = {\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\"}\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\n# 1. Load every panel and identify one shared numeric feature set.\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    assert path.exists(), f\"Missing feature file: {path}\"\n\n    df = pd.read_csv(path)\n    df = df[\n        df[\"label_valid\"].eq(True)\n        & df[\"queue_label\"].notna()\n    ].copy()\n\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n    features = {\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    }\n\n    data[panel] = df\n    feature_sets.append(features)\n\nfeature_cols = sorted(set.intersection(*feature_sets))\n\nassert feature_cols, \"No common numeric features found.\"\n\nprint(\"Shared feature count:\", len(feature_cols))\nprint(\"Shared features:\", feature_cols)\n\n# 2. Leave one window out for each panel.\nall_predictions = []\npanel_results = []\n\ndef calculate_iou(group, pred_col):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    p = group[pred_col].to_numpy().astype(bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nfor panel in PANELS:\n    df = data[panel]\n    panel_oof = []\n\n    for held_out in sorted(df[\"window_id\"].unique()):\n        train = df[df[\"window_id\"] != held_out]\n        test = df[df[\"window_id\"] == held_out]\n\n        X_train = train[feature_cols].replace([np.inf, -np.inf], np.nan)\n        X_test = test[feature_cols].replace([np.inf, -np.inf], np.nan)\n        y_train = train[\"queue_label\"]\n\n        positives = int(y_train.sum())\n        negatives = len(y_train) - positives\n\n        model = lgb.LGBMClassifier(\n            n_estimators=300,\n            learning_rate=0.03,\n            num_leaves=15,\n            min_child_samples=30,\n            colsample_bytree=0.9,\n            subsample=0.9,\n            reg_lambda=2.0,\n            scale_pos_weight=negatives / max(positives, 1),\n            random_state=42,\n            verbosity=-1,\n        )\n        model.fit(X_train, y_train)\n\n        cols = [\n            \"window_id\", \"panel\", \"condition\", \"link_id\",\n            \"horizon_step\", \"timestamp\", \"queue_label\",\n        ]\n        cols = [c for c in cols if c in test.columns]\n\n        out = test[cols].copy()\n        out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n        out[\"baseline_pred\"] = out[\"probability\"] >= 0.5\n        panel_oof.append(out)\n\n    oof = pd.concat(panel_oof, ignore_index=True)\n    oof[\"hybrid_pred\"] = oof[\"baseline_pred\"].astype(bool)\n\n    # 3. Apply the onset rule using horizon-6 positives from OTHER windows only.\n    if panel in LINK_RULE_PANELS:\n        onset = oof[oof[\"condition\"] == \"queue_onset\"]\n\n        for held_out in sorted(onset[\"window_id\"].unique()):\n            other_h6 = onset[\n                (onset[\"window_id\"] != held_out)\n                & (onset[\"horizon_step\"] == 6)\n            ]\n\n            positive_links = set(\n                other_h6.loc[\n                    other_h6[\"queue_label\"] == 1, \"link_id\"\n                ]\n            )\n\n            onset_mask = (\n                (oof[\"window_id\"] == held_out)\n                & (oof[\"condition\"] == \"queue_onset\")\n            )\n\n            # Keep onset horizons 1-5 negative, and predict horizon 6\n            # only for links positive at horizon 6 in other windows.\n            oof.loc[onset_mask, \"hybrid_pred\"] = False\n\n            h6_mask = onset_mask & (oof[\"horizon_step\"] == 6)\n            oof.loc[h6_mask, \"hybrid_pred\"] = (\n                oof.loc[h6_mask, \"link_id\"]\n                .isin(positive_links).to_numpy()\n            )\n\n    all_predictions.append(oof)\n\n    for (wid, condition), group in oof.groupby(\n        [\"window_id\", \"condition\"], sort=True\n    ):\n        panel_results.append({\n            \"panel\": panel,\n            \"window_id\": wid,\n            \"condition\": condition,\n            \"baseline_IoU\": calculate_iou(group, \"baseline_pred\"),\n            \"hybrid_IoU\": calculate_iou(group, \"hybrid_pred\"),\n        })\n\n    print(f\"{panel}: completed {oof['window_id'].nunique()} held-out windows\")\n\n# 4. Save and report results.\npredictions = pd.concat(all_predictions, ignore_index=True)\nresults = pd.DataFrame(panel_results)\n\npredictions.to_csv(\n    BASE / \"shared_features_hybrid_oof_predictions.csv\", index=False\n)\nresults.to_csv(\n    BASE / \"shared_features_hybrid_oof_summary.csv\", index=False\n)\n\nprint(\"\\n=== MEAN IoU BY PANEL ===\")\nprint(\n    results.groupby(\"panel\")[[\"baseline_IoU\", \"hybrid_IoU\"]]\n    .mean().round(4).to_string()\n)\n\nprint(\"\\n=== MEAN IoU BY PANEL AND CONDITION ===\")\nprint(\n    results.groupby([\"panel\", \"condition\"])[\n        [\"baseline_IoU\", \"hybrid_IoU\"]\n    ].mean().round(4).to_string()\n)\n\nprint(\"\\n=== OVERALL MEAN WINDOW-CONDITION IoU ===\")\nprint(\"Baseline:\", round(results[\"baseline_IoU\"].mean(), 4))\nprint(\"Hybrid:  \", round(results[\"hybrid_IoU\"].mean(), 4))\nprint(\"Gain:    \", round(\n    results[\"hybrid_IoU\"].mean() - results[\"baseline_IoU\"].mean(), 4\n))\n\nprint(\"\\nSaved corrected predictions and summary in:\", BASE)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:43:13.081727Z","iopub.execute_input":"2026-10-24T09:43:13.082462Z","iopub.status.idle":"2026-10-24T09:43:53.3127Z","shell.execute_reply.started":"2026-10-24T09:43:13.082433Z","shell.execute_reply":"2026-10-24T09:43:53.312091Z"}},"outputs":[{"name":"stdout","text":"Shared feature count: 42\nShared features: ['downstream_mean_flow', 'downstream_mean_occupancy', 'downstream_mean_speed_ratio', 'downstream_min_speed_ratio', 'downstream_neighbor_count', 'downstream_slow_neighbor_fraction', 'downstream_valid_speed_count', 'eligible_latest', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'horizon_step', 'last3_eligible_fraction', 'last3_flow_ratio_mean', 'last3_occupancy_mean', 'last3_pct_observed_mean', 'last3_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_eligible_fraction', 'last6_flow_ratio_mean', 'last6_occupancy_mean', 'last6_pct_observed_mean', 'last6_speed_ratio_mean', 'last6_speed_ratio_std', 'occupancy_latest', 'occupancy_recent_vs_long', 'pct_observed_latest', 'speed_ratio_change', 'speed_ratio_first', 'speed_ratio_latest', 'speed_ratio_overall_change', 'speed_ratio_recent_change', 'speed_ratio_recent_vs_long', 'speed_variability_change', 'speed_variability_long', 'speed_variability_recent', 'upstream_mean_flow', 'upstream_mean_occupancy', 'upstream_mean_speed_ratio', 'upstream_min_speed_ratio', 'upstream_neighbor_count', 'upstream_slow_neighbor_fraction', 