        0.7240       0.4067\n17                    hybrid   D12_I5_S         0.6456       0.2305\n18                    hybrid   D7_I10_E         0.7522       0.9333\n19                    hybrid   D7_I10_W         0.7226       1.0000\n20                    hybrid  D7_I210_E         0.8355       1.0000\n21                    hybrid  D7_I210_W         0.8134       0.2133\n22                    hybrid  D7_I405_N         0.8775       0.2105\n23                    hybrid  D7_I405_S         0.8321       0.5286","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th>condition</th>\n      <th>model</th>\n      <th>panel</th>\n      <th>queue_ongoing</th>\n      <th>queue_onset</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>baseline</td>\n      <td>D12_I5_N</td>\n      <td>0.7240</td>\n      <td>0.0000</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>baseline</td>\n      <td>D12_I5_S</td>\n      <td>0.6456</td>\n      <td>0.2000</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>baseline</td>\n      <td>D7_I10_E</td>\n      <td>0.7522</td>\n      <td>0.0000</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>baseline</td>\n      <td>D7_I10_W</td>\n      <td>0.7226</td>\n      <td>0.4000</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>baseline</td>\n      <td>D7_I210_E</td>\n      <td>0.8355</td>\n      <td>0.0400</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>baseline</td>\n      <td>D7_I210_W</td>\n      <td>0.8134</td>\n      <td>0.1000</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>baseline</td>\n      <td>D7_I405_N</td>\n      <td>0.8775</td>\n      <td>0.0400</td>\n    </tr>\n    <tr>\n      <th>7</t