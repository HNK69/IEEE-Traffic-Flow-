pd.read_csv(topology_path)\nlinks = pd.read_csv(links_path)\n\nfor name, frame in [\n    (\"History\", history),\n    (\"Labels\", labels),\n    (\"Topology\", topology),\n    (\"Links\", links),\n]:\n    print(f\"\\n{name}: shape={frame.shape}\")\n    print(frame.columns.tolist())\n    print(frame.head(2).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:36:43.231135Z","iopub.execute_input":"2026-10-24T09:36:43.231402Z","iopub.status.idle":"2026-10-24T09:36:43.387766Z","shell.execute_reply.started":"2026-10-24T09:36:43.231383Z","shell.execute_reply":"2026-10-24T09:36:43.387092Z"}},"outputs":[{"name":"stdout","text":"History: exists=True | /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/task2/D7_I10_W/train/window_history.parquet\nLabels: exists=True | /kaggle/working/task2_training_labels/D7_I10_W_train_labels.csv\nTopology: exists=True | /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D7_I10_W/network/lwr_mainline_topology.csv\nLinks: exists=True | /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D7_I10_W/network/links.csv\n\nHistory: shape=(12840, 8)\n['window_id', 'timestamp', 'link_id', 'speed_kmh', 'flow_vph', 'occupancy', 'pct_observed', 'is_score_eligible']\n            window_id            timestamp  link_id  speed_kmh    flow_vph  occupancy  pct_observed  is_score_eligible\nQ2_D7_I10_W_train_001 2030-06-02T13:10:00Z L10W-001 120.750000 6354.372706   0.183733           100                  1\nQ2_D7_I10_W_train_001 2030-06-02T13:10:00Z L10W-010 114.109612 6365.899131   0.190550           100                  1\n\nLabels: shape=(6420, 11)\n['window_id', 'panel', 'condition', 'forecast_origin', 'timestamp', 'horizon_step', 'link_id', 'speed_kmh', 'free_speed_kmh', 'label_valid', 'queue_label']\n            window_id    panel   condition           forecast_origin                 timestamp  horizon_step  link_id  speed_kmh  free_speed_kmh  label_valid  queue_label\nQ2_D7_I10_W_train_001 D7_I10_W queue_onset 2030-06-02 14:10:00+00:00 2030-06-02 14:15:00+00:00             1 L10W-175 106.731784           105.4         True          0.0\nQ2_D7_I10_W_train_001 D7_I10_W queue_onset 2030-06-02 14:10:00+00:00 2030-06-02 14:15:00+00:00             1 L10W-253 104.859674           105.4         True          0.0\n\nTopology: shape=(107, 22)\n['mainline_link_id', 'incoming_link_ids', 'outgoing_link_ids', 'on_ramp_link_ids', 'off_ramp_link_ids', 'incoming_has_sensor', 'outgoing_has_sensor', 'lanes', 'length_km', 'capacity_vph', 'free_speed_kmh', 'order_index', 'link_id', 'from_node', 'to_node', 'has_sensor', 'detector_id', 'n_incoming', 'n_outgoing', 'n_incoming_no_sensor', 'n_outgoing_no_sensor', 'free_flow_speed_kmh']\nmainline_link_id    incoming_link_ids     outgoing_link_ids on_ramp_link_ids      off_ramp_link_ids incoming_has_sensor outgoing_has_sensor  lanes  length_km  capacity_vph  free_speed_kmh  order_index  link_id  from_node  to_node  has_sensor       detector_id  n_incoming  n_outgoing  n_incoming_no_sensor  n_outgoing_no_sensor  free_flow_speed_kmh\n        L10W-175 L10W-253;CONN-519-IN          CONN-520-OUT              NaN SYN_RAMP_D7_I10_W_0093                 1;0                   0      3      0.440        6000.0           105.0            0 L10W-175        252      253           1 SYN_D7_I10_W_0001           2           1                     1                     1                105.0\n        L10W-253 L10W-197;CONN-530-IN L10W-175;CONN-519-OUT              NaN                    NaN                 1;0                 1;0      4      0.524        8000.0           105.0            1 L10W-253        277      252           1 SYN_D7_I10_W_0002           2           2                     1                     1                105.0\n\nLinks: shape=(107, 5)\n['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n link_id  length_km  lanes  free_speed_kmh  capacity_vph\nL10W-175      0.440      3           105.4        6085.8\nL10W-253      0.524      4           105.4        8114.4\n","output_type":"stream"}],"execution_count":72},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in PANELS:\n    print(f\"\\nProcessing {panel}...\")\n\n    history_path = ROOT / \"task2\" / panel / \"train\" / \"window_history.parquet\"\n    labels_path = BASE / f\"{panel}_train_labels.csv\"\n    links_path = ROOT / \"corridors\" / panel / \"network\" / \"links.csv\"\n\n    assert history_path.exists(), f\"Missing: {history_path}\"\n    assert labels_path.exists(), f\"Missing: {labels_path}\"\n    assert links_path.exists(), f\"Missing: {links_path}\"\n\n    history = pd.read_parquet(history_path)\n    labels = pd.read_csv(labels_path)\n    links = pd.read_csv(links_path)\n\n    # Normalize timestamps for reliable matching.\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    labels[\"timestamp\"] = pd.to_datetime(labels[\"timestamp\"], utc=True)\n    labels[\"forecast_origin\"] = pd.to_datetime(\n        labels[\"forecast_origin\"], utc=True\n    )\n\n    # Static road attributes.\n    static_cols = [\n        c for c in [\n            \"link_id\", \"free_speed_kmh\", \"capacity_vph\",\n            \"length_km\", \"lanes\"\n        ] if c in links.columns\n    ]\n    static = links[static_cols].drop_duplicates(\"link_id\")\n\n    # Convert each history observation to a free-flow-normalized ratio.\n    history = history.merge(static, on=\"link_id\", how=\"left\")\n    history[\"speed_ratio\"] = (\n        history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n    )\n    history[\"flow_ratio\"] = (\n        history[\"flow_vph\"] / history[\"capacity_vph\"].replace(0, np.nan)\n    )\n\n    # Sort so each window-link time series is chronological.\n    history = history.sort_values(\n        [\"window_id\", \"link_id\", \"timestamp\"]\n    )\n\n    # Latest available released observation for each window-link.\n    latest = history.groupby(\n        [\"window_id\", \"link_id\"], as_index=False\n    ).tail(1)\n\n    latest = latest[[\n        \"window_id\", \"link_id\", \"free_speed_kmh\",\n        \"capacity_vph\", \"length_km\", \"lanes\",\n        \"speed_ratio\", \"flow_ratio\", \"occupancy\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    ]].rename(columns={\n        \"speed_ratio\": \"speed_ratio_latest\",\n        \"flow_ratio\": \"flow_ratio_latest\",\n        \"occupancy\": \"occupancy_latest\",\n        \"speed_kmh\": \"speed_latest\",\n        \"flow_vph\": \"flow_latest\",\n        \"pct_observed\": \"pct_observed_latest\",\n        \"is_score_eligible\": \"eligible_latest\",\n    })\n\n    # Aggregate the most recent 3 and 6 released observations per link.\n    temporal_parts = []\n    for n in (3, 6):\n        recent = history.groupby(\n            [\"window_id\", \"link_id\"], sort=False\n        ).tail(n)\n\n        agg = recent.groupby([\"window_id\", \"link_id\"]).agg(\n            speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n            speed_ratio_std=(\"speed_ratio\", \"std\"),\n            flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n            occupancy_mean=(\"occupancy\", \"mean\"),\n            pct_observed_mean=(\"pct_observed\", \"mean\"),\n            eligible_fraction=(\"is_score_eligible\", \"mean\"),\n        ).reset_index()\n\n        agg = agg.rename(columns={\n            \"speed_ratio_mean\": f\"last{n}_speed_ratio_mean\",\n            \"speed_ratio_std\": f\"last{n}_speed_ratio_std\",\n            \"flow_ratio_mean\": f\"last{n}_flow_ratio_mean\",\n            \"occupancy_mean\": f\"last{n}_occupancy_mean\",\n            \"pct_observed_mean\": f\"last{n}_pct_observed_mean\",\n            \"eligible_fraction\": f\"last{n}_eligible_fraction\",\n        })\n\n        temporal_parts.append(agg)\n\n    features = latest.copy()\n    for part in temporal_parts:\n        features = features.merge(\n            part, on=[\"window_id\", \"link_id\"],\n            how=\"left\", validate=\"one_to_one\"\n        )\n\n    # Derived temporal changes and variability.\n    features[\"speed_ratio_first\"] = (\n        history.sort_values([\"window_id\", \"link_id\", \"timestamp\"])\n        .groupby([\"window_id\", \"link_id\"])[\"speed_ratio\"].first()\n        .reindex(pd.MultiIndex.from_frame(\n            features[[\"window_id\", \"link_id\"]]\n        ))\n        .to_numpy()\n    )\n    features[\"speed_ratio_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n    features[\"speed_ratio_recent_vs_long\"] = (\n        features[\"last3_speed_ratio_mean\"]\n        - features[\"last6_speed_ratio_mean\"]\n    )\n    features[\"flow_ratio_recent_vs_long\"] = (\n        features[\"last3_flow_ratio_mean\"]\n        - features[\"last6_flow_ratio_mean\"]\n    )\n    features[\"occupancy_recent_vs_long\"] = (\n        features[\"last3_occupancy_mean\"]\n        - features[\"last6_occupancy_mean\"]\n    )\n\n    # Join forecast-target rows. Labels are retained for training only;\n    # target speed itself is excluded later from model predictors.\n    feature_cols = [\n        c for c in features.columns\n        if c not in {\"speed_latest\", \"flow_latest\"}\n    ]\n    merged = labels.merge(\n        features[feature_cols],\n        on=[\"window_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_feature\"),\n    )\n\n    # Save base features and a temporal version.\n    base_path = BASE / f\"{panel}_train_features.csv\"\n    temporal_path = BASE / f\"{panel}_train_features_temporal.csv\"\n\n    merged.to_csv(base_path, index=False)\n    merged.to_csv(temporal_path, index=False)\n\n    print(\n        f\"Saved {len(merged)} rows | \"\n        f\"{merged['window_id'].nunique()} windows | \"\n        f\"{merged['link_id'].nunique()} links | \"\n        f\"valid labels={int(merged['label_valid'].astype(bool).sum())}\"\n    )\n\nprint(\"\\nFeature generation complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:37:03.631085Z","iopub.execute_input":"2026-10-24T09:37:03.631391Z","iopub.status.idle":"2026-10-24T09:37:10.860555Z","shell.execute_reply.started":"2026-10-24T09:37:03.631365Z","shell.execute_reply":"2026-10-24T09:37:10.859828Z"}},"outputs":[{"name":"stdout","text":"\nProcessing D7_I10_W...\nSaved 6420 rows | 10 windows | 107 links | valid labels=4149\n\nProcessing D7_I210_E...\nSaved 17820 rows | 10 windows | 297 links | valid labels=11421\n\nProcessing D7_I210_W...\nSaved 4860 rows | 10 windows | 81 links | valid labels=3068\n\nProcessing D7_I405_N...\nSaved 21120 rows | 10 windows | 352 links | valid labels=13325\n\nProcessing D7_I405_S...\nSaved 6540 rows | 10 windows | 109 links | valid labels=4144\n\nProcessing D12_I5_N...\nSaved 15480 rows | 10 windows | 258 links | valid labels=9882\n\nProcessing D12_I5_S...\nSaved 6000 rows | 10 windows | 100 links | valid labels=3840\n\nFeature generation complete.\n","output_type":"stream"}],"execution_count":73},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in panels:\n    path = BASE / f\"{panel}_train_features_temporal.csv\"\n    df = pd.read_csv(path)\n\n    feature_cols = [\n        \"speed_ratio_latest\",\n        \"last3_speed_ratio_mean\",\n        \"last6_speed_ratio_mean\",\n        \"speed_ratio_change\",\n        \"speed_ratio_recent_vs_long\",\n    ]\n    available = [c for c in feature_cols if c in df.columns]\n\n    print(\n        f\"{panel}: rows={len(df)}, \"\n        f\"valid_labels={int(df['label_valid'].astype(bool).sum())}, \"\n        f\"features={len(available)}/{len(feature_cols)}, \"\n        f\"non-null latest speed ratio=\"\n        f\"{df['speed_ratio_latest'].notna().mean():.1%}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:38:30.838744Z","iopub.execute_input":"2026-10-24T09:38:30.839046Z","iopub.status.idle":"2026-10-24T09:38:31.30625Z","shell.execute_reply.started":"2026-10-24T09:38:30.839024Z","shell.execute_reply":"2026-10-24T09:38:31.305529Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: rows=8760, valid_labels=5533, features=5/5, non-null latest speed ratio=82.7%\nD7_I10_W: rows=6420, valid_labels=4149, features=5/5, non-null latest speed ratio=84.1%\nD7_I210_E: rows=17820, valid_labels=11421, features=5/5, non-null latest speed ratio=84.6%\nD7_I210_W: rows=4860, valid_labels=3068, features=5/5, non-null latest speed ratio=85.1%\nD7_I405_N: rows=21120, valid_labels=13325, features=5/5, non-null latest speed ratio=84.0%\nD7_I405_S: rows=6540, valid_labels=4144, features=5/5, non-null latest speed ratio=82.6%\nD12_I5_N: rows=15480, valid_labels=9882, features=5/5, non-null latest speed ratio=84.2%\nD12_I5_S: rows=6000, valid_labels=3840, features=5/5, non-null latest speed ratio=81.9%\n","output_type":"stream"}],"execution_count":74},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in panels:\n    path = BASE / f\"{panel}_train_features_temporal.csv\"\n    df = pd.read_csv(path)\n\n    # Use existing rolling aggregates; don't recompute from target labels.\n    required = [\n        \"last3_speed_ratio_mean\", \"last6_speed_ratio_mean\",\n        \"last3_flow_ratio_mean\", \"last6_flow_ratio_mean\",\n        \"last3_occupancy_mean\", \"last6_occupancy_mean\",\n        \"last3_speed_ratio_std\", \"last6_speed_ratio_std\",\n        \"speed_ratio_latest\", \"speed_ratio_change\",\n    ]\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"{panel}: missing columns {missing}\")\n\n    df[\"speed_ratio_recent_vs_long\"] = (\n        df[\"last3_speed_ratio_mean\"] - df[\"last6_speed_ratio_mean\"]\n    )\n    df[\"flow_ratio_recent_vs_long\"] = (\n        df[\"last3_flow_ratio_mean\"] - df[\"last6_flow_ratio_mean\"]\n    )\n    df[\"occupancy_recent_vs_long\"] = (\n        df[\"last3_occupancy_mean\"] - df[\"last6_occupancy_mean\"]\n    )\n    df[\"speed_ratio_recent_change\"] = (\n        df[\"last3_speed_ratio_mean\"] - df[\"speed_ratio_latest\"]\n    )\n    df[\"speed_ratio_overall_change\"] = df[\"speed_ratio_change\"]\n    df[\"speed_variability_recent\"] = df[\"last3_speed_ratio_std\"]\n    df[\"speed_variability_long\"] = df[\"last6_speed_ratio_std\"]\n    df[\"speed_variability_change\"] = (\n        df[\"last3_speed_ratio_std\"] - df[\"last6_speed_ratio_std\"]\n    )\n\n    df.to_csv(path, index=False)\n\n    print(\n        f\"{panel}: saved {len(df)} rows, \"\n        f\"added 8 temporal features\"\n    )\n\nprint(\"\\nTemporal feature update complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:38:57.953065Z","iopub.execute_input":"2026-10-24T09:38:57.953383Z","iopub.status.idle":"2026-10-24T09:39:01.954734Z","shell.execute_reply.started":"2026-10-24T09:38:57.953362Z","shell.execute_reply":"2026-10-24T09:39:01.954082Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: saved 8760 rows, added 8 temporal features\nD7_I10_W: saved 6420 rows, added 8 temporal features\nD7_I210_E: saved 17820 rows, added 8 temporal features\nD7_I210_W: saved 4860 rows, added 8 temporal features\nD7_I405_N: saved 21120 rows, added 8 temporal features\nD7_I405_S: saved 6540 rows, added 8 temporal features\nD12_I5_N: saved 15480 rows, added 8 temporal features\nD12_I5_S: saved 6000 rows, added 8 temporal features\n\nTemporal feature update complete.\n","output_type":"stream"}],"execution_count":75},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\ndef parse_ids(value):\n    if pd.isna(value) or not str(value).strip():\n        return []\n    return [x.strip() for x in str(value).split(\";\") if x.strip()]\n\nfor panel in PANELS:\n    print(f\"\\nProcessing {panel}...\")\n\n    history_path = ROOT / \"task2\" / panel / \"train\" / \"window_history.parquet\"\n    topology_path = ROOT / \"corridors\" / panel / \"network\" / \"lwr_mainline_topology.csv\"\n    feature_path = BASE / f\"{panel}_train_features_temporal.csv\"\n\n    assert history_path.exists(), f\"Missing history: {history_path}\"\n    assert topology_path.exists(), f\"Missing topology: {topology_path}\"\n    assert feature_path.exists(), f\"Missing features: {feature_path}\"\n\n    history = pd.read_parquet(history_path)\n    topology = pd.read_csv(topology_path)\n    features = pd.read_csv(feature_path)\n\n    # Topology IDs must match observed history IDs.\n    mainline_ids = set(topology[\"mainline_link_id\"].dropna().astype(str))\n    history_ids = set(history[\"link_id\"].dropna().astype(str))\n    overlap = mainline_ids & history_ids\n    print(\n        f\"Topology links={len(mainline_ids)}, history links={len(history_ids)}, \"\n        f\"overlap={len(overlap)}\"\n    )\n    assert overlap, f\"{panel}: topology and history link IDs do not overlap\"\n\n    topology = topology.drop_duplicates(\"mainline_link_id\").copy()\n    topology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\n\n    # Use the latest released observation for each window-link.\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    history = history.sort_values([\"window_id\", \"link_id\", \"timestamp\"])\n    latest = history.groupby(\n        [\"window_id\", \"link_id\"], as_index=False\n    ).tail(1).copy()\n\n    latest[\"link_id\"] = latest[\"link_id\"].astype(str)\n\n    # Use topology free-flow speed for normalization.\n    speed_col = (\n        \"free_speed_kmh\"\n        if \"free_speed_kmh\" in topology.columns\n        else \"free_flow_speed_kmh\"\n    )\n    free_speed = topology.set_index(\"mainline_link_id\")[speed_col].to_dict()\n\n    latest[\"neighbor_free_speed\"] = latest[\"link_id\"].map(free_speed)\n    latest[\"speed_ratio\"] = (\n        latest[\"speed_kmh\"] / latest[\"neighbor_free_speed\"]\n    )\n\n    # Map the direct upstream/downstream mainline neighbors.\n    upstream = {\n        row[\"mainline_link_id\"]: [\n            n for n in parse_ids(row[\"incoming_link_ids\"])\n            if n in mainline_ids\n        ]\n        for _, row in topology.iterrows()\n    }\n    downstream = {\n        row[\"mainline_link_id\"]: [\n            n for n in parse_ids(row[\"outgoing_link_ids\"])\n            if n in mainline_ids\n        ]\n        for _, row in topology.iterrows()\n    }\n\n    by_window = {\n        wid: g.set_index(\"link_id\")\n        for wid, g in latest.groupby(\"window_id\")\n    }\n\n    records = []\n    for wid, target_link in features[[\"window_id\", \"link_id\"]].drop_duplicates().itertuples(index=False, name=None):\n        target_link = str(target_link)\n        obs = by_window.get(wid)\n\n        row = {\"window_id\": wid, \"link_id\": target_link}\n\n        for direction, neighbor_map in [\n            (\"upstream\", upstream),\n            (\"downstream\", downstream),\n        ]:\n            neighbor_ids = neighbor_map.get(target_link, [])\n            neighbor_rows = (\n                obs.reindex(neighbor_ids)\n                if obs is not None and neighbor_ids\n                else pd.DataFrame()\n            )\n\n            ratios = (\n                neighbor_rows[\"speed_ratio\"].dropna()\n                if not neighbor_rows.empty else pd.Series(dtype=float)\n            )\n            flows = (\n                neighbor_rows[\"flow_vph\"].dropna()\n                if not neighbor_rows.empty else pd.Series(dtype=float)\n            )\n            occupancies = (\n                neighbor_rows[\"occupancy\"].dropna()\n                if not neighbor_rows.empty else pd.Series(dtype=float)\n            )\n\n            row[f\"{direction}_neighbor_count\"] = len(neighbor_ids)\n            row[f\"{direction}_valid_speed_count\"] = len(ratios)\n            row[f\"{direction}_mean_speed_ratio\"] = ratios.mean()\n            row[f\"{direction}_min_speed_ratio\"] = ratios.min()\n            row[f\"{direction}_slow_neighbor_fraction\"] = (\n                (ratios <= 0.6).mean() if len(ratios) else np.nan\n            )\n            row[f\"{direction}_mean_flow\"] = flows.mean()\n            row[f\"{direction}_mean_occupancy\"] = occupancies.mean()\n\n        records.append(row)\n\n    spatial = pd.DataFrame(records).drop_duplicates([\"window_id\", \"link_id\"])\n\n    # Confirm useful coverage before merging.\n    for direction in [\"upstream\", \"downstream\"]:\n        count_col = f\"{direction}_valid_speed_count\"\n        coverage = (spatial[count_col] > 0).mean()\n        print(f\"{direction} neighbor speed coverage: {coverage:.1%}\")\n\n    merged = features.merge(\n        spatial,\n        on=[\"window_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    assert len(merged) == len(features), f\"{panel}: row count changed\"\n    assert merged[\"upstream_neighbor_count\"].notna().all()\n    assert merged[\"downstream_neighbor_count\"].notna().all()\n\n    output_path = BASE / f\"{panel}_train_features_spatial.csv\"\n    merged.to_csv(output_path, index=False)\n\n    print(\n        f\"Saved {output_path.name}: {len(merged)} rows, \"\n        f\"{len(merged.columns)} columns\"\n    )\n\nprint(\"\\nSpatial feature generation complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:39:44.874129Z","iopub.execute_input":"2026-10-24T09:39:44.874404Z","iopub.status.idle":"2026-10-24T09:40:06.052706Z","shell.execute_reply.started":"2026-10-24T09:39:44.874381Z","shell.execute_reply":"2026-10-24T09:40:06.051742Z"}},"outputs":[{"name":"stdout","text":"\nProcessing D7_I10_E...\nTopology links=146, history links=146, overlap=146\nupstream neighbor speed coverage: 48.4%\ndownstream neighbor speed coverage: 47.7%\nSaved D7_I10_E_train_features_spatial.csv: 8760 rows, 57 columns\n\nProcessing D7_I10_W...\nTopology links=107, history links=107, overlap=107\nupstream neighbor speed coverage: 21.7%\ndownstream neighbor speed coverage: 22.2%\nSaved D7_I10_W_train_features_spatial.csv: 6420 rows, 56 columns\n\nProcessing D7_I210_E...\nTopology links=297, history links=297, overlap=297\nupstream neighbor speed coverage: 82.7%\ndownstream neighbor speed coverage: 82.5%\nSaved D7_I210_E_train_features_spatial.csv: 17820 rows, 56 columns\n\nProcessing D7_I210_W...\nTopology links=81, history links=81, overlap=81\nupstream neighbor speed coverage: 16.8%\ndownstream neighbor speed coverage: 15.7%\nSaved D7_I210_W_train_features_spatial.csv: 4860 rows, 56 columns\n\nProcessing D7_I405_N...\nTopology links=352, history links=352, overlap=352\nupstream neighbor speed coverage: 79.1%\ndownstream neighbor speed coverage: 79.1%\nSaved D7_I405_N_train_features_spatial.csv: 21120 rows, 56 columns\n\nProcessing D7_I405_S...\nTopology links=109, history links=109, overlap=109\nupstream neighbor speed coverage: 11.5%\ndownstream neighbor speed coverage: 11.7%\nSaved D7_I405_S_train_features_spatial.csv: 6540 rows, 56 columns\n\nProcessing D12_I5_N...\nTopology links=258, history links=258, overlap=258\nupstream neighbor speed coverage: 83.7%\ndownstream neighbor speed coverage: 83.8%\nSaved D12_I5_N_train_features_spatial.csv: 15480 rows, 56 columns\n\nProcessing D12_I5_S...\nTopology links=100, history links=100, overlap=100\nupstream neighbor speed coverage: 24.4%\ndownstream neighbor speed coverage: 25.4%\nSaved D12_I5_S_train_features_spatial.csv: 6000 rows, 56 columns\n\nSpatial feature generation complete.\n","output_type":"stream"}],"execution_count":76},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nLINK_RULE_PANELS = {\"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\"}\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\nall_results = []\nall_predictions = []\n\ndef iou(group, prediction_col):\n    actual = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[prediction_col].to_numpy().astype(bool)\n    union = np.sum(actual | pred)\n    return np.sum(actual & pred) / union if union else 1.0\n\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    assert path.exists(), f\"Missing feature file: {path}\"\n\n    df = pd.read_csv(path)\n    df = df[\n        df[\"label_valid\"].astype(bool)\n        & df[\"queue_label\"].notna()\n    ].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n    feature_cols = [\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    ]\n\n    id_cols = [\n        c for c in [\n            \"window_id\", \"panel\", \"condition\", \"link_id\",\n            \"horizon_step\", \"timestamp\", \"queue_label\"\n        ]\n        if c in df.columns\n    ]\n\n    print(f\"\\n{panel}: {len(df)} valid rows, {len(feature_cols)} features\")\n    predictions = []\n\n    for wid in sorted(df[\"window_id\"].unique()):\n        train = df[df[\"window_id\"] != wid]\n        test = df[df[\"window_id\"] == wid]\n\n        X_train = train[feature_cols].replace([np.inf, -np.inf], np.nan)\n        X_test = test[feature_cols].replace([np.inf, -np.inf], np.nan)\n        y_train = train[\"queue_label\"].astype(int)\n\n        positives = int(y_train.sum())\n        negatives = len(y_train) - positives\n\n        model = lgb.LGBMClassifier(\n            n_estimators=300,\n            learning_rate=0.03,\n            num_leaves=15,\n            min_child_samples=30,\n            colsample_bytree=0.9,\n            subsample=0.9,\n            reg_lambda=2.0,\n            scale_pos_weight=negatives / max(positives, 1),\n            random_state=42,\n            verbosity=-1,\n        )\n        model.fit(X_train, y_train)\n\n        out = test[id_cols].copy()\n        out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n        out[\"baseline_pred\"] = out[\"probability\"] >= 0.5\n        predictions.append(out)\n\n    oof = pd.concat(predictions, ignore_index=True)\n    oof[\"hybrid_pred\"] = oof[\"baseline_pred\"].astype(bool)\n\n    if panel in LINK_RULE_PANELS:\n        onset = oof[oof[\"condition\"] == \"queue_onset\"]\n        for held_out in sorted(onset[\"window_id\"].unique()):\n            other = onset[onset[\"window_id\"] != held_out]\n            positive_links = set(\n                other.loc[other[\"queue_label\"] == 1, \"link_id\"]\n            )\n\n            onset_mask = (\n                (oof[\"window_id\"] == held_out)\n                & (oof[\"condition\"] == \"queue_onset\")\n            )\n            oof.loc[onset_mask, \"hybrid_pred\"] = False\n\n            h6_mask = onset_mask & (oof[\"horizon_step\"] == 6)\n            oof.loc[h6_mask, \"hybrid_pred\"] = (\n                oof.loc[h6_mask, \"link_id\"]\n                .isin(positive_links).to_numpy()\n            )\n\n    for wid, group in oof.groupby(\"window_id\", sort=True):\n        all_results.append({\n            \"panel\": panel,\n            \"window_id\": wid,\n            \"condition\": group[\"condition\"].iloc[0],\n            \"baseline_IoU\": iou(group, \"baseline_pred\"),\n            \"hybrid_IoU\": iou(group, \"hybrid_pred\"),\n        })\n\n    all_predictions.append(oof)\n    print(\"OOF windows completed:\", oof[\"window_id\"].nunique())\n\nresults = pd.DataFrame(all_results)\npredictions = pd.concat(all_predictions, ignore_index=True)\n\nsummary_path = BASE / \"all_panels_hybrid_oof_summary.csv\"\npredictions_path = BASE / \"all_panels_hybrid_oof_predictions.csv\"\n\nresults.to_csv(summary_path, index=False)\npredictions.to_csv(predictions_path, index=False)\n\nprint(\"\\n=== MEAN IoU BY PANEL ===\")\nprint(\n    results.groupby(\"panel\")[[\"baseline_IoU\", \"hybrid_IoU\"]]\n    .mean().round(4).to_string()\n)\n\nprint(\"\\n=== MEAN IoU BY PANEL AND CONDITION ===\")\nprint(\n    results.groupby([\"panel\", \"condition\"])[\n        [\"baseline_IoU\", \"hybrid_IoU\"]\n    ].mean().round(4).to_string()\n)\n\nprint(\"\\n=== OVERALL EQUAL-WEIGHT MEAN WINDOW IoU ===\")\nprint(\"Baseline:\", round(results[\"baseline_IoU\"].mean(), 4))\nprint(\"Hybrid:  \", round(results[\"hybrid_IoU\"].mean(), 4))\n\nprint(\"\\nSaved summary:\", summary_path)\nprint(\"Saved predictions:\", predictions_path)\n","metadata":{"t