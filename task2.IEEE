ns.py: HTTP 200\nSaved: /kaggle/working/trafficflowbench-public/src/merge_submissions.py\n\n============================================================\nsample_submission_path_flow.csv\nShape: (4278, 6)\nColumns: ['panel', 'departure_time', 'path_id', 'origin_zone', 'destination_zone', 'path_flow']\n   panel    departure_time  path_id origin_zone destination_zone  path_flow\nD7_I10_E SYN_PM_VALIDATION P000_001          Z0               Z1        0.0\nD7_I10_E SYN_PM_VALIDATION P000_002          Z0               Z2        0.0\nD7_I10_E SYN_PM_VALIDATION P000_003          Z0               Z3        0.0\nD7_I10_E SYN_PM_VALIDATION P000_004          Z0               Z4        0.0\nD7_I10_E SYN_PM_VALIDATION P000_005          Z0               Z5        0.0\nMissing cells: 0\n\n============================================================\nsynthetic_link_counts.csv\nShape: (137, 3)\nColumns: ['panel', 'link_id', 'count']\n   panel  link_id       count\nD7_I10_E L10E-166 3390.491917\nD7_I10_E L10E-147 5104.100918\nD7_I10_E L10E-043 5098.335435\nD7_I10_E L10E-171 5098.335435\nD7_I10_E L10E-209 5098.335435\nMissing cells: 0\n\n============================================================\nsynthetic_weak_prior.csv\nShape: (4278, 6)\nColumns: ['panel', 'departure_time', 'path_id', 'origin_zone', 'destination_zone', 'path_flow']\n   panel    departure_time  path_id origin_zone destination_zone  path_flow\nD7_I10_E SYN_PM_VALIDATION P000_001          Z0               Z1 412.236121\nD7_I10_E SYN_PM_VALIDATION P000_002          Z0               Z2 346.234884\nD7_I10_E SYN_PM_VALIDATION P000_003          Z0               Z3  76.670517\nD7_I10_E SYN_PM_VALIDATION P000_004          Z0               Z4  83.631328\nD7_I10_E SYN_PM_VALIDATION P000_005          Z0               Z5  60.310667\nMissing cells: 0\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"from pathlib import Path\nimport subprocess\nimport sys\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nREPO = Path(\"/kaggle/working/trafficflowbench-public\")\nOUT = Path(\"/kaggle/working/task4_odme\")\n\ncmd = [\n    sys.executable,\n    str(REPO / \"src/task4/build_task4_odme_artifacts.py\"),\n    \"--release-root\", str(ROOT),\n    \"--split\", \"validation\",\n    \"--output-root\", str(OUT),\n]\n\nresult = subprocess.run(cmd, text=True, capture_output=True)\nprint(result.stdout)\nif result.stderr:\n    print(result.stderr[-5000:])\nprint(\"Return code:\", result.returncode)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T10:14:16.104668Z","iopub.execute_input":"2026-10-25T10:14:16.105013Z","iopub.status.idle":"2026-10-25T10:28:06.860457Z","shell.execute_reply.started":"2026-10-25T10:14:16.104985Z","shell.execute_reply":"2026-10-25T10:28:06.859564Z"}},"outputs":[{"name":"stdout","text":"[Task4 ODME artifacts] D7_I10_E\n  paths=4,278, operator links=373\n[Task4 ODME artifacts] D7_I10_W\n  paths=5,050, operator links=427\n[Task4 ODME artifacts] D7_I210_E\n  paths=2,628, operator links=396\n[Task4 ODME artifacts] D7_I210_W\n  paths=3,321, operator links=398\n[Task4 ODME artifacts] D7_I405_N\n  paths=4,560, operator links=516\n[Task4 ODME artifacts] D7_I405_S\n  paths=4,656, operator links=496\n[Task4 ODME artifacts] D12_I5_N\n  paths=4,278, operator links=343\n[Task4 ODME artifacts] D12_I5_S\n  paths=5,050, operator links=370\n[Task4 ODME artifacts] D12_I405_N\n  paths=903, operator links=152\n[Task4 ODME artifacts] D12_I405_S\n  paths=630, operator links=132\nWrote artifacts to /kaggle/working/task4_odme\n\nReturn code: 0\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"from pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task4_odme\")\n\npred = pd.read_csv(OUT / \"public_reference.csv\")\ncounts = pd.read_csv(OUT / \"public_link_counts.csv\")\n\n# Basic prediction validity\nprint(\"Prediction shape:\", pred.shape)\nprint(\"Missing cells:\", int(pred.isna().sum().sum()))\nprint(\"Non-finite path flows:\", int(\n    (~np.isfinite(pd.to_numeric(pred[\"path_flow\"], errors=\"coerce\"))).sum()\n))\nprint(\"Negative path flows:\", int((pred[\"path_flow\"] < 0).sum()))\nprint(\"Panels:\", pred[\"panel\"].nunique())\n\n# Reconstruct link counts: predicted count = sum of flows on paths using each link\nresults = []\n\nfor panel in pred[\"panel\"].unique():\n    network = ROOT / \"corridors\" / panel / \"network\"\n    incidence = pd.read_csv(network / \"path_link_incidence.csv\")\n    incidence[\"path_id\"] = incidence[\"path_id\"].astype(str)\n    incidence[\"link_id\"] = incidence[\"link_id\"].astype(str)\n\n    p = pred[pred[\"panel\"] == panel][[\"path_id\", \"path_flow\"]].copy()\n    p[\"path_id\"] = p[\"path_id\"].astype(str)\n\n    # Each path contributes its flow to each link it traverses\n    contributions = incidence.merge(p, on=\"path_id\", how=\"left\")\n    contributions[\"path_flow\"] = contributions[\"path_flow\"].fillna(0.0)\n    predicted_counts = contributions.groupby(\"link_id\")[\"path_flow\"].sum()\n\n    actual = counts[counts[\"panel\"] == panel].copy()\n    actual[\"link_id\"] = actual[\"link_id\"].astype(str)\n    actual[\"predicted_count\"] = actual[\"link_id\"].map(predicted_counts)\n    actual = actual.dropna(subset=[\"predicted_count\"])\n\n    error = actual[\"predicted_count\"].to_numpy() - actual[\"count\"].to_numpy()\n    denominator = np.abs(actual[\"count\"].to_numpy()).sum()\n\n    results.append({\n        \"panel\": panel,\n        \"paths\": len(p),\n        \"observed_links\": len(actual),\n        \"MAE\": np.mean(np.abs(error)),\n        \"RMSE\": np.sqrt(np.mean(error ** 2)),\n        \"WAPE_pct\": 100 * np.abs(error).sum() / denominator\n            if denominator else np.nan,\n        \"correlation\": actual[\"predicted_count\"].corr(actual[\"count\"]),\n    })\n\nreport = pd.DataFrame(results)\nprint(\"\\nLink-count reconstruction diagnostics:\")\nprint(report.round(4).to_string(index=False))\nprint(\"\\nOverall WAPE:\",\n      round(100 * np.abs(\n          pred.merge(counts, on=[\"panel\"], how=\"left\")[\"path_flow\"]\n      ).sum(), 4) if False else\n      \"See per-panel results above; next we can compute a properly weighted aggregate.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T10:28:57.666002Z","iopub.execute_input":"2026-10-25T10:28:57.66633Z","iopub.status.idle":"2026-10-25T10:29:00.749004Z","shell.execute_reply.started":"2026-10-25T10:28:57.666303Z","shell.execute_reply":"2026-10-25T10:29:00.74762Z"}},"outputs":[{"name":"stdout","text":"Prediction shape: (35354, 6)\nMissing cells: 0\nNon-finite path flows: 0\nNegative path flows: 0\nPanels: 10\n\nLink-count reconstruction diagnostics:\n     panel  paths  observed_links    MAE   RMSE  WAPE_pct  correlation\n  D7_I10_E   4278             137 0.1564 0.2547    0.0030       1.0000\n  D7_I10_W   5050             100 0.2678 0.4048    0.0049       1.0000\n D7_I210_E   2628             294 0.0606 0.1127    0.0013       1.0000\n D7_I210_W   3321              81 0.3257 0.4867    0.0069       1.0000\n D7_I405_N   4560             350 0.0437 0.0784    0.0007       1.0000\n D7_I405_S   4656              96 0.2188 0.3494    0.0037       1.0000\n  D12_I5_N   4278             257 0.0823 0.1367    0.0014       1.0000\n  D12_I5_S   5050             100 0.2380 0.3452    0.0038       1.0000\nD12_I405_N    903              81 0.6576 1.1994    0.0105       1.0000\nD12_I405_S    630              35 1.7152 2.9553    0.0243       0.9999\n\nOverall WAPE: See per-panel results above; next we can compute a properly weighted aggregate.\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"from pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task4_odme\")\n\npred = pd.read_csv(OUT / \"public_reference.csv\")\ncounts = pd.read_csv(OUT / \"public_link_counts.csv\")\n\ntotal_abs_error = 0.0\ntotal_actual_volume = 0.0\n\nfor panel in pred[\"panel\"].unique():\n    network = ROOT / \"corridors\" / panel / \"network\"\n\n    incidence = pd.read_csv(network / \"path_link_incidence.csv\")\n    incidence[\"path_id\"] = incidence[\"path_id\"].astype(str)\n    incidence[\"link_id\"] = incidence[\"link_id\"].astype(str)\n\n    p = pred[pred[\"panel\"] == panel][[\"path_id\", \"path_flow\"]].copy()\n    p[\"path_id\"] = p[\"path_id\"].astype(str)\n\n    reconstructed = (\n        incidence.merge(p, on=\"path_id\", how=\"left\")\n        .groupby(\"link_id\")[\"path_flow\"]\n        .sum()\n    )\n\n    actual = counts[counts[\"panel\"] == panel].copy()\n    actual[\"link_id\"] = actual[\"link_id\"].astype(str)\n    actual[\"predicted\"] = actual[\"link_id\"].map(reconstructed).fillna(0.0)\n\n    total_abs_error += np.abs(actual[\"predicted\"] - actual[\"count\"]).sum()\n    total_actual_volume += np.abs(actual[\"count\"]).sum()\n\nprint(\"Overall link-count WAPE (%):\",\n      round(100 * total_abs_error / total_actual_volume, 6))\nprint(\"Total observed link counts:\", len(counts))\nprint(\"Total path-flow predictions:\", len(pred))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T10:29:33.771727Z","iopub.execute_input":"2026-10-25T10:29:33.772215Z","iopub.status.idle":"2026-10-25T10:29:36.727778Z","shell.execute_reply.started":"2026-10-25T10:29:33.772177Z","shell.execute_reply":"2026-10-25T10:29:36.726528Z"}},"outputs":[{"name":"stdout","text":"Overall link-count WAPE (%): 0.003348\nTotal observed link counts: 1531\nTotal path-flow predictions: 35354\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"from pathlib import Path\n\npaths = [\n 