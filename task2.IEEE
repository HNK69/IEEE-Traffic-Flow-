hared/condition OOF matched rows:\", len(check))\nprint(\n    \"Label disagreements:\",\n    (check[\"queue_label_shared\"] != check[\"queue_label_condition\"]).sum()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T11:09:30.46068Z","iopub.execute_input":"2026-10-24T11:09:30.461543Z","iopub.status.idle":"2026-10-24T11:09:30.673367Z","shell.execute_reply.started":"2026-10-24T11:09:30.461517Z","shell.execute_reply":"2026-10-24T11:09:30.672515Z"}},"outputs":[{"name":"stdout","text":"Shared OOF missing panels after repair: 0\nShared OOF panel count: 8\n\nshared\nRows: 55362\nPositive rate: 0.096366\nDuplicate key rows: 0\n\ncondition-specific\nRows: 55362\nPositive rate: 0.096366\nDuplicate key rows: 0\n\npanel-hybrid\nRows: 55362\nPositive rate: 0.096366\nDuplicate key rows: 0\n\nShared/condition OOF matched rows: 55362\nLabel disagreements: 0\n","output_type":"stream"}],"execution_count":113},{"cell_type":"code","source":"from pathlib import Path\n\nroots = [\n    Path(\"/kaggle/working\"),\n    Path(\"/kaggle/input\"),\n]\n\nterms = [\n    \"upstream_slow_neighbor_fraction\",\n    \"downstream_mean_speed_ratio\",\n    \"last3_speed_ratio_mean\",\n]\n\nfor root in roots:\n    print(f\"\\n{'=' * 60}\\nSearching {root}\")\n\n    count = 0\n    for path in root.rglob(\"*\"):\n        if not path.is_file():\n            continue\n\n        if path.suffix.lower() not in {\".py\", \".ipynb\", \".md\"}:\n            continue\n\n        # Skip common bulky or irrelevant directories.\n        if any(part in {\".git\", \"__pycache__\"} for part in path.parts):\n            continue\n\n        try:\n            content = path.read_text(errors=\"ignore\")\n        except Exception:\n            continue\n\n        matched = [term for term in terms if term in content]\n        if matched:\n            print(path)\n            print(\"  matched:\", matched)\n            count += 1\n\n            if count >= 30:\n                print(\"Search result limit reached.\")\n                break","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T11:19:30.657652Z","iopub.execute_input":"2026-10-24T11:19:30.658006Z","iopub.status.idle":"2026-10-24T11:19:45.753403Z","shell.execute_reply.started":"2026-10-24T11:19:30.657976Z","shell.execute_reply":"2026-10-24T11:19:45.752752Z"}},"outputs":[{"name":"stdout","text":"\n============================================================\nSearching /kaggle/working\n/kaggle/working/.virtual_documents/__notebook_source__.ipynb\n  matched: ['upstream_slow_neighbor_fraction', 'downstream_mean_speed_ratio', 'last3_speed_ratio_mean']\n\n============================================================\nSearching /kaggle/input\n","output_type":"stream"}],"execution_count":115},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport shutil\nfrom datetime import datetime\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nCHECKPOINT = Path(\"/kaggle/working/trafficflow_checkpoint\")\nCHECKPOINT.mkdir(parents=True, exist_ok=True)\n\nimportant_files = [\n    \"shared_features_hybrid_oof_predictions.csv\",\n    \"condition_specific_oof_predictions.csv\",\n    \"condition_specific_oof_summary.csv\",\n    \"panel_specific_hybrid_predictions.csv\",\n    \"panel_specific_hybrid_summary.csv\",\n    \"link_history_experiment_predictions.csv\",\n    \"link_history_experiment_summary.csv\",\n    \"hybrid_onset_window_audit.csv\",\n    \"min_child_samples_results.csv\",\n]\n\ncopied = []\nmissing = []\n\nfor name in important_files:\n    src = BASE / name\n    if src.exists():\n        shutil.copy2(src, CHECKPOINT / name)\n        copied.append(name)\n    else:\n        missing.append(name)\n\nfeatures = [\n    \"downstream_mean_flow\",\n    \"downstream_mean_occupancy\",\n    \"downstream_mean_speed_ratio\",\n    \"downstream_min_speed_ratio\",\n    \"downstream_neighbor_count\",\n    \"downstream_slow_neighbor_fraction\",\n    \"downstream_valid_speed_count\",\n    \"eligible_latest\",\n    \"flow_ratio_latest\",\n    \"flow_ratio_recent_vs_long\",\n    \"horizon_step\",\n    \"last3_eligible_fraction\",\n    \"last3_flow_ratio_mean\",\n    \"last3_occupancy_mean\",\n    \"last3_pct_observed_mean\",\n    \"last3_speed_ratio_mean\",\n    \"last3_speed_ratio_std\",\n    \"last6_eligible_fraction\",\n    \"last6_flow_ratio_mean\",\n    \"last6_occupancy_mean\",\n    \"last6_pct_observed_mean\",\n    \"last6_speed_ratio_mean\",\n    \"last6_speed_ratio_std\",\n    \"occupancy_latest\",\n    \"occupancy_recent_vs_long\",\n    \"pct_observed_latest\",\n    \"speed_ratio_change\",\n    \"speed_ratio_first\",\n    \"speed_ratio_latest\",\n    \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_change\",\n    \"speed_ratio_recent_vs_long\",\n    \"speed_variability_change\",\n    \"speed_variability_long\",\n    \"speed_variability_recent\",\n    \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\",\n    \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\",\n    \"upstream_neighbor_count\",\n    \"upstream_slow_neighbor_fraction\",\n    \"upstream_valid_speed_count\",\n]\n\ncheckpoint = {\n    \"created_at\": datetime.now().isoformat(timespec=\"seconds\"),\n    \"panels\": [\n        \"D7_I10_E\", \"D7_I10_W\",\n        \"D7_I210_E\", \"D7_I210_W\",\n        \"D7_I405_N\", \"D7_I405_S\",\n        \"D12_I5_N\", \"D12_I5_S\",\n    ],\n    \"feature_count\": len(features),\n    \"features\": features,\n    \"model\": {\n        \"library\": \"LightGBM\",\n        \"n_estimators\": 300,\n        \"learning_rate\": 0.03,\n        \"num_leaves\": 15,\n        \"min_child_samples\": 30,\n        \"colsample_bytree\": 0.9,\n        \"subsample\": 0.9,\n        \"reg_lambda\": 2.0,\n        \"random_state\": 42,\n        \"threshold\": 0.50,\n        \"separate_models_by_condition\": True,\n    },\n    \"baseline_oof_mean_iou\": 0.4385,\n    \"experimental_panel_hybrid_oof_mean_iou\": 0.5944,\n    \"warning\": (\n        \"Panel-specific hybrid score is exploratory and optimistic; \"\n        \"rules were selected after inspecting the same folds.\"\n    ),\n    \"next_steps\": [\n        \"Recover original temporal and spatial feature-generation code.\",\n        \"Generate validation/private features from released histories only.\",\n        \"Check feature alignment and row order.\",\n        \"Fit final models and create official-format submission files.\",\n    ],\n    \"copied_files\": copied,\n    \"missing_files\": missing,\n}\n\n(CHECKPOINT / \"progress_checkpoint.json\").write_text(\n    json.dumps(checkpoint, indent=2)\n)\n\nnotes = f\"\"\"# Traffic Flow Bench — Resume Checkpoint\n\nSaved: {checkpoint['created_at']}\n\n## Completed\n- Processed all eight panels' training features.\n- Established a common 42-feature schema.\n- Trained condition-specific LightGBM models in the current session.\n- Verified OOF labels and keys: 55,362 rows, no duplicate keys,\n  zero label disagreements after repairing missing panel IDs.\n- Baseline exploratory mean IoU: 0.4385.\n- Panel-specific hybrid exploratory mean IoU: 0.5944, but optimistic.\n\n## Model configuration\n- LightGBM, separate queue_onset and queue_ongoing models\n- 300 estimators, learning rate 0.03, 15 leaves\n- min_child_samples=30, reg_lambda=2.0\n- Threshold=0.50\n\n## Next task\nGenerate validation and private spatial features using the original\nfeature-generation logic. Do not use submission placeholders as labels.\nPreserve the exact 42-feature schema and official submission row order.\n\n## Important\nKaggle /working files can disappear when the session is reset.\nDownload or otherwise export the checkpoint folder before closing.\nThis checkpoint stores results and configuration, not fitted model objects.\n\"\"\"\n(CHECKPOINT / \"RESUME_NOTES.md\").write_text(notes)\n\nprint(\"Checkpoint saved to:\", CHECKPOINT)\nprint(\"Files copied:\", len(copied))\nprint(\"Files not found:\", missing)\nprint(\"Feature count:\", len(features))\nprint(\"Checkpoint contents:\")\nfor p in sorted(CHECKPOINT.iterdir()):\n    print(f\" - {p.name} ({p.stat().st_size:,} bytes)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T11:43:23.455615Z","iopub.execute_input":"2026-10-24T11:43:23.455924Z","iopub.status.idle":"2026-10-24T11:43:23.525195Z","shell.execute_reply.started":"2026-10-24T11:43:23.455875Z","shell.execute_reply":"2026-10-24T11:43:23.5245Z"}},"outputs":[{"name":"stdout","text":"Checkpoint saved to: /kaggle/working/trafficflow_checkpoint\nFiles copied: 8\nFiles not found: ['panel_specific_hybrid_summary.csv']\nFeature count: 42\nCheckpoint contents:\n - RESUME_NOTES.md (1,114 bytes)\n - condition_specific_oof_predictions.csv (6,180,176 bytes)\n - condition_specific_oof_summary.csv (5,243 bytes)\n - hybrid_onset_window_audit.csv (2,120 bytes)\n - link_history_experiment_predictions.csv (3,569,964 bytes)\n - link_history_experiment_summary.csv (233 bytes)\n - min_child_samples_results.csv (2,907 bytes)\n - panel_specific_hybrid_predictions.csv (3,680,706 bytes)\n - progress_checkpoint.json (2,754 bytes)\n - shared_features_hybrid_oof_predictions.csv (6,485,115 bytes)\n","output_type":"stream"}],"execution_count":119},{"cell_type":"code","source":"import shutil\nfrom pathlib import Path\n\nfolder = Path(\"/kaggle/working/trafficflow_checkpoint\")\nzip_path = \"/kaggle/working/trafficflow_checkpoint.zip\"\n\nshutil.make_archive(\n    zip_path.replace(\".zip\", \"\"),\n    \"zip\",\n    root_dir=folder\n)\n\nprint(\"ZIP created:\", zip_path)\nprint(f\"Size: {Path(zip_path).stat().st_size / (1024 * 1024):.2f} MB\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T11:44:33.081623Z","iopub.execute_input":"2026-10-24T11:44:33.081934Z","iopub.status.idle":"2026-10-24T11:44:33.448176Z","shell.execute_reply.started":"2026-10-24T11:44:33.081905Z","shell.execute_reply":"2026-10-24T11:44:33.44639Z"}},"outputs":[{"name":"stdout","text":"ZIP created: /kaggle/working/trafficflow_checkpoint.zip\nSize: 2.08 MB\n","output_type":"stream"}],"execution_count":120},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nall_labels = []\n\nfor panel in PANELS:\n    print(f\"\\nBuilding labels: {panel}\")\n\n    base = ROOT / \"task2\" / panel / \"train\"\n    wi = pd.read_csv(base / \"window_index.csv\")\n    wi[\"origin\"] = pd.to_datetime(wi[\"forecast_origin\"], utc=True)\n\n    horizon = []\n    for _, w in wi.iterrows():\n        for step in range(1, 7):\n            horizon.append({\n                \"window_id\": w[\"window_id\"],\n                \"panel\": panel,\n                \"condition\": w[\"condition\"],\n                \"forecast_origin\": w[\"origin\"],\n                \"timestamp\": w[\"origin\"] + pd.Timedelta(minutes=5 * step),\n                \"horizon_step\": step,\n            })\n\n    horizon = pd.DataFrame(horizon)\n    target_times = set(horizon[\"timestamp\"])\n    target_dates = {t.strftime(\"%Y_%m_%d\") for t in target_times}\n\n    folder = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n    files = [\n        f for f in folder.rglob(\"*.parquet\")\n        if any(f\"synthetic_mainline_{d}\" in f.name for d in target_dates)\n    ]\n\n    if not files:\n        raise RuntimeError(f\"No target state files found for {panel}\")\n\n    states = pd.concat([\n        pd.read_parquet(\n            f,\n            columns=[\n                \"timestamp\", \"link_id\", \"speed_kmh\",\n                \"is_score_eligible\", \"is_imputed\", \"is_missing\",\n            ],\n        )\n        for f in files\n    ], ignore_index=True)\n\n    states[\"timestamp\"] = pd.to_datetime(states[\"timestamp\"], utc=True)\n    states = states[states[\"timestamp\"].isin(target_times)].copy()\n\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )[[\"link_id\", \"free_speed_kmh\"]]\n\n    states = states.merge(\n        fd, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    states[\"speed_kmh\"] = pd.to_numeric(states[\"speed_kmh\"], errors=\"coerce\")\n\n    states[\"label_valid\"] = (\n        states[\"is_score_eligible\"].eq(1)\n        & states[\"is_imputed\"].eq(0)\n        & states[\"is_missing\"].eq(0)\n        & states[\"speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].gt(0)\n    )\n\n    states[\"queue_label\"] = (\n        states[\"speed_kmh\"] <= 0.60 * states[\"free_speed_kmh\"]\n    ).astype(\"int8\")\n\n    labels = horizon.merge(fd[[\"link_id\"]], how=\"cross\").merge(\n        states[[\n            \"timestamp\", \"link_id\", \"speed_kmh\",\n            \"free_speed_kmh\", \"label_valid\", \"queue_label\",\n        ]],\n        on=[\"timestamp\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    labels[\"label_valid\"] = labels[\"label_valid\"].fillna(False)\n    labels.loc[~labels[\"label_valid\"], \"queue_label\"] = np.nan\n    labels[\"panel\"] = panel\n\n    labels.to_csv(OUT / f\"{panel}_train_labels.csv\", index=False)\n    all_labels.append(labels)\n\n    print(\n        f\"Rows: {len(labels):,} | \"\n        f\"Valid: {int(labels['label_valid'].sum()):,} | \"\n        f\"Positive valid: \"\n        f\"{int(labels.loc[labels['label_valid'], 'queue_label'].sum()):,}\"\n    )\n\ncombined = pd.concat(all_labels, ignore_index=True)\ncombined.to_csv(OUT / \"all_panels_train_labels.csv\", index=False)\n\nprint(\"\\nLabel rebuild complete.\")\nprint(\"Total rows:\", f\"{len(combined):,}\")\nprint(\"Valid rows:\", f\"{int(combined['label_valid'].sum()):,}\")\nprint(\"Output:\", OUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:40:52.442989Z","iopub.execute_input":"2026-10-25T07:40:52.443408Z","iopub.status.idle":"2026-10-25T07:40:58.431864Z","shell.execute_reply.started":"2026-10-25T07:40:52.443373Z","shell.execute_reply":"2026-10-25T07:40:58.430982Z"}},"outputs":[{"name":"stdout","text":"\nBuilding labels: D7_I10_E\nRows: 8,760 | Valid: 5,533 | Positive valid: 642\n\nBuilding labels: D7_I10_W\nRows: 6,420 | Valid: 4,149 | Positive valid: 111\n\nBuilding labels: D7_I210_E\nRows: 17,820 | Valid: 11,421 | Positive valid: 98\n\nBuilding labels: D7_I210_W\nRows: 4,860 | Valid: 3,068 | Positive valid: 305\n\nBuilding labels: D7_I405_N\nRows: 21,120 | Valid: 13,325 | Positive valid: 1,993\n\nBuilding labels: D7_I405_S\nRows: 6,540 | Valid: 4,144 | Positive valid: 354\n\nBuilding labels: D12_I5_N\nRows: 15,480 | Valid: 9,882 | Positive valid: 1,426\n\nBuilding labels: D12_I5_S\nRows: 6,000 | Valid: 3,840 | Positive valid: 406\n\nLabel rebuild complete.\nTotal rows: 87,000\nValid rows: 55,362\nOutput: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nOUT = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in PANELS:\n    print(f\"\\nBuilding base features: {panel}\")\n\n    base = ROOT / \"task2\" / panel / \"train\"\n    history = pd.read_parquet(base / \"window_history.parquet\")\n    windows = pd.read_csv(base / \"window_index.csv\")\n    labels = pd.read_csv(OUT / f\"{panel}_train_labels.csv\")\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )\n\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    windows[\"origin\"] = pd.to_datetime(windows[\"forecast_origin\"], utc=True)\n\n    history = history.merge(\n        fd[[\"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\"]],\n        on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    history = history.merge(\n        windows[[\"window_id\", \"origin\"]],\n        on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n    )\n\n    history[\"minutes_before_origin\"] = (\n        history[\"origin\"] - history[\"timestamp\"]\n    ).dt.total_seconds() / 60\n\n    for col in [\"speed_kmh\", \"flow_vph\", \"occupancy\"]:\n        history[col] = pd.to_numeric(history[col], errors=\"coerce\")\n\n    history[\"speed_ratio\"] = history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n    history[\"flow_ratio\"] = history[\"flow_vph\"] / history[\"capacity_vph\"]\n\n    history = history.sort_values(\n        [\"window_id\", \"link_id\", \"timestamp\"]\n    ).copy()\n\n    group_cols = [\"window_id\", \"link_id\"]\n\n    latest = history.groupby(group_cols, sort=False).tail(1).copy()\n    latest = latest.rename(columns={\n        \"speed_ratio\": \"speed_ratio_latest\",\n        \"flow_ratio\": \"flow_ratio_latest\",\n        \"occupancy\": \"occupancy_latest\",\n        \"speed_kmh\": \"speed_latest\",\n        \"flow_vph\": \"flow_latest\",\n        \"pct_observed\": \"pct_observed_latest\",\n        \"is_score_eligible\": \"eligible_latest\",\n    })\n\n    features = latest[\n        [\n            \"window_id\", \"link_id\", \"free_speed_kmh\", \"capacity_vph\",\n            \"length_km\", \"lanes\", \"speed_ratio_latest\", \"flow_ratio_latest\",\n            \"occupancy_latest\", \"speed_latest\", \"flow_latest\",\n            \"pct_observed_latest\", \"eligible_latest\",\n        ]\n    ].copy()\n\n    for n_steps, prefix in [(3, \"last3\"), (6, \"last6\")]:\n        recent = history.groupby(group_cols, sort=False).tail(n_steps)\n        agg = recent.groupby(group_cols).agg(\n            speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n            speed_ratio_std=(\"speed_ratio\", \"std\"),\n            flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n            occupancy_mean=(\"occupancy\", \"mean\"),\n            pct_observed_mean=(\"pct_observed\", \"mean\"),\n            eligible_fraction=(\"is_score_eligible\", \"mean\"),\n            observed_speed_fraction=(\"speed_kmh\", lambda x: x.notna().mean()),\n        ).reset_index()\n\n        agg = agg.rename(columns={\n            c: f\"{prefix}_{c}\" for c in agg.columns\n            if c not in group_cols\n        })\n        features = features.merge(\n            agg, on=group_cols, how=\"left\", validate=\"one_to_one\"\n        )\n\n    first = history.groupby(group_cols, sort=False).head(1)[\n        group_cols + [\"speed_ratio\"]\n    ].rename(columns={\"speed_ratio\": \"speed_ratio_first\"})\n\n    features = features.merge(\n        first, on=group_cols, how=\"left\", validate=\"one_to_one\"\n    )\n    features[\"speed_ratio_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n\n    features = features.merge(\n        pd.DataFrame({\"horizon_step\": range(1, 7)}).assign(_key=1),\n        how=\"cross\"\n    )\n\n    labels[\"timestamp\"] = pd.to_datetime(labels[\"timestamp\"], utc=True)\n    features = features.merge(\n        labels[[\n            \"window_id\", \"link_id\", \"timestamp\", \"horizon_step\",\n            \"queue_label\", \"label_valid\", \"condition\",\n        ]],\n        on=[\"window_id\", \"link_id\", \"horizon_step\"],\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    origin_map = windows.set_index(\"window_id\")[\"origin\"]\n    features[\"expected_timestamp\"] = (\n        features[\"window_id\"].map(origin_map)\n        + pd.to_timedelta(features[\"horizon_step\"] * 5, unit=\"min\")\n    )\n\n    assert features[\"timestamp\"].equals(features[\"expected_timestamp\"]), (\n        f\"{panel}: label timestamp mismatch\"\n    )\n    assert not features.duplicated(\n        [\"window_id\", \"link_id\", \"timestamp\"]\n    ).any()\n\n    path = OUT / f\"{panel}_train_features.csv\"\n    features.to_csv(path, index=False)\n\n    print(\n        f\"Rows: {len(features):,} | \"\n        f\"Valid labels: {int(features['label_valid'].fillna(False).sum()):,} | \"\n        f\"Saved: {path.name}\"\n    )\n\nprint(\"\\nBase feature reconstruction complete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:41:18.29346Z","iopub.execute_input":"2026-10-25T07:41:18.293846Z","iopub.status.idle":"2026-10-25T07:41:27.836191Z","shell.execute_reply.started":"2026-10-25T07:41:18.293817Z","shell.execute_reply":"2026-10-25T07:41:27.83499Z"}},"outputs":[{"name":"stdout","text":"\nBuilding base features: D7_I10_E\nRows: 8,760 | Valid labels: 5,533 | Saved: D7_I10_E_train_features.csv\n\nBuilding base features: D7_I10_W\nRows: 6,420 | Valid labels: 4,149 | Saved: D7_I10_W_train_features.csv\n\nBuilding base features: D7_I210_E\nRows: 17,820 | Valid labels: 11,421 | Saved: D7_I210_E_train_features.csv\n\nBuilding base features: D7_I210_W\nRows: 4,860 | Valid labels: 3,068 | Saved: D7_I210_W_train_features.csv\n\nBuilding base features: D7_I405_N\nRows: 21,120 | Valid labels: 13,325 | Saved: D7_I405_N_train_features.csv\n\nBuilding base features: D7_I405_S\nRows: 6,540 | Valid labels: 4,144 | Saved: D7_I405_S_train_features.csv\n\nBuilding base features: D12_I5_N\nRows: 15,480 | Valid labels: 9,882 | Saved: D12_I5_N_train_features.csv\n\nBuilding base features: D12_I5_S\nRows: 6,000 | Valid labels: 3,840 | Saved: D12_I5_S_train_features.csv\n\nBase feature reconstruction complete.\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in PANELS:\n    input_path = BASE / f\"{panel}_train_features.csv\"\n    output_path = BASE / f\"{panel}_train_features_temporal.csv\"\n\n    df = pd.read_csv(input_path)\n\n    required = [\n        \"last3_speed_ratio_mean\", \"last6_speed_ratio_mean\",\n        \"last3_flow_ratio_mean\", \"last6_flow_ratio_mean\",\n        \"last3_occupancy_mean\", \"last6_occupancy_mean\",\n        \"speed_ratio_latest\", \"speed_ratio_first\",\n    ]\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"{panel}: missing required columns: {missing}\")\n\n    df[\"speed_ratio_recent_vs_long\"] = (\n        df[\"last3_speed_ratio_mean\"] - df[\"last6_speed_ratio_mean\"]\n    )\n    df[\"flow_ratio_recent_vs_long\"] = (\n        df[\"last3_flow_ratio_mean\"] - df[\"last6_flow_ratio_mean\"]\n    )\n    df[\"occupancy_recent_vs_long\"] = (\n        df[\"last3_occupancy_mean\"] - df[\"last6_occupancy_mean\"]\n    )\n    df[\"speed_ratio_recent_change\"] = (\n        df[\"speed_ratio_latest\"] - df[\"last3_speed_ratio_mean\"]\n    )\n    df[\"speed_ratio_overall_change\"] = (\n        df[\"speed_ratio_latest\"] - df[\"speed_ratio_first\"]\n    )\n\n    if \"last3_speed_ratio_std\" in df.columns:\n        df[\"speed_variability_recent\"] = df[\"last3_speed_ratio_std\"]\n\n    if \"last6_speed_ratio_std\" in df.columns:\n        df[\"speed_variability_long\"] = df[\"last6_speed_ratio_std\"]\n        if \"last3_speed_ratio_std\" in df.columns:\n            df[\"speed_variability_change\"] = (\n                df[\"last3_speed_ratio_std\"] - df[\"last6_speed_ratio_std\"]\n            )\n\n    df.to_csv(output_path, index=False)\n    print(f\"{panel}: {len(df):,} rows | saved {output_path.name}\")\n\nprint(\"\\nTemporal feature generation complete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:41:45.261816Z","iopub.execute_input":"2026-10-25T07:41:45.262138Z","iopub.status.idle":"2026-10-25T07:41:51.60844Z","shell.execute_reply.started":"2026-10-25T07:41:45.262112Z","shell.execute_reply":"2026-10-25T07:41:51.607649Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: 8,760 rows | saved D7_I10_E_train_features_temporal.csv\nD7_I10_W: 6,420 rows | saved D7_I10_W_train_features_temporal.csv\nD7_I210_E: 17,820 rows | saved D7_I210_E_train_features_temporal.csv\nD7_I210_W: 4,860 rows | saved D7_I210_W_train_features_temporal.csv\nD7_I405_N: 21,120 rows | saved D7_I405_N_train_features_temporal.csv\nD7_I405_S: 6,540 rows | saved D7_I405_S_train_features_temporal.csv\nD12_I5_N: 15,480 rows | saved D12_I5_N_train_features_temporal.csv\nD12_I5_S: 6,000 rows | saved D12_I5_S_train_features_temporal.csv\n\nTemporal feature generation complete.\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in PANELS:\n    print(f\"\\nBuilding spatial features: {panel}\")\n\n    history_path = ROOT / \"task2\" / panel / \"train\" / \"window_history.parquet\"\n    topology_path = ROOT / \"corridors\" / panel / \"network\" / \"lwr_mainline_topology.csv\"\n    temporal_path = BASE / f\"{panel}_train_features_temporal.csv\"\n    output_path = BASE / f\"{panel}_train_features_spatial.csv\"\n\n    assert history_path.exists(), f\"History missing: {history_path}\"\n    assert topology_path.exists(), f\"Topology missing: {topology_path}\"\n    assert temporal_path.exists(), f\"Temporal features missing: {temporal_path}\"\n\n    history = pd.read_parquet(history_path)\n    topology = pd.read_csv(topology_path)\n    features = pd.read_csv(temporal_path)\n\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    history = history.sort_values(\"timestamp\")\n\n    latest = history.groupby(\n        [\"window_id\", \"link_id\"], as_index=False\n    ).tail(1).copy()\n\n    topology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\n    topology[\"free_speed_kmh\"] = pd.to_numeric(\n        topology[\"free_speed_kmh\"], errors=\"coerce\"\n    )\n    free_speed = topology.set_index(\"mainline_link_id\")[\"free_speed_kmh\"]\n\n    latest[\"link_id\"] = latest[\"link_id\"].astype(str)\n    latest[\"neighbor_free_speed\"] = latest[\"link_id\"].map(free_speed)\n    latest[\"neighbor_speed_ratio\"] = (\n        latest[\"speed_kmh\"] / latest[\"neighbor_free_speed\"]\n    )\n\n    mainline_ids = set(topology[\"mainline_link_id\"])\n\n    def parse_neighbors(value):\n        if pd.isna(value):\n            return []\n        return [\n            x.strip() for x in str(value).split(\";\")\n            if x.strip() in mainline_ids\n        ]\n\n    incoming = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"incoming_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n    outgoing = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"outgoing_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n\n    lookup = latest.set_index([\"window_id\", \"link_id\"])\n    spatial_rows = []\n\n    for window_id, group in latest.groupby(\"window_id\", sort=False):\n        for link_id in group[\"link_id\"].unique():\n            row = {\"window_id\": window_id, \"link_id\": link_id}\n\n            for direction, mapping in [\n                (\"upstream\", incoming),\n                (\"downstream\", outgoing),\n            ]:\n                neighbors = mapping.get(link_id, [])\n                vals = []\n\n                for neighbor_id in neighbors:\n                    key = (window_id, neighbor_id)\n                    if key not in lookup.index:\n                        continue\n\n                    item = lookup.loc[key]\n                    if isinstance(item, pd.DataFrame):\n                        item = item.iloc[-1]\n                    vals.append(item)\n\n                ratios = [\n                    float(v[\"neighbor_speed_ratio\"])\n                    for v in vals\n                    if pd.notna(v[\"neighbor_speed_ratio\"])\n                ]\n                flows = [\n                    float(v[\"flow_vph\"])\n                    for v in vals\n                    if pd.notna(v[\"flow_vph\"])\n                ]\n                occs = [\n                    float(v[\"occupancy\"])\n                    for v in vals\n                    if pd.notna(v[\"occupancy\"])\n                ]\n\n                row[f\"{direction}_neighbor_count\"] = len(neighbors)\n                row[f\"{direction}_valid_speed_count\"] = len(ratios)\n                row[f\"{direction}_mean_speed_ratio\"] = (\n                    np.mean(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_min_speed_ratio\"] = (\n                    np.min(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_slow_neighbor_fraction\"] = (\n                    np.mean(np.array(ratios) <= 0.6) if ratios else np.nan\n                )\n                row[f\"{direction}_mean_flow\"] = (\n                    np.mean(flows) if flows else np.nan\n                )\n                row[f\"{direction}_mean_occupancy\"] = (\n                    np.mean(occs) if occs else np.nan\n                )\n\n            spatial_rows.append(row)\n\n    spatial = pd.DataFrame(spatial_rows)\n    if spatial.empty:\n        raise ValueError(f\"{panel}: spatial feature table is empty\")\n\n    merged = features.merge(\n        spatial,\n        on=[\"window_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    assert len(merged) == len(features), f\"{panel}: row count changed\"\n    merged.to_csv(output_path, index=False)\n\n    print(\n        f\"Rows: {len(merged):,} | \"\n        f\"Spatial rows: {len(spatial):,} | \"\n        f\"Saved: {output_path.name}\"\n    )\n\nprint(\"\\nSpatial feature generation complete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:42:10.77175Z","iopub.execute_input":"2026-10-25T07:42:10.772342Z","iopub.status.idle":"2026-10-25T07:42:23.911595Z","shell.execute_reply.started":"2026-10-25T07:42:10.772307Z","shell.execute_reply":"2026-10-25T07:42:23.910832Z"}},"outputs":[{"name":"stdout","text":"\nBuilding spatial features: D7_I10_E\nRows: 8,760 | Spatial rows: 1,460 | Saved: D7_I10_E_train_features_spatial.csv\n\nBuilding spatial features: D7_I10_W\nRows: 6,420 | Spatial rows: 1,070 | Saved: D7_I10_W_train_features_spatial.csv\n\nBuilding spatial features: D7_I210_E\nRows: 17,820 | Spatial rows: 2,970 | Saved: D7_I210_E_train_features_spatial.csv\n\nBuilding spatial features: D7_I210_W\nRows: 4,860 | Spatial rows: 810 | Saved: D7_I210_W_train_features_spatial.csv\n\nBuilding spatial features: D7_I405_N\nRows: 21,120 | Spatial rows: 3,520 | Saved: D7_I405_N_train_features_spatial.csv\n\nBuilding spatial features: D7_I405_S\nRows: 6,540 | Spatial rows: 1,090 | Saved: D7_I405_S_train_features_spatial.csv\n\nBuilding spatial features: D12_I5_N\nRows: 15,480 | Spatial rows: 2,580 | Saved: D12_I5_N_train_features_spatial.csv\n\nBuilding spatial features: D12_I5_S\nRows: 6,000 | Spatial rows: 1,000 | Saved: D12_I5_S_train_features_spatial.csv\n\nSpatial feature generation complete.\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nFEATURES = [\n    \"downstream_mean_flow\",\n    \"downstream_mean_occupancy\",\n    \"downstream_mean_speed_ratio\",\n    \"downstream_min_speed_ratio\",\n    \"downstream_neighbor_count\",\n    \"downstream_slow_neighbor_fraction\",\n    \"downstream_valid_speed_count\",\n    \"eligible_latest\",\n    \"flow_ratio_latest\",\n    \"flow_ratio_recent_vs_long\",\n    \"horizon_step\",\n    \"last3_eligible_fraction\",\n    \"last3_flow_ratio_mean\",\n    \"last3_occupancy_mean\",\n    \"last3_pct_observed_mean\",\n    \"last3_speed_ratio_mean\",\n    \"last3_speed_ratio_std\",\n    \"last6_eligible_fraction\",\n    \"last6_flow_ratio_mean\",\n    \"last6_occupancy_mean\",\n    \"last6_pct_observed_mean\",\n    \"last6_speed_ratio_mean\",\n    \"last6_speed_ratio_std\",\n    \"occupancy_latest\",\n    \"occupancy_recent_vs_long\",\n    \"pct_observed_latest\",\n    \"speed_ratio_change\",\n    \"speed_ratio_first\",\n    \"speed_ratio_latest\",\n    \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_change\",\n    \"speed_ratio_recent_vs_long\",\n    \"speed_variability_change\",\n    \"speed_variability_long\",\n    \"speed_variability_recent\",\n    \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\",\n    \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\",\n    \"upstream_neighbor_count\",\n    \"upstream_slow_neighbor_fraction\",\n    \"upstream_valid_speed_count\",\n]\n\nassert len(FEATURES) == 42\n\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(path)\n\n    missing = [c for c in FEATURES if c not in df.columns]\n    valid = df[\"label_valid\"].fillna(False).astype(bool)\n    labeled = df.loc[valid, \"queue_label\"]\n\n    print(\n        f\"{panel}: rows={len(df):,}, \"\n        f\"valid={int(valid.sum()):,}, \"\n        f\"features_missing={missing}, \"\n        f\"positive_labels={int(labeled.sum()):,}\"\n    )\n\n    if missing:\n        raise ValueError(f\"{panel} is missing model features: {missing}\")\n\nprint(\"\\nAll panels contain the required 42 model features.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:42:43.246315Z","iopub.execute_input":"2026-10-25T07:42:43.246635Z","iopub.status.idle":"2026-10-25T07:42:44.278977Z","shell.execute_reply.started":"2026-10-25T07:42:43.246612Z","shell.execute_reply":"2026-10-25T07:42:44.278167Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: rows=8,760, valid=5,533, features_missing=[], positive_labels=642\nD7_I10_W: rows=6,420, valid=4,149, features_missing=[], positive_labels=111\nD7_I210_E: rows=17,820, valid=11,421, features_missing=[], positive_labels=98\nD7_I210_W: rows=4,860, valid=3,068, features_missing=[], positive_labels=305\nD7_I405_N: rows=21,120, valid=13,325, features_missing=[], positive_labels=1,993\nD7_I405_S: rows=6,540, valid=4,144, features_missing=[], positive_labels=354\nD12_I5_N: rows=15,480, valid=9,882, features_missing=[], positive_labels=1,426\nD12_I5_S: rows=6,000, valid=3,840, features_missing=[], positive_labels=406\n\nAll panels contain the required 42 model features.\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"from pathlib import Path\nimport json\nimport joblib\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nMODEL_DIR = BASE / \"final_models\"\nMODEL_DIR.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nFEATURES = [\n    \"downstream_mean_flow\",\n    \"downstream_mean_occupancy\",\n    \"downstream_mean_speed_ratio\",\n    \"downstream_min_speed_ratio\",\n    \"downstream_neighbor_count\",\n    \"downstream_slow_neighbor_fraction\",\n    \"downstream_valid_speed_count\",\n    \"eligible_latest\",\n    \"flow_ratio_latest\",\n    \"flow_ratio_recent_vs_long\",\n    \"horizon_step\",\n    \"last3_eligible_fraction\",\n    \"last3_flow_ratio_mean\",\n    \"last3_occupancy_mean\",\n    \"last3_pct_observed_mean\",\n    \"last3_speed_ratio_mean\",\n    \"last3_speed_ratio_std\",\n    \"last6_eligible_fraction\",\n    \"last6_flow_ratio_mean\",\n    \"last6_occupancy_mean\",\n    \"last6_pct_observed_mean\",\n    \"last6_speed_ratio_mean\",\n    \"last6_speed_ratio_std\",\n    \"occupancy_latest\",\n    \"occupancy_recent_vs_long\",\n    \"pct_observed_latest\",\n    \"speed_ratio_change\",\n    \"speed_ratio_first\",\n    \"speed_ratio_latest\",\n    \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_change\",\n    \"speed_ratio_recent_vs_long\",\n    \"speed_variability_change\",\n    \"speed_variability_long\",\n    \"speed_variability_recent\",\n    \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\",\n    \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\",\n    \"upstream_neighbor_count\",\n    \"upstream_slow_neighbor_fraction\",\n    \"upstream_valid_speed_count\",\n]\n\nassert len(FEATURES) == 42\n\nframes = []\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(path)\n\n    missing = [c for c in FEATURES if c not in df.columns]\n    if missing:\n        raise ValueError(f\"{panel} missing features: {missing}\")\n\n    df = df[\n        df[\"label_valid\"].fillna(False).astype(bool)\n        & df[\"queue_label\"].notna()\n    ].copy()\n\n    df[\"panel\"] = panel\n    frames.append(df)\n\ntrain_df = pd.concat(frames, ignore_index=True)\ntrain_df[\"queue_label\"] = train_df[\"queue_label\"].astype(int)\n\n# Keep the two conditions separate.\n# Condition strings are read from the actual training labels.\nprint(\"Training rows:\", f\"{len(train_df):,}\")\nprint(\"\\nRows by condition:\")\nprint(train_df.groupby(\"condition\").size().to_string())\n\nmanifest = {\n    \"panels\": PANELS,\n    \"features\": FEATURES,\n    \"model_parameters\": {\n        \"n_estimators\": 300,\n        \"learning_rate\": 0.03,\n        \"num_leaves\": 15,\n        \"min_child_samples\": 30,\n        \"colsample_bytree\": 0.9,\n        \"subsample\": 0.9,\n        \"reg_lambda\": 2.0,\n        \"random_state\": 42,\n    },\n    \"thresholds\": {\n        \"ongoing\": 0.50,\n        \"onset\": 0.40,\n    },\n}\n\nfor condition in sorted(train_df[\"condition\"].dropna().unique()):\n    subset = train_df[train_df[\"condition\"] == condition].copy()\n    X = subset[FEATURES].replace([np.inf, -np.inf], np.nan)\n    y = subset[\"queue_label\"].astype(int)\n\n    positives = int(y.sum())\n    negatives = len(y) - positives\n\n    if y.nunique() != 2:\n        raise ValueError(\n            f\"{condition}: expected both classes, found {y.value_counts().to_dict()}\"\n        )\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / max(positives, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X, y)\n\n    artifact = {\n        \"model\": model,\n        \"features\": FEATURES,\n        \"condition\": condition,\n        \"threshold\": manifest[\"thresholds\"].get(\n            str(condition).lower(), 0.50\n        ),\n    }\n\n    safe_name = str(condition).lower().replace(\" \", \"_\")\n    path = MODEL_DIR / f\"{safe_name}_model.joblib\"\n    joblib.dump(artifact, path)\n\n    print(\n        f\"\\n{condition}: rows={len(subset):,}, \"\n        f\"positives={positives:,}, \"\n        f\"positive_rate={y.mean():.4%}\"\n    )\n    print(\"Saved:\", path)\n\nmanifest_path = MODEL_DIR / \"manifest.json\"\nmanifest_path.write_text(json.dumps(manifest, indent=2))\n\nprint(\"\\nModels and manifest saved to:\", MODEL_DIR)\nprint(\"Model files:\", [p.name for p in sorted(MODEL_DIR.glob(\"*\"))])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:43:03.722875Z","iopub.execute_input":"2026-10-25T07:43:03.723271Z","iopub.status.idle":"2026-10-25T07:43:12.302902Z","shell.execute_reply.started":"2026-10-25T07:43:03.72324Z","shell.execute_reply":"2026-10-25T07:43:12.301999Z"}},"outputs":[{"name":"stdout","text":"Training rows: 55,362\n\nRows by condition:\ncondition\nqueue_ongoing    27635\nqueue_onset      27727\n\nqueue_ongoing: rows=27,635, positives=5,235, positive_rate=18.9434%\nSaved: /kaggle/working/task2_training_labels/final_models/queue_ongoing_model.joblib\n\nqueue_onset: rows=27,727, positives=100, positive_rate=0.3607%\nSaved: /kaggle/working/task2_training_labels/final_models/queue_onset_model.joblib\n\nModels and manifest saved to: /kaggle/working/task2_training_labels/final_models\nModel files: ['manifest.json', 'queue_ongoing_model.joblib', 'queue_onset_model.joblib']\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\n\npanel = \"D7_I10_E\"\nhistory_path = ROOT / \"task2\" / panel / \"validation\" / \"window_history.parquet\"\n\nhistory = pd.read_parquet(history_path)\n\nprint(\"History columns:\")\nprint(history.columns.tolist())\n\nprint(\"\\nLatest-row columns:\")\nhistory[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\nlatest = history.sort_values(\"timestamp\").groupby(\n    [\"window_id\", \"link_id\"], as_index=False\n).tail(1).copy()\nprint(latest.columns.tolist())\n\nprint(\"\\nSpeed-related columns:\")\nprint([c for c in latest.columns if \"speed\" in c.lower()])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:44:39.859661Z","iopub.execute_input":"2026-10-25T07:44:39.859993Z","iopub.status.idle":"2026-10-25T07:44:39.889458Z","shell.execute_reply.started":"2026-10-25T07:44:39.859965Z","shell.execute_reply":"2026-10-25T07:44:39.888495Z"}},"outputs":[{"name":"stdout","text":"History columns:\n['window_id', 'timestamp', 'link_id', 'speed_kmh', 'flow_vph', 'occupancy', 'pct_observed', 'is_score_eligible']\n\nLatest-row columns:\n['window_id', 'timestamp', 'link_id', 'speed_kmh', 'flow_vph', 'occupancy', 'pct_observed', 'is_score_eligible']\n\nSpeed-related columns:\n['speed_kmh']\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"from pathlib import Path\nimport joblib\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nMODEL_DIR = BASE / \"final_models\"\nOUT = BASE / \"validation_predictions\"\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nFEATURES = [\n    \"downstream_mean_flow\", \"downstream_mean_occupancy\",\n    \"downstream_mean_speed_ratio\", \"downstream_min_speed_ratio\",\n    \"downstream_neighbor_count\", \"downstream_slow_neighbor_fraction\",\n    \"downstream_valid_speed_count\", \"eligible_latest\",\n    \"flow_ratio_latest\", \"flow_ratio_recent_vs_long\", \"horizon_step\",\n    \"last3_eligible_fraction\", \"last3_flow_ratio_mean\",\n    \"last3_occupancy_mean\", \"last3_pct_observed_mean\",\n    \"last3_speed_ratio_mean\", \"last3_speed_ratio_std\",\n    \"last6_eligible_fraction\", \"last6_flow_ratio_mean\",\n    \"last6_occupancy_mean\", \"last6_pct_observed_mean\",\n    \"last6_speed_ratio_mean\", \"last6_speed_ratio_std\",\n    \"occupancy_latest\", \"occupancy_recent_vs_long\",\n    \"pct_observed_latest\", \"speed_ratio_change\", \"speed_ratio_first\",\n    \"speed_ratio_latest\", \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_change\", \"speed_ratio_recent_vs_long\",\n    \"speed_variability_change\", \"speed_variability_long\",\n    \"speed_variability_recent\", \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\", \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\", \"upstream_neighbor_count\",\n    \"upstream_slow_neighbor_fraction\", \"upstream_valid_speed_count\",\n]\n\nmodels = {\n    \"queue_ongoing\": joblib.load(MODEL_DIR / \"queue_ongoing_model.joblib\"),\n    \"queue_onset\": joblib.load(MODEL_DIR / \"queue_onset_model.joblib\"),\n}\n\ndef make_validation_features(panel):\n    folder = ROOT / \"task2\" / panel / \"validation\"\n    history = pd.read_parquet(folder / \"window_history.parquet\")\n    wi = pd.read_csv(folder / \"window_index.csv\")\n    template = pd.read_csv(folder / \"sample_submission_queue.csv\")\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )\n    topology = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"lwr_mainline_topology.csv\"\n    )\n\n    # Preserve template row order as the final prediction order.\n    template[\"_row_order\"] = np.arange(len(template))\n    template[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n    wi[\"origin\"] = pd.to_datetime(wi[\"forecast_origin\"], utc=True)\n\n    # Normalize IDs consistently for feature construction.\n    history[\"link_id\"] = history[\"link_id\"].astype(str)\n    template[\"link_id\"] = template[\"link_id\"].astype(str)\n    fd[\"link_id\"] = fd[\"link_id\"].astype(str)\n\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    history = history.merge(\n        fd[[\"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\"]],\n        on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    history = history.merge(\n        wi[[\"window_id\", \"origin\"]],\n        on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n    )\n\n    for c in [\"speed_kmh\", \"flow_vph\", \"occupancy\"]:\n        history[c] = pd.to_numeric(history[c], errors=\"coerce\")\n\n    history[\"speed_ratio\"] = history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n    history[\"flow_ratio\"] = history[\"flow_vph\"] / history[\"capacity_vph\"]\n\n    history = history.sort_values(\n        [\"window_id\", \"link_id\", \"timestamp\"]\n    ).copy()\n    keys = [\"window_id\", \"link_id\"]\n\n    latest = history.groupby(keys, sort=False).tail(1).copy()\n    latest = latest.rename(columns={\n        \"speed_ratio\": \"speed_ratio_latest\",\n        \"flow_ratio\": \"flow_ratio_latest\",\n        \"occupancy\": \"occupancy_latest\",\n        \"speed_kmh\": \"speed_latest\",\n        \"flow_vph\": \"flow_latest\",\n        \"pct_observed\": \"pct_observed_latest\",\n        \"is_score_eligible\": \"eligible_latest\",\n    })\n\n    features = latest[\n        keys + [\n            \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\",\n            \"speed_ratio_latest\", \"flow_ratio_latest\", \"occupancy_latest\",\n            \"speed_latest\", \"flow_latest\", \"pct_observed_latest\",\n            \"eligible_latest\",\n        ]\n    ].copy()\n\n    for n_steps, prefix in [(3, \"last3\"), (6, \"last6\")]:\n        recent = history.groupby(keys, sort=False).tail(n_steps)\n        agg = recent.groupby(keys).agg(\n            speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n            speed_ratio_std=(\"speed_ratio\", \"std\"),\n            flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n            occupancy_mean=(\"occupancy\", \"mean\"),\n            pct_observed_mean=(\"pct_observed\", \"mean\"),\n            eligible_fraction=(\"is_score_eligible\", \"mean\"),\n            observed_speed_fraction=(\"speed_kmh\", lambda x: x.notna().mean()),\n        ).reset_index()\n        agg = agg.rename(columns={\n            c: f\"{prefix}_{c}\" for c in agg.columns if c not in keys\n        })\n        features = features.merge(\n            agg, on=keys, how=\"left\", validate=\"one_to_one\"\n        )\n\n    first = history.groupby(keys, sort=False).head(1)[\n        keys + [\"speed_ratio\"]\n    ].rename(columns={\"speed_ratio\": \"speed_ratio_first\"})\n    features = features.merge(\n        first, on=keys, how=\"left\", validate=\"one_to_one\"\n    )\n    features[\"speed_ratio_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n\n    features[\"speed_ratio_recent_vs_long\"] = (\n        features[\"last3_speed_ratio_mean\"] - features[\"last6_speed_ratio_mean\"]\n    )\n    features[\"flow_ratio_recent_vs_long\"] = (\n        features[\"last3_flow_ratio_mean\"] - features[\"last6_flow_ratio_mean\"]\n    )\n    features[\"occupancy_recent_vs_long\"] = (\n        features[\"last3_occupancy_mean\"] - features[\"last6_occupancy_mean\"]\n    )\n    features[\"speed_ratio_recent_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"last3_speed_ratio_mean\"]\n    )\n    features[\"speed_ratio_overall_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n    features[\"speed_variability_recent\"] = features[\"last3_speed_ratio_std\"]\n    features[\"speed_variability_long\"] = features[\"last6_speed_ratio_std\"]\n    features[\"speed_variability_change\"] = (\n        features[\"last3_speed_ratio_std\"] - features[\"last6_speed_ratio_std\"]\n    )\n\n        # Spatial aggregates from the latest released observation per link.\n    # Build independently from raw released history to preserve speed_kmh.\n    raw_history = pd.read_parquet(folder / \"window_history.parquet\")\n    raw_history[\"timestamp\"] = pd.to_datetime(\n        raw_history[\"timestamp\"], utc=True\n    )\n    raw_history[\"link_id\"] = raw_history[\"link_id\"].astype(str)\n\n    latest_spatial = raw_history.sort_values(\"timestamp\").groupby(\n        [\"window_id\", \"link_id\"], as_index=False\n    ).tail(1).copy()\n\n    topology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\n    topology[\"free_speed_kmh\"] = pd.to_numeric(\n        topology[\"free_speed_kmh\"], errors=\"coerce\"\n    )\n    free_speed = topology.set_index(\"mainline_link_id\")[\"free_speed_kmh\"]\n\n    latest_spatial[\"neighbor_free_speed\"] = (\n        latest_spatial[\"link_id\"].map(free_speed)\n    )\n    latest_spatial[\"neighbor_speed_ratio\"] = (\n        pd.to_numeric(latest_spatial[\"speed_kmh\"], errors=\"coerce\")\n        / latest_spatial[\"neighbor_free_speed\"]\n    )\n\n    mainline_ids = set(topology[\"mainline_link_id\"])\n\n    def parse_neighbors(value):\n        if pd.isna(value):\n            return []\n        return [\n            x.strip() for x in str(value).split(\";\")\n            if x.strip() in mainline_ids\n        ]\n\n    incoming = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"incoming_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n    outgoing = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"outgoing_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n\n    lookup = latest_spatial.set_index([\"window_id\", \"link_id\"])\n    spatial_rows = []\n\n    for window_id, group in latest_spatial.groupby(\"window_id\", sort=False):\n        for link_id in group[\"link_id\"].unique():\n            row = {\"window_id\": window_id, \"link_id\": link_id}\n\n            for direction, mapping in [\n                (\"upstream\", incoming),\n                (\"downstream\", outgoing),\n            ]:\n                neighbors = mapping.get(link_id, [])\n                vals = []\n\n                for neighbor_id in neighbors:\n                    key = (window_id, neighbor_id)\n                    if key not in lookup.index:\n                        continue\n\n                    item = lookup.loc[key]\n                    if isinstance(item, pd.DataFrame):\n                        item = item.iloc[-1]\n                    vals.append(item)\n\n                ratios = [\n                    float(v[\"neighbor_speed_ratio\"])\n                    for v in vals\n                    if pd.notna(v[\"neighbor_speed_ratio\"])\n                ]\n                flows = [\n                    float(v[\"flow_vph\"])\n                    for v in vals\n                    if pd.notna(v[\"flow_vph\"])\n                ]\n                occs = [\n                    float(v[\"occupancy\"])\n                    for v in vals\n                    if pd.notna(v[\"occupancy\"])\n                ]\n\n                row[f\"{direction}_neighbor_count\"] = len(neighbors)\n                row[f\"{direction}_valid_speed_count\"] = len(ratios)\n                row[f\"{direction}_mean_speed_ratio\"] = (\n                    np.mean(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_min_speed_ratio\"] = (\n                    np.min(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_slow_neighbor_fraction\"] = (\n                    np.mean(np.array(ratios) <= 0.6) if ratios else np.nan\n                )\n                row[f\"{direction}_mean_flow\"] = (\n                    np.mean(flows) if flows else np.nan\n                )\n                row[f\"{direction}_mean_occupancy\"] = (\n                    np.mean(occs) if occs else np.nan\n                )\n\n            spatial_rows.append(row)\n\n    spatial = pd.DataFrame(spatial_rows)\n\n    features = features.merge(\n        spatial,\n        on=[\"window_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    # Match each submission row to its window/link predictors.\n    template = template.merge(\n        wi[[\"window_id\", \"forecast_origin\", \"origin\", \"condition\"]],\n        on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    template[\"horizon_step\"] = (\n        (template[\"timestamp\"] - template[\"origin\"]).dt.total_seconds() / 300\n    ).round().astype(int)\n\n    if not template[\"horizon_step\"].between(1, 6).all():\n        raise ValueError(f\"{panel}: unexpected forecast horizon in template\")\n\n    result = template.merge(\n        features, on=keys, how=\"left\", validate=\"many_to_one\",\n        suffixes=(\"\", \"_feature\")\n    ).sort_values(\"_row_order\").reset_index(drop=True)\n\n    missing = [c for c in FEATURES if c not in result.columns]\n    if missing:\n        raise ValueError(f\"{panel}: missing inference features: {missing}\")\n\n    if result[FEATURES].isna().all(axis=1).any():\n        raise ValueError(f\"{panel}: at least one row has no usable predictors\")\n\n    return result, template\n\nall_predictions = []\n\nfor panel in PANELS:\n    print(f\"\\nPredicting validation: {panel}\")\n    result, original_template = make_validation_features(panel)\n\n    probabilities = np.zeros(len(result), dtype=float)\n    predictions = np.zeros(len(result), dtype=np.int8)\n\n    for condition, artifact in models.items():\n        mask = result[\"condition\"].astype(str).eq(condition).to_numpy()\n        if not mask.any():\n            continue\n\n        model = artifact[\"model\"]\n        threshold = float(artifact[\"threshold\"])\n        X = result.loc[mask, FEATURES].replace([np.inf, -np.inf], np.nan)\n        prob = model.predict_proba(X)[:, 1]\n\n        probabilities[mask] = prob\n        predictions[mask] = (prob >= threshold).astype(np.int8)\n\n    result[\"queue_probability\"] = probabilities\n    result[\"queue_pred\"] = predictions\n\n    # Confirm exact alignment with the original template.\n    assert len(result) == len(original_template)\n    assert result[\"_row_order\"].tolist() == list(range(len(result)))\n\n    output = result[\n        [\"window_id\", \"timestamp\", \"link_id\", \"queue_pred\"]\n    ].copy()\n    output[\"timestamp\"] = output[\"timestamp\"].astype(str)\n    output_path = OUT / f\"{panel}_validation_predictions.csv\"\n    output.to_csv(output_path, index=False)\n\n    print(\n        f\"Rows: {len(output):,} | \"\n        f\"Predicted queue cells: {int(output['queue_pred'].sum()):,} | \"\n        f\"Saved: {output_path.name}\"\n    )\n    all_predictions.append(output.assign(panel=panel))\n\ncombined = pd.concat(all_predictions, ignore_index=True)\ncombined.to_csv(OUT / \"all_panels_validation_predictions.csv\", index=False)\n\nprint(\"\\nValidation inference complete.\")\nprint(\"Total rows:\", f\"{len(combined):,}\")\nprint(\"Output directory:\", OUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:46:17.113339Z","iopub.execute_input":"2026-10-25T07:46:17.113687Z","iopub.status.idle":"2026-10-25T07:46:29.005249Z","shell.execute_reply.started":"2026-10-25T07:46:17.113658Z","shell.execute_reply":"2026-10-25T07:46:29.004376Z"}},"outputs":[{"name":"stdout","text":"\nPredicting validation: D7_I10_E\nRows: 8,760 | Predicted queue cells: 517 | Saved: D7_I10_E_validation_predictions.csv\n\nPredicting validation: D7_I10_W\nRows: 6,420 | Predicted queue cells: 171 | Saved: D7_I10_W_validation_predictions.csv\n\nPredicting validation: D7_I210_E\nRows: 17,820 | Predicted queue cells: 228 | Saved: D7_I210_E_validation_predictions.csv\n\nPredicting validation: D7_I210_W\nRows: 4,860 | Predicted queue cells: 364 | Saved: D7_I210_W_validation_predictions.csv\n\nPredicting validation: D7_I405_N\nRows: 21,120 | Predicted queue cells: 2,597 | Saved: D7_I405_N_validation_predictions.csv\n\nPredicting validation: D7_I405_S\nRows: 6,540 | Predicted queue cells: 1,000 | Saved: D7_I405_S_validation_predictions.csv\n\nPredicting validation: D12_I5_N\nRows: 15,480 | Predicted queue cells: 816 | Saved: D12_I5_N_validation_predictions.csv\n\nPredicting validation: D12_I5_S\nRows: 6,000 | Predicted queue cells: 489 | Saved: D12_I5_S_validation_predictions.csv\n\nValidation inference complete.\nTotal rows: 87,000\nOutput directory: /kaggle/working/task2_training_labels/validation_predictions\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nOUT = Path(\"/kaggle/working/task2_training_labels/validation_predictions\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\ntotal_rows = 0\n\nfor panel in PANELS:\n    pred = pd.read_csv(OUT / f\"{panel}_validation_predictions.csv\")\n    template = pd.read_csv(\n        ROOT / \"task2\" / panel / \"validation\" / \"sample_submission_queue.csv\"\n    )\n\n    assert len(pred) == len(template), f\"{panel}: row count mismatch\"\n    assert pred.columns.tolist() == template.columns.tolist(), (\n        f\"{panel}: column mismatch\"\n    )\n\n    for col in [\"window_id\", \"link_id\"]:\n        assert (\n            pred[col].astype(str).to_numpy()\n            == template[col].astype(str).to_numpy()\n        ).all(), f\"{panel}: row alignment mismatch in {col}\"\n\n    pred_ts = pd.to_datetime(pred[\"timestamp\"], utc=True, errors=\"coerce\")\n    template_ts = pd.to_datetime(template[\"timestamp\"], utc=True, errors=\"coerce\")\n\n    assert pred_ts.notna().all(), f\"{panel}: invalid prediction timestamps\"\n    assert template_ts.notna().all(), f\"{panel}: invalid template timestamps\"\n    assert (pred_ts.to_numpy() == template_ts.to_numpy()).all(), (\n        f\"{panel}: timestamp alignment mismatch\"\n    )\n\n    assert pred[\"queue_pred\"].notna().all(), f\"{panel}: missing predictions\"\n    assert pred[\"queue_pred\"].isin([0, 1]).all(), f\"{panel}: invalid labels\"\n\n    total_rows += len(pred)\n    print(\n        f\"{panel}: PASS | rows={len(pred):,} | \"\n        f\"positive predictions={int(pred['queue_pred'].sum()):,}\"\n    )\n\nprint(f\"\\nAll checks passed. Total rows: {total_rows:,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:50:17.288131Z","iopub.execute_input":"2026-10-25T07:50:17.288522Z","iopub.status.idle":"2026-10-25T07:50:17.975689Z","shell.execute_reply.started":"2026-10-25T07:50:17.288492Z","shell.execute_reply":"2026-10-25T07:50:17.974663Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: PASS | rows=8,760 | positive predictions=517\nD7_I10_W: PASS | rows=6,420 | positive predictions=171\nD7_I210_E: PASS | rows=17,820 | positive predictions=228\nD7_I210_W: PASS | rows=4,860 | positive predictions=364\nD7_I405_N: PASS | rows=21,120 | positive predictions=2,597\nD7_I405_S: PASS | rows=6,540 | positive predictions=1,000\nD12_I5_N: PASS | rows=15,480 | positive predictions=816\nD12_I5_S: PASS | rows=6,000 | positive predictions=489\n\nAll checks passed. Total rows: 87,000\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nfor panel in PANELS:\n    folder = ROOT / \"task2\" / panel / \"private\"\n\n    required = [\n        folder / \"window_history.parquet\",\n        folder / \"window_index.csv\",\n        folder / \"sample_submission_queue.csv\",\n    ]\n\n    missing = [str(p) for p in required if not p.exists()]\n    if missing:\n        print(f\"{panel}: MISSING\")\n        for path in missing:\n            print(\"  \", path)\n    else:\n        template = pd.read_csv(required[2])\n        print(f\"{panel}: OK | {len(template):,} submission rows\")\n\nprint(\"\\nPrivate-test input check complete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:50:36.610538Z","iopub.execute_input":"2026-10-25T07:50:36.610878Z","iopub.status.idle":"2026-10-25T07:50:36.769295Z","shell.execute_reply.started":"2026-10-25T07:50:36.610846Z","shell.execute_reply":"2026-10-25T07:50:36.76831Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: OK | 8,760 submission rows\nD7_I10_W: OK | 6,420 submission rows\nD7_I210_E: OK | 17,820 submission rows\nD7_I210_W: OK | 4,860 submission rows\nD7_I405_N: OK | 21,120 submission rows\nD7_I405_S: OK | 6,540 submission rows\nD12_I5_N: OK | 15,480 submission rows\nD12_I5_S: OK | 6,000 submission rows\n\nPrivate-test input check complete.\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"from pathlib import Path\nimport joblib\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nMODEL_DIR = BASE / \"final_models\"\nOUT = Path(\"/kaggle/working/task2_training_labels/private_predictions\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nFEATURES = [\n    \"downstream_mean_flow\", \"downstream_mean_occupancy\",\n    \"downstream_mean_speed_ratio\", \"downstream_min_speed_ratio\",\n    \"downstream_neighbor_count\", \"downstream_slow_neighbor_fraction\",\n    \"downstream_valid_speed_count\", \"eligible_latest\",\n    \"flow_ratio_latest\", \"flow_ratio_recent_vs_long\", \"horizon_step\",\n    \"last3_eligible_fraction\", \"last3_flow_ratio_mean\",\n    \"last3_occupancy_mean\", \"last3_pct_observed_mean\",\n    \"last3_speed_ratio_mean\", \"last3_speed_ratio_std\",\n    \"last6_eligible_fraction\", \"last6_flow_ratio_mean\",\n    \"last6_occupancy_mean\", \"last6_pct_observed_mean\",\n    \"last6_speed_ratio_mean\", \"last6_speed_ratio_std\",\n    \"occupancy_latest\", \"occupancy_recent_vs_long\",\n    \"pct_observed_latest\", \"speed_ratio_change\", \"speed_ratio_first\",\n    \"speed_ratio_latest\", \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_change\", \"speed_ratio_recent_vs_long\",\n    \"speed_variability_change\", \"speed_variability_long\",\n    \"speed_variability_recent\", \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\", \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\", \"upstream_neighbor_count\",\n    \"upstream_slow_neighbor_fraction\", \"upstream_valid_speed_count\",\n]\n\nmodels = {\n    \"queue_ongoing\": joblib.load(MODEL_DIR / \"queue_ongoing_model.joblib\"),\n    \"queue_onset\": joblib.load(MODEL_DIR / \"queue_onset_model.joblib\"),\n}\n\ndef make_validation_features(panel):\n    folder = ROOT / \"task2\" / panel / \"private\"\n    history = pd.read_parquet(folder / \"window_history.parquet\")\n    wi = pd.read_csv(folder / \"window_index.csv\")\n    template = pd.read_csv(folder / \"sample_submission_queue.csv\")\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )\n    topology = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"lwr_mainline_topology.csv\"\n    )\n\n    # Preserve template row order as the final prediction order.\n    template[\"_row_order\"] = np.arange(len(template))\n    template[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n    wi[\"origin\"] = pd.to_datetime(wi[\"forecast_origin\"], utc=True)\n\n    # Normalize IDs consistently for feature construction.\n    history[\"link_id\"] = history[\"link_id\"].astype(str)\n    template[\"link_id\"] = template[\"link_id\"].astype(str)\n    fd[\"link_id\"] = fd[\"link_id\"].astype(str)\n\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n    history = history.merge(\n        fd[[\"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\"]],\n        on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    history = history.merge(\n        wi[[\"window_id\", \"origin\"]],\n        on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n    )\n\n    for c in [\"speed_kmh\", \"flow_vph\", \"occupancy\"]:\n        history[c] = pd.to_numeric(history[c], errors=\"coerce\")\n\n    history[\"speed_ratio\"] = history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n    history[\"flow_ratio\"] = history[\"flow_vph\"] / history[\"capacity_vph\"]\n\n    history = history.sort_values(\n        [\"window_id\", \"link_id\", \"timestamp\"]\n    ).copy()\n    keys = [\"window_id\", \"link_id\"]\n\n    latest = history.groupby(keys, sort=False).tail(1).copy()\n    latest = latest.rename(columns={\n        \"speed_ratio\": \"speed_ratio_latest\",\n        \"flow_ratio\": \"flow_ratio_latest\",\n        \"occupancy\": \"occupancy_latest\",\n        \"speed_kmh\": \"speed_latest\",\n        \"flow_vph\": \"flow_latest\",\n        \"pct_observed\": \"pct_observed_latest\",\n        \"is_score_eligible\": \"eligible_latest\",\n    })\n\n    features = latest[\n        keys + [\n            \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\",\n            \"speed_ratio_latest\", \"flow_ratio_latest\", \"occupancy_latest\",\n            \"speed_latest\", \"flow_latest\", \"pct_observed_latest\",\n            \"eligible_latest\",\n        ]\n    ].copy()\n\n    for n_steps, prefix in [(3, \"last3\"), (6, \"last6\")]:\n        recent = history.groupby(keys, sort=False).tail(n_steps)\n        agg = recent.groupby(keys).agg(\n            speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n            speed_ratio_std=(\"speed_ratio\", \"std\"),\n            flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n            occupancy_mean=(\"occupancy\", \"mean\"),\n            pct_observed_mean=(\"pct_observed\", \"mean\"),\n            eligible_fraction=(\"is_score_eligible\", \"mean\"),\n            observed_speed_fraction=(\"speed_kmh\", lambda x: x.notna().mean()),\n        ).reset_index()\n        agg = agg.rename(columns={\n            c: f\"{prefix}_{c}\" for c in agg.columns if c not in keys\n        })\n        features = features.merge(\n            agg, on=keys, how=\"left\", validate=\"one_to_one\"\n        )\n\n    first = history.groupby(keys, sort=False).head(1)[\n        keys + [\"speed_ratio\"]\n    ].rename(columns={\"speed_ratio\": \"speed_ratio_first\"})\n    features = features.merge(\n        first, on=keys, how=\"left\", validate=\"one_to_one\"\n    )\n    features[\"speed_ratio_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n\n    features[\"speed_ratio_recent_vs_long\"] = (\n        features[\"last3_speed_ratio_mean\"] - features[\"last6_speed_ratio_mean\"]\n    )\n    features[\"flow_ratio_recent_vs_long\"] = (\n        features[\"last3_flow_ratio_mean\"] - features[\"last6_flow_ratio_mean\"]\n    )\n    features[\"occupancy_recent_vs_long\"] = (\n        features[\"last3_occupancy_mean\"] - features[\"last6_occupancy_mean\"]\n    )\n    features[\"speed_ratio_recent_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"last3_speed_ratio_mean\"]\n    )\n    features[\"speed_ratio_overall_change\"] = (\n        features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n    )\n    features[\"speed_variability_recent\"] = features[\"last3_speed_ratio_std\"]\n    features[\"speed_variability_long\"] = features[\"last6_speed_ratio_std\"]\n    features[\"speed_variability_change\"] = (\n        features[\"last3_speed_ratio_std\"] - features[\"last6_speed_ratio_std\"]\n    )\n\n        # Spatial aggregates from the latest released observation per link.\n    # Build independently from raw released history to preserve speed_kmh.\n    raw_history = pd.read_parquet(folder / \"window_history.parquet\")\n    raw_history[\"timestamp\"] = pd.to_datetime(\n        raw_history[\"timestamp\"], utc=True\n    )\n    raw_history[\"link_id\"] = raw_history[\"link_id\"].astype(str)\n\n    latest_spatial = raw_history.sort_values(\"timestamp\").groupby(\n        [\"window_id\", \"link_id\"], as_index=False\n    ).tail(1).copy()\n\n    topology[\"mainline_link_id\"] = topology[\"mainline_link_id\"].astype(str)\n    topology[\"free_speed_kmh\"] = pd.to_numeric(\n        topology[\"free_speed_kmh\"], errors=\"coerce\"\n    )\n    free_speed = topology.set_index(\"mainline_link_id\")[\"free_speed_kmh\"]\n\n    latest_spatial[\"neighbor_free_speed\"] = (\n        latest_spatial[\"link_id\"].map(free_speed)\n    )\n    latest_spatial[\"neighbor_speed_ratio\"] = (\n        pd.to_numeric(latest_spatial[\"speed_kmh\"], errors=\"coerce\")\n        / latest_spatial[\"neighbor_free_speed\"]\n    )\n\n    mainline_ids = set(topology[\"mainline_link_id\"])\n\n    def parse_neighbors(value):\n        if pd.isna(value):\n            return []\n        return [\n            x.strip() for x in str(value).split(\";\")\n            if x.strip() in mainline_ids\n        ]\n\n    incoming = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"incoming_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n    outgoing = {\n        r[\"mainline_link_id\"]: parse_neighbors(r[\"outgoing_link_ids\"])\n        for _, r in topology.iterrows()\n    }\n\n    lookup = latest_spatial.set_index([\"window_id\", \"link_id\"])\n    spatial_rows = []\n\n    for window_id, group in latest_spatial.groupby(\"window_id\", sort=False):\n        for link_id in group[\"link_id\"].unique():\n            row = {\"window_id\": window_id, \"link_id\": link_id}\n\n            for direction, mapping in [\n                (\"upstream\", incoming),\n                (\"downstream\", outgoing),\n            ]:\n                neighbors = mapping.get(link_id, [])\n                vals = []\n\n                for neighbor_id in neighbors:\n                    key = (window_id, neighbor_id)\n                    if key not in lookup.index:\n                        continue\n\n                    item = lookup.loc[key]\n                    if isinstance(item, pd.DataFrame):\n                        item = item.iloc[-1]\n                    vals.append(item)\n\n                ratios = [\n                    float(v[\"neighbor_speed_ratio\"])\n                    for v in vals\n                    if pd.notna(v[\"neighbor_speed_ratio\"])\n                ]\n                flows = [\n                    float(v[\"flow_vph\"])\n                    for v in vals\n                    if pd.notna(v[\"flow_vph\"])\n                ]\n                occs = [\n                    float(v[\"occupancy\"])\n                    for v in vals\n                    if pd.notna(v[\"occupancy\"])\n                ]\n\n                row[f\"{direction}_neighbor_count\"] = len(neighbors)\n                row[f\"{direction}_valid_speed_count\"] = len(ratios)\n                row[f\"{direction}_mean_speed_ratio\"] = (\n                    np.mean(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_min_speed_ratio\"] = (\n                    np.min(ratios) if ratios else np.nan\n                )\n                row[f\"{direction}_slow_neighbor_fraction\"] = (\n                    np.mean(np.array(ratios) <= 0.6) if ratios else np.nan\n                )\n                row[f\"{direction}_mean_flow\"] = (\n                    np.mean(flows) if flows else np.nan\n                )\n                row[f\"{direction}_mean_occupancy\"] = (\n                    np.mean(occs) if occs else np.nan\n                )\n\n            spatial_rows.append(row)\n\n    spatial = pd.DataFrame(spatial_rows)\n\n    features = features.merge(\n        spatial,\n        on=[\"window_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    # Match each submission row to its window/link predictors.\n    template = template.merge(\n        wi[[\"window_id\", \"forecast_origin\", \"origin\", \"condition\"]],\n        on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    template[\"horizon_step\"] = (\n        (template[\"timestamp\"] - template[\"origin\"]).dt.total_seconds() / 300\n    ).round().astype(int)\n\n    if not template[\"horizon_step\"].between(1, 6).all():\n        raise ValueError(f\"{panel}: unexpected forecast horizon in template\")\n\n    result = template.merge(\n        features, on=keys, how=\"left\", validate=\"many_to_one\",\n        suffixes=(\"\", \"_feature\")\n    ).sort_values(\"_row_order\").reset_index(drop=True)\n\n    missing = [c for c in FEATURES if c not in result.columns]\n    if missing:\n        raise ValueError(f\"{panel}: missing inference features: {missing}\")\n\n    if result[FEATURES].isna().all(axis=1).any():\n        raise ValueError(f\"{panel}: at least one row has no usable predictors\")\n\n    return result, template\n\nall_predictions = []\n\nfor panel in PANELS:\n    print(f\"\\nPredicting validation: {panel}\")\n    result, original_template = make_validation_features(panel)\n\n    probabilities = np.zeros(len(result), dtype=float)\n    predictions = np.zeros(len(result), dtype=np.int8)\n\n    for condition, artifact in models.items():\n        mask = result[\"condition\"].astype(str).eq(condition).to_numpy()\n        if not mask.any():\n            continue\n\n        model = artifact[\"model\"]\n        threshold = float(artifact[\"threshold\"])\n        X = result.loc[mask, FEATURES].replace([np.inf, -np.inf], np.nan)\n        prob = model.predict_proba(X)[:, 1]\n\n        probabilities[mask] = prob\n        predictions[mask] = (prob >= threshold).astype(np.int8)\n\n    result[\"queue_probability\"] = probabilities\n    result[\"queue_pred\"] = predictions\n\n    # Confirm exact alignment with the original template.\n    assert len(result) == len(original_template)\n    assert result[\"_row_order\"].tolist() == list(range(len(result)))\n\n    output = result[\n        [\"window_id\", \"timestamp\", \"link_id\", \"queue_pred\"]\n    ].copy()\n    output[\"timestamp\"] = output[\"timestamp\"].astype(str)\n    output_path = OUT / f\"{panel}_private_predictions.csv\"\n    output.to_csv(output_path, index=False)\n\n    print(\n        f\"Rows: {len(output):,} | \"\n        f\"Predicted queue cells: {int(output['queue_pred'].sum()):,} | \"\n        f\"Saved: {output_path.name}\"\n    )\n    all_predictions.append(output.assign(panel=panel))\n\ncombined = pd.concat(all_predictions, ignore_index=True)\ncombined.to_csv(OUT / \"all_panels_private_predictions.csv\", index=False)\n\nprint(\"\\nValidation inference complete.\")\nprint(\"Total rows:\", f\"{len(combined):,}\")\nprint(\"Output directory:\", OUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:57:10.759814Z","iopub.execute_input":"2026-10-25T07:57:10.760245Z","iopub.status.idle":"2026-10-25T07:57:22.677126Z","shell.execute_reply.started":"2026-10-25T07:57:10.760215Z","shell.execute_reply":"2026-10-25T07:57:22.675901Z"}},"outputs":[{"name":"stdout","text":"\nPredicting validation: D7_I10_E\nRows: 8,760 | Predicted queue cells: 617 | Saved: D7_I10_E_private_predictions.csv\n\nPredicting validation: D7_I10_W\nRows: 6,420 | Predicted queue cells: 182 | Saved: D7_I10_W_private_predictions.csv\n\nPredicting validation: D7_I210_E\nRows: 17,820 | Predicted queue cells: 202 | Saved: D7_I210_E_private_predictions.csv\n\nPredicting validation: D7_I210_W\nRows: 4,860 | Predicted queue cells: 245 | Saved: D7_I210_W_private_predictions.csv\n\nPredicting validation: D7_I405_N\nRows: 21,120 | Predicted queue cells: 2,076 | Saved: D7_I405_N_private_predictions.csv\n\nPredicting validation: D7_I405_S\nRows: 6,540 | Predicted queue cells: 898 | Saved: D7_I405_S_private_predictions.csv\n\nPredicting validation: D12_I5_N\nRows: 15,480 | Predicted queue cells: 842 | Saved: D12_I5_N_private_predictions.csv\n\nPredicting validation: D12_I5_S\nRows: 6,000 | Predicted queue cells: 634 | Saved: D12_I5_S_private_predictions.csv\n\nValidation inference complete.\nTotal rows: 87,000\nOutput directory: /kaggle/working/task2_training_labels/private_predictions\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nOUT = Path(\"/kaggle/working/task2_training_labels/private_predictions\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\ntotal_rows = 0\n\nfor panel in PANELS:\n    pred = pd.read_csv(OUT / f\"{panel}_private_predictions.csv\")\n    template = pd.read_csv(\n        ROOT / \"task2\" / panel / \"private\" / \"sample_submission_queue.csv\"\n    )\n\n    assert len(pred) == len(template), f\"{panel}: row count mismatch\"\n    assert pred.columns.tolist() == template.columns.tolist(), (\n        f\"{panel}: column mismatch\"\n    )\n\n    for col in [\"window_id\", \"link_id\"]:\n        assert (\n            pred[col].astype(str).to_numpy()\n            == template[col].astype(str).to_numpy()\n        ).all(), f\"{panel}: row alignment mismatch in {col}\"\n\n    pred_ts = pd.to_datetime(pred[\"timestamp\"], utc=True, errors=\"coerce\")\n    template_ts = pd.to_datetime(template[\"timestamp\"], utc=True, errors=\"coerce\")\n\n    assert pred_ts.notna().all(), f\"{panel}: invalid prediction timestamps\"\n    assert template_ts.notna().all(), f\"{panel}: invalid template timestamps\"\n    assert (pred_ts.to_numpy() == template_ts.to_numpy()).all(), (\n        f\"{panel}: timestamp alignment mismatch\"\n    )\n\n    assert pred[\"queue_pred\"].notna().all(), f\"{panel}: missing predictions\"\n    assert pred[\"queue_pred\"].isin([0, 1]).all(), f\"{panel}: invalid labels\"\n\n    total_rows += len(pred)\n    print(\n        f\"{panel}: PASS | rows={len(pred):,} | \"\n        f\"positive predictions={int(pred['queue_pred'].sum()):,}\"\n    )\n\nprint(f\"\\nAll checks passed. Total rows: {total_rows:,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:57:42.269729Z","iopub.execute_input":"2026-10-25T07:57:42.270125Z","iopub.status.idle":"2026-10-25T07:57:42.941465Z","shell.execute_reply.started":"2026-10-25T07:57:42.270087Z","shell.execute_reply":"2026-10-25T07:57:42.940537Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: PASS | rows=8,760 | positive predictions=617\nD7_I10_W: PASS | rows=6,420 | positive predictions=182\nD7_I210_E: PASS | rows=17,820 | positive predictions=202\nD7_I210_W: PASS | rows=4,860 | positive predictions=245\nD7_I405_N: PASS | rows=21,120 | positive predictions=2,076\nD7_I405_S: PASS | rows=6,540 | positive predictions=898\nD12_I5_N: PASS | rows=15,480 | positive predictions=842\nD12_I5_S: PASS | rows=6,000 | positive predictions=634\n\nAll checks passed. Total rows: 87,000\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nVAL_OUT = BASE / \"validation_predictions\"\nPRIVATE_OUT = BASE / \"private_predictions\"\n\nSAMPLE_PATH = ROOT / \"sample_submission.csv\"\nKEY_PATH = ROOT / \"submission_key.csv\"\nOUTPUT_PATH = BASE / \"submission_task2.csv\"\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\n# 1. Load predictions from both splits.\npred_frames = []\n\nfor panel in PANELS:\n    for split, folder in [\n        (\"validation\", VAL_OUT),\n        (\"private\", PRIVATE_OUT),\n    ]:\n        path = folder / f\"{panel}_{split}_predictions.csv\"\n        pred = pd.read_csv(path)\n\n        required = {\"window_id\", \"timestamp\", \"link_id\", \"queue_pred\"}\n        assert required.issubset(pred.columns), (\n            f\"Unexpected columns in {path}: {pred.columns.tolist()}\"\n        )\n\n        pred = pred[[\"window_id\", \"timestamp\", \"link_id\", \"queue_pred\"]].copy()\n        pred[\"panel\"] = panel\n        pred[\"split\"] = split\n        pred_frames.append(pred)\n\npredictions = pd.concat(pred_frames, ignore_index=True)\n\nassert len(predictions) == 174_000, (\n    f\"Expected 174,000 predictions, got {len(predictions):,}\"\n)\nassert predictions[\"queue_pred\"].isin([0, 1]).all()\nassert predictions[\"queue_pred\"].notna().all()\n\n# 2. Normalize timestamps for reliable joins.\ndef add_timestamp_key(df):\n    df = df.copy()\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True, errors=\"coerce\")\n    assert ts.notna().all(), \"Found invalid timestamps\"\n    df[\"_timestamp_key\"] = ts.astype(\"int64\")\n    for col in [\"panel\", \"split\", \"window_id\", \"link_id\"]:\n        df[col] = df[col].astype(str)\n    return df\n\npredictions = add_timestamp_key(predictions)\n\n# 3. Read the large official key in chunks, keeping only Task 2 rows.\nkey_columns = [\n    \"submission_id\", \"task\", \"split\", \"panel\",\n    \"timestamp\", \"window_id\", \"link_id\",\n]\n\nkey_parts = []\n\nfor chunk in pd.read_csv(\n    KEY_PATH,\n    usecols=key_columns,\n    chunksize=1_000_000,\n    dtype={\n        \"task\": \"string\",\n        \"split\": \"string\",\n        \"panel\": \"string\",\n        \"timestamp\": \"string\",\n        \"window_id\": \"string\",\n        \"link_id\": \"string\",\n    },\n):\n    mask = (\n        chunk[\"task\"].eq(\"queue\")\n        & chunk[\"split\"].isin([\"validation\", \"private\"])\n        & chunk[\"panel\"].isin(PANELS)\n    )\n    if mask.any():\n        key_parts.append(chunk.loc[mask].copy())\n\nqueue_key = pd.concat(key_parts, ignore_index=True)\n\nassert not queue_key[\"submission_id\"].duplicated().any(), (\n    \"Duplicate submission IDs in Task 2 key\"\n)\n\nqueue_key = add_timestamp_key(queue_key)\n\n# 4. Map predictions to official submission IDs.\njoin_cols = [\n    \"panel\", \"split\", \"window_id\", \"link_id\", \"_timestamp_key\"\n]\n\nmapped = queue_key.merge(\n    predictions[join_cols + [\"queue_pred\"]],\n    on=join_cols,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=True,\n)\n\nunmatched = mapped[\"_merge\"].ne(\"both\").sum()\nassert unmatched == 0, f\"{unmatched:,} official queue rows lack predictions\"\nassert len(mapped) == 174_000, (\n    f\"Expected 174,000 official Task 2 rows, got {len(mapped):,}\"\n)\n\nmapped[\"submission_id\"] = pd.to_numeric(\n    mapped[\"submission_id\"], errors=\"raise\"\n).astype(\"int64\")\n\nmapped[\"queue_pred\"] = mapped[\"queue_pred\"].astype(\"int8\")\n\n# 5. Fill the official template; preserve all other values and row order.\nsubmission = pd.read_csv(SAMPLE_PATH)\n\nassert submission[\"submission_id\"].is_unique\nassert submission[\"submission_id\"].notna().all()\n\nprediction_map = mapped.set_index(\"submission_id\")[\"queue_pred\"]\n\nqueue_mask = submission[\"task\"].eq(\"queue\")\nexpected_queue_ids = set(mapped[\"submission_id\"])\ntemplate_queue_ids = set(\n    submission.loc[queue_mask, \"submission_id\"].astype(\"int64\")\n)\n\nassert expected_queue_ids.issubset(set(submission[\"submission_id\"])), (\n    \"Some mapped IDs are missing from the official template\"\n)\n\nsubmission[\"queue_pred\"] = submission[\"queue_pred\"].astype(\"int64\")\nsubmission.loc[queue_mask, \"queue_pred\"] = (\n    submission.loc[queue_mask, \"submission_id\"]\n    .map(prediction_map)\n    .fillna(submission.loc[queue_mask, \"queue_pred\"])\n    .astype(\"int64\")\n)\n\n# 6. Validate and save the unified submission.\nassert submission.columns.tolist() == [\n    \"submission_id\", \"task\", \"speed_kmh\",\n    \"flow_vph\", \"queue_pred\", \"path_flow\"\n]\nassert len(submission) > 0\nassert submission[\"submission_id\"].is_unique\nassert submission.notna().all().all()\nassert submission[\"queue_pred\"].isin([0, 1]).all()\n\n# Every mapped queue prediction must have been applied.\ncheck = submission.set_index(\"submission_id\").loc[\n    mapped[\"submission_id\"].to_numpy(), \"queue_pred\"\n].to_numpy()\n\nassert np.array_equal(check, mapped[\"queue_pred\"].to_numpy()), (\n    \"Final queue predictions do not match mapped predictions\"\n)\n\nsubmission.to_csv(OUTPUT_PATH, index=False)\n\nprint(\"FINAL SUBMISSION CREATED\")\nprint(\"Path:\", OUTPUT_PATH)\nprint(\"Total rows:\", f\"{len(submission):,}\")\nprint(\"Task 2 rows mapped:\", f\"{len(mapped):,}\")\nprint(\"Task 2 positive predictions:\", int(mapped[\"queue_pred\"].sum()))\nprint(\"Missing values:\", int(submission.isna().sum().sum()))\nprint(\"Duplicate submission IDs:\", int(submission[\"submission_id\"].duplicated().sum()))\nprint(\"File size (MB):\", round(OUTPUT_PATH.stat().st_size / (1024**2), 2))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:58:34.949504Z","iopub.execute_input":"2026-10-25T07:58:34.949854Z","iopub.status.idle":"2026-10-25T07:59:07.951222Z","shell.execute_reply.started":"2026-10-25T07:58:34.949813Z","shell.execute_reply":"2026-10-25T07:59:07.950344Z"}},"outputs":[{"name":"stdout","text":"FINAL SUBMISSION CREATED\nPath: /kaggle/working/task2_training_labels/submission_task2.csv\nTotal rows: 6,980,503\nTask 2 rows mapped: 174,000\nTask 2 positive predictions: 11878\nMissing values: 0\nDuplicate submission IDs: 0\nFile size (MB): 145.33\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nsample_path = ROOT / \"sample_submission.csv\"\noutput_path = BASE / \"submission_task2.csv\"\n\n# Read only the columns needed for structural checks.\nsub = pd.read_csv(output_path)\nsample = pd.read_csv(sample_path)\n\nassert sub.columns.tolist() == sample.columns.tolist()\nassert len(sub) == len(sample)\nassert sub[\"submission_id\"].equals(sample[\"submission_id\"])\nassert sub[\"task\"].equals(sample[\"task\"])\nassert sub.notna().all().all()\nassert sub[\"submission_id\"].is_unique\n\n# Verify all non-queue rows retain the official template values.\nnon_queue = sample[\"task\"].ne(\"queue\")\nfor col in [\"speed_kmh\", \"flow_vph\", \"queue_pred\", \"path_flow\"]:\n    assert np.array_equal(\n        sub.loc[non_queue, col].to_numpy(),\n        sample.loc[non_queue, col].to_numpy(),\n    ), f\"Unexpected changes to {col} outside Task 2 queue rows\"\n\n# Verify Task 2 predictions against the mapped per-panel files.\npred_map = {}\n\nfor split, folder in [\n    (\"validation\", BASE / \"validation_predictions\"),\n    (\"private\", BASE / \"private_predictions\"),\n]:\n    for panel in [\n        \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n        \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    ]:\n        df = pd.read_csv(folder / f\"{panel}_{split}_predictions.csv\")\n        pred_map[(panel, split)] = int(df[\"queue_pred\"].sum())\n\nqueue = sub[\"task\"].eq(\"queue\")\nassert sub.loc[queue, \"queue_pred\"].isin([0, 1]).all()\n\nprint(\"Final structural checks: PASS\")\nprint(f\"Rows: {len(sub):,}\")\nprint(f\"Queue rows: {int(queue.sum()):,}\")\nprint(f\"Queue predictions = 1: {int(sub.loc[queue, 'queue_pred'].sum()):,}\")\nprint(f\"File size: {output_path.stat().st_size / (1024**2):.2f} MB\")\nprint(\"Non-queue template values: unchanged\")\nprint(\"Output:\", output_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T07:59:32.883502Z","iopub.execute_input":"2026-10-25T07:59:32.883865Z","iopub.status.idle":"2026-10-25T07:59:41.45227Z","shell.execute_reply.started":"2026-10-25T07:59:32.883837Z","shell.execute_reply":"2026-10-25T07:59:41.451429Z"}},"outputs":[{"name":"stdout","text":"Final structural checks: PASS\nRows: 6,980,503\nQueue rows: 174,000\nQueue predictions = 1: 11,878\nFile size: 145.33 MB\nNon-queue template values: unchanged\nOutput: /kaggle/working/task2_training_labels/submission_task2.csv\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nTASK1_FILE = Path(\n    \"/kaggle/input/datasets/krupaalhn/task1-csv/submission (1).csv\"\n)\n\nprint(\"File exists:\", TASK1_FILE.exists())\nprint(\"File size (MB):\", round(TASK1_FILE.stat().st_size / 1e6, 2))\n\ndf = pd.read_csv(TASK1_FILE, nrows=5)\nprint(\"\\nColumns:\")\nprint(df.columns.tolist())\n\nprint(\"\\nFirst 5 rows:\")\ndisplay(df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T08:14:03.879613Z","iopub.execute_input":"2026-10-25T08:14:03.879994Z","iopub.status.idle":"2026-10-25T08:14:04.092224Z","shell.execute_reply.started":"2026-10-25T08:14:03.879966Z","shell.execute_reply":"2026-10-25T08:14:04.091007Z"}},"outputs":[{"name":"stdout","text":"File exists: True\nFile size (MB): 374.46\n\nColumns:\n['submission_id', 'task', 'speed_kmh', 'flow_vph', 'queue_pred', 'path_flow']\n\nFirst 5 rows:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"   submission_id   task   speed_kmh     flow_vph  queue_pred  path_flow\n0              1  state  115.554367  2404.394360           0          0\n1              2  state  115.506793  2506.686519           0          0\n2              3  state  112.666303  2497.350623           0          0\n3              4  state  115.538180  2301.011734           0          0\n4              5  state  115.681739  2429.187907           0          0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n