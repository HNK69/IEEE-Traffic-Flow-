nt":78},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\npred = pd.read_csv(BASE / \"shared_features_hybrid_oof_predictions.csv\")\n\ndef iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nthresholds = np.arange(0.20, 0.801, 0.05)\nrows = []\n\nfor threshold in thresholds:\n    pred_col = pred[\"probability\"] >= threshold\n\n    scores = []\n    for (panel, window, condition), idx in pred.groupby(\n        [\"panel\", \"window_id\", \"condition\"]\n    ).groups.items():\n        scores.append({\n            \"panel\": panel,\n            \"condition\": condition,\n            \"iou\": iou(\n                pred.loc[idx, \"queue_label\"],\n                pred_col.loc[idx]\n            )\n        })\n\n    scores = pd.DataFrame(scores)\n    rows.append({\n        \"threshold\": round(float(threshold), 2),\n        \"overall_mean_IoU\": scores[\"iou\"].mean(),\n        \"ongoing_mean_IoU\": scores.loc[\n            scores[\"condition\"] == \"queue_ongoing\", \"iou\"\n        ].mean(),\n        \"onset_mean_IoU\": scores.loc[\n            scores[\"condition\"] == \"queue_onset\", \"iou\"\n        ].mean(),\n    })\n\nthreshold_results = pd.DataFrame(rows)\nprint(threshold_results.round(4).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:45:01.880206Z","iopub.execute_input":"2026-10-24T09:45:01.880492Z","iopub.status.idle":"2026-10-24T09:45:03.359254Z","shell.execute_reply.started":"2026-10-24T09:45:01.880471Z","shell.execute_reply":"2026-10-24T09:45:03.358316Z"}},"outputs":[{"name":"stdout","text":" threshold  overall_mean_IoU  ongoing_mean_IoU  onset_mean_IoU\n      0.20            0.3980            0.7399          0.0561\n      0.25            0.4034            0.7445          0.0624\n      0.30            0.4082            0.7530          0.0634\n      0.35            0.4389            0.7616          0.1162\n      0.40            0.4407            0.7643          0.1171\n      0.45            0.4415            0.7701          0.1129\n      0.50            0.4385            0.7754          0.1017\n      0.55            0.4318            0.7744          0.0892\n      0.60            0.4293            0.7695          0.0892\n      0.65            0.4287            0.7683          0.0892\n      0.70            0.4249            0.7657          0.0842\n      0.75            0.4239            0.7666          0.0812\n      0.80            0.4246            0.7658          0.0833\n","output_type":"stream"}],"execution_count":79},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    df = pd.read_csv(BASE / f\"{panel}_train_features_spatial.csv\")\n    df = df[df[\"label_valid\"].eq(True) & df[\"queue_label\"].notna()].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n    data[panel] = df\n\n    feature_sets.append({\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    })\n\nfeatures = sorted(set.intersection(*feature_sets))\nprint(\"Using\", len(features), \"shared features\")\n\nrows = []\n\nfor weight_multiplier in [0.5, 1.0, 2.0]:\n    predictions = []\n\n    for panel in PANELS:\n        df = data[panel]\n\n        for held_out in sorted(df[\"window_id\"].unique()):\n            train = df[df[\"window_id\"] != held_out]\n            test = df[df[\"window_id\"] == held_out]\n\n            X_train = train[features].replace([np.inf, -np.inf], np.nan)\n            X_test = test[features].replace([np.inf, -np.inf], np.nan)\n            y_train = train[\"queue_label\"]\n\n            positives = int(y_train.sum())\n            negatives = len(y_train) - positives\n            base_weight = negatives / max(positives, 1)\n\n            model = lgb.LGBMClassifier(\n                n_estimators=300,\n                learning_rate=0.03,\n                num_leaves=15,\n                min_child_samples=30,\n                colsample_bytree=0.9,\n                subsample=0.9,\n                reg_lambda=2.0,\n                scale_pos_weight=base_weight * weight_multiplier,\n                random_state=42,\n                verbosity=-1,\n            )\n            model.fit(X_train, y_train)\n\n            out = test[\n                [\"window_id\", \"condition\", \"queue_label\"]\n            ].copy()\n            \n            out[\"panel\"] = panel\n            out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n            predictions.append(out)\n\n    oof = pd.concat(predictions, ignore_index=True)\n\n    for threshold in [0.35, 0.40, 0.45, 0.50]:\n        oof[\"pred\"] = oof[\"probability\"] >= threshold\n        scores = []\n\n        for (panel, window, condition), group in oof.groupby(\n            [\"panel\", \"window_id\", \"condition\"]\n        ):\n            y = group[\"queue_label\"].to_numpy().astype(bool)\n            p = group[\"pred\"].to_numpy().astype(bool)\n            union = np.logical_or(y, p).sum()\n            score = (\n                np.logical_and(y, p).sum() / union if union else 1.0\n            )\n            scores.append((condition, score))\n\n        score_df = pd.DataFrame(scores, columns=[\"condition\", \"IoU\"])\n        rows.append({\n            \"weight_multiplier\": weight_multiplier,\n            \"threshold\": threshold,\n            \"overall_mean_IoU\": score_df[\"IoU\"].mean(),\n            \"ongoing_mean_IoU\": score_df.loc[\n                score_df[\"condition\"] == \"queue_ongoing\", \"IoU\"\n            ].mean(),\n            \"onset_mean_IoU\": score_df.loc[\n                score_df[\"condition\"] == \"queue_onset\", \"IoU\"\n            ].mean(),\n        })\n\nresults = pd.DataFrame(rows)\nprint(results.round(4).to_string(index=False))\n\nresults.to_csv(BASE / \"class_weight_experiment.csv\", index=False)\nprint(\"\\nSaved:\", BASE / \"class_weight_experiment.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:47:21.482083Z","iopub.execute_input":"2026-10-24T09:47:21.482457Z","iopub.status.idle":"2026-10-24T09:49:18.237937Z","shell.execute_reply.started":"2026-10-24T09:47:21.482435Z","shell.execute_reply":"2026-10-24T09:49:18.237174Z"}},"outputs":[{"name":"stdout","text":"Using 42 shared features\n weight_multiplier  threshold  overall_mean_IoU  ongoing_mean_IoU  onset_mean_IoU\n               0.5       0.35            0.4182            0.7647          0.0717\n               0.5       0.40            0.4324            0.7682          0.0967\n               0.5       0.45            0.4295            0.7687          0.0904\n               0.5       0.50            0.4283            0.7662          0.0904\n               1.0       0.35            0.4389            0.7616          0.1162\n               1.0       0.40            0.4407            0.7643          0.1171\n               1.0       0.45            0.4415            0.7701          0.1129\n               1.0       0.50            0.4385            0.7754          0.1017\n               2.0       0.35            0.4000            0.7427          0.0573\n               2.0       0.40            0.3977            0.7498          0.0457\n               2.0       0.45            0.3991            0.7514          0.0469\n               2.0       0.50            0.4122            0.7561          0.0683\n\nSaved: /kaggle/working/task2_training_labels/class_weight_experiment.csv\n","output_type":"stream"}],"execution_count":81},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\nSPATIAL_FEATURES = {\n    \"upstream_neighbor_count\",\n    \"upstream_valid_speed_count\",\n    \"upstream_mean_speed_ratio\",\n    \"upstream_min_speed_ratio\",\n    \"upstream_slow_neighbor_fraction\",\n    \"upstream_mean_flow\",\n    \"upstream_mean_occupancy\",\n    \"downstream_neighbor_count\",\n    \"downstream_valid_speed_count\",\n    \"downstream_mean_speed_ratio\",\n    \"downstream_min_speed_ratio\",\n    \"downstream_slow_neighbor_fraction\",\n    \"downstream_mean_flow\",\n    \"downstream_mean_occupancy\",\n}\n\n# Load the same valid rows and establish a common feature set.\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(path)\n    df = df[df[\"label_valid\"].eq(True) & df[\"queue_label\"].notna()].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n    data[panel] = df\n    feature_sets.append({\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    })\n\nall_features = sorted(set.intersection(*feature_sets))\nspatial = sorted(set(all_features) & SPATIAL_FEATURES)\nnonspatial = sorted(set(all_features) - SPATIAL_FEATURES)\n\nfeature_groups = {\n    \"temporal_current\": nonspatial,\n    \"spatial_only\": spatial + ([\"horizon_step\"] if \"horizon_step\" in all_features else []),\n    \"combined\": all_features,\n}\n\nprint(\"Common features:\", len(all_features))\nprint(\"Non-spatial features:\", len(nonspatial))\nprint(\"Spatial features:\", len(spatial))\n\nassert len(spatial) > 0, \"No spatial features matched; check column names.\"\n\ndef calc_iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nsummary_rows = []\n\n# Each configuration gets the same held-out windows.\nfor group_name, features in feature_groups.items():\n    predictions = []\n\n    print(f\"\\nEvaluating {group_name}: {len(features)} features\")\n\n    for panel in PANELS:\n        df = data[panel]\n\n        for held_out in sorted(df[\"window_id\"].unique()):\n            train = df[df[\"window_id\"] != held_out]\n            test = df[df[\"window_id\"] == held_out]\n\n            X_train = train[features].replace([np.inf, -np.inf], np.nan)\n            X_test = test[features].replace([np.inf, -np.inf], np.nan)\n            y_train = train[\"queue_label\"].astype(int)\n\n            positives = int(y_train.sum())\n            negatives = len(y_train) - positives\n\n            model = lgb.LGBMClassifier(\n                n_estimators=300,\n                learning_rate=0.03,\n                num_leaves=15,\n                min_child_samples=30,\n                colsample_bytree=0.9,\n                subsample=0.9,\n                reg_lambda=2.0,\n                scale_pos_weight=negatives / max(positives, 1),\n                random_state=42,\n                verbosity=-1,\n            )\n            model.fit(X_train, y_train)\n\n            out = test[\n                [\"window_id\", \"condition\", \"queue_label\"]\n            ].copy()\n            out[\"panel\"] = panel\n            out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n            out[\"prediction\"] = out[\"probability\"] >= 0.50\n            predictions.append(out)\n\n    oof = pd.concat(predictions, ignore_index=True)\n    oof[\"feature_group\"] = group_name\n\n    for (panel, window, condition), g in oof.groupby(\n        [\"panel\", \"window_id\", \"condition\"], sort=True\n    ):\n        summary_rows.append({\n            \"feature_group\": group_name,\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"IoU\": calc_iou(g[\"queue_label\"], g[\"prediction\"]),\n        })\n\n    print(\"Completed all panels.\")\n\nresults = pd.DataFrame(summary_rows)\n\nprint(\"\\n=== OVERALL FEATURE ABLATION ===\")\noverall = results.groupby(\"feature_group\")[\"IoU\"].mean().sort_values(\n    ascending=False\n)\nprint(overall.round(4).to_string())\n\nprint(\"\\n=== BY FEATURE GROUP AND CONDITION ===\")\nprint(\n    results.groupby([\"feature_group\", \"condition\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nprint(\"\\n=== BY PANEL ===\")\nprint(\n    results.groupby([\"panel\", \"feature_group\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nresults.to_csv(BASE / \"feature_ablation_results.csv\", index=False)\nprint(\"\\nSaved:\", BASE / \"feature_ablation_results.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:52:19.36868Z","iopub.execute_input":"2026-10-24T09:52:19.369035Z","iopub.status.idle":"2026-10-24T09:53:44.697078Z","shell.execute_reply.started":"2026-10-24T09:52:19.369007Z","shell.execute_reply":"2026-10-24T09:53:44.695769Z"}},"outputs":[{"name":"stdout","text":"Common features: 42\nNon-spatial features: 28\nSpatial features: 14\n\nEvaluating temporal_current: 28 features\nCompleted all panels.\n\nEvaluating spatial_only: 15 features\nCompleted all panels.\n\nEvaluating combined: 42 features\nCompleted all panels.\n\n=== OVERALL FEATURE ABLATION ===\nfeature_group\ncombined            0.4385\ntemporal_current    0.4153\nspatial_only        0.2161\n\n=== BY FEATURE GROUP AND CONDITION ===\ncondition         queue_ongoing  queue_onset\nfeature_group                               \ncombined                 0.7754       0.1017\nspatial_only             0.4245       0.0078\ntemporal_current         0.7687       0.0619\n\n=== BY PANEL ===\nfeature_group  combined  spatial_only  temporal_current\npanel                                                  \nD12_I5_N         0.3620        0.3164            0.3646\nD12_I5_S         0.4228        0.1000            0.4208\nD7_I10_E         0.3761        0.2981            0.3873\nD7_I10_W         0.5613        0.1409            0.4672\nD7_I210_E        0.4378        0.2375            0.4086\nD7_I210_W        0.4567        0.1205            0.4024\nD7_I405_N        0.4587        0.4228            0.4390\nD7_I405_S        0.4327        0.0927            0.4327\n\nSaved: /kaggle/working/task2_training_labels/feature_ablation_results.csv\n","output_type":"stream"}],"execution_count":82},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    df = pd.read_csv(BASE / f\"{panel}_train_features_spatial.csv\")\n    df = df[df[\"label_valid\"].eq(True) & df[\"queue_label\"].notna()].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n    data[panel] = df\n\n    feature_sets.append({\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    })\n\nfeatures = sorted(set.intersection(*feature_sets))\nassert len(features) == 42, f\"Expected 42 shared features, found {len(features)}\"\nprint(\"Using\", len(features), \"shared features\")\n\ndef calc_iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nsummary_rows = []\n\nfor leaves in [7, 15, 31]:\n    predictions = []\n    print(f\"\\nTesting num_leaves={leaves}\")\n\n    for panel in PANELS:\n        df = data[panel]\n\n        for held_out in sorted(df[\"window_id\"].unique()):\n            train = df[df[\"window_id\"] != held_out]\n            test = df[df[\"window_id\"] == held_out]\n\n            X_train = train[features].replace([np.inf, -np.inf], np.nan)\n            X_test = test[features].replace([np.inf, -np.inf], np.nan)\n            y_train = train[\"queue_label\"]\n\n            positives = int(y_train.sum())\n            negatives = len(y_train) - positives\n\n            model = lgb.LGBMClassifier(\n                n_estimators=300,\n                learning_rate=0.03,\n                num_leaves=leaves,\n                min_child_samples=30,\n                colsample_bytree=0.9,\n                subsample=0.9,\n                reg_lambda=2.0,\n                scale_pos_weight=negatives / max(positives, 1),\n                random_state=42,\n                verbosity=-1,\n            )\n            model.fit(X_train, y_train)\n\n            out = test[\n                [\"window_id\", \"condition\", \"queue_label\"]\n            ].copy()\n            out[\"panel\"] = panel\n            out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n            out[\"prediction\"] = out[\"probability\"] >= 0.50\n            predictions.append(out)\n\n    oof = pd.concat(predictions, ignore_index=True)\n\n    for (panel, window, condition), group in oof.groupby(\n        [\"panel\", \"window_id\", \"condition\"], sort=True\n    ):\n        summary_rows.append({\n            \"num_leaves\": leaves,\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"IoU\": calc_iou(group[\"queue_label\"], group[\"prediction\"]),\n        })\n\n    print(\"Completed all panels.\")\n\nresults = pd.DataFrame(summary_rows)\n\nprint(\"\\n=== OVERALL MEAN IoU ===\")\nprint(\n    results.groupby(\"num_leaves\")[\"IoU\"]\n    .mean().round(4).to_string()\n)\n\nprint(\"\\n=== BY TREE COMPLEXITY AND CONDITION ===\")\nprint(\n    results.groupby([\"num_leaves\", \"condition\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nprint(\"\\n=== BY PANEL ===\")\nprint(\n    results.groupby([\"panel\", \"num_leaves\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nresults.to_csv(BASE / \"tree_complexity_results.csv\", index=False)\nprint(\"\\nSaved:\", BASE / \"tree_complexity_results.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:54:57.896176Z","iopub.execute_input":"2026-10-24T09:54:57.896459Z","iopub.status.idle":"2026-10-24T09:56:54.359285Z","shell.execute_reply.started":"2026-10-24T09:54:57.896438Z","shell.execute_reply":"2026-10-24T09:56:54.358436Z"}},"outputs":[{"name":"stdout","text":"Using 42 shared features\n\nTesting num_leaves=7\nCompleted all panels.\n\nTesting num_leaves=15\nCompleted all panels.\n\nTesting num_leaves=31\nCompleted all panels.\n\n=== OVERALL MEAN IoU ===\nnum_leaves\n7     0.4278\n15    0.4385\n31    0.4286\n\n=== BY TREE COMPLEXITY AND CONDITION ===\ncondition   queue_ongoing  queue_onset\nnum_leaves                            \n7                  0.7580       0.0976\n15                 0.7754       0.1017\n31                 0.7689       0.0883\n\n=== BY PANEL ===\nnum_leaves      7       15      31\npanel                             \nD12_I5_N    0.3623  0.3620  0.3611\nD12_I5_S    0.3187  0.4228  0.4201\nD7_I10_E    0.3769  0.3761  0.3711\nD7_I10_W    0.5668  0.5613  0.5613\nD7_I210_E   0.4622  0.4378  0.4378\nD7_I210_W   0.4533  0.4567  0.4065\nD7_I405_N   0.4617  0.4587  0.4750\nD7_I405_S   0.4204  0.4327  0.3961\n\nSaved: /kaggle/working/task2_training_labels/tree_complexity_results.csv\n","output_type":"stream"}],"execution_count":83},{"cell_type":"code","source":"\n# Repair panel values in the saved baseline predictions.\nbaseline = pd.read_csv(\n    BASE / \"shared_features_hybrid_oof_predictions.csv\"\n)\n\nmissing_panel = baseline[\"panel\"].isna()\nbaseline.loc[missing_panel, \"panel\"] = (\n    baseline.loc[missing_panel, \"window_id\"]\n    .str.extract(r\"Q\\d+_(.+?)_train_\")[0]\n)\n\nprint(\"Missing panel values after repair:\", baseline[\"panel\"].isna().sum())\nprint(\"Panel counts:\")\nprint(baseline[\"panel\"].value_counts().to_string())\n\nkeys = [\n    \"panel\", \"window_id\", \"condition\",\n    \"link_id\", \"horizon_step\", \"queue_label\"\n]\n\nbaseline = baseline[keys + [\"probability\"]].rename(\n    columns={\"probability\": \"baseline_probability\"}\n)\n\nassert not baseline.duplicated(keys).any()\nassert not specialized.duplicated(keys).any()\n\ncomparison = specialized.merge(\n    baseline,\n    on=keys,\n    how=\"inner\",\n    validate=\"one_to_one\",\n)\n\nprint(\"\\nMatched rows:\", len(comparison))\nprint(\"Specialized rows:\", len(specialized))\nassert len(comparison) == len(specialized), \"Rows still do not fully match.\"\n\ncomparison[\"baseline_pred\"] = comparison[\"baseline_probability\"] >= 0.50\n\nrows = []\nfor (panel, window, condition), group in comparison.groupby(\n    [\"panel\", \"window_id\", \"condition\"], sort=True\n):\n    rows.append({\n        \"panel\": panel,\n        \"window_id\": window,\n        \"condition\": condition,\n        \"baseline_IoU\": calc_iou(\n            group[\"queue_label\"], group[\"baseline_pred\"]\n        ),\n        \"specialized_IoU\": calc_iou(\n            group[\"queue_label\"], group[\"specialized_pred\"]\n        ),\n    })\n\nresults = pd.DataFrame(rows)\n\nprint(\"\\n=== OVERALL MEAN IoU ===\")\nprint(\"Single model:\", round(results[\"baseline_IoU\"].mean(), 4))\nprint(\"Specialized:\", round(results[\"specialized_IoU\"].mean(), 4))\n\nprint(\"\\n=== BY CONDITION ===\")\nprint(\n    results.groupby(\"condition\")[\n        [\"baseline_IoU\", \"specialized_IoU\"]\n    ].mean().round(4).to_string()\n)\n\nprint(\"\\n=== BY PANEL AND CONDITION ===\")\nprint(\n    results.groupby([\"panel\", \"condition\"])[\n        [\"baseline_IoU\", \"specialized_IoU\"]\n    ].mean().round(4).to_string()\n)\n\ncomparison.to_csv(\n    BASE / \"condition_specific_oof_predictions.csv\", index=False\n)\nresults.to_csv(\n    BASE / \"condition_specific_oof_summary.csv\", index=False\n)\n\nprint(\"\\nSaved corrected comparison.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:04:55.948418Z","iopub.execute_input":"2026-10-24T10:04:55.948723Z","iopub.status.idle":"2026-10-24T10:04:56.435843Z","shell.execute_reply.started":"2026-10-24T10:04:55.948698Z","shell.execute_reply":"2026-10-24T10:04:56.434862Z"}},"outputs":[{"name":"stdout","text":"Missing panel values after repair: 0\nPanel counts:\npanel\nD7_I405_N    13325\nD7_I210_E    11421\nD12_I5_N      9882\nD7_I10_E      5533\nD7_I10_W      4149\nD7_I405_S     4144\nD12_I5_S      3840\nD7_I210_W     3068\n\nMatched rows: 55362\nSpecialized rows: 55362\n\n=== OVERALL MEAN IoU ===\nSingle model: 0.4385\nSpecialized: 0.4412\n\n=== BY CONDITION ===\n               baseline_IoU  specialized_IoU\ncondition                                   \nqueue_ongoing        0.7754           0.7782\nqueue_onset          0.1017           0.1042\n\n=== BY PANEL AND CONDITION ===\n                         baseline_IoU  specialized_IoU\npanel     condition                                   \nD12_I5_N  queue_ongoing        0.7240           0.7331\n          queue_onset          0.0000           0.0000\nD12_I5_S  queue_ongoing        0.6456           0.6394\n          queue_onset          0.2000           0.0000\nD7_I10_E  queue_ongoing        0.7522           0.7585\n          queue_onset          0.0000           0.0000\nD7_I10_W  queue_ongoing        0.7226           0.7814\n          queue_onset          0.4000           0.4000\nD7_I210_E queue_ongoing        0.8355           0.8733\n          queue_onset          0.0400           0.2050\nD7_I210_W queue_ongoing        0.8134           0.8205\n          queue_onset          0.1000           0.1286\nD7_I405_N queue_ongoing        0.8775           0.8779\n          queue_onset          0.0400           0.1000\nD7_I405_S queue_ongoing        0.8321           0.7414\n          queue_onset          0.0333           0.0000\n\nSaved corrected comparison.\n","output_type":"stream"}],"execution_count":89},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\npred = pd.read_csv(\n    BASE / \"shared_features_hybrid_oof_predictions.csv\"\n)\n\ndef calc_iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\n# Search thresholds independently for the two conditions.\nthresholds = np.round(np.arange(0.20, 0.801, 0.05), 2)\nrows = []\n\nfor ongoing_threshold in thresholds:\n    for onset_threshold in thresholds:\n        pred[\"tuned_pred\"] = np.where(\n            pred[\"condition\"].eq(\"queue_onset\"),\n            pred[\"probability\"] >= onset_threshold,\n            pred[\"probability\"] >= ongoing_threshold,\n        )\n\n        scores = []\n        for (panel, window, condition), group in pred.groupby(\n            [\"panel\", \"window_id\", \"condition\"], sort=True\n        ):\n            scores.append({\n                \"panel\": panel,\n                \"condition\": condition,\n                \"IoU\": calc_iou(\n                    group[\"queue_label\"], group[\"tuned_pred\"]\n                ),\n            })\n\n        score_df = pd.DataFrame(scores)\n        rows.append({\n            \"ongoing_threshold\": ongoing_threshold,\n            \"onset_threshold\": onset_threshold,\n            \"overall_mean_IoU\": score_df[\"IoU\"].mean(),\n            \"ongoing_mean_IoU\": score_df.loc[\n                score_df[\"condition\"] == \"queue_ongoing\", \"IoU\"\n            ].mean(),\n            \"onset_mean_IoU\": score_df.loc[\n                score_df[\"condition\"] == \"queue_onset\", \"IoU\"\n            ].mean(),\n        })\n\nresults = pd.DataFrame(rows)\n\nprint(\"=== TOP 15 THRESHOLD COMBINATIONS BY OVERALL IoU ===\")\nprint(\n    results.sort_values(\"overall_mean_IoU\", ascending=False)\n    .head(15).round(4).to_string(index=False)\n)\n\nprint(\"\\n=== TOP 10 BY ONSET IoU ===\")\nprint(\n    results.sort_values(\"onset_mean_IoU\", ascending=False)\n    .head(10).round(4).to_string(index=False)\n)\n\nresults.to_csv(\n    BASE / \"condition_threshold_grid.csv\", index=False\n)\nprint(\"\\nSaved:\", BASE / \"condition_threshold_grid.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:05:02.89792Z","iopub.execute_input":"2026-10-24T10:05:02.898219Z","iopub.status.idle":"2026-10-24T10:05:06.939111Z","shell.execute_reply.started":"2026-10-24T10:05:02.898198Z","shell.execute_reply":"2026-10-24T10:05:06.93818Z"}},"outputs":[{"name":"stdout","text":"=== TOP 15 THRESHOLD COMBINATIONS BY OVERALL IoU ===\n ongoing_threshold  onset_threshold  overall_mean_IoU  ongoing_mean_IoU  onset_mean_IoU\n              0.50             0.40            0.4562            0.7787          0.1338\n              0.55             0.40            0.4561            0.7785          0.1338\n              0.50             0.35            0.4558            0.7787          0.1329\n              0.55             0.35            0.4557            0.7785          0.1329\n              0.45             0.40            0.4550            0.7763          0.1338\n              0.45             0.35            0.4546            0.7763          0.1329\n              0.50             0.45            0.4539            0.7787          0.1290\n              0.55             0.45            0.4538            0.7785          0.1290\n              0.60             0.40            0.4528            0.7718          0.1338\n              0.45             0.45            0.4527            0.7763          0.1290\n              0.35             0.40            0.4524            0.7709          0.1338\n              0.40             0.40            0.4523            0.7709          0.1338\n              0.60             0.35            0.4523            0.7718          0.1329\n              0.65             0.40            0.4520            0.7702          0.1338\n              0.35             0.35            0.4519            0.7709          0.1329\n\n=== TOP 10 BY ONSET IoU ===\n ongoing_threshold  onset_threshold  overall_mean_IoU  ongoing_mean_IoU  onset_mean_IoU\n              0.20              0.4            0.4432            0.7525          0.1338\n              0.30              0.4            0.4487            0.7635          0.1338\n              0.25              0.4            0.4449            0.7560          0.1338\n              0.70              0.4            0.4505            0.7672          0.1338\n              0.55              0.4            0.4561            0.7785          0.1338\n              0.50              0.4            0.4562            0.7787          0.1338\n              0.45              0.4            0.4550            0.7763          0.1338\n              0.40              0.4            0.4523            0.7709          0.1338\n              0.35              0.4            0.4524            0.7709          0.1338\n              0.60              0.4            0.4528            0.7718          0.1338\n\nSaved: /kaggle/working/task2_training_labels/condition_threshold_grid.csv\n","output_type":"stream"}],"execution_count":90},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npred = pd.read_csv(\n    BASE / \"shared_features_hybrid_oof_predictions.csv\"\n)\n\n# Repair missing panel identifiers in the saved OOF file, if necessary.\nmissing = pred[\"panel\"].isna()\npred.loc[missing, \"panel\"] = (\n    pred.loc[missing, \"window_id\"]\n    .str.extract(r\"Q\\d+_(.+?)_train_\")[0]\n)\n\nrequired = {\n    \"panel\", \"window_id\", \"condition\",\n    \"queue_label\", \"probability\"\n}\nassert required.issubset(pred.columns), (\n    f\"Missing columns: {required - set(pred.columns)}\"\n)\nassert pred[\"panel\"].notna().all()\nassert pred[\"probability\"].notna().all()\n\ndef calc_iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nthresholds = np.round(np.arange(0.20, 0.801, 0.05), 2)\nwindow_keys = [\"panel\", \"window_id\"]\n\n# Each outer fold holds out one complete panel-window.\ngroups = {\n    key: group.copy()\n    for key, group in pred.groupby(window_keys, sort=True)\n}\n\nouter_scores = []\nchosen_thresholds = []\n\nfor fold_num, (held_key, held) in enumerate(groups.items(), start=1):\n    # Thresholds are selected using labels from all OTHER panel-windows.\n    inner_parts = [\n        group for key, group in groups.items()\n        if key != held_key\n    ]\n    inner = pd.concat(inner_parts, ignore_index=True)\n\n    best_score = -1.0\n    best_pair = None\n\n    # Select a shared threshold pair using inner OOF predictions only.\n    for ongoing_t in thresholds:\n        for onset_t in thresholds:\n            inner_pred = np.where(\n                inner[\"condition\"].eq(\"queue_onset\"),\n                inner[\"probability\"].to_numpy() >= onset_t,\n                inner[\"probability\"].to_numpy() >= ongoing_t,\n            )\n\n            tmp = inner[\n                [\"panel\", \"window_id\", \"condition\", \"queue_label\"]\n            ].copy()\n            tmp[\"pred\"] = inner_pred\n\n            scores = []\n            for _, g in tmp.groupby(\n                [\"panel\", \"window_id\", \"condition\"], sort=False\n            ):\n                scores.append(\n                    calc_iou(g[\"queue_label\"], g[\"pred\"])\n                )\n\n            score = float(np.mean(scores))\n\n            if score > best_score:\n                best_score = score\n                best_pair = (float(ongoing_t), float(onset_t))\n\n    ongoing_t, onset_t = best_pair\n\n    # Apply selected thresholds only to this outer held-out window.\n    held = held.copy()\n    held[\"nested_pred\"] = np.where(\n        held[\"condition\"].eq(\"queue_onset\"),\n        held[\"probability\"] >= onset_t,\n        held[\"probability\"] >= ongoing_t,\n    )\n\n    for condition, g in held.groupby(\"condition\"):\n        baseline_pred = g[\"probability\"] >= 0.50\n\n        outer_scores.append({\n            \"panel\": held_key[0],\n            \"window_id\": held_key[1],\n            \"condition\": condition,\n            \"baseline_IoU\": calc_iou(\n                g[\"queue_label\"], baseline_pred\n            ),\n            \"nested_threshold_IoU\": calc_iou(\n                g[\"queue_label\"], g[\"nested_pred\"]\n            ),\n        })\n\n    chosen_thresholds.append({\n        \"panel\": held_key[0],\n        \"window_id\": held_key[1],\n        \"ongoing_threshold\": ongoing_t,\n        \"onset_threshold\": onset_t,\n        \"inner_mean_IoU\": best_score,\n    })\n\n    if fold_num % 10 == 0:\n        print(f\"Completed {fold_num}/{len(groups)} outer folds\")\n\nresults = pd.DataFrame(outer_scores)\nthreshold_log = pd.DataFrame(chosen_thresholds)\n\nprint(\"\\n=== NESTED VALIDATION: OVERALL ===\")\nprint(\n    \"Fixed threshold 0.50:\",\n    round(results[\"baseline_IoU\"].mean(), 4)\n)\nprint(\n    \"Nested thresholds:\",\n    round(results[\"nested_threshold_IoU\"].mean(), 4)\n)\n\nprint(\"\\n=== BY CONDITION ===\")\nprint(\n    results.groupby(\"condition\")[\n        [\"baseline_IoU\", \"nested_threshold_IoU\"]\n    ].mean().round(4).to_string()\n)\n\nprint(\"\\n=== BY PANEL ===\")\nprint(\n    results.groupby(\"panel\")[\n        [\"baseline_IoU\", \"nested_threshold_IoU\"]\n    ].mean().round(4).to_string()\n)\n\nprint(\"\\n=== SELECTED THRESHOLD FREQUENCIES ===\")\nprint(\n    threshold_log.groupby(\n        [\"ongoing_threshold\", \"onset_threshold\"]\n    ).size().sort_values(ascending=False).head(15).to_string()\n)\n\nresults.to_csv(BASE / \"nested_threshold_validation.csv\", index=False)\nthreshold_log.to_csv(BASE / \"nested_threshold_choices.csv\", index=False)\n\nprint(\"\\nSaved nested validation results in:\", BASE)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:06:23.185871Z","iopub.execute_input":"2026-10-24T10:06:23.18622Z","iopub.status.idle":"2026-10-24T10:11:56.02393Z","shell.execute_reply.started":"2026-10-24T10:06:23.186198Z","shell.execute_reply":"2026-10-24T10:11:56.023279Z"}},"outputs":[{"name":"stdout","text":"Completed 10/80 outer folds\nCompleted 20/80 outer folds\nCompleted 30/80 outer folds\nCompleted 40/80 outer folds\nCompleted 70/80 outer folds\nCompleted 80/80 outer folds\n\n=== NESTED VALIDATION: OVERALL ===\nFixed threshold 0.50: 0.4385\nNested thresholds: 0.4453\n\n=== BY CONDITION ===\n               baseline_IoU  nested_threshold_IoU\ncondition                                        \nqueue_ongoing        0.7754                0.7743\nqueue_onset          0.1017                0.1162\n\n=== BY PANEL ===\n           baseline_IoU  nested_threshold_IoU\npanel                                        \nD12_I5_N         0.3620                0.3620\nD12_I5_S         0.4228                0.4228\nD7_I10_E         0.3761                0.3718\nD7_I10_W         0.5613                0.5613\nD7_I210_E        0.4378                0.4828\nD7_I210_W        0.4567                0.4567\nD7_I405_N        0.4587                0.4554\nD7_I405_S        0.4327                0.4494\n\n=== SELECTED THRESHOLD FREQUENCIES ===\nongoing_threshold  onset_threshold\n0.50               0.40               78\n                   0.35                1\n0.55               0.40                1\n\nSaved nested validation results in: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":91},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\ntemporal_candidates = [\n    \"speed_ratio_latest\",\n    \"speed_ratio_first\",\n    \"speed_ratio_change\",\n    \"speed_ratio_recent_change\",\n    \"speed_ratio_overall_change\",\n    \"speed_ratio_recent_vs_long\",\n    \"flow_ratio_latest\",\n    \"flow_ratio_recent_vs_long\",\n    \"occupancy_latest\",\n    \"occupancy_recent_vs_long\",\n    \"speed_variability_recent\",\n    \"speed_variability_long\",\n    \"speed_variability_change\",\n    \"last3_speed_ratio_mean\",\n    \"last6_speed_ratio_mean\",\n    \"last3_speed_ratio_std\",\n    \"last6_speed_ratio_std\",\n    \"last3_flow_ratio_mean\",\n    \"last6_flow_ratio_mean\",\n    \"last3_occupancy_mean\",\n    \"last6_occupancy_mean\",\n    \"last3_pct_observed_mean\",\n    \"last6_pct_observed_mean\",\n]\n\nfor panel in panels:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(path, nrows=5)\n    available = [c for c in temporal_candidates if c in df.columns]\n    missing = [c for c in temporal_candidates if c not in df.columns]\n\n    print(f\"\\n{panel}\")\n    print(\"Available:\", available)\n    if missing:\n        print(\"Missing:\", missing)\n\nprint(\"\\nInspection complete. No models were trained.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:23:37.308988Z","iopub.execute_input":"2026-10-24T10:23:37.30928Z","iopub.status.idle":"2026-10-24T10:23:37.339927Z","shell.execute_reply.started":"2026-10-24T10:23:37.309257Z","shell.execute_reply":"2026-10-24T10:23:37.339169Z"}},"outputs":[{"name":"stdout","text":"\nD7_I10_E\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD7_I10_W\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD7_I210_E\nAvailable: ['speed_ratio_latest