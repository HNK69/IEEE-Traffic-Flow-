\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ndf = pd.read_csv(base / \"D7_I10_E_train_features_spatial.csv\")\n\ndf = df[\n    df[\"label_valid\"].astype(bool) & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude and pd.api.types.is_numeric_dtype(df[c])\n]\n\nid_cols = [\n    c for c in [\"window_id\", \"panel\", \"condition\", \"link_id\",\n                \"horizon_step\", \"timestamp\", \"queue_label\"]\n    if c in df.columns\n]\n\npredictions = []\n\nfor wid in sorted(df[\"window_id\"].unique()):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    Xva = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].astype(int)\n\n    positives = max(int(ytr.sum()), 1)\n    negatives = len(ytr) - int(ytr.sum())\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / positives,\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(Xtr, ytr)\n\n    out = va[id_cols].copy()\n    out[\"probability\"] = model.predict_proba(Xva)[:, 1]\n    predictions.append(out)\n\noof_identified = pd.concat(predictions, ignore_index=True)\nsave_path = base / \"D7_I10_E_spatial_oof_identified.csv\"\noof_identified.to_csv(save_path, index=False)\n\nprint(\"Saved:\", save_path)\nprint(\"Rows:\", len(oof_identified))\nprint(\"Unique window-link-horizon keys:\",\n      oof_identified[[\"window_id\", \"link_id\", \"horizon_step\"]]\n      .drop_duplicates().shape[0])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:10:22.109331Z","iopub.execute_input":"2026-10-24T09:10:22.110673Z","iopub.status.idle":"2026-10-24T09:10:27.309462Z","shell.execute_reply.started":"2026-10-24T09:10:22.110616Z","shell.execute_reply":"2026-10-24T09:10:27.308685Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/task2_training_labels/D7_I10_E_spatial_oof_identified.csv\nRows: 5533\nUnique window-link-horizon keys: 5533\n","output_type":"stream"}],"execution_count":57},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\noof = pd.read_csv(base / \"D7_I10_E_spatial_oof_identified.csv\")\n\nonset = oof[oof[\"condition\"] == \"queue_onset\"].copy()\nonset[\"predicted\"] = onset[\"probability\"] >= 0.5\n\nprint(\"True queued cells in onset windows:\")\nprint(\n    onset[onset[\"queue_label\"] == 1][\n        [\"window_id\", \"link_id\", \"horizon_step\",\n         \"timestamp\", \"queue_label\", \"probability\", \"predicted\"]\n    ]\n    .sort_values([\"window_id\", \"horizon_step\", \"link_id\"])\n    .to_string(index=False)\n)\n\nprint(\"\\nOnset IoU by window at threshold 0.5:\")\nfor wid, group in onset.groupby(\"window_id\"):\n    y = group[\"queue_label\"].astype(bool)\n    pred = group[\"predicted\"]\n    union = (y | pred).sum()\n    iou = (y & pred).sum() / union if union else 1.0\n    print(f\"{wid}: IoU={iou:.4f}, true={y.sum()}, predicted={pred.sum()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:18:50.493998Z","iopub.execute_input":"2026-10-24T09:18:50.49432Z","iopub.status.idle":"2026-10-24T09:18:50.524499Z","shell.execute_reply.started":"2026-10-24T09:18:50.494297Z","shell.execute_repl