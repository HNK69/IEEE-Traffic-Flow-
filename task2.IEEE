UBMISSION = Path(\n    \"/kaggle/input/datasets/krupaalhn/task1-csv/submission (1).csv\"\n)\nOUT = Path(\"/kaggle/working/task1_validation_for_physics.csv\")\n\n# Read only the submission IDs and values for state rows\nstate_parts = []\n\nfor chunk in pd.read_csv(\n    SUBMISSION,\n    chunksize=500_000,\n    usecols=[\"submission_id\", \"task\", \"speed_kmh\", \"flow_vph\"],\n):\n    state = chunk.loc[chunk[\"task\"] == \"state\",\n                      [\"submission_id\", \"speed_kmh\", \"flow_vph\"]]\n    if not state.empty:\n        state_parts.append(state)\n\nstate_predictions = pd.concat(state_parts, ignore_index=True)\nstate_predictions[\"submission_id\"] = state_predictions[\"submission_id\"].astype(\"int64\")\n\nprint(\"State predictions loaded:\", f\"{len(state_predictions):,}\")\n\n# Match them to the official key and keep validation state rows\nkey_path = ROOT / \"submission_key.csv\"\nfirst = True\nwritten = 0\n\nfor chunk in pd.read_csv(key_path, chunksize=500_000):\n    mask = (chunk[\"task\"] == \"state\") & (chunk[\"split\"] == \"validation\")\n    if not mask.any():\n        continue\n\n    keys = chunk.loc[mask, [\n        \"submission_id\", \"panel\", \"timestamp\",\n        \"station_id\", \"link_id\", \"mask_regime\"\n    ]]\n\n    merged = keys.merge(\n        state_predictions,\n        on=\"submission_id\",\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    if merged[[\"speed_kmh\", \"flow_vph\"]].isna().any().any():\n        raise ValueError(\"Missing predictions after joining submission IDs.\")\n\n    merged = merged[[\n        \"panel\", \"timestamp\", \"station_id\",\n        \"link_id\", \"mask_regime\", \"speed_kmh\", \"flow_vph\"\n    ]]\n\n    merged.to_csv(\n        OUT, mode=\"w\" if first else \"a\",\n        header=first, index=False\n    )\n    first = False\n    written += len(merged)\n\nprint(\"Created:\", OUT)\nprint(\"Validation state rows:\", f\"{written:,}\")\nprint(\"File size (MB):\", round(OUT.stat().st_size / 1e6, 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T09:08:23.863054Z","iopub.execute_input":"2026-10-25T09:08:23.863388Z","iopub.status.idle":"2026-10-25T09:09:53.229374Z","shell.execute_reply.started":"2026-10-25T09:08:23.863361Z","shell.execute_reply":"2026-10-25T09:09:53.228528Z"}},"outputs":[{"name":"stdout","text":"State predictions loaded: 6,735,795\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_49/887463879.py:35: DtypeWarning: Columns (4,5,6,9,11,12) have mixed types. Specify dtype option on import or set low_memory=False.\n  for chunk in pd.read_csv(key_path, chunksize=500_000):\n","output_type":"stream"},{"name":"stdout","text":"Created: /kaggle/working/task1_validation_for_physics.csv\nValidation state rows: 3,451,376\nFile size (MB): 340.17\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"from pathlib import Path\nimport subprocess\n\nREPO = Path(\"/kaggle/working/trafficflowbench-public\")\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nSTATE_FILE = Path(\"/kaggle/working/task1_validation_for_physics.csv\")\n\ncmd = [\n    \"python\", str(REPO / \"src/task3/score_task3.py\"),\n    \"--state-submission\", str(STATE_FILE),\n    \"--split\", \"validation\",\n    \"--release-root\", str(ROOT),\n    \"--modes-config\", str(REPO / \"config/task3_lwr_modes.json\"),\n    \"--panel\", \"D7_I10_E\",\n    \"--output\", \"/kaggle/working/task3_smoke_test.csv\",\n]\n\nresult = subprocess.run(cmd, capture_output=True, text=True)\n\nprint(\"Return code:\", result.returncode)\nprint(\"\\nSTDOUT:\\n\", result.stdout[-8000:])\nprint(\"\\nSTDERR:\\n\", result.stderr[-5000:])\n\nout = Path(\"/kaggle/working/task3_smoke_test.csv\")\nif result.returncode == 0 and out.exists():\n    print(\"\\nOutput preview:\")\n    print(pd.read_csv(out).head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T09:17:35