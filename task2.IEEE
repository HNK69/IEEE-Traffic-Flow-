n\nrows = []\n\nfor threshold in np.arange(0.05, 0.81, 0.05):\n    window_ious = []\n\n    for _, group in oof.groupby(\"window_id\"):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = group[\"probability\"].to_numpy() >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n\n        window_ious.append(intersection / union if union else 1.0)\n\n    rows.append({\n        \"threshold\": round(threshold, 2),\n        \"mean_IoU\": np.mean(window_ious),\n        \"onset_IoU\": np.mean([\n            window_ious[i]\n            for i, (_, g) in enumerate(oof.groupby(\"window_id\"))\n            if g[\"condition\"].iloc[0] == \"queue_onset\"\n        ]),\n        \"ongoing_IoU\": np.mean([\n            window_ious[i]\n            for i, (_, g) in enumerate(oof.groupby(\"window_id\"))\n            if g[\"condition\"].iloc[0] == \"queue_ongoing\"\n        ]),\n    })\n\nprint(pd.DataFrame(rows).round(4).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:07:33.862197Z","iopub.execute_input":"2026-10-24T09:07:33.862468Z","iopub.status.idle":"2026-10-24T09:07:33.942739Z","shell.execute_reply.started":"2026-10-24T09:07:33.862447Z","shell.execute_reply":"2026-10-24T09:07:33.941941Z"}},"outputs":[{"name":"stdout","text":" threshold  mean_IoU  onset_IoU  ongoing_IoU\n      0.05    0.2849      0.031       0.5389\n      0.10    0.2975      0.000       0.5951\n      0.15    0.3113      0.000       0.6226\n      0.20    0.3228      0.000       0.6456\n      0.25    0.3360      0.000       0.6720\n      0.30    0.3431      0.000       0.6862\n      0.35    0.3555      0.000       0.7110\n      0.40    0.3640      0.000       0.7279\n      0.45    0.3777      0.000       0.7553\n      0.50    0.3837      0.000       0.7674\n      0.55    0.3849      0.000       0.7698\n      0.60    0.3874      0.000       0.7749\n      0.65    0.3879      0.000       0.7757\n      0.70    0.38