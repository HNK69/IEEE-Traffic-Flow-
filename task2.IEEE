going          109               121      0.7969\nQ2_D7_I10_E_train_008 queue_ongoing           69                31      0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354      0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                28      0.7097\n\nMean per-window IoU @ 0.5: 0.3661\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7100\nqueue_onset      0.0222\nName: IoU_at_0.5, dtype: float64\n\nSaved OOF predictions to D7_I10_E_lightgbm_oof.csv\n","output_type":"stream"}],"execution_count":37},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nbase = \"/kaggle/working/task2_training_labels/\"\n\nfeatures = pd.read_csv(base + \"D7_I10_E_train_features.csv\")\noof = pd.read_csv(base + \"D7_I10_E_lightgbm_oof.csv\")\n\nonset_ids = [\n    f\"Q2_D7_I10_E_train_{i:03d}\"\n    for i in range(1, 6)\n]\n\n# Look at the features of the rare positive onset cells.\nonset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n    & (features[\"queue_label\"] == 1)\n].copy()\n\nprint(\"Valid onset queue cells:\", len(onset))\n\n# Show which predictors are available and compare positive-cell\n# values against all valid onset cells.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nnumeric_features = [\n    c for c in features.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(features[c])\n]\n\nall_onset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n].copy()\n\nsummary = pd.DataFrame({\n    \"queue_cells_mean\": onset[numeric_features].mean(),\n    \"nonqueue_cells_mean\": all_onset.loc[\n        all_onset[\"queue_label\"] == 0, numeric_features\n    ].mean(),\n})\n\nsummary[\"difference\"] = (\n    summary[\"queue_cells_mean\"] - summary[\"nonqueue_cells_mean\"]\n)\n\nprint(summary.round(4).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:54:33.489742Z","iopub.execute_input":"2026-10-24T08:54:33.490056Z","iopub.status.idle":"2026-10-24T08:54:33.558917Z","shell.execute_reply.started":"2026-10-24T08:54:33.490034Z","shell.execute_reply":"2026-10-24T08:54:33.55824Z"}},"outputs":[{"name":"stdout","text":"Valid onset queue cells: 18\n                               queue_cells_mean  nonqueue_cells_mean  difference\nspeed_ratio_latest                       1.0020               0.9920      0.0100\nflow_ratio_latest                        0.5854               0.5676      0.0177\noccupancy_latest                         0.1514               0.1392      0.0122\nspeed_latest                           111.5693             112.4239     -0.8546\nflow_latest                           4756.1829            4489.8774    266.3054\npct_observed_latest                     80.8333              78.3136      2.5197\neligible_latest                          0.8333               0.7722      0.0612\nlast3_speed_ratio_mean                   1.0000               0.9922      0.0078\nlast3_speed_ratio_std                    0.0112               0.0092      0.0020\nlast3_flow_ratio_mean                    0.5954               0.5622      0.0333\nlast3_occupancy_mean                     0.1510               0.1379      0.0131\nlast3_pct_observed_mean                 76.3148              77.0204     -0.7056\nlast3_eligible_fraction                  0.7963               0.7641      0.0322\nlast3_observed_speed_fraction            0.8148               0.8274     -0.0126\nlast6_speed_ratio_mean                   1.0004               0.9923      0.0080\nlast6_speed_ratio_std                    0.0119               0.0102      0.0018\nlast6_flow_ratio_mean                    0.5896               0.5470      0.0426\nlast6_occupancy_mean                     0.1500               0.1340      0.0160\nlast6_pct_observed_mean                 72.8333              76.8184     -3.9851\nlast6_eligible_fraction                  0.7315               0.7617     -0.0302\nlast6_observed_speed_fraction            0.8056               0.8276     -0.0220\nspeed_ratio_first                        1.0003               0.9889      0.0115\nspeed_ratio_change                       0.0012               0.0031     -0.0019\nhorizon_step                             6.0000               3.4996      2.5004\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ninput_path = base / \"D7_I10_E_train_features.csv\"\noutput_path = base / \"D7_I10_E_train_features_temporal.csv\"\n\ndf = pd.read_csv(input_path)\n\n# Add temporal-change features from existing history summaries.\n# These are differences between historical summary windows, not target values.\nrequired = [\n    \"last3_speed_ratio_mean\", \"last6_speed_ratio_mean\",\n    \"last3_flow_ratio_mean\", \"last6_flow_ratio_mean\",\n    \"last3_occupancy_mean\", \"last6_occupancy_mean\",\n    \"speed_ratio_latest\", \"speed_ratio_first\",\n]\n\nmissing = [c for c in required if c not in df.columns]\nif missing:\n    raise ValueError(f\"Missing expected columns: {missing}\")\n\ndf[\"speed_ratio_recent_vs_long\"] = (\n    df[\"last3_speed_ratio_mean\"] - df[\"last6_speed_ratio_mean\"]\n)\ndf[\"flow_ratio_recent_vs_long\"] = (\n    df[\"last3_flow_ratio_mean\"] - df[\"last6_flow_ratio_mean\"]\n)\ndf[\"occupancy_recent_vs_long\"] = (\n    df[\"last3_occupancy_mean\"] - df[\"last6_occupancy_mean\"]\n)\ndf[\"speed_ratio_recent_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"last3_speed_ratio_mean\"]\n)\ndf[\"speed_ratio_overall_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"speed_ratio_first\"]\n)\n\n# Change in variability between recent and longer history.\nif \"last3_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_recent\"] = df[\"last3_speed_ratio_std\"]\n\nif \"last6_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_long\"] = df[\"last6_speed_ratio_std\"]\n    if \"last3_speed_ratio_std\" in df.columns:\n        df[\"speed_variability_change\"] = (\n            df[\"last3_speed_ratio_std\"] - df[\"last6_speed_ratio_std\"]\n        )\n\ndf.to_csv(output_path, index=False)\n\nnew_cols = [c for c in df.columns if c not in pd.read_csv(input_path, nrows=0).columns]\nprint(\"Saved:\", output_path)\nprint(\"Rows:\", len(df))\nprint(\"New temporal features:\", new_cols)\nprint(df[new_cols].describe().round(4).to_string())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:55:16.123105Z","iopub.execute_input":"2026-10-24T08:55:16.123425Z","iopub.status.idle":"2026-10-24T08:55:16.630565Z","shell.execute_reply.started":"2026-10-24T08:55:16.123401Z","shell.execute_reply":"2026-10-24T08:55:16.629715Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/task2_training_labels/D7_I10_E_train_features_temporal.csv\nRows: 8760\nNew temporal features: ['speed_ratio_recent_vs_long', 'flow_ratio_recent_vs_long', 'occupancy_recent_vs_long', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change']\n       speed_ratio_recent_vs_long  flow_ratio_recent_vs_long  occupancy_recent_vs_long  speed_ratio_recent_change  speed_ratio_overall_change  speed_variability_recent  speed_variability_long  speed_variability_change\ncount                   8364.0000                  8364.0000                 8364.0000                  7242.0000                   6060.0000                 7860.0000               8490.0000                 7860.0000\nmean                      -0.0047                     0.0084                    0.0042                    -0.0015                     -0.0182                    0.0106                  0.0167                   -0.0061\nstd                        0.0382                     0.0178                    0.0233                     0.0217                      0.1268                    0.0182                  0.0445                    0.0405\nmin                       -0.4524                    -0.0864                   -0.0639                    -0.4279                     -0.8614                    0.0000                  0.0000                   -0.4484\n25%                       -0.0031                    -0.0020                   -0.0004                    -0.0053                     -0.0089                    0.0044                  0.0070                   -0.0041\n50%                        0.0000                     0.0047                    0.0011                     0.0000                      0.0008                    0.0083                  0.0103                   -0.0004\n75%                        0.0029                     0.0159                    0.0038                     0.0053                      0.0131                    0.0132                  0.0137                    0.0018\nmax                        0.0456                     0.1107                    0.2316                     0.0239                      0.2055                    0.3706                  0.4484                    0.0848\n","output_type":"stream"}],"execution_count":39},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\n\n# 1. Load the NEW temporal feature file\npath = (\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features_temporal.csv\"\n)\ndf = pd.read_csv(path)\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# 2. Select features without target leakage\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\n# 3. Leave one entire window out at a time\noof_parts = []\nwindows = sorted(df[\"window_id\"].unique())\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    X_train = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    y_train = tr[\"queue_label\"]\n\n    X_val = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n\n    n_pos = int(y_train.sum())\n    n_neg = len(y_train) - n_pos\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=n_neg / max(n_pos, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X_train, y_train)\n\n    out = va[\n        [\"window_id\", \"condition\", \"queue_label\"]\n    ].copy()\n    out[\"probability\"] = model.predict_proba(X_val)[:, 1]\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\n# 4. Evaluate at the same fixed threshold: 0.5\noof = pd.concat(oof_parts, ignore_index=True)\nresults = []\n\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\nresults = pd.DataFrame(results)\n\nprint(\"\\n=== TEMPORAL FEATURES: RESULTS ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\n\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n\noof.to_csv(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_temporal_oof.csv\",\n    index=False,\n)\nprint(\"\\nSaved temporal OOF predictions.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:56:36.402537Z","iopub.execute_input":"2026-10-24T08:56:36.402841Z","iopub.status.idle":"2026-10-24T08:56:40.759159Z","shell.execute_reply.started":"2026-10-24T08:56:36.402809Z","shell.execute_reply":"2026-10-24T08:56:40.758076Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== TEMPORAL FEATURES: RESULTS ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 5 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               131 0.7941\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3909\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7597\nqueue_onset      0.0222\nName: IoU, dtype: float64\n\nSaved temporal OOF predictions.\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\ntry:\n    from catboost import CatBoostClassifier\nexcept ImportError:\n    print(\"CatBoost is not installed. Run: !pip -q install catboost\")\n    raise\n\npath = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features_temporal.csv\"\n)\n\ndf = pd.read_csv(path)\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeatures = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nwindows = sorted(df[\"window_id\"].unique())\nfold_results = []\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[features].replace([np.inf, -np.inf], np.nan)\n    Xva = va[features].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].to_numpy()\n\n    # CatBoost can handle missing numerical values.\n    pos = max(int(ytr.sum()), 1)\n    neg = len(ytr) - int(ytr.sum())\n\n    model = CatBoostClassifier(\n        iterations=300,\n        depth=5,\n        learning_rate=0.03,\n        loss_function=\"Logloss\",\n        eval_metric=\"PRAUC\",\n        class_weights=[1.0, neg / pos],\n        random_seed=42,\n        verbose=False,\n        allow_writing_files=False,\n        thread_count=-1,\n    )\n\n    model.fit(Xtr, ytr)\n    prob = model.predict_proba(Xva)[:, 1]\n    pred = prob >= 0.5\n    y = va[\"queue_label\"].to_numpy().astype(bool)\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    fold_results.append({\n        \"window_id\": wid,\n        \"condition\": va[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\nresults = pd.DataFrame(fold_results)\nprint(\"\\n=== CATBOOST OOF RESULTS ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:57:12.381841Z","iopub.execute_input":"2026-10-24T08:57:12.38217Z","iopub.status.idle":"2026-10-24T08:57:23.651476Z","shell.execute_reply.started":"2026-10-24T08:57:12.382148Z","shell.execute_reply":"2026-10-24T08:57:23.650833Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== CATBOOST OOF RESULTS ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 2 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.8370\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3952\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7683\nqueue_onset      0.0222\nName: IoU, dtype: float64\n","output_type":"stream"}],"execution_count":42},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\nfrom catboost import CatBoostClassifier\nfrom pathlib import Path\n\n# 1. Load the same temporal feature dataset\nbase = Path(\"/kaggle/working/task2_training_labels\")\ndf = pd.read_csv(base / \"D7_I10_E_train_features_temporal.csv\")\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# 2. Exclude labels, target-derived columns, and identifiers\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeatures = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\nwindows = sorted(df[\"window_id\"].unique())\noof_parts = []\n\n# 3. Train both models while holding out one entire window per fold\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    Xtr = tr[features].replace([np.inf, -np.inf], np.nan)\n    Xva = va[features].replace([np.inf, -np.inf], np.nan)\n    ytr = tr[\"queue_label\"].astype(int).to_numpy()\n    yva = va[\"queue_label\"].astype(int).to_numpy()\n\n    positives = max(int(ytr.sum()), 1)\n    negatives = len(ytr) - int(ytr.sum())\n    pos_weight = negatives / positives\n\n    # LightGBM\n    lgb_model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=pos_weight,\n        random_state=42,\n        verbosity=-1,\n    )\n    lgb_model.fit(Xtr, ytr)\n    p_lgb = lgb_model.predict_proba(Xva)[:, 1]\n\n    # CatBoost\n    cat_model = CatBoostClassifier(\n        iterations=300,\n        depth=5,\n        learning_rate=0.03,\n        loss_function=\"Logloss\",\n        class_weights=[1.0, pos_weight],\n        random_seed=42,\n        verbose=False,\n        allow_writing_files=False,\n        thread_count=-1,\n    )\n    cat_model.fit(Xtr, ytr)\n    p_cat = cat_model.predict_proba(Xva)[:, 1]\n\n    out = va[\n        [\"window_id\", \"condition\", \"queue_label\", \"horizon_step\"]\n    ].copy()\n    out[\"p_lightgbm\"] = p_lgb\n    out[\"p_catboost\"] = p_cat\n    out[\"p_ensemble\"] = (p_lgb + p_cat) / 2\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\n# 4. Save all aligned out-of-fold probabilities\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(base / \"D7_I10_E_ensemble_oof.csv\", index=False)\n\n# 5. Score each method with equal weight per window\ndef score_method(data, probability_column, threshold=0.5):\n    rows = []\n\n    for wid, group in data.groupby(\"window_id\", sort=True):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = group[probability_column].to_numpy() >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n        iou = intersection / union if union else 1.0\n\n        rows.append({\n            \"window_id\": wid,\n            \"condition\": group[\"condition\"].iloc[0],\n            \"true_queued\": int(y.sum()),\n            \"predicted_queued\": int(pred.sum()),\n            \"IoU\": float(iou),\n        })\n\n    result = pd.DataFrame(rows)\n    return result, result[\"IoU\"].mean()\n\nfor method in [\"p_lightgbm\", \"p_catboost\", \"p_ensemble\"]:\n    result, mean_iou = score_method(oof, method, threshold=0.5)\n    print(f\"\\n=== {method} ===\")\n    print(result.round(4).to_string(index=False))\n    print(\"Overall mean per-window IoU:\", round(mean_iou, 4))\n    print(\n        \"Mean IoU by condition:\",\n        result.groupby(\"condition\")[\"IoU\"].mean().round(4).to_dict()\n    )\n\nprint(\"\\nSaved OOF probabilities:\", base / \"D7_I10_E_ensemble_oof.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:59:00.185332Z","iopub.execute_input":"2026-10-24T08:59:00.185612Z","iopub.status.idle":"2026-10-24T08:59:12.567543Z","shell.execute_reply.started":"2026-10-24T08:59:00.185593Z","shell.execute_reply":"2026-10-24T08:59:12.566823Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== p_lightgbm ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 5 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               131 0.7941\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3909\nMean IoU by condition: {'queue_ongoing': 0.7597, 'queue_onset': 0.0222}\n\n=== p_catboost ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 2 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.8370\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3952\nMean IoU by condition: {'queue_ongoing': 0.7683, 'queue_onset': 0.0222}\n\n=== p_ensemble ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 3 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               135 0.7714\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\nOverall mean per-window IoU: 0.3887\nMean IoU by condition: {'queue_ongoing': 0.7551, 'queue_onset': 0.0222}\n\nSaved OOF probabilities: /kaggle/working/task2_training_labels/D7_I10_E_ensemble_oof.csv\n","output_type":"stream"}],"execution_count":43},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\npath = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_ensemble_oof.csv\"\n)\noof = pd.read_csv(path)\n\ndef evaluate(prob, threshold):\n    scores = []\n    for _, group in oof.groupby(\"window_id\", sort=True):\n        y = group[\"queue_label\"].to_numpy().astype(bool)\n        pred = prob[group.index.to_numpy()] >= threshold\n\n        intersection = np.sum(y & pred)\n        union = np.sum(y | pred)\n        scores.append(intersection / union if union else 1.0)\n\n    return float(np.mean(scores)), scores\n\nbest = None\nresults = []\n\n# Weight = share assigned to CatBoost.\nfor cat_weight in np.arange(0.0, 1.01, 0.1):\n    prob = (\n        (1 - cat_weight) * oof[\"p_lightgbm\"].to_numpy()\n        + cat_weight * oof[\"p_catboost\"].to_numpy()\n    )\n\n    for threshold in np.arange(0.10, 0.96, 0.02):\n        mean_iou, scores = evaluate(prob, threshold)\n        results.append((mean_iou, cat_weight, threshold, scores))\n\n        if best is None or mean_iou > best[0]:\n            best = (mean_iou, cat_weight, threshold, scores)\n\nprint(\"Best mean per-window IoU:\", round(best[0], 4))\nprint(\"CatBoost weight:\", round(best[1], 2))\nprint(\"LightGBM weight:\", round(1 - best[1], 2))\nprint(\"Threshold:\", round(best[2], 2))\n\n# Show each window's score at the best setting.\nbest_prob = (\n    (1 - best[1]) * oof[\"p_lightgbm\"].to_numpy()\n    + best[1] * oof[\"p_catboost\"].to_numpy()\n)\nbest_threshold = best[2]\n\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    idx = group.index.to_numpy()\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = best_prob[idx] >= best_threshold\n    union = np.sum(y | pred)\n    intersection = np.sum(y & pred)\n    iou = intersection / union if union else 1.0\n    print(\n        wid,\n        \"| condition:\", group[\"condition\"].iloc[0],\n        \"| predicted:\", int(pred.sum()),\n        \"| IoU:\", round(float(iou), 4),\n    )\n\nprint(\"\\nNote: weights and threshold are tuned on these same 10 OOF windows.\")\nprint(\"Treat this as exploratory; the best score may be optimistic.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:00:35.654105Z","iopub.execute_input":"2026-10-24T09:00:35.654712Z","iopub.status.idle":"2026-10-24T09:00:36.32182Z","shell.execute_reply.started":"2026-10-24T09:00:35.654692Z","shell.execute_reply":"2026-10-24T09:00:36.321137Z"}},"outputs":[{"name":"stdout","text":"Best mean per-window IoU: 0.3994\nCatBoost weight: 0.1\nLightGBM weight: 0.9\nThreshold: 0.74\nQ2_D7_I10_E_train_001 | condition: queue_onset | predicted: 1 | IoU: 0.0\nQ2_D7_I10_E_train_002 | condition: queue_onset | predicted: 4 | IoU: 0.0\nQ2_D7_I10_E_train_003 | condition: queue_onset | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_004 | condition: queue_onset | predicted: 6 | IoU: 0.1429\nQ2_D7_I10_E_train_005 | condition: queue_onset | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_006 | condition: queue_ongoing | predicted: 111 | IoU: 0.8512\nQ2_D7_I10_E_train_007 | condition: queue_ongoing | predicted: 105 | IoU: 0.8609\nQ2_D7_I10_E_train_008 | condition: queue_ongoing | predicted: 29 | IoU: 0.4203\nQ2_D7_I10_E_train_009 | condition: queue_ongoing | predicted: 354 | IoU: 0.8389\nQ2_D7_I10_E_train_010 | condition: queue_ongoing | predicted: 22 | IoU: 0.88\n\nNote: weights and threshold are tuned on these same 10 OOF windows.\nTreat this as exploratory; the best score may be optimistic.\n","output_type":"stream"}],"execution_count":44},{"cell_type":"code","source":"\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D7_I10_E\"\npanel_dir = ROOT / \"corridors\" / panel\n\nprint(\"Panel directory exists:\", panel_dir.exists())\nprint(\"\\nNetwork files:\")\n\nnetwork_dir = panel_dir / \"network\"\n\nif network_dir.exists():\n    for path in sorted(network_dir.rglob(\"*\")):\n        if path.is_file():\n            print(path.relative_to(panel_dir), \"|\", path.stat().st_size, \"bytes\")\nelse:\n    print(\"No network directory found.\")\n    print(\"\\nNearby files containing 'network' or 'link':\")\n    for path in panel_dir.rglob(\"*\"):\n        if path.is_file() and (\n            \"network\" in path.name.lower()\n            or \"link\" in path.name.lower()\n        ):\n            print(path.relative_to(panel_dir))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:02:36.158929Z","iopub.execute_input":"2026-10-24T09:02:36.159264Z","iopub.status.idle":"2026-10-24T09:02:36.200066Z","shell.execute_reply.started":"2026-10-24T09:02:36.159241Z","shell.execute_reply":"2026-10-24T09:02:36.199378Z"}},"outputs":[{"name":"stdout","text":"Panel directory exists: True\n\nNetwork files:\nnetwork/fd_parameters.csv | 8439 bytes\nnetwork/links.csv | 4956 bytes\nnetwork/lwr_mainline_topology.csv | 22063 bytes\nnetwork/path_link_incidence.csv | 8038841 bytes\nnetwork/path_set.csv | 3846393 bytes\nnetwork/ramp_attachment_map.csv | 4108 bytes\nnetwork/synthetic_network_manifest.json | 383 bytes\nnetwork/synthetic_ramp_attachment_map.csv | 4108 bytes\n","output_type":"stream"}],"execution_count":45},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nnetwork_dir = (\n    ROOT / \"corridors\" / \"D7_I10_E\" / \"network\"\n)\n\nfiles = [\n    \"lwr_mainline_topology.csv\",\n    \"links.csv\",\n    \"ramp_attachment_map.csv\",\n]\n\nfor filename in files:\n    path = network_dir / filename\n    print(f\"\\n{'=' * 20} {filename} {'=' * 20}\")\n\n    df_top = pd.read_csv(path)\n    print(\"Shape:\", df_top.shape)\n    print(\"Columns:\", df_top.columns.tolist())\n    print(df_top.head(5).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:04:10.706783Z","iopub.execute_input":"