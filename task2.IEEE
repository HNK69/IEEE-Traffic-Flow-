to_numeric(state[\"speed_kmh\"], errors=\"coerce\")\n        flow = pd.to_numeric(state[\"flow_vph\"], errors=\"coerce\")\n\n        invalid_state_values += int(\n            (~np.isfinite(speed) | ~np.isfinite(flow) |\n             (speed < 0) | (speed > 160) | (flow < 0)).sum()\n        )\n\n        speed_min = min(speed_min, speed.min())\n        speed_max = max(speed_max, speed.max())\n        flow_min = min(flow_min, flow.min())\n        flow_max = max(flow_max, flow.max())\n\nprint(\"Total rows:\", f\"{total_rows:,}\")\nprint(\"Rows by task:\", task_counts)\nprint(\"Missing cells:\", missing_values)\nprint(\"Duplicate IDs within chunks:\", duplicate_ids)\nprint(\"State rows:\", f\"{state_rows:,}\")\nprint(\"Invalid state values:\", invalid_state_values)\nprint(\"Speed range:\", speed_min, \"to\", speed_max, \"km/h\")\nprint(\"Flow range:\", flow_min, \"to\", flow_max, \"veh/h\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T08:14:28.16287Z","iopub.execute_input":"2026-10-25T08:14:28.163291Z","iopub.status.idle":"2026-10-25T08:14:37.19194Z","shell.execute_reply.started":"2026-10-25T08:14:28.163262Z","shell.execute_reply":"2026-10-25T08:14:37.190996Z"}},"outputs":[{"name":"stdout","text":"Total rows: 6,980,503\nRows by task: {'state': 6735795, 'queue': 174000, 'odme': 70708}\nMissing cells: 0\nDuplicate IDs within chunks: 0\nState rows: 6,735,795\nInvalid state values: 0\nSpeed range: 5.768987889390239 to 141.78941350388288 km/h\nFlow range: 247.2658149842473 to 10950.652093687057 veh/h\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"import pandas as pd\n\nROOT = \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n\nKEY_FILE = f\"{ROOT}/submission_key.csv\"\n\n# Inspect the official key schema and task/split distribution\nkey_sample = pd.read_csv(KEY_FILE, nrows=5)\nprint(\"Key columns:\", key_sample.columns.tolist())\ndisplay(key_sample)\n\nprint(\"\\nTask 1 templates ava