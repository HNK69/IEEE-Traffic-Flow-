iguration and regime coverage\nexpected_panels = set(modes[\"panels\"])\nevaluated_panels = set(panel_rows[\"panel\"])\nprint(\"Configured panels:\", len(expected_panels))\nprint(\"Evaluated panels:\", len(evaluated_panels))\nprint(\"Panel set matches:\", expected_panels == evaluated_panels)\nprint(\"Configured modes:\", sorted({\n    v[\"mode\"] for v in modes[\"panels\"].values()\n}))\nprint(\"Panel/regime rows:\", len(panel_rows))\nprint(\"Every panel has R1/R2/R3:\",\n      bool((panel_rows.groupby(\"panel\")[\"regime\"].nunique() == 3).all()))\n\n# 2. Summarize the FD diagnostic by panel\nsummary = (\n    panel_rows.groupby(\"panel\")\n    .agg(\n        FD_mean=(\"S_FD\", \"mean\"),\n        FD_min=(\"S_FD\", \"min\"),\n        LWR_mean=(\"S_LWR\", \"mean\"),\n        rows=(\"n_rows\", \"sum\"),\n    )\n    .sort_values(\"FD_mean\")\n)\nprint(\"\\nPanel summary, weakest FD first:\")\nprint(summary.round(6).to_string())\n\n# 3. Input file sanity checks, streamed to avoid loading all rows at once\nrequired = {\n    \"panel\", \"timestamp\", \"station_id\", \"link_id\",\n    \"mask_regime\", \"speed_kmh\", \"flow_vph\"\n}\nseen = 0\nbad_values = 0\nbad_bounds = 0\npanels_seen = set()\nregimes_seen = set()\n\nfor chunk in pd.read_csv(STATE_FILE, chunksize=300_000):\n    if not required.issubset(chunk.columns):\n        raise ValueError(f\"Missing columns: {required - set(chunk.columns)}\")\n\n    seen += len(chunk)\n    panels_seen.update(chunk[\"panel\"].dropna().astype(str).unique())\n    regimes_seen.update(chunk[\"mask_regime\"].dropna().astype(str).unique())\n\n    speed = pd.to_numeric(chunk[\"speed_kmh\"], errors=\"coerce\")\n    flow = pd.to_numeric(chunk[\"flow_vph\"], errors=\"coerce\")\n\n    bad_values += int((~np.isfinite(speed) | ~np.isfinite(flow)).sum())\n    bad_bounds += int(((speed < 0) | (speed > 160) | (flow < 0)).sum())\n\nprint(\"\\nInput audit:\")\nprint(\"Rows:\", f\"{seen:,}\")\nprint(\"Panels:\", len(panels_seen))\nprint(\"Regimes:\", so