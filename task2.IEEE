          3.0           100.0             3\nL10E-052               3              3.0           100.0             3\nL10E-180               3              3.0           100.0             3\nL10E-043               1              1.0           100.0             1\nL10E-243               1              1.0           100.0             1\nL10E-022               3              0.0             0.0             3\nL10E-002               3              0.0             0.0             3\nL10E-008               2              0.0             0.0             2\nL10E-012               4              0.0             0.0             4\nL10E-014               5              0.0             0.0             5\nL10E-017               5              0.0             0.0             5\nL10E-020               3              0.0             0.0             3\nL10E-021               5              0.0             0.0             5\nL10E-034               4              0.0             0.0             4\nL10E-028               3              0.0             0.0             3\nL10E-027               4              0.0             0.0             4\nL10E-026               3              0.0             0.0             3\nL10E-025               3              0.0             0.0             3\n\nOverall horizon-6 onset queue rate: 3.838 %\n","output_type":"stream"}],"execution_count":63},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\nlabels = pd.read_csv(base / \"D7_I10_E_train_labels.csv\")\n\nd = labels[\n    (labels[\"condition\"] == \"queue_onset\")\n    & (labels[\"horizon_step\"] == 6)\n    & labels[\"label_valid\"].astype(bool)\n].copy()\n\nrows = []\n\nfor wid in sorted(d[\"window_id\"].unique()):\n    train = d[d[\"window_id\"] != wid]\n    test = d[d[\"window_id\"] == wid]\n\n    positive_links = set(\n        train.loc[train[\"queue_label\"] == 1, \"link_id\"]\n    )\n    pred = test[\"link_id\"].isin(positive_links)\n    actual = test[\"queue_label\"].astype(bool)\n\n    intersection = (pred & actual).sum()\n    union = (pred | actual).sum()\n    iou = intersection / union if union else 1.0\n\n    rows.append({\n        \"held_out_window\": wid,\n        \"true_queued\": int(actual.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"correct_queued\": int(intersection),\n        \"IoU\": iou,\n    })\n\nresults = pd.DataFrame(rows)\nprint(results.round(4).to_string(index=False))\nprint(\"\\nMean onset IoU:\", round(results[\"IoU\"].mean(), 4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:25:26.276027Z","iopub.execute_input":"2026-10-24T09:25:26.276302Z","iopub.status.idle":"2026-10-24T09:25:26.31274Z","shell.execute_reply.started":"2026-10-24T09:25:26.276282Z","shell.execute_reply":"2026-10-24T09:25:26.311728Z"}},"outputs":[{"name":"stdout","text":"      held_out_window  true_queued  predicted_queued  correct_queued    IoU\nQ2_D7_I10_E_train_001            4                 4               4 1.0000\nQ2_D7_I10_E_train_002            6                 4               4 0.6667\nQ2_D7_I10_E_train_003            3                 3               3 1.0000\nQ2_D7_I10_E_train_004            2                 2               2 1.0000\nQ2_D7_I10_E_train_005            3                 3               3 1.0000\n\nMean onset IoU: 0.9333\n","output_type":"stream"}],"execution_count":64},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\noof = pd.read_csv(base / \"D7_I10_E_spatial_oof_identified.csv\")\n\nrequired = {\n    \"window_id\", \"condition\", \"link_id\",\n    \"horizon_step\", \"queue_label\", \"probability\"\n}\nassert required.issubset(oof.columns), (\n    f\"Missing columns: {required - set(oof.columns)}\"\n)\nassert not oof.duplicated(\n    [\"window_id\", \"link_id\", \"horizon_step\"]\n).any()\n\noof[\"queue_label\"] = oof[\"queue_label\"].astype(int)\noof[\"baseline_pred\"] = oof[\"probability\"] >= 0.5\noof[\"hybrid_pred\"] = oof[\"baseline_pred\"].copy()\n\n# Leave one onset window out when learning positive link identities.\nonset = oof[oof[\"condition\"] == \"queue_onset\"]\nonset_windows = sorted(onset[\"window_id\"].unique())\n\nfor held_out in onset_windows:\n    other_onset = onset[onset[\"window_id\"] != held_out]\n\n    positive_links = set(\n        other_onset.loc[\n            other_onset[\"queue_label\"] == 1, \"link_id\"\n        ]\n    )\n\n    mask = (\n        (oof[\"window_id\"] == held_out)\n        & (oof[\"condition\"] == \"queue_onset\")\n    )\n\n    # Training labels show no onset positives at horizons 1–5.\n    oof.loc[mask, \"hybrid_pred\"] = False\n\n    # At horizon 6, use only link identities found in other onset windows.\n    h6 = mask & (oof[\"horizon_step\"] == 6)\n    oof.loc[h6, \"hybrid_pred\"] = (\n        oof.loc[h6, \"link_id\"].isin(positive_links).to_numpy()\n    )\n\ndef window_iou(group, prediction_col):\n    actual = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[prediction_col].to_numpy().astype(bool)\n    union = np.sum(actual | pred)\n    return np.sum(actual & pred) / union if union else 1.0\n\nresults = []\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"baseline_IoU\": window_iou(group, \"baseline_pred\"),\n        \"hybrid_IoU\": window_iou(group, \"hybrid_pred\"),\n        \"true_queued\": int(group[\"queue_label\"].sum()),\n        \"hybrid_predicted\": int(group[\"hybrid_pred\"].sum()),\n    })\n\nresults = pd.DataFrame(results)\n\nprint(\"=== PER-WINDOW RESULTS ===\")\nprint(results.round(4).to_string(index=False))\n\nprint(\"\\n=== MEAN IoU ===\")\nprint(\"Baseline:\", round(results[\"baseline_IoU\"].mean(), 4))\nprint(\"Hybrid:  \", round(results[\"hybrid_IoU\"].mean(), 4))\n\nprint(\"\\n=== MEAN IoU BY CONDITION ===\")\nprint(\n    results.groupby(\"condition\")[[\"baseline_IoU\", \"hybrid_IoU\"]]\n    .mean()\n    .round(4)\n)\n\nsave_path = base / \"D7_I10_E_hybrid_oof.csv\"\noof.to_csv(save_path, index=False)\nprint(\"\\nSaved predictions:\", save_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:26:40.076284Z","iopub.execute_input":"2026-10-24T09:26:40.076576Z","iopub.status.idle":"2026-10-24T09:26:40.147704Z","shell.execute_reply.started":"2026-10-24T09:26:40.076554Z","shell.execute_reply":"2026-10-24T09:26:40.146973Z"}},"outputs":[{"name":"stdout","text":"=== PER-WINDOW RESULTS ===\n            window_id     condition  baseline_IoU  hybrid_IoU  true_queued  hybrid_predicted\nQ2_D7_I10_E_train_001   queue_onset        0.0000      1.0000            4                 4\nQ2_D7_I10_E_train_002   queue_onset        0.0000      0.6667            6                 4\nQ2_D7_I10_E_train_003   queue_onset        0.0000      1.0000            3                 3\nQ2_D7_I10_E_train_004   queue_onset        0.0000      1.0000            2                 2\nQ2_D7_I10_E_train_005   queue_onset        0.0000      1.0000            3                 3\nQ2_D7_I10_E_train_006 queue_ongoing        0.7970      0.7970          113               126\nQ2_D7_I10_E_train_007 queue_ongoing        0.8718      0.8718          109               110\nQ2_D7_I10_E_train_008 queue_ongoing        0.4493      0.4493           69                31\nQ2_D7_I10_E_train_009 queue_ongoing        0.8389      0.8389          308               354\nQ2_D7_I10_E_train_010 queue_ongoing        0.8800      0.8800           25                22\n\n=== MEAN IoU ===\nBaseline: 0.3837\nHybrid:   0.8504\n\n=== MEAN IoU BY CONDITION ===\n               baseline_IoU  hybrid_IoU\ncondition                              \nqueue_ongoing        0.7674      0.7674\nqueue_onset          0.0000      0.9333\n\nSaved predictions: /kaggle/working/task2_training_labels/D7_I10_E_hybrid_oof.csv\n","output_type":"stream"}],"execution_count":65},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanels = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nrows = []\n\nfor panel in panels:\n    path = (\n        ROOT / \"task2\" / panel / \"train\"\n        / \"window_labels.parquet\"\n    )\n\n    # Locate the actual label file instead of assuming its name.\n    if not path.exists():\n        candidates = list(\n            (ROOT / \"task2\" / panel / \"train\").glob(\"*label*\")\n        )\n        print(panel, \"label candidates:\", [p.name for p in candidates])\n        continue\n\n    labels = pd.read_parquet(path)\n    d = labels[\n        (labels[\"condition\"] == \"queue_onset\")\n        & (labels[\"horizon_step\"] == 6)\n        & labels[\"label_valid\"].astype(bool)\n    ].copy()\n\n    positives = d[d[\"queue_label\"] == 1]\n    rows.append({\n        \"panel\": panel,\n        \"valid_cells\": len(d),\n        \"positive_cells\": len(positives),\n        \"positive_links\": positives[\"link_id\"].nunique(),\n        \"links_repeating_across_windows\": (\n            positives.groupby(\"link_id\")[\"window_id\"].nunique().gt(1).sum()\n        ),\n    })\n\nprint(\"\\nPanel summary:\")\nprint(pd.DataFrame(rows).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T09:29:02.731353Z","iopub.execute_input":"2026-10-24T09:29:02.73165Z","iopub.status.idle":"2026-10-24T09:29:02.766815Z","shell.execute_reply.started":"2026-10-24T09:29:02.731626Z","shell.execute_reply":"2026-10-24T09:29:02.765917Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E label candidates: []\nD7_I10_W label candidates: []\nD7_I210_E label candidates: []\nD7_I210_