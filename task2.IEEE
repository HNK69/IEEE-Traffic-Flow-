=== State columns ===\n['submission_id', 'task', 'speed_kmh', 'flow_vph', 'queue_pred', 'path_flow']\n\n=== Queue columns ===\n['window_id', 'timestamp', 'link_id', 'queue_pred']\n\n=== ODME columns ===\n['panel', 'departure_time', 'path_id', 'origin_zone', 'destination_zone', 'path_flow']\n\n=== Old unified submission audit ===\nDuplicate submission IDs: 0\nMissing state speeds: 0\nMissing state flows: 0\n\n=== ODME split coverage ===\npanel\nD12_I405_N     1806\nD12_I405_S     1260\nD12_I5_N       8556\nD12_I5_S      10100\nD7_I10_E       8556\nD7_I10_W      10100\nD7_I210_E      5256\nD7_I210_W      6642\nD7_I405_N      9120\nD7_I405_S      9312\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nkey_path = ROOT / \"submission_key.csv\"\nold_path = Path(\n    \"/kaggle/input/datasets/krupaalhn/task1-csv/submission (1).csv\"\n)\nout_path = Path(\"/kaggle/working/task1_state_submission.csv\")\n\n# Load Task 1 predictions indexed by the official submission ID.\nold = pd.read_csv(\n    old_path,\n    usecols=[\"submission_id\", \"task\", \"speed_kmh\", \"flow_vph\"]\n)\nstate_values = (\n    old.loc[old.task == \"state\"]\n       .set_index(\"submission_id\")[[\"speed_kmh\", \"flow_vph\"]]\n)\ndel old\n\n# Reconstruct natural keys from the official key, in chunks.\nfirst = True\nwritten = 0\n\nfor chunk in pd.read_csv(key_path, dtype=str, chunksize=500_000):\n    s = chunk.loc[chunk.task == \"state\"].copy()\n    if s.empty:\n        continue\n\n    s[\"submission_id\"] = s[\"submission_id\"].astype(\"int64\")\n    values = state_values.reindex(s[\"submission_id\"].to_numpy())\n\n    s[\"speed_kmh\"] = values[\"speed_kmh\"].to_numpy()\n    s[\"flow_vph\"] = values[\"flow_vph\"].to_numpy()\n\n    result = s[\n        [\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n         \"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n    ]\n\n    result.to_csv(\n        out_path, mode=\"w\" if first else \"a\",\n        header=first, index=False\n    )\n    first = False\n    written += len(result)\n\nprint(\"State rows written:\", written)\nprint(\"State rows expected:\", len(state_values))\nprint(\"Missing speed predictions:\", int(state_values.speed_kmh.isna().sum()))\nprint(\"Missing flow predictions:\", int(state_values.flow_vph.isna().sum()))\nprint(\"Saved:\", out_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T10:52:15.429012Z","iopub.execute_input":"2026-10-25T10:52:15.42934Z","iopub.status.idle":"2026-10-25T10:53:32.295147Z","shell.execute_reply.started":"2026-10-25T10:52:15.429314Z","shell.execute_reply":"2026-10-25T10:53:32.293913Z"}},"outputs":[{"name":"stdout","text":"State rows written: 6735795\nState rows expected: 6735795\nMissing speed predictions: 0\nMissing flow predictions: 0\nSaved: /kaggle/working/task1_state_submission.csv\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"from pathlib import Path\nimport subprocess\nimport sys\nimport pandas as pd\n\nREPO = Path(\"/kaggle/working/trafficflowbench-public\")\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUTPUT = Path(\"/kaggle/working/final_submission.csv\")\n\ncmd = [\n    sys.executable,\n    str(REPO / \"src/merge_submissions.py\"),\n    \"--state\", \"/kaggle/working/task1_state_submission.csv\",\n    \"--queue\", \"/kaggle/working/task2_submission.csv\",\n    \"--odme\", \"/kaggle/working/task4_submission.csv\",\n    \"--key\", str(ROOT / \"submission_key.csv\"),\n    \"--output\", str(OUTPUT),\n]\n\nresult = subprocess.run(cmd, text=True, capture_output=True)\nprint(result.stdout)\nif result.stderr:\n    print(result.stderr[-4000:])\nprint(\"Return code:\", result.returncode)\n\nif result.returncode == 0 and OUTPUT.exists():\n    sub = pd.read_csv(OUTPUT)\n    key = pd.read_csv(ROOT / \"submission_key.csv\", usecols=[\"submission_id\", \"task\"])\n\n    print(\"\\n=== Final validation ===\")\n    print(\"Rows:\", len(sub), \"| Expected:\", len(key))\n    print(\"Columns:\", sub.columns.tolist())\n    print(\"Duplicate IDs:\", int(sub.submission_id.duplicated().sum()))\n    print(\"Task counts:\")\n    print(sub.task.value_counts().to_string())\n\n    value_cols = [\"speed_kmh\", \"flow_vph\", \"queue_pred\", \"path_flow\"]\n    print(\"\\nMissing values per prediction column:\")\n    print(sub[value_cols].isna().sum().to_string())\n\n    print(\"\\nNon-finite values per prediction column:\")\n    print((~sub[value_cols].apply(lambda c: pd.Series(\n        __import__(\"numpy\").isfinite(c.to_numpy())\n    )).all()).sum().to_string())\n\n    print(\"\\nTask-specific ranges:\")\n    for task, cols in {\n        \"state\": [\"speed_kmh\", \"flow_vph\"],\n        \"queue\": [\"queue_pred\"],\n        \"odme\": [\"path_flow\"],\n    }.items():\n        part = sub[sub.task == task]\n        print(task, {c: (part[c].min(), part[c].max()) for c in cols})\n\n    print(\"\\nSaved final submission:\", OUTPUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T10:53:58.979552Z","iopub.execute_input":"2026-10-25T10:53:58.98022Z","iopub.status.idle":"2026-10-25T10:55:42.997375Z","shell.execute_reply.started":"2026-10-25T10:53:58.98019Z","shell.execute_reply":"2026-10-25T10:55:42.996176Z"}},"outputs":[{"name":"stdout","text":"  1,000,000 rows\n  2,000,000 rows\n  3,000,000 rows\n  4,000,000 rows\n  5,000,000 rows\n  6,000,000 rows\n  6,980,503 rows\nWrote 6,980,503 rows to /kaggle/working/final_submission.csv\nEvery scored cell was filled from your files.\n\nReturn code: 0\n\n=== Final validation ===\nRows: 6980503 | Expected: 6980503\nColumns: ['submission_id', 'task', 'speed_kmh', 'flow_vph', 'queue_pred', 'path_flow']\nDuplicate IDs: 0\nTask counts:\ntask\nstate    6735795\nqueue     174000\n