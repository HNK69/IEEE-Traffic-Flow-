_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD7_I210_W\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD7_I405_N\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD7_I405_S\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD12_I5_N\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nD12_I5_S\nAvailable: ['speed_ratio_latest', 'speed_ratio_first', 'speed_ratio_change', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_ratio_recent_vs_long', 'flow_ratio_latest', 'flow_ratio_recent_vs_long', 'occupancy_latest', 'occupancy_recent_vs_long', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change', 'last3_speed_ratio_mean', 'last6_speed_ratio_mean', 'last3_speed_ratio_std', 'last6_speed_ratio_std', 'last3_flow_ratio_mean', 'last6_flow_ratio_mean', 'last3_occupancy_mean', 'last6_occupancy_mean', 'last3_pct_observed_mean', 'last6_pct_observed_mean']\n\nInspection complete. No models were trained.\n","output_type":"stream"}],"execution_count":92},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nnew_features = [\n    \"speed_deceleration_signal\",\n    \"flow_acceleration_signal\",\n    \"variability_acceleration_signal\",\n]\n\nfor panel in PANELS:\n    src = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(src)\n\n    required = [\n        \"speed_ratio_recent_change\",\n        \"speed_ratio_overall_change\",\n        \"flow_ratio_recent_vs_long\",\n        \"speed_variability_recent\",\n        \"speed_variability_long\",\n    ]\n    missing = [c for c in required if c not in df.columns]\n    assert not missing, f\"{panel} missing columns: {missing}\"\n\n    # Difference between recent and overall speed change.\n    df[\"speed_deceleration_signal\"] = (\n        df[\"speed_ratio_recent_change\"]\n        - df[\"speed_ratio_overall_change\"]\n    )\n\n    # Existing recent-vs-long flow ratio, centered at neutral ratio 1.\n    df[\"flow_acceleration_signal\"] = (\n        df[\"flow_ratio_recent_vs_long\"] - 1.0\n    )\n\n    # Positive values indicate more recent speed variability.\n    df[\"variability_acceleration_signal\"] = (\n        df[\"speed_variability_recent\"]\n        - df[\"speed_variability_long\"]\n    )\n\n    dst = BASE / f\"{panel}_train_features_temporal_plus.csv\"\n    df.to_csv(dst, index=False)\n\n    print(\n        f\"{panel}: saved {len(df)} rows; \"\n        f\"new features non-null = \"\n        f\"{df[new_features].notna().all(axis=1).sum()}/{len(df)}\"\n    )\n\nprint(\"\\nCreated expanded feature files.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:25:09.063333Z","iopub.execute_input":"2026-10-24T10:25:09.063597Z","iopub.status.idle":"2026-10-24T10:25:14.260353Z","shell.execute_reply.started":"2026-10-24T10:25:09.063577Z","shell.execute_reply":"2026-10-24T10:25:14.259388Z"}},"outputs":[{"name":"stdout","text":"D7_I10_E: saved 8760 rows; new features non-null = 5838/8760\nD7_I10_W: saved 6420 rows; new features non-null = 5292/6420\nD7_I210_E: saved 17820 rows; new features non-null = 14748/17820\nD7_I210_W: saved 4860 rows; new features non-null = 4050/4860\nD7_I405_N: saved 21120 rows; new features non-null = 17280/21120\nD7_I405_S: saved 6540 rows; new features non-null = 5286/6540\nD12_I5_N: saved 15480 rows; new features non-null = 12666/15480\nD12_I5_S: saved 6000 rows; new features non-null = 4824/6000\n\nCreated expanded feature files.\n","output_type":"stream"}],"execution_count":93},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\nNEW_FEATURES = [\n    \"speed_deceleration_signal\",\n    \"flow_acceleration_signal\",\n    \"variability_acceleration_signal\",\n]\n\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    df = pd.read_csv(\n        BASE / f\"{panel}_train_features_temporal_plus.csv\"\n    )\n    df = df[df[\"label_valid\"].eq(True) & df[\"queue_label\"].notna()].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n    data[panel] = df\n\n    feature_sets.append({\n        c for c in df.columns\n        if c not in EXCLUDE\n        and pd.api.types.is_numeric_dtype(df[c])\n    })\n\nexpanded_features = sorted(set.intersection(*feature_sets))\nbaseline_features = [\n    c for c in expanded_features if c not in NEW_FEATURES\n]\n\nprint(\"Baseline features:\", len(baseline_features))\nprint(\"Expanded features:\", len(expanded_features))\nassert len(expanded_features) == len(baseline_features) + 3\n\ndef calc_iou(y, p):\n    y = np.asarray(y, dtype=bool)\n    p = np.asarray(p, dtype=bool)\n    union = np.logical_or(y, p).sum()\n    return np.logical_and(y, p).sum() / union if union else 1.0\n\nsummary = []\n\nfor model_name, features in [\n    (\"baseline_42\", baseline_features),\n    (\"expanded_45\", expanded_features),\n]:\n    print(f\"\\nTraining: {model_name}\")\n    predictions = []\n\n    for panel in PANELS:\n        df = data[panel]\n\n        for held_out in sorted(df[\"window_id\"].unique()):\n            train = df[df[\"window_id\"] != held_out]\n            test = df[df[\"window_id\"] == held_out]\n\n            X_train = train[features].replace([np.inf, -np.inf], np.nan)\n            X_test = test[features].replace([np.inf, -np.inf], np.nan)\n            y_train = train[\"queue_label\"]\n\n            positives = int(y_train.sum())\n            negatives = len(y_train) - positives\n\n            model = lgb.LGBMClassifier(\n                n_estimators=300,\n                learning_rate=0.03,\n                num_leaves=15,\n                min_child_samples=30,\n                colsample_bytree=0.9,\n                subsample=0.9,\n                reg_lambda=2.0,\n                scale_pos_weight=negatives / max(positives, 1),\n                random_state=42,\n                verbosity=-1,\n            )\n            model.fit(X_train, y_train)\n\n            out = test[\n                [\"window_id\", \"condition\", \"queue_label\"]\n            ].copy()\n            out[\"panel\"] = panel\n            out[\"probability\"] = model.predict_proba(X_test)[:, 1]\n            out[\"prediction\"] = out[\"probability\"] >= 0.50\n            out[\"model\"] = model_name\n            predictions.append(out)\n\n        print(f\"  {panel} completed\")\n\n    oof = pd.concat(predictions, ignore_index=True)\n\n    for (panel, window, condition), group in oof.groupby(\n        [\"panel\", \"window_id\", \"condition\"], sort=True\n    ):\n        summary.append({\n            \"model\": model_name,\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"IoU\": calc_iou(\n                group[\"queue_label\"], group[\"prediction\"]\n            ),\n        })\n\nresults = pd.DataFrame(summary)\n\nprint(\"\\n=== OVERALL MEAN IoU ===\")\nprint(results.groupby(\"model\")[\"IoU\"].mean().round(4).to_string())\n\nprint(\"\\n=== BY CONDITION ===\")\nprint(\n    results.groupby([\"model\", \"condition\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nprint(\"\\n=== BY PANEL ===\")\nprint(\n    results.groupby([\"panel\", \"model\"])[\"IoU\"]\n    .mean().unstack().round(4).to_string()\n)\n\nresults.to_csv(BASE / \"temporal_feature_experiment.csv\", index=False)\nprint(\"\\nSaved:\", BASE / \"temporal_feature_experiment.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:27:34.202855Z","iopub.execute_input":"2026-10-24T10:27:34.203145Z","iopub.status.idle":"2026-10-24T10:28:56.386507Z","shell.execute_reply.started":"2026-10-24T10:27:34.203124Z","shell.execute_reply":"2026-10-24T10:28:56.385924Z"}},"outputs":[{"name":"stdout","text":"Baseline features: 42\nExpanded features: 45\n\nTraining: baseline_42\n  D7_I10_E completed\n  D7_I10_W completed\n  D7_I210_E completed\n  D7_I210_W completed\n  D7_I405_N completed\n  D7_I405_S completed\n  D12_I5_N completed\n  D12_I5_S completed\n\nTraining: expanded_45\n  D7_I10_E completed\n  D7_I10_W completed\n  D7_I210_E completed\n  D7_I210_W completed\n  D7_I405_N completed\n  D7_I405_S completed\n  D12_I5_N completed\n  D12_I5_S completed\n\n=== OVERALL MEAN IoU ===\nmodel\nbaseline_42    0.4385\nexpanded_45    0.4292\n\n=== BY CONDITION ===\ncondition    queue_ongoing  queue_onset\nmodel                                  \nbaseline_42         0.7754       0.1017\nexpanded_45         0.7680       0.0904\n\n=== BY PANEL ===\nmodel      baseline_42  expanded_45\npanel                              \nD12_I5_N        0.3620       0.3631\nD12_I5_S        0.4228       0.4203\nD7_I10_E        0.3761       0.3642\nD7_I10_W        0.5613       0.5613\nD7_I210_E       0.4378       0.4453\nD7_I210_W       0.4567       0.3998\nD7_I405_N       0.4587       0.4599\nD7_I405_S       0.4327       0.4196\n\nSaved: /kaggle/working/task2_training_labels/temporal_feature_experiment.csv\n","output_type":"stream"}],"execution_count":94},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\nfrom sklearn.metrics import confusion_matrix\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\n# Load the original spatial feature files and determine common numeric features.\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    path = BASE / f\"{panel}_train_features_spatial.csv\"\n    df = pd.read_csv(path)\n\n    # Ensure panel is present even if a source file omitted it.\n    df[\"panel\"] = panel\n\n    data[panel] = df\n    numeric = set(df.select_dtypes(include=[np.number]).columns) - EXCLUDE\n    feature_sets.append(numeric)\n\nFEATURES = sorted(set.intersection(*feature_sets))\nprint(f\"Shared numeric features: {len(FEATURES)}\")\nassert len(FEATURES) == 42, (\n    f\"Expected 42 shared features, found {len(FEATURES)}. \"\n    \"Check that the original spatial feature files are being used.\"\n)\n\nTHRESHOLD = 0.50\nLEAF_SAMPLES = [15, 30, 60]\nall_results = []\n\nfor min_child in LEAF_SAMPLES:\n    print(f\"\\n{'='*55}\")\n    print(f\"Testing min_child_samples = {min_child}\")\n    print(f\"{'='*55}\")\n\n    panel_results = []\n\n    for panel in PANELS:\n        df = data[panel].copy()\n\n        # Only rows with valid training labels are evaluated.\n        df = df[df[\"label_valid\"].astype(bool)].copy()\n        df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n        # One held-out window at a time.\n        windows = sorted(df[\"window_id\"].dropna().unique())\n        fold_predictions = []\n\n        for held_out in windows:\n            train = df[df[\"window_id\"] != held_out]\n            test = df[df[\"window_id\"] == held_out]\n\n            if train.empty or test.empty or train[\"queue_label\"].nunique() < 2:\n                continue\n\n            y_train = train[\"queue_label\"]\n            y_test = test[\"queue_label\"]\n\n            positives = int((y_train == 1).sum())\n            negatives = int((y_train == 0).sum())\n\n            model = lgb.LGBMClassifier(\n                objective=\"binary\",\n                n_estimators=300,\n                learning_rate=0.03,\n                num_leaves=15,\n                min_child_samples=min_child,\n                colsample_bytree=0.9,\n                subsample=0.9,\n                reg_lambda=2.0,\n                scale_pos_weight=negatives / max(positives, 1),\n                random_state=42,\n                verbosity=-1,\n            )\n\n            model.fit(train[FEATURES], y_train)\n            probabilities = model.predict_proba(test[FEATURES])[:, 1]\n            predictions = (probabilities >= THRESHOLD).astype(int)\n\n            fold_predictions.append(pd.DataFrame({\n                \"panel\": panel,\n                \"window_id\": test[\"window_id\"].values,\n                \"condition\": test[\"condition\"].values,\n                \"y_true\": y_test.values,\n                \"y_pred\": predictions,\n            }))\n\n        if not fold_predictions:\n            print(f\"{panel}: no valid folds\")\n            continue\n\n        pred_df = pd.concat(fold_predictions, ignore_index=True)\n\n        # Equal-weighted IoU across each window-condition group,\n        # matching the existing evaluation approach.\n        group_scores = []\n        for (_, _, condition), group in pred_df.groupby(\n            [\"panel\", \"window_id\", \"condition\"], dropna=False\n        ):\n            yt = group[\"y_true\"].to_numpy()\n            yp = group[\"y_pred\"].to_numpy()\n\n            intersection = np.sum((yt == 1) & (yp == 1))\n            union = np.sum((yt == 1) | (yp == 1))\n            iou = intersection / union if union else 1.0\n\n            group_scores.append({\n                \"panel\": panel,\n                \"condition\": condition,\n                \"iou\": iou,\n            })\n\n        group_df = pd.DataFrame(group_scores)\n\n        for condition, group in group_df.groupby(\"condition\"):\n            panel_results.append({\n                \"min_child_samples\": min_child,\n                \"panel\": panel,\n                \"condition\": condition,\n                \"mean_iou\": group[\"iou\"].mean(),\n                \"groups\": len(group),\n            })\n\n        panel_results.append({\n            \"min_child_samples\": min_child,\n            \"panel\": panel,\n            \"condition\": \"ALL\",\n            \"mean_iou\": group_df[\"iou\"].mean(),\n            \"groups\": len(group_df),\n        })\n\n        print(\n            f\"{panel}: IoU = {group_df['iou'].mean():.4f} \"\n            f\"({len(group_df)} window-condition groups)\"\n        )\n\n    all_results.extend(panel_results)\n\nresults = pd.DataFrame(all_results)\n\n# Summarize across panels, weighting panel-window-condition groups equally.\noverall = (\n    results[results[\"condition\"] == \"ALL\"]\n    .groupby(\"min_child_samples\")\n    .apply(\n        lambda g: np.average(g[\"mean_iou\"], weights=g[\"groups\"]),\n        include_groups=False,\n    )\n    .rename(\"overall_iou\")\n)\n\ncondition_summary = (\n    results[results[\"condition\"] != \"ALL\"]\n    .groupby([\"min_child_samples\", \"condition\"])\n    .apply(\n        lambda g: np.average(g[\"mean_iou\"], weights=g[\"groups\"]),\n        include_groups=False,\n    )\n    .unstack(\"condition\")\n)\n\nsummary = pd.concat([overall, condition_summary], axis=1).reset_index()\nsummary = summary.sort_values(\"overall_iou\", ascending=False)\n\nout_path = BASE / \"min_child_samples_results.csv\"\nresults.to_csv(out_path, index=False)\n\nprint(\"\\nFINAL COMPARISON\")\ndisplay(summary.round(4))\nprint(f\"\\nDetailed results saved to: {out_path}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:34:33.25637Z","iopub.execute_input":"2026-10-24T10:34:33.256675Z","iopub.status.idle":"2026-10-24T10:36:29.972388Z","shell.execute_reply.started":"2026-10-24T10:34:33.256652Z","shell.execute_reply":"2026-10-24T10:36:29.971759Z"}},"outputs":[{"name":"stdout","text":"Shared numeric features: 42\n\n=======================================================\nTesting min_child_samples = 15\n=======================================================\nD7_I10_E: IoU = 0.3777 (10 window-condition groups)\nD7_I10_W: IoU = 0.5550 (10 window-condition groups)\nD7_I210_E: IoU = 0.3965 (10 window-condition groups)\nD7_I210_W: IoU = 0.4069 (10 window-condition groups)\nD7_I405_N: IoU = 0.4602 (10 window-condition groups)\nD7_I405_S: IoU = 0.4368 (10 window-condition groups)\nD12_I5_N: IoU = 0.3624 (10 window-condition groups)\nD12_I5_S: IoU = 0.4150 (10 window-condition groups)\n\n=======================================================\nTesting min_child_samples = 30\n=======================================================\nD7_I10_E: IoU = 0.3761 (10 window-condition groups)\nD7_I10_W: IoU = 0.5613 (10 window-condition groups)\nD7_I210_E: IoU = 0.4378 (10 window-condition groups)\nD7_I210_W: IoU = 0.4567 (10 window-condition groups)\nD7_I405_N: IoU = 0.4587 (10 window-condition groups)\nD7_I405_S: IoU = 0.4327 (10 window-condition groups)\nD12_I5_N: IoU = 0.3620 (10 window-condition groups)\nD12_I5_S: IoU = 0.4228 (10 window-condition groups)\n\n=======================================================\nTesting min_child_samples = 60\n=======================================================\nD7_I10_E: IoU = 0.3653 (10 window-condition groups)\nD7_I10_W: IoU = 0.5613 (10 window-condition groups)\nD7_I210_E: IoU = 0.4386 (10 window-condition groups)\nD7_I210_W: IoU = 0.4053 (10 window-condition groups)\nD7_I405_N: IoU = 0.4578 (10 window-condition groups)\nD7_I405_S: IoU = 0.4231 (10 window-condition groups)\nD12_I5_N: IoU = 0.3639 (10 window-condition groups)\nD12_I5_S: IoU = 0.4200 (10 window-condition groups)\n\nFINAL COMPARISON\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"   min_child_samples  overall_iou  queue_ongoing  queue_onset\n1                 30       0.4385         0.7754       0.1017\n2                 60       0.4294         0.7647       0.0942\n0                 15       0.4263         0.7643       0.0883","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>min_child_samples</th>\n      <th>overall_iou</th>\n      <th>queue_ongoing</th>\n      <th>queue_onset</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>1</th>\n      <td>30</td>\n      <td>0.4385</td>\n      <td>0.7754</td>\n      <td>0.1017</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>60</td>\n      <td>0.4294</td>\n      <td>0.7647</td>\n      <td>0.0942</td>\n    </tr>\n    <tr>\n      <th>0</th>\n      <td>15</td>\n      <td>0.4263</td>\n      <td>0.7643</td>\n      <td>0.0883</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nDetailed results saved to: /kaggle/working/task2_training_labels/min_child_samples_results.csv\n","output_type":"stream"}],"execution_count":95},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nframes = []\n\nfor panel in PANELS:\n    df = pd.read_csv(BASE / f\"{panel}_train_features_spatial.csv\")\n    df[\"panel\"] = panel\n    df = df[df[\"label_valid\"].astype(bool)].copy()\n    frames.append(df)\n\ndata = pd.concat(frames, ignore_index=True)\n\nonset = data[data[\"condition\"] == \"queue_onset\"].copy()\n\nprint(\"ONSET LABEL AUDIT\")\nprint(\"Valid onset rows:\", len(onset))\nprint(\"Positive onset rows:\", int(onset[\"queue_label\"].sum()))\nprint(\"Positive rate:\", round(onset[\"queue_label\"].mean(), 5))\n\nprint(\"\\n1. BY PANEL\")\ndisplay(\n    onset.groupby(\"panel\").agg(\n        rows=(\"queue_label\", \"size\"),\n        positives=(\"queue_label\", \"sum\"),\n        positive_rate=(\"queue_label\", \"mean\"),\n        windows=(\"window_id\", \"nunique\"),\n    ).round(4)\n)\n\nprint(\"\\n2. BY FORECAST HORIZON\")\ndisplay(\n    onset.groupby(\"horizon_step\").agg(\n        rows=(\"queue_label\", \"size\"),\n        positives=(\"queue_label\", \"sum\"),\n        positive_rate=(\"queue_label\", \"mean\"),\n    ).round(4)\n)\n\nprint(\"\\n3. BY WINDOW\")\ndisplay(\n    onset.groupby([\"panel\", \"window_id\"]).agg(\n        rows=(\"queue_label\", \"size\"),\n        positives=(\"queue_label\", \"sum\"),\n    ).query(\"positives > 0\").reset_index()\n)\n\nprint(\"\\n4. MOST FREQUENT POSITIVE LINKS\")\ndisplay(\n    onset[onset[\"queue_label\"] == 1]\n    .groupby([\"panel\", \"link_id\"])\n    .agg(\n        positive_rows=(\"queue_label\", \"size\"),\n        positive_windows=(\"window_id\", \"nunique\"),\n        horizons=(\"horizon_step\", \"nunique\"),\n    )\n    .sort_values(\n        [\"panel\", \"positive_windows\", \"positive_rows\"],\n        ascending=[True, False, False],\n    )\n    .reset_index()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:38:44.067409Z","iopub.execute_input":"2026-10-24T10:38:44.067684Z","iopub.status.idle":"2026-10-24T10:38:45.310973Z","shell.execute_reply.started":"2026-10-24T10:38:44.067664Z","shell.execute_reply":"2026-10-24T10:38:45.310072Z"}},"outputs":[{"name":"stdout","text":"ONSET LABEL AUDIT\nValid onset rows: 27727\nPositive onset rows: 100\nPositive rate: 0.00361\n\n1. BY PANEL\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           rows  positives  positive_rate  windows\npanel                                             \nD12_I5_N   4948        9.0         0.0018        5\nD12_I5_S   1941       10.0         0.0052        5\nD7_I10_E   2792       18.0         0.0064        5\nD7_I10_W   2094        3.0         0.0014        5\nD7_I210_E  5703       19.0         0.0033        5\nD7_I210_W  1558        9.0         0.0058        5\nD7_I405_N  6665       12.0         0.0018        5\nD7_I405_S  2026       20.0         0.0099        5","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>rows</th>\n      <th>positives</th>\n      <th>positive_rate</th>\n      <th>windows</th>\n    </tr>\n    <tr>\n      <th>panel</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>D12_I5_N</th>\n      <td>4948</td>\n