{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":153956},{"sourceType":"datasetVersion","sourceId":21148729}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I10_E\"\n\nwi = pd.read_csv(\n    ROOT / \"task2\" / PANEL / \"train\" / \"window_index.csv\"\n)\nw = wi.iloc[0]\norigin = pd.to_datetime(w[\"forecast_origin\"], utc=True)\n\nfolder = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\ndate = origin.strftime(\"%Y_%m_%d\")\n\nfiles = list(folder.rglob(f\"synthetic_mainline_{date}.parquet\"))\nprint(\"Origin:\", origin)\nprint(\"Matching daily files:\", len(files))\n\nif files:\n    state = pd.concat([\n        pd.read_parquet(f, columns=[\"timestamp\", \"link_id\", \"speed_kmh\"])\n        for f in files\n    ], ignore_index=True)\n\n    state[\"timestamp\"] = pd.to_datetime(state[\"timestamp\"], utc=True)\n    at_origin = state[state[\"timestamp\"] == origin]\n\n    print(\"State rows at T:\", len(at_origin))\n    print(\"Unique links at T:\", at_origin[\"link_id\"].nunique())\n    print(\"Non-null speeds at T:\", at_origin[\"speed_kmh\"].notna().sum())\nelse:\n    print(\"No daily file found for the origin date.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:13:20.72678Z","iopub.execute_input":"2026-10-24T08:13:20.727088Z","iopub.status.idle":"2026-10-24T08:13:20.777826Z","shell.execute_reply.started":"2026-10-24T08:13:20.727065Z","shell.execute_reply":"2026-10-24T08:13:20.776948Z"}},"outputs":[{"name":"stdout","text":"Origin: 2030-06-01 09:05:00+00:00\nMatching daily files: 1\nState rows at T: 146\nUnique links at T: 146\nNon-null speeds at T: 116\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nall_labels = []\n\nfor panel in PANELS:\n    print(f\"Building labels: {panel}\")\n\n    base = ROOT / \"task2\" / panel / \"train\"\n    wi = pd.read_csv(base / \"window_index.csv\")\n    wi[\"origin\"] = pd.to_datetime(wi[\"forecast_origin\"], utc=True)\n\n    # Six future timestamps per training window\n    horizon = []\n    for _, w in wi.iterrows():\n        for step in range(1, 7):\n            horizon.append({\n                \"window_id\": w[\"window_id\"],\n                \"panel\": panel,\n                \"condition\": w[\"condition\"],\n                \"forecast_origin\": w[\"origin\"],\n                \"timestamp\": w[\"origin\"] + pd.Timedelta(minutes=5 * step),\n                \"horizon_step\": step,\n            })\n\n    horizon = pd.DataFrame(horizon)\n    target_times = set(horizon[\"timestamp\"])\n    target_dates = {t.strftime(\"%Y_%m_%d\") for t in target_times}\n\n    folder = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n    files = [\n        f for f in folder.rglob(\"*.parquet\")\n        if any(f\"synthetic_mainline_{d}\" in f.name for d in target_dates)\n    ]\n    if not files:\n        raise RuntimeError(f\"No target state files found for {panel}\")\n\n    parts = [\n        pd.read_parquet(\n            f,\n            columns=[\n                \"timestamp\", \"link_id\", \"speed_kmh\",\n                \"is_score_eligible\", \"is_imputed\", \"is_missing\",\n            ],\n        )\n        for f in files\n    ]\n    states = pd.concat(parts, ignore_index=True)\n    states[\"timestamp\"] = pd.to_datetime(states[\"timestamp\"], utc=True)\n    states = states[states[\"timestamp\"].isin(target_times)].copy()\n\n    fd = pd.read_csv(\n        ROOT / \"corridors\" / panel / \"network\" / \"fd_parameters.csv\"\n    )[[\"link_id\", \"free_speed_kmh\"]]\n\n    states = states.merge(\n        fd, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    states[\"speed_kmh\"] = pd.to_numeric(states[\"speed_kmh\"], errors=\"coerce\")\n\n    states[\"label_valid\"] = (\n        states[\"is_score_eligible\"].eq(1)\n        & states[\"is_imputed\"].eq(0)\n        & states[\"is_missing\"].eq(0)\n        & states[\"speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].notna()\n        & states[\"free_speed_kmh\"].gt(0)\n    )\n\n    states[\"queue_label\"] = (\n        states[\"speed_kmh\"] <= 0.60 * states[\"free_speed_kmh\"]\n    ).astype(\"int8\")\n\n    labels = horizon.merge(\n        fd[[\"link_id\"]], how=\"cross\"\n    ).merge(\n        states[[\n            \"timestamp\", \"link_id\", \"speed_kmh\",\n            \"free_speed_kmh\", \"label_valid\", \"queue_label\",\n        ]],\n        on=[\"timestamp\", \"link_id\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    labels[\"label_valid\"] = labels[\"label_valid\"].fillna(False)\n    labels.loc[~labels[\"label_valid\"], \"queue_label\"] = np.nan\n    labels[\"panel\"] = panel\n\n    # One CSV per panel, including invalid cells marked by label_valid=False\n    labels.to_csv(OUT / f\"{panel}_train_labels.csv\", index=False)\n    all_labels.append(labels)\n\n    print(\n        f\"  Cells: {len(labels):,} | \"\n        f\"Valid: {int(labels['label_valid'].sum()):,} | \"\n        f\"Coverage: {labels['label_valid'].mean():.1%}\"\n    )\n\ncombined = pd.concat(all_labels, ignore_index=True)\ncombined.to_csv(OUT / \"all_panels_train_labels.csv\", index=False)\n\nprint(\"\\n=== PHASE 2 SUMMARY ===\")\nprint(\"Total label cells:\", f\"{len(combined):,}\")\nprint(\"Valid label cells:\", f\"{int(combined['label_valid'].sum()):,}\")\nprint(\"Invalid/missing cells:\", f\"{int((~combined['label_valid']).sum()):,}\")\nprint(\"Saved to:\", OUT)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:13:45.781228Z","iopub.execute_input":"2026-10-24T08:13:45.781485Z","iopub.status.idle":"2026-10-24T08:13:48.840656Z","shell.execute_reply.started":"2026-10-24T08:13:45.781466Z","shell.execute_reply":"2026-10-24T08:13:48.839581Z"}},"outputs":[{"name":"stdout","text":"Building labels: D7_I10_E\n  Cells: 8,760 | Valid: 5,533 | Coverage: 63.2%\nBuilding labels: D7_I10_W\n  Cells: 6,420 | Valid: 4,149 | Coverage: 64.6%\nBuilding labels: D7_I210_E\n  Cells: 17,820 | Valid: 11,421 | Coverage: 64.1%\nBuilding labels: D7_I210_W\n  Cells: 4,860 | Valid: 3,068 | Coverage: 63.1%\nBuilding labels: D7_I405_N\n  Cells: 21,120 | Valid: 13,325 | Coverage: 63.1%\nBuilding labels: D7_I405_S\n  Cells: 6,540 | Valid: 4,144 | Coverage: 63.4%\nBuilding labels: D12_I5_N\n  Cells: 15,480 | Valid: 9,882 | Coverage: 63.8%\nBuilding labels: D12_I5_S\n  Cells: 6,000 | Valid: 3,840 | Coverage: 64.0%\n\n=== PHASE 2 SUMMARY ===\nTotal label cells: 87,000\nValid label cells: 55,362\nInvalid/missing cells: 31,638\nSaved to: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\n\nbase = ROOT / \"task2\" / PANEL / \"train\"\n\n# Load released history, window metadata, network free-flow speeds, and labels\nhistory = pd.read_parquet(base / \"window_history.parquet\")\nwindows = pd.read_csv(base / \"window_index.csv\")\nlabels = pd.read_csv(OUT / f\"{PANEL}_train_labels.csv\")\nfd = pd.read_csv(\n    ROOT / \"corridors\" / PANEL / \"network\" / \"fd_parameters.csv\"\n)\n\nhistory[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\nwindows[\"origin\"] = pd.to_datetime(windows[\"forecast_origin\"], utc=True)\n\nhistory = history.merge(\n    fd[[\"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\"]],\n    on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nhistory = history.merge(\n    windows[[\"window_id\", \"origin\"]],\n    on=\"window_id\", how=\"left\", validate=\"many_to_one\"\n)\n\n# Only history at or before T-5 is actually present in the released file.\nhistory[\"minutes_before_origin\"] = (\n    history[\"origin\"] - history[\"timestamp\"]\n).dt.total_seconds() / 60\n\n# Derive normalized speed and flow.\nhistory[\"speed_kmh\"] = pd.to_numeric(history[\"speed_kmh\"], errors=\"coerce\")\nhistory[\"flow_vph\"] = pd.to_numeric(history[\"flow_vph\"], errors=\"coerce\")\nhistory[\"occupancy\"] = pd.to_numeric(history[\"occupancy\"], errors=\"coerce\")\n\nhistory[\"speed_ratio\"] = (\n    history[\"speed_kmh\"] / history[\"free_speed_kmh\"]\n)\nhistory[\"flow_ratio\"] = (\n    history[\"flow_vph\"] / history[\"capacity_vph\"]\n)\n\n# Explicitly order time within each window/link.\nhistory = history.sort_values(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).copy()\n\ngroup_cols = [\"window_id\", \"link_id\"]\ng = history.groupby(group_cols, sort=False)\n\n# Latest observed history row (normally T-5).\nlatest = history.groupby(group_cols, sort=False).tail(1).copy()\nlatest = latest.rename(columns={\n    \"speed_ratio\": \"speed_ratio_latest\",\n    \"flow_ratio\": \"flow_ratio_latest\",\n    \"occupancy\": \"occupancy_latest\",\n    \"speed_kmh\": \"speed_latest\",\n    \"flow_vph\": \"flow_latest\",\n    \"pct_observed\": \"pct_observed_latest\",\n    \"is_score_eligible\": \"eligible_latest\",\n})\n\n# Aggregates over the latest 3 and 6 history steps.\nfeatures = latest[\n    [\"window_id\", \"link_id\", \"free_speed_kmh\", \"capacity_vph\",\n     \"length_km\", \"lanes\", \"speed_ratio_latest\", \"flow_ratio_latest\",\n     \"occupancy_latest\", \"speed_latest\", \"flow_latest\",\n     \"pct_observed_latest\", \"eligible_latest\"]\n].copy()\n\nfor n_steps, prefix in [(3, \"last3\"), (6, \"last6\")]:\n    recent = history.groupby(group_cols, sort=False).tail(n_steps)\n    agg = recent.groupby(group_cols).agg(\n        speed_ratio_mean=(\"speed_ratio\", \"mean\"),\n        speed_ratio_std=(\"speed_ratio\", \"std\"),\n        flow_ratio_mean=(\"flow_ratio\", \"mean\"),\n        occupancy_mean=(\"occupancy\", \"mean\"),\n        pct_observed_mean=(\"pct_observed\", \"mean\"),\n        eligible_fraction=(\"is_score_eligible\", \"mean\"),\n        observed_speed_fraction=(\"speed_kmh\", lambda x: x.notna().mean()),\n    ).reset_index()\n\n    agg = agg.rename(columns={\n        c: f\"{prefix}_{c}\" for c in agg.columns\n        if c not in group_cols\n    })\n    features = features.merge(\n        agg, on=group_cols, how=\"left\", validate=\"one_to_one\"\n    )\n\n# Trend: change in normalized speed from the first to latest history row.\nfirst = history.groupby(group_cols, sort=False).head(1)[\n    group_cols + [\"speed_ratio\"]\n].rename(columns={\"speed_ratio\": \"speed_ratio_first\"})\n\nfeatures = features.merge(\n    first, on=group_cols, how=\"left\", validate=\"one_to_one\"\n)\nfeatures[\"speed_ratio_change\"] = (\n    features[\"speed_ratio_latest\"] - features[\"speed_ratio_first\"]\n)\n\n# Expand features over the six forecast steps.\nfeatures[\"key\"] = 1\nsteps = pd.DataFrame({\"horizon_step\": range(1, 7), \"key\": [1] * 6})\nfeatures = features.merge(steps, on=\"key\").drop(columns=\"key\")\n\n# Attach labels using the exact window/link/time key.\nlabels[\"timestamp\"] = pd.to_datetime(labels[\"timestamp\"], utc=True)\nfeatures = features.merge(\n    labels[[\n        \"window_id\", \"link_id\", \"timestamp\", \"horizon_step\",\n        \"queue_label\", \"label_valid\", \"condition\"\n    ]],\n    on=[\"window_id\", \"link_id\", \"horizon_step\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\n# Audit: label timestamp must equal origin + 5 * horizon_step minutes.\norigin_map = windows.set_index(\"window_id\")[\"origin\"]\nfeatures[\"expected_timestamp\"] = (\n    features[\"window_id\"].map(origin_map)\n    + pd.to_timedelta(features[\"horizon_step\"] * 5, unit=\"min\")\n)\n\nassert features[\"timestamp\"].equals(features[\"expected_timestamp\"]), (\n    \"Label timestamp mismatch: stop and investigate.\"\n)\nassert not features.duplicated(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).any(), \"Duplicate feature/label keys found.\"\n\nout_file = OUT / f\"{PANEL}_train_features.csv\"\nfeatures.to_csv(out_file, index=False)\n\nprint(\"Feature rows:\", len(features))\nprint(\"Unique links per window:\", features.groupby(\"window_id\")[\"link_id\"].nunique().to_dict())\nprint(\"Valid labels:\", int(features[\"label_valid\"].fillna(False).sum()))\nprint(\"Feature columns:\", len(features.columns))\nprint(\"Missing feature values (top 10):\")\nprint(features.isna().sum().sort_values(ascending=False).head(10).to_string())\nprint(\"Saved:\", out_file)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:44:56.760848Z","iopub.execute_input":"2026-10-24T08:44:56.761269Z","iopub.status.idle":"2026-10-24T08:44:57.507766Z","shell.execute_reply.started":"2026-10-24T08:44:56.761246Z","shell.execute_reply":"2026-10-24T08:44:57.506874Z"}},"outputs":[{"name":"stdout","text":"Feature rows: 8760\nUnique links per window: {'Q2_D7_I10_E_train_001': 146, 'Q2_D7_I10_E_train_002': 146, 'Q2_D7_I10_E_train_003': 146, 'Q2_D7_I10_E_train_004': 146, 'Q2_D7_I10_E_train_005': 146, 'Q2_D7_I10_E_train_006': 146, 'Q2_D7_I10_E_train_007': 146, 'Q2_D7_I10_E_train_008': 146, 'Q2_D7_I10_E_train_009': 146, 'Q2_D7_I10_E_train_010': 146}\nValid labels: 5533\nFeature columns: 35\nMissing feature values (top 10):\nqueue_label               3227\nspeed_ratio_change        2700\nspeed_ratio_latest        1518\nflow_latest               1518\nflow_ratio_latest         1518\noccupancy_latest          1518\nspeed_latest              1518\nspeed_ratio_first         1470\nlast3_speed_ratio_std      900\nlast3_speed_ratio_mean     396\nSaved: /kaggle/working/task2_training_labels/D7_I10_E_train_features.csv\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# Rebuild the feature-label join with the exact timestamp key.\n# Uses existing features, labels, and windows from the previous cell.\n\nlabel_cols = [\n    \"window_id\", \"link_id\", \"timestamp\",\n    \"horizon_step\", \"queue_label\", \"label_valid\", \"condition\"\n]\n\nlabels_check = labels[label_cols].copy()\nlabels_check[\"timestamp\"] = pd.to_datetime(\n    labels_check[\"timestamp\"], utc=True\n)\n\nbase_features = features.drop(\n    columns=[\n        \"timestamp\", \"horizon_step\", \"queue_label\",\n        \"label_valid\", \"condition\", \"expected_timestamp\"\n    ],\n    errors=\"ignore\"\n).copy()\n\nbase_features[\"origin\"] = base_features[\"window_id\"].map(\n    windows.set_index(\"window_id\")[\"origin\"]\n)\n\nbase_features[\"horizon_step\"] = features[\"horizon_step\"].to_numpy()\nbase_features[\"timestamp\"] = (\n    base_features[\"origin\"]\n    + pd.to_timedelta(base_features[\"horizon_step\"] * 5, unit=\"min\")\n)\n\ncorrected = base_features.merge(\n    labels_check,\n    on=[\"window_id\", \"link_id\", \"timestamp\", \"horizon_step\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nprint(\"Corrected rows:\", len(corrected))\nprint(\"Missing label matches:\", int(corrected[\"label_valid\"].isna().sum()))\nprint(\"Valid labels:\", int(corrected[\"label_valid\"].fillna(False).sum()))\nprint(\"Duplicate keys:\", int(\n    corrected.duplicated([\"window_id\", \"link_id\", \"timestamp\"]).sum()\n))\n\nassert len(corrected) == 8760\nassert corrected[\"label_valid\"].notna().all(), (\n    \"Some feature rows failed to match labels.\"\n)\nassert not corrected.duplicated(\n    [\"window_id\", \"link_id\", \"timestamp\"]\n).any()\n\nout_file = OUT / f\"{PANEL}_train_features.csv\"\ncorrected.to_csv(out_file, index=False)\nprint(\"Saved corrected features:\", out_file)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:45:49.953872Z","iopub.execute_input":"2026-10-24T08:45:49.954181Z","iopub.status.idle":"2026-10-24T08:45:50.331739Z","shell.execute_reply.started":"2026-10-24T08:45:49.954159Z","shell.execute_reply":"2026-10-24T08:45:50.331023Z"}},"outputs":[{"name":"stdout","text":"Corrected rows: 8760\nMissing label matches: 0\nValid labels: 5533\nDuplicate keys: 0\nSaved corrected features: /kaggle/working/task2_training_labels/D7_I10_E_train_features.csv\n","output_type":"stream"}],"execution_count":29},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport joblib\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.ensemble import HistGradientBoostingClassifier\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\nOUT = Path(\"/kaggle/working/task2_training_labels\")\nPANEL = \"D7_I10_E\"\ndf = pd.read_csv(OUT / f\"{PANEL}_train_features.csv\")\n\n# Keep only rows with valid supervised labels.\ndf = df[df[\"label_valid\"].eq(True)].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# Hold out whole windows, not individual rows.\n# Use two ongoing windows and one onset window for validation.\nvalid_windows = [\n    \"Q2_D7_I10_E_train_003\",\n    \"Q2_D7_I10_E_train_007\",\n    \"Q2_D7_I10_E_train_009\",\n]\ntrain = df[~df[\"window_id\"].isin(valid_windows)].copy()\nvalid = df[df[\"window_id\"].isin(valid_windows)].copy()\n\n# Remove identifiers, target fields, timestamps, and strings from predictors.\ndrop_cols = {\n    \"window_id\", \"panel\", \"condition\", \"forecast_origin\", \"timestamp\",\n    \"expected_timestamp\", \"queue_label\", \"label_valid\", \"origin\",\n    \"link_id\", \"free_speed_kmh\", \"capacity_vph\", \"length_km\", \"lanes\",\n}\nfeature_cols = [\n    c for c in df.columns\n    if c not in drop_cols and pd.api.types.is_numeric_dtype(df[c])\n]\n\nX_train = train[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_train = train[\"queue_label\"]\nX_valid = valid[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_valid = valid[\"queue_label\"]\n\nprint(\"Train rows:\", len(train), \"| Validation rows:\", len(valid))\nprint(\"Training queue prevalence:\", round(float(y_train.mean()), 4))\nprint(\"Validation queue prevalence:\", round(float(y_valid.mean()), 4))\nprint(\"Features:\", len(feature_cols))\nprint(\"Training windows:\", sorted(train[\"window_id\"].unique()))\nprint(\"Validation windows:\", sorted(valid[\"window_id\"].unique()))\n\nif y_train.nunique() < 2:\n    raise ValueError(\"Training split contains only one class.\")\n\nmodel = Pipeline([\n    (\"imputer\", SimpleImputer(strategy=\"median\", add_indicator=True)),\n    (\"classifier\", HistGradientBoostingClassifier(\n        max_iter=150,\n        learning_rate=0.08,\n        max_leaf_nodes=15,\n        l2_regularization=2.0,\n        random_state=42,\n    )),\n])\n\nmodel.fit(X_train, y_train)\nprob = model.predict_proba(X_valid)[:, 1]\n\ndef mean_window_iou(y, p, window_ids, threshold):\n    scores = []\n    for window_id in pd.unique(window_ids):\n        mask = np.asarray(window_ids == window_id)\n        yt = np.asarray(y)[mask].astype(bool)\n        yp = (np.asarray(p)[mask] >= threshold)\n        union = np.logical_or(yt, yp).sum()\n        inter = np.logical_and(yt, yp).sum()\n        scores.append(inter / union if union else 1.0)\n    return float(np.mean(scores)), scores\n\nthresholds = np.arange(0.05, 0.81, 0.025)\nresults = []\nfor threshold in thresholds:\n    score, per_window = mean_window_iou(\n        y_valid.to_numpy(),\n        prob,\n        valid[\"window_id\"].to_numpy(),\n        threshold,\n    )\n    results.append((score, threshold, per_window))\n\nbest_score, best_threshold, best_per_window = max(\n    results, key=lambda x: x[0]\n)\n\nprint(\"\\n=== VALIDATION RESULTS ===\")\nprint(\"Mean per-window IoU:\", round(best_score, 4))\nprint(\"Selected threshold:\", round(float(best_threshold), 3))\n\nfor wid, score in zip(pd.unique(valid[\"window_id\"]), best_per_window):\n    condition = valid.loc[valid[\"window_id\"] == wid, \"condition\"].iloc[0]\n    print(wid, \"|\", condition, \"| IoU:\", round(score, 4))\n\nif y_valid.nunique() > 1:\n    print(\"ROC-AUC:\", round(roc_auc_score(y_valid, prob), 4))\n    print(\"PR-AUC:\", round(average_precision_score(y_valid, prob), 4))\n\nartifact = {\n    \"model\": model,\n    \"feature_cols\": feature_cols,\n    \"threshold\": float(best_threshold),\n    \"panel\": PANEL,\n    \"validation_windows\": valid_windows,\n}\njoblib.dump(artifact, OUT / f\"{PANEL}_baseline.joblib\")\n\nreport = {\n    \"panel\": PANEL,\n    \"train_rows\": len(train),\n    \"validation_rows\": len(valid),\n    \"feature_count\": len(feature_cols),\n    \"validation_windows\": valid_windows,\n    \"mean_window_iou\": best_score,\n    \"threshold\": float(best_threshold),\n    \"per_window_iou\": {\n        wid: float(score)\n        for wid, score in zip(pd.unique(valid[\"window_id\"]), best_per_window)\n    },\n}\n(OUT / f\"{PANEL}_baseline_report.json\").write_text(\n    json.dumps(report, indent=2)\n)\n\nprint(\"\\nSaved model:\", OUT / f\"{PANEL}_baseline.joblib\")\nprint(\"Saved report:\", OUT / f\"{PANEL}_baseline_report.json\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:46:33.850533Z","iopub.execute_input":"2026-10-24T08:46:33.850814Z","iopub.status.idle":"2026-10-24T08:46:38.207708Z","shell.execute_reply.started":"2026-10-24T08:46:33.850793Z","shell.execute_reply":"2026-10-24T08:46:38.20616Z"}},"outputs":[{"name":"stdout","text":"Train rows: 3888 | Validation rows: 1645\nTraining queue prevalence: 0.0571\nValidation queue prevalence: 0.2553\nFeatures: 24\nTraining windows: ['Q2_D7_I10_E_train_001', 'Q2_D7_I10_E_train_002', 'Q2_D7_I10_E_train_004', 'Q2_D7_I10_E_train_005', 'Q2_D7_I10_E_train_006', 'Q2_D7_I10_E_train_008', 'Q2_D7_I10_E_train_010']\nValidation windows: ['Q2_D7_I10_E_train_003', 'Q2_D7_I10_E_train_007', 'Q2_D7_I10_E_train_009']\n\n=== VALIDATION RESULTS ===\nMean per-window IoU: 0.5951\nSelected threshold: 0.725\nQ2_D7_I10_E_train_003 | queue_onset | IoU: 0.0\nQ2_D7_I10_E_train_007 | queue_ongoing | IoU: 0.9107\nQ2_D7_I10_E_train_009 | queue_ongoing | IoU: 0.8746\nROC-AUC: 0.9901\nPR-AUC: 0.9798\n\nSaved model: /kaggle/working/task2_training_labels/D7_I10_E_baseline.joblib\nSaved report: /kaggle/working/task2_training_labels/D7_I10_E_baseline_report.json\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\n# Inspect all validation predictions by window and forecast horizon.\nonset_id = \"Q2_D7_I10_E_train_003\"\nmask = valid[\"window_id\"].to_numpy() == onset_id\n\nonset = valid.loc[mask].copy()\nonset[\"y_true\"] = y_valid.to_numpy()[mask]\nonset[\"probability\"] = prob[mask]\n\nprint(\n    onset.groupby(\"horizon_step\").agg(\n        rows=(\"y_true\", \"size\"),\n        queued=(\"y_true\", \"sum\"),\n        max_probability=(\"probability\", \"max\"),\n        mean_probability=(\"probability\", \"mean\"),\n    ).round(4).to_string()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:48:19.240572Z","iopub.execute_input":"2026-10-24T08:48:19.240854Z","iopub.status.idle":"2026-10-24T08:48:19.259428Z","shell.execute_reply.started":"2026-10-24T08:48:19.240832Z","shell.execute_reply":"2026-10-24T08:48:19.258444Z"}},"outputs":[{"name":"stdout","text":"              rows  queued  max_probability  mean_probability\nhorizon_step                                                 \n1               95       0           0.0027            0.0002\n2               90       0           0.0027            0.0002\n3               91       0           0.0016            0.0002\n4               93       0           0.0034            0.0003\n5               95       0           0.0037            0.0003\n6               92       3           0.0300            0.0017\n","output_type":"stream"}],"execution_count":34},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\n# Explicitly exclude labels, target speed, identifiers, and timestamps.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in train.columns\n    if c not in exclude\n    and c in valid.columns\n    and pd.api.types.is_numeric_dtype(train[c])\n]\n\n# Use only rows with known labels.\ntr = train.loc[train[\"queue_label\"].notna()].copy()\nva = valid.loc[valid[\"queue_label\"].notna()].copy()\n\nX_train = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_train = tr[\"queue_label\"].astype(int)\n\nX_valid = va[feature_cols].replace([np.inf, -np.inf], np.nan)\ny_valid_lgb = va[\"queue_label\"].astype(int)\n\n# Give the rare positive class more weight.\nn_pos = int(y_train.sum())\nn_neg = len(y_train) - n_pos\nscale_pos_weight = n_neg / max(n_pos, 1)\n\nmodel_lgb = lgb.LGBMClassifier(\n    n_estimators=500,\n    learning_rate=0.03,\n    num_leaves=15,\n    max_depth=-1,\n    min_child_samples=30,\n    colsample_bytree=0.9,\n    subsample=0.9,\n    reg_lambda=2.0,\n    scale_pos_weight=scale_pos_weight,\n    random_state=42,\n    verbosity=-1,\n)\n\nmodel_lgb.fit(X_train, y_train)\n\nvalid_prob_lgb = model_lgb.predict_proba(X_valid)[:, 1]\n\nprint(\"Features:\", len(feature_cols))\nprint(\"Positive-class weight:\", round(scale_pos_weight, 2))\nprint(\"Validation ROC-AUC:\", round(\n    roc_auc_score(y_valid_lgb, valid_prob_lgb), 4\n))\nprint(\"Validation PR-AUC:\", round(\n    average_precision_score(y_valid_lgb, valid_prob_lgb), 4\n))\n\n# Score each complete validation window separately.\nresults = []\nfor wid in va[\"window_id\"].unique():\n    m = va[\"window_id\"].to_numpy() == wid\n    yt = y_valid_lgb.to_numpy()[m]\n    yp = valid_prob_lgb[m] >= 0.5\n\n    intersection = np.sum(yt * yp)\n    union = np.sum((yt == 1) | yp)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": va.loc[m, \"condition\"].iloc[0],\n        \"queued_true\": int(yt.sum()),\n        \"queued_pred\": int(yp.sum()),\n        \"IoU_at_0.5\": round(float(iou), 4),\n    })\n\nresults_df = pd.DataFrame(results)\nprint(\"\\n\", results_df.to_string(index=False))\nprint(\n    \"\\nMean per-window IoU @ 0.5:\",\n    round(results_df[\"IoU_at_0.5\"].mean(), 4)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:50:38.937546Z","iopub.execute_input":"2026-10-24T08:50:38.937855Z","iopub.status.idle":"2026-10-24T08:50:42.502378Z","shell.execute_reply.started":"2026-10-24T08:50:38.937832Z","shell.execute_reply":"2026-10-24T08:50:42.501672Z"}},"outputs":[{"name":"stdout","text":"Features: 24\nPositive-class weight: 16.51\nValidation ROC-AUC: 0.9887\nValidation PR-AUC: 0.9736\n\n             window_id     condition  queued_true  queued_pred  IoU_at_0.5\nQ2_D7_I10_E_train_003   queue_onset            3            0      0.0000\nQ2_D7_I10_E_train_007 queue_ongoing          109          112      0.9217\nQ2_D7_I10_E_train_009 queue_ongoing          308          354      0.8389\n\nMean per-window IoU @ 0.5: 0.5869\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"import numpy as np\n\nbest_score = -1\nbest_threshold = None\n\nfor threshold in np.arange(0.01, 0.96, 0.01):\n    scores = []\n\n    for wid in va[\"window_id\"].unique():\n        m = va[\"window_id\"].to_numpy() == wid\n        y = y_valid_lgb.to_numpy()[m]\n        pred = valid_prob_lgb[m] >= threshold\n\n        union = np.sum((y == 1) | pred)\n        intersection = np.sum((y == 1) & pred)\n        scores.append(intersection / union if union else 1.0)\n\n    mean_iou = float(np.mean(scores))\n\n    if mean_iou > best_score:\n        best_score = mean_iou\n        best_threshold = float(threshold)\n\nprint(\"Best threshold:\", round(best_threshold, 2))\nprint(\"Best mean per-window IoU:\", round(best_score, 4))\n\nfor wid in va[\"window_id\"].unique():\n    m = va[\"window_id\"].to_numpy() == wid\n    y = y_valid_lgb.to_numpy()[m]\n    pred = valid_prob_lgb[m] >= best_threshold\n    union = np.sum((y == 1) | pred)\n    intersection = np.sum((y == 1) & pred)\n    iou = intersection / union if union else 1.0\n    print(wid, \"| predicted:\", int(pred.sum()), \"| IoU:\", round(float(iou), 4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:51:28.24556Z","iopub.execute_input":"2026-10-24T08:51:28.24614Z","iopub.status.idle":"2026-10-24T08:51:28.283791Z","shell.execute_reply.started":"2026-10-24T08:51:28.246117Z","shell.execute_reply":"2026-10-24T08:51:28.283026Z"}},"outputs":[{"name":"stdout","text":"Best threshold: 0.66\nBest mean per-window IoU: 0.5959\nQ2_D7_I10_E_train_003 | predicted: 0 | IoU: 0.0\nQ2_D7_I10_E_train_007 | predicted: 109 | IoU: 0.9464\nQ2_D7_I10_E_train_009 | predicted: 353 | IoU: 0.8412\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\n# Load the existing feature + label dataset for D7_I10_E.\nDATA_PATH = Path(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features.csv\"\n)\ndf = pd.read_csv(DATA_PATH)\n\n# Keep only rows with valid labels.\ndf = df[df[\"label_valid\"].astype(bool)].copy()\ndf = df[df[\"queue_label\"].notna()].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# Never use target-derived values or identifiers as model features.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\n# Report label coverage before training.\nprint(\"Valid labelled rows:\", len(df))\nprint(\"Features:\", len(feature_cols))\nprint(\"\\nWindow label counts:\")\nprint(\n    df.groupby([\"window_id\", \"condition\"])[\"queue_label\"]\n      .agg(rows=\"size\", queued=\"sum\", prevalence=\"mean\")\n      .round(4)\n      .to_string()\n)\n\n# Leave one complete window out per fold.\nwindows = sorted(df[\"window_id\"].unique())\noof_parts = []\n\nfor i, heldout_window in enumerate(windows, start=1):\n    train_fold = df[df[\"window_id\"] != heldout_window]\n    val_fold = df[df[\"window_id\"] == heldout_window]\n\n    X_train = train_fold[feature_cols].replace(\n        [np.inf, -np.inf], np.nan\n    )\n    y_train = train_fold[\"queue_label\"]\n\n    X_val = val_fold[feature_cols].replace(\n        [np.inf, -np.inf], np.nan\n    )\n    y_val = val_fold[\"queue_label\"].to_numpy()\n\n    positives = int(y_train.sum())\n    negatives = len(y_train) - positives\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=negatives / max(positives, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X_train, y_train)\n\n    fold_out = val_fold[\n        [\"window_id\", \"condition\", \"horizon_step\", \"queue_label\"]\n    ].copy()\n    fold_out[\"probability\"] = model.predict_proba(X_val)[:, 1]\n    oof_parts.append(fold_out)\n\n    print(f\"Completed fold {i}/{len(windows)}: {heldout_window}\")\n\n# Combine out-of-fold predictions.\noof = pd.concat(oof_parts, ignore_index=True)\noof.to_csv(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_lightgbm_oof.csv\",\n    index=False,\n)\n\n# Evaluate each held-out window at a fixed threshold of 0.5.\nresults = []\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU_at_0.5\": round(float(iou), 4),\n    })\n\nresults_df = pd.DataFrame(results)\nprint(\"\\n=== LEAVE-ONE-WINDOW-OUT RESULTS ===\")\nprint(results_df.to_string(index=False))\nprint(\n    \"\\nMean per-window IoU @ 0.5:\",\n    round(results_df[\"IoU_at_0.5\"].mean(), 4),\n)\n\nprint(\"\\nMean IoU by condition:\")\nprint(results_df.groupby(\"condition\")[\"IoU_at_0.5\"].mean().round(4))\n\nprint(\"\\nSaved OOF predictions to D7_I10_E_lightgbm_oof.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:53:57.840425Z","iopub.execute_input":"2026-10-24T08:53:57.840772Z","iopub.status.idle":"2026-10-24T08:54:01.301754Z","shell.execute_reply.started":"2026-10-24T