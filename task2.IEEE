td>D7_I405_N</td>\n      <td>L405N-041</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>34</th>\n      <td>D7_I405_N</td>\n      <td>L405N-145</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>35</th>\n      <td>D7_I405_N</td>\n      <td>L405N-080</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>36</th>\n      <td>D7_I405_N</td>\n      <td>L405N-082</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>37</th>\n      <td>D7_I405_N</td>\n      <td>L405N-217</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>38</th>\n      <td>D7_I405_N</td>\n      <td>L405N-234</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>39</th>\n      <td>D7_I405_N</td>\n      <td>L405N-235</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>40</th>\n      <td>D7_I405_N</td>\n      <td>L405N-392</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>41</th>\n      <td>D7_I405_S</td>\n      <td>L405S-001</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>42</th>\n      <td>D7_I405_S</td>\n      <td>L405S-065</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>43</th>\n      <td>D7_I405_S</td>\n      <td>L405S-373</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>44</th>\n      <td>D7_I405_S</td>\n      <td>L405S-017</td>\n      <td>2</td>\n      <td>2</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>45</th>\n      <td>D7_I405_S</td>\n      <td>L405S-317</td>\n      <td>2</td>\n      <td>2</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>46</th>\n      <td>D7_I405_S</td>\n      <td>L405S-319</td>\n      <td>2</td>\n      <td>2</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>47</th>\n      <td>D7_I405_S</td>\n      <td>L405S-336</td>\n      <td>2</td>\n      <td>2</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>48</th>\n      <td>D7_I405_S</td>\n      <td>L405S-056</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>49</th>\n      <td>D7_I405_S</td>\n      <td>L405S-127</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>50</th>\n      <td>D7_I405_S</td>\n      <td>L405S-260</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":96},{"cell_type":"code","source":"# Verify where positive onset labels actually occur\npositive_onset = onset[onset[\"queue_label\"] == 1]\n\nprint(\"Positive onset rows:\", len(positive_onset))\nprint(\"\\nPositive rows by horizon:\")\ndisplay(positive_onset[\"horizon_step\"].value_counts().sort_index())\n\nprint(\"\\nPositive link-horizon combinations:\")\ndisplay(\n    positive_onset.groupby([\"panel\", \"horizon_step\"])\n    .agg(\n        positive_rows=(\"queue_label\", \"size\"),\n        unique_links=(\"link_id\", \"nunique\"),\n        unique_windows=(\"window_id\", \"nunique\"),\n    )\n    .reset_index()\n)\n\nassert positive_onset[\"horizon_step\"].eq(6).all(), (\n    \"Unexpected positive onset labels outside horizon 6.\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:40:49.460648Z","iopub.execute_input":"2026-10-24T10:40:49.460942Z","iopub.status.idle":"2026-10-24T10:40:49.4844Z","shell.execute_reply.started":"2026-10-24T10:40:49.460914Z","shell.execute_reply":"2026-10-24T10:40:49.483732Z"}},"outputs":[{"name":"stdout","text":"Positive onset rows: 100\n\nPositive rows by horizon:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"horizon_step\n6    100\nName: count, dtype: int64"},"metadata":{}},{"name":"stdout","text":"\nPositive link-horizon combinations:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"       panel  horizon_step  positive_rows  unique_links  unique_windows\n0   D12_I5_N             6              9             6               5\n1   D12_I5_S             6             10             7               4\n2   D7_I10_E             6             18             7               5\n3   D7_I10_W             6              3             1               3\n4  D7_I210_E             6             19             5               5\n5  D7_I210_W             6              9             7               5\n6  D7_I405_N             6             12             8               5\n7  D7_I405_S             6             20            10               5","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>panel</th>\n      <th>horizon_step</th>\n      <th>positive_rows</th>\n      <th>unique_links</th>\n      <th>unique_windows</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>D12_I5_N</td>\n      <td>6</td>\n      <td>9</td>\n      <td>6</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>D12_I5_S</td>\n      <td>6</td>\n      <td>10</td>\n      <td>7</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>D7_I10_E</td>\n      <td>6</td>\n      <td>18</td>\n      <td>7</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>D7_I10_W</td>\n      <td>6</td>\n      <td>3</td>\n      <td>1</td>\n      <td>3</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>D7_I210_E</td>\n      <td>6</td>\n      <td>19</td>\n      <td>5</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>D7_I210_W</td>\n      <td>6</td>\n      <td>9</td>\n      <td>7</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>D7_I405_N</td>\n      <td>6</td>\n      <td>12</td>\n      <td>8</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>D7_I405_S</td>\n      <td>6</td>\n      <td>20</td>\n      <td>10</td>\n      <td>5</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":98},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    df = pd.read_csv(BASE / f\"{panel}_train_features_spatial.csv\")\n    df[\"panel\"] = panel\n    df = df[df[\"label_valid\"].astype(bool)].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n    data[panel] = df\n    feature_sets.append(\n        set(df.select_dtypes(include=[np.number]).columns) - EXCLUDE\n    )\n\nFEATURES = sorted(set.intersection(*feature_sets))\nassert len(FEATURES) == 42, f\"Expected 42 features, got {len(FEATURES)}\"\n\ndef make_model(weight):\n    return lgb.LGBMClassifier(\n        objective=\"binary\",\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=weight,\n        random_state=42,\n        verbosity=-1,\n    )\n\npredictions = []\n\nfor panel in PANELS:\n    df = data[panel]\n    windows = sorted(df[\"window_id\"].unique())\n\n    for held_out in windows:\n        train = df[df[\"window_id\"] != held_out].copy()\n        test = df[df[\"window_id\"] == held_out].copy()\n\n        # Baseline model: all conditions and horizons.\n        positives = int(train[\"queue_label\"].sum())\n        negatives = len(train) - positives\n\n        baseline = make_model(negatives / max(positives, 1))\n        baseline.fit(train[FEATURES], train[\"queue_label\"])\n        baseline_prob = baseline.predict_proba(test[FEATURES])[:, 1]\n        baseline_pred = (baseline_prob >= 0.50).astype(int)\n\n        # Dedicated model: horizon-6 queue-onset rows only.\n        onset_train = train[\n            (train[\"condition\"] == \"queue_onset\")\n            & (train[\"horizon_step\"] == 6)\n        ].copy()\n\n        onset_mask = (\n            (test[\"condition\"] == \"queue_onset\")\n            & (test[\"horizon_step\"] == 6)\n        ).to_numpy()\n\n        specialized_pred = baseline_pred.copy()\n\n        # By the verified label audit, onset horizons 1–5 have no positives.\n        other_onset_mask = (\n            (test[\"condition\"] == \"queue_onset\")\n            & (test[\"horizon_step\"] != 6)\n        ).to_numpy()\n        specialized_pred[other_onset_mask] = 0\n\n        # Predict only when the held-out fold has rows and training has both classes.\n        if onset_mask.sum() > 0 and onset_train[\"queue_label\"].nunique() == 2:\n            pos = int(onset_train[\"queue_label\"].sum())\n            neg = len(onset_train) - pos\n\n            specialized = make_model(neg / max(pos, 1))\n            specialized.fit(\n                onset_train[FEATURES],\n                onset_train[\"queue_label\"]\n            )\n\n            specialized_prob = specialized.predict_proba(\n                test.iloc[np.flatnonzero(onset_mask)][FEATURES]\n            )[:, 1]\n\n            specialized_pred[np.flatnonzero(onset_mask)] = (\n                specialized_prob >= 0.50\n            ).astype(int)\n\n        elif onset_mask.sum() > 0:\n            # If a fold's training labels contain only one class, predict\n            # the sole observed class for its horizon-6 onset rows.\n            only_class = int(onset_train[\"queue_label\"].iloc[0])\n            specialized_pred[np.flatnonzero(onset_mask)] = only_class\n\n        fold = test[\n            [\"panel\", \"window_id\", \"condition\", \"horizon_step\", \"queue_label\"]\n        ].copy()\n        fold[\"baseline_pred\"] = baseline_pred\n        fold[\"specialized_pred\"] = specialized_pred\n        predictions.append(fold)\n\npred = pd.concat(predictions, ignore_index=True)\npred = pred.rename(columns={\"queue_label\": \"y_true\"})\n\ndef score_predictions(frame, prediction_col):\n    scores = []\n\n    for (panel, window, condition), group in frame.groupby(\n        [\"panel\", \"window_id\", \"condition\"], dropna=False\n    ):\n        y = group[\"y_true\"].to_numpy()\n        p = group[prediction_col].to_numpy()\n        union = np.sum((y == 1) | (p == 1))\n        intersection = np.sum((y == 1) & (p == 1))\n\n        scores.append({\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"iou\": intersection / union if union else 1.0,\n        })\n\n    return pd.DataFrame(scores)\n\nsummaries = []\n\nfor name, col in [\n    (\"baseline\", \"baseline_pred\"),\n    (\"specialized_onset_h6\", \"specialized_pred\"),\n]:\n    scores = score_predictions(pred, col)\n    summaries.append({\n        \"model\": name,\n        \"overall_iou\": scores[\"iou\"].mean(),\n        \"onset_iou\": scores.loc[\n            scores[\"condition\"] == \"queue_onset\", \"iou\"\n        ].mean(),\n        \"ongoing_iou\": scores.loc[\n            scores[\"condition\"] == \"queue_ongoing\", \"iou\"\n        ].mean(),\n    })\n\nsummary = pd.DataFrame(summaries)\ndisplay(summary.round(4))\n\npred.to_csv(BASE / \"onset_horizon6_experiment_predictions.csv\", index=False)\nsummary.to_csv(BASE / \"onset_horizon6_experiment_summary.csv\", index=False)\n\nprint(\"Saved experiment results to:\", BASE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:42:29.382326Z","iopub.execute_input":"2026-10-24T10:42:29.382787Z","iopub.status.idle":"2026-10-24T10:43:13.075303Z","shell.execute_reply.started":"2026-10-24T10:42:29.382759Z","shell.execute_reply":"2026-10-24T10:43:13.074702Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                  model  overall_iou  onset_iou  ongoing_iou\n0              baseline       0.4385     0.1017       0.7754\n1  specialized_onset_h6       0.4262     0.0771       0.7754","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>model</th>\n      <th>overall_iou</th>\n      <th>onset_iou</th>\n      <th>ongoing_iou</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>baseline</td>\n      <td>0.4385</td>\n      <td>0.1017</td>\n      <td>0.7754</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>specialized_onset_h6</td>\n      <td>0.4262</td>\n      <td>0.0771</td>\n      <td>0.7754</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Saved experiment results to: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":100},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom pathlib import Path\nimport lightgbm as lgb\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\nPANELS = [\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n]\n\nEXCLUDE = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\", \"capacity_vph\",\n    \"length_km\", \"lanes\",\n}\n\ndata = {}\nfeature_sets = []\n\nfor panel in PANELS:\n    df = pd.read_csv(BASE / f\"{panel}_train_features_spatial.csv\")\n    df[\"panel\"] = panel\n    df = df[df[\"label_valid\"].astype(bool)].copy()\n    df[\"queue_label\"] = df[\"queue_label\"].astype(int)\n    data[panel] = df\n    feature_sets.append(\n        set(df.select_dtypes(include=[np.number]).columns) - EXCLUDE\n    )\n\nFEATURES = sorted(set.intersection(*feature_sets))\nassert len(FEATURES) == 42, f\"Expected 42 features; got {len(FEATURES)}\"\n\nall_predictions = []\n\nfor panel in PANELS:\n    df = data[panel]\n\n    for held_out in sorted(df[\"window_id\"].unique()):\n        train = df[df[\"window_id\"] != held_out].copy()\n        test = df[df[\"window_id\"] == held_out].copy()\n\n        # Baseline LightGBM.\n        y_train = train[\"queue_label\"]\n        positives = int(y_train.sum())\n        negatives = len(y_train) - positives\n\n        model = lgb.LGBMClassifier(\n            objective=\"binary\",\n            n_estimators=300,\n            learning_rate=0.03,\n            num_leaves=15,\n            min_child_samples=30,\n            colsample_bytree=0.9,\n            subsample=0.9,\n            reg_lambda=2.0,\n            scale_pos_weight=negatives / max(positives, 1),\n            random_state=42,\n            verbosity=-1,\n        )\n        model.fit(train[FEATURES], y_train)\n        base_pred = (\n            model.predict_proba(test[FEATURES])[:, 1] >= 0.50\n        ).astype(int)\n\n        # Learn positive link IDs from OTHER onset windows only.\n        onset_history = train[\n            (train[\"condition\"] == \"queue_onset\")\n            & (train[\"horizon_step\"] == 6)\n            & (train[\"queue_label\"] == 1)\n        ]\n        known_positive_links = set(onset_history[\"link_id\"].dropna())\n\n        link_pred = np.zeros(len(test), dtype=int)\n        onset_h6_mask = (\n            (test[\"condition\"] == \"queue_onset\")\n            & (test[\"horizon_step\"] == 6)\n        ).to_numpy()\n\n        # Link-history rule only applies to onset at horizon 6.\n        link_pred[onset_h6_mask] = (\n            test.iloc[np.flatnonzero(onset_h6_mask)][\"link_id\"]\n            .isin(known_positive_links)\n            .to_numpy(dtype=int)\n        )\n\n        # Hybrid: use link history for onset; retain baseline for ongoing.\n        hybrid_pred = base_pred.copy()\n        onset_mask = (test[\"condition\"] == \"queue_onset\").to_numpy()\n        hybrid_pred[onset_mask] = link_pred[onset_mask]\n\n        fold = test[\n            [\"panel\", \"window_id\", \"condition\", \"horizon_step\",\n             \"link_id\", \"queue_label\"]\n        ].copy()\n        fold[\"baseline_pred\"] = base_pred\n        fold[\"link_history_pred\"] = link_pred\n        fold[\"hybrid_pred\"] = hybrid_pred\n        all_predictions.append(fold)\n\npred = pd.concat(all_predictions, ignore_index=True)\npred = pred.rename(columns={\"queue_label\": \"y_true\"})\n\ndef evaluate(frame, prediction_column):\n    scores = []\n    for (panel, window, condition), group in frame.groupby(\n        [\"panel\", \"window_id\", \"condition\"], dropna=False\n    ):\n        y = group[\"y_true\"].to_numpy()\n        p = group[prediction_column].to_numpy()\n        union = np.sum((y == 1) | (p == 1))\n        intersection = np.sum((y == 1) & (p == 1))\n        scores.append({\n            \"panel\": panel,\n            \"window_id\": window,\n            \"condition\": condition,\n            \"iou\": intersection / union if union else 1.0,\n        })\n    return pd.DataFrame(scores)\n\nsummaries = []\npanel_summaries = []\n\nfor name, col in [\n    (\"baseline\", \"baseline_pred\"),\n    (\"link_history_only\", \"link_history_pred\"),\n    (\"hybrid\", \"hybrid_pred\"),\n]:\n    scores = evaluate(pred, col)\n\n    summaries.append({\n        \"model\": name,\n        \"overall_iou\": scores[\"iou\"].mean(),\n        \"onset_iou\": scores.loc[\n            scores[\"condition\"] == \"queue_onset\", \"iou\"\n        ].mean(),\n        \"ongoing_iou\": scores.loc[\n            scores[\"condition\"] == \"queue_ongoing\", \"iou\"\n        ].mean(),\n    })\n\n    panel_scores = (\n        scores.groupby([\"panel\", \"condition\"])[\"iou\"]\n        .mean()\n        .unstack(\"condition\")\n        .reset_index()\n    )\n    panel_scores.insert(0, \"model\", name)\n    panel_summaries.append(panel_scores)\n\nsummary = pd.DataFrame(summaries)\ndisplay(summary.round(4))\n\nprint(\"PANEL-LEVEL RESULTS\")\ndisplay(pd.concat(panel_summaries, ignore_index=True).round(4))\n\npred.to_csv(BASE / \"link_history_experiment_predictions.csv\", index=False)\nsummary.to_csv(BASE / \"link_history_experiment_summary.csv\", index=False)\n\nprint(\"Saved results in:\", BASE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:48:43.649682Z","iopub.execute_input":"2026-10-24T10:48:43.64998Z","iopub.status.idle":"2026-10-24T10:49:23.484755Z","shell.execute_reply.started":"2026-10-24T10:48:43.649959Z","shell.execute_reply":"2026-10-24T10:49:23.484055Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"               model  overall_iou  onset_iou  ongoing_iou\n0           baseline       0.4385     0.1017       0.7754\n1  link_history_only       0.2827     0.5654       0.0000\n2             hybrid       0.6704     0.5654       0.7754","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>model</th>\n      <th>overall_iou</th>\n      <th>onset_iou</th>\n      <th>ongoing_iou</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>baseline</td>\n      <td>0.4385</td>\n      <td>0.1017</td>\n      <td>0.7754</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>link_history_only</td>\n      <td>0.2827</td>\n      <td>0.5654</td>\n      <td>0.0000</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>hybrid</td>\n      <td>0.6704</td>\n      <td>0.5654</td>\n      <td>0.7754</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"PANEL-LEVEL RESULTS\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"condition              model      panel  queue_ongoing  queue_onset\n0                   baseline   D12_I5_N         0.7240       0.0000\n1                   baseline   D12_I5_S         0.6456       0.2000\n2                   baseline   D7_I10_E         0.7522       0.0000\n3                   baseline   D7_I10_W         0.7226       0.4000\n4                   baseline  D7_I210_E         0.8355       0.0400\n5                   baseline  D7_I210_W         0.8134       0.1000\n6                   baseline  D7_I405_N         0.8775       0.0400\n7                   baseline  D7_I405_S         0.8321       0.0333\n8          link_history_only   D12_I5_N         0.0000       0.4067\n9          link_history_only   D12_I5_S         0.0000       0.2305\n10         link_history_only   D7_I10_E         0.0000       0.9333\n11         link_history_only   D7_I10_W         0.0000       1.0000\n12         link_history_only  D7_I210_E         0.0000       1.0000\n13         link_history_only  D7_I210_W         0.0000       0.2133\n14         link_history_only  D7_I405_N         0.0000       0.2105\n15         link_history_only  D7_I405_S         0.0000       0.5286\n16                    hybrid   D12_I5_N         0.7240       0.4067\n17                    hybrid   D12_I5_S         0.6456       0.2305\n18                    hybrid   D7_I10_E         0.7522       0.9333\n19                    hybrid   D7_I10_W         0.7226       1.0000\n20                    hybrid  D7_I210_E         0.8355       1.0000\n21                    hybrid  D7_I210_W         0.8134       0.2133\n22                    hybrid  D7_I405_N         0.8775       0.2105\n23                    hybrid  D7_I405_S         0.8321       0.5286","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th>condition</th>\n      <th>model</th>\n      <th>panel</th>\n      <th>queue_ongoing</th>\n      <th>queue_onset</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>baseline</td>\n      <td>D12_I5_N</td>\n      <td>0.7240</td>\n      <td>0.0000</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>baseline</td>\n      <td>D12_I5_S</td>\n      <td>0.6456</td>\n      <td>0.2000</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>baseline</td>\n      <td>D7_I10_E</td>\n      <td>0.7522</td>\n      <td>0.0000</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>baseline</td>\n      <td>D7_I10_W</td>\n      <td>0.7226</td>\n      <td>0.4000</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>baseline</td>\n      <td>D7_I210_E</td>\n      <td>0.8355</td>\n      <td>0.0400</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>baseline</td>\n      <td>D7_I210_W</td>\n      <td>0.8134</td>\n      <td>0.1000</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>baseline</td>\n      <td>D7_I405_N</td>\n      <td>0.8775</td>\n      