 <tr>\n      <th>21</th>\n      <td>hybrid</td>\n      <td>D7_I210_W</td>\n      <td>0.8134</td>\n      <td>0.2133</td>\n    </tr>\n    <tr>\n      <th>22</th>\n      <td>hybrid</td>\n      <td>D7_I405_N</td>\n      <td>0.8775</td>\n      <td>0.2105</td>\n    </tr>\n    <tr>\n      <th>23</th>\n      <td>hybrid</td>\n      <td>D7_I405_S</td>\n      <td>0.8321</td>\n      <td>0.5286</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Saved results in: /kaggle/working/task2_training_labels\n","output_type":"stream"}],"execution_count":101},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nBASE = Path(\"/kaggle/working/task2_training_labels\")\npred = pd.read_csv(BASE / \"link_history_experiment_predictions.csv\")\n\n# Focus on queue onset only.\nonset = pred[pred[\"condition\"] == \"queue_onset\"].copy()\n\nrows = []\n\nfor (panel, window), group in onset.groupby([\"panel\", \"window_id\"]):\n    y = group[\"y_true\"].astype(int).to_numpy()\n    p = group[\"hybrid_pred\"].astype(int).to_numpy()\n\n    tp = int(((y == 1) & (p == 1)).sum())\n    fp = int(((y == 0) & (p == 1)).sum())\n    fn = int(((y == 1) & (p == 0)).sum())\n\n    union = tp + fp + fn\n    iou = tp / union if union else 1.0\n\n    rows.append({\n        \"panel\": panel,\n        \"window_id\": window,\n        \"actual_positives\": int(y.sum()),\n        \"predicted_positives\": int(p.sum()),\n        \"true_positives\": tp,\n        \"false_positives\": fp,\n        \"false_negatives\": fn,\n        \"onset_iou\": iou,\n    })\n\naudit = pd.DataFrame(rows)\n\nprint(\"ONSET PERFORMANCE BY HELD-OUT WINDOW\")\ndisplay(audit.round(4))\n\nprint(\"\\nSUMMARY BY PANEL\")\ndisplay(\n    audit.groupby(\"panel\").agg(\n        windows=(\"window_id\", \"count\"),\n        actual_positives=(\"actual_positives\", \"sum\"),\n        predicted_positives=(\"predicted_positives\", \"sum\"),\n        true_positives=(\"true_positives\", \"sum\"),\n        false_positives=(\"false_positives\", \"sum\"),\n        false_negatives=(\"false_negatives\", \"sum\"),\n        mean_window_iou=(\"onset_iou\", \"mean\"),\n    ).round(4)\n)\n\naudit.to_csv(BASE / \"hybrid_onset_window_audit.csv\", index=False)\nprint(\"\\nSaved audit:\", BASE / \"hybrid_onset_window_audit.csv\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T10:50:01.196239Z","iopub.execute_input":"2026-10-24T10:50:01.196509Z","iopub.status.idle":"2026-10-24T10:50:01.282381Z","shell.execute_reply.started":"2026-10-24T10:50:01.196488Z","shell.execute_reply":"2026-10-24T10:50:01.281653Z"}},"outputs":[{"name":"stdout","text":"ONSET PERFORMANCE BY HELD-OUT WINDOW\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"        panel               window_id  actual_positives  predicted_positives  \\\n0    D12_I5_N   Q2_D12_I5_N_train_001                 1                    1   \n1    D12_I5_N   Q2_D12_I5_N_train_002                 2                    4   \n2    D12_I5_N   Q2_D12_I5_N_train_003                 2                    3   \n3    D12_I5_N   Q2_D12_I5_N_train_004                 2                    2   \n4    D12_I5_N   Q2_D12_I5_N_train_005                 2                    3   \n5    D12_I5_S   Q2_D12_I5_S_train_001                 1                    5   \n6    D12_I5_S   Q2_D12_I5_S_train_002                 3                    3   \n7    D12_I5_S   Q2_D12_I5_S_train_003                 3                    2   \n8    D12_I5_S   Q2_D12_I5_S_train_004                 3                    6   \n9    D12_I5_S   Q2_D12_I5_S_train_005                 0                    3   \n10   D7_I10_E   Q2_D7_I10_E_train_001                 4                    4   \n11   D7_I10_E   Q2_D7_I10_E_train_002                 6                    4   \n12   D7_I10_E   Q2_D7_I10_E_train_003                 3                    3   \n13   D7_I10_E   Q2_D7_I10_E_train_004                 2             