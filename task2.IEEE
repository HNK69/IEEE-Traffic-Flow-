going          109               121      0.7969\nQ2_D7_I10_E_train_008 queue_ongoing           69                31      0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354      0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                28      0.7097\n\nMean per-window IoU @ 0.5: 0.3661\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7100\nqueue_onset      0.0222\nName: IoU_at_0.5, dtype: float64\n\nSaved OOF predictions to D7_I10_E_lightgbm_oof.csv\n","output_type":"stream"}],"execution_count":37},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nbase = \"/kaggle/working/task2_training_labels/\"\n\nfeatures = pd.read_csv(base + \"D7_I10_E_train_features.csv\")\noof = pd.read_csv(base + \"D7_I10_E_lightgbm_oof.csv\")\n\nonset_ids = [\n    f\"Q2_D7_I10_E_train_{i:03d}\"\n    for i in range(1, 6)\n]\n\n# Look at the features of the rare positive onset cells.\nonset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n    & (features[\"queue_label\"] == 1)\n].copy()\n\nprint(\"Valid onset queue cells:\", len(onset))\n\n# Show which predictors are available and compare positive-cell\n# values against all valid onset cells.\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nnumeric_features = [\n    c for c in features.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(features[c])\n]\n\nall_onset = features[\n    features[\"window_id\"].isin(onset_ids)\n    & features[\"label_valid\"].astype(bool)\n].copy()\n\nsummary = pd.DataFrame({\n    \"queue_cells_mean\": onset[numeric_features].mean(),\n    \"nonqueue_cells_mean\": all_onset.loc[\n        all_onset[\"queue_label\"] == 0, numeric_features\n    ].mean(),\n})\n\nsummary[\"difference\"] = (\n    summary[\"queue_cells_mean\"] - summary[\"nonqueue_cells_mean\"]\n)\n\nprint(summary.round(4).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:54:33.489742Z","iopub.execute_input":"2026-10-24T08:54:33.490056Z","iopub.status.idle":"2026-10-24T08:54:33.558917Z","shell.execute_reply.started":"2026-10-24T08:54:33.490034Z","shell.execute_reply":"2026-10-24T08:54:33.55824Z"}},"outputs":[{"name":"stdout","text":"Valid onset queue cells: 18\n                               queue_cells_mean  nonqueue_cells_mean  difference\nspeed_ratio_latest                       1.0020               0.9920      0.0100\nflow_ratio_latest                        0.5854               0.5676      0.0177\noccupancy_latest                         0.1514               0.1392      0.0122\nspeed_latest                           111.5693             112.4239     -0.8546\nflow_latest                           4756.1829            4489.8774    266.3054\npct_observed_latest                     80.8333              78.3136      2.5197\neligible_latest                          0.8333               0.7722      0.0612\nlast3_speed_ratio_mean                   1.0000               0.9922      0.0078\nlast3_speed_ratio_std                    0.0112               0.0092      0.0020\nlast3_flow_ratio_mean                    0.5954               0.5622      0.0333\nlast3_occupancy_mean                     0.1510               0.1379      0.0131\nlast3_pct_observed_mean                 76.3148              77.0204     -0.7056\nlast3_eligible_fraction                  0.7963               0.7641      0.0322\nlast3_observed_speed_fraction            0.8148               0.8274     -0.0126\nlast6_speed_ratio_mean                   1.0004               0.9923      0.0080\nlast6_speed_ratio_std                    0.0119               0.0102      0.0018\nlast6_flow_ratio_mean                    0.5896               0.5470      0.0426\nlast6_occupancy_mean                     0.1500               0.1340      0.0160\nlast6_pct_observed_mean                 72.8333              76.8184     -3.9851\nlast6_eligible_fraction                  0.7315               0.7617     -0.0302\nlast6_observed_speed_fraction            0.8056               0.8276     -0.0220\nspeed_ratio_first                        1.0003               0.9889      0.0115\nspeed_ratio_change                       0.0012               0.0031     -0.0019\nhorizon_step                             6.0000               3.4996      2.5004\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nbase = Path(\"/kaggle/working/task2_training_labels\")\ninput_path = base / \"D7_I10_E_train_features.csv\"\noutput_path = base / \"D7_I10_E_train_features_temporal.csv\"\n\ndf = pd.read_csv(input_path)\n\n# Add temporal-change features from existing history summaries.\n# These are differences between historical summary windows, not target values.\nrequired = [\n    \"last3_speed_ratio_mean\", \"last6_speed_ratio_mean\",\n    \"last3_flow_ratio_mean\", \"last6_flow_ratio_mean\",\n    \"last3_occupancy_mean\", \"last6_occupancy_mean\",\n    \"speed_ratio_latest\", \"speed_ratio_first\",\n]\n\nmissing = [c for c in required if c not in df.columns]\nif missing:\n    raise ValueError(f\"Missing expected columns: {missing}\")\n\ndf[\"speed_ratio_recent_vs_long\"] = (\n    df[\"last3_speed_ratio_mean\"] - df[\"last6_speed_ratio_mean\"]\n)\ndf[\"flow_ratio_recent_vs_long\"] = (\n    df[\"last3_flow_ratio_mean\"] - df[\"last6_flow_ratio_mean\"]\n)\ndf[\"occupancy_recent_vs_long\"] = (\n    df[\"last3_occupancy_mean\"] - df[\"last6_occupancy_mean\"]\n)\ndf[\"speed_ratio_recent_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"last3_speed_ratio_mean\"]\n)\ndf[\"speed_ratio_overall_change\"] = (\n    df[\"speed_ratio_latest\"] - df[\"speed_ratio_first\"]\n)\n\n# Change in variability between recent and longer history.\nif \"last3_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_recent\"] = df[\"last3_speed_ratio_std\"]\n\nif \"last6_speed_ratio_std\" in df.columns:\n    df[\"speed_variability_long\"] = df[\"last6_speed_ratio_std\"]\n    if \"last3_speed_ratio_std\" in df.columns:\n        df[\"speed_variability_change\"] = (\n            df[\"last3_speed_ratio_std\"] - df[\"last6_speed_ratio_std\"]\n        )\n\ndf.to_csv(output_path, index=False)\n\nnew_cols = [c for c in df.columns if c not in pd.read_csv(input_path, nrows=0).columns]\nprint(\"Saved:\", output_path)\nprint(\"Rows:\", len(df))\nprint(\"New temporal features:\", new_cols)\nprint(df[new_cols].describe().round(4).to_string())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:55:16.123105Z","iopub.execute_input":"2026-10-24T08:55:16.123425Z","iopub.status.idle":"2026-10-24T08:55:16.630565Z","shell.execute_reply.started":"2026-10-24T08:55:16.123401Z","shell.execute_reply":"2026-10-24T08:55:16.629715Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/task2_training_labels/D7_I10_E_train_features_temporal.csv\nRows: 8760\nNew temporal features: ['speed_ratio_recent_vs_long', 'flow_ratio_recent_vs_long', 'occupancy_recent_vs_long', 'speed_ratio_recent_change', 'speed_ratio_overall_change', 'speed_variability_recent', 'speed_variability_long', 'speed_variability_change']\n       speed_ratio_recent_vs_long  flow_ratio_recent_vs_long  occupancy_recent_vs_long  speed_ratio_recent_change  speed_ratio_overall_change  speed_variability_recent  speed_variability_long  speed_variability_change\ncount                   8364.0000                  8364.0000                 8364.0000                  7242.0000                   6060.0000                 7860.0000               8490.0000                 7860.0000\nmean                      -0.0047                     0.0084                    0.0042                    -0.0015                     -0.0182                    0.0106                  0.0167                   -0.0061\nstd                        0.0382                     0.0178                    0.0233                     0.0217                      0.1268                    0.0182                  0.0445                    0.0405\nmin                       -0.4524                    -0.0864                   -0.0639                    -0.4279                     -0.8614                    0.0000                  0.0000                   -0.4484\n25%                       -0.0031                    -0.0020                   -0.0004                    -0.0053                     -0.0089                    0.0044                  0.0070                   -0.0041\n50%                        0.0000                     0.0047                    0.0011                     0.0000                      0.0008                    0.0083                  0.0103                   -0.0004\n75%                        0.0029                     0.0159                    0.0038                     0.0053                      0.0131                    0.0132                  0.0137                    0.0018\nmax                        0.0456                     0.1107                    0.2316                     0.0239                      0.2055                    0.3706                  0.4484                    0.0848\n","output_type":"stream"}],"execution_count":39},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\n\n# 1. Load the NEW temporal feature file\npath = (\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_train_features_temporal.csv\"\n)\ndf = pd.read_csv(path)\n\ndf = df[\n    df[\"label_valid\"].astype(bool)\n    & df[\"queue_label\"].notna()\n].copy()\ndf[\"queue_label\"] = df[\"queue_label\"].astype(int)\n\n# 2. Select features without target leakage\nexclude = {\n    \"queue_label\", \"label_valid\", \"speed_kmh\",\n    \"window_id\", \"panel\", \"link_id\", \"condition\",\n    \"forecast_origin\", \"expected_timestamp\", \"origin\",\n    \"timestamp\", \"free_speed_kmh\",\n    \"capacity_vph\", \"length_km\", \"lanes\",\n}\n\nfeature_cols = [\n    c for c in df.columns\n    if c not in exclude\n    and pd.api.types.is_numeric_dtype(df[c])\n]\n\n# 3. Leave one entire window out at a time\noof_parts = []\nwindows = sorted(df[\"window_id\"].unique())\n\nfor i, wid in enumerate(windows, start=1):\n    tr = df[df[\"window_id\"] != wid]\n    va = df[df[\"window_id\"] == wid]\n\n    X_train = tr[feature_cols].replace([np.inf, -np.inf], np.nan)\n    y_train = tr[\"queue_label\"]\n\n    X_val = va[feature_cols].replace([np.inf, -np.inf], np.nan)\n\n    n_pos = int(y_train.sum())\n    n_neg = len(y_train) - n_pos\n\n    model = lgb.LGBMClassifier(\n        n_estimators=300,\n        learning_rate=0.03,\n        num_leaves=15,\n        min_child_samples=30,\n        colsample_bytree=0.9,\n        subsample=0.9,\n        reg_lambda=2.0,\n        scale_pos_weight=n_neg / max(n_pos, 1),\n        random_state=42,\n        verbosity=-1,\n    )\n    model.fit(X_train, y_train)\n\n    out = va[\n        [\"window_id\", \"condition\", \"queue_label\"]\n    ].copy()\n    out[\"probability\"] = model.predict_proba(X_val)[:, 1]\n    oof_parts.append(out)\n\n    print(f\"Fold {i}/{len(windows)} complete\")\n\n# 4. Evaluate at the same fixed threshold: 0.5\noof = pd.concat(oof_parts, ignore_index=True)\nresults = []\n\nfor wid, group in oof.groupby(\"window_id\", sort=True):\n    y = group[\"queue_label\"].to_numpy().astype(bool)\n    pred = group[\"probability\"].to_numpy() >= 0.5\n\n    intersection = np.sum(y & pred)\n    union = np.sum(y | pred)\n    iou = intersection / union if union else 1.0\n\n    results.append({\n        \"window_id\": wid,\n        \"condition\": group[\"condition\"].iloc[0],\n        \"true_queued\": int(y.sum()),\n        \"predicted_queued\": int(pred.sum()),\n        \"IoU\": float(iou),\n    })\n\nresults = pd.DataFrame(results)\n\nprint(\"\\n=== TEMPORAL FEATURES: RESULTS ===\")\nprint(results.round(4).to_string(index=False))\nprint(\"\\nOverall mean IoU:\", round(results[\"IoU\"].mean(), 4))\n\nprint(\"\\nMean IoU by condition:\")\nprint(results.groupby(\"condition\")[\"IoU\"].mean().round(4))\n\noof.to_csv(\n    \"/kaggle/working/task2_training_labels/\"\n    \"D7_I10_E_temporal_oof.csv\",\n    index=False,\n)\nprint(\"\\nSaved temporal OOF predictions.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T08:56:36.402537Z","iopub.execute_input":"2026-10-24T08:56:36.402841Z","iopub.status.idle":"2026-10-24T08:56:40.759159Z","shell.execute_reply.started":"2026-10-24T08:56:36.402809Z","shell.execute_reply":"2026-10-24T08:56:40.758076Z"}},"outputs":[{"name":"stdout","text":"Fold 1/10 complete\nFold 2/10 complete\nFold 3/10 complete\nFold 4/10 complete\nFold 5/10 complete\nFold 6/10 complete\nFold 7/10 complete\nFold 8/10 complete\nFold 9/10 complete\nFold 10/10 complete\n\n=== TEMPORAL FEATURES: RESULTS ===\n            window_id     condition  true_queued  predicted_queued    IoU\nQ2_D7_I10_E_train_001   queue_onset            4                 5 0.0000\nQ2_D7_I10_E_train_002   queue_onset            6                 5 0.0000\nQ2_D7_I10_E_train_003   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_004   queue_onset            2                 8 0.1111\nQ2_D7_I10_E_train_005   queue_onset            3                 0 0.0000\nQ2_D7_I10_E_train_006 queue_ongoing          113               131 0.7941\nQ2_D7_I10_E_train_007 queue_ongoing          109               115 0.8361\nQ2_D7_I10_E_train_008 queue_ongoing           69                31 0.4493\nQ2_D7_I10_E_train_009 queue_ongoing          308               354 0.8389\nQ2_D7_I10_E_train_010 queue_ongoing           25                22 0.8800\n\nOverall mean IoU: 0.3909\n\nMean IoU by condition:\ncondition\nqueue_ongoing    0.7597\nqueue_onset      0.0222\nName: IoU, dtype: float64\n\nSaved temporal OOF predictions.\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}