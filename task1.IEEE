</th>\n      <td>8916</td>\n      <td>-52.0779</td>\n      <td>0.0378</td>\n      <td>0.2887</td>\n      <td>0.3282</td>\n      <td>0.4261</td>\n      <td>0.4271</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":86},{"cell_type":"code","source":"# Compare recent lag speeds for extreme vs normal predictions\ndiag[\"lag5_low\"] = diag[\"lag_speed_5\"] < 40\ndiag[\"lag15_low\"] = diag[\"lag_speed_15\"] < 40\ndiag[\"both_recent_lags_low\"] = diag[\"lag5_low\"] & diag[\"lag15_low\"]\n\nprint(\"Recent speed-lag behavior:\")\ndisplay(\n    diag.groupby(\"extreme\").agg(\n        rows=(\"correction\", \"size\"),\n        lag5_available=(\"lag_speed_5\", lambda s: s.notna().mean()),\n        lag5_below_40=(\"lag5_low\", \"mean\"),\n        lag15_below_40=(\"lag15_low\", \"mean\"),\n        both_recent_below_40=(\"both_recent_lags_low\", \"mean\"),\n        median_lag5=(\"lag_speed_5\", \"median\"),\n        median_lag15=(\"lag_speed_15\", \"median\"),\n    ).round(4)\n)\n\nprint(\"\\nExtreme corrections where both recent lags are available and >= 40:\")\nsuspect = diag[\n    diag[\"extreme\"]\n    & diag[\"lag_speed_5\"].notna()\n    & diag[\"lag_speed_15\"].notna()\n    & (diag[\"lag_speed_5\"] >= 40)\n    & (diag[\"lag_speed_15\"] >= 40)\n]\nprint(\"Rows:\", len(suspect))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:55:26.246878Z","iopub.execute_input":"2026-10-19T15:55:26.2473Z","iopub.status.idle":"2026-10-19T15:55:26.332324Z","shell.execute_reply.started":"2026-10-19T15:55:26.247273Z","shell.execute_reply":"2026-10-19T15:55:26.331155Z"}},"outputs":[{"name":"stdout","text":"Recent speed-lag behavior:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           rows  lag5_available  lag5_below_40  lag15_below_40  \\\nextreme                                                          \nFalse    234687          0.5447         0.0082          0.0086   \nTrue       8916          0.7113  