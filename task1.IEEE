9T16:09:27.456397Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"     month    rows  eligible_rows  speed_available  flow_available\n0  2030-06  941760         718985           785092          785092\n1  2030-07  973152         743082           811733          811733\n2  2030-08  973152         743218           812875          812875\n3  2030-09  941760         719275           785776          785776\n4  2030-10  973152         744217           812909          812909\n5  2030-11  941760         719224           785678          785678\n6  2030-12  973152         744102           813299          813299\n7  2031-01  973152         743058           811888          811888\n8  2031-02  878976         671980           733947          733947","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>month</th>\n      <th>rows</th>\n      <th>eligible_rows</th>\n      <th>speed_available</th>\n      <th>flow_available</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>2030-06</td>\n      <td>941760</td>\n      <td>718985</td>\n      <td>785092</td>\n      <td>785092</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2030-07</td>\n      <td>973152</td>\n      <td>743082</td>\n      <td>811733</td>\n      <td>811733</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>2030-08</td>\n      <td>973152</td>\n      <td>743218</td>\n      <td>812875</td>\n      <td>812875</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>2030-09</td>\n      <td>941760</td>\n      <td>719275</td>\n      <td>785776</td>\n      <td>785776</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>2030-10</td>\n      <td>973152</td>\n      <td>744217</td>\n      <td>812909</td>\n      <td>812909</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>2030-11</td>\n      <td>941760</td>\n      <td>719224</td>\n      <td>785678</td>\n      <td>785678</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>2030-12</td>\n      <td>973152</td>\n      <td>744102</td>\n      <td>813299</td>\n      <td>813299</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>2031-01</td>\n      <td>973152</td>\n      <td>743058</td>\n      <td>811888</td>\n      <td>811888</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>2031-02</td>\n      <td>878976</td>\n      <td>671980</td>\n      <td>733947</td>\n      <td>733947</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":105},{"cell_type":"code","source":"# Check prerequisites for a leakage-safe temporal validation\n\nrequired = [\n    \"truth\", \"masked_lookup\", \"KEYS\", \"VALUE_COLS\",\n    \"build_baseline\", \"attach_baseline\",\n    \"add_lags\", \"add_model_features\",\n    \"FEATURES\",\n]\n\nfor name in required:\n    print(f\"{name}: {'OK' if name in globals() else 'MISSING'}\")\n\nprint(\"\\nExisting model variables:\")\nfor name in [\n    \"speed_model_original_style\",\n    \"flow_model_original_style\",\n]:\n    print(f\"{name}: {'OK' if name in globals() else 'MISSING'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:09:52.342323Z","iopub.execute_input":"2026-10-19T16:09:52.342842Z","iopub.status.idle":"2026-10-19T16:09:52.351391Z","shell.execute_reply.started":"2026-10-19T16:09:52.342811Z","shell.execute_reply":"2026-10-19T16:09:52.350251Z"}},"outputs":[{"name":"stdout","text":"truth: OK\nmasked_lookup: OK\nKEYS: OK\nVALUE_COLS: OK\nbuild_baseline: OK\nattach_baseline: OK\nadd_lags: OK\nadd_model_features: OK\nFEATURES: OK\n\nExisting model variables:\nspeed_model_original_style: OK\nflow_model_original_style: OK\n","output_type":"stream"}],"execution_count":106},{"cell_type":"code","source":"# January 2031 temporal holdout: prepare targets and features\nimport pandas as pd\nimport numpy as np\n\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\nfeb_start = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\ndec_start = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\n\n# Ground-truth labels for January evaluation\njan_truth = truth.loc[\n    (truth[\"timestamp\"] >= jan_start)\n    & (truth[\"timestamp\"] < feb_start)\n    & truth[\"is_score_eligible\"].eq(1)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\nprint(\"Eligible January truth rows:\", len(jan_truth))\n\n# Targets use the same timestamp/station/link keys and regime as the pipeline\njan_targets = jan_truth[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].merge(\n    masked_lookup[[\"timestamp\", \"station_id\", \"link_id\"]],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# Attach the regime from the corresponding masked data if it isn't already present\n# (truth labels are used only for evaluation, never as model input)\nif \"mask_regime\" not in jan_targets.columns:\n    jan_regime = features.loc[\n        features[\"timestamp\"].between(jan_start, feb_start, inclusive=\"left\"),\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n    ].drop_duplicates([\"timestamp\", \"station_id\", \"link_id\"])\n    jan_targets = jan_targets.merge(\n        jan_regime,\n        on=[\"timestamp\", \"station_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n# Baseline is computed using history before January\njan_baseline = build_baseline(jan_targets, jan_start)\njan_features = attach_baseline(jan_targets, jan_baseline)\njan_features = add_lags(jan_features)\njan_features = add_model_features(jan_features)\n\nprint(\"January feature rows:\", len(jan_features))\nprint(\"Missing baseline speed:\", jan_features[\"base_speed\"].isna().sum())\nprint(\"Missing baseline flow:\", jan_features[\"base_flow\"].isna().sum())\nprint(\"Feature columns prepared:\", len(jan_features.columns))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:10:43.118081Z","iopub.execute_input":"2026-10-19T16:10:43.11862Z","iopub.status.idle":"2026-10-19T16:11:45.777448Z","shell.execute_reply.started":"2026-10-19T16:10:43.118588Z","shell.execute_reply":"2026-10-19T16:11:45.776227Z"}},"outputs":[{"name":"stdout","text":"Eligible January truth rows: 743058\nJanuary feature rows: 743058\nMissing baseline speed: 0\nMissing baseline flow: 0\nFeature columns prepared: 22\n","output_type":"stream"}],"execution_count":107},{"cell_type":"code","source":"# Inspect available training months and expected feature schema\n\nprint(\"Existing feature rows by month:\")\ndisplay(\n    features.assign(\n        month=features[\"timestamp\"].dt.strftime(\"%Y-%m\")\n    ).groupby(\"month\", observed=True)\n    .agg(\n        rows=(\"timestamp\", \"size\"),\n        eligible_targets=(\"target_eligible\", \"sum\"),\n    )\n    .reset_index()\n)\n\nprint(\"\\nFeature schema:\")\nprint(\"FEATURES count:\", len(FEATURES))\nprint(\"Model expected features:\", speed_model_original_style.n_features_in_)\nprint(\"Model feature names:\", list(speed_model_original_style.feature_names_in_))\n\nprint(\"\\nJanuary feature columns:\")\nprint(jan_features.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:12:32.007699Z","iopub.execute_input":"2026-10-19T16:12:32.00913Z","iopub.status.idle":"2026-10-19T16:12:37.171523Z","shell.execute_reply.started":"2026-10-19T16:12:32.009085Z","shell.execute_reply":"2026-10-19T16:12:37.170386Z"}},"outputs":[{"name":"stdout","text":"Existing feature rows by month:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"     month    rows  eligible_targets\n0  2030-12  244890            244890\n1  2031-01  234798            234798\n2  2031-02  235491            235491","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>month</th>\n      <th>rows</th>\n      <th>eligible_targets</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>2030-12</td>\n      <td>244890</td>\n      <td>244890</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2031-01</td>\n      <td>234798</td>\n      <td>234798</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>2031-02</td>\n      <td>235491</td>\n      <td>235491</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nFeature schema:\nFEATURES count: 19\nModel expected features: 19\nModel feature names: ['base_speed', 'base_flow', 'lag_speed_5', 'lag_flow_5', 'lag_speed_15', 'lag_flow_15', 'lag_speed_60', 'lag_flow_60', 'lag_speed_1440', 'lag_flow_1440', 'weekday', 'minute_of_day', 'tod_sin', 'tod_cos', 'weekday_sin', 'weekday_cos', 'station_id_code', 'link_id_code', 'mask_regime_code']\n\nJanuary feature columns:\n['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph', 'mask_regime', 'base_speed', 'base_flow', 'lag_speed_5', 'lag_flow_5', 'lag_speed_15', 'lag_flow_15', 'lag_speed_60', 'lag_flow_60', 'lag_speed_1440', 'lag_flow_1440', 'weekday', 'minute_of_day', 'tod_sin', 'tod_cos', 'weekday_sin', 'weekday_cos']\n","output_type":"stream"}],"execution_count":108},{"cell_type":"code","source":"# Verify pre-January training data and target columns\n\npre_jan = features.loc[features[\"timestamp\"] < jan_start].copy()\n\nprint(\"Pre-January rows:\", len(pre_jan))\nprint(\"Target columns available:\",\n      [c for c in [\"target_speed\", \"target_flow\", \"speed_kmh\", \"flow_vph\"]\n       if c in pre_jan.columns])\n\nprint(\"Target missingness:\")\nfor col in [\"target_speed\", \"target_flow\"]:\n    if col in pre_jan.columns:\n        print(f\"{col}: {pre_jan[col].isna().sum()} missing\")\n\nprint(\"\\nID mappings available:\")\nfor col in [\"station_id_code\", \"link_id_code\", \"mask_regime_code\"]:\n    print(f\"{col}: {col in features.columns}\")\n\nprint(\"\\nLag lookup columns:\")\nprint(masked_lookup.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:16:39.578626Z","iopub.execute_input":"2026-10-19T16:16:39.579589Z","iopub.status.idle":"2026-10-19T16:16:39.706411Z","shell.execute_reply.started":"2026-10-19T16:16:39.579442Z","shell.execute_reply":"2026-10-19T16:16:39.704704Z"}},"outputs":[{"name":"stdout","text":"Pre-January rows: 244890\nTarget columns available: ['target_speed', 'target_flow']\nTarget missingness:\ntarget_speed: 0 missing\ntarget_flow: 0 missing\n\nID mappings available:\nstation_id_code: False\nlink_id_code: False\nmask_regime_code: False\n\nLag lookup columns:\n['timestamp', 'station_id', 'link_id', 'masked_speed', 'masked_flow']\n","output_type":"stream"}],"execution_count":109},{"cell_type":"code","source":"# Fix feature names for the January temporal validation\n\n# Rename the existing training feature columns to match the model schema\nrename_map = {\n    \"lag5_speed\": \"lag_speed_5\",\n    \"lag5_flow\": \"lag_flow_5\",\n    \"lag15_speed\": \"lag_speed_15\",\n    \"lag15_flow\": \"lag_flow_15\",\n    \"lag60_speed\": \"lag_speed_60\",\n    \"lag60_flow\": \"lag_flow_60\",\n    \"lag1440_speed\": \"lag_speed_1440\",\n    \"lag1440_flow\": \"lag_flow_1440\",\n    \"dow\": \"weekday\",\n    \"dow_sin\": \"weekday_sin\",\n    \"dow_cos\": \"weekday_cos\",\n}\n\nfeatures = features.rename(columns=rename_map)\n\n# Add sorted category codes to the training and January frames\ncategory_maps = {}\nfor col, code_col in [\n    (\"station_id\", \"station_id_code\"),\n    (\"link_id\", \"link_id_code\"),\n    (\"mask_regime\", \"mask_regime_code\"),\n]:\n    categories = sorted(features[col].astype(str).unique())\n    category_maps[col] = {value: i for i, value in enumerate(categories)}\n\n    features[code_col] = (\n        features[col].astype(str).map(category_maps[col]).astype(\"float32\")\n    )\n    jan_features[code_col] = (\n        jan_features[col].astype(str).map(category_maps[col]).astype(\"float32\")\n    )\n\nX_pre_jan = features.loc[\n    features[\"timestamp\"] < jan_start, FEATURES\n].astype(\"float32\").copy()\n\nX_jan = jan_features[FEATURES].astype(\"float32\").copy()\n\nprint(\"Training matrix:\", X_pre_jan.shape)\nprint(\"January matrix:\", X_jan.shape)\nprint(\"Feature order matches:\", list(X_pre_jan.columns) == list(X_jan.columns))\nprint(\"Training NaNs:\", int(X_pre_jan.isna().sum().sum()))\nprint(\"January NaNs:\", int(X_jan.isna().sum().sum()))\nprint(\"Unmapped January IDs:\", {\n    code: int(jan_features[code].isna().sum())\n    for code in [\"station_id_code\", \"link_id_code\", \"mask_regime_code\"]\n})","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:17:37.195563Z","iopub.execute_input":"2026-10-19T16:17:37.196066Z","iopub.status.idle":"2026-10-19T16:17:38.339205Z","shell.execute_reply.started":"2026-10-19T16:17:37.196036Z","shell.execute_reply":"2026-10-19T16:17:38.33769Z"}},"outputs":[{"name":"stdout","text":"Training matrix: (244890, 19)\nJanuary matrix: (743058, 19)\nFeature order matches: True\nTraining NaNs: 858176\nJanuary NaNs: 2869048\nUnmapped January IDs: {'station_id_code': 0, 'link_id_code': 0, 'mask_regime_code': 508260}\n","output_type":"stream"}],"execution_count":111},{"cell_type":"code","source":"# Diagnose missing feature values and category mapping coverage\n\nprint(\"Training NaNs by feature:\")\ndisplay(\n    X_pre_jan.isna().sum()\n    .sort_values(ascending=False)\n    .rename(\"missing_rows\")\n    .to_frame()\n    .query(\"missing_rows > 0\")\n)\n\nprint(\"\\nJanuary NaNs by feature:\")\ndisplay(\n    X_jan.isna().sum()\n    .sort_values(ascending=False)\n    .rename(\"missing_rows\")\n    .to_frame()\n    .query(\"missing_rows > 0\")\n)\n\nprint(\"\\nRegime categories:\")\nprint(\"Training features:\", sorted(features[\"mask_regime\"].astype(str).unique()))\nprint(\"January features:\", sorted(jan_features[\"mask_regime\"].astype(str).unique()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:18:20.966016Z","iopub.execute_input":"2026-10-19T16:18:20.9665Z","iopub.status.idle":"2026-10-19T16:18:21.263132Z","shell.execute_reply.started":"2026-10-19T16:18:20.966471Z","shell.execute_reply":"2026-10-19T16:18:21.262057Z"}},"outputs":[{"name":"stdout","text":"Training NaNs by feature:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                missing_rows\nlag_speed_60          111527\nlag_flow_60           111527\nlag_flow_15           108484\nlag_speed_15          108484\nlag_flow_5            107399\nlag_speed_5           107399\nlag_speed_1440        101678\nlag_flow_1440         101678","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>missing_rows</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>lag_speed_60</th>\n      <td>111527</td>\n    </tr>\n    <tr>\n      <th>lag_flow_60</th>\n      <td>111527</td>\n    </tr>\n    <tr>\n      <th>lag_flow_15</th>\n      <td>108484</td>\n    </tr>\n    <tr>\n      <th>lag_speed_15</th>\n      <td>108484</td>\n    </tr>\n    <tr>\n      <th>lag_flow_5</th>\n      <td>107399</td>\n    </tr>\n    <tr>\n      <th>lag_speed_5</th>\n      <td>107399</td>\n    </tr>\n    <t