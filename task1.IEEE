int(\"\\nExtreme corrections vs others:\")\ndisplay(\n    diag.groupby(\"extreme\").agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        recent_lags_missing=(\"recent_lags_missing\", \"mean\"),\n        lag5_missing=(\"lag_speed_5\", lambda s: s.isna().mean()),\n        lag15_missing=(\"lag_speed_15\", lambda s: s.isna().mean()),\n        lag60_missing=(\"lag_speed_60\", lambda s: s.isna().mean()),\n        lag1440_missing=(\"lag_speed_1440\", lambda s: s.isna().mean()),\n    ).round(4)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:54:50.062141Z","iopub.execute_input":"2026-10-19T15:54:50.062975Z","iopub.status.idle":"2026-10-19T15:54:50.186566Z","shell.execute_reply.started":"2026-10-19T15:54:50.062934Z","shell.execute_reply":"2026-10-19T15:54:50.18559Z"}},"outputs":[{"name":"stdout","text":"By regime:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"               rows  extreme_rate  extreme_with_both_recent_lags_missing\nmask_regime                                                             \nR1            33201        0.0317                                 0.1147\nR2            92845        0.0476                                 0.1520\nR3           117557        0.0293                                 0.3047","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>rows</th>\n      <th>extreme_rate</th>\n      <th>extreme_with_both_recent_lags_missing</th>\n    </tr>\n    <tr>\n      <th>mask_regime</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>R1</th>\n      <td