{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:12:38.424566Z","iopub.execute_input":"2026-10-21T18:12:38.425256Z","iopub.status.idle":"2026-10-21T18:12:38.477252Z","shell.execute_reply.started":"2026-10-21T18:12:38.425215Z","shell.execute_reply":"2026-10-21T18:12:38.476179Z"}},"outputs":[{"name":"stdout","text":"D12_I405_N | checkpoint exists | columns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nD12_I405_S | checkpoint exists | columns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nD12_I5_N | checkpoint exists | columns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nD12_I5_S | checkpoint exists | columns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nD7_I10_E | checkpoint exists | columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph']\nD7_I10_W | checkpoint exists | columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph']\nD7_I210_E | checkpoint exists | columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph']\nD7_I210_W | checkpoint exists | columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph']\nD7_I405_N | checkpoint exists | columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph']\nD7_I405_S | checkpoint exists | columns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split', '_timestamp_utc']\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"\n# Audit all 10 checkpoint files without modifying them.\n\nimport pandas as pd\nimport numpy as np\n\naudit_results = []\n\nfor panel in PANELS:\n    cp = checkpoint_path(panel)\n\n    if not cp.exists():\n        audit_results.append((panel, \"MISSING\", 0, 0, 0))\n        continue\n\n    pred = pd.read_csv(cp)\n\n    # Normalize the prediction keys.\n    pred[\"timestamp\"] = pd.to_datetime(\n        pred[\"timestamp\"], utc=True\n    ).astype(str)\n    pred[\"station_id\"] = pred[\"station_id\"].astype(str).str.strip()\n    pred[\"link_id\"] = pred[\"link_id\"].astype(str).str.strip()\n\n    if not set(KEYS + TARGETS).issubset(pred.columns):\n        audit_results.append(\n            (panel, \"BAD_COLUMNS\", len(pred), 0, 0)\n        )\n        continue\n\n    panel_ok = True\n    missing_total = 0\n    extra_total = 0\n\n    for split in [\"validation\", \"private\"]:\n        template = load_template(panel, split)\n        template[\"timestamp\"] = pd.to_datetime(\n            template[\"timestamp\"], utc=True\n        ).astype(str)\n        template[\"station_id\"] = (\n            template[\"station_id\"].astype(str).str.strip()\n        )\n        template[\"link_id\"] = (\n            template[\"link_id\"].astype(str).str.strip()\n        )\n\n        # Prefer explicit split when available; otherwise use date.\n        if \"split\" in pred.columns:\n            part = pred[\n                pred[\"split\"].astype(str).str.lower() == split\n            ].copy()\n        else:\n            month = 3 if split == \"validation\" else 4\n            part = pred[\n                pd.to_datetime(pred[\"timestamp\"], utc=True).dt.month == month\n            ].copy()\n\n        expected = pd.MultiIndex.from_frame(template[KEYS])\n        actual = pd.MultiIndex.from_frame(part[KEYS])\n\n        missing = len(expected.difference(actual))\n        extra = len(actual.difference(expected))\n\n        missing_total += missing\n        extra_total += extra\n\n        ok = (\n            len(part) == len(template)\n            and missing == 0\n            and extra == 0\n            and not part.duplicated(KEYS).any()\n            and not part[TARGETS].isna().any().any()\n            and np.isfinite(part[TARGETS].to_numpy(dtype=float)).all()\n        )\n\n        panel_ok = panel_ok and ok\n\n    status = \"PASS\" if panel_ok else \"FAIL\"\n    audit_results.append(\n        (panel, status, len(pred), missing_total, extra_total)\n    )\n\nprint(\"Panel | Status | Rows | Missing keys | Extra keys\")\nfor row in audit_results:\n    print(\n        f\"{row[0]} | {row[1]} | {row[2]:,} | \"\n        f\"{row[3]:,} | {row[4]:,}\"\n    )\n\nprint(\"\\nVerified panels:\", sum(r[1] == \"PASS\" for r in audit_results), \"/ 10\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:13:52.29372Z","iopub.execute_input":"2026-10-21T18:13:52.295043Z","iopub.status.idle":"2026-10-21T18:15:41.941536Z","shell.execute_reply.started":"2026-10-21T18:13:52.29496Z","shell.execute_reply":"2026-10-21T18:15:41.940423Z"}},"outputs":[{"name":"stdout","text":"Panel | Status | Rows | Missing keys | Extra keys\nD12_I405_N | PASS | 395,501 | 0 | 0\nD12_I405_S | PASS | 201,134 | 0 | 0\nD12_I5_N | PASS | 1,131,560 | 0 | 0\nD12_I5_S | PASS | 424,179 | 0 | 0\nD7_I10_E | PASS | 640,806 | 0 | 0\nD7_I10_W | PASS | 436,759 | 0 | 0\nD7_I210_E | PASS | 1,206,210 | 0 | 0\nD7_I210_W | PASS | 364,874 | 0 | 0\nD7_I405_N | PASS | 1,419,230 | 0 | 0\nD7_I405_S | PASS | 515,542 | 0 | 0\n\nVerified panels: 10 / 10\n","output_type":"stream"}],"execution_count":37},{"cell_type":"code","source":"\nfrom pathlib import Path\n\nINPUT_ROOT = Path(\"/kaggle/input\")\n\nprint(\"Competition root exists:\", ROOT.exists())\nprint(\"\\nFiles matching submission templates:\\n\")\n\nmatches = []\nfor base in [ROOT, INPUT_ROOT / \"competitions\"]:\n    if base.exists():\n        for p in base.rglob(\"*\"):\n            if p.is_file() and (\n                \"sample_submission\" in p.name.lower()\n                or \"submission_key\" in p.name.lower()\n            ):\n                matches.append(p)\n\nfor p in matches[:100]:\n    print(p)\n\nprint(\"\\nTotal matches:\", len(matches))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:18:17.896262Z","iopub.execute_input":"2026-10-21T18:1