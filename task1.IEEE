station_id\", \"link_id\", \"mask_regime\"]\n].copy()\n\nprivate_baseline = build_baseline(\n    private_targets,\n    pd.Timestamp(\"2031-04-01\", tz=\"UTC\")\n)\n\nprint(\"Private baseline:\", private_baseline.shape)\nprint(\"Missing baseline values:\",\n      private_baseline[VALUE_COLS].isna().any(axis=1).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:45:00.919192Z","iopub.execute_input":"2026-10-19T15:45:00.919703Z","iopub.status.idle":"2026-10-19T15:45:08.727596Z","shell.execute_reply.started":"2026-10-19T15:45:00.919672Z","shell.execute_reply":"2026-10-19T15:45:08.726546Z"}},"outputs":[{"name":"stdout","text":"Private masked shape: (941760, 17)\nDuplicate keys: 0\nPrivate baseline: (243603, 6)\nMissing baseline values: 0\n","output_type":"stream"}],"execution_count":76},{"cell_type":"code","source":"# 1. Create lookup from private masked observations\nprivate_lookup = private_raw[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"masked_speed\",\n    \"flow_vph\": \"masked_flow\",\n})\n\n# Keep the existing add_lags lookup intact\n_original_masked_lookup = masked_lookup\nmasked_lookup = pd.concat(\n    [_original_masked_lookup, private_lookup],\n    ignore_index=True\n).drop_duplicates(KEYS, keep=\"last\")\n\n# 2. Build April features\nprivate_features = attach_baseline(private_targets, private_baseline)\nprivate_features = add_lags(private_features)\nprivate_features = add_model_features(private_features)\n\n# 3. Match training category codes\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = sorted(features[col].astype(str).unique())\n    mapping = {value: i for i, value in enumerate(categories)}\n    private_features[f\"{col}_code\"] = (\n        private_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n\n# 4. Match model feature names\nprivate_features = private_features.rename(columns={\n    \"lag_speed_5\": \"lag_speed_5\", \"lag_flow_5\": \"lag_flow_5\",\n    \"lag_speed_15\": \"lag_speed_15\", \"lag_flow_15\": \"lag_flow_15\",\n    \"lag_speed_60\": \"lag_speed_60\", \"lag_flow_60\": \"lag_flow_60\",\n    \"lag_speed_1440\": \"lag_speed_1440\", \"lag_flow_1440\": \"lag_flow_1440\",\n    \"dow\": \"weekday\", \"dow_sin\": \"weekday_sin\", \"dow_cos\": \"weekday_cos\",\n})\n\nassert all(c in private_features.columns for c in FEATURES)\n\nX_private = private_features[FEATURES].astype(\"float32\")\n\n# 5. Predict residuals and add baselines\nprivate_submission = private_template.copy()\nprivate_submission[\"speed_kmh\"] = np.clip(\n    private_features[\"base_speed\"].to_numpy()\n    + speed_model_original_style.predict(X_private),\n    0, 160\n)\nprivate_submission[\"flow_vph\"] = np.clip(\n    private_features[\"base_flow\"].to_numpy()\n    + flow_model_original_style.predict(X_private),\n    0, None\n)\n\n# 6. Validate and save\nassert len(private_submission) == len(private_template)\nassert private_submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert private_submission[[\"timestamp\", \"station_id\", \"link_id\"]].equals(\n    private_template[[\"timestamp\", \"station_id\", \"link_id\"]]\n)\n\noutput_path = \"/kaggle/working/private_submission.csv\"\nprivate_submission.to_csv(output_path, index=False)\n\nprint(\"Saved:\", output_path)\nprint(\"Shape:\", private_submission.shape)\ndisplay(private_submission.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:47:06.394105Z","iopub.execute_input":"2026-10-19T15:47:06.394623Z","iopub.status.idle":"2026-10-19T15:48:04.643735Z","shell.execute_reply.started":"2026-10-19T15:47:06.39459Z","shell.execute_reply":"2026-10-19T15:48:04.642685Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/private_submission.csv\nShape: (243603, 7)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"       panel                 timestamp          station