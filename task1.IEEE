'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\nRows: 25632\nTimestamp range: 2031-03-03T00:00:00Z to 2031-03-03T23:55:00Z\nObserved rows: 21408\nMissing rows: 4224\n\n--- PRIVATE ---\nFiles: 30\nSample: synthetic_mainline_2031_04_01.parquet\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\nRows: 25632\nTimestamp range: 2031-04-01T00:00:00Z to 2031-04-01T23:55:00Z\nObserved rows: 21355\nMissing rows: 4277\n","output_type":"stream"}],"execution_count":183},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\nimport gc\n\npanel_root = ROOT / \"corridors\" / panel\ntrain_root = panel_root / \"train\"\n\n# Load January ground truth for baseline construction\ntruth_files = sorted(\n    (train_root / \"mainline_states\").rglob(\"*.parquet\")\n)\n\nhistory_parts = []\n\nfor path in truth_files:\n    # Partition folders are not sufficient for filtering;\n    # filter the actual timestamps after reading.\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (df[\"is_score_eligible\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        history_parts.append(part)\n\n    del df\n    gc.collect()\n\nhistory_feb = pd.concat(history_parts, ignore_index=True)\ndel history_parts\ngc.collect()\n\n# Load February masked observations\nmasked_files_feb = sorted(\n    (train_root / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\nmasked_parts = []\n\nfor path in masked_files_feb:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        masked_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_feb = pd.concat(masked_parts, ignore_index=True)\ndel masked_parts\ngc.collect()\n\nprint(\"January history rows:\", len(history_feb))\nprint(\"January date range:\",\n      history_feb[\"timestamp\"].min(), \"to\",\n      history_feb[\"timestamp\"].max())\nprint(\"February observed rows:\", len(masked_feb))\nprint(\"February date range:\",\n      masked_feb[\"timestamp\"].min(), \"to\",\n      masked_feb[\"timestamp\"].max())\nprint(\"Duplicate history keys:\", history_feb.duplicated(KEYS).sum())\nprint(\"Duplicate masked keys:\", masked_feb.duplicated(KEYS).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:36:30.6352Z","iopub.execute_input":"2026-10-19T18:36:30.635619Z","iopub.status.idle":"2026-10-19T18:41:27.068493Z","shell.execute_reply.started":"2026-10-19T18:36:30.63558Z","shell.execute_reply":"2026-10-19T18:41:27.067107Z"}},"outputs":[{"name":"stdout","text":"January history rows: 607319\nJanuary date range: 2031-01-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\nFebruary observed rows: 599794\nFebruary date range: 2031-02-01 00:00:00+00:00 to 2031-02-28 23:55:00+00:00\nDuplicate history keys: 0\nDuplicate masked keys: 0\n","output_type":"stream"}],"execution_count":184},{"cell_type":"code","source":"# Build February supervised training features without target leakage\n\nimport pandas as pd\nimport numpy as np\nimport gc\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\n# 1. February ground truth: labels only\nfeb_truth_parts = []\n\ntruth_files = sorted(\n    (train_root / \"mainline_states\").rglob(\"*.parquet\")\n)\n\nfor path in truth_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (df[\"is_score_eligible\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, KEYS + VALUE_COLS].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        feb_truth_parts.append(part)\n\n    del df\n    gc.collect()\n\nfeb_targets = pd.concat(feb_truth_parts, ignore_index=True)\ndel feb_truth_parts\ngc.collect()\n\nfeb_targets = feb_targets.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\"\n})\n\n# 2. Join each target to its assigned mask regime\nfeb_targets = feb_targets.merge(\n    masked_feb[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# 3. January historical profiles\njan_profile = history_feb.copy()\njan_profile[\"weekday\"] = jan_profile[\"timestamp\"].dt.dayofweek\njan_profile[\"minute_of_day\"] = (\n    jan_profile[\"timestamp\"].dt.hour * 60\n    + jan_profile[\"timestamp\"].dt.minute\n)\n\nprofile_min = (\n    jan_profile.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week = (\n    jan_profile.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link = (\n    jan_profile.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 4. Create feature table\nfeb_features = feb_targets.copy()\nfeb_features[\"weekday\"] = feb_features[\"timestamp\"].dt.dayofweek\nfeb_features[\"minute_of_day\"] = (\n    feb_features[\"timestamp\"].dt.hour * 60\n    + feb_features[\"timestamp\"].dt.minute\n)\n\nfeb_features = feb_features.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nfeb_features = feb_features.merge(\n    profile_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nfeb_features = feb_features.merge(\n    profile_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfeb_features[\"base_speed\"] = (\n    feb_features[\"base_speed_min\"]\n    .fillna(feb_features[\"base_speed_week\"])\n    .fillna(feb_features[\"base_speed_link\"])\n)\nfeb_features[\"base_flow\"] = (\n    feb_features[\"base_flow_min\"]\n    .fillna(feb_features[\"base_flow_week\"])\n    .fillna(feb_features[\"base_flow_link\"])\n)\n\n# 5. Observed-value lags, including January for 1440-minute lags\nlag_source = pd.concat([\n    history_feb[KEYS + VALUE_COLS].rename(columns={\n        \"speed_kmh\": \"masked_speed\",\n        \"flow_vph\": \"masked_flow\"\n    }),\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\n# Keep only observed source values and avoid duplicate keys\nlag_source = lag_source.drop_duplicates(KEYS, keep=\"last\")\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    feb_features = feb_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 6. Time and categorical features\nfeb_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * feb_features[\"minute_of_day\"] / 1440\n)\nfeb_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * feb_features[\"minute_of_day\"] / 1440\n)\nfeb_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * feb_features[\"weekday\"] / 7\n)\nfeb_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * feb_features[\"weekday\"] / 7\n)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    feb_features[f\"{col}_code\"] = pd.Categorical(\n        feb_features[col],\n        categories=sorted(feb_features[col].dropna().unique())\n    ).codes\n\n# 7. Checks\nassert feb_features[[\"target_speed\", \"target_flow\"]].notna().all().all()\nassert feb_features[[\"base_speed\", \"base_flow\"]].notna().all().all()\nassert not feb_features.duplicated(KEYS).any()\n\nprint(\"February feature rows:\", len(feb_features))\nprint(\"Target missingness:\")\nprint(feb_features[[\"target_speed\", \"target_flow\"]].isna().mean())\nprint(\"\\nBaseline missingness:\")\nprint(feb_features[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"\\nLag missingness:\")\nprint(feb_features[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"\\nFeature table shape:\", feb_features.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:48:23.925081Z","iopub.execute_input":"2026-10-19T18:48:23.925506Z","iopub.status.idle":"2026-10-19T18:51:00.730136Z","shell.execute_reply.started":"2026-10-19T18:48:23.925476Z","shell.execute_reply":"2026-10-19T18:51:00.72902Z"}},"outputs":[{"name":"stdout","text":"February feature rows: 549076\nTarget missingness:\ntarget_speed    0.0\ntarget_flow     0.0\ndtype: float64\n\nBaseline missingness:\nbase_speed    0.0\nbase_flow     0.0\ndtype: float64\n\nLag missingness:\nlag_speed_5       0.430166\nlag_speed_15      0.435291\nlag_speed_60      0.448044\nlag_speed_1440    0.437799\ndtype: float64\n\nFeature table shape: (549076, 31)\n","output_type":"stream"}],"execution_count":185},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\"\n]\n\ndf = feb_features.sort_values(\"timestamp\").reset_index(drop=True)\n\nunique_times = np.sort(df[\"timestamp\"].unique())\ncut_idx = int(len(unique_times) * 0.8)\nval_start = unique_times[cut_idx]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\nX_train = train[FEATURES]\nX_valid = valid[FEATURES]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    X_train, train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    X_train, train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy() + speed_model_next.predict(X_valid),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy() + flow_model_next.predict(X_valid),\n    0, None\n)\n\n# Competition metric: lane-normalized flow RMSE\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\neval_df = valid[\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\neval_df[\"pred_speed\"] = speed_pred\neval_df[\"pred_flow\"] = flow_pred\neval_df = eval_df.merge(\n    lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert eval_df[\"lanes\"].notna().all()\nassert (eval_df[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean(\n    (eval_df[\"target_speed\"] - eval_df[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((eval_df[\"target_flow\"] - eval_df[\"pred_flow\"])\n     / eval_df[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(\"Holdout starts:\", pd.Timestamp(val_start))\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"Estimated state score: {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:51:44.661692Z","iopub.execute_input":"2026-10-19T18:51:44.662446Z","iopub.status.idle":"2026-10-19T18:51:59.656265Z","shell.execute_reply.started":"2026-10-19T18:51:44.662412Z","shell.execute_reply":"2026-10-19T18:51:59.655151Z"}},"outputs":[{"name":"stdout","text":"Training rows: 439514\nHoldout rows: 109562\nHoldout starts: 2031-02-23 09:35:00+00:00\nSpeed RMSE: 3.8444 km/h\nFlow RMSE per lane: 76.5473\nEstimated state score: 0.85828\n","output_type":"stream"}],"execution_count":186},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nval_masked_files = sorted(\n    (panel_root / \"validation\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\nmarch_parts = []\n\nfor path in val_masked_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-04-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        march_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_march = pd.concat(march_parts, ignore_index=True)\ndel march_parts\ngc.collect()\n\nprint(\"March observed rows:\", len(masked_march))\nprint(\"Timestamp range:\",\n      masked_march[\"timestamp\"].min(), \"to\",\n      masked_march[\"timestamp\"].max())\nprint(\"Duplicate keys:\", masked_march.duplicated(KEYS).sum())\nprint(\"Missing masked values:\")\nprint(masked_march[[\"masked_speed\", \"masked_flow\"]].isna().mean())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:56:54.451186Z","iopub.execute_input":"2026-10-19T18:56:54.45168Z","iopub.status.idle":"2026-10-19T18:57:12.917998Z","shell.execute_reply.started":"2026-10-19T18:56:54.451651Z","shell.execute_reply":"2026-10-19T18:57:12.916442Z"}},"outputs":[{"name":"stdout","text":"March observed rows: 663228\nTimestamp range: 2031-03-01 00:00:00+00:00 to 2031-03-31 23:55:00+00:00\nDuplicate keys: 0\nMissing masked values:\nmasked_speed    0.306587\nmasked_flow     0.306587\ndtype: float64\n","output_type":"stream"}],"execution_count":187},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. History for profile baselines: January + February ground truth.\n# Use only data strictly before March.\nhistory_mar = pd.concat([\n    history_feb,\n    feb_targets[KEYS + [\"target_speed\", \"target_flow\"]].rename(columns={\n        \"target_speed\": \"speed_kmh\",\n        \"target_flow\": \"flow_vph\"\n    })\n], ignore_index=True)\n\nhistory_mar = history_mar.drop_duplicates(KEYS, keep=\"last\")\nhistory_mar[\"weekday\"] = history_mar[\"timestamp\"].dt.dayofweek\nhistory_mar[\"minute_of_day\"] = (\n    history_mar[\"timestamp\"].dt.hour * 60\n    + history_mar[\"timestamp\"].dt.minute\n)\n\nprofile_min_mar = (\n    history_mar.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week_mar = (\n    history_mar.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link_mar = (\n    history_mar.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 2. Start from March masked rows, including unobserved targets\nmarch_targets = val_template.copy()\nmarch_targets[\"timestamp\"] = pd.to_datetime(\n    march_targets[\"timestamp\"], utc=True\n)\n\nmarch_features = march_targets[KEYS + [\"mask_regime\"]].copy()\nmarch_features[\"weekday\"] = march_features[\"timestamp\"].dt.dayofweek\nmarch_features[\"minute_of_day\"] = (\n    march_features[\"timestamp\"].dt.hour * 60\n    + march_features[\"timestamp\"].dt.minute\n)\n\nmarch_features = march_features.merge(\n    profile_min_mar,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nmarch_features = march_features.merge(\n    profile_week_mar,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nmarch_features = march_features.merge(\n    profile_link_mar,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nmarch_features[\"base_speed\"] = (\n    march_features[\"base_speed_min\"]\n    .fillna(march_features[\"base_speed_week\"])\n    .fillna(march_features[\"base_speed_link\"])\n)\nmarch_features[\"base_flow\"] = (\n    march_features[\"base_flow_min\"]\n    .fillna(march_features[\"base_flow_week\"])\n    .fillna(march_features[\"base_flow_link\"])\n)\n\n# 3. Build lag source from January, February, and March observed data\nfeb_observed = masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n\nlag_source_mar = pd.concat([\n    history_feb[KEYS + VALUE_COLS].rename(columns={\n        \"speed_kmh\": \"masked_speed\",\n        \"flow_vph\": \"masked_flow\"\n    }),\n    feb_observed,\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\nlag_source_mar = lag_source_mar.drop_duplicates(KEYS, keep=\"last\")\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_mar[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    march_features = march_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 4. Time features\nmarch_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * march_features[\"minute_of_day\"] / 1440\n)\nmarch_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * march_features[\"minute_of_day\"] / 1440\n)\nmarch_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * march_features[\"weekday\"] / 7\n)\nmarch_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * march_features[\"weekday\"] / 7\n)\n\n# 5. Use training category mappings, not new March mappings\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    mapping = {\n        value: i\n        for i, value in enumerate(\n            sorted(feb_features[col].dropna().unique())\n        )\n    }\n    march_features[f\"{col}_code\"] = (\n        march_features[col].map(mapping).fillna(-1).astype(\"int32\")\n    )\n\n# 6. Validate\nassert len(march_features) == len(val_template)\nassert not march_features.duplicated(KEYS).any()\nassert march_features[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\nprint(\"March features:\", march_features.shape)\nprint(\"Baseline missingness:\")\nprint(march_features[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"Lag missingness:\")\nprint(march_features[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"Rows:\", len(march_features))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:04:58.119954Z","iopub.execute_input":"2026-10-19T19:04:58.120544Z","iopub.status.idle":"2026-10-19T19:05:09.617857Z","shell.execute_reply.started":"2026-10-19T19:04:58.12051Z","shell.execute_reply":"2026-10-19T19:05:09.616693Z"}},"outputs":[{"name":"stdout","text":"March features: (203337, 29)\nBaseline missingness:\nbase_speed    0.0\nbase_flow     0.0\ndtype: float64\nLag missingness:\nlag_speed_5       0.437186\nlag_speed_15      0.440259\nlag_speed_60      0.453892\nlag_speed_1440    0.419358\ndtype: float64\nRows: 203337\n","output_type":"stream"}],"execution_count":188},{"cell_type":"code","source":"# Verify model feature schema\nassert list(march_features[FEATURES].columns) == FEATURES\nassert list(feb_features[FEATURES].columns) == FEATURES\n\n# Generate predictions\nmarch_pred_speed = np.clip(\n    march_features[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(march_features[FEATURES]),\n    0, 160\n)\n\nmarch_pred_flow = np.clip(\n    march_features[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(march_features[FEATURES]),\n    0, None\n)\n\n# Build prediction table using the exact template key order\nmarch_predictions = march_features[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].copy()\n\nmarch_predictions[\"panel\"] = panel\nmarch_predictions[\"speed_kmh\"] = march_pred_speed\nmarch_predictions[\"flow_vph\"] = march_pred_flow\n\n# Restore the template's row order via a stable merge\ntemplate_keys = val_template.copy()\ntemplate_keys[\"timestamp\"] = pd.to_datetime(\n    template_keys[\"timestamp\"], utc=True\n)\n\nmarch_predictions = template_keys[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].merge(\n    march_predictions[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"speed_kmh\", \"flow_vph\"]\n    ],\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\nassert len(march_predictions) == len(val_template)\nassert march_predictions[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert march_predictions[\"speed_kmh\"].between(0, 160).all()\nassert (march_predictions[\"flow_vph\"] >= 0).all()\n\n# Save a separate checkpoint; don't overwrite the existing combined checkpoint\nmarch_path = WORK / \"D12_I405_N_march_predictions.csv\"\nmarch_predictions.to_csv(march_path, index=False)\n\nprint(\"March predictions:\", len(march_predictions))\nprint(\"Speed range:\",\n      march_predictions[\"speed_kmh\"].min(),\n      \"to\", march_predictions[\"speed_kmh\"].max())\nprint(\"Flow range:\",\n      march_predictions[\"flow_vph\"].min(),\n      \"to\", march_predictions[\"flow_vph\"].max())\nprint(\"Saved:\", march_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:08:44.014683Z","iopub.execute_input":"2026-10-19T19:08:44.016164Z","iopub.status.idle":"2026-10-19T19:08:50.926693Z","shell.execute_reply.started":"2026-10-19T19:08:44.016119Z","shell.execute_reply":"2026-10-19T19:08:50.925551Z"}},"outputs":[{"name":"stdout","text":"March predictions: 203337\nSpeed range: 0.0 to 134.1133810233431\nFlow range: 277.3597887197866 to 9163.600315554671\nSaved: /kaggle/working/D12_I405_N_march_predictions.csv\n","output_type":"stream"}],"execution_count":189},{"cell_type":"code","source":"print(\"January history rows:\", len(history_feb))\nprint(\"February masked observed rows:\", len(masked_feb))\nprint(\"March masked observed rows:\", len(masked_march))\n\nprint(\"\\nJanuary history date range:\")\nprint(history_feb[\"timestamp\"].min(), \"to\",\n      history_feb[\"timestamp\"].max())\n\nprint(\"\\nFebruary masked date range:\")\nprint(masked_feb[\"timestamp\"].min(), \"to\",\n      masked_feb[\"timestamp\"].max())\n\nprint(\"\\nMarch masked date range:\")\nprint(masked_march[\"timestamp\"].min(), \"to\",\n      masked_march[\"timestamp\"].max())\n\nprint(\"\\nLag source currently includes:\")\nprint(\"January truth:\", len(history_feb))\nprint(\"February observed:\", len(masked_feb))\nprint(\"March observed:\", len(masked_march))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:11:39.519714Z","iopub.execute_input":"2026-10-19T19:11:39.521477Z","iopub.status.idle":"2026-10-19T19:11:39.583192Z","shell.execute_reply.started":"2026-10-19T19:11:39.521351Z","shell.execute_reply":"2026-10-19T19:11:39.577482Z"}},"outputs":[{"name":"stdout","text":"January history rows: 607319\nFebruary masked observed rows: 599794\nMarch masked observed rows: 663228\n\nJanuary history date range:\n2031-01-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\n\nFebruary masked date range:\n2031-02-01 00:00:00+00:00 to 2031-02-28 23:55:00+00:00\n\nMarch masked date range:\n2031-03-01 00:00:00+00:00 to 2031-03-31 23:55:00+00:00\n\nLag source currently includes:\nJanuary truth: 607319\nFebruary observed: 599794\nMarch observed: 663228\n","output_type":"stream"}],"execution_count":190},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\njan_masked_files = sorted(\n    (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\njan_parts = []\n\nfor path in jan_masked_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        jan_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_jan = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\nprint(\"January masked observed rows:\", len(masked_jan))\nprint(\"Duplicate keys:\", masked_jan.duplicated(KEYS).sum())\nprint(\"Missing masked values:\")\nprint(masked_jan[[\"masked_speed\", \"masked_flow\"]].isna().mean())\nprint(\"Date range:\",\n      masked_jan[\"timestamp\"].min(), \"to\",\n      masked_jan[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:13:47.769237Z","iopub.execute_input":"2026-10-19T19:13:47.770307Z","iopub.status.idle":"2026-10-19T19:16:07.686331Z","shell.execute_reply.started":"2026-10-19T19:13:47.770258Z","shell.execute_reply":"2026-10-19T19:16:07.684212Z"}},"outputs":[{"name":"stdout","text":"January masked observed rows: 663297\nDuplicate keys: 0\nMissing masked values:\nmasked_speed    0.28605\nmasked_flow     0.28605\ndtype: float64\nDate range: 2031-01-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\n","output_type":"stream"}],"execution_count":191},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# Combine only genuinely observed masked values\nlag_source_corrected = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\nassert not lag_source_corrected.duplicated(KEYS).any()\n\n# Remove previous lag columns before rebuilding\nlag_cols = (\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    + [f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]]\n)\n\nfeb_features_corrected = feb_features.drop(\n    columns=lag_cols, errors=\"ignore\"\n).copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_corrected[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    feb_features_corrected = feb_features_corrected.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n    del lag\n    gc.collect()\n\nassert len(feb_features_corrected) == len(feb_features)\nassert not feb_features_corrected.duplicated(KEYS).any()\n\nprint(\"Corrected February features:\", feb_features_corrected.shape)\nprint(\"Lag missingness:\")\nprint(feb_features_corrected[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"Target missingness:\")\nprint(feb_features_corrected[[\"target_speed\", \"target_flow\"]].isna().mean())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:21:07.698256Z","iopub.execute_input":"2026-10-19T19:21:07.698996Z","iopub.status.idle":"2026-10-19T19:21:15.475688Z","shell.execute_reply.started":"2026-10-19T19:21:07.698927Z","shell.execute_reply":"2026-10-19T19:21:15.474495Z"}},"outputs":[{"name":"stdout","text":"Corrected February features: (549076, 31)\nLag missingness:\nlag_speed_5       0.430174\nlag_speed_15      0.435320\nlag_speed_60      0.448188\nlag_speed_1440    0.440768\ndtype: float64\nTarget missingness:\ntarget_speed    0.0\ntarget_flow     0.0\ndtype: float64\n","output_type":"stream"}],"execution_count":192},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nimport numpy as np\nimport pandas as pd\n\ndf = feb_features_corrected.sort_values(\"timestamp\").reset_index(drop=True)\n\nunique_times = np.sort(df[\"timestamp\"].unique())\nval_start = unique_times[int(len(unique_times) * 0.8)]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    train[FEATURES],\n    train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    train[FEATURES],\n    train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(valid[FEATURES]),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(valid[FEATURES]),\n    0, None\n)\n\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\nev = valid[[\"link_id\", \"target_speed\", \"target_flow\"]].copy()\nev[\"pred_speed\"] = speed_pred\nev[\"pred_flow\"] = flow_pred\nev = ev.merge(lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\")\n\nassert ev[\"lanes\"].notna().all() and (ev[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean((ev[\"target_speed\"] - ev[\"pred_speed\"]) ** 2))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((ev[\"target_flow\"] - ev[\"pred_flow\"]) / ev[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"Estimated state score: {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:22:18.734397Z","iopub.execute_input":"2026-10-19T19:22:18.734968Z","iopub.status.idle":"2026-10-19T19:22:33.110106Z","shell.execute_reply.started":"2026-10-19T19:22:18.734929Z","shell.execute_reply":"2026-10-19T19:22:33.10902Z"}},"outputs":[{"name":"stdout","text":"Training rows: 439514\nHoldout rows: 109562\nSpeed RMSE: 3.8611 km/h\nFlow RMSE per lane: 76.5952\nEstimated state score: 0.85788\n","output_type":"stream"}],"execution_count":193},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. Build observed-only lag source across Jan–Mar\nlag_source_mar = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]],\n], ignore_index=True)\n\nassert not lag_source_mar.duplicated(KEYS).any()\n\n# 2. Rebuild March lag columns\nlag_cols = (\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    + [f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]]\n)\n\nmarch_features_final = march_features.drop(\n    columns=lag_cols, errors=\"ignore\"\n).copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_mar[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    march_features_final = march_features_final.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n    del lag\n    gc.collect()\n\n# 3. Verify the exact model feature schema\nassert all(c in march_features_final.columns for c in FEATURES)\nassert len(march_features_final) == len(val_template)\nassert not march_features_final.duplicated(KEYS).any()\nassert march_features_final[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\n# 4. Predict using the corrected February-trained models\nmarch_speed_final = np.clip(\n    march_features_final[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(march_features_final[FEATURES]),\n    0, 160\n)\n\nmarch_flow_final = np.clip(\n    march_features_final[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(march_features_final[FEATURES]),\n    0, None\n)\n\n# 5. Reconstruct predictions in exact template order\nmarch_predictions_final = val_template.copy()\nmarch_predictions_final[\"timestamp\"] = pd.to_datetime(\n    march_predictions_final[\"timestamp\"], utc=True\n)\n\npred_values = march_features_final[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].copy()\npred_values[\"speed_kmh\"] = march_speed_final\npred_values[\"flow_vph\"] = march_flow_final\n\nmarch_predictions_final = march_predictions_final.drop(\n    columns=[\"speed_kmh\", \"flow_vph\"]\n).merge(\n    pred_values,\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\n# 6. Validate and save a separate final checkpoint\nassert len(march_predictions_final) == len(val_template)\nassert march_predictions_final[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert march_predictions_final[\"speed_kmh\"].between(0, 160).all()\nassert (march_predictions_final[\"flow_vph\"] >= 0).all()\n\nmarch_path_final = WORK / \"D12_I405_N_march_predictions_corrected.csv\"\nmarch_predictions_final.to_csv(march_path_final, index=False)\n\nprint(\"Rows:\", len(march_predictions_final))\nprint(\"Missing predictions:\",\n      int(march_predictions_final[[\"speed_kmh\", \"flow_vph\"]].isna().any(axis=1).sum()))\nprint(\"Speed range:\",\n      march_predictions_final[\"speed_kmh\"].min(),\n      \"to\", march_predictions_final[\"speed_kmh\"].max())\nprint(\"Flow range:\",\n      march_predictions_final[\"flow_vph\"].min(),\n      \"to\", march_predictions_final[\"flow_vph\"].max())\nprint(\"Saved:\", march_path_final)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:24:23.864609Z","iopub.execute_input":"2026-10-19T19:24:23.866293Z","iopub.status.idle":"2026-10-19T19:24:39.530019Z","shell.execute_reply.started":"2026-10-19T19:24:23.866247Z","shell.execute_reply":"2026-10-19T19:24:39.528807Z"}},"outputs":[{"name":"stdout","text":"Rows: 203337\nMissing predictions: 0\nSpeed range: 4.323940532993227 to 133.26115107219127\nFlow range: 273.3673550141349 to 9337.581330114877\nSaved: /kaggle/working/D12_I405_N_march_predictions_corrected.csv\n","output_type":"stream"}],"execution_count":194},{"cell_type":"code","source":"\nimport gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# ============================================================\n# 1. PRE-FLIGHT CHECKS\n# ============================================================\nassert panel == \"D12_I405_N\"\nassert \"speed_model_next\" in globals()\nassert \"flow_model_next\" in globals()\nassert \"masked_jan\" in globals()\nassert \"masked_feb\" in globals()\nassert \"masked_march\" in globals()\nassert \"history_mar\" in globals()\nassert \"priv_template\" in globals()\n\npanel_root = ROOT / \"corridors\" / panel\nprivate_root = panel_root / \"private\" / \"mainline_states_masked\"\n\napril_files = sorted(private_root.rglob(\"*.parquet\"))\nassert len(april_files) > 0, f\"No April masked files found: {private_root}\"\n\napril_start = pd.Timestamp(\"2031-04-01\", tz=\"UTC\")\nmay_start = pd.Timestamp(\"2031-05-01\", tz=\"UTC\")\n\n# ============================================================\n# 2. LOAD APRIL OBSERVED MASKED DATA\n# ============================================================\napril_parts = []\n\nfor path in april_files:\n    part = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(part[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= april_start)\n        & (ts < may_start)\n        & (part[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        out = part.loc[\n            keep,\n            [\n                \"timestamp\", \"station_id\", \"link_id\",\n                \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n            ]\n        ].copy()\n\n        out[\"timestamp\"] = ts.loc[keep]\n        out = out.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        april_parts.append(out)\n\n    del part\n    gc.collect()\n\nassert april_parts, \"No observed April rows were loaded.\"\n\nmasked_april = pd.concat(april_parts, ignore_index=True)\ndel april_parts\ngc.collect()\n\nassert not masked_april.duplicated(KEYS).any(), \\\n    \"Duplicate April observation keys found.\"\n\nprint(\"April observed rows:\", len(masked_april))\nprint(\"April range:\", masked_april[\"timestamp\"].min(),\n      \"to\", masked_april[\"timestamp\"].max())\n\n# ============================================================\n# 3. PREPARE APRIL TEMPLATE AND BASELINES\n# ============================================================\napril_template = priv_template.copy()\napril_template[\"timestamp\"] = pd.to_datetime(\n    april_template[\"timestamp\"], utc=True\n)\n\nassert len(april_template) == 192164\nassert april_template[\"timestamp\"].ge(april_start).all()\nassert april_template[\"timestamp\"].lt(may_start).all()\nassert not april_template.duplicated(KEYS).any()\n\n# Use only pre-April historical truth for the baseline profiles.\nhist = history_mar.copy()\nhist[\"weekday\"] = hist[\"timestamp\"].dt.dayofweek\nhist[\"minute_of_day\"] = (\n    hist[\"timestamp\"].dt.hour * 60 + hist[\"timestamp\"].dt.minute\n)\n\nprof_min = (\n    hist.groupby([\"link_id\", \"weekday\", \"minute_of_day\"], observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprof_week = (\n    hist.groupby([\"link_id\", \"weekday\"], observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprof_link = (\n    hist.groupby(\"link_id\", observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\napril_features = april_template[\n    KEYS + [\"mask_regime\"]\n].copy()\n\napril_features[\"weekday\"] = april_features[\"timestamp\"].dt.dayofweek\napril_features[\"minute_of_day\"] = (\n    april_features[\"timestamp\"].dt.hour * 60\n    + april_features[\"timestamp\"].dt.minute\n)\n\napril_features = april_features.merge(\n    prof_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\napril_features = april_features.merge(\n    prof_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\napril_features = april_features.merge(\n    prof_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\napril_features[\"base_speed\"] = (\n    april_features[\"base_speed_min\"]\n    .fillna(april_features[\"base_speed_week\"])\n    .fillna(april_features[\"base_speed_link\"])\n)\napril_features[\"base_flow\"] = (\n    april_features[\"base_flow_min\"]\n    .fillna(april_features[\"base_flow_week\"])\n    .fillna(april_features[\"base_flow_link\"])\n)\n\nassert april_features[[\"base_speed\", \"base_flow\"]].notna().all().all(), \\\n    \"April baseline has missing values.\"\n\n# ============================================================\n# 4. OBSERVED-ONLY LAGS ACROSS JANUARY–APRIL\n# ============================================================\nlag_source = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_april[KEYS + [\"masked_speed\", \"masked_flow\"]],\n], ignore_index=True)\n\nassert not lag_source.duplicated(KEYS).any(), \\\n    \"Duplicate keys in combined lag source.\"\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    april_features = april_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# ============================================================\n# 5. TIME FEATURES AND TRAINING CATEGORY MAPPINGS\n# ============================================================\napril_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * april_features[\"minute_of_day\"] / 1440\n)\napril_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * april_features[\"minute_of_day\"] / 1440\n)\napril_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * april_features[\"weekday\"] / 7\n)\napril_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * april_features[\"weekday\"] / 7\n)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    mapping = {\n        value: i\n        for i, value in enumerate(\n            sorted(feb_features_corrected[col].dropna().unique())\n        )\n    }\n    april_features[f\"{col}_code\"] = (\n        april_features[col].map(mapping).fillna(-1).astype(\"int32\")\n    )\n\nassert all(c in april_features.columns for c in FEATURES)\nassert len(april_features) == len(april_template)\nassert not april_features.duplicated(KEYS).any()\n\n# ============================================================\n# 6. PREDICT\n# ============================================================\nX_april = april_features[FEATURES]\n\napril_speed = np.clip(\n    april_features[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(X_april),\n    0, 160\n)\napril_flow = np.clip(\n    april_features[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(X_april),\n    0, None\n)\n\n# Reattach predictions using the official template keys.\napril_values = april_features[\n    KEYS + [\"mask_regime\"]\n].copy()\napril_values[\"speed_kmh\"] = april_speed\napril_values[\"flow_vph\"] = april_flow\n\napril_predictions = april_template.drop(\n    columns=[\"speed_kmh\", \"flow_vph\"]\n).merge(\n    april_values,\n    on=KEYS + [\"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\n# ============================================================\n# 7. STRICT VALIDATION AND CHECKPOINT\n# ============================================================\nassert len(april_predictions) == len(april_template)\nassert april_predictions[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert april_predictions[\"speed_kmh\"].between(0, 160).all()\nassert (april_predictions[\"flow_vph\"] >= 0).all()\nassert april_predictions[KEYS].equals(april_template[KEYS]), \\\n    \"Prediction row order or keys differ from template.\"\n\napril_path = WORK / \"D12_I405_N_april_predictions.csv\"\napril_predictions.to_csv(april_path, index=False)\n\nassert april_path.exists() and april_path.stat().st_size > 0\n\nprint(\"\\nAPRIL PREDICTIONS SAVED\")\nprint(\"Rows:\", len(april_predictions))\nprint(\"Missing predictions:\",\n      int(april_predictions[[\"speed_kmh\", \"flow_vph\"]].isna().any(axis=1).sum()))\nprint(\"Speed range:\",\n      round(april_predictions[\"speed_kmh\"].min(), 3),\n      \"to\", round(april_predictions[\"speed_kmh\"].max(), 3))\nprint(\"Flow range:\",\n      round(april_predictions[\"flow_vph\"].min(), 3),\n      \"to\", round(april_predictions[\"flow_vph\"].max(), 3))\nprint(\"File:\", april_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:26:32.228098Z","iopub.execute_input":"2026-10-19T19:26:32.229514Z","iopub.status.idle":"2026-10-19T19:27:06.729346Z","shell.execute_reply.started":"2026-10-19T19:26:32.22946Z","shell.execute_reply":"2026-10-19T19:27:06.727999Z"}},"outputs":[{"name":"stdout","text":"April observed rows: 641833\nApril range: 2031-04-01 00:00:00+00:00 to 2031-04-30 23:55:00+00:00\n\nAPRIL PREDICTIONS SAVED\nRows: 192164\nMissing predictions: 0\nSpeed range: 1.587 to 142.102\nFlow range: 253.533 to 8119.003\nFile: /kaggle/working/D12_I405_N_april_predictions.csv\n","output_type":"stream"}],"execution_count":195},{"cell_type":"code","source":"import pandas as pd\n\npred_path = WORK / \"D12_I405_N_march_predictions_corrected.csv\"\ntemplate_path = (\n    ROOT / \"task1\" / panel / \"validation\" / \"sample_submission_state.csv\"\n)\n\npred = pd.read_csv(pred_path)\ntemplate = pd.read_csv(template_path)\n\nKEYS_OUT = [\n    \"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nprint(\"Prediction shape:\", pred.shape)\nprint(\"Template shape:\", template.shape)\nprint(\"\\nPrediction dtypes:\")\nprint(pred[KEYS_OUT].dtypes.to_string())\nprint(\"\\nTemplate dtypes:\")\nprint(template[KEYS_OUT].dtypes.to_string())\n\n# Normalize timestamp representation before comparing\npred[\"timestamp\"] = pd.to_datetime(pred[\"timestamp\"], utc=True)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n\nprint(\"\\nExact keys/order match after timestamp normalization:\",\n      pred[KEYS_OUT].equals(template[KEYS_OUT]))\n\nprint(\"Prediction duplicate keys:\", pred.duplicated(KEYS_OUT).sum())\nprint(\"Template duplicate keys:\", template.duplicated(KEYS_OUT).sum())\n\n# Check whether all template keys exist in predictions\ncomparison = template[KEYS_OUT].merge(\n    pred[KEYS_OUT],\n    on=KEYS_OUT,\n    how=\"outer\",\n    indicator=True\n)\nprint(\"\\nKey match counts:\")\nprint(comparison[\"_merge\"].value_counts().to_string())\n\nprint(\"\\nFirst five rows — template:\")\nprint(template[KEYS_OUT].head().to_string(index=False))\nprint(\"\\nFirst five rows — predictions:\")\nprint(pred[KEYS_OUT].head().to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:29:10.636156Z","iopub.execute_input":"2026-10-19T19:29:10.636571Z","iopub.status.idle":"2026-10-19T19:29:11.846891Z","shell.execute_reply.started":"2026-10-19T19:29:10.63654Z","shell.execute_reply":"2026-10-19T19:29:11.844832Z"}},"outputs":[{"name":"stdout","text":"Prediction shape: (203337, 7)\nTemplate shape: (203337, 7)\n\nPrediction dtypes:\np