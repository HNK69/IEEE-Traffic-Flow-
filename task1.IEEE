Panel: D12_I5_N\nTraining rows: 1,588,503\nMissing lag values:\nlag_speed_5       622937\nlag_flow_5        622937\nlag_speed_15      633806\nlag_flow_15       633806\nlag_speed_60      658015\nlag_flow_60       658015\nlag_speed_1440    670839\nlag_flow_1440     670839\ndtype: int64\nFeature integrity checks passed.\n","output_type":"stream"}],"execution_count":218},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL_I5N = \"D12_I5_N\"\ntruth_root_i5n = ROOT / \"corridors\" / PANEL_I5N / \"train\" / \"mainline_states\"\n\njan_parts_i5n = []\n\nfor f in truth_root_i5n.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n\n    if not x.empty:\n        jan_parts_i5n.append(\n            x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del x\n    gc.collect()\n\nif not jan_parts_i5n:\n    raise ValueError(\"No January 2031 truth files found for D12_I5_N.\")\n\njan_truth_i5n = pd.concat(jan_parts_i5n, ignore_index=True)\ndel jan_parts_i5n\ngc.collect()\n\njan_truth_i5n[\"weekday\"] = jan_truth_i5n[\"timestamp\"].dt.weekday\njan_truth_i5n[\"minute_of_day\"] = (\n    jan_truth_i5n[\"timestamp\"].dt.hour * 60\n    + jan_truth_i5n[\"timestamp\"].dt.minute\n)\n\nprofile_i5n = jan_truth_i5n.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile_i5n = jan_truth_i5n.groupby(\n    \"link_id\", as_index=False\n).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\nfeb_features_i5n = feb_features_i5n.merge(\n    profile_i5n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n) if {\"weekday\", \"minute_of_day\"}.issubset(feb_features_i5n.columns) else feb_features_i5n\n\nif \"base_speed\" not in feb_features_i5n.columns:\n    feb_features_i5n[\"weekday\"] = pd.to_datetime(\n        feb_features_i5n[\"timestamp\"], utc=True\n    ).dt.weekday\n    feb_features_i5n[\"minute_of_day\"] = (\n        pd.to_datetime(feb_features_i5n[\"timestamp\"], utc=True).dt.hour * 60\n        + pd.to_datetime(feb_features_i5n[\"timestamp\"], utc=True).dt.minute\n    )\n    feb_features_i5n = feb_features_i5n.merge(\n        profile_i5n,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\nfeb_features_i5n = feb_features_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i5n[\"base_speed\"] = feb_features_i5n[\"base_speed\"].fillna(\n    feb_features_i5n[\"link_base_speed\"]\n)\nfeb_features_i5n[\"base_flow\"] = feb_features_i5n[\"base_flow\"].fillna(\n    feb_features_i5n[\"link_base_flow\"]\n)\n\nassert len(feb_features_i5n) == 1_588_503\nassert feb_features_i5n[\"base_speed\"].notna().all()\nassert feb_features_i5n[\"base_flow\"].notna().all()\n\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Rows:\", f\"{len(feb_features_i5n):,}\")\nprint(\"Baseline profile rows:\", f\"{len(profile_i5n):,}\")\nprint(\"Missing base_speed:\", feb_features_i5n[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_i5n[\"base_flow\"].isna().sum())\nprint(\"Baseline checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:24:09.398382Z","iopub.execute_input":"2026-10-19T20:24:09.39895Z","iopub.status.idle":"2026-10-19T20:24:31.028883Z","shell.execute_reply.started":"2026-10-19T20:24:09.398916Z","shell.execute_reply":"2026-10-19T20:24:31.027625Z"}},"outputs":[{"name":"stdout","text":"Pa