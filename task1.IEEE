tes_masked: 0 parquet files\n\nTask 1 templates:\n  validation: columns=['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\n    Example rows:\n    panel            timestamp         station_id   link_id mask_regime  speed_kmh  flow_vph\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0033 L405S-001          R1        NaN       NaN\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0019 L405S-007          R1        NaN       NaN\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0022 L405S-021          R1        NaN       NaN\n  private: columns=['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\n    Example rows:\n    panel            timestamp         station_id   link_id mask_regime  speed_kmh  flow_vph\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0094 L405S-004          R3        NaN       NaN\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0035 L405S-013          R3        NaN       NaN\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0024 L405S-029          R3        NaN       NaN\n","output_type":"stream"}],"execution_count":145},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanels = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\nfor panel in panels:\n    print(f\"\\n{'=' * 15} {panel} {'=' * 15}\")\n    base = ROOT / \"corridors\" / panel\n\n    for split, folders in [\n        (\"train\", [\"mainline_states\", \"mainline_states_masked\"]),\n        (\"validation\", [\"mainline_states_masked\"]),\n        (\"private\", [\"mainline_states_masked\"]),\n    ]:\n        for folder_name in folders:\n            folder = base / split / folder_name\n\n            if not folder.exists():\n                print(f\"{split}/{folder_name}: DIRECTORY MISSING\")\n                continue\n\n            # Recursive search handles partitioned/nested Parquet directories.\n            files = sorted(folder.rglob(\"*.parquet\"))\n            print(f\"{split}/{folder_name}: {len(files)} Parquet files\")\n\n            if files:\n                sample_path = files[0]\n                sample = pd.read_parquet(sample_path)\n                print(\"  Sample:\", sample_path.relative_to(ROOT))\n                print(\"  Columns:\", sample.columns.tolist())\n                print(\"  Sample rows:\", len(sample))\n\n                # Show a few paths to identify the actual directory structure.\n                for p in files[:3]:\n                    print(\"  File:\", p.relative_to(ROOT))\n\n    task_base = ROOT / \"task1\" / panel\n    for split in [\"validation\", \"private\"]:\n        path = task_base / split / \"sample_submission_state.csv\"\n        if path.exists():\n            template = pd.read_csv(path)\n            print(\n                f\"Task template {split}: {len(template):,} rows, \"\n                f\"{template['timestamp'].nunique():,} timestamps\"\n            )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:37:14.608792Z","iopub.execute_input":"2026-10-19T17:37:14.609295Z","iopub.status.idle":"2026-10-19T17:37:28.456305Z","shell.execute_reply.started":"2026-10-19T17:37:14.609266Z","shell.execute_reply":"2026-10-19T17:37:28.45503Z"}},"outputs":[{"name":"stdout","text":"\n=============== D12_I405_N ===============\ntrain/mainline_states: 273 Parquet files\n  Sample: corridors/D12_I405_N/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_01.parquet\n  Columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n  Sample rows: 25632\n  File: corridors/D12_I405_N/