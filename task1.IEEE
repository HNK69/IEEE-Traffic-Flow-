   march_i5n[\"timestamp\"].dt.hour * 60 + march_i5n[\"timestamp\"].dt.minute\n)\n\n# 2. Attach January historical baseline profiles.\nmarch_i5n = march_i5n.merge(\n    profile_i5n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch_i5n = march_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch_i5n[\"base_speed\"] = march_i5n[\"base_speed\"].fillna(\n    march_i5n[\"link_base_speed\"]\n)\nmarch_i5n[\"base_flow\"] = march_i5n[\"base_flow\"].fillna(\n    march_i5n[\"link_base_flow\"]\n)\n\n# 3. Add lag features from observed January/February history.\nfor lag in LAGS_I5N:\n    src = observed_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    march_i5n = march_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    del src\n    gc.collect()\n\n# 4. Add lags from observed March values for later March timestamps.\nmarch_obs_i5n = march_i5n.loc[\n    march_i5n[\"is_observed\"].eq(1),\n    KEYS_I5N + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\n\nfor lag in LAGS_I5N:\n    src = march_obs_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"march_lag_speed_{lag}\",\n        \"obs_flow\": f\"march_lag_flow_{lag}\",\n    })\n    march_i5n = march_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    march_i5n[f\"lag_speed_{lag}\"] = march_i5n[f\"lag_speed_{lag}\"].fillna(\n        march_i5n[f\"march_lag_speed_{lag}\"]\n    )\n    march_i5n[f\"lag_flow_{lag}\"] = march_i5n[f\"lag_flow_{lag}\"].fillna(\n        march_i5n[f\"march_lag_flow_{lag}\"]\n    )\n    march_i5n.drop(\n        columns=[f\"march_lag_speed_{lag}\", f\"march_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar features and saved training encodings.\nmarch_i5n[\"weekday\"] = march_i5n[\"timestamp\"].dt.weekday\nmarch_i5n[\"minute_of_day\"] = (\n    march_i5n[\"timestamp\"].dt.hour * 60 + march_i5n[\"timestamp\"].dt.minute\n)\nmarch_i5n[\"tod_sin\"] = np.sin(2 * np.pi * march_i5n[\"minute_of_day\"] / 1440)\nmarch_i5n[\"tod_cos\"] = np.cos(2 * np.pi * march_i5n[\"minute_of_day\"] / 1440)\nmarch_i5n[\"weekday_sin\"] = np.sin(2 * np.pi * march_i5n[\"weekday\"] / 7)\nmarch_i5n[\"weekday_cos\"] = np.cos(2 * np.pi * march_i5n[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    march_i5n[col + \"_code\"] = (\n        march_i5n[col].map(category_maps_i5n[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict all March rows, then select official template rows.\nX_march_i5n = march_i5n[FEATURES_I5N].replace([np.inf, -np.inf], np.nan)\n\nmarch_i5n[\"pred_speed\"] = np.clip(\n    march_i5n[\"base_speed\"].to_numpy()\n    + speed_model_i5n_final.predict(X_march_i5n),\n    0, 160,\n)\nmarch_i5n[\"pred_flow\"] = np.clip(\n    march_i5n[\"base_flow\"].to_numpy()\n    + flow_model_i5n_final.predict(X_march_i5n),\n    0, None,\n)\n\ntemplate_path_i5n = (\n    ROOT / \"task1\" / PANEL_I5N / \"validation\" / \"sample_submission_state.csv\"\n)\ntemplate_i5n = pd.read_csv(template_path_i5n)\ntemplate_i5n[\"timestamp\"] = pd.to_datetime(\n    template_i5n[\"timestamp\"], utc=True\n)\n\njoin_keys_i5n = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\npred_source_i5n = march_i5n[\n    join_keys_i5n + [\"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source_i5n.duplicated(join_keys_i5n).any()\n\ntemplate_i5n[\"_row_order\"] = np.arange(len(template_i5n))\nresult_i5n = template_i5n.merge(\n    pred_source_i5n,\n    on=join_keys_i5