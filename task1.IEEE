truth has no mask_regime column\n","output_type":"stream"}],"execution_count":114},{"cell_type":"code","source":"from pathlib import Path\n\nJAN_MASKED_DIR = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\nprint(\"Directory exists:\", JAN_MASKED_DIR.exists())\nprint(\"Parquet files:\", len(list(JAN_MASKED_DIR.rglob(\"*.parquet\"))))\n\nsample_path = next(JAN_MASKED_DIR.rglob(\"*.parquet\"))\nsample = pd.read_parquet(sample_path)\n\nprint(\"\\nSample file:\", sample_path)\nprint(\"Columns:\", sample.columns.tolist())\ndisplay(sample.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:20:38.362439Z","iopub.execute_input":"2026-10-19T16:20:38.36297Z","iopub.status.idle":"2026-10-19T16:20:38.608386Z","shell.execute_reply.started":"2026-10-19T16:20:38.362939Z","shell.execute_reply":"2026-10-19T16:20:38.607373Z"}},"outputs":[{"name":"stdout","text":"Directory exists: True\nParquet files: 273\n\nSample file: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D7_I405_S/train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2031_01_10.parquet\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  corridor_id        date             timestamp          station_id  \\\n0   D7_I405_S  2031-01-10  2031-01-10T00:00:00Z  SYN_D7_I405_S_0033   \n1   D7_I405_S  2031-01-10  2031-01-10T00:00:00Z  SYN_D7_I405_S_0094   \n2   D7_I405_S  2031-01-10  2031-01-10T00:00:00Z  SYN_D7_I405_S_0021   \n3   D7_I405_S  2031-01-10  2031-01-10T00:00:00Z  SYN_D7_I405_S_0019   \n4   D7_I405_S  2031-01-10  2031-01-10T00:00:00Z  SYN_D7_I405_S_0035   \n\n     link_id  milepost direction   speed_kmh     flow_vph  occupancy  \\\n0  L405S-001    10.602         S  120.187025  2718.220074   0.076011   \n1  L405S-004    36.076         S  118.340076  2512.948865   0.076100   \n2  L405S-005     6.371         S  112.478013  2684.858295   0.083582   \n3  L405S-007     5.555         S         NaN          NaN        NaN   \n4  L405S-013    10.859         S         NaN          NaN        NaN   \n\n   density_occ_linear_vehpkm  pct_observed  is_observed  is_imputed  \\\n0                  21.663020           100            1           0   \n1                  21.688622           100            1           0   \n2                  23.820852           100            1           0   \n3                        NaN           100            1           0   \n4                        NaN            75            1           1   \n\n   is_score_eligible  is_missing mask_regime  \n0                  1           0          R1  \n1                  1           0          R1  \n2                  1           0          R1  \n3                  1           0          R1  \n4                  1           0          R1  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>corridor_id</th>\n      <th>date</th>\n      <th>timestamp</th>\n      <th>station_id</th>\n      <th>link_id</th>\n      <th>milepost</th>\n      <th>direction</th>\n      <th>speed_kmh</th>\n      <th>flow_vph</th>\n      <th>occupancy</th>\n      <th>density_occ_linear_vehpkm</th>\n      <th>pct_observed</th>\n      <th>is_observed</th>\n      <th>is_imputed</th>\n      <th>is_score_eligible</th>\n      <th>is_missing</th>\n      <th>mask_regime</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>D7_I405_S</td>\n      <td>2031-01-10</td>\n      <td>2031-01-10T00:00:00Z</td>\n      <td>SYN_D7_I405_S_0033</td>\n      <td>L405S-001</td>\n      <td>10.602</td>\n      <td>S</td>\n      <td>120.187025</td>\n      <td>2718.220074</td>\n      <td>0.076011</td>\n      <td>21.663020</td>\n      <td>100</td>\n      <td>1</td>\n      <td>0</td>\n      <td>1</td>\n      <td>0</td>\n      <td>R1</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>D7_I405_S</td>\n      <td>2031-01-10</td>\n      <td>2031-01-10T00:00:00Z</td>\n      <td>SYN_D7_I405_S_0094</td>\n      <td>L405S-004</td>\n      <td>36.076</td>\n      <td>S</td>\n      <td>118.340076</td>\n      <td>2512.948865</td>\n      <td>0.076100</td>\n      <td>21.688622</td>\n      <td>100</td>\n      <td>1</td>\n      <td>0</td>\n      <td>1</td>\n      <td>0</td>\n      <td>R1</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>D7_I405_S</td>\n      <td>2031-01-10</td>\n      <td>2031-01-10T00:00:00Z</td>\n      <td>SYN_D7_I405_S_0021</td>\n      <td>L405S-005</td>\n      <td>6.371</td>\n      <td>S</td>\n      <td>112.478013</td>\n      <td>2684.858295</td>\n      <td>0.083582</td>\n      <td>23.820852</td>\n      <td>100</td>\n      <td>1</td>\n      <td>0</td>\n      <td>1</td>\n      <td>0</td>\n      <td>R1</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>D7_I405_S</td>\n      <td>2031-01-10</td>\n      <td>2031-01-10T00:00:00Z</td>\n      <td>SYN_D7_I405_S_0019</td>\n      <td>L405S-007</td>\n      <td>5.555</td>\n      <td>S</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>100</td>\n      <td>1</td>\n      <td>0</td>\n      <td>1</td>\n      <td>0</td>\n      <td>R1</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>D7_I405_S</td>\n      <td>2031-01-10</td>\n      <td>2031-01-10T00:00:00Z</td>\n      <td>SYN_D7_I405_S_0035</td>\n      <td>L405S-013</td>\n      <td>10.859</td>\n      <td>S</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>75</td>\n      <td>1</td>\n      <td>1</td>\n      <td>1</td>\n      <td>0</td>\n      <td>R1</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":115},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nJAN_MASKED_DIR = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\n# Load only January masked records and the columns needed for regime mapping\njan_regime_parts = []\n\nfor path in JAN_MASKED_DIR.rglob(\"*.parquet\"):\n    if \"2031_01_\" not in path.name:\n        continue\n\n    part = pd.read_parquet(\n        path,\n        columns=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n    )\n    jan_regime_parts.append(part)\n\njan_regime_lookup = pd.concat(jan_regime_parts, ignore_index=True)\njan_regime_lookup[\"timestamp\"] = pd.to_datetime(\n    jan_regime_lookup[\"timestamp\"], utc=True\n)\n\njan_regime_lookup = jan_regime_lookup.drop_duplicates(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n)\n\n# Replace the missing regime values using the true masked-data assignments\njan_targets = jan_targets.drop(columns=[\"mask_regime\"]).merge(\n    jan_regime_lookup,\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nprint(\"January target rows:\", len(jan_targets))\nprint(\"Missing regime assignments:\", jan_targets[\"mask_regime\"].isna().sum())\ndisplay(jan_targets[\"mask_regime\"].value_counts(dropna=False))\n\n# Rebuild January features with pre-January baseline and masked lag data\njan_baseline = build_baseline(jan_targets, jan_start)\njan_features = attach_baseline(jan_targets, jan_baseline)\njan_features = add_lags(jan_features)\njan_features = add_model_features(jan_features)\n\nprint(\"\\nJanuary feature rows:\", len(jan_features))\nprint(\"Missing baseline speed:\", jan_features[\"base_speed\"].isna().sum())\nprint(\"Missing baseline flow:\", jan_features[\"base_flow\"].isna().sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:21:13.754671Z","iopub.execute_input":"2026-10-19T16:21:13.755098Z","iopub.status.idle":"2026-10-19T16:22:07.252258Z","shell.execute_reply.started":"2026-10-19T16:21:13.755068Z","shell.execute_reply":"2026-10-19T16:22:07.250883Z"}},"outputs":[{"name":"stdout","text":"January target rows: 743058\nMissing regime assignments: 0\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"mask_regime\nR2    287462\nR1    264013\nR3    191583\nName: count, dtype: int64"},"metadata":{}},{"name":"stdout","text":"\nJanuary feature rows: 743058\nMissing baseline speed: 0\nMissing baseline flow: 0\n","output_type":"stream"}],"execution_count":117},{"cell_type":"code","source":"# Build December training features for January temporal validation\n\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\ndec_start = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n\n# December eligible labels; used as training targets only\ndec_truth = truth.loc[\n    (truth[\"timestamp\"] >= dec_start)\n    & (truth[\"timestamp\"] < jan_start)\n    & truth[\"is_score_eligible\"].eq(1)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\n# Load December regimes from masked parquet files\ndec_parts = []\nfor path in ROOT.rglob(\"*.parquet\"):\n    if \"2030_12_\" not in path.name:\n        continue\n    dec_parts.append(\n        pd.read_parquet(\n            path,\n            columns=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n        )\n    )\n\ndec_regime_lookup = pd.concat(dec_parts, ignore_index=True)\ndec_regime_lookup[\"timestamp\"] = pd.to_datetime(\n    dec_regime_lookup[\"timestamp\"], utc=True\n)\ndec_regime_lookup = dec_regime_lookup.drop_duplicates(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n)\n\ndec_targets = dec_truth[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].merge(\n    dec_regime_lookup,\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nassert dec_targets[\"mask_regime\"].notna().all(), \"Missing December regimes\"\n\n# Build baseline from history strictly before December 1\ndec_baseline = build_baseline(dec_targets, dec_start)\ndec_features = attach_baseline(dec_targets, dec_baseline)\ndec_features = add_lags(dec_features)\ndec_features = add_model_features(dec_features)\n\n# Match the existing 19-feature schema\ndec_features = dec_features.rename(columns={\n    \"lag5_speed\": \"lag_speed_5\",\n    \"lag5_flow\": \"lag_flow_5\",\n    \"lag15_speed\": \"lag_speed_15\",\n    \"lag15_flow\": \"lag_flow_15\",\n    \"lag60_speed\": \"lag_speed_60\",\n    \"lag60_flow\": \"lag_flow_60\",\n    \"lag1440_speed\": \"lag_speed_1440\",\n    \"lag1440_flow\": \"lag_flow_1440\",\n    \"dow\": \"weekday\",\n    \"dow_sin\": \"weekday_sin\",\n    \"dow_cos\": \"weekday_cos\",\n})\n\n# Consistent sorted categorical codes across December and January\nfor col, code_col in [\n    (\"station_id\", \"station_id_code\"),\n    (\"link_id\", \"link_id_code\"),\n    (\"mask_regime\", \"mask_regime_code\"),\n]:\n    categories = sorted(\n        set(dec_features[col].astype(str))\n        | set(jan_features[col].astype(str))\n    )\n    mapping = {value: i for i, value in enumerate(categories)}\n\n    dec_features[code_col] = (\n        dec_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n    jan_features[code_col] = (\n        jan_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n\nX_dec = dec_features[FEATURES].astype(\"float32\")\nX_jan = jan_features[FEATURES].astype(\"float32\")\n\nprint(\"December training rows:\", len(X_dec))\nprint(\"January validation rows:\", len(X_jan))\nprint(\"December missing regimes:\", dec_features[\"mask_regime\"].isna().sum())\nprint(\"January missing regimes:\", jan_features[\"mask_regime\"].isna().sum())\nprint(\"December missing baseline:\", dec_features[[\"base_speed\", \"base_flow\"]].isna().sum().sum())\nprint(\"January missing baseline:\", jan_features[[\"base_speed\", \"base_flow\"]].isna().sum().sum())\nprint(\"Feature count:\", X_dec.shape[1])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:22:57.333184Z","iopub.execute_input":"2026-10-19T16:22:57.333648Z","iopub.status.idle":"2026-10-19T16:23:50.739082Z","shell.execute_reply.started":"2026-10-19T16:22:57.333615Z","shell.execute_reply":"2026-10-19T16:23:50.737831Z"}},"outputs":[{"name":"stdout","text":"December training rows: 744102\nJanuary validation rows: 743058\nDecember missing regimes: 0\nJanuary missing regimes: 0\nDecember missing baseline: 0\nJanuary missing baseline: 0\nFeature count: 19\n","output_type":"stream"}],"execution_count":119},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n# Train targets are residuals relative to the December baseline\ny_dec_speed = (\n    dec_features[\"speed_kmh\"].to_numpy()\n    - dec_features[\"base_speed\"].to_numpy()\n)\ny_dec_flow = (\n    dec_features[\"flow_vph\"].to_numpy()\n    - dec_features[\"base_flow\"].to_numpy()\n)\n\njan_base_speed = jan_features[\"base_speed\"].to_numpy()\njan_base_flow = jan_features[\"base_flow\"].to_numpy()\n\n# Independent temporal-validation models\njan_speed_model = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\njan_flow_model = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\njan_speed_model.fit(X_dec, y_dec_speed)\njan_flow_model.fit(X_dec, y_dec_flow)\n\n# Predict January; labels are used only for evaluation\njan_pred_speed = np.clip(\n    jan_base_speed + jan_speed_model.predict(X_jan), 0, 160\n)\njan_pred_flow = np.clip(\n    jan_base_flow + jan_flow_model.predict(X_jan), 0, None\n)\n\njan_actual_speed = jan_features[\"speed_kmh\"].to_numpy()\njan_actual_flow = jan_features[\"flow_vph\"].to_numpy()\n\n# Official metric: macro-average over R1/R2/R3\njan_eval = jan_features[[\"mask_regime\"]].copy()\njan_eval[\"speed_actual\"] = jan_actual_speed\njan_eval[\"flow_actual\"] = jan_actual_flow\njan_eval[\"speed_pred\"] = jan_pred_speed\njan_eval[\"flow_pred\"] = jan_pred_flow\njan_eval[\"speed_base\"] = jan_base_speed\njan_eval[\"flow_base\"] = jan_base_flow\n\nrows = []\nfor regime, group in jan_eval.groupby(\"mask_regime\", observed=True):\n    speed_rmse_model = np.sqrt(\n        mean_squared_error(group[\"speed_actual\"], group[\"speed_pred\"])\n    )\n    flow_rmse_lane_model = np.sqrt(\n        np.mean(\n            (\n                (group[\"flow_actual\"] - group[\"flow_pred\"])\n                / 1.0\n            ) ** 2\n        )\n    )\n\n    speed_rmse_base = np.sqrt(\n        mean_squared_error(group[\"speed_actual\"], group[\"speed_base\"])\n    )\n    flow_rmse_lane_base = np.sqrt(\n        np.mean(\n            (\n                (group[\"flow_actual\"] - group[\"flow_base\"])\n                / 1.0\n            ) ** 2\n        )\n    )\n\n    score_model = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_model / 600)\n    )\n    score_base = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_base / 600)\n    )\n\n    rows.append({\n        \"regime\": regime,\n        \"rows\": len(group),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_baseline\": flow_rmse_lane_base,\n        \"flow_rmse_model\": flow_rmse_lane_model,\n        \"score_baseline\": score_base,\n        \"score_model\": score_model,\n    })\n\njan_results = pd.DataFrame(rows)\ndisplay(jan_results.round(4))\n\nprint(\"January baseline macro score:\",\n      round(jan_results[\"score_baseline\"].mean(), 6))\nprint(\"January residual-model macro score:\",\n      round(jan_results[\"score_model\"].mean(), 6))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:30:18.004799Z","iopub.execute_input":"2026-10-19T16:30:18.006625Z","iopub.status.idle":"2026-10-19T16:30:50.127408Z","shell.execute_reply.started":"2026-10-19T16:30:18.00657Z","shell.execute_reply":"2026-10-19T16:30:50.126477Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"  regime    rows  speed_rmse_baseline  speed_rmse_model  flow_rmse_baseline  \\\n0     R1  264013              13.2498            5.2644            435.6318   \n1     R2  287462              13.3808            6.6742            401.0261   \n2     R3  191583              12.7841            7.2959            431.3580   \n\n   flow_rmse_model  score_baseline  score_model  \n0         298.7019          0.3798       0.6573  \n1         320.7479          0.4035       0.6099  \n2         340.3971          0.3932       0.5814  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>regime</th>\n      <th>rows</th>\n      <th>speed_rmse_baseline</th>\n      <th>speed_rmse_model</th>\n      <th>flow_rmse_baseline</th>\n      <th>flow_rmse_model</th>\n      <th>score_baseline</th>\n      <th>score_model</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>R1</td>\n      <td>264013</td>\n      <td>13.2498</td>\n      <td>5.2644</td>\n      <td>435.6318</td>\n      <td>298.7019</td>\n      <td>0.3798</td>\n      <td>0.6573</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>R2</td>\n      <td>287462</td>\n      <td>13.3808</td>\n      <td>6.6742</td>\n      <td>401.0261</td>\n      <td>320.7479</td>\n      <td>0.4035</td>\n      <td>0.6099</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>R3</td>\n      <td>191583</td>\n      <td>12.7841</td>\n      <td>7.2959</td>\n      <td>431.3580</td>\n      <td>340.3971</td>\n      <td>0.3932</td>\n      <td>0.5814</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"January baseline macro score: 0.392165\nJanuary residual-model macro score: 0.616217\n","output_type":"stream"}],"execution_count":120},{"cell_type":"code","source":"# Inspect available lane-count metadata\nprint(\"Truth columns:\", truth.columns.tolist())\nprint(\"January feature columns:\", jan_features.columns.tolist())\n\nfor name in [\"metadata\", \"links\", \"link_metadata\", \"station_metadata\"]:\n    if name in globals():\n        obj = globals()[name]\n        print(f\"\\n{name}: {type(obj).__name__}\")\n        if hasattr(obj, \"columns\"):\n            print(obj.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:31:35.060336Z","iopub.execute_input":"2026-10-19T16:31:35.060834Z","iopub.status.idle":"2026-10-19T16:31:35.074746Z","shell.execute_reply.started":"2026-10-19T16:31:35.060803Z","shell.execute_reply":"2026-10-19T16:31:35.071776Z"}},"outputs":[{"name":"stdout","text":"Truth columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph', 'pct_observed', 'is_score_eligible']\nJanuary feature columns: ['timestamp', 'station_id', 'link_id', 'speed_kmh', 'flow_vph', 'mask_regime', 'base_speed', 'base_flow', 'lag_speed_5', 'lag_flow_5', 'lag_speed_15', 'lag_flow_15', 'lag_speed_60', 'lag_flow_60', 'lag_speed_1440', 'lag_flow_1440', 'weekday', 'minute_of_day', 'tod_sin', 'tod_cos', 'weekday_sin', 'weekday_cos', 'station_id_code', 'link_id_code', 'mask_regime_code']\n\nmetadata: DataFrame\n['link_id', 'length_km', 'lanes', 'free_speed_kmh', 'capacity_vph']\n\nlinks: DataFrame\n['link_id', 'lanes']\n","output_type":"stream"}],"execution_count":121},{"cell_type":"code","source":"# Recalculate January validation using the official lane-normalized metric\n\njan_eval_lanes = jan_eval.merge(\n    metadata[[\"link_id\", \"lanes\"]],\n    left_index=False,\n    right_index=False,\n    left_on=jan_features[\"link_id\"],\n    right_on=metadata[\"link_id\"],\n    how=\"left\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:10.357874Z","iopub.execute_input":"2026-10-19T16:32:10.358349Z","iopub.status.idle":"2026-10-19T16:32:10.596215Z","shell.execute_reply.started":"2026-10-19T16:32:10.358294Z","shell.execute_reply":"2026-10-19T16:32:10.595141Z"}},"outputs":[],"execution_count":123},{"cell_type":"code","source":"# Attach lane counts by link_id\njan_eval_lanes = jan_eval.copy()\njan_eval_lanes[\"link_id\"] = jan_features[\"link_id\"].to_numpy()\n\njan_eval_lanes = jan_eval_lanes.merge(\n    metadata[[\"link_id\", \"lanes\"]],\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nassert jan_eval_lanes[\"lanes\"].notna().all(), \"Missing lane counts\"\nassert (jan_eval_lanes[\"lanes\"] > 0).all(), \"Invalid lane counts\"\n\nrows = []\nfor regime, g in jan_eval_lanes.groupby(\"mask_regime\", observed=True):\n    speed_rmse_base = np.sqrt(\n        np.mean((g[\"speed_actual\"] - g[\"speed_base\"]) ** 2)\n    )\n    speed_rmse_model = np.sqrt(\n        np.mean((g[\"speed_actual\"] - g[\"speed_pred\"]) ** 2)\n    )\n\n    flow_rmse_base = np.sqrt(\n        np.mean(((g[\"flow_actual\"] - g[\"flow_base\"]) / g[\"lanes\"]) ** 2)\n    )\n    flow_rmse_model = np.sqrt(\n        np.mean(((g[\"flow_actual\"] - g[\"flow_pred\"]) / g[\"lanes\"]) ** 2)\n    )\n\n    score_base = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_base / 600)\n    )\n    score_model = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_model / 600)\n    )\n\n    rows.append({\n        \"regime\": regime,\n        \"rows\": len(g),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_lane_baseline\": flow_rmse_base,\n        \"flow_rmse_lane_model\": flow_rmse_model,\n        \"score_baseline\": score_base,\n        \"score_model\": score_model,\n    })\n\njan_official_results = pd.DataFrame(rows)\ndisplay(jan_official_results.round(4))\n\nprint(\n    \"January baseline macro score:\",\n    round(jan_official_results[\"score_baseline\"].mean(), 6)\n)\nprint(\n    \"January residual-model macro score:\",\n    round(jan_official_results[\"score_model\"].mean(), 6)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:16.707568Z","iopub.execute_input":"2026-10-19T16:32:16.707977Z","iopub.status.idle":"2026-10-19T16:32:17.123221Z","shell.execute_reply.started":"2026-10-19T16:32:16.707946Z","shell.execute_reply":"2026-10-19T16:32:17.122067Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"  regime    rows  speed_rmse_baseline  speed_rmse_model  \\\n0     R1  264013              13.2498            5.2644   \n1     R2  287462              13.3808            6.6742   \n2     R3  191583              12.7841            7.2959   \n\n   flow_rmse_lane_baseline  flow_rmse_lane_model  score_baseline  score_model  \n0                 103.0639               70.8523          0.6348       0.8320  \n1                  94.8933               76.0851          0.6382       0.7975  \n2                 102.0273               80.6908          0.6456       0.7805  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>regime</th>\n      <th>rows</th>\n      <th>speed_rmse_baseline</th>\n      <th>speed_rmse_model</th>\n      <th>flow_rmse_lane_baseline</th>\n      <th>flow_rmse_lane_model</th>\n      <th>score_baseline</th>\n      <th>score_model</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>R1</td>\n      <td>264013</td>\n      <td>13.2498</td>\n      <td>5.2644</td>\n      <td>103.0639</td>\n      <td>70.8523</td>\n      <td>0.6348</td>\n      <td>0.8320</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>R2</td>\n      <td>287462</td>\n      <td>13.3808</td>\n      <td>6.6742</td>\n      <td>94.8933</td>\n      <td>76.0851</td>\n      <td>0.6382</td>\n      <td>0.7975</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>R3</td>\n      <td>191583</td>\n      <td>12.7841</td>\n      <td>7.2959</td>\n      <td>102.0273</td>\n      <td>80.6908</td>\n      <td>0.6456</td>\n      <td>0.7805</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"January baseline macro score: 0.639551\nJanuary residual-model macro score: 0.80334\n","output_type":"stream"}],"execution_count":124},{"cell_type":"code","source":"# January temporal-holdout correction distribution\njan_eval_lanes[\"correction\"] = (\n    jan_eval_lanes[\"speed_pred\"] - jan_eval_lanes[\"speed_base\"]\n)\n\ndisplay(\n    jan_eval_lanes.groupby(\"mask_regime\", observed=True)\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        correction_std=(\"correction\", \"std\"),\n        below_minus_30_pct=(\n            \"correction\", lambda x: 100 * (x < -30).mean()\n        ),\n        below_minus_60_pct=(\n            \"correction\", lambda x: 100 * (x < -60).mean()\n        ),\n    )\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:54.792229Z","iopub.execute_input":"2026-10-19T16:32:54.792642Z","iopub.status.idle":"2026-10-19T16:32:54.953773Z","shell.execute_reply.started":"2026-10-19T16:32:54.792612Z","shell.execute_reply":"2026-10-19T16:32:54.952631Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"               rows  mean_correction  median_correction  correction_std  \\\nmask_regime                                                               \nR1           264013           -0.784              0.019          11.640   \nR2           287462           -0.462              0.017          11.167   \nR3           191583           -0.281              0.004          10.262   \n\n             below_minus_30_pct  below_minus_60_pct  \nmask_regime                                          \nR1                        3.240               0.711  \nR2                        2.888               0.689  \nR3                        2.373               0.424  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>rows</th>\n      <th>mean_correction</th>\n      <th>median_correction</th>\n      <th>correction_std</th>\n      <th>below_minus_30_pct</th>\n      <th>below_minus_60_pct</th>\n    </tr>\n    <tr>\n      <th>mask_regime</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>R1</th>\n      <td>264013</td>\n      <td>-0.784</td>\n      <td>0.019</td>\n      <td>11.640</td>\n      <td>3.240</td>\n      <td>0.711</td>\n    </tr>\n    <tr>\n      <th>R2</th>\n      <td>287462</td>\n      <td>-0.462</td>\n      <td>0.017</td>\n      <td>11.167</td>\n      <td>2.888</td>\n      <td>0.689</td>\n    </tr>\n    <tr>\n      <th>R3</th>\n      <td>191583</td>\n      <td>-0.281</td>\n      <td>0.004</td>\n      <td>10.262</td>\n      <td>2.373</td>\n      <td>0.424</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":125},{"cell_type":"code","source":"# Compare January holdout vs February vs April for R2 midday/evening\n# using the same lag-speed buckets\n\ndef correction_detail(frame, correction, period):\n    mask = frame[\"mask_regime\"].eq(\"R2\")\n    df = frame.loc[mask].copy()\n    df[\"correction\"] = np.asarray(correction)[mask.to_numpy()]\n\n    hour = df[\"timestamp\"].dt.hour\n    df[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n\n    for col, out_col in [\n        (\"lag_speed_5\", \"lag5_band\"),\n        (\"lag_speed_15\", \"lag15_band\"),\n    ]:\n        df[out_col] = pd.cut(\n            df[col],\n            bins=[-np.inf, 40, 60, 80, np.inf],\n            labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n        ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"period\"] = period\n    return df\n\njan_r2_detail = correction_detail(\n    jan_features,\n    jan_eval_lanes[\"correction\"].to_numpy(),\n    \"January\"\n)\n\nfeb_r2_detail = correction_detail(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_r2_detail = correction_detail(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\nall_detail = pd.concat(\n    [jan_r2_detail, feb_r2_detail, apr_r2_detail],\n    ignore_index=True\n)\n\ncomparison = (\n    all_detail.loc[\n        all_detail[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"period\", \"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        negative30_rate_pct=(\n            \"correction\", lambda x: 100 * (x < -30).mean()\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(\n    comparison.loc[comparison[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\", \"period\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:37:23.017812Z","iopub.execute_input":"2026-10-19T16:37:23.018891Z","iopub.status.idle":"2026-10-19T16:37:23.818567Z","shell.execute_reply.started":"2026-10-19T16:37:23.018849Z","shell.execute_reply":"2026-10-19T16:37:23.816982Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"       period   time_period lag5_band lag15_band  rows  mean_correction  \\\n0       April        Midday     40-60      40-60   661           -32.01   \n48   February        Midday     40-60      40-60   463           -22.86   \n96    January        Midday     40-60      40-60  1452           -20.53   \n97    January        Midday     40-60      60-80   132           -11.87   \n4       April        Midday     40-60    Missing   425           -32.13   \n..        ...           ...       ...        ...   ...              ...   \n94   February  Evening peak   Missing        >80  3436             4.90   \n140   January  Evening peak   Missing        >80  9313             4.32   \n47      April  Evening peak   Missing    Missing  2273            -1.74   \n95   February  Evening peak   Missing    Missing  2620            -0.62   \n141   January  Evening peak   Missing    Missing  6876             1.36   \n\n     negative30_rate_pct  \n0                  50.98  \n48                 29.81  \n96                 24.86  \n97                 12.88  \n4                  50.59  \n..                   ...  \n94                  0.00  \n140                 0.00  \n47                  2.38  \n95                  1.91  \n141                 0.07  \n\n[67 rows x 7 columns]","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>period</th>\n      <th>time_period</th>\n      <th>lag5_band</th>\n      <th>lag15_band</th>\n      <th>rows</th>\n      <th>mean_correction</th>\n      <th>negative30_rate_pct</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>April</td>\n      <td>Midday</td>\n      <td>40-60</td>\n      <td>40-60</td>\n      <td>661</td>\n      <td>-32.01</td>\n      <td>50.98</td>\n    </tr>\n    <tr>\n      <th>48</th>\n      <td>February</td>\n      <td>Midday</td>\n      <td>40-60</td>\n      <td>40-60</td>\n      <td>463</td>\n      <td>-22.86</td>\n      <td>29.81</td>\n    </tr>\n    <tr>\n      <th>96</th>\n      <td>January</td>\n      <td>Midday</td>\n      <td>40-60</td>\n      <td>40-60</td>\n      <td>1452</td>\n      <td>-20.53</td>\n      <td>24.86</td>\n    </tr>\n    <tr>\n      <th>97</th>\n      <td>January</td>\n      <td>Midday</td>\n      <td>40-60</td>\n      <td>60-80</td>\n      <td>132</td>\n      <td>-11.87</td>\n      <td>12.88</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>April</td>\n      <td>Midday</td>\n      <td>40-60</td>\n      <td>Missing</td>\n      <td>425</td>\n      <td>-32.13</td>\n      <td>50.59</td>\n    </tr>\n    <tr>\n      <th>...</th>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n    </tr>\n    <tr>\n      <th>94</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&gt;80</td>\n      <td>3436</td>\n      <td>4.90</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>140</th>\n      <td>January</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&gt;80</td>\n      <td>9313</td>\n      <td>4.32</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>47</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>2273</td>\n      <td>-1.74</td>\n      <td>2.38</td>\n    </tr>\n    <tr>\n      <th>95</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>2620</td>\n      <td>-0.62</td>\n      <td>1.91</td>\n    </tr>\n    <tr>\n      <th>141</th>\n      <td>January</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>6876</td>\n      <td>1.36</td>\n      <td>0.07</td>\n    </tr>\n  </tbody>\n</table>\n<p>67 rows × 7 columns</p>\n</div>"},"metadata":{}}],"execution_count":126},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\ndf = jan_eval_lanes.copy()\n\n# Add timestamp and time-of-day categories\ndf[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\ndf[\"hour\"] = df[\"timestamp\"].dt.hour\n\ndf[\"time_period\"] = pd.cut(\n    df[\"hour\"],\n    bins=[-1, 5, 9, 15, 19, 23],\n    labels=[\n        \"Night\",\n        \"Morning peak\",\n        \"Midday\",\n        \"Evening peak\",\n        \"Late evening\",\n    ],\n)\n\ndef calculate_metrics(g):\n    speed_actual = g[\"speed_actual\"].to_numpy()\n    speed_pred = g[\"speed_pred\"].to_numpy()\n    speed_base = g[\"speed_base\"].to_numpy()\n\n    flow_actual = g[\"flow_actual\"].to_numpy()\n    flow_pred = g[\"flow_pred\"].to_numpy()\n    flow_base = g[\"flow_base\"].to_numpy()\n    lanes = g[\"lanes\"].to_numpy()\n\n    speed_rmse_model = np.sqrt(np.mean((speed_actual - speed_pred) ** 2))\n    speed_rmse_base = np.sqrt(np.mean((speed_actual - speed_base) ** 2))\n\n    flow_rmse_lane_model = np.sqrt(\n        np.mean(((flow_actual - flow_pred) / lanes) ** 2)\n    )\n    flow_rmse_lane_base = np.sqrt(\n        np.mean(((flow_actual - flow_base) / lanes) ** 2)\n    )\n\n    model_score = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_model / 600)\n    )\n    baseline_score = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_base / 600)\n    )\n\n    return pd.Series({\n        \"rows\": len(g),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_lane_baseline\": flow_rmse_lane_base,\n        \"flow_rmse_lane_model\": flow_rmse_lane_model,\n        \"baseline_score\": baseline_score,\n        \"model_score\": model_score,\n        \"score_gain\": model_score - baseline_score,\n    })\n\nresults = (\n    df.groupby([\"mask_regime\", \"time_period\"], observed=True)\n      .apply(calculate_metrics, include_groups=False)\n      .reset_index()\n      .sort_values([\"mask_regime\", \"time_period\"])\n)\n\ndisplay(results.round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:39:22.831774Z","iopub.execute_input":"2026-10-19T16:39:22.832671Z","iopub.status.idle":"2026-10-19T16:39:26.042165Z","shell.execute_reply.started":"2026-10-19T16:39:22.832628Z","shell.execute_reply":"2026-10-19T16:39:26.040211Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"  