       -95.322094\n25%          -0.021852\n50%           0.016922\n75%           0.120025\nmax          79.941263\ndtype: float64\n\nApril correction distribution:\ncount    243603.000000\nmean         -0.765491\nstd          12.960050\nmin         -95.669003\n25%          -0.027571\n50%           0.014966\n75%           0.163157\nmax          86.287288\ndtype: float64\n\nFraction with correction below -30 km/h:\nFebruary: 0.027478757149954774\nApril:    0.0366005344761764\n\nFraction with correction below -60 km/h:\nFebruary: 0.005728456713844691\nApril:    0.011227283736242986\n","output_type":"stream"}],"execution_count":84},{"cell_type":"code","source":"# Compare residual correction tails by masking regime\nfor name, frame, corrections in [\n    (\"February\", holdout_data, feb_correction),\n    (\"April\", private_features, apr_correction),\n]:\n    tmp = pd.DataFrame({\n        \"mask_regime\": frame[\"mask_regime\"].to_numpy(),\n        \"correction\": corrections,\n    })\n\n    print(f\"\\n{name}\")\n    display(\n        tmp.groupby(\"mask_regime\")[\"correction\"]\n        .agg(\n            count=\"size\",\n            mean=\"mean\",\n            median=\"median\",\n            std=\"std\",\n            below_minus30=lambda s: (s < -30).mean(),\n            below_minus60=lambda s: (s < -60).mean(),\n        )\n        .round(4)\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:54:00.473275Z","iopub.execute_input":"2026-10-19T15:54:00.47429Z","iopub.status.idle":"2026-10-19T15:54:00.682951Z","shell.execute_reply.started":"2026-10-19T15:54:00.474244Z","shell.execute_reply":"2026-10-19T15:54:00.681651Z"}},"outputs":[{"name":"stdout","text":"\nFebruary\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"              count    mean  median      std  below_minus30  below_minus60\nmask_regime                                                               \nR1            19157 -0.3295  0.0109  10.1328   