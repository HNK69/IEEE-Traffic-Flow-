{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":153956}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\nSPLITS = [\"train\", \"validation\", \"private\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nassert ROOT.is_dir(), f\"Release root missing: {ROOT}\"\nassert (ROOT / \"corridors\").is_dir()\nassert (ROOT / \"task1\").is_dir()\n\nprint(\"Release root:\", ROOT)\nprint(\"Panels:\", len(PANELS), \"| Splits:\", SPLITS)\nprint(\"\\nChecking templates, masked partitions, train labels, and lanes...\")\n\nall_ok = True\ntemplate_summary = []\ntrain_sample_checked = 0\n\nfor panel in PANELS:\n    panel_dir = ROOT / \"corridors\" / panel\n    assert panel_dir.is_dir(), f\"Missing panel directory: {panel_dir}\"\n\n    # Lane metadata must be available for official per-lane flow scoring.\n    lane_path = panel_dir / \"network\" / \"links.csv\"\n    fd_path = panel_dir / \"network\" / \"fd_parameters.csv\"\n    assert lane_path.is_file(), f\"Missing lane metadata: {lane_path}\"\n    lanes_df = pd.read_csv(lane_path, dtype={\"link_id\": str})\n    assert {\"link_id\", \"lanes\"}.issubset(lanes_df.columns), (\n        f\"{lane_path} must contain link_id and lanes; got {list(lanes_df.columns)}\"\n    )\n    usable_lanes = pd.to_numeric(lanes_df[\"lanes\"], errors=\"coerce\")\n    assert (usable_lanes.between(1, 16) | usable_lanes.isna()).all(), (\n        f\"Unexpected lane values in {lane_path}\"\n    )\n\n    for split in SPLITS:\n        template_path = ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n        assert template_path.is_file(), f\"Missing Task 1 template: {template_path}\"\n\n        # Templates can be large; load only target key columns.\n        template = pd.read_csv(\n            template_path,\n            usecols=[\"timestamp\", \"station_id\", \"link_id\"],\n            dtype=str,\n        )\n        key_cols = [\"timestamp\", \"station_id\", \"link_id\"]\n        assert len(template) > 0, f\"Empty template: {template_path}\"\n        assert not template[key_cols].isna().any().any(), f\"Null template keys: {template_path}\"\n        assert not template.duplicated(key_cols).any(), f\"Duplicate template keys: {template_path}\"\n\n        expected_keys = set(map(tuple, template[key_cols].itertuples(index=False, name=None)))\n        masked_root = panel_dir / split / \"mainline_states_masked\"\n        assert masked_root.is_dir(), f\"Missing masked directory: {masked_root}\"\n\n        parquet_files = sorted(masked_root.glob(\"mask_regime=*/synthetic_mainline_*.parquet\"))\n        assert parquet_files, f\"No masked Parquet files: {masked_root}\"\n\n        actual_target_count = 0\n        matched_target_count = 0\n        covered_keys = set()\n        train_truth_count = 0\n\n        # Read all daily files in this panel/split. Target membership comes from\n        # the template, not from nulls alone; files are checked via their keys.\n        for fp in parquet_files:\n            cols = [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n            if split == \"train\":\n                cols += [\"is_score_eligible\"]\n            frame = pd.read_parquet(fp, columns=cols)\n            frame[\"timestamp\"] = frame[\"timestamp\"].astype(str)\n            frame[\"station_id\"] = frame[\"station_id\"].astype(str)\n            frame[\"link_id\"] = frame[\"link_id\"].astype(str)\n            keys = list(map(tuple, frame[key_cols].itertuples(index=False, name=None)))\n            is_target = np.fromiter((k in expected_keys for k in keys), dtype=bool, count=len(keys))\n            n_target_here = int(is_target.sum())\n            actual_target_count += n_target_here\n            if n_target_here:\n                found = set(k for k, flag in zip(keys, is_target) if flag)\n                covered_keys.update(found)\n                target_rows = frame.loc[is_target]\n                matched_target_count += len(target_rows)\n\n                # Target rows must be blank in the masked layer.\n                bad_nonblank = target_rows[\"speed_kmh\"].notna() | target_rows[\"flow_vph\"].notna()\n                if bad_nonblank.any():\n                    raise AssertionError(\n                        f\"{panel}/{split}: template target is not blank in {fp.name}\"\n                    )\n\n                if split == \"train\":\n                    if \"is_score_eligible\" not in target_rows.columns:\n                        raise AssertionError(\"Training labels are missing is_score_eligible\")\n                    eligible = target_rows[\"is_score_eligible\"].astype(bool)\n                    if not eligible.all():\n                        raise AssertionError(\n                            f\"{panel}/train: template includes ineligible target rows in {fp.name}\"\n                        )\n\n        # Every template key should appear in exactly one masked partition.\n        assert len(covered_keys) == len(expected_keys), (\n            f\"{panel}/{split}: template keys covered {len(covered_keys):,}/\"\n            f\"{len(expected_keys):,}\"\n        )\n        assert actual_target_count == len(expected_keys), (\n            f\"{panel}/{split}: template key count {len(expected_keys):,} != \"\n            f\"partition matches {actual_target_count:,}; possible duplicate keys across files\"\n        )\n\n        # For train only, the truth comes from the separate unmasked mainline_states\n        # layer. Verify a representative unmasked file is present and has labels.\n        if split == \"train\":\n            truth_files = sorted((panel_dir / \"train\" / \"mainline_states\").glob(\"**/*.parquet\"))\n            assert truth_files, f\"Missing unmasked training labels for {panel}\"\n            truth = pd.read_parquet(\n                truth_files[0],\n                columns=[\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\", \"pct_observed\"],\n            )\n            assert truth[\"speed_kmh\"].notna().any() and truth[\"flow_vph\"].notna().any(), (\n                f\"Unmasked training labels appear empty: {truth_files[0]}\"\n            )\n            train_sample_checked += 1\n\n        template_summary.append({\n            \"panel\": panel,\n            \"split\": split,\n            \"template_rows\": len(template),\n            \"masked_partitions\": len(parquet_files),\n            \"lane_metadata_rows\": len(lanes_df),\n        })\n\n        print(\n            f\"OK | {panel:12s} | {split:10s} | \"\n            f\"targets={len(template):,} | masked files={len(parquet_files)}\"\n        )\n\nsummary = pd.DataFrame(template_summary)\nsummary_path = Path(\"/kaggle/working/task1_integrity_summary.csv\")\nsummary.to_csv(summary_path, index=False)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"INTEGRITY CHECK PASSED\")\nprint(\"=\" * 80)\nprint(\"Template checks:\", len(summary), \"(expected 30)\")\nprint(\"Training panels with unmasked truth verified:\", train_sample_checked)\nprint(\"Total published target rows across 30 templates:\", f\"{summary.template_rows.sum():,}\")\nprint(\"Summary saved to:\", summary_path)\nprint(\"\\nThis validates target-key coverage and file structure; it does not yet evaluate prediction quality.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T06:00:19.971651Z","iopub.execute_input":"2026-10-19T06:00:19.972558Z","iopub.status.idle":"2026-10-19T06:07:10.981299Z","shell.execute_reply.started":"2026-10-19T06:00:19.972524Z","shell.execute_reply":"2026-10-19T06:07:10.980469Z"}},"outputs":[{"name":"stdout","text":"Release root: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\nPanels: 10 | Splits: ['train', 'validation', 'private']\n\nChecking templates, masked partitions, train labels, and lanes...\nOK | D12_I405_N   | train      | targets=1,793,853 | masked files=273\nOK | D12_I405_N   | validation | targets=203,337 | masked files=31\nOK | D12_I405_N   | private    | targets=192,164 | masked files=30\nOK | D12_I405_S   | train      | targets=947,966 | masked files=273\nOK | D12_I405_S   | validation | targets=93,718 | masked files=31\nOK | D12_I405_S   | private    | targets=107,416 | masked files=30\nOK | D12_I5_N     | train      | targets=5,148,741 | masked files=273\nOK | D12_I5_N     | validation | targets=588,468 | masked files=31\nOK | D12_I5_N     | private    | targets=543,092 | masked files=30\nOK | D12_I5_S     | train      | targets=2,049,512 | masked files=273\nOK | D12_I5_S     | validation | targets=219,222 | masked files=31\nOK | D12_I5_S     | private    | targets=204,957 | masked files=30\nOK | D7_I10_E     | train      | targets=2,815,381 | masked files=273\nOK | D7_I10_E     | validation | targets=337,512 | masked files=31\nOK | D7_I10_E     | private    | targets=303,294 | masked files=30\nOK | D7_I10_W     | train      | targets=2,156,021 | masked files=273\nOK | D7_I10_W     | validation | targets=233,060 | masked files=31\nOK | D7_I10_W     | private    | targets=203,699 | masked files=30\nOK | D7_I210_E    | train      | targets=6,061,039 | masked files=273\nOK | D7_I210_E    | validation | targets=625,014 | masked files=31\nOK | D7_I210_E    | private    | targets=581,196 | masked files=30\nOK | D7_I210_W    | train      | targets=1,569,035 | masked files=273\nOK | D7_I210_W    | validation | targets=205,973 | masked files=31\nOK | D7_I210_W    | private    | targets=158,901 | masked files=30\nOK | D7_I405_N    | train      | targets=7,114,278 | masked files=273\nOK | D7_I405_N    | validation | targets=673,133 | masked files=31\nOK | D7_I405_N    | private    | targets=746,097 | masked files=30\nOK | D7_I405_S    | train      | targets=2,127,937 | masked files=273\nOK | D7_I405_S    | validation | targets=271,939 | masked files=31\nOK | D7_I405_S    | private    | targets=243,603 | masked files=30\n\n================================================================================\nINTEGRITY CHECK PASSED\n================================================================================\nTemplate checks: 30 (expected 30)\nTraining panels with unmasked truth verified: 10\nTotal published target rows across 30 templates: 38,519,558\nSummary saved to: /kaggle/working/task1_integrity_summary.csv\n\nThis validates target-key coverage and file structure; it does not yet evaluate prediction quality.\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\n# ============================================================\n# CONFIG\n# ============================================================\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nPANEL = \"D7_I405_S\"\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\npanel_dir = ROOT / \"corridors\" / PANEL\ntruth_dir = panel_dir / \"train\" / \"mainline_states\"\ntemplate_path = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n# ============================================================\n# 1. Read the official Task 1 target keys\n# ============================================================\ntargets = pd.read_csv(\n    template_path,\n    usecols=KEYS,\n    dtype={\"station_id\": str, \"link_id\": str}\n)\ntargets[\"timestamp\"] = pd.to_datetime(targets[\"timestamp\"], utc=True)\ntargets = targets[targets[\"timestamp\"] >= HOLDOUT_START].copy()\ntargets = targets.drop_duplicates(KEYS)\n\ntarget_keys = targets.set_index(KEYS).index\nprint(f\"Panel: {PANEL}\")\nprint(f\"Holdout start: {HOLDOUT_START}\")\nprint(f\"Template holdout targets: {len(targets):,}\")\n\n# ============================================================\n# 2. Build historical profiles using ONLY pre-holdout truth\n#    Separate speed and flow counts; use pct_observed >= 75.\n# ============================================================\ndaily_aggregates = []\ntrain_files = sorted(truth_dir.glob(\"**/*.parquet\"))\nassert train_files, f\"No truth files found in {truth_dir}\"\n\nfor i, path in enumerate(train_files, 1):\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"link_id\", \"speed_kmh\",\n            \"flow_vph\", \"pct_observed\"\n        ]\n    )\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    df = df[df[\"timestamp\"] < HOLDOUT_START]\n\n    if df.empty:\n        continue\n\n    ts = df[\"timestamp\"]\n    df[\"slot\"] = (\n        ts.dt.dayofweek * 288\n        + ts.dt.hour * 12\n        + ts.dt.minute // 5\n    ).astype(\"int16\")\n\n    eligible = pd.to_numeric(\n        df[\"pct_observed\"], errors=\"coerce\"\n    ).ge(75)\n\n    speed = pd.to_numeric(df[\"speed_kmh\"], errors=\"coerce\")\n    flow = pd.to_numeric(df[\"flow_vph\"], errors=\"coerce\")\n\n    df[\"speed_sum\"] = speed.where(eligible & np.isfinite(speed), 0.0)\n    df[\"speed_n\"] = (eligible & np.isfinite(speed)).astype(\"int32\")\n    df[\"flow_sum\"] = flow.where(eligible & np.isfinite(flow), 0.0)\n    df[\"flow_n\"] = (eligible & np.isfinite(flow)).astype(\"int32\")\n\n    agg = df.groupby([\"link_id\", \"slot\"], observed=True).agg(\n        speed_sum=(\"speed_sum\", \"sum\"),\n        speed_n=(\"speed_n\", \"sum\"),\n        flow_sum=(\"flow_sum\", \"sum\"),\n        flow_n=(\"flow_n\", \"sum\"),\n    ).reset_index()\n\n    daily_aggregates.append(agg)\n\n    if i % 50 == 0:\n        print(f\"Processed {i}/{len(train_files)} truth files\")\n\nassert daily_aggregates, \"No pre-holdout data available.\"\n\nprofile = (\n    pd.concat(daily_aggregates, ignore_index=True)\n    .groupby([\"link_id\", \"slot\"], as_index=False)\n    .sum()\n)\n\nprofile[\"hist_speed\"] = (\n    profile[\"speed_sum\"] / profile[\"speed_n\"].replace(0, np.nan)\n)\nprofile[\"hist_flow\"] = (\n    profile[\"flow_sum\"] / profile[\"flow_n\"].replace(0, np.nan)\n)\n\n# Link-level fallbacks if a link/time-of-week slot has no valid history.\nlink_profile = profile.groupby(\"link_id\").agg(\n    link_speed_sum=(\"speed_sum\", \"sum\"),\n    link_speed_n=(\"speed_n\", \"sum\"),\n    link_flow_sum=(\"flow_sum\", \"sum\"),\n    link_flow_n=(\"flow_n\", \"sum\"),\n).reset_index()\n\nlink_profile[\"fallback_speed\"] = (\n    link_profile[\"link_speed_sum\"]\n    / link_profile[\"link_speed_n\"].replace(0, np.nan)\n)\nlink_profile[\"fallback_flow\"] = (\n    link_profile[\"link_flow_sum\"]\n    / link_profile[\"link_flow_n\"].replace(0, np.nan)\n)\n\nprofile = profile.merge(\n    link_profile[[\"link_id\", \"fallback_speed\", \"fallback_flow\"]],\n    on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nprint(f\"Historical link/slot profiles: {len(profile):,}\")\n\n# ============================================================\n# 3. Load lane counts\n# ============================================================\nlinks_path = panel_dir / \"network\" / \"links.csv\"\nlinks = pd.read_csv(links_path)\nlinks.columns = [c.strip() for c in links.columns]\n\nlink_col = next(\n    (c for c in links.columns if c.lower() == \"link_id\"), None\n)\nlane_col = next(\n    (c for c in links.columns\n     if c.lower() in {\"lanes\", \"lane_count\", \"num_lanes\", \"number_of_lanes\"}),\n    None\n)\n\nif link_col is None or lane_col is None:\n    raise ValueError(\n        \"Could not identify link_id/lane-count columns in links.csv. \"\n        f\"Available columns: {links.columns.tolist()}\"\n    )\n\nlinks[link_col] = links[link_col].astype(str)\nlinks[lane_col] = pd.to_numeric(links[lane_col], errors=\"coerce\")\nlane_map = (\n    links.dropna(subset=[lane_col])\n    .drop_duplicates(link_col)\n    .set_index(link_col)[lane_col]\n)\n\n# ============================================================\n# 4. Score the actual targets separately for R1, R2 and R3\n# ============================================================\nresults = []\n\nfor regime in REGIMES:\n    masked_dir = (\n        panel_dir / \"train\" / \"mainline_states_masked\"\n        / f\"mask_regime={regime}\"\n    )\n    masked_files = sorted(masked_dir.glob(\"*.parquet\"))\n    assert masked_files, f\"No masked files for {regime}\"\n\n    sq_speed = 0.0\n    sq_flow = 0.0\n    n_scored = 0\n    n_targets_found = 0\n\n    for masked_path in masked_files:\n        # Only score dates inside the chronological holdout.\n        day = pd.to_datetime(masked_path.stem.replace(\n            \"synthetic_mainline_\", \"\"\n        ), format=\"%Y_%m_%d\", utc=True)\n\n        if day < HOLDOUT_START:\n            continue\n\n        truth_path = truth_dir / masked_path.name\n        if not truth_path.exists():\n            matches = list(truth_dir.glob(f\"**/{masked_path.name}\"))\n            if not matches:\n                continue\n            truth_path = matches[0]\n\n        masked = pd.read_parquet(\n            masked_path,\n            columns=KEYS + [\"speed_kmh\", \"flow_vph\"]\n        )\n        masked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n        masked[\"station_id\"] = masked[\"station_id\"].astype(str)\n        masked[\"link_id\"] = masked[\"link_id\"].astype(str)\n\n        # Only cells blanked in BOTH scored channels are candidates.\n        blanked = masked[\n            masked[\"speed_kmh\"].isna() & masked[\"flow_vph\"].isna()\n        ][KEYS].drop_duplicates()\n\n        if blanked.empty:\n            continue\n\n        # Intersect with the official template so Task 2-only blanks\n        # are not incorrectly scored as Task 1 targets.\n        blanked = blanked.merge(\n            targets[KEYS], on=KEYS, how=\"inner\", validate=\"one_to_one\"\n        )\n        if blanked.empty:\n            continue\n\n        truth = pd.read_parquet(\n            truth_path,\n            columns=KEYS + [\n                \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n            ]\n        )\n        truth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\n        truth[\"station_id\"] = truth[\"station_id\"].astype(str)\n        truth[\"link_id\"] = truth[\"link_id\"].astype(str)\n\n        truth = truth[truth[\"is_score_eligible\"].astype(bool)]\n        truth = blanked.merge(\n            truth, on=KEYS, how=\"inner\", validate=\"one_to_one\"\n        )\n        if truth.empty:\n            continue\n\n        n_targets_found += len(truth)\n\n        ts = truth[\"timestamp\"]\n        truth[\"slot\"] = (\n            ts.dt.dayofweek * 288\n            + ts.dt.hour * 12\n            + ts.dt.minute // 5\n        ).astype(\"int16\")\n\n        scored = truth.merge(\n            profile[[\n                \"link_id\", \"slot\", \"hist_speed\", \"hist_flow\",\n                \"fallback_speed\", \"fallback_flow\"\n            ]],\n            on=[\"link_id\", \"slot\"],\n            how=\"left\",\n            validate=\"many_to_one\"\n        )\n\n        scored[\"pred_speed\"] = scored[\"hist_speed\"].fillna(\n            scored[\"fallback_speed\"]\n        )\n        scored[\"pred_flow\"] = scored[\"hist_flow\"].fillna(\n            scored[\"fallback_flow\"]\n        )\n\n        scored[\"lanes\"] = scored[\"link_id\"].map(lane_map)\n\n        true_speed = pd.to_numeric(\n            scored[\"speed_kmh\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        true_flow = pd.to_numeric(\n            scored[\"flow_vph\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        pred_speed = pd.to_numeric(\n            scored[\"pred_speed\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        pred_flow = pd.to_numeric(\n            scored[\"pred_flow\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        lanes = pd.to_numeric(\n            scored[\"lanes\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n\n        valid = (\n            np.isfinite(true_speed) & np.isfinite(true_flow)\n            & np.isfinite(pred_speed) & np.isfinite(pred_flow)\n            & np.isfinite(lanes) & (lanes > 0)\n        )\n        if not valid.any():\n            continue\n\n        ds = pred_speed[valid] - true_speed[valid]\n        dq = (pred_flow[valid] - true_flow[valid]) / lanes[valid]\n\n        sq_speed += float(np.sum(ds ** 2))\n        sq_flow += float(np.sum(dq ** 2))\n        n_scored += int(valid.sum())\n\n    if n_scored == 0:\n        raise ValueError(f\"No scoreable targets found for {regime}\")\n\n    rmse_speed = np.sqrt(sq_speed / n_scored)\n    rmse_flow = np.sqrt(sq_flow / n_scored)\n    s_speed = max(0.0, 1.0 - rmse_speed / 25.0)\n    s_flow = max(0.0, 1.0 - rmse_flow / 600.0)\n    s_state = 0.54 * s_speed + 0.46 * s_flow\n\n    results.append({\n        \"regime\": regime,\n        \"scored_targets\": n_scored,\n        \"eligible_targets_found\": n_targets_found,\n        \"speed_RMSE\": rmse_speed,\n        \"flow_RMSE_per_lane\": rmse_flow,\n        \"S_speed\": s_speed,\n        \"S_flow\": s_flow,\n        \"S_state\": s_state,\n    })\n\n    print(\n        f\"{regime}: n={n_scored:,} | \"\n        f\"speed RMSE={rmse_speed:.4f} | \"\n        f\"flow RMSE/lane={rmse_flow:.4f} | \"\n        f\"S_state={s_state:.6f}\"\n    )\n\n# Official-style regime macro-average for this panel/holdout.\nresult_df = pd.DataFrame(results)\nmacro_score = result_df[\"S_state\"].mean()\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"CHRONOLOGICAL BASELINE — REGIME-WISE\")\nprint(result_df.to_string(index=False, float_format=lambda x: f\"{x:.6f}\"))\nprint(f\"\\nRegime-macro S_state: {macro_score:.6f}\")\nprint(\"=\" * 60)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T07:47:49.527652Z","iopub.execute_input":"2026-10-19T07:47:49.528012Z","iopub.status.idle":"2026-10-19T07:48:17.028488Z","shell.execute_reply.started":"2026-10-19T07:47:49.527984Z","shell.execute_reply":"2026-10-19T07:48:17.027624Z"}},"outputs":[{"name":"stdout","text":"Panel: D7_I405_S\nHoldout start: 2031-02-01 00:00:00+00:00\nTemplate holdout targets: 235,491\nProcessed 50/273 truth files\nProcessed 100/273 truth files\nProcessed 150/273 truth files\nProcessed 200/273 truth files\nHistorical link/slot profiles: 219,744\nR1: n=19,157 | speed RMSE=11.1154 | flow RMSE/lane=79.4165 | S_state=0.699020\nR2: n=108,110 | speed RMSE=12.8175 | flow RMSE/lane=101.8759 | S_state=0.645038\nR3: n=108,224 | speed RMSE=13.6231 | flow RMSE/lane=116.4972 | S_state=0.616426\n\n============================================================\nCHRONOLOGICAL BASELINE — REGIME-WISE\nregime  scored_targets  eligible_targets_found  speed_RMSE  flow_RMSE_per_lane  S_speed   S_flow  S_state\n    R1           19157                   19157   11.115449           79.416453 0.555382 0.867639 0.699020\n    R2          108110                  108110   12.817455          101.875854 0.487302 0.830207 0.645038\n    R3          108224                  108224   13.623117          116.497210 0.455075 0.805838 0.616426\n\nRegime-macro S_state: 0.653495\n============================================================\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\n\nwarnings.filterwarnings(\"ignore\", category=RuntimeWarning)\n\n# ============================================================\n# CONFIG\n# ============================================================\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/trafficflow_eda_audit\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\nSPLITS = [\"train\", \"validation\", \"private\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTRAFFIC_COLS = [\n    \"speed_kmh\", \"flow_vph\", \"occupancy\",\n    \"density_occ_linear_vehpkm\", \"pct_observed\"\n]\nFLAG_COLS = [\n    \"is_score_eligible\", \"is_observed\",\n    \"is_imputed\", \"is_missing\"\n]\n\ndef safe_read_parquet(path, columns=None):\n    try:\n        return pd.read_parquet(path, columns=columns)\n    except Exception as exc:\n        print(f\"READ ERROR: {path.name}: {exc}\")\n        return None\n\ndef find_files(folder):\n    return sorted(folder.glob(\"**/*.parquet\")) if folder.exists() else []\n\ndef normalize_keys(df):\n    df = df.copy()\n    if \"timestamp\" in df:\n        df[\"timestamp\"] = pd.to_datetime(\n            df[\"timestamp\"], utc=True, errors=\"coerce\"\n        )\n    for col in [\"station_id\", \"link_id\"]:\n        if col in df:\n            df[col] = df[col].astype(str)\n    return df\n\ndef get_target_template(panel, split):\n    path = ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n    if not path.exists():\n        return None, path\n    try:\n        # Read only key columns to keep memory use down.\n        df = pd.read_csv(\n            path,\n            usecols=lambda c: c in KEYS,\n            dtype={\"station_id\": str, \"link_id\": str}\n        )\n        if not set(KEYS).issubset(df.columns):\n            return None, path\n        return normalize_keys(df), path\n    except Exception as exc:\n        print(f\"TEMPLATE ERROR: {path}: {exc}\")\n        return None, path\n\n# ============================================================\n# 1. FILE INVENTORY + SCHEMA\n# ============================================================\nprint(\"=\" * 78)\nprint(\"PHASE 1 — INVENTORY AND SCHEMA\")\nprint(\"=\" * 78)\n\ninventory_rows = []\nschema_rows = []\npanel_metadata_rows = []\n\nfor panel in PANELS:\n    pdir = ROOT / \"corridors\" / panel\n\n    # Network metadata\n    for filename in [\"links.csv\", \"fd_parameters.csv\"]:\n        path = pdir / \"network\" / filename\n        if path.exists():\n            try:\n                meta = pd.read_csv(path)\n                panel_metadata_rows.append({\n                    \"panel\": panel,\n                    \"file\": filename,\n                    \"rows\": len(meta),\n                    \"columns\": \"|\".join(meta.columns.astype(str)),\n                    \"duplicate_link_ids\": (\n                        int(meta[\"link_id\"].duplicated().sum())\n                        if \"link_id\" in meta else np.nan\n                    ),\n                    \"missing_cells\": int(meta.isna().sum().sum())\n                })\n            except Exception as exc:\n                panel_metadata_rows.append({\n                    \"panel\": panel, \"file\": filename, \"error\": str(exc)\n                })\n\n    for split in SPLITS:\n        for layer in [\"mainline_states\", \"mainline_states_masked\"]:\n            folder = pdir / split / layer\n            files = find_files(folder)\n            inventory_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"layer\": layer,\n                \"directory_exists\": folder.exists(),\n                \"file_count\": len(files),\n                \"first_file\": files[0].name if files else None,\n                \"last_file\": files[-1].name if files else None\n            })\n\n            if files:\n                sample = safe_read_parquet(files[0])\n                if sample is not None:\n                    schema_rows.append({\n                        \"panel\": panel,\n                        \"split\": split,\n                        \"layer\": layer,\n                        \"sample_file\": files[0].name,\n                        \"rows_in_sample\": len(sample),\n                        \"columns\": \"|\".join(sample.columns.astype(str)),\n                        \"missing_required_keys\": \"|\".join(\n                            sorted(set(KEYS) - set(sample.columns))\n                        ),\n                        \"missingness_columns_present\": \"|\".join(\n                            c for c in TRAFFIC_COLS + FLAG_COLS\n                            if c in sample.columns\n                        )\n                    })\n\ninventory_df = pd.DataFrame(inventory_rows)\nschema_df = pd.DataFrame(schema_rows)\nmetadata_df = pd.DataFrame(panel_metadata_rows)\n\ninventory_df.to_csv(OUT / \"01_file_inventory.csv\", index=False)\nschema_df.to_csv(OUT / \"02_schema_audit.csv\", index=False)\nmetadata_df.to_csv(OUT / \"03_network_metadata.csv\", index=False)\n\nprint(inventory_df.to_string(index=False))\nprint(\"\\nSchema samples:\")\nprint(schema_df.to_string(index=False))\nprint(\"\\nReports saved:\", OUT)\n\n# ============================================================\n# 2. MASKING AUDIT\n#    Inspect ALL masked files, not just selected dates.\n#    Count blank cells, flags, template matches and key coverage.\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"PHASE 2 — MASKING AND TEMPLATE AUDIT\")\nprint(\"=\" * 78)\n\nmask_file_rows = []\nmask_group_rows = []\ntemplate_rows = []\ntruth_rows = []\n\nfor panel in PANELS:\n    pdir = ROOT / \"corridors\" / panel\n    print(f\"\\nAuditing panel: {panel}\")\n\n    for split in SPLITS:\n        template, template_path = get_target_template(panel, split)\n\n        template_keys = None\n        if template is not None:\n            template = template.drop_duplicates(KEYS)\n            template_keys = pd.MultiIndex.from_frame(template[KEYS])\n\n            template_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"template_exists\": True,\n                \"template_path\": str(template_path),\n                \"template_unique_keys\": len(template),\n                \"template_duplicate_keys\": 0,\n                \"template_min_timestamp\": template.timestamp.min(),\n                \"template_max_timestamp\": template.timestamp.max()\n            })\n        else:\n            template_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"template_exists\": False,\n                \"template_path\": str(template_path),\n                \"template_unique_keys\": 0,\n                \"template_duplicate_keys\": np.nan,\n                \"template_min_timestamp\": None,\n                \"template_max_timestamp\": None\n            })\n\n        # Truth files: training should have unmasked truth.\n        truth_dir = pdir / split / \"mainline_states\"\n        truth_files = find_files(truth_dir)\n\n        truth_key_count = 0\n        truth_eligible_count = 0\n        truth_duplicate_count = 0\n        truth_speed_null = 0\n        truth_flow_null = 0\n        truth_rows_total = 0\n        truth_key_set = set()\n\n        # Full truth audit is most important on train.\n        if split == \"train\":\n            for tf in truth_files:\n                t = safe_read_parquet(tf)\n                if t is None:\n                    continue\n                truth_rows_total += len(t)\n\n                if \"speed_kmh\" in t:\n                    truth_speed_null += int(t.speed_kmh.isna().sum())\n                if \"flow_vph\" in t:\n                    truth_flow_null += int(t.flow_vph.isna().sum())\n                if \"is_score_eligible\" in t:\n                    truth_eligible_count += int(\n                        t[\"is_score_eligible\"].fillna(False).astype(bool).sum()\n                    )\n\n                if set(KEYS).issubset(t.columns):\n                    t = normalize_keys(t)\n                    truth_duplicate_count += int(t.duplicated(KEYS).sum())\n                    truth_key_count += len(t)\n\n                    # Used to check template keys against truth coverage.\n                    # Keep normalized key tuples for accurate membership checks.\n                    truth_key_set.update(\n                        zip(t.timestamp, t.station_id, t.link_id)\n                    )\n\n        truth_rows.append({\n            \"panel\": panel,\n            \"split\": split,\n            \"truth_files\": len(truth_files),\n            \"truth_rows\": truth_rows_total,\n            \"truth_key_rows\": truth_key_count,\n            \"truth_duplicate_keys\": truth_duplicate_count,\n            \"truth_eligible_rows\": truth_eligible_count,\n            \"truth_speed_nulls\": truth_speed_null,\n            \"truth_flow_nulls\": truth_flow_null,\n            \"truth_unique_keys_in_memory\": len(truth_key_set)\n        })\n\n        masked_root = pdir / split / \"mainline_states_masked\"\n        total_files = 0\n        total_rows = 0\n        total_speed_null = 0\n        total_flow_null = 0\n        total_both_null = 0\n        total_speed_only_null = 0\n        total_flow_only_null = 0\n        total_is_missing_true = 0\n        total_is_observed_false = 0\n        total_is_imputed_true = 0\n        total_eligible_true = 0\n        total_template_matches = 0\n        total_template_matches_both_null = 0\n        total_key_duplicates = 0\n        total_key_missing = 0\n        total_template_truth_matches = 0\n\n        for regime in REGIMES:\n            folder = masked_root / f\"mask_regime={regime}\"\n            files = find_files(folder)\n\n            group = {\n                \"panel\": panel,\n                \"split\": split,\n                \"regime\": regime,\n                \"files\": len(files),\n                \"rows\": 0,\n                \"speed_nulls\": 0,\n                \"flow_nulls\": 0,\n                \"both_null\": 0,\n                \"speed_only_null\": 0,\n                \"flow_only_null\": 0,\n                \"is_missing_true\": 0,\n                \"is_observed_false\": 0,\n                \"is_imputed_true\": 0,\n                \"eligible_true\": 0,\n                \"template_matches\": 0,\n                \"template_matches_both_null\": 0,\n                \"duplicate_keys\": 0,\n                \"missing_key_rows\": 0\n            }\n\n            for fi, path in enumerate(files, 1):\n                df = safe_read_parquet(path)\n                if df is None:\n                    continue\n\n                total_files += 1\n                n = len(df)\n                total_rows += n\n                group[\"rows\"] += n\n\n                for col in KEYS:\n                    if col not in df.columns:\n                        raise ValueError(\n                            f\"Missing key {col} in {path}\"\n                        )\n\n                df = normalize_keys(df)\n                key_missing = df[KEYS].isna().any(axis=1)\n                dup = df.duplicated(KEYS)\n                group[\"duplicate_keys\"] += int(dup.sum())\n                group[\"missing_key_rows\"] += int(key_missing.sum())\n                total_key_duplicates += int(dup.sum())\n                total_key_missing += int(key_missing.sum())\n\n                has_speed = \"speed_kmh\" in df.columns\n                has_flow = \"flow_vph\" in df.columns\n                speed_null = (\n                    df[\"speed_kmh\"].isna()\n                    if has_speed else pd.Series(False, index=df.index)\n                )\n                flow_null = (\n                    df[\"flow_vph\"].isna()\n                    if has_flow else pd.Series(False, index=df.index)\n                )\n\n                both_null = speed_null & flow_null\n                speed_only = speed_null & ~flow_null\n                flow_only = flow_null & ~speed_null\n\n                group[\"speed_nulls\"] += int(speed_null.sum())\n                group[\"flow_nulls\"] += int(flow_null.sum())\n                group[\"both_null\"] += int(both_null.sum())\n                group[\"speed_only_null\"] += int(speed_only.sum())\n                group[\"flow_only_null\"] += int(flow_only.sum())\n\n                total_speed_null += int(speed_null.sum())\n                total_flow_null += int(flow_null.sum())\n                total_both_null += int(both_null.sum())\n                total_speed_only_null += int(speed_only.sum())\n                total_flow_only_null += int(flow_only.sum())\n\n                if \"is_missing\" in df:\n                    count = int(df[\"is_missing\"].fillna(False).astype(bool).sum())\n                    group[\"is_missing_true\"] += count\n                    total_is_missing_true += count\n\n                if \"is_observed\" in df:\n                    count = int((~df[\"is_observed\"].fillna(True).astype(bool)).sum())\n                    group[\"is_observed_false\"] += count\n                    total_is_observed_false += count\n\n                if \"is_imputed\" in df:\n                    count = int(df[\"is_imputed\"].fillna(False).astype(bool).sum())\n                    group[\"is_imputed_true\"] += count\n                    total_is_imputed_true += count\n\n                if \"is_score_eligible\" in df:\n                    count = int(df[\"is_score_eligible\"].fillna(False).astype(bool).sum())\n                    group[\"eligible_true\"] += count\n                    total_eligible_true += count\n\n                # Match template keys by exact timestamp/station/link.\n                # This does NOT assume target cells must be null.\n                template_matches = 0\n                template_matches_both_null = 0\n\n                if template_keys is not None and len(template_keys):\n                    keys_idx = pd.MultiIndex.from_frame(df[KEYS])\n                    in_template = keys_idx.isin(template_keys)\n                    template_matches = int(in_template.sum())\n                    template_matches_both_null = int(\n                        (in_template & both_null.to_numpy()).sum()\n                    )\n\n                    group[\"template_matches\"] += template_matches\n                    group[\"template_matches_both_null\"] += template_matches_both_null\n                    total_template_matches += template_matches\n                    total_template_matches_both_null += template_matches_both_null\n\n                # Keep file-level details for identifying the exact failure.\n                mask_file_rows.append({\n                    \"panel\": panel,\n                    \"split\": split,\n                    \"regime\": regime,\n                    \"file\": path.name,\n                    \"rows\": n,\n                    \"min_timestamp\": df[\"timestamp\"].min(),\n                    \"max_timestamp\": df[\"timestamp\"].max(),\n                    \"speed_nulls\": int(speed_null.sum()),\n                    \"flow_nulls\": int(flow_null.sum()),\n                    \"both_null\": int(both_null.sum()),\n                    \"speed_only_null\": int(speed_only.sum()),\n                    \"flow_only_null\": int(flow_only.sum()),\n                    \"is_missing_true\": (\n                        int(df[\"is_missing\"].fillna(False).astype(bool).sum())\n                        if \"is_missing\" in df else np.nan\n                    ),\n                    \"is_observed_false\": (\n                        int((~df[\"is_observed\"].fillna(True).astype(bool)).sum())\n                        if \"is_observed\" in df else np.nan\n                    ),\n                    \"is_imputed_true\": (\n                        int(df[\"is_imputed\"].fillna(False).astype(bool).sum())\n                        if \"is_imputed\" in df else np.nan\n                    ),\n                    \"template_key_matches\": template_matches,\n                    \"template_matches_both_null\": template_matches_both_null,\n                    \"duplicate_keys\": int(dup.sum()),\n                    \"missing_key_rows\": int(key_missing.sum()),\n                    \"columns\": \"|\".join(df.columns.astype(str))\n                })\n\n            mask_group_rows.append(group)\n\n        print(\n            f\"  {split}: template keys=\"\n            f\"{len(template_keys) if template_keys is not None else 'MISSING'}, \"\n            f\"masked rows={total_rows:,}, both-null={total_both_null:,}, \"\n            f\"template key matches={total_template_matches:,}, \"\n            f\"matches also both-null={total_template_matches_both_null:,}\"\n        )\n\n# ============================================================\n# 3. TRAFFIC DISTRIBUTIONS AND FLAG RELATIONSHIPS\n#    Aggregate descriptive statistics over all training truth.\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"PHASE 3 — TRAINING TRAFFIC DISTRIBUTIONS\")\nprint(\"=\" * 78)\n\ntraffic_rows = []\nflag_rows = []\ntemporal_rows = []\n\nfor panel in PANELS:\n    truth_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n    files = find_files(truth_dir)\n\n    # Stream one file at a time; avoid loading the whole panel.\n    for path in files:\n        df = safe_read_parquet(path)\n        if df is None:\n            continue\n\n        if \"timestamp\" in df:\n            df[\"timestamp\"] = pd.to_datetime(\n                df[\"timestamp\"], utc=True, errors=\"coerce\"\n            )\n\n        for col in TRAFFIC_COLS:\n            if col not in df.columns:\n                continue\n\n            x = pd.to_numeric(df[col], errors=\"coerce\")\n            finite = x[np.isfinite(x)]\n\n            if len(finite):\n                traffic_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"feature\": col,\n                    \"n_rows\": len(df),\n                    \"n_non_null_finite\": len(finite),\n                    \"null_or_nonfinite\": len(df) - len(finite),\n                    \"mean\": finite.mean(),\n                    \"std\": finite.std(),\n                    \"min\": finite.min(),\n                    \"p01\": finite.quantile(0.01),\n                    \"p05\": finite.quantile(0.05),\n                    \"median\": finite.median(),\n                    \"p95\": finite.quantile(0.95),\n                    \"p99\": finite.quantile(0.99),\n                    \"max\": finite.max()\n                })\n\n        # Compare missingness and eligibility flags.\n        flag_subset = [c for c in FLAG_COLS if c in df.columns]\n        if flag_subset:\n            flags = {}\n            for col in flag_subset:\n                flags[col] = (\n                    df[col].fillna(False).astype(bool)\n                    if col in [\"is_score_eligible\", \"is_observed\",\n                               \"is_imputed\", \"is_missing\"]\n                    else df[col]\n                )\n            if \"is_missing\" in flags and \"is_observed\" in flags:\n                flag_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"rows\": len(df),\n                    \"is_missing_true\": int(flags[\"is_missing\"].sum()),\n                    \"is_observed_true\": int(flags[\"is_observed\"].sum()),\n                    \"is_imputed_true\": (\n                        int(flags[\"is_imputed\"].sum())\n                        if \"is_imputed\" in flags else np.nan\n                    ),\n                    \"eligible_true\": (\n                        int(flags[\"is_score_eligible\"].sum())\n                        if \"is_score_eligible\" in flags else np.nan\n                    ),\n                    \"missing_and_observed\": int(\n                        (flags[\"is_missing\"] & flags[\"is_observed\"]).sum()\n                    ),\n                    \"missing_and_imputed\": (\n                        int((flags[\"is_missing\"] & flags[\"is_imputed\"]).sum())\n                        if \"is_imputed\" in flags else np.nan\n                    )\n                })\n\n        if \"timestamp\" in df:\n            ts = df[\"timestamp\"].dropna()\n            if len(ts):\n                temporal_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"rows\": len(df),\n                    \"min_timestamp\": ts.min(),\n                    \"max_timestamp\": ts.max(),\n                    \"unique_timestamps\": ts.nunique(),\n                    \"weekdays_present\": ts.dt.dayofweek.nunique(),\n                    \"hours_present\": ts.dt.hour.nunique(),\n                    \"minute_values\": \"|\".join(\n                        map(str, sorted(ts.dt.minute.unique().tolist()))\n                    )\n                })\n\n    print(f\"  Finished traffic summaries: {panel}\")\n\n# ============================================================\n# 4. SAVE REPORTS\n# ============================================================\nmask_files_df = pd.DataFrame(mask_file_rows)\nmask_groups_df = pd.DataFrame(mask_group_rows)\ntemplates_df = pd.DataFrame(template_rows)\ntruth_df = pd.DataFrame(truth_rows)\ntraffic_df = pd.DataFrame(traffic_rows)\nflags_df = pd.DataFrame(flag_rows)\ntemporal_df = pd.DataFrame(temporal_rows)\n\nreports = {\n    \"04_mask_file_details.csv\": mask_files_df,\n    \"05_mask_group_summary.csv\": mask_groups_df,\n    \"06_template_audit.csv\": templates_df,\n    \"07_truth_audit.csv\": truth_df,\n    \"08_traffic_statistics.csv\": traffic_df,\n    \"09_flag_consistency.csv\": flags_df,\n    \"10_temporal_audit.csv\": temporal_df,\n}\n\nfor filename, frame in reports.items():\n    frame.to_csv(OUT / filename, index=False)\n\n# ============================================================\n# 5. PRINT HIGH-VALUE FINDINGS\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"AUDIT FINDINGS\")\nprint(\"=\" * 78)\n\nprint(\"\\nMASK SUMMARY:\")\nif not mask_groups_df.empty:\n    cols = [\n        \"panel\", \"split\", \"regime\", \"files\", \"rows\",\n        \"speed_nulls\", \"flow_nulls\", \"both_null\",\n        \"is_missing_true\", \"is_observed_false\",\n        \"template_matches\", \"template_matches_both_null\",\n        \"duplicate_keys\", \"missing_key_rows\"\n    ]\n    print(mask_groups_df[cols].to_string(index=False))\n\nprint(\"\\nTEMPLATE SUMMARY:\")\nprint(templates_df.to_string(index=False))\n\nprint(\"\\nTRAIN TRUTH SUMMARY:\")\nprint(truth_df.to_string(index=False))\n\nprint(\"\\nTRAFFIC STATISTICS (combined by panel and feature):\")\nif not traffic_df.empty:\n    print(\n        traffic_df.groupby([\"panel\", \"feature\"], as_index=False).agg(\n            rows=(\"n_rows\", \"sum\"),\n            non_null=(\"n_non_null_finite\", \"sum\"),\n            mean_of_file_means=(\"mean\", \"mean\"),\n            min=(\"min\", \"min\"),\n            median_of_file_medians=(\"median\", \"median\"),\n            max=(\"max\", \"max\")\n        ).to_string(index=False)\n    )\n\nprint(\"\\nFlag consistency summary:\")\nif not flags_df.empty:\n    print(\n        flags_df.groupby(\"panel\", as_index=False).agg(\n            rows=(\"rows\", \"sum\"),\n            missing_true=(\"is_missing_true\", \"sum\"),\n            observed_true=(\"is_observed_true\", \"sum\"),\n            imputed_true=(\"is_imputed_true\", \"sum\"),\n            eligible_true=(\"eligible_true\", \"sum\"),\n            missing_and_observed=(\"missing_and_observed\", \"sum\")\n        ).to_string(index=False)\n    )\n\n# Make the output location and report list explicit.\nmanifest = {\n    \"root\": str(ROOT),\n    \"output_directory\": str(OUT),\n    \"panels\": PANELS,\n    \"splits\": SPLITS,\n    \"regimes\": REGIMES,\n    \"reports\": list(reports.keys()),\n    \"warning\": (\n        \"File-level traffic means are descriptive only; use weighted \"\n        \"row-level aggregates for model decisions. No files were modified.\"\n    )\n}\n(OUT / \"audit_manifest.json\").write_text(\n    json.dumps(manifest, indent=2), encoding=\"utf-8\"\n)\n\nprint(\"\\n\" + \"=\" * 78)\nprint(\"EDA AND MASKING AUDIT FINISHED\")\nprint(\"Reports directory:\", OUT)\nfor filename in list(reports.keys()) + [\"audit_manifest.json\"]:\n    print(\" -\", filename)\nprint(\"=\" * 78)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T08:08:05.421305Z","iopub.execute_input":"2026-10-19T08:08:05.42169Z","iopub.status.idle":"2026-10-19T08:28:51.73668Z","shell.execute_reply.started":"2026-10-19T08:08:05.421661Z","shell.execute_reply":"2026-10-19T08:28:51.735781Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"==============================================================================\nPHASE 1 — INVENTORY AND SCHEMA\n==============================================================================\n     panel      split                  layer  directory_exists  file_count                            first_file                             last_file\nD12_I405_N      train        mainline_states              True         273 synthetic_mainline_2030_06_01.parquet synthetic_mainline_2031_02_28.parquet\nD12_I405_N      train mainline_states_masked              True         273 synthetic_mainline_2030_06_02.parqu