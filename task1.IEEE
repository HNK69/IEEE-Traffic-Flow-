>-0.01</td>\n      <td>50.48</td>\n      <td>50.47</td>\n    </tr>\n    <tr>\n      <th>35</th>\n      <td>Evening peak</td>\n      <td>&lt;40</td>\n      <td>&lt;40</td>\n      <td>536</td>\n      <td>8.45</td>\n      <td>-0.45</td>\n      <td>32.34</td>\n      <td>31.90</td>\n    </tr>\n    <tr>\n      <th>37</th>\n      <td>Evening peak</td>\n      <td>&lt;40</td>\n      <td>Missing</td>\n      <td>349</td>\n      <td>12.16</td>\n      <td>0.17</td>\n      <td>32.58</td>\n      <td>32.75</td>\n    </tr>\n    <tr>\n      <th>41</th>\n      <td>Evening peak</td>\n      <td>&gt;80</td>\n      <td>&gt;80</td>\n      <td>6022</td>\n      <td>2.80</td>\n      <td>0.12</td>\n      <td>112.97</td>\n      <td>113.08</td>\n    </tr>\n    <tr>\n      <th>42</th>\n      <td>Evening peak</td>\n      <td>&gt;80</td>\n      <td>Missing</td>\n      <td>3754</td>\n      <td>2.98</td>\n      <td>-0.35</td>\n      <td>112.92</td>\n      <td>112.57</td>\n    </tr>\n    <tr>\n      <th>43</th>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>40-60</td>\n      <td>199</td>\n      <td>13.88</td>\n      <td>1.00</td>\n      <td>53.71</td>\n      <td>54.71</td>\n    </tr>\n    <tr>\n      <th>45</th>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&lt;40</td>\n      <td>364</td>\n      <td>12.72</td>\n      <td>2.59</td>\n      <td>35.07</td>\n      <td>37.66</td>\n    </tr>\n    <tr>\n      <th>46</th>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&gt;80</td>\n      <td>3436</td>\n      <td>5.13</td>\n      <td>-0.39</td>\n      <td>112.84</td>\n      <td>112.45</td>\n    </tr>\n    <tr>\n      <th>47</th>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>2620</td>\n      <td>18.32</td>\n      <td>-0.64</td>\n      <td>103.38</td>\n      <td>102.74</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":99},{"cell_type":"code","source":"# February R2: compare baseline vs final model by time and lag availability\n\nfeb_baseline_check = feb_error_check.copy()\n\nfeb_baseline_check[\"baseline_speed\"] = (\n    holdout_data.loc[\n        feb_diag[\"mask_regime\"].eq(\"R2\"), \"base_speed\"\n    ].to_numpy()\n)\n\nfeb_baseline_check[\"baseline_error\"] = (\n    feb_baseline_check[\"baseline_speed\"]\n    - feb_baseline_check[\"actual_speed\"]\n)\n\nfeb_baseline_check[\"final_sq_error\"] = feb_baseline_check[\"error\"] ** 2\nfeb_baseline_check[\"baseline_sq_error\"] = (\n    feb_baseline_check[\"baseline_error\"] ** 2\n)\n\nresult = (\n    feb_baseline_check.loc[\n        feb_baseline_check[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"error\", \"size\"),\n        baseline_rmse=(\n            \"baseline_sq_error\", lambda x: np.sqrt(x.mean())\n        ),\n        model_rmse=(\n            \"final_sq_error\", lambda x: np.sqrt(x.mean())\n        ),\n        baseline_bias=(\"baseline_error\", \"mean\"),\n        model_bias=(\"error\", \"mean\"),\n    )\n    .reset_index()\n)\n\nresult[\"rmse_change\"] = result[\"model_rmse\"] - result[\"baseline_rmse\"]\n\ndisplay(\n    result.loc[result[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\"])\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:05:03.205738Z","iopub.execute_input":"2026-10-19T16:05:03.206181Z","iopub.status.idle":"2026-10-19T16:05:03.331681Z","shell.execute_reply.started":"2026-10-19T16:05:03.206152Z","shell.execute_reply":"2026-10-19T16:05:03.330599Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"     time_period lag5_band lag15_band  rows  baseline_rmse  model_rmse  \\\n0         Midday     40-60      40-60   463         27.120       3.474   \n4         Midday     40-60    Missing   342         28.344       5.767   \n10        Midday       <40