d\", \"link_id\"]].merge(\n    march_raw[[\"timestamp\", \"station_id\", \"link_id\"]],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    indicator=True\n)\nprint(\"Template rows matched:\", (check[\"_merge\"] == \"both\").sum(), \"/\", len(check))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:21:48.054317Z","iopub.execute_input":"2026-10-19T15:21:48.054749Z","iopub.status.idle":"2026-10-19T15:21:51.155363Z","shell.execute_reply.started":"2026-10-19T15:21:48.054719Z","shell.execute_reply":"2026-10-19T15:21:51.154278Z"}},"outputs":[{"name":"stdout","text":"March raw shape: (973152, 17)\nUnique timestamps: 8928\nDuplicate station-time keys: 0\nMissing speed: 444070\nMissing flow: 444070\nTemplate rows matched: 271939 / 271939\n","output_type":"stream"}],"execution_count":62},{"cell_type":"code","source":"# Inspect existing feature-building code objects and key columns\nprint(\"LAGS_MINUTES:\", LAGS_MINUTES)\nprint(\"FEATURES:\", FEATURES)\n\nprint(\"\\nExisting features sample:\")\ndisplay(features.head(3))\n\nprint(\"\\nAvailable notebook variables related to baseline/features:\")\nfor name in sorted(globals()):\n    if any(k in name.lower() for k in [\"baseline\", \"lag\", \"feature\", \"build\", \"masked\", \"truth\"]):\n        obj = globals()[name]\n        if isinstance(obj, (pd.DataFrame, pd.Series)):\n            print(f\"{name}: {type(obj).__name__}, shape={obj.shape}\")\n        elif callable(obj):\n            print(f\"{name}: callable\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:22:34.06854Z","iopub.execute_input":"2026-10-19T15:22:34.069044Z","iopub.status.idle":"2026-10-19T15:22:34.11289Z","shell.execute_reply.started":"2026-10-19T15:22:34.069012Z","shell.execute_reply":"2026-10-19T15:22:34.11167Z"}},"outputs":[{"name":"stdout","text":"LAGS_MINUTES: [5, 15, 60, 1440]\nFEATURES: ['base_speed', 'base_flow', 'lag_speed_5', 'lag_flow_5', 'lag_speed_15', 'lag_flow_15',