g[\"pred_speed\"] - feb_diag[\"base_speed\"].to_numpy()\n)\n\n# Use lag columns from the February feature matrix\nfor col in [\"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\", \"lag_speed_1440\"]:\n    if col in X_holdout_original_style.columns:\n        feb_diag[col] = X_holdout_original_style[col].to_numpy()\n\nfeb_diag[\"extreme\"] = feb_diag[\"correction\"] < -60\nfeb_diag[\"recent_normal\"] = (\n    feb_diag[\"lag_speed_5\"].ge(40)\n    & feb_diag[\"lag_speed_15\"].ge(40)\n    & feb_diag[\"lag_speed_60\"].ge(80)\n)\n\nprint(\"February extreme corrections:\", int(feb_diag[\"extreme\"].sum()))\nprint(\"Extreme corrections with normal recent context:\",\n      int((feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"]).sum()))\n\ndisplay(\n    feb_diag.loc[\n        feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"],\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"pred_speed\", \"correction\",\n         \"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]\n    ].head(15)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:57:41.217084Z","iopub.execute_input":"2026-10-19T15:57:41.218047Z","iopub.status.idle":"2026-10-19T15:57:41.332015Z","shell.execute_reply.started":"2026-10-19T15:57:41.218013Z","shell.execute_reply":"2026-10-19T15:57:41.330844Z"}},"outputs":[{"name":"stdout","text":"February extreme corrections: 1349\nExtreme corrections with normal recent context: 2\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                       timestamp          station_id    link_id mask_regime  \\\n104848 2031-02-13 07:20:00+00:00  SYN_D7_I405_S_0037  L405S-260          R3   \n170401 2031-02-21 08:25:00+00:00  SYN_D7_I405_S_0005  L405S-305          R3   \n\n        base_speed  pred_speed  correction  lag_speed_5  lag_speed_15  \\\n104848  109.689887   43.754320  -65.935567    49.165554    112.823570   \n170401  103.945054   43.089777  -60.855276    42.019245     41.000069   \n\n        lag_speed_60  \n104848    112.904015  \n170401    111.279419  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>timestamp</th>\n      <th>station_id</th>\n      <th>link_id</th>\n      <th>mask_regime</th>\n      <th>base_speed</th>\n      <th>pred_speed</th>\n      <th>correction</th>\n      <th>lag_speed_5</th>\n      <th>lag_speed_15</th>\n      <th>lag_speed_60</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>104848</th>\n      <td>2031-02-13 07:20:00+00:00</td>\n      <td>SYN_D7_I405_S_0037</td>\n      <td>L405S-260</td>\n      <td>R3</td>\n      <td>109.689887</td>\n      <td>43.754320</td>\n      <td>-65.935567</td>\n      <td>49.165554</td>\n      <td>112.823570</td>\n      <td>112.904015</td>\n    </tr>\n    <tr>\n      <th>170401</th>\n      <td>2031-02-21 08:25:00+00:00</td>\n      <td>SYN_D7_I405_S_0005</td>\n      <td>L405S-305</td>\n      <td>R3</td>\n      <td>103.945054</td>\n      <td>43.089777</td>\n      <td>-60.855276</td>\n      <td>42.019245</td>\n      <td>41.000069</td>\n      <td>111.279419</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":89},{"cell_type":"code","source":"# Evaluate the two February cases against actual validation labels\nfeb_cases = feb_diag.loc[\n    feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"]\n].copy()\n\n# Join actual February speed labels\nfeb_cases = feb_cases.merge(\n    holdout_truth[[\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\"]],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    suffixes=(\"\", \"_actual\"),\n    validate=\"one_to_one\"\n)\n\nfeb_cases[\"actual_speed\"] = feb_cases[\"speed_kmh_actual\"]\nfeb_cases[\"prediction_error\"] = (\n    feb_cases[\"pred_speed\"] - feb_cases[\"actual_speed\"]\n).abs()\n\ndisplay(\n    feb_cases[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"pred_speed\", \"actual_speed\", \"prediction_error\",\n         \"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:58:15.891537Z","iopub.execute_input":"2026-10-19T15:58:15.892Z","iopub.status.idle":"2026-10-19T15:58:16.078584Z","shell.execute_reply.started":"2026-10-19T15:58:15.891967Z","shell.execute_reply":"2026-10-19T15:58:16.077576Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                  timestamp          station_id    link_id mask_regime  \\\n0 2031-02-13 07:20:00+00:00  SYN_D7_I405_S_0037  L405S-260          R3   \n1 2031-02-21 08:25:00+00:00  SYN_D7_I405_S_0005  L405S-305          R3   \n\n   base_speed  pred_speed  actual_speed  prediction_error  lag_speed_5  \\\n0  109.689887   43.754320    112.057703         68.303383    49.165554   \n1  103.945054   43.089777     42.598862          0.490916    42.019245   \n\n   lag_speed_15  lag_speed_60  \n0    112.823570    112.904015  \n1     41.000069    111.279419  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>timestamp</th>\n      <th>station_id</th>\n      <th>link_id</th>\n      <th>mask_regime</th>\n      <th>base_speed</th>\n      <th>pred_speed</th>\n      <th>actual_speed</th>\n      <th>prediction_error</th>\n      <th>lag_speed_5</th>\n      <th>lag_speed_15</th>\n      <th>lag_speed_60</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>2031-02-13 07:20:00+00:00</td>\n      <td>SYN_D7_I405_S_0037</td>\n      <td>L405S-260</td>\n      <td>R3</td>\n      <td>109.689887</td>\n      <td>43.754320</td>\n      <td>112.057703</td>\n      <td>68.303383</td>\n      <td>49.165554</td>\n      <td>112.823570</td>\n      <td>112.904015</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2031-02-21 08:25:00+00:00</td>\n      <td>SYN_D7_I405_S_0005</td>\n      <td>L405S-305</td>\n      <td>R3</td>\n      <td>103.945054</td>\n      <td>43.089777</td>\n      <td>42.598862</td>\n      <td>0.490916</td>\n      <td>42.019245</td>\n      <td>41.000069</td>\n      <td>111.279419</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":90},{"cell_type":"code","source":"# Test speed-correction caps on February holdout\ny_actual = holdout_truth[\"speed_kmh\"].to_numpy()\nbase = holdout_data[\"base_speed\"].to_numpy()\nraw_pred = pred_speed_original_style.copy()\n\ndef speed_rmse(pred):\n    valid = np.isfinite(y_actual) & np.isfinite(pred)\n    return np.sqrt(np.mean((y_actual[valid] - pred[valid]) ** 2))\n\nprint(\"February speed RMSE, original:\", round(speed_rmse(raw_pred), 4))\n\nfor cap in [40, 50, 60, 70, 80]:\n    correction = raw_pred - base\n    capped_pred = base + np.maximum(correction, -cap)\n    capped_pred = np.clip(capped_pred, 0, 160)\n    print(\n        f\"Lower correction cap -{cap:2d} km/h | \"\n        f\"speed RMSE: {speed_rmse(capped_pred):.4f}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:59:13.359557Z","iopub.execute_input":"2026-10-19T15:59:13.360061Z","iopub.status.idle":"2026-10-19T15:59:13.404146Z","shell.execute_reply.started":"2026-10-19T15:59:13.360028Z","shell.execute_reply":"2026-10-19T15:59:13.4025Z"}},"outputs":[{"name":"stdout","text":"February speed RMSE, original: 6.3175\nLower correction cap -40 km/h | speed RMSE: 6.8161\nLower correction cap -50 km/h | speed RMSE: 6.5095\nLower correction cap -60 km/h | speed RMSE: 6.3716\nLower correction cap -70 km/h | speed RMSE: 6.3267\nLower correction cap -80 km/h | speed RMSE: 6.3185\n","output_type":"stream"}],"execution_count":91},{"cell_type":"code","source":"# Compare February vs April correction behavior by recent-lag availability\ndef correction_summary(name, frame, correction_col):\n    frame = frame.copy()\n    frame[\"recent_lags_missing\"] = (\n        frame[\"lag_speed_5\"].isna() | frame[\"lag_speed_15\"].isna()\n    )\n    frame[\"large_negative\"] = frame[correction_col] < -30\n\n    result = (\n        frame.groupby([\"mask_regime\", \"recent_lags_missing\"], observed=True)\n        .agg(\n            rows=(correction_col, \"size\"),\n            mean_correction=(correction_col, \"mean\"),\n            large_negative_rate=(\"large_negative\", \"mean\"),\n        )\n        .reset_index()\n    )\n    result.insert(0, \"period\", name)\n    return result\n\nfeb_compare = feb_diag.copy()\nfeb_compare[\"correction_value\"] = feb_compare[\"correction\"]\n\napr_compare = private_features.copy()\napr_compare[\"correction_value\"] = (\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy()\n)\n\ncomparison = pd.concat([\n    correction_summary(\"February\", feb_compare, \"correction_value\"),\n    correction_summary(\"April\", apr_compare, \"correction_value\"),\n], ignore_index=True)\n\ncomparison[\"large_negative_rate_pct\"] = (\n    100 * comparison.pop(\"large_negative_rate\")\n).round(2)\n\ndisplay(comparison.round(3))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:00:04.959677Z","iopub.execute_input":"2026-10-19T16:00:04.960126Z","iopub.status.idle":"2026-10-19T16:00:05.249203Z","shell.execute_reply.started":"2026-10-19T16:00:04.960096Z","shell.execute_reply":"2026-10-19T16:00:05.248084Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"      period mask_regime  recent_lags_missing   rows  mean_correction  \\\n0   February          R1                False   9439           -0.298   \n1   February          R1                 True   9718           -0.360   \n2   February          R2                False  42336            0.144   \n3   February          R2                 True  65774            0.015   \n4   February          R3                False  23770           -0.973   \n5   February          R3                 True  84454           -0.609   \n6      April          R1                False  16035           -0.170   \n7      April          R1                 True  17166            0.110   \n8      April          R2                False  36130           -2.135   \n9      April          R2                 True  56715           -1.685   \n10     April          R3                False  24974           -0.472   \n11     April          R3                 True  92583           -0.012   \n\n    large_negative_rate_pct  \n0                      2.61  \n1                      2.07  \n2                      2.98  \n3                      2.28  \n4                      4.15  \n5                      2.69  \n6                      3.84  \n7                      2.54  \n8                      5.73  \n9                      4.14  \n10                     4.27  \n11                     2.57  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>period</th>\n      <th>mask_regime</th>\n      <th>recent_lags_missing</th>\n      <th>rows</th>\n      <th>mean_correction</th>\n      <th>large_negative_rate_pct</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>February</td>\n      <td>R1</td>\n      <td>False</td>\n      <td>9439</td>\n      <td>-0.298</td>\n      <td>2.61</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>February</td>\n      <td>R1</td>\n      <td>True</td>\n      <td>9718</td>\n      <td>-0.360</td>\n      <td>2.07</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>February</td>\n      <td>R2</td>\n      <td>False</td>\n      <td>42336</td>\n      <td>0.144</td>\n      <td>2.98</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>February</td>\n      <td>R2</td>\n      <td>True</td>\n      <td>65774</td>\n      <td>0.015</td>\n      <td>2.28</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>February</td>\n      <td>R3</td>\n      <td>False</td>\n      <td>23770</td>\n      <td>-0.973</td>\n      <td>4.15</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>February</td>\n      <td>R3</td>\n      <td>True</td>\n      <td>84454</td>\n      <td>-0.609</td>\n      <td>2.69</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>April</td>\n      <td>R1</td>\n      <td>False</td>\n      <td>16035</td>\n      <td>-0.170</td>\n      <td>3.84</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>April</td>\n      <td>R1</td>\n      <td>True</td>\n      <td>17166</td>\n      <td>0.110</td>\n      <td>2.54</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>April</td>\n      <td>R2</td>\n      <td>False</td>\n      <td>36130</td>\n      <td>-2.135</td>\n      <td>5.73</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>April</td>\n      <td>R2</td>\n      <td>True</td>\n      <td>56715</td>\n      <td>-1.685</td>\n      <td>4.14</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>April</td>\n      <td>R3</td>\n      <td>False</td>\n      <td>24974</td>\n      <td>-0.472</td>\n      <td>4.27</td>\n    </tr>\n    <tr>\n      <th>11</th>\n      <td>April</td>\n      <td>R3</td>\n      <td>True</td>\n      <td>92583</td>\n      <td>-0.012</td>\n      <td>2.57</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":92},{"cell_type":"code","source":"# February speed error by model correction range\nfeb_eval = feb_diag.copy()\n\nfeb_eval[\"actual_speed\"] = holdout_truth[\"speed_kmh\"].to_numpy()\nfeb_eval[\"abs_error\"] = (\n    feb_eval[\"pred_speed\"] - feb_eval[\"actual_speed\"]\n).abs()\n\nfeb_eval[\"correction_band\"] = pd.cut(\n    feb_eval[\"correction\"],\n    bins=[-np.inf, -60, -40, -30, -20, 0, 20, np.inf],\n    labels=[\n        \"< -60\", \"-60 to -40\", \"-40 to -30\",\n        \"-30 to -20\", \"-20 to 0\", \"0 to 20\", \"> 20\"\n    ],\n    right=False\n)\n\ndisplay(\n    feb_eval.groupby(\"correction_band\", observed=True)\n    .agg(\n        rows=(\"abs_error\", \"size\"),\n        speed_rmse=(\"abs_error\", lambda x: np.sqrt(np.mean(x**2))),\n        mean_abs_error=(\"abs_error\", \"mean\"),\n        mean_actual_speed=(\"actual_speed\", \"mean\"),\n        mean_predicted_speed=(\"pred_speed\", \"mean\"),\n    )\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:00:42.927357Z","iopub.execute_input":"2026-10-19T16:00:42.92777Z","iopub.status.idle":"2026-10-19T16:00:43.064432Z","shell.execute_reply.started":"2026-10-19T16:00:42.927739Z","shell.execute_reply":"2026-10-19T16:00:43.06272Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                   rows  speed_rmse  mean_abs_error  mean_actual_speed  \\\ncorrection_band                                                          \n< -60              1349      12.717           5.028             29.938   \n-60 to -40         2970      13.624           6.199             40.398   \n-40 to -30         2152      12.732           6.044             41.941   \n-30 to -20         2573      13.402           6.639             43.241   \n-20 to 0          89698       5.475           2.013            109.467   \n0 to 20          130348       5.823           1.995            112.114   \n> 20               6401      10.530           4.682            112.171   \n\n                 mean_predicted_speed  \ncorrection_band                        \n< -60                          30.805  \n-60 to -40                     40.956  \n-40 to -30                     42.451  \n-30 to -20                     44.314  \n-20 to 0                      109.552  \n0 to 20                       112.255  \n> 20                          110.959  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>rows</th>\n      <th>speed_rmse</th>\n      <th>mean_abs_error</th>\n      <th>mean_actual_speed</th>\n      <th>mean_predicted_speed</th>\n    </tr>\n    <tr>\n      <th>correction_band</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>&lt; -60</th>\n      <td>1349</td>\n      <td>12.717</td>\n      <td>5.028</td>\n      <td>29.938</td>\n      <td>30.805</td>\n    </tr>\n    <tr>\n      <th>-60 to -40</th>\n      <td>2970</td>\n      <td>13.624</td>\n      <td>6.199</td>\n      <td>40.398</td>\n      <td>40.956</td>\n    </tr>\n    <tr>\n      <th>-40 to -30</th>\n      <td>2152</td>\n      <td>12.732</td>\n      <td>6.044</td>\n      <td>41.941</td>\n      <td>42.451</td>\n    </tr>\n    <tr>\n      <th>-30 to -20</th>\n      <td>2573</td>\n      <td>13.402</td>\n      <td>6.639</td>\n      <td>43.241</td>\n      <td>44.314</td>\n    </tr>\n    <tr>\n      <th>-20 to 0</th>\n      <td>89698</td>\n      <td>5.475</td>\n      <td>2.013</td>\n      <td>109.467</td>\n      <td>109.552</td>\n    </tr>\n    <tr>\n      <th>0 to 20</th>\n      <td>130348</td>\n      <td>5.823</td>\n      <td>1.995</td>\n      <td>112.114</td>\n      <td>112.255</td>\n    </tr>\n    <tr>\n      <th>&gt; 20</th>\n      <td>6401</td>\n      <td>10.530</td>\n      <td>4.682</td>\n      <td>112.171</td>\n      <td>110.959</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":93},{"cell_type":"code","source":"# Compare February vs April R2 under similar recent traffic conditions\n\ndef prepare_period(frame, correction, period):\n    df = frame.copy()\n    df[\"correction\"] = np.asarray(correction)\n    df[\"period\"] = period\n\n    # Bucket recent observed speeds; missing values remain identifiable\n    for col in [\"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]:\n        df[col + \"_band\"] = pd.cut(\n            df[col],\n            bins=[-np.inf, 40, 60, 80, 100, np.inf],\n            labels=[\"<40\", \"40-60\", \"60-80\", \"80-100\", \">100\"]\n        ).astype(\"object\").fillna(\"Missing\")\n\n    return df\n\nfeb_r2 = prepare_period(\n    feb_diag.loc[feb_diag[\"mask_regime\"].eq(\"R2\")],\n    feb_diag.loc[feb_diag[\"mask_regime\"].eq(\"R2\"), \"correction\"],\n    \"February\"\n)\n\napr_r2 = prepare_period(\n    private_features.loc[private_features[\"mask_regime\"].eq(\"R2\")],\n    (\n        private_submission.loc[\n            private_features[\"mask_regime\"].eq(\"R2\"), \"speed_kmh\"\n        ].to_numpy()\n        - private_features.loc[\n            private_features[\"mask_regime\"].eq(\"R2\"), \"base_speed\"\n        ].to_numpy()\n    ),\n    \"April\"\n)\n\nboth_r2 = pd.concat([feb_r2, apr_r2], ignore_index=True)\n\ncomparison_r2 = (\n    both_r2.groupby(\n        [\"period\", \"lag_speed_5_band\", \"lag_speed_15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        negative30_rate=(\"correction\", lambda x: (x < -30).mean()),\n    )\n    .reset_index()\n)\n\ncomparison_r2[\"negative30_rate_pct\"] = (\n    100 * comparison_r2.pop(\"negative30_rate\")\n).round(2)\n\n# Keep conditions with enough observations for a meaningful comparison\ncomparison_r2 = comparison_r2.loc[comparison_r2[\"rows\"] >= 100]\n\ndisplay(\n    comparison_r2.sort_values(\n        [\"lag_speed_5_band\", \"lag_speed_15_band\", \"period\"]\n    ).round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:02:37.744386Z","iopub.execute_input":"2026-10-19T16:02:37.744858Z","iopub.status.idle":"2026-10-19T16:02:38.297969Z","shell.execute_reply.started":"2026-10-19T16:02:37.744831Z","shell.execute_reply":"2026-10-19T16:02:38.296031Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"      period lag_speed_5_band lag_speed_15_band   rows  mean_correction  \\\n0      April            40-60             40-60   1184           -33.81   \n35  February            40-60             40-60    849           -28.00   \n5      April            40-60           Missing    786           -33.43   \n39  February            40-60           Missing    614           -28.03   \n20     April              <40               <40   1777           -44.54   \n53  February              <40               <40   1291           -37.74   \n22     April              <40           Missing   1144           -45.26   \n55  February              <40           Missing    775           -38.68   \n27     April             >100              >100  32544             1.68   \n60  February             >100              >100  39679             2.11   \n28     April             >100           Missing  19532             1.59   \n61  February             >100           Missing  24115             2.01   \n29     April          Missing             40-60    769           -27.56   \n62  February          Missing             40-60    559           -25.00   \n32     April          Missing               <40   1103           -38.89   \n65  February          Missing               <40    737           -34.84   \n33     April    