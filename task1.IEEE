d>\n      <td>0.4352</td>\n      <td>0.7202</td>\n      <td>0.2850</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>R2</td>\n      <td>Late evening</td>\n      <td>47825.0</td>\n      <td>10.3496</td>\n      <td>5.1987</td>\n      <td>129.6253</td>\n      <td>96.1947</td>\n      <td>0.6771</td>\n      <td>0.8140</td>\n      <td>0.1369</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>R3</td>\n      <td>Night</td>\n      <td>47920.0</td>\n      <td>1.6021</td>\n      <td>1.6097</td>\n      <td>54.8570</td>\n      <td>53.0661</td>\n      <td>0.9233</td>\n      <td>0.9245</td>\n      <td>0.0012</td>\n    </tr>\n    <tr>\n      <th>11</th>\n      <td>R3</td>\n      <td>Morning peak</td>\n      <td>31921.0</td>\n      <td>11.1807</td>\n      <td>6.8396</td>\n      <td>123.3981</td>\n      <td>94.9228</td>\n      <td>0.6639</td>\n      <td>0.7795</td>\n      <td>0.1156</td>\n    </tr>\n    <tr>\n      <th>12</th>\n      <td>R3</td>\n      <td>Midday</td>\n      <td>47915.0</td>\n      <td>16.1012</td>\n      <td>9.3278</td>\n      <td>78.7901</td>\n      <td>69.0339</td>\n      <td>0.5918</td>\n      <td>0.7456</td>\n      <td>0.1538</td>\n    </tr>\n    <tr>\n      <th>13</th>\n      <td>R3</td>\n      <td>Evening peak</td>\n      <td>31872.0</td>\n      <td>20.0470</td>\n      <td>10.8194</td>\n      <td>126.4837</td>\n      <td>98.3996</td>\n      <td>0.4700</td>\n      <td>0.6909</td>\n      <td>0.2208</td>\n    </tr>\n    <tr>\n      <th>14</th>\n      <td>R3</td>\n      <td>Late evening</td>\n      <td>31955.0</td>\n      <td>7.8460</td>\n      <td>4.6153</td>\n      <td>131.9881</td>\n      <td>94.9165</td>\n      <td>0.7293</td>\n      <td>0.8275</td>\n      <td>0.0982</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":127},{"cell_type":"code","source":"\n# Restore timestamp and link_id using the original row order\nr2_night = jan_eval_lanes.copy()\nr2_night[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\nr2_night[\"link_id\"] = jan_features[\"link_id\"].to_numpy()\n\nr2_night = r2_night.loc[\n    r2_night[\"mask_regime\"].eq(\"R2\")\n    & r2_night[\"timestamp\"].dt.hour.lt(6)\n].copy()\n\nfor name in [\"baseline\", \"model\"]:\n    speed_pred = (\n        r2_night[\"speed_base\"].to_numpy()\n        if name == \"baseline\"\n        else r2_night[\"speed_pred\"].to_numpy()\n    )\n    flow_pred = (\n        r2_night[\"flow_base\"].to_numpy()\n        if name == \"baseline\"\n        else r2_night[\"flow_pred\"].to_numpy()\n    )\n\n    speed_rmse = np.sqrt(\n        np.mean((r2_night[\"speed_actual\"].to_numpy() - speed_pred) ** 2)\n    )\n    flow_rmse_lane = np.sqrt(\n        np.mean(\n            (\n                (r2_night[\"flow_actual\"].to_numpy() - flow_pred)\n                / r2_night[\"lanes\"].to_numpy()\n            ) ** 2\n        )\n    )\n\n    print(\n        f\"{name:8s} | speed RMSE: {speed_rmse:.4f} | \"\n        f\"flow RMSE/lane: {flow_rmse_lane:.4f}\"\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:46:30.470285Z","iopub.execute_input":"2026-10-19T16:46:30.470769Z","iopub.status.idle":"2026-10-19T16:46:33.866191Z","shell.execute_reply.started":"2026-10-19T16:46:30.470712Z","shell.execute_reply":"2026-10-19T16:46:33.864724Z"}},"outputs":[{"name":"stdout","text":"baseline | speed RMSE: 1.5680 | flow RMSE/lane: 48.3138\nmodel    | speed RMSE: 1.5746 | flow RMSE/lane: 58.6545\n","output_type":"stream"}],"execution_count":132},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\ntest = jan_eval_lanes.copy()\ntest[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\n\n# Candidate: use baseline predictions for R2 from 00:00–05:59\nfallback = (\n    test[\"mask_regime\"].eq(\"R2\")\n    & test[\"timestamp\"].dt.hour.lt(6)\n)\n\nspeed_candidate = test[\"speed_pred\"].to_numpy().copy()\nflow_candidate = test[\"flow_pred\"].to_numpy().copy()\n\nspeed_candidate[fallback.to_numpy()] = test.loc[fallback, \"speed_base\"].to_numpy()\nflow_candidate[fallback.to_numpy()] = test.loc[fallback, \"flow_base\"].to_numpy()\n\ndef official_score(speed_pred, flow_pred, data):\n    scores = []\n\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        mask = data[\"mask_regime\"].eq(regime).to_numpy()\n        g = data.loc[mask]\n\n        speed_rmse = np.sqrt(np.mean(\n            (g[\"speed_actual\"].to_numpy() - speed_pred[mask]) ** 2\n        ))\n        flow_rmse_lane = np.sqrt(np.mean(\n            (\n                (g[\"flow_actual\"].to_numpy() - flow_pred[mask])\n                / g[\"lanes\"].to_numpy()\n            ) ** 2\n        ))\n\n        score = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n        )\n        scores.append(score)\n        print(\n            f\"{regime}: score={score:.6f}, \"\n            f\"speed_RMSE={speed_rmse:.4f}, \"\n            f\"flow_RMSE/lane={flow_rmse_lane:.4f}\"\n        )\n\n    return np.mean(scores)\n\nprint(\"CURRENT MODEL\")\ncurrent_score = official_score(\n    test[\"speed_pred\"].to_numpy(),\n    test[\"flow_pred\"].to_numpy(),\n    test\n)\n\nprint(\"\\nR2 NIGHT BASELINE FALLBACK\")\ncandidate_score = official_score(\n    speed_candidate, flow_candidate, test\n)\n\nprint(f\"\\nCurrent macro score:   {current_score:.6f}\")\nprint(f\"Candidate macro score: {candidate_score:.6f}\")\nprint(f\"Score difference:      {candidate_score - current_score:+.6f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:47:08.317836Z","iopub.execute_input":"2026-10-19T16:47:08.318321Z","iopub.status.idle":"2026-10-19T16:47:11.919035Z","shell.execute_reply.started":"2026-10-19T16:47:08.31829Z","shell.execute_reply":"2026-10-19T16:47:11.917939Z"}},"outputs":[{"name":"stdout","text":"CURRENT MODEL\nR1: score=0.831969, speed_RMSE=5.2644, flow_RMSE/lane=70.8523\nR2: score=0.797505, speed_RMSE=6.6742, flow_RMSE/lane=76.0851\nR3: score=0.780546, speed_RMSE=7.2959, flow_RMSE/lane=80.6908\n\nR2 NIGHT BASELINE FALLBACK\nR1: score=0.831969, speed_RMSE=5.2644, flow_RMSE/lane=70.8523\nR2: score=0.798922, speed_RMSE=6.6738, flow_RMSE/lane=74.2473\nR3: score=0.780546, speed_RMSE=7.2959, flow_RMSE/lane=80.6908\n\nCurrent macro score:   0.803340\nCandidate macro score: 0.803812\nScore difference:      +0.000473\n","output_type":"stream"}],"execution_count":133},{"cell_type":"code","source":"\nimport os\nimport numpy as np\nimport pandas as pd\n\n# 1. Verify required objects and submission file\nrequired = [\n    \"jan_eval_lanes\", \"jan_features\",\n    \"speed_model_original_style\", \"flow_model_original_style\",\n    \"FEATURES\",\n]\nmissing = [name for name in required if name not in globals()]\nif missing:\n    raise NameError(f\"Missing required notebook objects: {missing}\")\n\nsubmission_path = \"/kaggle/working/private_submission.csv\"\nif not os.path.isfile(submission_path):\n    raise FileNotFoundError(f\"Submission file not found: {submission_path}\")\n\nsubmission = pd.read_csv(submission_path)\n\n# 2. Verify January evaluation data\ndata = jan_eval_lanes.copy()\nif len(data) != len(jan_features):\n    raise ValueError(\n        f\"Row mismatch: jan_eval_lanes={len(data)}, \"\n        f\"jan_features={len(jan_features)}\"\n    )\n\ndata[\"timestamp\"] = pd.to_datetime(\n    jan_features[\"timestamp\"].to_numpy(), utc=True\n)\n\nrequired_cols = [\n    \"mask_regime\", \"speed_actual\", \"flow_actual\",\n    \"speed_pred\", \"flow_pred\", \"speed_base\", \"flow_base\", \"lanes\",\n]\nmissing_cols = [c for c in required_cols if c not in data.columns]\nif missing_cols:\n    raise KeyError(f\"Missing evaluation columns: {missing_cols}\")\n\nif data[required_cols].isna().any().any():\n    raise ValueError(\"Evaluation data contains missing values.\")\nif (data[\"lanes\"] <= 0).any():\n    raise ValueError(\"Invalid lane counts.\")\nif not set(data[\"mask_regime\"].unique()).issubset({\"R1\", \"R2\", \"R3\"}):\n    raise ValueError(\"Unexpected mask regime values.\")\n\n# 3. Recompute the original and candidate official macro scores\ndef score_by_regime(frame, speed_pred, flow_pred):\n    output = {}\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        mask = frame[\"mask_regime\"].eq(regime).to_numpy()\n        g = frame.loc[mask]\n\n        speed_rmse = np.sqrt(np.mean(\n            (g[\"speed_actual\"].to_numpy() - speed_pred[mask]) ** 2\n        ))\n        flow_rmse_lane = np.sqrt(np.mean(\n            (\n                (g[\"flow_actual\"].to_numpy() - flow_pred[mask])\n                / g[\"lanes\"].to_numpy()\n            ) ** 2\n        ))\n\n        output[regime] = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n        )\n    return output\n\ncurrent_speed = data[\"speed_pred\"].to_numpy(copy=True)\ncurrent_flow = data[\"flow_pred\"].to_numpy(copy=True)\n\nfallback_mask = (\n    data[\"mask_regime\"].eq(\"R2\")\n    & data[\"timestamp\"].dt.hour.lt(6)\n).to_numpy()\n\ncandidate_speed = current_speed.copy()\ncandidate_flow = current_flow.copy()\n\ncandidate_speed[fallback_mask] = data.loc[\n    fallback_mask, \"speed_base\"\n].to_numpy()\ncandidate_flow[fallback_mask] = data.loc[\n    fallback_mask, \"flow_base\"\n].to_numpy()\n\ncurrent_scores = score_by_regime(data, current_speed, current_flow)\ncandidate_scores = score_by_regime(data, candidate_speed, candidate_flow)\n\nprint(\"JANUARY VALIDATION\")\nprint(f\"Rows evaluated: {len(data):,}\")\nprint(f\"Fallback rows:  {fallback_mask.sum():,}\")\nprint(f\"Fallback affects only R2, hours 00:00–05:59: \"\n      f\"{data.loc[fallback_mask, 'mask_regime'].eq('R2').all() and data.loc[fallback_mask, 'timestamp'].dt.hour.lt(6).all()}\")\n\nprint(\"\\nRegime scores\")\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    print(\n        f\"{regime}: current={current_scores[regime]:.6f}, \"\n        f\"candidate={candidate_scores[regime]:.6f}, \"\n        f\"delta={candidate_scores[regime] - current_scores[regime]:+.6f}\"\n    )\n\ncurrent_macro = np.mean(list(current_scores.values()))\ncandidate_macro = np.mean(list(candidate_scores.values()))\n\nprint(f\"\\nCurrent macro score:   {current_macro:.6f}\")\nprint(f\"Candidate macro score: {candidate_macro:.6f}\")\nprint(f\"Macro score change:    {candidate_macro - current_macro:+.6f}\")\n\nprint(\"\\nEXISTING SUBMISSION — READ-ONLY CHECK\")\nprint(f\"Path: {submission_path}\")\nprint(f\"Rows: {len(submission):,}\")\nprint(f\"Columns: {submission.columns.tolist()}\")\nprint(f\"Missing values: {int(submission.isna().sum().sum())}\")\nprint(f\"Speed range: {submission['speed_kmh'].min():.3f} to \"\n      f\"{submission['speed_kmh'].max():.3f}\")\nprint(f\"Flow range: {submission['flow_vph'].min():.3f} to \"\n      f\"{submission['flow_vph'].max():.3f}\")\n\nassert np.isfinite(current_macro) and np.isfinite(candidate_macro)\nassert submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert submission[\"speed_kmh\"].between(0, 160).all()\nassert (submission[\"flow_vph\"] >= 0).all()\n\nprint(\"\\nPASS: validation completed; existing submission was not modified.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:55:06.628481Z","iopub.execute_input":"2026-10-19T16:55:06.629172Z","iopub.status.idle":"2026-10-19T16:55:13.002646Z","shell.execute_reply.started":"2026-10-19T16:55:06.629129Z","shell.execute_reply":"2026-10-19T16:55:13.001524Z"}},"outputs":[{"name":"stdout","text":"JANUARY VALIDATION\nRows evaluated: 743,058\nFallback rows:  71,803\nFallback affects only R2, hours 00:00–05:59: True\n\nRegime scores\nR1: current=0.831969, candidate=0.831969, delta=+0.000000\nR2: current=0.797505, candidate=0.798922, delta=+0.001418\nR3: current=0.780546, candidate=0.780546, delta=+0.000000\n\nCurrent macro score:   0.803340\nCandidate macro score: 0.803812\nMacro score change:    +0.000473\n\nEXISTING SUBMISSION — READ-ONLY CHECK\nPath: /kaggle/working/private_submiss