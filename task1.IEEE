.inf, -np.inf], np.nan)\ny_speed_i5n = df_i5n[\"target_speed\"].to_numpy(dtype=float)\ny_flow_i5n = df_i5n[\"target_flow\"].to_numpy(dtype=float)\nbase_speed_i5n = df_i5n[\"base_speed\"].to_numpy(dtype=float)\nbase_flow_i5n = df_i5n[\"base_flow\"].to_numpy(dtype=float)\n\nvalid_labels_i5n = (\n    np.isfinite(y_speed_i5n) & np.isfinite(y_flow_i5n)\n    & np.isfinite(base_speed_i5n) & np.isfinite(base_flow_i5n)\n)\ntrain_idx_i5n = np.flatnonzero(train_mask_i5n.to_numpy() & valid_labels_i5n)\nvalid_idx_i5n = np.flatnonzero(valid_mask_i5n.to_numpy() & valid_labels_i5n)\n\ndef make_model_i5n():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5n = make_model_i5n()\nflow_model_i5n = make_model_i5n()\n\nspeed_model_i5n.fit(\n    X_i5n.iloc[train_idx_i5n],\n    y_speed_i5n[train_idx_i5n] - base_speed_i5n[train_idx_i5n],\n)\nflow_model_i5n.fit(\n    X_i5n.iloc[train_idx_i5n],\n    y_flow_i5n[train_idx_i5n] - base_flow_i5n[train_idx_i5n],\n)\n\npred_speed_i5n = np.clip(\n    base_speed_i5n[valid_idx_i5n]\n    + speed_model_i5n.predict(X_i5n.iloc[valid_idx_i5n]),\n    0, 160,\n)\npred_flow_i5n = np.clip(\n    base_flow_i5n[valid_idx_i5n]\n    + flow_model_i5n.predict(X_i5n.iloc[valid_idx_i5n]),\n    0, None,\n)\n\nlinks_i5n = pd.read_csv(\n    ROOT / \"corridors\" / PANEL_I5N / \"network\" / \"links.csv\"\n)\nlane_map_i5n = links_i5n[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev_i5n = df_i5n.iloc[valid_idx_i5n][\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\nev_i5n[\"pred_speed\"] = pred_speed_i5n\nev_i5n[\"pred_flow\"] = pred_flow_i5n\nev_i5n = ev_i5n.merge(\n    lane_map_i5n, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nassert ev_i5n[\"lanes\"].notna().all() and (ev_i5n[\"lanes\"] > 0).all()\n\nspeed_rmse_i5n = np.sqrt(np.mean(\n    (ev_i5n[\"target_speed\"] - ev_i5n[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse_i5n = np.sqrt(np.mean(\n    ((ev_i5n[\"target_flow\"] - ev_i5n[\"pred_flow\"]) / ev_i5n[\"lanes\"]) ** 2\n))\n\nS_speed_i5n = max(0, 1 - speed_rmse_i5n / 25)\nS_flow_i5n = max(0, 1 - flow_lane_rmse_i5n / 600)\nS_state_i5n = 0.54 * S_speed_i5n + 0.46 * S_flow_i5n\n\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Training rows:\", f\"{len(train_idx_i5n):,}\")\nprint(\"Holdout rows:\", f\"{len(valid_idx_i5n):,}\")\nprint(f\"Speed RMSE: {speed_rmse_i5n:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse_i5n:.4f}\")\nprint(f\"S_speed: {S_speed_i5n:.6f}\")\nprint(f\"S_flow: {S_flow_i5n:.6f}\")\nprint(f\"Estimated state score: {S_state_i5n:.6f}\")\n\ndel X_i5n, links_i5n, lane_map_i5n, ev_i5n\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:25:51.725397Z","iopub.execute_input":"2026-10-19T20:25:51.726249Z","iopub.status.idle":"2026-10-19T20:26:32.932047Z","shell.execute_reply.started":"2026-10-19T20:25:51.726176Z","shell.execute_reply":"2026-10-19T20:26:32.930981Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I5_N\nTraining rows: 1,270,025\nHoldout rows: 318,478\nSpeed RMSE: 5.4136 km/h\nFlow RMSE per lane: 92.7291\nS_speed: 0.783457\nS_flow: 0.845451\nEstimated state score: 0.811974\n","output_type":"stream"},{"execution_count":220,"output_type":"execute_result","data":{"text/plain":"48"},"metadata":{}}],"execution_count":220},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL_I5N = \"D12_I5_N\"\n\nfinal_train_i5n = feb_features_i5n.copy()\nfinal_train_i5n[\"timestamp\"] = pd.to_datetime(\n    final_train_i5n[\"timestamp\"], utc=True\n)\n\nfinal_train_i5n[\"weekday\"] = final_train_i5n[\"timestamp\"].dt.weekday\nfinal_train_i5n[\"minute_of_day\"] = (\n    final_train_i5n[\"timestamp\"].dt.hour * 60\n    + final_train_i5n[\"timestamp\"].dt.minute\n)\nfinal_train_i5n[\"tod_sin\"] = np.sin(\n    2 * np.pi * final_train_i5n[\"minute_of_day\"] / 1440\n)\nfinal_train_i5n[\"tod_cos\"] = np.cos(\n    2 * np.pi * final_train_i5n[\"minute_of_day\"] / 1440\n)\nfinal_train_i5n[\"weekday_sin\"] = np.sin(\n    2 * np.pi * final_train_i5n[\"weekday\"] / 7\n)\nfinal_train_i5n[\"weekday_cos\"] = np.cos(\n    2 * np.pi * final_train_i5n[\"weekday\"] / 7\n)\n\n# Apply the same mappings used for evaluation.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    final_train_i5n[col + \"_code\"] = (\n        final_train_i5n[col].map(category_maps_i5n[col]).astype(\"int16\")\n    )\n\nassert len(final_train_i5n) == 1_588_503\nassert final_train_i5n[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\ndef make_final_model_i5n():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5n_final = make_final_model_i5n()\nflow_model_i5n_final = make_final_model_i5n()\n\nspeed_model_i5n_final.fit(\n    final_train_i5n[FEATURES_I5N],\n    final_train_i5n[\"target_speed\"] - final_train_i5n[\"base_speed\"],\n)\nflow_model_i5n_final.fit(\n    final_train_i5n[FEATURES_I5N],\n    final_train_i5n[\"target_flow\"] - final_train_i5n[\"base_flow\"],\n)\n\nprint(\"Final models fitted.\")\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Training rows:\", f\"{len(final_train_i5n):,}\")\nprint(\"Features:\", len(FEATURES_I5N))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:27:33.312861Z","iopub.execute_input":"2026-10-19T20:27:33.31362Z","iopub.status.idle":"2026-10-19T20:28:14.483982Z","shell.execute_reply.started":"2026-10-19T20:27:33.31358Z","shell.execute_reply":"2026-10-19T20:28:14.482727Z"}},"outputs":[{"name":"stdout","text":"Final m