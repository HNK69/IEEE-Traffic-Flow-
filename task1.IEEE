}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import inspect\n\nprint(\"VALUE_COLS:\", VALUE_COLS)\nprint(\"KEYS:\", KEYS)\n\n# Inspect the original baseline history setup\nfor name in [\"history\", \"truth\", \"baseline_train\"]:\n    obj = globals().get(name)\n    if isinstance(obj, pd.DataFrame):\n        print(f\"\\n{name}:\")\n        print(\"Date range:\", obj[\"timestamp\"].min(), \"to\", obj[\"timestamp\"].max())\n        print(\"Rows:\", len(obj))\n        if \"pct_observed\" in obj.columns:\n            print(\"pct_observed:\", obj[\"pct_observed\"].describe().to_dict())\n        if \"is_score_eligible\" in obj.columns:\n            print(\"Eligible:\", obj[\"is_score_eligible\"].sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:25:45.798683Z","iopub.execute_input":"2026-10-19T15:25:45.7991Z","iopub.status.idle":"2026-10-19T15:25:46.138685Z","shell.execute_reply.started":"2026-10-19T15:25:45.799072Z","shell.execute_reply":"2026-10-19T15:25:46.137692Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Restore historical data for baseline construction\nhistory = truth.loc[\n    (truth[\"timestamp\"] < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n    & (truth[\"is_score_eligible\"].eq(1))\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\nhistory[\"weekday\"] = history[\"timestamp\"].dt.dayofweek\nhistory[\"minute_of_day\"] = (\n    history[\"timestamp\"].dt.hour * 60\n    + history[\"timestamp\"].dt.minute\n)\n\nprint(\"Restored history:\", history.shape)\nprint(\"Date range:\", history[\"timestamp\"].min(), \"to\", history[\"timestamp\"].max())\n\n# Build March baseline\nmarch_baseline = build_baseline(\n    march_targets,\n    pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n)\n\nprint(\"March baseline:\", march_baseline.shape)\nprint(\"Missing baseline values:\",\n      march_baseline[VALUE_COLS].isna().any(axis=1).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:26:14.476293Z","iopub.execute_input":"2026-10-19T15:26:14.476778Z","iopub.status.idle":"2026-10-19T15:26:22.233755Z","shell.execute_reply.started":"2026-10-19T15:26:14.476749Z","shell.execute_reply":"2026-10-19T15:26:22.232585Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Attach baseline and construct March features\nmarch_features = attach_baseline(march_targets, march_baseline)\nmarch_features = add_lags(march_features)\nmarch_features = add_model_features(march_features)\n\n# Match the exact feature names expected by the trained models\nrename_map = {\n    \"lag_speed_5\": \"lag_speed_5\",\n    \"lag_flow_5\": \"lag_flow_5\",\n    \"lag_speed_15\": \"lag_speed_15\",\n    \"lag_flow_15\": \"lag_flow_15\",\n    \"lag_speed_60\": \"lag_speed_60\",\n    \"lag_flow_60\": \"lag_flow_60\",\n    \"lag_speed_1440\": \"lag_speed_1440\",\n    \"lag_flow_1440\": \"lag_flow_1440\",\n}\n\n# Create ID codes using the same sorted-category scheme as the original model\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = sorted(features[col].astype(str).unique())\n    mapping = {value: i for i, value in enumerate(categories)}\n    march_features[f\"{col}_code\"] = (\n        march_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n\n# Convert feature names to match the model's expected order\nmarch_features = march_features.rename(columns={\n    \"lag5_speed\": \"lag_speed_5\", \"lag5_flow\": \"lag_flow_5\",\n    \"lag15_speed\": \"lag_speed_15\", \"lag15_flow\": \"lag_flow_15\",\n    \"lag60_speed\": \"lag_speed_60\", \"lag60_flow\": \"lag_flow_60\",\n    \"lag1440_speed\": \"lag_speed_1440\", \"lag1440_flow\": \"lag_flow_1440\",\n    \"dow\": \"weekday\", \"dow_sin\": \"weekday_sin\", \"dow_cos\": \"weekday_cos\",\n})\n\nmissing_cols = [c for c in FEATURES if c not in march_features.columns]\nassert not missing_cols, f\"Missing model features: {missing_cols}\"\n\nX_march = march_features[FEATURES].astype(\"float32\")\n\npred_speed = np.clip(\n    march_features[\"base_speed\"].to_numpy()\n    + speed_model_original_style.predict(X_march),\n    0, 160\n)\npred_flow = np.clip(\n    march_features[\"base_flow\"].to_numpy()\n    + flow_model_original_style.predict(X_march),\n    0, None\n)\n\nmarch_submission = march_template.copy()\nmarch_submission[\"speed_kmh\"] = pred_speed\nmarch_submission[\"flow_vph\"] = pred_flow\n\nprint(\"Submission shape:\", march_submission.shape)\nprint(\"Missing predictions:\", march_submission[[\"speed_kmh\", \"flow_vph\"]].isna().sum().to_dict())\ndisplay(march_submission.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:27:02.472234Z","iopub.execute_input":"2026-10-19T15:27:02.474099Z","iopub.status.idle":"2026-10-19T15:27:53.599704Z","shell.execute_reply.started":"2026-10-19T15:27:02.474044Z","shell.execute_reply":"2026-10-19T15:27:53.598501Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Validate predictions and save submission\nassert len(march_submission) == len(march_template)\nassert march_submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert march_submission[\"speed_kmh\"].between(0, 160).all()\nassert (march_submission[\"flow_vph\"] >= 0).all()\nassert march_submission[[\"timestamp\", \"station_id\", \"link_id\"]].equals(\n    march_template[[\"timestamp\", \"station_id\", \"link_id\"]]\n)\n\noutput_path = \"/kaggle/working/march_validation_predictions.csv\"\nmarch_submission.to_csv(output_path, index=False)\n\nprint(\"Saved:\", output_path)\nprint(\"Shape:\", march_submission.shape)\nprint(march_submission[[\"speed_kmh\", \"flow_vph\"]].describe())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:28:50.05071Z","iopub.execute_input":"2026-10-19T15:28:50.051599Z","iopub.status.idle":"2026-10-19T15:28:53.906312Z","shell.execute_reply.started":"2026-10-19T15:28:50.051554Z","shell.execute_reply":"