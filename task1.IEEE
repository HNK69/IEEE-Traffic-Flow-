bruary R2 correction shift by link\ndef link_corrections(frame, correction, period):\n    df = frame.loc[frame[\"mask_regime\"].eq(\"R2\"), [\"link_id\"]].copy()\n    df[\"correction\"] = np.asarray(correction)[\n        frame[\"mask_regime\"].eq(\"R2\").to_numpy()\n    ]\n    df[\"period\"] = period\n\n    return (\n        df.groupby([\"period\", \"link_id\"], observed=True)\n        .agg(\n            rows=(\"correction\", \"size\"),\n            mean_correction=(\"correction\", \"mean\"),\n            negative30_rate=(\"correction\", lambda x: 100 * (x < -30).mean()),\n        )\n        .reset_index()\n    )\n\nfeb_link = link_corrections(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_link = link_corrections(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\nlink_compare = feb_link.merge(\n    apr_link,\n    on=\"link_id\",\n    suffixes=(\"_feb\", \"_apr\"),\n    validate=\"one_to_one\"\n)\n\nlink_compare[\"mean_correction_change\"] = (\n    link_compare[\"mean_correction_apr\"]\n    - link_compare[\"mean_correction_feb\"]\n)\nlink_compare[\"negative30_rate_change_pp\"] = (\n    link_compare[\"negative30_rate_apr\"]\n    - link_compare[\"negative30_rate_feb\"]\n)\n\ndisplay(\n    link_compare.loc[\n        (link_compare[\"rows_feb\"] >= 100)\n        & (link_compare[\"rows_apr\"] >= 100)\n    ]\n    .sort_values(\"mean_correction_change\")\n    [[\n        \"link_id\", \"rows_feb\", \"rows_apr\",\n        \"mean_correction_feb\", \"mean_correction_apr\",\n        \"mean_correction_change\",\n        \"negative30_rate_feb\", \"negative30_rate_apr\",\n        \"negative30_rate_change_pp\",\n    ]]\n    .head(15)\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:05:40.232262Z","iopub.execute_input":"2026-10-19T16:05:40.232675Z","iopub.status.idle":"2026-10-19T16:05:40.462419Z","shell.exe