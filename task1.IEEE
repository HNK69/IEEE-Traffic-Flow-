y</td>\n      <td>Evening peak</td>\n      <td>&gt;80</td>\n      <td>&gt;80</td>\n      <td>6022</td>\n      <td>5.68</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>42</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>&gt;80</td>\n      <td>Missing</td>\n      <td>2857</td>\n      <td>4.44</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>90</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>&gt;80</td>\n      <td>Missing</td>\n      <td>3754</td>\n      <td>5.54</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>43</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>40-60</td>\n      <td>266</td>\n      <td>-25.41</td>\n      <td>37.97</td>\n    </tr>\n    <tr>\n      <th>91</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>40-60</td>\n      <td>199</td>\n      <td>-27.07</td>\n      <td>45.73</td>\n    </tr>\n    <tr>\n      <th>45</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&lt;40</td>\n      <td>455</td>\n      <td>-39.65</td>\n      <td>67.47</td>\n    </tr>\n    <tr>\n      <th>93</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&lt;40</td>\n      <td>364</td>\n      <td>-37.03</td>\n      <td>57.69</td>\n    </tr>\n    <tr>\n      <th>46</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&gt;80</td>\n      <td>2773</td>\n      <td>4.10</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>94</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>&gt;80</td>\n      <td>3436</td>\n      <td>4.90</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>47</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>2273</td>\n      <td>-1.74</td>\n      <td>2.38</td>\n    </tr>\n    <tr>\n      <th>95</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>2620</td>\n      <td>-0.62</td>\n      <td>1.91</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":98},{"cell_type":"code","source":"# February R2: evaluate errors by time of day and recent lag speeds\n\nfeb_error_check = feb_diag.loc[\n    feb_diag[\"mask_regime\"].eq(\"R2\")\n].copy()\n\nfeb_error_check[\"actual_speed\"] = holdout_truth.loc[\n    feb_diag[\"mask_regime\"].eq(\"R2\"), \"speed_kmh\"\n].to_numpy()\n\nfeb_error_check[\"error\"] = (\n    feb_error_check[\"pred_speed\"] - feb_error_check[\"actual_speed\"]\n)\n\nhour = feb_error_check[\"timestamp\"].dt.hour\nfeb_error_check[\"time_period\"] = pd.cut(\n    hour,\n    bins=[-1, 5, 9, 15, 19, 23],\n    labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n)\n\nfor col, band_col in [\n    (\"lag_speed_5\", \"lag5_band\"),\n    (\"lag_speed_15\", \"lag15_band\"),\n]:\n    feb_error_check[band_col] = pd.cut(\n        feb_error_check[col],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\nfeb_error_summary = (\n    feb_error_check.loc[\n        feb_error_check[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"error\", \"size\"),\n        speed_rmse=(\"error\", lambda x: np.sqrt(np.mean(x**2))),\n        mean_error=(\"error\", \"mean\"),\n        actual_speed_mean=(\"actual_speed\", \"mean\"),\n        predicted_speed_mean=(\"pred_speed\", \"mean\"),\n    )\n    .reset_index()\n)\n\ndisplay(\n    feb_error_summary.loc[feb_error_summary[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.s