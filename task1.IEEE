e two prediction files already used in our pipeline.\nmarch_path = WORK / \"march_validation_predictions.csv\"\napril_path = WORK / \"private_submission.csv\"\n\npred_frames = []\nfor path, split in [\n    (march_path, \"validation\"),\n    (april_path, \"private\"),\n]:\n    if not path.exists():\n        print(f\"\\nMISSING FILE: {path}\")\n        continue\n\n    df = pd.read_csv(path, low_memory=False)\n    df[\"split\"] = split\n    pred_frames.append(df)\n\nif not pred_frames:\n    raise FileNotFoundError(\"Neither existing prediction file was found.\")\n\npred = pd.concat(pred_frames, ignore_index=True)\n\nkeys = [\n    \"split\", \"panel\", \"timestamp\",\n    \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nfor df in [state, pred]:\n    for col in [\"split\", \"panel\", \"station_id\", \"link_id\", \"mask_regime\"]:\n        df[col] = df[col].astype(\"string\").str.strip()\n    df[\"_ts\"] = pd.to_datetime(df[\"timestamp\"], utc=True, errors=\"coerce\")\n\nif state[\"_ts\"].isna().any():\n    raise ValueError(\"Official state key has invalid timestamps.\")\nif pred[\"_ts\"].isna().any():\n    raise ValueError(\"Prediction file has invalid timestamps.\")\n\nmatch_keys = [\n    \"split\", \"panel\", \"_ts\",\n    \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nif pred.duplicated(match_keys).any():\n    raise ValueError(\"Duplicate keys found in prediction artifacts.\")\n\ncoverage = state[match_keys].merge(\n    pred[match_keys],\n    on=match_keys,\n    how=\"left\",\n    indicator=True,\n    validate=\"one_to_one\"\n)\n\nmissing_keys = coverage.loc[coverage[\"_merge\"].eq(\"left_only\"), match_keys]\n\nprint(\"\\n=== 3. Missing prediction coverage ===\")\nprint(\"Matched official state rows:\", f\"{len(coverage)-len(missing_keys):,}\")\nprint(\"Missing official state rows:\", f\"{len(missing_keys):,}\")\n\nif missing_keys.empty:\n    print(\"All state rows are covered by these artifacts.\")\nelse:\n    missing_summary = (\n        missing_keys.groupby([\"split\", \"panel\"], observed=True)\n        .size()\n        .sort_values(ascending=False)\n    )\n    print(\"\\nMissing rows by split and panel:\")\n    print(missing_summary.to_string())\n\nprint(\"\\n=== 4. Existing prediction coverage ===\")\nprint(\n    pred.groupby([\"split\", \"panel\"], observed=True)\n    .size()\n    .sort_values(ascending=False)\n    .to_string()\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:29:41.325473Z","iopub.execute_input":"2026-10-19T17:29:41.326568Z","iopub.status.idle":"2026-10-19T17:30:30.574232Z","shell.execute_reply.started":"2026-10-19T17:29:41.326511Z","shell.execute_reply":"2026-10-19T17:30:30.573176Z"}},"outputs":[{"name":"stdout","text":"=== 1. Existing prediction artifacts ===\nmarch_validation_predictions.csv                28,536,337 bytes\nprivate_submission.csv                          25,568,226 bytes\nstage2_label_coverage_audit.csv                        884 bytes\nstage2_panel_readiness_audit.csv                     1,076 bytes\n\n=== 2. Official Task 1 coverage required ===\nTotal state rows: 6,735,795\n\nRows by split and panel:\npanel       D12_I405_N  D12_I405_S  D12_I5_N  D12_I5_S  D7_I10_E  D7_I10_W  D7_I210_E  D7_I210_W  D7_I405_N  D7_I405_S\nsplit                                                                                                                 \nprivate         192164      107416    543092    204957    303294    203699     581196     158901     746097     243603\nvalidation      203337       93718    588468    219222    337512    233060     625014     205973     673133     271939\n\n=== 3. Missing prediction coverage ===\nMatched official state rows: 515,542\nMissing official state rows: 6,220,253\n\nMissing rows by split and panel:\nsplit       panel     \nprivate     D7_I405_N     746097\nvalidation  D7_I405_N     673133\n            D7_I210_E     625014\n            D12_I5_N      588468\nprivate     D7_I210_E     581196\n            D12_I5_N      543