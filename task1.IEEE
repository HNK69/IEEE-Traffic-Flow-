validate=\"many_to_one\",\n)\napril_i5n = april_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\napril_i5n[\"base_speed\"] = april_i5n[\"base_speed\"].fillna(\n    april_i5n[\"link_base_speed\"]\n)\napril_i5n[\"base_flow\"] = april_i5n[\"base_flow\"].fillna(\n    april_i5n[\"link_base_flow\"]\n)\n\n# 3. Lag features from observed January/February history.\nfor lag in LAGS_I5N:\n    src = observed_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    april_i5n = april_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    del src\n    gc.collect()\n\n# 4. Lags from observed April values.\napril_obs_i5n = april_i5n.loc[\n    april_i5n[\"is_observed\"].eq(1),\n    KEYS_I5N + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\n\nfor lag in LAGS_I5N:\n    src = april_obs_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"april_lag_speed_{lag}\",\n        \"obs_flow\": f\"april_lag_flow_{lag}\",\n    })\n    april_i5n = april_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    april_i5n[f\"lag_speed_{lag}\"] = april_i5n[f\"lag_speed_{lag}\"].fillna(\n        april_i5n[f\"april_lag_speed_{lag}\"]\n    )\n    april_i5n[f\"lag_flow_{lag}\"] = april_i5n[f\"lag_flow_{lag}\"].fillna(\n        april_i5n[f\"april_lag_flow_{lag}\"]\n    )\n    april_i5n.drop(\n        columns=[f\"april_lag_speed_{lag}\", f\"april_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar and category features.\napril_i5n[\"weekday\"] = april_i5n[\"timestamp\"].dt.weekday\napril_i5n[\"minute_of_day\"] = (\n    april_i5n[\"timestamp\"].dt.hour * 60 + april_i5n[\"timestamp\"].dt.minute\n)\napril_i5n[\"tod_sin\"] = np.sin(2 * np.pi * april_i5n[\"minute_of_day\"] / 1440)\napril_i5n[\"tod_cos\"] = np.cos(2 * np.pi * april_i5n[\"minute_of_day\"] / 1440)\napril_i5n[\"weekday_sin\"] = np.sin(2 * np.pi * april_i5n[\"weekday\"] / 7)\napril_i5n[\"weekday_cos\"] = np.cos(2 * np.pi * april_i5n[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    april_i5n[col + \"_code\"] = (\n        april_i5n[col].map(category_maps_i5n[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict.\nX_april_i5n = april_i5n[FEATURES_I5N].replace([np.inf, -np.inf], np.nan)\napril_i5n[\"pred_speed\"] = np.clip(\n    april_i5n[\"base_speed\"].to_numpy()\n    + speed_model_i5n_final.predict(X_april_i5n),\n    0, 160,\n)\napril_i5n[\"pred_flow\"] = np.clip(\n    april_i5n[\"base_flow\"].to_numpy()\n    + flow_model_i5n_final.predict(X_april_i5n),\n    0, None,\n)\n\n# 7. Align to official private template.\ntemplate_path_i5n = (\n    ROOT / \"task1\" / PANEL_I5N / \"private\" / \"sample_submission_state.csv\"\n)\ntemplate_i5n = pd.read_csv(template_path_i5n)\ntemplate_i5n[\"timestamp\"] = pd.to_datetime(\n    template_i5n[\"timestamp\"], utc=True\n)\n\njoin_keys_i5n = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\npred_source_i5n = april_i5n[\n    join_keys_i5n + [\"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source_i5n.duplicated(join_keys_i5n).any()\n\ntemplate_i5n[\"_row_order\"] = np.arange(len(template_i5n))\nresult_april_i5n = template_i5n.merge(\n    pred_source_i5n,\n    on=join_keys_i5n,\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n).sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(result_april_i5n) == 543_092\nassert result_april_i5n[\"pred_speed\"].notna().all(), (\n    f\"Missing speed: {result_april_i5n['pred_speed'].isna().sum()}\"\n)\nassert result_april_i