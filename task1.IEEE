mission_key):,}\")\nprint(\"Submission-key columns:\", submission_key.columns.tolist())\n\nprint(\"\\nSample:\")\nprint(sample.head(3).to_string(index=False))\n\nprint(\"\\nSubmission key:\")\nprint(submission_key.head(5).to_string(index=False))\n\nprint(\"\\nSample task counts:\")\nprint(sample[\"task\"].value_counts(dropna=False).to_string())\n\nif \"task\" in submission_key.columns:\n    print(\"\\nSubmission-key task counts:\")\n    print(submission_key[\"task\"].value_counts(dropna=False).to_string())\n\nprint(\"\\nSample IDs unique:\", sample[\"submission_id\"].is_unique)\nprint(\n    \"Key IDs unique:\",\n    submission_key[\"submission_id\"].is_unique\n    if \"submission_id\" in submission_key.columns else \"No submission_id column\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:19:55.344834Z","iopub.execute_input":"2026-10-21T18:19:55.345346Z","iopub.status.idle":"2026-10-21T18:20:23.561775Z","shell.execute_reply.started":"2026-10-21T18:19:55.345312Z","shell.execute_reply":"2026-10-21T18:20:23.560461Z"}},"outputs":[{"name":"stdout","text":"Sample rows: 6,980,503\nSample columns: ['submission_id', 'task', 'speed_kmh', 'flow_vph', 'queue_pred', 'path_flow']\n\nSubmission-key rows: 6,980,503\nSubmission-key columns: ['submission_id', 'task', 'split', 'panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'window_id', 'departure_time', 'path_id', 'origin_zone', 'destination_zone']\n\nSample:\n submission_id  task  speed_kmh  flow_vph  queue_pred  path_flow\n             1 state          0         0           0          0\n             2 state          0         0           0          0\n             3 state          0         0           0          0\n\nSubmission key:\n submission_id  task      split      panel            timestamp          station_id   link_id mask_regime window_id departure_time path_id origin_zone destination_zone\n             1 state validation D12_I405_N 2031-03-01T00:00:00Z SYN_D12_I405_N_0002 L405N-010          R2         -            NaN       -         NaN              NaN\n             2 state validation D12_I405_N 2031-03-01T00:00:00Z SYN_D12_I405_N_0003 L405N-013          R2         -            NaN       -         NaN              NaN\n             3 state validation D12_I405_N 2031-03-01T00:00:00Z SYN_D12_I405_N_0010 L405N-038          R2         -            NaN       -         NaN              NaN\n             4 state validation D12_I405_N 2031-03-01T00:00:00Z SYN_D12_I405_N_0025 L405N-089          R2         -            NaN       -         NaN              NaN\n             5 state validation D12_I405_N 2031-03-01T00:00:00Z SYN_D12_I405_N_0029 L405N-040          R2         -            NaN       -         NaN              NaN\n\nSample task counts:\ntask\nstate    6735795\nqueue     174000\nodme       70708\n\nSubmission-key task counts:\ntask\nstate    6735795\nqueue     174000\nodme       70708\n\nSample IDs unique: True\nKey IDs unique: True\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"\n# Diagnose exactly why the non-state comparison fails.\n\nnon_state_mask = (\n    sample[\"task\"].astype(str).str.lower() != \"state\"\n)\n\nfor col in [\"speed_kmh\", \"flow_vph\", \"queue_pred\", \"path_flow\"]:\n    original = sample.loc[non_state_mask, col].reset_index(drop=True)\n    result = final.loc[non_state_mask, col].reset_index(drop=True)\n\n    print(f\"\\n--- {col} ---\")\n    print(\"Original dtype:\", original.dtype)\n    print(\"Final dtype:\", result.dtype)\n    print(\"Original missing:\", original.isna().sum())\n    print(\"Final missing:\", result.isna().sum())\n    print(\"Series.equals:\", original.equals(result))\n\n    # Compare values after numeric normalization when possible.\n    orig_num = pd.to_numeric(original, errors=\"coerce\")\n    final_num = pd.to_numeric(result, errors=\"coerce\")\n\n    print(\"Numeric values equal:\",\n          np.allclose(\n              orig_num.to_numpy(dtype=float),\n              final_num.to_numpy(dtype=float),\n              equal_nan=True\n          ))\n\n    differing = ~(\n        (original == result)\n        | (original.isna() & result.isna())\n    )\n    print(\"Different rows:\", int(differing.sum()))\n\n    if differing.any():\n        idx = np.flatnonzero(differing.to_numpy())[:5]\n        print(\"Examples:\")\n        for i in idx:\n            print(\n                \"row\", int(i),\n                \"| original:\", repr(original.iloc[i]),\n                \"| final:\", repr(result.iloc[i])\n            )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:36:38.613556Z","iopub.execute_input":"2026-10-21T18:36:38.615078Z","iopub.status.idle":"2026-10-21T18:36:40.84539Z","shell.execute_reply.started":"2026-10-21T18:36:38.614991Z","shell.execute_reply":"2026-10-21T18:36:40.843918Z"}},"outputs":[{"name":"stdout","text":"\n--- speed_kmh ---\nOriginal dtype: int64\nFinal dtype: float64\nOriginal missing: 0\nFinal missing: 0\nSeries.equals: False\nNumeric values equal: True\nDifferent rows: 0\n\n--- flow_vph ---\nOriginal dtype: int64\nFinal dtype: float64\nOriginal missing: 0\nFinal missing: 0\nSeries.equals: False\nNumeric values equal: True\nDifferent rows: 0\n\n--- queue_pred ---\nOriginal dtype: int64\nFinal dtype: int64\nOriginal missing: 0\nFinal missing: 0\nSeries.equals: True\nNumeric values equal: True\nDifferent rows: 0\n\n--- path_flow ---\nOriginal dtype: int64\nFinal dtype: int64\nOriginal missing: 0\nFinal missing: 0\nSeries.equals: True\nNumeric values equal: True\nDifferent rows: 0\n","output_type":"stream"}],"execution_count":45},{"cell_type":"code","source":"\n# FINALIZE — dtype-aware validation, save, and verify\n\nimport numpy as np\nimport pandas as pd\nimport json\nimport zipfile\n\n# Check that non-state values are numerically identical.\nnon_state_mask = (\n    sample[\"task\"].astype(str).str.lower().to_numpy() != \"state\"\n)\n\nfor col in sample.columns:\n    original = sample.loc[non_state_mask, col].reset_index(drop=True)\n    result = final.loc[non_state_mask, col].reset_index(drop=True)\n\n    if col in [\"speed_kmh\", \"flow_vph\", \"queue_pred\", \"path_flow\"]:\n        a = pd.to_numeric(original, errors=\"raise\").to_numpy(dtype=float)\n        b = pd.to_numeric(result, errors=\"raise\").to_numpy(dtype=float)\n        if not np.array_equal(a, b, equal_nan=True):\n            raise ValueError(f\"Actual non-state value change in {col}\")\n    elif not original.equals(result):\n        raise ValueError(f\"Non-state values changed in {col}\")\n\n# Validate official schema and predictions.\nassert len(final) == len(sample) == 6_980_503\nassert final.columns.tolist() == sample.columns.tolist()\nassert final[\"submission_id\"].is_unique\n\nstate_mask = final[\"task\"].astype(str).str.lower() == \"state\"\nassert int(state_mask.sum()) == 6_735_795\nassert final.loc[state_mask, [\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n\nstate_values = final.loc[\n    state_mask, [\"speed_kmh\", \"flow_vph\"]\n].to_numpy(dtype=float)\nassert np.isfinite(state_values).all()\n\n# Save submission.\nout_path = WORK / \"submission.csv\"\nfinal.to_csv(out_path, index=False)\n\n# Reload and verify the saved CSV.\ncheck = pd.read_csv(out_path)\nassert len(check) == len(sample)\nassert check.columns.tolist() == sample.columns.tolist()\nassert check[\"submission_id\"].is_unique\n\nsaved_state = check[\"task\"].astype(str).str.lower() == \"state\"\nassert check.loc[saved_state, [\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert np.isfinite(\n    check.loc[saved_state, [\"speed_kmh\", \"flow_vph\"]].to_numpy(dtype=float)\n).all()\n\n# Verify non-state values after saving, allowing numeric dtype differences.\nsaved_non_state = ~saved_state\nfor col in [\"speed_kmh\", \"flow_vph\", \"queue_pred\", \"path_flow\"]:\n    a = pd.to_numeric(\n        sample.loc[non_state_mask, col], errors=\"raise\"\n    ).to_numpy(dtype=float)\n    b = pd.to_numeric(\n        check.loc[saved_non_state, col], errors=\"raise\"\n    ).to_numpy(dtype=float)\n    assert np.array_equal(a, b, equal_nan=True), (\n        f\"Saved non-state values changed: {col}\"\n    )\n\n# Update manifest.\nmanifest_path = LOCAL_RESUME_DIR / \"manifest.json\"\nmanifest = {}\nif manifest_path.exists():\n    with open(manifest_path, \"r\") as f:\n        manifest = json.load(f)\n\nmanifest.update({\n    \"completed_panels\": PANELS,\n    \"status\": \"ALL_PANELS_VERIFIED\",\n    \"final_submission_created\": True,\n    \"submission_path\": str(out_path),\n    \"submission_rows\": int(len(check)),\n    \"state_rows\": int(saved_state.sum()),\n})\n\nwith open(manifest_path, \"w\") as f:\n    json.dump(manifest, f, indent=2)\n\n# Refresh and verify recovery ZIP.\nzip_path = WORK / \"trafficflow_resume_package.zip\"\nwith zipfile.ZipFile(zip_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n    for file in LOCAL_RESUME_DIR.rglob(\"*\"):\n        if file.is_file():\n            zf.write(file, arcname=str(file.relative_to(WORK)))\n\nwith zipfile.ZipFile(zip_path, \"r\") as zf:\n    assert zf.testzip() is None\n\nprint(\"=\" * 55)\nprint(\"SUBMISSION CREATED AND VERIFIED\")\nprint(\"File:\", out_path)\nprint(\"Total rows:\", f\"{len(check):,}\")\nprint(\"State rows:\", f\"{int(saved_state.sum()):,}\")\nprint(\"Non-state values preserved.\")\nprint(\"Recovery ZIP:\", zip_path)\nprint(\"=\" * 55)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:37:29.287844Z","iopub.execute_input":"2026-10-21T18:37:29.288658Z","iopub.status.idle":"2026-10-21T18:38:55.101853Z","shell.execute_reply.started":"2026-10-21T18:37:29.288611Z","shell.execute_reply":"2026-10-21T18:38:55.100667Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nSUBMISSION CREATED AND VERIFIED\nFile: /kaggle/working/submission.csv\nTotal rows: 6,980,503\nState rows: 6,735,795\nNon-state values preserved.\nRecovery ZIP: /kaggle/working/trafficflow_resume_package.zip\n=======================================================\n","output_type":"stream"}],"execution_count":46},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}