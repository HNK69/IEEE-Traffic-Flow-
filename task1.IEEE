t counts: 6061039 625014 581196\n  Missing target-link metadata: 0\n  Schema valid: True\n  Status: READY_FOR_NEXT_CHECK\n\nChecking D7_I210_W...\n  Truth files: 273\n  Masked files: 273\n  Target counts: 1569035 205973 158901\n  Missing target-link metadata: 0\n  Schema valid: True\n  Status: READY_FOR_NEXT_CHECK\n\nChecking D7_I405_N...\n  Truth files: 273\n  Masked files: 273\n  Target counts: 7114278 673133 746097\n  Missing target-link metadata: 0\n  Schema valid: True\n  Status: READY_FOR_NEXT_CHECK\n\nChecking D7_I405_S...\n  Truth files: 273\n  Masked files: 273\n  Target counts: 2127937 271939 243603\n  Missing target-link metadata: 0\n  Schema valid: True\n  Status: READY_FOR_NEXT_CHECK\n\n==========================================================================================\nSTAGE 2.1 SUMMARY\n==========================================================================================\n     panel               status  truth_files  masked_files  train_targets  validation_targets  private_targets  link_metadata_rows  target_links_missing_metadata  truth_schema_ok  duplicate_metadata_ids  invalid_lane_rows  duplicate_train_keys  duplicate_validation_keys  duplicate_private_keys\nD12_I405_N READY_FOR_NEXT_CHECK          273           273        1793853              203337           192164                  89                              0             True                       0                  0                     0                          0                       0\nD12_I405_S READY_FOR_NEXT_CHECK          273           273         947966               93718           107416                  44                              0             True                       0                  0                     0                          0                       0\n  D12_I5_N READY_FOR_NEXT_CHECK          273           273        5148741              588468           543092                 258                              0             True                       0                  0                     0                          0                       0\n  D12_I5_S READY_FOR_NEXT_CHECK          273           273        2049512              219222           204957                 100                              0             True                       0                  0                     0                          0                       0\n  D7_I10_E READY_FOR_NEXT_CHECK          273           273        2815381              337512           303294                 146                              0             True                       0                  0                     0                          0                       0\n  D7_I10_W READY_FOR_NEXT_CHECK          273           273        2156021              233060           203699                 107                              0             True                       0                  0                     0                          0                       0\n D7_I210_E READY_FOR_NEXT_CHECK          273           273        6061039              625014           581196                 297                              0             True                       0                  0                     0                          0                       0\n D7_I210_W READY_FOR_NEXT_CHECK          273           273        1569035              205973           158901                  81                              0             True                       0                  0                     0                          0                       0\n D7_I405_N READY_FOR_NEXT_CHECK          273           273        7114278              673133           746097                 352                              0             True                       0                  0                     0                          0                       0\n D7_I405_S READY_FOR_NEXT_CHECK          273           273        2127937              271939           243603                 109                              0             True                       0                  0                     0                          0                       0\n\nAudit report saved to: /kaggle/working/stage2_panel_readiness_audit.csv\nThis audit does not train models or establish model performance.\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.2\n# Cross-panel label and holdout coverage audit\n# ============================================================\n\nfrom pathlib import Path\nimport gc\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nHOLDOUT_END = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\ndef normalize_keys(df):\n    df = df.copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(\"string\").str.strip()\n    df[\"link_id\"] = df[\"link_id\"].astype(\"string\").str.strip()\n    return df\n\ndef load_truth(truth_dir):\n    files = sorted(truth_dir.rglob(\"*.parquet\"))\n    if not files:\n        raise FileNotFoundError(f\"No truth parquet files in {truth_dir}\")\n\n    frames = []\n    columns = [\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    ]\n\n    for file in files:\n        frame = pd.read_parquet(file, columns=columns)\n        frames.append(frame)\n\n    truth = pd.concat(frames, ignore_index=True)\n    del frames\n    truth = normalize_keys(truth)\n    return truth\n\nrows = []\n\nfor panel in PANELS:\n    print(f\"\\nAuditing labels: {panel}\")\n\n    corridor = ROOT / \"corridors\" / panel\n    truth_dir = corridor / \"train\" / \"mainline_states\"\n    template_path = (\n        ROOT / \"task1\" / panel / \"train\"\n        / \"sample_submission_state.csv\"\n    )\n\n    if not truth_dir.exists() or not template_path.exists():\n        rows.append({\n            \"panel\": panel,\n            \"status\": \"MISSING_INPUT\",\n        })\n        print(\"  Missing truth directory or train template.\")\n        continue\n\n    template = pd.read_csv(\n        template_path,\n        usecols=KEYS + [\"mask_regime\"],\n    )\n    template = normalize_keys(template)\n\n    if template.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate keys in train template\")\n\n    dates = template[\"timestamp\"]\n\n    train_template = template.loc[\n        (dates >= TRAIN_START) & (dates < HOLDOUT_START)\n    ].copy()\n\n    feb_template = template.loc[\n        (dates >= HOLDOUT_START) & (dates < HOLDOUT_END)\n    ].copy()\n\n    truth = load_truth(truth_dir)\n\n    if truth.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate truth keys\")\n\n    # Truth coverage and labels for December–January training targets.\n    train_labels = train_template.merge(\n        truth[\n            KEYS + [\n                \"speed_kmh\", \"flow_vph\",\n                \"pct_observed\", \"is_score_eligible\",\n            ]\n        ],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True,\n    )\n\n    # Truth coverage and labels for February holdout targets.\n    feb_labels = feb_template.merge(\n        truth[\n            KEYS + [\n                \"speed_kmh\", \"flow_vph\",\n                \"pct_observed\", \"is_score_eligible\",\n            ]\n        ],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True,\n    )\n\n    def summarize(df):\n        matched = df[\"_merge\"].eq(\"both\")\n        valid_values = (\n            df[\"speed_kmh\"].notna()\n            & df[\"flow_vph\"].notna()\n        )\n        eligible = (\n            df[\"is_score_eligible\"]\n            .fillna(False)\n            .astype(bool)\n        )\n        valid = matched & valid_values & eligible\n\n        return {\n            \"targets\": len(df),\n            \"truth_matched\": int(matched.sum()),\n            \"valid_eligible_labels\": int(valid.sum()),\n            \"missing_truth_keys\": int((~matched).sum()),\n            \"invalid_or_ineligible\": int((~valid).sum()),\n        }\n\n    tr = summarize(train_labels)\n    ho = summarize(feb_labels)\n\n    status = (\n        \"READY\"\n        if (\n            tr[\"targets\"] > 0\n            and ho[\"targets\"] > 0\n            and tr[\"valid_eligible_labels\"] == tr[\"targets\"]\n            and ho[\"valid_eligible_labels\"] == ho[\"targets\"]\n        )\n        else \"REVIEW_REQUIRED\"\n    )\n\n    rows.append({\n        \"panel\": panel,\n        \"status\": status,\n        \"train_targets_dec_jan\": tr[\"targets\"],\n        \"train_truth_matched\": tr[\"truth_matched\"],\n        \"train_valid_eligible\": tr[\"valid_eligible_labels\"],\n        \"train_missing_truth\": tr[\"missing_truth_keys\"],\n        \"train_invalid_or_ineligible\": tr[\"invalid_or_ineligible\"],\n        \"feb_targets\": ho[\"targets\"],\n        \"feb_truth_matched\": ho[\"truth_matched\"],\n        \"feb_valid_eligible\": ho[\"valid_eligible_labels\"],\n        \"feb_missing_truth\": ho[\"missing_truth_keys\"],\n        \"feb_invalid_or_ineligible\": ho[\"invalid_or_ineligible\"],\n    })\n\n    print(\n        f\"  Dec-Jan targets: {tr['targets']:,}; \"\n        f\"valid eligible labels: {tr['valid_eligible_labels']:,}\"\n    )\n    print(\n        f\"  February targets: {ho['targets']:,}; \"\n        f\"valid eligible labels: {ho['valid_eligible_labels']:,}\"\n    )\n    print(\"  Status:\", status)\n\n    del template, train_template, feb_template\n    del truth, train_labels, feb_labels\n    gc.collect()\n\nreport = pd.DataFrame(rows)\n\nprint(\"\\n\" + \"=\" * 110)\nprint(\"STAGE 2.2 — LABEL COVERAGE SUMMARY\")\nprint(\"=\" * 110)\nprint(report.to_string(index=False))\n\noutput_path = Path(\n    \"/kaggle/working/stage2_label_coverage_audit.csv\"\n)\nreport.to_csv(output_path, index=False)\nprint(\"\\nSaved report:\", output_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:29:12.398653Z","iopub.execute_input":"2026-10-19T13:29:12.399059Z","iopub.status.idle":"2026-10-19T13:39:52.531178Z","shell.execute_reply.started":"2026-10-19T13:29:12.399028Z","shell.execute_reply":"2026-10-19T13:39:52.529781Z"}},"outputs":[{"name":"stdout","text":"\nAuditing labels: D12_I405_N\n  Dec-Jan targets: 405,259; valid eligible labels: 405,259\n  February targets: 204,314; valid eligible labels: 204,314\n  Status: READY\n\nAuditing labels: D12_I405_S\n  Dec-Jan targets: 220,537; valid eligible labels: 220,537\n  February targets: 101,015; valid eligible labels: 101,015\n  Status: READY\n\nAuditing labels: D12_I5_N\n  Dec-Jan targets: 1,139,915; valid eligible labels: 1,139,915\n  February targets: 516,304; valid eligible labels: 516,304\n  Status: READY\n\nAuditing labels: D12_I5_S\n  Dec-Jan targets: 469,815; valid eligible labels: 469,815\n  February targets: 209,079; valid eligible labels: 209,079\n  Status: READY\n\nAuditing labels: D7_I10_E\n  Dec-Jan targets: 619,677; valid eligible labels: 619,677\n  February targets: 324,220; valid eligible labels: 324,220\n  Status: READY\n\nAuditing labels: D7_I10_W\n  Dec-Jan targets: 514,028; valid eligible labels: 514,028\n  February targets: 219,045; valid eligible labels: 219,045\n  Status: READY\n\nAuditing labels: D7_I210_E\n  Dec-Jan targets: 1,359,402; valid eligible labels: 1,359,402\n  February targets: 719,938; valid eligible labels: 719,938\n  Status: READY\n\nAuditing labels: D7_I210_W\n  Dec-Jan targets: 376,731; valid eligible labels: 376,731\n  February targets: 170,401; valid eligible labels: 170,401\n  Status: READY\n\nAuditing labels: D7_I405_N\n  Dec-Jan targets: 1,593,412; valid eligible labels: 1,593,412\n  February targets: 744,137; valid eligible labels: 744,137\n  Status: READY\n\nAuditing labels: D7_I405_S\n  Dec-Jan targets: 479,688; valid eligible labels: 479,688\n  February targets: 235,491; valid eligible labels: 235,491\n  Status: READY\n\n==============================================================================================================\nSTAGE 2.2 — LABEL COVERAGE SUMMARY\n==============================================================================================================\n     panel status  train_targets_dec_jan  train_truth_matched  train_valid_eligible  train_missing_truth  train_invalid_or_ineligible  feb_targets  feb_truth_matched  feb_valid_eligible  feb_missing_truth  feb_invalid_or_ineligible\nD12_I405_N  READY                 405259               405259                405259                    0                            0       204314             204314              204314                  0                          0\nD12_I405_S  READY                 220537               220537                220537                    0                            0       101015             101015              101015                  0                          0\n  D12_I5_N  READY                1139915              1139915               1139915                    0                            0       516304             516304              516304                  0                          0\n  D12_I5_S  READY                 469815               469815                469815                    0                            0       209079             209079              209079                  0                          0\n  D7_I10_E  READY                 619677               619677                619677                    0                            0       324220             324220              324220                  0                          0\n  D7_I10_W  READY                 514028               514028                514028                    0                            0       219045             219045              219045                  0                          0\n D7_I210_E  READY                1359402              1359402               1359402                    0                            0       719938             719938              719938                  0                          0\n D7_I210_W  READY                 376731               376731                376731                    0                            0       170401             170401              170401                  0                          0\n D7_I405_N  READY                1593412              1593412               1593412                    0                            0       744137             744137              744137                  0                          0\n D7_I405_S  READY                 479688               479688                479688                    0                            0       235491             235491              235491                  0                          0\n\nSaved report: /kaggle/working/stage2_label_coverage_audit.csv\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.3\n# Reconstructed benchmark gate: D7_I405_S\n#\n# Purpose:\n#   1. Rebuild historical baseline profiles.\n#   2. Build target features using masked inputs for lags.\n#   3. Train residual models on Dec 2030 + Jan 2031.\n#   4. Evaluate against Feb 2031 truth.\n#   5. Compare against Stage 1 benchmark scores.\n#\n# IMPORTANT:\n#   This is a reconstruction, not the recovered original cell.\n#   Do not expand to other panels unless this gate passes.\n# ============================================================\n\nfrom pathlib import Path\nimport gc\nimport json\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.impute import SimpleImputer\n\nwarnings.filterwarnings(\"ignore\")\n\n# -----------------------------\n# 1. Configuration\n# -----------------------------\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nCORRIDOR = ROOT / \"corridors\" / PANEL\nTRUTH_DIR = CORRIDOR / \"train\" / \"mainline_states\"\nMASKED_DIR = CORRIDOR / \"train\" / \"mainline_states_masked\"\nTEMPLATE = (\n    ROOT / \"task1\" / PANEL / \"train\"\n    / \"sample_submission_state.csv\"\n)\nLINKS_PATH = CORRIDOR / \"network\" / \"links.csv\"\n\nOUT = Path(\"/kaggle/working/stage2_benchmark_gate\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nHOLDOUT_END = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\nEXPECTED_BASELINE_MACRO = 0.653495\nEXPECTED_RESIDUAL_MACRO = 0.825718\nSCORE_TOLERANCE = 0.01  # diagnostic tolerance, not a guarantee\n\n# -----------------------------\n# 2. Safe loading and key types\n# -----------------------------\n\ndef normalize_keys(df):\n    df = df.copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = (\n        df[\"station_id\"].astype(\"string\").str.strip()\n    )\n    df[\"link_id\"] = (\n        df[\"link_id\"].astype(\"string\").str.strip()\n    )\n    return df\n\n\ndef load_parquet_folder(folder, columns):\n    files = sorted(folder.rglob(\"*.parquet\"))\n    if not files:\n        raise FileNotFoundError(f\"No parquet files found: {folder}\")\n\n    frames = []\n    for i, file in enumerate(files, 1):\n        frames.append(pd.read_parquet(file, columns=columns))\n        if i % 50 == 0:\n            print(f\"  Loaded {i}/{len(files)} files from {folder.name}\")\n\n    result = pd.concat(frames, ignore_index=True)\n    del frames\n    result = normalize_keys(result)\n    return result\n\n\nprint(\"Loading truth data...\")\ntruth = load_parquet_folder(\n    TRUTH_DIR,\n    KEYS + VALUE_COLS + [\"pct_observed\", \"is_score_eligible\"],\n)\n\nprint(\"Loading masked data...\")\nmasked = load_parquet_folder(\n    MASKED_DIR,\n    KEYS + VALUE_COLS,\n)\n\nprint(\"Loading official train template...\")\ntemplate = pd.read_csv(\n    TEMPLATE,\n    usecols=KEYS + [\"mask_regime\"],\n)\ntemplate = normalize_keys(template)\ntemplate[\"mask_regime\"] = (\n    template[\"mask_regime\"].astype(\"string\").str.strip()\n)\n\nif truth.duplicated(KEYS).any():\n    raise ValueError(\"Truth contains duplicate keys.\")\nif masked.duplicated(KEYS).any():\n    raise ValueError(\"Masked data contains duplicate keys.\")\nif template.duplicated(KEYS).any():\n    raise ValueError(\"Train template contains duplicate keys.\")\n\nprint(\"Truth rows:\", f\"{len(truth):,}\")\nprint(\"Masked rows:\", f\"{len(masked):,}\")\nprint(\"Template rows:\", f\"{len(template):,}\")\n\n# -----------------------------\n# 3. Load link lane metadata\n# -----------------------------\n\nlinks = pd.read_csv(LINKS_PATH, usecols=[\"link_id\", \"lanes\"])\nlinks[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\nlinks[\"lanes\"] = pd.to_numeric(links[\"lanes\"], errors=\"coerce\")\n\nif links[\"link_id\"].duplicated().any():\n    raise ValueError(\"Duplicate link IDs in lane metadata.\")\nif links[\"lanes\"].isna().any() or (links[\"lanes\"] <= 0).any():\n    raise ValueError(\"Invalid lane counts in metadata.\")\n\n# -----------------------------\n# 4. Define train and holdout\n# -----------------------------\n\ndates = template[\"timestamp\"]\n\ntrain_targets = template.loc[\n    (dates >= TRAIN_START) & (dates < HOLDOUT_START)\n].copy()\n\nholdout_targets = template.loc[\n    (dates >= HOLDOUT_START) & (dates < HOLDOUT_END)\n].copy()\n\nif train_targets.empty or holdout_targets.empty:\n    raise ValueError(\"Training or February holdout targets are empty.\")\n\ntruth_labels = truth[\n    KEYS + VALUE_COLS + [\"pct_observed\", \"is_score_eligible\"]\n].copy()\n\ntrain_targets = train_targets.merge(\n    truth_labels,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=\"_truth_match\",\n)\n\nholdout_targets = holdout_targets.merge(\n    truth_labels,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=\"_truth_match\",\n)\n\nfor name, frame in [\n    (\"train\", train_targets),\n    (\"holdout\", holdout_targets),\n]:\n    valid = (\n        frame[\"_truth_match\"].eq(\"both\")\n        & frame[\"speed_kmh\"].notna()\n        & frame[\"flow_vph\"].notna()\n        & frame[\"is_score_eligible\"].fillna(False).astype(bool)\n    )\n    if not valid.all():\n        raise ValueError(\n            f\"{name}: {int((~valid).sum()):,} targets lack \"\n            \"valid eligible truth labels.\"\n        )\n\ntrain_targets = train_targets.drop(columns=\"_truth_match\")\nholdout_targets = holdout_targets.drop(columns=\"_truth_match\")\n\nprint(\"Training targets:\", f\"{len(train_targets):,}\")\nprint(\"February holdout:\", f\"{len(holdout_targets):,}\")\n\n# -----------------------------\n# 5. Historical baseline profiles\n# -----------------------------\n\n# Profile values only use rows before the relevant target month.\n# Require pct_observed >= 75 and both targets non-null.\n\nhistory = truth.loc[\n    (truth[\"pct_observed\"] >= 75)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\nhistory[\"weekday\"] = history[\"timestamp\"].dt.dayofweek\nhistory[\"minute_of_day\"] = (\n    history[\"timestamp\"].dt.hour * 60\n    + history[\"timestamp\"].dt.minute\n)\n\ndef build_baseline(targets, month_cutoff):\n    hist = history.loc[\n        history[\"timestamp\"] < month_cutoff\n    ].copy()\n\n    if hist.empty:\n        raise ValueError(f\"No historical rows before {month_cutoff}\")\n\n    by_link_week_min = (\n        hist.groupby(\n            [\"link_id\", \"weekday\", \"minute_of_day\"],\n            observed=True,\n        )[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    by_link_week = (\n        hist.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    by_link = (\n        hist.groupby(\"link_id\", observed=True)[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    result = targets[KEYS + [\"mask_regime\"]].copy()\n    result[\"weekday\"] = result[\"timestamp\"].dt.dayofweek\n    result[\"minute_of_day\"] = (\n        result[\"timestamp\"].dt.hour * 60\n        + result[\"timestamp\"].dt.minute\n    )\n\n    result = result.merge(\n        by_link_week_min,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_profile\"),\n    )\n\n    result = result.merge(\n        by_link_week,\n        on=[\"link_id\", \"weekday\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_week\"),\n    )\n\n    result = result.merge(\n        by_link,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_link\"),\n    )\n\n    # Fill minute-profile gaps with link-week values, then link-wide.\n    for col in VALUE_COLS:\n        week_col = f\"{col}_week\"\n        link_col = f\"{col}_link\"\n\n        result[col] = (\n            result[col]\n            .fillna(result[week_col])\n            .fillna(result[link_col])\n        )\n\n    if result[VALUE_COLS].isna().any().any():\n        missing = int(result[VALUE_COLS].isna().any(axis=1).sum())\n        raise ValueError(\n            f\"{missing:,} targets have no historical baseline.\"\n        )\n\n    return result[KEYS + [\"mask_regime\"] + VALUE_COLS]\n\n\nprint(\"Building past-only baselines...\")\nbaseline_train = build_baseline(train_targets, HOLDOUT_START)\nbaseline_holdout = build_baseline(holdout_targets, HOLDOUT_START)\n\n# For training targets, use the December 1 cutoff for December\n# and the January 1 cutoff for January.\n# Rebuild January baselines separately to avoid using January data\n# to construct January baseline features.\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n\ndec_mask = train_targets[\"timestamp\"] < jan_start\njan_mask = ~dec_mask\n\nbaseline_train = pd.concat(\n    [\n        build_baseline(\n            train_targets.loc[dec_mask],\n            TRAIN_START,\n        ),\n        build_baseline(\n            train_targets.loc[jan_mask],\n            jan_start,\n        ),\n    ],\n    ignore_index=True,\n)\n\n# -----------------------------\n# 6. Merge baseline values and labels\n# -----------------------------\n\ndef attach_baseline(targets, baseline):\n    return targets.merge(\n        baseline.rename(columns={\n            \"speed_kmh\": \"base_speed\",\n            \"flow_vph\": \"base_flow\",\n        }),\n        on=KEYS + [\"mask_regime\"],\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\ntrain_data = attach_baseline(train_targets, baseline_train)\nholdout_data = attach_baseline(holdout_targets, baseline_holdout)\n\nfor name, frame in [\n    (\"train\", train_data),\n    (\"holdout\", holdout_data),\n]:\n    if frame[[\"base_speed\", \"base_flow\"]].isna().any().any():\n        raise ValueError(f\"{name}: baseline join left missing values.\")\n\n# -----------------------------\n# 7. Lag features from masked inputs only\n# -----------------------------\n\nmasked_lookup = masked[KEYS + VALUE_COLS].copy()\n\n# Preserve the observed series. Target truth values are never used\n# as lag inputs; lag lookups come exclusively from masked data.\nmasked_lookup = masked_lookup.rename(columns={\n    \"speed_kmh\": \"masked_speed\",\n    \"flow_vph\": \"masked_flow\",\n})\n\ndef add_lags(frame):\n    result = frame.copy()\n\n    for minutes in [5, 15, 60, 1440]:\n        lookup = masked_lookup.copy()\n        lookup[\"timestamp\"] = (\n            lookup[\"timestamp\"]\n            + pd.Timedelta(minutes=minutes)\n        )\n\n        lookup = lookup.rename(columns={\n            \"masked_speed\": f\"lag_speed_{minutes}\",\n            \"masked_flow\": f\"lag_flow_{minutes}\",\n        })\n\n        result = result.merge(\n            lookup,\n            on=KEYS,\n            how=\"left\",\n            validate=\"one_to_one\",\n        )\n\n        del lookup\n\n    return result\n\nprint(\"Building lag features...\")\ntrain_data = add_lags(train_data)\nholdout_data = add_lags(holdout_data)\n\n# -----------------------------\n# 8. Time and categorical ID features\n# -----------------------------\n\ndef add_model_features(frame):\n    result = frame.copy()\n\n    ts = result[\"timestamp\"]\n    weekday = ts.dt.dayofweek.to_numpy()\n    minute = (\n        ts.dt.hour.to_numpy() * 60\n        + ts.dt.minute.to_numpy()\n    )\n\n    result[\"weekday\"] = weekday\n    result[\"minute_of_day\"] = minute\n    result[\"tod_sin\"] = np.sin(2 * np.pi * minute / 1440)\n    result[\"tod_cos\"] = np.cos(2 * np.pi * minute / 1440)\n    result[\"weekday_sin\"] = np.sin(2 * np.pi * weekday / 7)\n    result[\"weekday_cos\"] = np.cos(2 * np.pi * weekday / 7)\n\n    # Encode IDs consistently across train and holdout.\n    # IDs remain strings in all joins.\n    return result\n\ntrain_data = add_model_features(train_data)\nholdout_data = add_model_features(holdout_data)\n\n# Map categories jointly so train and holdout share the same codes.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    combined = pd.concat(\n        [train_data[col], holdout_data[col]],\n        ignore_index=True,\n    ).astype(\"string\")\n    categories = pd.Index(combined.dropna().unique())\n\n    train_data[col + \"_code\"] = pd.Categorical(\n        train_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\n    holdout_data[col + \"_code\"] = pd.Categorical(\n        holdout_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nif len(FEATURES) != 19:\n    raise AssertionError(\"Expected exactly 19 features.\")\n\nX_train = train_data[FEATURES].replace([np.inf, -np.inf], np.nan)\nX_holdout = holdout_data[FEATURES].replace([np.inf, -np.inf], np.nan)\n\nprint(\"Feature matrices:\", X_train.shape, X_holdout.shape)\n\n# -----------------------------\n# 9. Fit residual models\n# -----------------------------\n\nmodel_params = dict(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\n# Impute missing lag values using training medians.\n# This is explicit to make the reconstructed pipeline reproducible.\nimputer = SimpleImputer(strategy=\"median\")\nX_train_i = imputer.fit_transform(X_train)\nX_holdout_i = imputer.transform(X_holdout)\n\ny_speed_resid = (\n    train_data[\"speed_kmh\"].to_numpy()\n    - train_data[\"base_speed\"].to_numpy()\n)\ny_flow_resid = (\n    train_data[\"flow_vph\"].to_numpy()\n    - train_data[\"base_flow\"].to_numpy()\n)\n\nprint(\"Fitting speed residual model...\")\nspeed_model = HistGradientBoostingRegressor(**model_params)\nspeed_model.fit(X_train_i, y_speed_resid)\n\nprint(\"Fitting flow residual model...\")\nflow_model = HistGradientBoostingRegressor(**model_params)\nflow_model.fit(X_train_i, y_flow_resid)\n\npred_speed = np.clip(\n    holdout_data[\"base_speed\"].to_numpy()\n    + speed_model.predict(X_holdout_i),\n    0,\n    160,\n)\npred_flow = np.clip(\n    holdout_data[\"base_flow\"].to_numpy()\n    + flow_model.predict(X_holdout_i),\n    0,\n    None,\n)\n\n# -----------------------------\n# 10. Score by official regime metric\n# -----------------------------\n\nevaluation = holdout_data[\n    KEYS + [\"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].copy()\n\nevaluation = evaluation.merge(\n    links,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nif evaluation[\"lanes\"].isna().any():\n    raise ValueError(\"Missing lane metadata during scoring.\")\n\nevaluation[\"baseline_speed_pred\"] = holdout_data[\"base_speed\"].to_numpy()\nevaluation[\"baseline_flow_pred\"] = holdout_data[\"base_flow\"].to_numpy()\nevaluation[\"residual_speed_pred\"] = pred_speed\nevaluation[\"residual_flow_pred\"] = pred_flow\n\ndef calculate_metrics(frame, prediction_prefix):\n    actual_speed = frame[\"speed_kmh\"].to_numpy()\n    actual_flow_lane = (\n        frame[\"flow_vph\"].to_numpy() / frame[\"lanes\"].to_numpy()\n    )\n\n    predicted_speed = frame[f\"{prediction_prefix}_speed_pred\"].to_numpy()\n    predicted_flow_lane = (\n        frame[f\"{prediction_prefix}_flow_pred\"].to_numpy()\n        / frame[\"lanes\"].to_numpy()\n    )\n\n    rmse_speed = float(\n        np.sqrt(np.mean((actual_speed - predicted_speed) ** 2))\n    )\n    rmse_flow_lane = float(\n        np.sqrt(np.mean((actual_flow_lane - predicted_flow_lane) ** 2))\n    )\n\n    speed_score = max(0.0, 1 - rmse_speed / 25)\n    flow_score = max(0.0, 1 - rmse_flow_lane / 600)\n    state_score = 0.54 * speed_score + 0.46 * flow_score\n\n    return {\n        \"targets\": len(frame),\n        \"speed_rmse\": rmse_speed,\n        \"flow_rmse_per_lane\": rmse_flow_lane,\n        \"score\": state_score,\n    }\n\nmetric_rows = []\n\nfor method in [\"baseline\", \"residual\"]:\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        subset = evaluation.loc[\n            evaluation[\"mask_regime\"].astype(\"string\") == regime\n        ]\n\n        if subset.empty:\n            raise ValueError(f\"No holdout targets for regime {regime}\")\n\n        metrics = calculate_metrics(subset, method)\n        metric_rows.append({\n            \"method\": method,\n            \"regime\": regime,\n            **metrics,\n        })\n\n    regime_scores = [\n        row[\"score\"]\n        for row in metric_rows\n        if row[\"method\"] == method\n    ]\n\n    metric_rows.append({\n        \"method\": method,\n        \"regime\": \"MACRO\",\n        \"targets\": len(evaluation),\n        \"speed_rmse\": np.nan,\n        \"flow_rmse_per_lane\": np.nan,\n        \"score\": float(np.mean(regime_scores)),\n    })\n\nmetrics = pd.DataFrame(metric_rows)\nprint(\"\\nBENCHMARK RESULTS\")\nprint(metrics.to_string(index=False))\n\nmetrics.to_csv(OUT / \"benchmark_gate_metrics.csv\", index=False)\n\n# Save predictions for further diagnosis.\nevaluation[\n    KEYS + [\n        \"mask_regime\", \"lanes\", \"speed_kmh\", \"flow_vph\",\n        \"baseline_speed_pred\", \"baseline_flow_pred\",\n        \"residual_speed_pred\", \"residual_flow_pred\",\n    ]\n].to_csv(OUT / \"benchmark_gate_predictions.csv\", index=False)\n\nbaseline_macro = float(\n    metrics.loc[\n        (metrics[\"method\"] == \"baseline\")\n        & (metrics[\"regime\"] == \"MACRO\"),\n        \"score\",\n    ].iloc[0]\n)\nresidual_macro = float(\n    metrics.loc[\n        (metrics[\"method\"] == \"residual\")\n        & (metrics[\"regime\"] == \"MACRO\"),\n        \"score\",\n    ].iloc[0]\n)\n\nsummary = {\n    \"panel\": PANEL,\n    \"training_targets\": len(train_data),\n    \"february_holdout_targets\": len(holdout_data),\n    \"feature_count\": len(FEATURES),\n    \"baseline_macro\": baseline_macro,\n    \"residual_macro\": residual_macro,\n    \"score_gain\": residual_macro - baseline_macro,\n    \"expected_baseline_macro\": EXPECTED_BASELINE_MACRO,\n    \"expected_residual_macro\": EXPECTED_RESIDUAL_MACRO,\n    \"baseline_within_tolerance\": (\n        abs(baseline_macro - EXPECTED_BASELINE_MACRO) <= SCORE_TOLERANCE\n    ),\n    \"residual_within_tolerance\": (\n        abs(residual_macro - EXPECTED_RESIDUAL_MACRO) <= SCORE_TOLERANCE\n    ),\n}\n\nwith open(OUT / \"benchmark_gate_summary.json\", \"w\") as f:\n    json.dump(summary, f, indent=2)\n\nprint(\"\\nBENCHMARK GATE SUMMARY\")\nprint(json.dumps(summary, indent=2))\nprint(\"\\nArtifacts saved in:\", OUT)\n\nif (\n    summary[\"baseline_within_tolerance\"]\n    and summary[\"residual_within_tolerance\"]\n):\n    print(\n        \"\\nGATE RESULT: PASS — scores match the recorded benchmark \"\n        \"within the configured tolerance. Review implementation \"\n        \"differences before scaling to all panels.\"\n    )\nelse:\n    print(\n        \"\\nGATE RESULT: NOT PASSED — do not scale to other panels yet. \"\n        \"Compare the baseline and residual metrics with Stage 1.\"\n    )\n\n# Release large objects after saving results.\ndel X_train_i, X_holdout_i\ngc.collect()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:54:44.09286Z","iopub.execute_input":"2026-10-19T13:54:44.093505Z","iopub.status.idle":"2026-10-19T13:57:54.861206Z","shell.execute_reply.started":"2026-10-19T13:54:44.093467Z","shell.execute_reply":"2026-10-19T13:57:54.859862Z"}},"outputs":[{"name":"stdout","text":"Loading truth data...\n  Loaded 50/273 files from mainline_states\n  Loaded 100/273 files from mainline_states\n  Loaded 150/273 files from mainline_states\n  Loaded 200/273 files from mainline_states\n  Loaded 250/273 files from mainline_states\nLoading masked data...\n  Loaded 50/273 files from mainline_states_masked\n  Loaded 100/273 files from mainline_states_masked\n  Loaded 150/273 files from mainline_states_masked\n  Loaded 200/273 files from mainline_states_masked\n  Loaded 250/273 files from mainline_states_masked\nLoading official train template...\nTruth rows: 8,570,016\nMasked rows: 8,570,016\nTemplate rows: 2,127,937\nTraining targets: 479,688\nFebruary holdout: 235,491\nBuilding past-only baselines...\nBuilding lag features...\nFeature matrices: (479688, 19) (235491, 19)\nFitting speed residual model...\nFitting flow residual model...\n\nBENCHMARK RESULTS\n  method regime  targets  speed_rmse  flow_rmse_per_lane    score\nbaseline     R1    19157   11.115449           79.416453 0.699020\nbaseline     R2   108110   12.817455          101.875854 0.645038\nbaseline     R3   108224   13.623117          116.497210 0.616426\nbaseline  MACRO   235491         NaN                 NaN 0.653495\nresidual     R1    19157    5.015668           59.008909 0.846421\nresidual     R2   108110    5.576311           63.762628 0.830667\nresidual     R3   108224    7.519165           74.948503 0.780126\nresidual  MACRO   235491         NaN                 NaN 0.819071\n\nBENCHMARK GATE SUMMARY\n{\n  \"panel\": \"D7_I405_S\",\n  \"training_targets\": 479688,\n  \"february_holdout_targets\": 235491,\n  \"feature_count\": 19,\n  \"baseline_macro\": 0.6534948779623194,\n  \"residual_macro\": 0.8190713133754374,\n  \"score_gain\": 0.16557643541311795,\n  \"expected_baseline_macro\": 0.653495,\n  \"expected_residual_macro\": 0.825718,\n  \"baseline_within_tolerance\": true,\n  \"residual_within_tolerance\": true\n}\n\nArtifacts saved in: /kaggle/working/stage2_benchmark_gate\n\nGATE RESULT: PASS — scores match the recorded benchmark within the configured tolerance. Review implementation differences before scaling to all panels.\n","output_type":"stream"},{"execution_count":16,"output_type":"execute_result","data":{"text/plain":"400"},"metadata":{}}],"execution_count":16},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\n# Normalize source keys.\nmasked_check = masked[KEYS + [\"speed_kmh\", \"flow_vph\"]].copy()\nmasked_check[\"timestamp\"] = pd.to_datetime(\n    masked_check[\"timestamp\"], utc=True\n)\nfor col in [\"station_id\", \"link_id\"]:\n    masked_check[col] = masked_check[col].astype(\"string\").str.strip()\n\nif masked_check.duplicated(KEYS).any():\n    raise ValueError(\"Masked source contains duplicate keys.\")\n\ntargets_check = features[KEYS].copy().reset_index(drop=True)\ntargets_check[\"timestamp\"] = pd.to_datetime(\n    targets_check[\"timestamp\"], utc=True\n)\nfor col in [\"station_id\", \"link_id\"]:\n    targets_check[col] = targets_check[col].astype(\"string\").str.strip()\n\n# Match the original source's masked lookup filtering.\nmin_time = targets_check[\"timestamp\"].min() - pd.Timedelta(days=1)\nmax_time = targets_check[\"timestamp\"].max()\n\nmasked_check = masked_check.loc[\n    masked_check[\"timestamp\"].between(min_time, max_time)\n].copy()\n\nmasked_check = masked_check.loc[\n    masked_check[\"speed_kmh\"].notna()\n    | masked_check[\"flow_vph\"].notna()\n].copy()\n\nprint(\"Target rows:\", len(targets_check))\nprint(\"Masked lookup rows:\", len(masked_check))\nprint(\"\\n=== INDEPENDENT LAG COMPARISON ===\")\n\nfor lag in LAGS:\n    lookup = targets_check.copy()\n    lookup[\"timestamp\"] -= pd.Timedelta(minutes=lag)\n\n    source = masked_check.rename(\n        columns={\n            \"speed_kmh\": \"rebuilt_speed\",\n            \"flow_vph\": \"rebuilt_flow\",\n        }\n    )\n\n    rebuilt = lookup.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        sort=False,\n    )\n\n    for kind, rebuilt_col in [\n        (\"speed\", \"rebuilt_speed\"),\n        (\"flow\", \"rebuilt_flow\"),\n    ]:\n        current_col = f\"lag{lag}_{kind}\"\n\n        a = rebuilt[rebuilt_col].to_numpy(dtype=float)\n        b = features[current_col].to_numpy(dtype=float)\n\n        same_missing = np.array_equal(np.isnan(a), np.isnan(b))\n        valid = np.isfinite(a) & np.isfinite(b)\n\n        max_diff = (\n            float(np.max(np.abs(a[valid] - b[valid])))\n            if valid.any() else 0.0\n        )\n\n        matches = (\n            same_missing\n            and np.allclose(a[valid], b[valid], rtol=0, atol=1e-10)\n        )\n\n        print(\n            f\"Lag {lag:4d} {kind:5s}: \"\n            f\"missing_pattern_match={same_missing}, \"\n            f\"max_abs_diff={max_diff:.12g}, \"\n            f\"matches={matches}\"\n        )\n\nprint(\"\\nFinished. No models were trained.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:40:13.904572Z","iopub.execute_input":"2026-10-19T14:40:13.905045Z","iopub.status.idle":"2026-10-19T14:40:31.40124Z","shell.execute_reply.started":"2026-10-19T14:40:13.905013Z","shell.execute_reply":"2026-10-19T14:40:31.399921Z"}},"outputs":[{"name":"stdout","text":"Target rows: 715179\nMasked lookup rows: 1662998\n\n=== INDEPENDENT LAG COMPARISON ===\nLag    5 speed: missing_pattern_match=True, max_abs_diff=0, matches=True\nLag    5 flow : missing_pattern_match=True, max_abs_diff=0, matches=True\nLag   15 speed: missing_pattern_match=True, max_abs_diff=0, matches=True\nLag   15 flow : missing_pattern_match=True, max_abs_diff=0, matches=True\nLag   60 speed: missing_pattern_match=True, max_abs_diff=0, matches=True\nLag   60 flow : missing_pattern_match=True, max_abs_diff=0, matches=True\nLag 1440 speed: missing_pattern_match=True, max_abs_diff=0, matches=True\nLag 1440 flow : missing_pattern_match=True, max_abs_diff=0, matches=True\n\nFinished. No models were trained.\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \