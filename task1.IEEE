.03</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>61</th>\n      <td>February</td>\n      <td>&gt;100</td>\n      <td>Missing</td>\n      <td>24115</td>\n      <td>2.01</td>\n      <td>0.02</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>29</th>\n      <td>April</td>\n      <td>Missing</td>\n      <td>40-60</td>\n      <td>769</td>\n      <td>-27.56</td>\n      <td>-27.35</td>\n      <td>45.12</td>\n    </tr>\n    <tr>\n      <th>62</th>\n      <td>February</td>\n      <td>Missing</td>\n      <td>40-60</td>\n      <td>559</td>\n      <td>-25.00</td>\n      <td>-23.66</td>\n      <td>38.28</td>\n    </tr>\n    <tr>\n      <th>32</th>\n      <td>April</td>\n      <td>Missing</td>\n      <td>&lt;40</td>\n      <td>1103</td>\n      <td>-38.89</td>\n      <td>-38.03</td>\n      <td>62.01</td>\n    </tr>\n    <tr>\n      <th>65</th>\n      <td>February</td>\n      <td>Missing</td>\n      <td>&lt;40</td>\n      <td>737</td>\n      <td>-34.84</td>\n      <td>-33.03</td>\n      <td>54.41</td>\n    </tr>\n    <tr>\n      <th>33</th>\n      <td>April</td>\n      <td>Missing</td>\n      <td>&gt;100</td>\n      <td>19037</td>\n      <td>1.39</td>\n      <td>0.01</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>66</th>\n      <td>February</td>\n      <td>Missing</td>\n      <td>&gt;100</td>\n      <td>23191</td>\n      <td>1.84</td>\n      <td>0.01</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>34</th>\n      <td>April</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>14108</td>\n      <td>-0.57</td>\n      <td>-0.01</td>\n      <td>0.79</td>\n    </tr>\n    <tr>\n      <th>67</th>\n      <td>February</td>\n      <td>Missing</td>\n      <td>Missing</td>\n      <td>15546</td>\n      <td>-0.09</td>\n      <td>-0.00</td>\n      <td>0.77</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":94},{"cell_type":"code","source":"# Compare February vs April R2 corrections by time of day\n\ndef make_tod_table(df, correction, period):\n    out = df[[\"timestamp\", \"mask_regime\"]].copy()\n    out[\"correction\"] = np.asarray(correction)\n    out = out[out[\"mask_regime\"].eq(\"R2\")].copy()\n\n    # UTC timestamps, consistent with the existing notebook\n    hour = out[\"timestamp\"].dt.hour\n    out[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n    out[\"period\"] = period\n    return out\n\nfeb_tod = make_tod_table(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_tod = make_tod_table(\n    private_features,\n    (\n        private_submission[\"speed_kmh\"].to_numpy()\n        - private_features[\"base_speed\"].to_numpy()\n    ),\n    \"April\"\n)\n\ntod_comparison = (\n    pd.concat([feb_tod, apr_tod], ignore_index=True)\n    .groupby([\"period\", \"time_period\"], observed=True)\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        negative30_rate=(\"correction\", lambda x: (x < -30).mean() * 100),\n    )\n    .reset_index()\n)\n\ndisplay(tod_comparison.round(2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:03:02.92462Z","iopub.execute_input":"2026-10-19T16:03:02.925178Z","iopub.status.idle":"2026-10-19T16:03:03.099607Z","shell.execute_reply.started":"2026-10-19T16:03:02.925148Z","shell.execute_reply":"2026-10-19T16:03:03.09777Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"     period   time_period   rows  mean_correction  median_correction  \\\n0     April         Night  23507             0.07              -0.01   \n1     April  Morning peak  15177            -0.51               0.03   \n2     April        Midday  23108            -3.99              -0.01   \n3     April  Evening peak  15502            -4.41               0.13   \n4     April  Late evening  15551            -0.39               0.02   \n5  February         Night  27125             0.02              -0.01   \n6  February  Morning peak  17977            -0.34               0.03   \n7  February        Midday  26905             0.46               0.01   \n8  February  Evening peak  18000            -0.11               0.14   \n9  February  Late evening  18103             0.13               0.02   \n\n   negative30_rate  \n0             0.00  \n1             2.80  \n2             8.34  \n3            11.67  \n4             1.67  \n5             0.00  \n6             2.36  \n7             3.56  \n8             6.96  \n9             0.72  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>period</th>\n      <th>time_period</th>\n      <th>rows</th>\n      <th>mean_correction</th>\n      <th>median_correction</th>\n      <th>negative30_rate</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>April</td>\n      <td>Night</td>\n      <td>23507</td>\n      <td>0.07</td>\n      <td>-0.01</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>April</td>\n      <td>Morning peak</td>\n      <td>15177</td>\n      <td>-0.51</td>\n      <td>0.03</td>\n      <td>2.80</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>April</td>\n      <td>Midday</td>\n      <td>23108</td>\n      <td>-3.99</td>\n      <td>-0.01</td>\n      <td>8.34</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>April</td>\n      <td>Evening peak</td>\n      <td>15502</td>\n      <td>-4.41</td>\n      <td>0.13</td>\n      <td>11.67</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>April</td>\n      <td>Late evening</td>\n      <td>15551</td>\n      <td>-0.39</td>\n      <td>0.02</td>\n      <td>1.67</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>February</td>\n      <td>Night</td>\n      <td>27125</td>\n      <td>0.02</td>\n      <td>-0.01</td>\n      <td>0.00</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>February</td>\n      <td>Morning peak</td>\n      <td>17977</td>\n      <td>-0.34</td>\n      <td>0.03</td>\n      <td>2.36</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>February</td>\n      <td>Midday</td>\n      <td>26905</td>\n      <td>0.46</td>\n      <td>0.01</td>\n      <td>3.56</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>February</td>\n      <td>Evening peak</td>\n      <td>18000</td>\n      <td>-0.11</td>\n      <td>0.14</td>\n      <td>6.96</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>February</td>\n      <td>Late evening</td>\n      <td>18103</td>\n      <td>0.13</td>\n      <td>0.02</td>\n      <td>0.72</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":95},{"cell_type":"code","source":"# R2: compare midday/evening corrections by recent lag-speed conditions\n\ndef make_r2_detail(frame, correction, period):\n    df = frame.loc[frame[\"mask_regime\"].eq(\"R2\")].copy()\n    df[\"correction\"] = np.asarray(correction)[\n        frame[\"mask_regime\"].eq(\"R2\").to_numpy()\n    ]\n\n    hour = df[\"timestamp\"].dt.hour\n    df[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n\n    df[\"lag5_band\"] = pd.cut(\n        df[\"lag_speed_5\"],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"lag15_band\"] = pd.cut(\n        df[\"lag_speed_15\"],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"period\"] = period\n    return df\n\nfeb_r2_detail = make_r2_detail(\n    feb_diag, feb_diag[\"correction\"].to_numpy(), \"February\"\n)\n\napr_r2_detail = make_r2_detail(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\ndetail = pd.concat([feb_r2_detail, apr_r2_detail], ignore_index=True)\n\nresult = (\n    detail.loc[detail[\"time_period\"].isin([\"Midday\", \"Evening peak\"])]\n    .groupby(\n        [\"period\", \"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        negative30_rate_pct=(\"correction\", lambda x: 100 * (x < -30).mean())\n    )\n    .reset_index()\n)\n\ndisplay(\n    result.loc[result[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\", \"period\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:03:42.629491Z","iopub.execute_input":"2026-10-19T16:03:42.630002Z","iopub.status.idle":"2026-10-19T16:03:43.139269Z","shell.execute_reply.started":"2026-10-19T16:03:42.629961Z","shell.execute_reply":"2026-10-19T16:03:43.138251Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"      period   time_period lag5_band lag15_band  rows  mean_correction  \\\n0      April        Midday     40-60      40-60   661           -32.01   \n48  February        Midday     40-60      40-60   463           -22.86   \n4      April        Midday     40-60    Missing   425           -32.13   \n52  February        Midday     40-60    Missing   342           -22.12   \n10     April        Midday       <40        <40   857           -37.57   \n58  February        Midday       <40        <40   629           -30.63   \n12     April        Midday       <40    Missing   565           -39.60