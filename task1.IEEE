oint-only examples:\")\n    print(list(ai.difference(bi)[:3]))\n    print(\"Template-only examples:\")\n    print(list(bi.difference(ai)[:3]))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:02:31.130785Z","iopub.execute_input":"2026-10-21T18:02:31.131421Z","iopub.status.idle":"2026-10-21T18:02:37.743858Z","shell.execute_reply.started":"2026-10-21T18:02:31.131381Z","shell.execute_reply":"2026-10-21T18:02:37.742884Z"}},"outputs":[{"name":"stdout","text":"\n--- D12_I405_N / validation ---\nCheckpoint timestamp dtype: object\nTemplate timestamp dtype: datetime64[ns, UTC]\n\nCheckpoint sample:\n           timestamp          station_id   link_id\n2031-03-01T00:00:00Z SYN_D12_I405_N_0084 L405N-001\n2031-03-01T00:00:00Z SYN_D12_I405_N_0002 L405N-010\n2031-03-01T00:00:00Z SYN_D12_I405_N_0031 L405N-011\n\nTemplate sample:\n                timestamp          station_id   link_id\n2031-03-01 00:00:00+00:00 SYN_D12_I405_N_0084 L405N-001\n2031-03-01 00:00:00+00:00 SYN_D12_I405_N_0002 L405N-010\n2031-03-01 00:00:00+00:00 SYN_D12_I405_N_0031 L405N-011\n\nAfter normalization:\nCheckpoint keys: 203337\nTemplate keys: 203337\nCheckpoint keys absent from template: 0\nTemplate keys absent from checkpoint: 0\nCheckpoint-only examples:\n[]\nTemplate-only examples:\n[]\n\n--- D12_I405_N / private ---\nCheckpoint timestamp dtype: object\nTemplate timestamp dtype: datetime64[ns, UTC]\n\nCheckpoint sample:\n           timestamp          station_id   link_id\n2031-04-01T00:00:00Z SYN_D12_I405_N_0084 L405N-001\n2031-04-01T00:00:00Z SYN_D12_I405_N_0066 L405N-005\n2031-04-01T00:00:00Z SYN_D12_I405_N_0024 L405N-015\n\nTemplate sample:\n                timestamp          station_id   link_id\n2031-04-01 00:00:00+00:00 SYN_D12_I405_N_0084 L405N-001\n2031-04-01 00:00:00+00:00 SYN_D12_I405_N_0066 L405N-005\n2031-04-01 00:00:00+00:00 SYN_D12_I405_N_0024 L405N-015\n\nAfter normalization:\nCheckpoint keys: 192164\nTemplate keys: 192164\nCheckpoint keys absent from template: 0\nTemplate keys absent from checkpoint: 0\nCheckpoint-only examples:\n[]\nTemplate-only examples:\n[]\n","output_type":"stream"}],"execution_count":33},{"cell_type":"code","source":"\n# Verify all existing checkpoints with normalized keys.\n\nimport pandas as pd\n\nverified_existing = []\n\nfor panel in PANELS:\n    cp = checkpoint_path(panel)\n    if not cp.exists():\n        print(\"NOT CHECKPOINTED:\", panel)\n        continue\n\n    pred = pd.read_csv(cp)\n    if \"split\" not in pred.columns:\n        print(\"NOT CHECKPOINTED / needs processing:\", panel)\n        continue\n\n    panel_ok = True\n\n    for split in [\"validation\", \"private\"]:\n        template = load_template(panel, split)\n        part = pred[\n            pred[\"split\"].astype(str).str.lower() == split\n        ].copy()\n\n        # Normalize all keys before comparison.\n        for df in (part, template):\n            df[\"timestamp\"] = pd.to_datetime(\n                df[\"timestamp\"], utc=True\n            ).astype(str)\n            df[\"station_id\"] = df[\"station_id\"].astype(str).str.strip()\n            df[\"link_id\"] = df[\"link_id\"].astype(str).str.strip()\n\n        if part.duplicated(KEYS).any():\n            panel_ok = False\n            print(panel, split, \"FAIL: duplicate keys\")\n            continue\n\n        expected = pd.MultiIndex.from_frame(template[KEYS])\n        actual = pd.MultiIndex.from_frame(part[KEYS])\n\n        missing = len(expected.difference(actual))\n        extra = len(actual.difference(expected))\n\n        ok = (\n            len(part) == len(template)\n            and missing == 0\n            and extra == 0\n            and not part[TARGETS].isna().any().any()\n            and np.isfinite(part[TARGETS].to_numpy(dtype=float)).all()\n        )\n\n        print(\n            f\"{panel} / {split}: \"\n            f\"{len(part):,} predictions, \"\n            f\"{len(template):,} expected, \"\n            f\"missing={missing}, extra={extra}, PASS={ok}\"\n        )\n        panel_ok = panel_ok and ok\n\n    if panel_ok:\n        verified_existing.append(panel)\n        print(\"VERIFIED:\", panel)\n    else:\n        print(\"NEEDS INVESTIGATION:\", panel)\n\nprint(\"\\nVerified existing panels:\", verified_existing)\nprint(\"Verified count:\", len(verified_existing))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:04:02.007485Z","iopub.execute_input":"2026-10-21T18:04:02.008415Z","iopub.status.idle":"2026-10-21T18:04:50.679762Z","shell.execute_reply.started":"2026-10-21T18:04:02.008375Z","shell.execute_reply":"2026-10-21T18:04:50.678849Z"}},"outputs":[{"name":"stdout","text":"D12_I405_N / validation: 203,337 predictions, 203,337 expected, missing=0, extra=0, PASS=True\nD12_I405_N / private: 192,164 predictions, 192,164 expected, missing=0, extra=0, PASS=True\nVERIFIED: D12_I405_N\nD12_I405_S / validation: 93,718 predictions, 93,718 expected, missing=0, extra=0, PASS=True\nD12_I405_S / private: 107,416 predictions, 107,416 expected, missing=0, extra=0, PASS=True\nVERIFIED: D12_I405_S\nD12_I5_N / validation: 588,468 predictions, 588,468 expected, missing=0, extra=0, PASS=True\nD12_I5_N / private: 543,092 predictions, 543,092 expected, missing=0, extra=0, PASS=True\nVERIFIED: D12_I5_N\nD12_I5_S / validation: 219,222 predictions, 219,222 expected, missing=0, extra=0, PASS=True\nD12_I5_S / private: 204,957 predictions, 204,957 expected, missing=0, extra=0, PASS=True\nVERIFIED: D12_I5_S\nNOT CHECKPOINTED / needs processing: D7_I10_E\nNOT CHECKPOINTED / needs processing: D7_I10_W\nNOT CHECKPOINTED / needs processing: D7_I210_E\nNOT CHECKPOINTED / needs processing: D7_I210_W\nNOT CHECKPOINTED / needs processing: D7_I405_N\nD7_I405_S / validation: 271,939 predictions, 271,939 expected, missing=0, extra=0, PASS=True\nD7_I405_S / private: 243,603 predictions, 243,603 expected, missing=0, extra=0, PASS=True\nVERIFIED: D7_I405_S\n\nVerified existing panels: ['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I405_S']\nVerified count: 5\n","output_type":"stream"}],"execution_count":34},{"cell_type":"code","source":"\n# Correct split-aware checkpoint validation\n\nfor panel in PANELS:\n    cp = checkpoint_path(panel)\n\n    if not cp.exists():\n        raise FileNotFoundError(f\"Missing checkpoint: {panel}\")\n\n    pred = pd.read_csv(cp)\n\n    if \"split\" not in pred.columns:\n        raise ValueError(\n            f\"{panel}: checkpoint has no split column. \"\n            \"It must be generated before final submission.\"\n        )\n\n    for split in [\"validation\", \"private\"]:\n        template = load_template(panel, split)\n        part = pred[\n            pred[\"split\"].astype(str).str.lower() == split\n        ].copy()\n\n        for df in (part, template):\n            df[\"timestamp\"] = pd.to_datetime(\n                df[\"timestamp\"], utc=True\n            ).astype(str)\n            df[\"station_id\"] = df[\"station_id\"].astype(str).str.strip()\n            df[\"link_id\"] = df[\"link_id\"].astype(str).str.strip()\n\n        expected = pd.MultiIndex.from_frame(template[KEYS])\n        actual = pd.MultiIndex.from_frame(part[KEYS])\n\n        assert len(part) == len(template), (\n            f\"{panel}/{split}: row count mismatch\"\n        )\n        assert len(expected.difference(actual)) == 0, (\n            f\"{panel}/{split}: missing template keys\"\n        )\n        assert len(actual.difference(expected)) == 0, (\n            f\"{panel}/{split}: unexpected keys\"\n        )\n        assert not part[TARGETS].isna().any().any(), (\n            f\"{panel}/{split}: missing predictions\"\n        )\n        assert np.isfinite(part[TARGETS].to_numpy(dtype=float)).all(), (\n            f\"{panel}/{split}: non-finite predictions\"\n        )\n\n    print(\"VERIFIED:\", panel)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T18:10:03.236202Z","iopub.execute_input":"2026-10-21T18:10:03.236929Z","iopub.statu