{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":153956},{"sourceType":"datasetVersion","sourceId":21062617}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\nSPLITS = [\"train\", \"validation\", \"private\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nassert ROOT.is_dir(), f\"Release root missing: {ROOT}\"\nassert (ROOT / \"corridors\").is_dir()\nassert (ROOT / \"task1\").is_dir()\n\nprint(\"Release root:\", ROOT)\nprint(\"Panels:\", len(PANELS), \"| Splits:\", SPLITS)\nprint(\"\\nChecking templates, masked partitions, train labels, and lanes...\")\n\nall_ok = True\ntemplate_summary = []\ntrain_sample_checked = 0\n\nfor panel in PANELS:\n    panel_dir = ROOT / \"corridors\" / panel\n    assert panel_dir.is_dir(), f\"Missing panel directory: {panel_dir}\"\n\n    # Lane metadata must be available for official per-lane flow scoring.\n    lane_path = panel_dir / \"network\" / \"links.csv\"\n    fd_path = panel_dir / \"network\" / \"fd_parameters.csv\"\n    assert lane_path.is_file(), f\"Missing lane metadata: {lane_path}\"\n    lanes_df = pd.read_csv(lane_path, dtype={\"link_id\": str})\n    assert {\"link_id\", \"lanes\"}.issubset(lanes_df.columns), (\n        f\"{lane_path} must contain link_id and lanes; got {list(lanes_df.columns)}\"\n    )\n    usable_lanes = pd.to_numeric(lanes_df[\"lanes\"], errors=\"coerce\")\n    assert (usable_lanes.between(1, 16) | usable_lanes.isna()).all(), (\n        f\"Unexpected lane values in {lane_path}\"\n    )\n\n    for split in SPLITS:\n        template_path = ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n        assert template_path.is_file(), f\"Missing Task 1 template: {template_path}\"\n\n        # Templates can be large; load only target key columns.\n        template = pd.read_csv(\n            template_path,\n            usecols=[\"timestamp\", \"station_id\", \"link_id\"],\n            dtype=str,\n        )\n        key_cols = [\"timestamp\", \"station_id\", \"link_id\"]\n        assert len(template) > 0, f\"Empty template: {template_path}\"\n        assert not template[key_cols].isna().any().any(), f\"Null template keys: {template_path}\"\n        assert not template.duplicated(key_cols).any(), f\"Duplicate template keys: {template_path}\"\n\n        expected_keys = set(map(tuple, template[key_cols].itertuples(index=False, name=None)))\n        masked_root = panel_dir / split / \"mainline_states_masked\"\n        assert masked_root.is_dir(), f\"Missing masked directory: {masked_root}\"\n\n        parquet_files = sorted(masked_root.glob(\"mask_regime=*/synthetic_mainline_*.parquet\"))\n        assert parquet_files, f\"No masked Parquet files: {masked_root}\"\n\n        actual_target_count = 0\n        matched_target_count = 0\n        covered_keys = set()\n        train_truth_count = 0\n\n        # Read all daily files in this panel/split. Target membership comes from\n        # the template, not from nulls alone; files are checked via their keys.\n        for fp in parquet_files:\n            cols = [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n            if split == \"train\":\n                cols += [\"is_score_eligible\"]\n            frame = pd.read_parquet(fp, columns=cols)\n            frame[\"timestamp\"] = frame[\"timestamp\"].astype(str)\n            frame[\"station_id\"] = frame[\"station_id\"].astype(str)\n            frame[\"link_id\"] = frame[\"link_id\"].astype(str)\n            keys = list(map(tuple, frame[key_cols].itertuples(index=False, name=None)))\n            is_target = np.fromiter((k in expected_keys for k in keys), dtype=bool, count=len(keys))\n            n_target_here = int(is_target.sum())\n            actual_target_count += n_target_here\n            if n_target_here:\n                found = set(k for k, flag in zip(keys, is_target) if flag)\n                covered_keys.update(found)\n                target_rows = frame.loc[is_target]\n                matched_target_count += len(target_rows)\n\n                # Target rows must be blank in the masked layer.\n                bad_nonblank = target_rows[\"speed_kmh\"].notna() | target_rows[\"flow_vph\"].notna()\n                if bad_nonblank.any():\n                    raise AssertionError(\n                        f\"{panel}/{split}: template target is not blank in {fp.name}\"\n                    )\n\n                if split == \"train\":\n                    if \"is_score_eligible\" not in target_rows.columns:\n                        raise AssertionError(\"Training labels are missing is_score_eligible\")\n                    eligible = target_rows[\"is_score_eligible\"].astype(bool)\n                    if not eligible.all():\n                        raise AssertionError(\n                            f\"{panel}/train: template includes ineligible target rows in {fp.name}\"\n                        )\n\n        # Every template key should appear in exactly one masked partition.\n        assert len(covered_keys) == len(expected_keys), (\n            f\"{panel}/{split}: template keys covered {len(covered_keys):,}/\"\n            f\"{len(expected_keys):,}\"\n        )\n        assert actual_target_count == len(expected_keys), (\n            f\"{panel}/{split}: template key count {len(expected_keys):,} != \"\n            f\"partition matches {actual_target_count:,}; possible duplicate keys across files\"\n        )\n\n        # For train only, the truth comes from the separate unmasked mainline_states\n        # layer. Verify a representative unmasked file is present and has labels.\n        if split == \"train\":\n            truth_files = sorted((panel_dir / \"train\" / \"mainline_states\").glob(\"**/*.parquet\"))\n            assert truth_files, f\"Missing unmasked training labels for {panel}\"\n            truth = pd.read_parquet(\n                truth_files[0],\n                columns=[\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\", \"pct_observed\"],\n            )\n            assert truth[\"speed_kmh\"].notna().any() and truth[\"flow_vph\"].notna().any(), (\n                f\"Unmasked training labels appear empty: {truth_files[0]}\"\n            )\n            train_sample_checked += 1\n\n        template_summary.append({\n            \"panel\": panel,\n            \"split\": split,\n            \"template_rows\": len(template),\n            \"masked_partitions\": len(parquet_files),\n            \"lane_metadata_rows\": len(lanes_df),\n        })\n\n        print(\n            f\"OK | {panel:12s} | {split:10s} | \"\n            f\"targets={len(template):,} | masked files={len(parquet_files)}\"\n        )\n\nsummary = pd.DataFrame(template_summary)\nsummary_path = Path(\"/kaggle/working/task1_integrity_summary.csv\")\nsummary.to_csv(summary_path, index=False)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"INTEGRITY CHECK PASSED\")\nprint(\"=\" * 80)\nprint(\"Template checks:\", len(summary), \"(expected 30)\")\nprint(\"Training panels with unmasked truth verified:\", train_sample_checked)\nprint(\"Total published target rows across 30 templates:\", f\"{summary.template_rows.sum():,}\")\nprint(\"Summary saved to:\", summary_path)\nprint(\"\\nThis validates target-key coverage and file structure; it does not yet evaluate prediction quality.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T06:00:19.971651Z","iopub.execute_input":"2026-10-19T06:00:19.972558Z","iopub.status.idle":"2026-10-19T06:07:10.981299Z","shell.execute_reply.started":"2026-10-19T06:00:19.972524Z","shell.execute_reply":"2026-10-19T06:07:10.980469Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\n# ============================================================\n# CONFIG\n# ============================================================\nROOT = Path(\"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\")\nPANEL = \"D7_I405_S\"\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\npanel_dir = ROOT / \"corridors\" / PANEL\ntruth_dir = panel_dir / \"train\" / \"mainline_states\"\ntemplate_path = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n# ============================================================\n# 1. Read the official Task 1 target keys\n# ============================================================\ntargets = pd.read_csv(\n    template_path,\n    usecols=KEYS,\n    dtype={\"station_id\": str, \"link_id\": str}\n)\ntargets[\"timestamp\"] = pd.to_datetime(targets[\"timestamp\"], utc=True)\ntargets = targets[targets[\"timestamp\"] >= HOLDOUT_START].copy()\ntargets = targets.drop_duplicates(KEYS)\n\ntarget_keys = targets.set_index(KEYS).index\nprint(f\"Panel: {PANEL}\")\nprint(f\"Holdout start: {HOLDOUT_START}\")\nprint(f\"Template holdout targets: {len(targets):,}\")\n\n# ============================================================\n# 2. Build historical profiles using ONLY pre-holdout truth\n#    Separate speed and flow counts; use pct_observed >= 75.\n# ============================================================\ndaily_aggregates = []\ntrain_files = sorted(truth_dir.glob(\"**/*.parquet\"))\nassert train_files, f\"No truth files found in {truth_dir}\"\n\nfor i, path in enumerate(train_files, 1):\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"link_id\", \"speed_kmh\",\n            \"flow_vph\", \"pct_observed\"\n        ]\n    )\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    df = df[df[\"timestamp\"] < HOLDOUT_START]\n\n    if df.empty:\n        continue\n\n    ts = df[\"timestamp\"]\n    df[\"slot\"] = (\n        ts.dt.dayofweek * 288\n        + ts.dt.hour * 12\n        + ts.dt.minute // 5\n    ).astype(\"int16\")\n\n    eligible = pd.to_numeric(\n        df[\"pct_observed\"], errors=\"coerce\"\n    ).ge(75)\n\n    speed = pd.to_numeric(df[\"speed_kmh\"], errors=\"coerce\")\n    flow = pd.to_numeric(df[\"flow_vph\"], errors=\"coerce\")\n\n    df[\"speed_sum\"] = speed.where(eligible & np.isfinite(speed), 0.0)\n    df[\"speed_n\"] = (eligible & np.isfinite(speed)).astype(\"int32\")\n    df[\"flow_sum\"] = flow.where(eligible & np.isfinite(flow), 0.0)\n    df[\"flow_n\"] = (eligible & np.isfinite(flow)).astype(\"int32\")\n\n    agg = df.groupby([\"link_id\", \"slot\"], observed=True).agg(\n        speed_sum=(\"speed_sum\", \"sum\"),\n        speed_n=(\"speed_n\", \"sum\"),\n        flow_sum=(\"flow_sum\", \"sum\"),\n        flow_n=(\"flow_n\", \"sum\"),\n    ).reset_index()\n\n    daily_aggregates.append(agg)\n\n    if i % 50 == 0:\n        print(f\"Processed {i}/{len(train_files)} truth files\")\n\nassert daily_aggregates, \"No pre-holdout data available.\"\n\nprofile = (\n    pd.concat(daily_aggregates, ignore_index=True)\n    .groupby([\"link_id\", \"slot\"], as_index=False)\n    .sum()\n)\n\nprofile[\"hist_speed\"] = (\n    profile[\"speed_sum\"] / profile[\"speed_n\"].replace(0, np.nan)\n)\nprofile[\"hist_flow\"] = (\n    profile[\"flow_sum\"] / profile[\"flow_n\"].replace(0, np.nan)\n)\n\n# Link-level fallbacks if a link/time-of-week slot has no valid history.\nlink_profile = profile.groupby(\"link_id\").agg(\n    link_speed_sum=(\"speed_sum\", \"sum\"),\n    link_speed_n=(\"speed_n\", \"sum\"),\n    link_flow_sum=(\"flow_sum\", \"sum\"),\n    link_flow_n=(\"flow_n\", \"sum\"),\n).reset_index()\n\nlink_profile[\"fallback_speed\"] = (\n    link_profile[\"link_speed_sum\"]\n    / link_profile[\"link_speed_n\"].replace(0, np.nan)\n)\nlink_profile[\"fallback_flow\"] = (\n    link_profile[\"link_flow_sum\"]\n    / link_profile[\"link_flow_n\"].replace(0, np.nan)\n)\n\nprofile = profile.merge(\n    link_profile[[\"link_id\", \"fallback_speed\", \"fallback_flow\"]],\n    on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nprint(f\"Historical link/slot profiles: {len(profile):,}\")\n\n# ============================================================\n# 3. Load lane counts\n# ============================================================\nlinks_path = panel_dir / \"network\" / \"links.csv\"\nlinks = pd.read_csv(links_path)\nlinks.columns = [c.strip() for c in links.columns]\n\nlink_col = next(\n    (c for c in links.columns if c.lower() == \"link_id\"), None\n)\nlane_col = next(\n    (c for c in links.columns\n     if c.lower() in {\"lanes\", \"lane_count\", \"num_lanes\", \"number_of_lanes\"}),\n    None\n)\n\nif link_col is None or lane_col is None:\n    raise ValueError(\n        \"Could not identify link_id/lane-count columns in links.csv. \"\n        f\"Available columns: {links.columns.tolist()}\"\n    )\n\nlinks[link_col] = links[link_col].astype(str)\nlinks[lane_col] = pd.to_numeric(links[lane_col], errors=\"coerce\")\nlane_map = (\n    links.dropna(subset=[lane_col])\n    .drop_duplicates(link_col)\n    .set_index(link_col)[lane_col]\n)\n\n# ============================================================\n# 4. Score the actual targets separately for R1, R2 and R3\n# ============================================================\nresults = []\n\nfor regime in REGIMES:\n    masked_dir = (\n        panel_dir / \"train\" / \"mainline_states_masked\"\n        / f\"mask_regime={regime}\"\n    )\n    masked_files = sorted(masked_dir.glob(\"*.parquet\"))\n    assert masked_files, f\"No masked files for {regime}\"\n\n    sq_speed = 0.0\n    sq_flow = 0.0\n    n_scored = 0\n    n_targets_found = 0\n\n    for masked_path in masked_files:\n        # Only score dates inside the chronological holdout.\n        day = pd.to_datetime(masked_path.stem.replace(\n            \"synthetic_mainline_\", \"\"\n        ), format=\"%Y_%m_%d\", utc=True)\n\n        if day < HOLDOUT_START:\n            continue\n\n        truth_path = truth_dir / masked_path.name\n        if not truth_path.exists():\n            matches = list(truth_dir.glob(f\"**/{masked_path.name}\"))\n            if not matches:\n                continue\n            truth_path = matches[0]\n\n        masked = pd.read_parquet(\n            masked_path,\n            columns=KEYS + [\"speed_kmh\", \"flow_vph\"]\n        )\n        masked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n        masked[\"station_id\"] = masked[\"station_id\"].astype(str)\n        masked[\"link_id\"] = masked[\"link_id\"].astype(str)\n\n        # Only cells blanked in BOTH scored channels are candidates.\n        blanked = masked[\n            masked[\"speed_kmh\"].isna() & masked[\"flow_vph\"].isna()\n        ][KEYS].drop_duplicates()\n\n        if blanked.empty:\n            continue\n\n        # Intersect with the official template so Task 2-only blanks\n        # are not incorrectly scored as Task 1 targets.\n        blanked = blanked.merge(\n            targets[KEYS], on=KEYS, how=\"inner\", validate=\"one_to_one\"\n        )\n        if blanked.empty:\n            continue\n\n        truth = pd.read_parquet(\n            truth_path,\n            columns=KEYS + [\n                \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n            ]\n        )\n        truth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\n        truth[\"station_id\"] = truth[\"station_id\"].astype(str)\n        truth[\"link_id\"] = truth[\"link_id\"].astype(str)\n\n        truth = truth[truth[\"is_score_eligible\"].astype(bool)]\n        truth = blanked.merge(\n            truth, on=KEYS, how=\"inner\", validate=\"one_to_one\"\n        )\n        if truth.empty:\n            continue\n\n        n_targets_found += len(truth)\n\n        ts = truth[\"timestamp\"]\n        truth[\"slot\"] = (\n            ts.dt.dayofweek * 288\n            + ts.dt.hour * 12\n            + ts.dt.minute // 5\n        ).astype(\"int16\")\n\n        scored = truth.merge(\n            profile[[\n                \"link_id\", \"slot\", \"hist_speed\", \"hist_flow\",\n                \"fallback_speed\", \"fallback_flow\"\n            ]],\n            on=[\"link_id\", \"slot\"],\n            how=\"left\",\n            validate=\"many_to_one\"\n        )\n\n        scored[\"pred_speed\"] = scored[\"hist_speed\"].fillna(\n            scored[\"fallback_speed\"]\n        )\n        scored[\"pred_flow\"] = scored[\"hist_flow\"].fillna(\n            scored[\"fallback_flow\"]\n        )\n\n        scored[\"lanes\"] = scored[\"link_id\"].map(lane_map)\n\n        true_speed = pd.to_numeric(\n            scored[\"speed_kmh\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        true_flow = pd.to_numeric(\n            scored[\"flow_vph\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        pred_speed = pd.to_numeric(\n            scored[\"pred_speed\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        pred_flow = pd.to_numeric(\n            scored[\"pred_flow\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n        lanes = pd.to_numeric(\n            scored[\"lanes\"], errors=\"coerce\"\n        ).to_numpy(dtype=float)\n\n        valid = (\n            np.isfinite(true_speed) & np.isfinite(true_flow)\n            & np.isfinite(pred_speed) & np.isfinite(pred_flow)\n            & np.isfinite(lanes) & (lanes > 0)\n        )\n        if not valid.any():\n            continue\n\n        ds = pred_speed[valid] - true_speed[valid]\n        dq = (pred_flow[valid] - true_flow[valid]) / lanes[valid]\n\n        sq_speed += float(np.sum(ds ** 2))\n        sq_flow += float(np.sum(dq ** 2))\n        n_scored += int(valid.sum())\n\n    if n_scored == 0:\n        raise ValueError(f\"No scoreable targets found for {regime}\")\n\n    rmse_speed = np.sqrt(sq_speed / n_scored)\n    rmse_flow = np.sqrt(sq_flow / n_scored)\n    s_speed = max(0.0, 1.0 - rmse_speed / 25.0)\n    s_flow = max(0.0, 1.0 - rmse_flow / 600.0)\n    s_state = 0.54 * s_speed + 0.46 * s_flow\n\n    results.append({\n        \"regime\": regime,\n        \"scored_targets\": n_scored,\n        \"eligible_targets_found\": n_targets_found,\n        \"speed_RMSE\": rmse_speed,\n        \"flow_RMSE_per_lane\": rmse_flow,\n        \"S_speed\": s_speed,\n        \"S_flow\": s_flow,\n        \"S_state\": s_state,\n    })\n\n    print(\n        f\"{regime}: n={n_scored:,} | \"\n        f\"speed RMSE={rmse_speed:.4f} | \"\n        f\"flow RMSE/lane={rmse_flow:.4f} | \"\n        f\"S_state={s_state:.6f}\"\n    )\n\n# Official-style regime macro-average for this panel/holdout.\nresult_df = pd.DataFrame(results)\nmacro_score = result_df[\"S_state\"].mean()\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"CHRONOLOGICAL BASELINE — REGIME-WISE\")\nprint(result_df.to_string(index=False, float_format=lambda x: f\"{x:.6f}\"))\nprint(f\"\\nRegime-macro S_state: {macro_score:.6f}\")\nprint(\"=\" * 60)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T07:47:49.527652Z","iopub.execute_input":"2026-10-19T07:47:49.528012Z","iopub.status.idle":"2026-10-19T07:48:17.028488Z","shell.execute_reply.started":"2026-10-19T07:47:49.527984Z","shell.execute_reply":"2026-10-19T07:48:17.027624Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\n\nwarnings.filterwarnings(\"ignore\", category=RuntimeWarning)\n\n# ============================================================\n# CONFIG\n# ============================================================\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nOUT = Path(\"/kaggle/working/trafficflow_eda_audit\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\nSPLITS = [\"train\", \"validation\", \"private\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTRAFFIC_COLS = [\n    \"speed_kmh\", \"flow_vph\", \"occupancy\",\n    \"density_occ_linear_vehpkm\", \"pct_observed\"\n]\nFLAG_COLS = [\n    \"is_score_eligible\", \"is_observed\",\n    \"is_imputed\", \"is_missing\"\n]\n\ndef safe_read_parquet(path, columns=None):\n    try:\n        return pd.read_parquet(path, columns=columns)\n    except Exception as exc:\n        print(f\"READ ERROR: {path.name}: {exc}\")\n        return None\n\ndef find_files(folder):\n    return sorted(folder.glob(\"**/*.parquet\")) if folder.exists() else []\n\ndef normalize_keys(df):\n    df = df.copy()\n    if \"timestamp\" in df:\n        df[\"timestamp\"] = pd.to_datetime(\n            df[\"timestamp\"], utc=True, errors=\"coerce\"\n        )\n    for col in [\"station_id\", \"link_id\"]:\n        if col in df:\n            df[col] = df[col].astype(str)\n    return df\n\ndef get_target_template(panel, split):\n    path = ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n    if not path.exists():\n        return None, path\n    try:\n        # Read only key columns to keep memory use down.\n        df = pd.read_csv(\n            path,\n            usecols=lambda c: c in KEYS,\n            dtype={\"station_id\": str, \"link_id\": str}\n        )\n        if not set(KEYS).issubset(df.columns):\n            return None, path\n        return normalize_keys(df), path\n    except Exception as exc:\n        print(f\"TEMPLATE ERROR: {path}: {exc}\")\n        return None, path\n\n# ============================================================\n# 1. FILE INVENTORY + SCHEMA\n# ============================================================\nprint(\"=\" * 78)\nprint(\"PHASE 1 — INVENTORY AND SCHEMA\")\nprint(\"=\" * 78)\n\ninventory_rows = []\nschema_rows = []\npanel_metadata_rows = []\n\nfor panel in PANELS:\n    pdir = ROOT / \"corridors\" / panel\n\n    # Network metadata\n    for filename in [\"links.csv\", \"fd_parameters.csv\"]:\n        path = pdir / \"network\" / filename\n        if path.exists():\n            try:\n                meta = pd.read_csv(path)\n                panel_metadata_rows.append({\n                    \"panel\": panel,\n                    \"file\": filename,\n                    \"rows\": len(meta),\n                    \"columns\": \"|\".join(meta.columns.astype(str)),\n                    \"duplicate_link_ids\": (\n                        int(meta[\"link_id\"].duplicated().sum())\n                        if \"link_id\" in meta else np.nan\n                    ),\n                    \"missing_cells\": int(meta.isna().sum().sum())\n                })\n            except Exception as exc:\n                panel_metadata_rows.append({\n                    \"panel\": panel, \"file\": filename, \"error\": str(exc)\n                })\n\n    for split in SPLITS:\n        for layer in [\"mainline_states\", \"mainline_states_masked\"]:\n            folder = pdir / split / layer\n            files = find_files(folder)\n            inventory_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"layer\": layer,\n                \"directory_exists\": folder.exists(),\n                \"file_count\": len(files),\n                \"first_file\": files[0].name if files else None,\n                \"last_file\": files[-1].name if files else None\n            })\n\n            if files:\n                sample = safe_read_parquet(files[0])\n                if sample is not None:\n                    schema_rows.append({\n                        \"panel\": panel,\n                        \"split\": split,\n                        \"layer\": layer,\n                        \"sample_file\": files[0].name,\n                        \"rows_in_sample\": len(sample),\n                        \"columns\": \"|\".join(sample.columns.astype(str)),\n                        \"missing_required_keys\": \"|\".join(\n                            sorted(set(KEYS) - set(sample.columns))\n                        ),\n                        \"missingness_columns_present\": \"|\".join(\n                            c for c in TRAFFIC_COLS + FLAG_COLS\n                            if c in sample.columns\n                        )\n                    })\n\ninventory_df = pd.DataFrame(inventory_rows)\nschema_df = pd.DataFrame(schema_rows)\nmetadata_df = pd.DataFrame(panel_metadata_rows)\n\ninventory_df.to_csv(OUT / \"01_file_inventory.csv\", index=False)\nschema_df.to_csv(OUT / \"02_schema_audit.csv\", index=False)\nmetadata_df.to_csv(OUT / \"03_network_metadata.csv\", index=False)\n\nprint(inventory_df.to_string(index=False))\nprint(\"\\nSchema samples:\")\nprint(schema_df.to_string(index=False))\nprint(\"\\nReports saved:\", OUT)\n\n# ============================================================\n# 2. MASKING AUDIT\n#    Inspect ALL masked files, not just selected dates.\n#    Count blank cells, flags, template matches and key coverage.\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"PHASE 2 — MASKING AND TEMPLATE AUDIT\")\nprint(\"=\" * 78)\n\nmask_file_rows = []\nmask_group_rows = []\ntemplate_rows = []\ntruth_rows = []\n\nfor panel in PANELS:\n    pdir = ROOT / \"corridors\" / panel\n    print(f\"\\nAuditing panel: {panel}\")\n\n    for split in SPLITS:\n        template, template_path = get_target_template(panel, split)\n\n        template_keys = None\n        if template is not None:\n            template = template.drop_duplicates(KEYS)\n            template_keys = pd.MultiIndex.from_frame(template[KEYS])\n\n            template_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"template_exists\": True,\n                \"template_path\": str(template_path),\n                \"template_unique_keys\": len(template),\n                \"template_duplicate_keys\": 0,\n                \"template_min_timestamp\": template.timestamp.min(),\n                \"template_max_timestamp\": template.timestamp.max()\n            })\n        else:\n            template_rows.append({\n                \"panel\": panel,\n                \"split\": split,\n                \"template_exists\": False,\n                \"template_path\": str(template_path),\n                \"template_unique_keys\": 0,\n                \"template_duplicate_keys\": np.nan,\n                \"template_min_timestamp\": None,\n                \"template_max_timestamp\": None\n            })\n\n        # Truth files: training should have unmasked truth.\n        truth_dir = pdir / split / \"mainline_states\"\n        truth_files = find_files(truth_dir)\n\n        truth_key_count = 0\n        truth_eligible_count = 0\n        truth_duplicate_count = 0\n        truth_speed_null = 0\n        truth_flow_null = 0\n        truth_rows_total = 0\n        truth_key_set = set()\n\n        # Full truth audit is most important on train.\n        if split == \"train\":\n            for tf in truth_files:\n                t = safe_read_parquet(tf)\n                if t is None:\n                    continue\n                truth_rows_total += len(t)\n\n                if \"speed_kmh\" in t:\n                    truth_speed_null += int(t.speed_kmh.isna().sum())\n                if \"flow_vph\" in t:\n                    truth_flow_null += int(t.flow_vph.isna().sum())\n                if \"is_score_eligible\" in t:\n                    truth_eligible_count += int(\n                        t[\"is_score_eligible\"].fillna(False).astype(bool).sum()\n                    )\n\n                if set(KEYS).issubset(t.columns):\n                    t = normalize_keys(t)\n                    truth_duplicate_count += int(t.duplicated(KEYS).sum())\n                    truth_key_count += len(t)\n\n                    # Used to check template keys against truth coverage.\n                    # Keep normalized key tuples for accurate membership checks.\n                    truth_key_set.update(\n                        zip(t.timestamp, t.station_id, t.link_id)\n                    )\n\n        truth_rows.append({\n            \"panel\": panel,\n            \"split\": split,\n            \"truth_files\": len(truth_files),\n            \"truth_rows\": truth_rows_total,\n            \"truth_key_rows\": truth_key_count,\n            \"truth_duplicate_keys\": truth_duplicate_count,\n            \"truth_eligible_rows\": truth_eligible_count,\n            \"truth_speed_nulls\": truth_speed_null,\n            \"truth_flow_nulls\": truth_flow_null,\n            \"truth_unique_keys_in_memory\": len(truth_key_set)\n        })\n\n        masked_root = pdir / split / \"mainline_states_masked\"\n        total_files = 0\n        total_rows = 0\n        total_speed_null = 0\n        total_flow_null = 0\n        total_both_null = 0\n        total_speed_only_null = 0\n        total_flow_only_null = 0\n        total_is_missing_true = 0\n        total_is_observed_false = 0\n        total_is_imputed_true = 0\n        total_eligible_true = 0\n        total_template_matches = 0\n        total_template_matches_both_null = 0\n        total_key_duplicates = 0\n        total_key_missing = 0\n        total_template_truth_matches = 0\n\n        for regime in REGIMES:\n            folder = masked_root / f\"mask_regime={regime}\"\n            files = find_files(folder)\n\n            group = {\n                \"panel\": panel,\n                \"split\": split,\n                \"regime\": regime,\n                \"files\": len(files),\n                \"rows\": 0,\n                \"speed_nulls\": 0,\n                \"flow_nulls\": 0,\n                \"both_null\": 0,\n                \"speed_only_null\": 0,\n                \"flow_only_null\": 0,\n                \"is_missing_true\": 0,\n                \"is_observed_false\": 0,\n                \"is_imputed_true\": 0,\n                \"eligible_true\": 0,\n                \"template_matches\": 0,\n                \"template_matches_both_null\": 0,\n                \"duplicate_keys\": 0,\n                \"missing_key_rows\": 0\n            }\n\n            for fi, path in enumerate(files, 1):\n                df = safe_read_parquet(path)\n                if df is None:\n                    continue\n\n                total_files += 1\n                n = len(df)\n                total_rows += n\n                group[\"rows\"] += n\n\n                for col in KEYS:\n                    if col not in df.columns:\n                        raise ValueError(\n                            f\"Missing key {col} in {path}\"\n                        )\n\n                df = normalize_keys(df)\n                key_missing = df[KEYS].isna().any(axis=1)\n                dup = df.duplicated(KEYS)\n                group[\"duplicate_keys\"] += int(dup.sum())\n                group[\"missing_key_rows\"] += int(key_missing.sum())\n                total_key_duplicates += int(dup.sum())\n                total_key_missing += int(key_missing.sum())\n\n                has_speed = \"speed_kmh\" in df.columns\n                has_flow = \"flow_vph\" in df.columns\n                speed_null = (\n                    df[\"speed_kmh\"].isna()\n                    if has_speed else pd.Series(False, index=df.index)\n                )\n                flow_null = (\n                    df[\"flow_vph\"].isna()\n                    if has_flow else pd.Series(False, index=df.index)\n                )\n\n                both_null = speed_null & flow_null\n                speed_only = speed_null & ~flow_null\n                flow_only = flow_null & ~speed_null\n\n                group[\"speed_nulls\"] += int(speed_null.sum())\n                group[\"flow_nulls\"] += int(flow_null.sum())\n                group[\"both_null\"] += int(both_null.sum())\n                group[\"speed_only_null\"] += int(speed_only.sum())\n                group[\"flow_only_null\"] += int(flow_only.sum())\n\n                total_speed_null += int(speed_null.sum())\n                total_flow_null += int(flow_null.sum())\n                total_both_null += int(both_null.sum())\n                total_speed_only_null += int(speed_only.sum())\n                total_flow_only_null += int(flow_only.sum())\n\n                if \"is_missing\" in df:\n                    count = int(df[\"is_missing\"].fillna(False).astype(bool).sum())\n                    group[\"is_missing_true\"] += count\n                    total_is_missing_true += count\n\n                if \"is_observed\" in df:\n                    count = int((~df[\"is_observed\"].fillna(True).astype(bool)).sum())\n                    group[\"is_observed_false\"] += count\n                    total_is_observed_false += count\n\n                if \"is_imputed\" in df:\n                    count = int(df[\"is_imputed\"].fillna(False).astype(bool).sum())\n                    group[\"is_imputed_true\"] += count\n                    total_is_imputed_true += count\n\n                if \"is_score_eligible\" in df:\n                    count = int(df[\"is_score_eligible\"].fillna(False).astype(bool).sum())\n                    group[\"eligible_true\"] += count\n                    total_eligible_true += count\n\n                # Match template keys by exact timestamp/station/link.\n                # This does NOT assume target cells must be null.\n                template_matches = 0\n                template_matches_both_null = 0\n\n                if template_keys is not None and len(template_keys):\n                    keys_idx = pd.MultiIndex.from_frame(df[KEYS])\n                    in_template = keys_idx.isin(template_keys)\n                    template_matches = int(in_template.sum())\n                    template_matches_both_null = int(\n                        (in_template & both_null.to_numpy()).sum()\n                    )\n\n                    group[\"template_matches\"] += template_matches\n                    group[\"template_matches_both_null\"] += template_matches_both_null\n                    total_template_matches += template_matches\n                    total_template_matches_both_null += template_matches_both_null\n\n                # Keep file-level details for identifying the exact failure.\n                mask_file_rows.append({\n                    \"panel\": panel,\n                    \"split\": split,\n                    \"regime\": regime,\n                    \"file\": path.name,\n                    \"rows\": n,\n                    \"min_timestamp\": df[\"timestamp\"].min(),\n                    \"max_timestamp\": df[\"timestamp\"].max(),\n                    \"speed_nulls\": int(speed_null.sum()),\n                    \"flow_nulls\": int(flow_null.sum()),\n                    \"both_null\": int(both_null.sum()),\n                    \"speed_only_null\": int(speed_only.sum()),\n                    \"flow_only_null\": int(flow_only.sum()),\n                    \"is_missing_true\": (\n                        int(df[\"is_missing\"].fillna(False).astype(bool).sum())\n                        if \"is_missing\" in df else np.nan\n                    ),\n                    \"is_observed_false\": (\n                        int((~df[\"is_observed\"].fillna(True).astype(bool)).sum())\n                        if \"is_observed\" in df else np.nan\n                    ),\n                    \"is_imputed_true\": (\n                        int(df[\"is_imputed\"].fillna(False).astype(bool).sum())\n                        if \"is_imputed\" in df else np.nan\n                    ),\n                    \"template_key_matches\": template_matches,\n                    \"template_matches_both_null\": template_matches_both_null,\n                    \"duplicate_keys\": int(dup.sum()),\n                    \"missing_key_rows\": int(key_missing.sum()),\n                    \"columns\": \"|\".join(df.columns.astype(str))\n                })\n\n            mask_group_rows.append(group)\n\n        print(\n            f\"  {split}: template keys=\"\n            f\"{len(template_keys) if template_keys is not None else 'MISSING'}, \"\n            f\"masked rows={total_rows:,}, both-null={total_both_null:,}, \"\n            f\"template key matches={total_template_matches:,}, \"\n            f\"matches also both-null={total_template_matches_both_null:,}\"\n        )\n\n# ============================================================\n# 3. TRAFFIC DISTRIBUTIONS AND FLAG RELATIONSHIPS\n#    Aggregate descriptive statistics over all training truth.\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"PHASE 3 — TRAINING TRAFFIC DISTRIBUTIONS\")\nprint(\"=\" * 78)\n\ntraffic_rows = []\nflag_rows = []\ntemporal_rows = []\n\nfor panel in PANELS:\n    truth_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n    files = find_files(truth_dir)\n\n    # Stream one file at a time; avoid loading the whole panel.\n    for path in files:\n        df = safe_read_parquet(path)\n        if df is None:\n            continue\n\n        if \"timestamp\" in df:\n            df[\"timestamp\"] = pd.to_datetime(\n                df[\"timestamp\"], utc=True, errors=\"coerce\"\n            )\n\n        for col in TRAFFIC_COLS:\n            if col not in df.columns:\n                continue\n\n            x = pd.to_numeric(df[col], errors=\"coerce\")\n            finite = x[np.isfinite(x)]\n\n            if len(finite):\n                traffic_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"feature\": col,\n                    \"n_rows\": len(df),\n                    \"n_non_null_finite\": len(finite),\n                    \"null_or_nonfinite\": len(df) - len(finite),\n                    \"mean\": finite.mean(),\n                    \"std\": finite.std(),\n                    \"min\": finite.min(),\n                    \"p01\": finite.quantile(0.01),\n                    \"p05\": finite.quantile(0.05),\n                    \"median\": finite.median(),\n                    \"p95\": finite.quantile(0.95),\n                    \"p99\": finite.quantile(0.99),\n                    \"max\": finite.max()\n                })\n\n        # Compare missingness and eligibility flags.\n        flag_subset = [c for c in FLAG_COLS if c in df.columns]\n        if flag_subset:\n            flags = {}\n            for col in flag_subset:\n                flags[col] = (\n                    df[col].fillna(False).astype(bool)\n                    if col in [\"is_score_eligible\", \"is_observed\",\n                               \"is_imputed\", \"is_missing\"]\n                    else df[col]\n                )\n            if \"is_missing\" in flags and \"is_observed\" in flags:\n                flag_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"rows\": len(df),\n                    \"is_missing_true\": int(flags[\"is_missing\"].sum()),\n                    \"is_observed_true\": int(flags[\"is_observed\"].sum()),\n                    \"is_imputed_true\": (\n                        int(flags[\"is_imputed\"].sum())\n                        if \"is_imputed\" in flags else np.nan\n                    ),\n                    \"eligible_true\": (\n                        int(flags[\"is_score_eligible\"].sum())\n                        if \"is_score_eligible\" in flags else np.nan\n                    ),\n                    \"missing_and_observed\": int(\n                        (flags[\"is_missing\"] & flags[\"is_observed\"]).sum()\n                    ),\n                    \"missing_and_imputed\": (\n                        int((flags[\"is_missing\"] & flags[\"is_imputed\"]).sum())\n                        if \"is_imputed\" in flags else np.nan\n                    )\n                })\n\n        if \"timestamp\" in df:\n            ts = df[\"timestamp\"].dropna()\n            if len(ts):\n                temporal_rows.append({\n                    \"panel\": panel,\n                    \"file\": path.name,\n                    \"rows\": len(df),\n                    \"min_timestamp\": ts.min(),\n                    \"max_timestamp\": ts.max(),\n                    \"unique_timestamps\": ts.nunique(),\n                    \"weekdays_present\": ts.dt.dayofweek.nunique(),\n                    \"hours_present\": ts.dt.hour.nunique(),\n                    \"minute_values\": \"|\".join(\n                        map(str, sorted(ts.dt.minute.unique().tolist()))\n                    )\n                })\n\n    print(f\"  Finished traffic summaries: {panel}\")\n\n# ============================================================\n# 4. SAVE REPORTS\n# ============================================================\nmask_files_df = pd.DataFrame(mask_file_rows)\nmask_groups_df = pd.DataFrame(mask_group_rows)\ntemplates_df = pd.DataFrame(template_rows)\ntruth_df = pd.DataFrame(truth_rows)\ntraffic_df = pd.DataFrame(traffic_rows)\nflags_df = pd.DataFrame(flag_rows)\ntemporal_df = pd.DataFrame(temporal_rows)\n\nreports = {\n    \"04_mask_file_details.csv\": mask_files_df,\n    \"05_mask_group_summary.csv\": mask_groups_df,\n    \"06_template_audit.csv\": templates_df,\n    \"07_truth_audit.csv\": truth_df,\n    \"08_traffic_statistics.csv\": traffic_df,\n    \"09_flag_consistency.csv\": flags_df,\n    \"10_temporal_audit.csv\": temporal_df,\n}\n\nfor filename, frame in reports.items():\n    frame.to_csv(OUT / filename, index=False)\n\n# ============================================================\n# 5. PRINT HIGH-VALUE FINDINGS\n# ============================================================\nprint(\"\\n\" + \"=\" * 78)\nprint(\"AUDIT FINDINGS\")\nprint(\"=\" * 78)\n\nprint(\"\\nMASK SUMMARY:\")\nif not mask_groups_df.empty:\n    cols = [\n        \"panel\", \"split\", \"regime\", \"files\", \"rows\",\n        \"speed_nulls\", \"flow_nulls\", \"both_null\",\n        \"is_missing_true\", \"is_observed_false\",\n        \"template_matches\", \"template_matches_both_null\",\n        \"duplicate_keys\", \"missing_key_rows\"\n    ]\n    print(mask_groups_df[cols].to_string(index=False))\n\nprint(\"\\nTEMPLATE SUMMARY:\")\nprint(templates_df.to_string(index=False))\n\nprint(\"\\nTRAIN TRUTH SUMMARY:\")\nprint(truth_df.to_string(index=False))\n\nprint(\"\\nTRAFFIC STATISTICS (combined by panel and feature):\")\nif not traffic_df.empty:\n    print(\n        traffic_df.groupby([\"panel\", \"feature\"], as_index=False).agg(\n            rows=(\"n_rows\", \"sum\"),\n            non_null=(\"n_non_null_finite\", \"sum\"),\n            mean_of_file_means=(\"mean\", \"mean\"),\n            min=(\"min\", \"min\"),\n            median_of_file_medians=(\"median\", \"median\"),\n            max=(\"max\", \"max\")\n        ).to_string(index=False)\n    )\n\nprint(\"\\nFlag consistency summary:\")\nif not flags_df.empty:\n    print(\n        flags_df.groupby(\"panel\", as_index=False).agg(\n            rows=(\"rows\", \"sum\"),\n            missing_true=(\"is_missing_true\", \"sum\"),\n            observed_true=(\"is_observed_true\", \"sum\"),\n            imputed_true=(\"is_imputed_true\", \"sum\"),\n            eligible_true=(\"eligible_true\", \"sum\"),\n            missing_and_observed=(\"missing_and_observed\", \"sum\")\n        ).to_string(index=False)\n    )\n\n# Make the output location and report list explicit.\nmanifest = {\n    \"root\": str(ROOT),\n    \"output_directory\": str(OUT),\n    \"panels\": PANELS,\n    \"splits\": SPLITS,\n    \"regimes\": REGIMES,\n    \"reports\": list(reports.keys()),\n    \"warning\": (\n        \"File-level traffic means are descriptive only; use weighted \"\n        \"row-level aggregates for model decisions. No files were modified.\"\n    )\n}\n(OUT / \"audit_manifest.json\").write_text(\n    json.dumps(manifest, indent=2), encoding=\"utf-8\"\n)\n\nprint(\"\\n\" + \"=\" * 78)\nprint(\"EDA AND MASKING AUDIT FINISHED\")\nprint(\"Reports directory:\", OUT)\nfor filename in list(reports.keys()) + [\"audit_manifest.json\"]:\n    print(\" -\", filename)\nprint(\"=\" * 78)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T08:08:05.421305Z","iopub.execute_input":"2026-10-19T08:08:05.42169Z","iopub.status.idle":"2026-10-19T08:28:51.73668Z","shell.execute_reply.started":"2026-10-19T08:08:05.421661Z","shell.execute_reply":"2026-10-19T08:28:51.735781Z"},"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\n# ============================================================\n# TASK 1 — HISTORICAL PROFILE BASELINE EVALUATION\n# Panel: D7_I405_S | Holdout: February 2031\n# ============================================================\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nSTART = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nEND = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\n# ------------------------------------------------------------\n# 1. Load official holdout targets\n# ------------------------------------------------------------\ntemplate_path = (\n    ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n)\n\ntemplate = pd.read_csv(\n    template_path,\n    usecols=KEYS,\n    dtype={\"station_id\": str, \"link_id\": str},\n)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n\ntemplate = template.loc[\n    (template[\"timestamp\"] >= START)\n    & (template[\"timestamp\"] < END)\n].drop_duplicates(KEYS).reset_index(drop=True)\n\nassert len(template) == 235_491, (\n    f\"Unexpected holdout target count: {len(template):,}\"\n)\n\nprint(f\"Official February targets: {len(template):,}\")\n\n# ------------------------------------------------------------\n# 2. Load historical truth, excluding the holdout period\n# ------------------------------------------------------------\ntruth_dir = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\n\nhistory_files = sorted(truth_dir.rglob(\"*.parquet\"))\nif not history_files:\n    raise RuntimeError(f\"No truth files found under {truth_dir}\")\n\nPROFILE_COLS = KEYS + [\n    \"speed_kmh\", \"flow_vph\", \"pct_observed\"\n]\n\nhistory_parts = []\n\nfor path in history_files:\n    # The filename gives the date; only use dates before the holdout.\n    date_text = path.stem.replace(\"synthetic_mainline_\", \"\")\n    file_date = pd.to_datetime(\n        date_text, format=\"%Y_%m_%d\", errors=\"coerce\"\n    )\n\n    if pd.isna(file_date) or file_date >= START.tz_localize(None):\n        continue\n\n    df = pd.read_parquet(path, columns=PROFILE_COLS)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(str)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    history_parts.append(df)\n\nif not history_parts:\n    raise RuntimeError(\"No historical files found before the holdout.\")\n\nhistory = pd.concat(history_parts, ignore_index=True)\n\n# Use reliable observed historical records only.\nhistory = history.loc[\n    (history[\"pct_observed\"] >= 75)\n    & history[\"speed_kmh\"].notna()\n    & history[\"flow_vph\"].notna()\n].copy()\n\n# Monday=0 ... Sunday=6; 288 five-minute slots per day.\nhistory[\"slot\"] = (\n    history[\"timestamp\"].dt.dayofweek * 288\n    + history[\"timestamp\"].dt.hour * 12\n    + history[\"timestamp\"].dt.minute // 5\n).astype(\"int16\")\n\ntemplate[\"slot\"] = (\n    template[\"timestamp\"].dt.dayofweek * 288\n    + template[\"timestamp\"].dt.hour * 12\n    + template[\"timestamp\"].dt.minute // 5\n).astype(\"int16\")\n\n# Profile A: link + weekday/time slot.\nprofile = (\n    history.groupby([\"link_id\", \"slot\"], observed=True)[\n        [\"speed_kmh\", \"flow_vph\"]\n    ]\n    .mean()\n    .reset_index()\n)\n\n# Profile B: link-level fallback when a slot profile is unavailable.\nlink_profile = (\n    history.groupby(\"link_id\", observed=True)[\n        [\"speed_kmh\", \"flow_vph\"]\n    ]\n    .mean()\n    .reset_index()\n)\n\nprint(f\"Historical records used: {len(history):,}\")\nprint(f\"Link/slot profiles: {len(profile):,}\")\nprint(f\"Link fallback profiles: {len(link_profile):,}\")\n\n# ------------------------------------------------------------\n# 3. Load February ground truth\n# ------------------------------------------------------------\ntruth_parts = []\n\nfor path in sorted(truth_dir.rglob(\"synthetic_mainline_2031_02_*.parquet\")):\n    df = pd.read_parquet(\n        path,\n        columns=KEYS + [\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ],\n    )\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(str)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    truth_parts.append(df)\n\nif not truth_parts:\n    raise RuntimeError(\"No February ground-truth files found.\")\n\ntruth = pd.concat(truth_parts, ignore_index=True)\n\nif truth.duplicated(KEYS).any():\n    raise RuntimeError(\"Duplicate ground-truth keys found.\")\n\n# ------------------------------------------------------------\n# 4. Load link lane counts\n# ------------------------------------------------------------\nlinks_path = ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\nlinks = pd.read_csv(links_path, dtype={\"link_id\": str})\n\nif not {\"link_id\", \"lanes\"}.issubset(links.columns):\n    raise RuntimeError(\n        f\"Expected link_id and lanes in {links_path}; \"\n        f\"found columns: {links.columns.tolist()}\"\n    )\n\nlinks = links[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nif links[\"lanes\"].isna().any() or (links[\"lanes\"] <= 0).any():\n    raise RuntimeError(\"Missing or invalid lane counts in links.csv.\")\n\n# ------------------------------------------------------------\n# 5. Evaluate each regime independently\n# ------------------------------------------------------------\nresults = []\n\nfor regime in REGIMES:\n    print(f\"\\nEvaluating {regime}...\")\n\n    mask_dir = (\n        ROOT / \"corridors\" / PANEL / \"train\"\n        / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n    )\n\n    mask_files = sorted(\n        mask_dir.glob(\"synthetic_mainline_2031_02_*.parquet\")\n    )\n    if not mask_files:\n        raise RuntimeError(f\"No February masked files found for {regime}\")\n\n    regime_parts = []\n\n    for path in mask_files:\n        df = pd.read_parquet(\n            path, columns=KEYS + [\"speed_kmh\", \"flow_vph\"]\n        )\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df[\"station_id\"] = df[\"station_id\"].astype(str)\n        df[\"link_id\"] = df[\"link_id\"].astype(str)\n\n        # Official targets must be template keys with both values masked.\n        target_match = pd.MultiIndex.from_frame(df[KEYS]).isin(\n            pd.MultiIndex.from_frame(template[KEYS])\n        )\n        both_null = df[\"speed_kmh\"].isna() & df[\"flow_vph\"].isna()\n\n        selected = df.loc[target_match & both_null, KEYS]\n        if not selected.empty:\n            regime_parts.append(selected)\n\n    if not regime_parts:\n        raise RuntimeError(f\"No targets found for {regime}\")\n\n    targets = pd.concat(regime_parts, ignore_index=True).drop_duplicates(KEYS)\n\n    # Enforce the verified regime counts.\n    expected_counts = {\n        \"R1\": 19_157,\n        \"R2\": 108_110,\n        \"R3\": 108_224,\n    }\n    assert len(targets) == expected_counts[regime], (\n        f\"{regime}: expected {expected_counts[regime]:,} targets, \"\n        f\"found {len(targets):,}\"\n    )\n\n    # Join ground truth using the full official key.\n    scored = targets.merge(\n        truth[KEYS + [\"speed_kmh\", \"flow_vph\", \"is_score_eligible\"]],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    eligible = scored[\"is_score_eligible\"].fillna(False).astype(bool)\n    if not eligible.all():\n        raise RuntimeError(\n            f\"{regime}: {int((~eligible).sum()):,} targets lack eligible truth.\"\n        )\n\n    if scored[[\"speed_kmh\", \"flow_vph\"]].isna().any().any():\n        raise RuntimeError(f\"{regime}: missing ground truth after join.\")\n\n    # Join historical link/slot profile.\n    scored[\"slot\"] = (\n        scored[\"timestamp\"].dt.dayofweek * 288\n        + scored[\"timestamp\"].dt.hour * 12\n        + scored[\"timestamp\"].dt.minute // 5\n    ).astype(\"int16\")\n\n    scored = scored.merge(\n        profile.rename(columns={\n            \"speed_kmh\": \"pred_speed_profile\",\n            \"flow_vph\": \"pred_flow_profile\",\n        }),\n        on=[\"link_id\", \"slot\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    # Fall back to link-level historical averages.\n    scored = scored.merge(\n        link_profile.rename(columns={\n            \"speed_kmh\": \"pred_speed_link\",\n            \"flow_vph\": \"pred_flow_link\",\n        }),\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    scored[\"pred_speed\"] = scored[\"pred_speed_profile\"].fillna(\n        scored[\"pred_speed_link\"]\n    )\n    scored[\"pred_flow\"] = scored[\"pred_flow_profile\"].fillna(\n        scored[\"pred_flow_link\"]\n    )\n\n    if scored[[\"pred_speed\", \"pred_flow\"]].isna().any().any():\n        missing = int(\n            scored[[\"pred_speed\", \"pred_flow\"]].isna().any(axis=1).sum()\n        )\n        raise RuntimeError(\n            f\"{regime}: {missing:,} targets have no historical profile \"\n            \"or link-level fallback.\"\n        )\n\n    # Flow metric is evaluated per lane.\n    scored = scored.merge(\n        links, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    if scored[\"lanes\"].isna().any():\n        raise RuntimeError(f\"{regime}: missing lane counts for target links.\")\n\n    speed_rmse = np.sqrt(\n        np.mean(\n            (scored[\"pred_speed\"] - scored[\"speed_kmh\"]) ** 2\n        )\n    )\n\n    flow_per_lane_rmse = np.sqrt(\n        np.mean(\n            (\n                scored[\"pred_flow\"] / scored[\"lanes\"]\n                - scored[\"flow_vph\"] / scored[\"lanes\"]\n            ) ** 2\n        )\n    )\n\n    speed_score = max(0.0, 1.0 - speed_rmse / 25.0)\n    flow_score = max(0.0, 1.0 - flow_per_lane_rmse / 600.0)\n    state_score = 0.54 * speed_score + 0.46 * flow_score\n\n    results.append({\n        \"regime\": regime,\n        \"targets\": len(scored),\n        \"speed_RMSE\": speed_rmse,\n        \"flow_RMSE_per_lane\": flow_per_lane_rmse,\n        \"speed_score\": speed_score,\n        \"flow_score\": flow_score,\n        \"state_score\": state_score,\n    })\n\n    print(f\"Targets: {len(scored):,}\")\n    print(f\"Speed RMSE: {speed_rmse:.4f}\")\n    print(f\"Flow RMSE/lane: {flow_per_lane_rmse:.4f}\")\n    print(f\"State score: {state_score:.6f}\")\n\n# ------------------------------------------------------------\n# 6. Macro-average score\n# ------------------------------------------------------------\nresults_df = pd.DataFrame(results)\n\nprint(\"\\n========== BASELINE SUMMARY ==========\")\nprint(results_df.to_string(index=False, float_format=lambda x: f\"{x:.6f}\"))\n\nmacro_score = results_df[\"state_score\"].mean()\nprint(f\"\\nMacro-average state score: {macro_score:.6f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T09:02:37.656636Z","iopub.execute_input":"2026-10-19T09:02:37.657672Z","iopub.status.idle":"2026-10-19T09:02:54.748993Z","shell.execute_reply.started":"2026-10-19T09:02:37.657635Z","shell.execute_reply":"2026-10-19T09:02:54.748209Z"},"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D7_I405_S\"\n\nprint(\"=\" * 75)\nprint(\"TRAFFIC FLOW BENCH — DATASET STRUCTURE AUDIT\")\nprint(\"=\" * 75)\n\nif not ROOT.exists():\n    raise FileNotFoundError(f\"Competition dataset root not found: {ROOT}\")\n\nprint(\"\\nRoot directory:\", ROOT)\n\n# 1. Top-level dataset structure\nprint(\"\\n1. TOP-LEVEL DIRECTORIES\")\nfor path in sorted(ROOT.iterdir()):\n    kind = \"DIR \" if path.is_dir() else \"FILE\"\n    print(f\"{kind} {path.name}\")\n\n# 2. Panel-specific directories\nprint(\"\\n2. PANEL DIRECTORIES\")\nfor relative in [\n    f\"corridors/{PANEL}/train\",\n    f\"task1/{PANEL}\",\n]:\n    directory = ROOT / relative\n    print(f\"\\n{relative}\")\n\n    if not directory.exists():\n        print(\"  NOT FOUND\")\n        continue\n\n    for path in sorted(directory.iterdir())[:30]:\n        print(\" \", path.name)\n\n# 3. Inspect actual parquet paths and schemas\nprint(\"\\n3. MAINLINE TRUTH FILES\")\ntruth_dir = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\ntruth_files = sorted(truth_dir.rglob(\"*.parquet\"))\n\nprint(\"Truth parquet count:\", len(truth_files))\n\nfor path in truth_files[:3]:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_parquet(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n\n    for col in [\"date\", \"timestamp\"]:\n        if col in df.columns:\n            values = pd.to_datetime(df[col], errors=\"coerce\", utc=True)\n            print(\n                f\"{col}: dtype={df[col].dtype}, \"\n                f\"min={values.min()}, max={values.max()}\"\n            )\n\n# 4. Inspect actual masked inputs\nprint(\"\\n4. MASKED INPUT FILES\")\nmasked_dir = (\n    ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\n)\nmasked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\nprint(\"Masked parquet count:\", len(masked_files))\n\nfor path in masked_files[:3]:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_parquet(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n\n# 5. Inspect Task 1 templates\nprint(\"\\n5. TASK 1 TEMPLATES\")\ntask_dir = ROOT / \"task1\" / PANEL\ntemplates = sorted(task_dir.rglob(\"sample_submission_state.csv\"))\n\nprint(\"Template count:\", len(templates))\n\nfor path in templates:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_csv(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n    print(df.head(3).to_string(index=False))\n\n# 6. Inspect network metadata\nprint(\"\\n6. NETWORK METADATA\")\nfor name in [\n    \"links.csv\",\n    \"fd_parameters.csv\",\n    \"lwr_mainline_topology.csv\",\n]:\n    path = ROOT / \"corridors\" / PANEL / name\n\n    if path.exists():\n        df = pd.read_csv(path)\n        print(f\"\\n{name}: shape={df.shape}\")\n        print(\"Columns:\", df.columns.tolist())\n        print(df.head(3).to_string(index=False))\n    else:\n        print(f\"\\n{name}: not found at expected path\")\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"AUDIT COMPLETE — NO MODEL TRAINED\")\nprint(\"=\" * 75)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T12:46:16.468662Z","iopub.execute_input":"2026-10-19T12:46:16.469052Z","iopub.status.idle":"2026-10-19T12:46:19.32012Z","shell.execute_reply.started":"2026-10-19T12:46:16.46902Z","shell.execute_reply":"2026-10-19T12:46:19.319133Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# ============================================================\n# TASK 1 — REBUILD HISTORICAL-PROFILE BASELINE\n# D7_I405_S | February 2031 chronological holdout\n# ============================================================\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\nSTART = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nEND = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nTRUTH_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\nMASKED_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\nTEMPLATE_PATH = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\ndef utc(series):\n    return pd.to_datetime(series, errors=\"coerce\", utc=True)\n\ndef rmse(actual, predicted):\n    valid = actual.notna() & predicted.notna()\n    if not valid.any():\n        return np.nan\n    return float(np.sqrt(np.mean((actual[valid] - predicted[valid]) ** 2)))\n\nprint(\"=\" * 76)\nprint(\"1. LOAD HISTORICAL TRUTH\")\nprint(\"=\" * 76)\n\ntruth_files = sorted(TRUTH_DIR.rglob(\"*.parquet\"))\nif not truth_files:\n    raise FileNotFoundError(f\"No truth parquet files found: {TRUTH_DIR}\")\n\ntruth_parts = []\nfor path in truth_files:\n    # Only load dates strictly before the February holdout.\n    # Filename filtering uses the actual YYYY_MM_DD convention.\n    if \"2031_02_\" in path.name or \"2031_03_\" in path.name:\n        continue\n\n    frame = pd.read_parquet(path)\n    frame[\"timestamp\"] = utc(frame[\"timestamp\"])\n    truth_parts.append(frame)\n\ntruth = pd.concat(truth_parts, ignore_index=True)\ntruth = truth.drop_duplicates(KEYS)\nprint(\"Historical truth rows:\", len(truth))\nprint(\"Historical date range:\",\n      truth[\"timestamp\"].min(), \"to\", truth[\"timestamp\"].max())\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"2. LOAD FEBRUARY TARGET KEYS\")\nprint(\"=\" * 76)\n\n# The train template covers June 2030–February 2031.\ntemplate = pd.read_csv(TEMPLATE_PATH)\ntemplate[\"timestamp\"] = utc(template[\"timestamp\"])\ntargets = template.loc[\n    template[\"timestamp\"].ge(START)\n    & template[\"timestamp\"].lt(END)\n].copy()\n\nif targets.empty:\n    raise RuntimeError(\n        \"The train template contains no February targets. \"\n        \"Cannot proceed with this holdout.\"\n    )\n\ntargets = targets.drop_duplicates(KEYS)\nprint(\"February template targets:\", len(targets))\nprint(\"Target regime counts:\")\nprint(targets[\"mask_regime\"].value_counts().to_string())\n\n# Match holdout targets to truth.\nholdout = targets[KEYS + [\"mask_regime\"]].merge(\n    pd.concat([\n        pd.read_parquet(p)\n        for p in truth_files\n        if \"2031_02_\" in p.name\n    ], ignore_index=True).assign(\n        timestamp=lambda d: utc(d[\"timestamp\"])\n    ),\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=True\n)\n\nmatched = int(holdout[\"_merge\"].eq(\"both\").sum())\nprint(\"Targets matched to February truth:\", matched, \"/\", len(holdout))\n\nif matched != len(holdout):\n    print(holdout.loc[holdout[\"_merge\"].ne(\"both\"), KEYS].head(10))\n    raise ValueError(\"Some February target keys did not match truth.\")\n\nholdout = holdout.drop(columns=\"_merge\")\n\nif \"is_score_eligible\" in holdout.columns:\n    holdout = holdout.loc[\n        holdout[\"is_score_eligible\"].fillna(False).astype(bool)\n    ].copy()\n\nprint(\"Eligible holdout rows:\", len(holdout))\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"3. BUILD HISTORICAL PROFILE\")\nprint(\"=\" * 76)\n\n# Keep reliable historical records only.\nhist = truth.copy()\nhist[\"pct_observed\"] = pd.to_numeric(hist[\"pct_observed\"], errors=\"coerce\")\nhist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\nhist[\"flow_vph\"] = pd.to_numeric(hist[\"flow_vph\"], errors=\"coerce\")\n\nhist = hist.loc[\n    hist[\"timestamp\"].lt(START)\n    & hist[\"pct_observed\"].ge(75)\n    & hist[\"speed_kmh\"].notna()\n    & hist[\"flow_vph\"].notna()\n].copy()\n\nhist[\"minute_of_day\"] = (\n    hist[\"timestamp\"].dt.hour * 60 + hist[\"timestamp\"].dt.minute\n)\nhist[\"weekday\"] = hist[\"timestamp\"].dt.dayofweek\nhist[\"time_bin\"] = hist[\"weekday\"] * 288 + (\n    hist[\"minute_of_day\"] // 5\n)\n\nprofile = (\n    hist.groupby([\"link_id\", \"time_bin\"], as_index=False)\n    .agg(\n        profile_speed=(\"speed_kmh\", \"mean\"),\n        profile_flow=(\"flow_vph\", \"mean\")\n    )\n)\n\nlink_profile = (\n    hist.groupby(\"link_id\", as_index=False)\n    .agg(\n        fallback_speed=(\"speed_kmh\", \"mean\"),\n        fallback_flow=(\"flow_vph\", \"mean\")\n    )\n)\n\nholdout[\"minute_of_day\"] = (\n    holdout[\"timestamp\"].dt.hour * 60 + holdout[\"timestamp\"].dt.minute\n)\nholdout[\"weekday\"] = holdout[\"timestamp\"].dt.dayofweek\nholdout[\"time_bin\"] = holdout[\"weekday\"] * 288 + (\n    holdout[\"minute_of_day\"] // 5\n)\n\nholdout = holdout.merge(\n    profile,\n    on=[\"link_id\", \"time_bin\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nholdout = holdout.merge(\n    link_profile,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nholdout[\"pred_speed\"] = holdout[\"profile_speed\"].fillna(\n    holdout[\"fallback_speed\"]\n)\nholdout[\"pred_flow\"] = holdout[\"profile_flow\"].fillna(\n    holdout[\"fallback_flow\"]\n)\n\nprint(\"Missing speed predictions:\", int(holdout[\"pred_speed\"].isna().sum()))\nprint(\"Missing flow predictions:\", int(holdout[\"pred_flow\"].isna().sum()))\n\nif holdout[[\"pred_speed\", \"pred_flow\"]].isna().any().any():\n    raise ValueError(\"Baseline produced missing predictions.\")\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"4. SCORE BY REGIME\")\nprint(\"=\" * 76)\n\n# Locate lane counts in the actual truth files if available.\nlane_col = None\nif \"lanes\" in holdout.columns:\n    lane_col = \"lanes\"\nelse:\n    # Search nearby metadata files instead of assuming one exact location.\n    metadata_candidates = list(\n        (ROOT / \"corridors\" / PANEL).rglob(\"links.csv\")\n    )\n    for metadata_path in metadata_candidates:\n        metadata = pd.read_csv(metadata_path)\n        if {\"link_id\", \"lanes\"}.issubset(metadata.columns):\n            holdout = holdout.merge(\n                metadata[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\"),\n                on=\"link_id\",\n                how=\"left\",\n                validate=\"many_to_one\"\n            )\n            lane_col = \"lanes\"\n            print(\"Lane metadata loaded from:\", metadata_path)\n            break\n\nif lane_col is None:\n    print(\n        \"WARNING: Lane metadata unavailable. Flow RMSE per lane cannot \"\n        \"be computed correctly, so the official state score is withheld.\"\n    )\n\nresults = []\n\nfor regime, group in holdout.groupby(\"mask_regime\"):\n    speed_rmse = rmse(group[\"speed_kmh\"], group[\"pred_speed\"])\n    flow_rmse_total = rmse(group[\"flow_vph\"], group[\"pred_flow\"])\n\n    if lane_col is not None:\n        lanes = pd.to_numeric(group[lane_col], errors=\"coerce\")\n        valid = (\n            group[\"flow_vph\"].notna()\n            & group[\"pred_flow\"].notna()\n            & lanes.notna()\n            & lanes.gt(0)\n        )\n        flow_rmse_lane = (\n            float(np.sqrt(np.mean(\n                ((group.loc[valid, \"flow_vph\"]\n                  - group.loc[valid, \"pred_flow\"])\n                 / lanes.loc[valid]) ** 2\n            )))\n            if valid.any() else np.nan\n        )\n        state_score = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n            if np.isfinite(speed_rmse) and np.isfinite(flow_rmse_lane)\n            else np.nan\n        )\n    else:\n        flow_rmse_lane = np.nan\n        state_score = np.nan\n\n    results.append({\n        \"regime\": regime,\n        \"targets\": len(group),\n        \"speed_RMSE\": speed_rmse,\n        \"flow_RMSE_total\": flow_rmse_total,\n        \"flow_RMSE_per_lane\": flow_rmse_lane,\n        \"state_score\": state_score\n    })\n\nresults_df = pd.DataFrame(results)\nprint(results_df.to_string(index=False))\n\nif results_df[\"state_score\"].notna().all():\n    macro_score = float(results_df[\"state_score\"].mean())\n    print(\"\\nRebuilt baseline macro score:\", round(macro_score, 6))\nelse:\n    macro_score = np.nan\n    print(\"\\nMacro score not computed because lane-normalized flow errors \"\n          \"could not be verified.\")\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"5. SAVE RECONSTRUCTED BASELINE OUTPUTS\")\nprint(\"=\" * 76)\n\nOUT = Path(\"/kaggle/working/trafficflow_task1_rebuild\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nholdout[\n    KEYS + [\"mask_regime\", \"speed_kmh\", \"flow_vph\", \"pred_speed\", \"pred_flow\"]\n].to_csv(OUT / \"february_baseline_predictions.csv\", index=False)\n\nresults_df.to_csv(OUT / \"february_baseline_metrics.csv\", index=False)\n\nprint(\"Saved predictions:\", OUT / \"february_baseline_predictions.csv\")\nprint(\"Saved metrics:\", OUT / \"february_baseline_metrics.csv\")\nprint(\"\\nBaseline rebuild complete. No ML model was trained.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T12:47:03.838272Z","iopub.execute_input":"2026-10-19T12:47:03.838632Z","iopub.status.idle":"2026-10-19T12:47:35.515001Z","shell.execute_reply.started":"2026-10-19T12:47:03.838604Z","shell.execute_reply":"2026-10-19T12:47:35.512953Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# =====================================================================\n# IEEETrafficFlow — TASK 1: RESIDUAL-LEARNING EXPERIMENT\n# Complete standalone experiment | Panel: D7_I405_S\n#\n# Training: December 2030 + January 2031 official target keys\n# Holdout:   February 2031 official target keys\n# Baseline benchmark from previous verified experiment: 0.653495\n#\n# No dependency on variables from previous notebook cells.\n# =====================================================================\n\nimport gc\nimport json\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nwarnings.filterwarnings(\"ignore\", category=FutureWarning)\n\n# ----------------------------- CONFIG -----------------------------\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nTRUTH_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\nMASKED_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\nTEMPLATE_PATH = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\nLINKS_PATH = ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\n\nOUT = Path(\"/kaggle/working/trafficflow_residual_experiment\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nFEB_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nMAR_START = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\nKNOWN_BASELINE_SCORE = 0.653495\nBASELINE_TOLERANCE = 0.002\n\nLAGS_MINUTES = [5, 15, 60, 1440]\n\n\n# ----------------------------- HELPERS -----------------------------\n\ndef require(condition, message):\n    if not condition:\n        raise RuntimeError(message)\n\n\ndef load_parquets(folder, columns):\n    files = sorted(folder.rglob(\"*.parquet\"))\n    require(files, f\"No parquet files found: {folder}\")\n\n    frames = []\n    for i, path in enumerate(files, 1):\n        frames.append(pd.read_parquet(path, columns=columns))\n        if i % 50 == 0 or i == len(files):\n            print(f\"  Loaded {i}/{len(files)} files: {folder.name}\")\n\n    return pd.concat(frames, ignore_index=True)\n\n\ndef normalize_ids(frame):\n    \"\"\"Preserve real IDs such as L405S-406; never cast IDs to integers.\"\"\"\n    frame = frame.copy()\n    for col in [\"station_id\", \"link_id\"]:\n        frame[col] = frame[col].astype(\"string\").str.strip()\n    return frame\n\n\ndef rmse(actual, predicted):\n    actual = np.asarray(actual, dtype=np.float64)\n    predicted = np.asarray(predicted, dtype=np.float64)\n    return float(np.sqrt(np.mean((actual - predicted) ** 2)))\n\n\ndef add_time_features(frame):\n    frame = frame.copy()\n    ts = frame[\"timestamp\"]\n\n    frame[\"dow\"] = ts.dt.dayofweek.astype(\"int8\")\n    frame[\"minute_of_day\"] = (\n        ts.dt.hour * 60 + ts.dt.minute\n    ).astype(\"int16\")\n\n    frame[\"tod_sin\"] = np.sin(\n        2 * np.pi * frame[\"minute_of_day\"] / 1440.0\n    )\n    frame[\"tod_cos\"] = np.cos(\n        2 * np.pi * frame[\"minute_of_day\"] / 1440.0\n    )\n    frame[\"dow_sin\"] = np.sin(\n        2 * np.pi * frame[\"dow\"] / 7.0\n    )\n    frame[\"dow_cos\"] = np.cos(\n        2 * np.pi * frame[\"dow\"] / 7.0\n    )\n\n    return frame\n\n\n# ----------------------------- 1. LOAD DATA -----------------------------\n\nprint(\"\\n[1/9] Loading source data...\")\n\ntruth = load_parquets(\n    TRUTH_DIR,\n    [\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    ],\n)\n\nmasked = load_parquets(\n    MASKED_DIR,\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"],\n)\n\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n\ntruth = normalize_ids(truth)\nmasked = normalize_ids(masked)\n\ntemplate = pd.read_csv(TEMPLATE_PATH)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\ntemplate = normalize_ids(template)\n\nlinks = pd.read_csv(LINKS_PATH)\nrequire(\n    {\"link_id\", \"lanes\"}.issubset(links.columns),\n    f\"Unexpected links.csv columns: {links.columns.tolist()}\",\n)\nlinks[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\nlinks[\"lanes\"] = pd.to_numeric(links[\"lanes\"], errors=\"coerce\")\n\nrequire(links[\"link_id\"].notna().all(), \"Missing link IDs in links.csv.\")\nrequire(links[\"lanes\"].notna().all(), \"Missing/non-numeric lane counts.\")\nrequire((links[\"lanes\"] > 0).all(), \"Lane counts must be positive.\")\nrequire(not links[\"link_id\"].duplicated().any(), \"Duplicate link IDs in links.csv.\")\n\nfor name, frame in [\n    (\"truth\", truth),\n    (\"masked\", masked),\n    (\"template\", template),\n]:\n    require(frame[KEYS].notna().all().all(), f\"{name} has null target keys.\")\n    require(\n        not frame.duplicated(KEYS).any(),\n        f\"{name} contains duplicate target keys.\",\n    )\n\nprint(f\"Truth rows:  {len(truth):,}\")\nprint(f\"Masked rows: {len(masked):,}\")\nprint(f\"Template rows: {len(template):,}\")\nprint(\"Link metadata rows:\", len(links))\n\n\n# ----------------------------- 2. TARGET KEYS -----------------------------\n\nprint(\"\\n[2/9] Preparing official training and February holdout targets...\")\n\ntarget_keys = template.loc[\n    template[\"timestamp\"].ge(TRAIN_START)\n    & template[\"timestamp\"].lt(MAR_START),\n    KEYS + [\"mask_regime\"],\n].copy()\n\ntarget_keys[\"target_month\"] = target_keys[\"timestamp\"].dt.strftime(\"%Y-%m\")\n\ntrain_keys = target_keys.loc[\n    target_keys[\"timestamp\"].lt(FEB_START)\n].copy()\n\nholdout_keys = target_keys.loc[\n    target_keys[\"timestamp\"].ge(FEB_START)\n    & target_keys[\"timestamp\"].lt(MAR_START)\n].copy()\n\nrequire(\n    len(train_keys) == 479_688,\n    f\"Expected 479,688 Dec-Jan targets; found {len(train_keys):,}.\",\n)\nrequire(\n    len(holdout_keys) == 235_491,\n    f\"Expected 235,491 February targets; found {len(holdout_keys):,}.\",\n)\n\nprint(\"December-January training targets:\", f\"{len(train_keys):,}\")\nprint(\"February holdout targets:\", f\"{len(holdout_keys):,}\")\n\n\n# ----------------------------- 3. LABELS -----------------------------\n\nprint(\"\\n[3/9] Joining ground-truth labels once...\")\n\nlabels = truth[\n    KEYS + [\"speed_kmh\", \"flow_vph\", \"is_score_eligible\"]\n].rename(\n    columns={\n        \"speed_kmh\": \"target_speed\",\n        \"flow_vph\": \"target_flow\",\n        \"is_score_eligible\": \"target_eligible\",\n    }\n).copy()\n\ntrain_keys = train_keys.merge(\n    labels, on=KEYS, how=\"left\",\n    validate=\"one_to_one\", indicator=\"_label_match\",\n)\nholdout_keys = holdout_keys.merge(\n    labels, on=KEYS, how=\"left\",\n    validate=\"one_to_one\", indicator=\"_label_match\",\n)\n\nrequire(\n    train_keys[\"_label_match\"].eq(\"both\").all(),\n    \"Some training targets did not match truth.\",\n)\nrequire(\n    holdout_keys[\"_label_match\"].eq(\"both\").all(),\n    \"Some February targets did not match truth.\",\n)\n\nfor name, frame in [\n    (\"training\", train_keys),\n    (\"holdout\", holdout_keys),\n]:\n    valid = (\n        frame[\"target_eligible\"].fillna(False).astype(bool)\n        & frame[\"target_speed\"].notna()\n        & frame[\"target_flow\"].notna()\n    )\n    require(valid.all(), f\"{name} has ineligible or missing target labels.\")\n\ntrain_keys.drop(columns=\"_label_match\", inplace=True)\nholdout_keys.drop(columns=\"_label_match\", inplace=True)\n\n# Only these target labels are used for training or evaluation.\nall_targets = pd.concat(\n    [train_keys, holdout_keys],\n    ignore_index=True,\n)\n\ndel labels\ngc.collect()\n\n\n# ----------------------------- 4. PAST-ONLY PROFILES -----------------------------\n\nprint(\"\\n[4/9] Building month-specific historical profiles...\")\n\ndef build_profile(month_targets, month_start):\n    # Strictly earlier than the first instant of the target month.\n    history = truth.loc[\n        (truth[\"timestamp\"] < month_start)\n        & (truth[\"pct_observed\"] >= 75)\n        & truth[\"speed_kmh\"].notna()\n        & truth[\"flow_vph\"].notna(),\n        [\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"],\n    ].copy()\n\n    require(len(history) > 0, f\"No usable history before {month_start}.\")\n\n    history = add_time_features(history)\n    query = add_time_features(month_targets[KEYS].copy())\n\n    profile = (\n        history.groupby(\n            [\"link_id\", \"dow\", \"minute_of_day\"],\n            observed=True,\n        )[[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"base_speed\",\n                \"flow_vph\": \"base_flow\",\n            }\n        )\n    )\n\n    weekday_profile = (\n        history.groupby([\"link_id\", \"dow\"], observed=True)\n        [[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"weekday_speed\",\n                \"flow_vph\": \"weekday_flow\",\n            }\n        )\n    )\n\n    link_profile = (\n        history.groupby(\"link_id\", observed=True)\n        [[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"link_speed\",\n                \"flow_vph\": \"link_flow\",\n            }\n        )\n    )\n\n    query = query.merge(\n        profile,\n        on=[\"link_id\", \"dow\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    query = query.merge(\n        weekday_profile,\n        on=[\"link_id\", \"dow\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    query = query.merge(\n        link_profile,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    query[\"base_speed\"] = (\n        query[\"base_speed\"]\n        .fillna(query[\"weekday_speed\"])\n        .fillna(query[\"link_speed\"])\n    )\n    query[\"base_flow\"] = (\n        query[\"base_flow\"]\n        .fillna(query[\"weekday_flow\"])\n        .fillna(query[\"link_flow\"])\n    )\n\n    require(\n        query[[\"base_speed\", \"base_flow\"]].notna().all().all(),\n        f\"Uncovered profile rows for month starting {month_start}.\",\n    )\n\n    return query[KEYS + [\"base_speed\", \"base_flow\"]]\n\n\nprofile_parts = []\n\nfor month in [\"2030-12\", \"2031-01\", \"2031-02\"]:\n    month_start = pd.Timestamp(month + \"-01\", tz=\"UTC\")\n\n    month_keys = target_keys.loc[\n        target_keys[\"target_month\"].eq(month),\n        KEYS,\n    ].copy()\n\n    require(len(month_keys) > 0, f\"No target keys for {month}.\")\n\n    month_profile = build_profile(month_keys, month_start)\n    profile_parts.append(month_profile)\n\n    print(\n        f\"  {month}: {len(month_profile):,} rows; \"\n        f\"profile cutoff={month_start}\"\n    )\n\n    del month_keys, month_profile\n    gc.collect()\n\nprofiles = pd.concat(profile_parts, ignore_index=True)\n\nrequire(\n    not profiles.duplicated(KEYS).any(),\n    \"Duplicate keys in historical profiles.\",\n)\n\nfeatures = all_targets.merge(\n    profiles,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\nrequire(\n    features[[\"base_speed\", \"base_flow\"]].notna().all().all(),\n    \"Missing baseline profile values.\",\n)\n\ndel profile_parts, profiles, all_targets\ngc.collect()\n\n\n# ----------------------------- 5. MASKED LAG FEATURES -----------------------------\n\nprint(\"\\n[5/9] Building masked-only lag features...\")\n\n# Preserve raw IDs here. No numeric conversion of link_id.\nfeatures = features.reset_index(drop=True)\nfeatures[\"_row_id\"] = np.arange(len(features), dtype=np.int64)\n\nmin_source_time = features[\"timestamp\"].min() - pd.Timedelta(days=1)\nmax_source_time = features[\"timestamp\"].max()\n\nmasked_source = masked.loc[\n    masked[\"timestamp\"].ge(min_source_time)\n    & masked[\"timestamp\"].le(max_source_time),\n    KEYS + [\"speed_kmh\", \"flow_vph\"],\n].copy()\n\n# Null masked values naturally become NaN after a join.\nmasked_source = masked_source.loc[\n    masked_source[\"speed_kmh\"].notna()\n    | masked_source[\"flow_vph\"].notna()\n].copy()\n\nfor lag in LAGS_MINUTES:\n    print(f\"  Joining {lag}-minute lag...\")\n\n    lookup = features[[\"_row_id\"] + KEYS].copy()\n    lookup[\"timestamp\"] = (\n        lookup[\"timestamp\"] - pd.Timedelta(minutes=lag)\n    )\n\n    source = masked_source.rename(\n        columns={\n            \"speed_kmh\": f\"lag{lag}_speed\",\n            \"flow_vph\": f\"lag{lag}_flow\",\n        }\n    )\n\n    joined = lookup.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    require(len(joined) == len(features), f\"Row count changed for lag {lag}.\")\n\n    joined = joined.set_index(\"_row_id\")\n\n    features[f\"lag{lag}_speed\"] = (\n        joined[f\"lag{lag}_speed\"]\n        .reindex(features[\"_row_id\"])\n        .to_numpy()\n    )\n    features[f\"lag{lag}_flow\"] = (\n        joined[f\"lag{lag}_flow\"]\n        .reindex(features[\"_row_id\"])\n        .to_numpy()\n    )\n\n    del lookup, source, joined\n    gc.collect()\n\ndel masked_source, masked\ngc.collect()\n\n\n# ----------------------------- 6. MODEL FEATURES -----------------------------\n\nprint(\"\\n[6/9] Preparing model features...\")\n\nfeatures = add_time_features(features)\n\n# Keep raw IDs in `features` for evaluation and metadata joins.\n# Encode only the dedicated model matrix.\nFEATURES = [\n    \"base_speed\",\n    \"base_flow\",\n    \"dow\",\n    \"minute_of_day\",\n    \"tod_sin\",\n    \"tod_cos\",\n    \"dow_sin\",\n    \"dow_cos\",\n] + [\n    f\"lag{lag}_{kind}\"\n    for lag in LAGS_MINUTES\n    for kind in [\"speed\", \"flow\"]\n]\n\nX_all = features[FEATURES].astype(\"float32\").copy()\n\n# Stable categorical codes are derived jointly from training and holdout IDs.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    X_all[col] = (\n        features[col].astype(\"string\").astype(\"category\").cat.codes\n    ).astype(\"float32\")\n\n# Add encoded ID columns to the model matrix.\nX_all[\"station_id\"] = (\n    features[\"station_id\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\nX_all[\"link_id\"] = (\n    features[\"link_id\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\nX_all[\"mask_regime\"] = (\n    features[\"mask_regime\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"station_id\", \"link_id\", \"mask_regime\",\n    \"dow\", \"minute_of_day\", \"tod_sin\", \"tod_cos\", \"dow_sin\", \"dow_cos\",\n] + [\n    f\"lag{lag}_{kind}\"\n    for lag in LAGS_MINUTES\n    for kind in [\"speed\", \"flow\"]\n]\n\ntrain_mask = features[\"timestamp\"].lt(FEB_START)\nholdout_mask = (\n    features[\"timestamp\"].ge(FEB_START)\n    & features[\"timestamp\"].lt(MAR_START)\n)\n\nX_train = X_all.loc[train_mask, FEATURES].copy()\nX_holdout = X_all.loc[holdout_mask, FEATURES].copy()\n\ny_speed = (\n    features.loc[train_mask, \"target_speed\"].to_numpy(dtype=np.float32)\n    - features.loc[train_mask, \"base_speed\"].to_numpy(dtype=np.float32)\n)\ny_flow = (\n    features.loc[train_mask, \"target_flow\"].to_numpy(dtype=np.float32)\n    - features.loc[train_mask, \"base_flow\"].to_numpy(dtype=np.float32)\n)\n\nrequire(len(X_train) == 479_688, \"Unexpected training matrix size.\")\nrequire(len(X_holdout) == 235_491, \"Unexpected holdout matrix size.\")\nrequire(\n    np.isfinite(y_speed).all() and np.isfinite(y_flow).all(),\n    \"Non-finite residual labels.\",\n)\n\nprint(\"Training matrix:\", X_train.shape)\nprint(\"Holdout matrix:\", X_holdout.shape)\nprint(\"Training missing feature cells:\", int(X_train.isna().sum().sum()))\nprint(\"Holdout missing feature cells:\", int(X_holdout.isna().sum().sum()))\n\n\n# ----------------------------- 7. BASELINE CHECK -----------------------------\n\nprint(\"\\n[7/9] Checking the February baseline...\")\n\n# Use the untouched string link IDs from `features`.\neval_frame = features.loc[\n    holdout_mask,\n    KEYS + [\n        \"mask_regime\",\n        \"target_speed\",\n        \"target_flow\",\n        \"base_speed\",\n        \"base_flow\",\n    ],\n].copy()\n\n# Metadata IDs remain strings such as L405S-406.\neval_frame[\"link_id\"] = eval_frame[\"link_id\"].astype(\"string\").str.strip()\nlane_metadata = links[[\"link_id\", \"lanes\"]].copy()\nlane_metadata[\"link_id\"] = lane_metadata[\"link_id\"].astype(\"string\").str.strip()\n\neval_frame = eval_frame.merge(\n    lane_metadata,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nmissing_lane_ids = eval_frame.loc[\n    eval_frame[\"lanes\"].isna(), \"link_id\"\n].drop_duplicates().tolist()\n\nrequire(\n    not missing_lane_ids,\n    f\"Lane metadata missing for link IDs: {missing_lane_ids[:20]}\",\n)\nrequire((eval_frame[\"lanes\"] > 0).all(), \"Invalid lanes in holdout.\")\n\ndef calculate_scores(frame, speed_column, flow_column, experiment_name):\n    rows = []\n\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        part = frame.loc[frame[\"mask_regime\"].eq(regime)].copy()\n        require(len(part) > 0, f\"No evaluation rows for {regime}.\")\n\n        speed_error = rmse(\n            part[\"target_speed\"],\n            part[speed_column],\n        )\n\n        flow_error_per_lane = rmse(\n            part[\"target_flow\"].to_numpy(dtype=float)\n            / part[\"lanes\"].to_numpy(dtype=float),\n            part[flow_column].to_numpy(dtype=float)\n            / part[\"lanes\"].to_numpy(dtype=float),\n        )\n\n        speed_score = max(0.0, 1.0 - speed_error / 25.0)\n        flow_score = max(0.0, 1.0 - flow_error_per_lane / 600.0)\n        state_score = 0.54 * speed_score + 0.46 * flow_score\n\n        rows.append({\n            \"experiment\": experiment_name,\n            \"mask_regime\": regime,\n            \"n_targets\": len(part),\n            \"speed_RMSE\": speed_error,\n            \"flow_RMSE_per_lane\": flow_error_per_lane,\n            \"score\": state_score,\n        })\n\n    result = pd.DataFrame(rows)\n    result.loc[len(result)] = {\n        \"experiment\": experiment_name,\n        \"mask_regime\": \"MACRO\",\n        \"n_targets\": len(frame),\n        \"speed_RMSE\": np.nan,\n        \"flow_RMSE_per_lane\": np.nan,\n        \"score\": result[\"score\"].mean(),\n    }\n    return result\n\nbaseline_metrics = calculate_scores(\n    eval_frame,\n    \"base_speed\",\n    \"base_flow\",\n    \"baseline\",\n)\n\nbaseline_macro = float(\n    baseline_metrics.loc[\n        baseline_metrics[\"mask_regime\"].eq(\"MACRO\"), \"score\"\n    ].iloc[0]\n)\n\nprint(baseline_metrics.to_string(index=False))\nprint(f\"\\nRecomputed baseline: {baseline_macro:.6f}\")\nprint(f\"Known reference:     {KNOWN_BASELINE_SCORE:.6f}\")\n\nif abs(baseline_macro - KNOWN_BASELINE_SCORE) > BASELINE_TOLERANCE:\n    raise RuntimeError(\n        \"Baseline verification failed. Model training stopped. \"\n        f\"Recomputed={baseline_macro:.6f}, \"\n        f\"reference={KNOWN_BASELINE_SCORE:.6f}. \"\n        \"The residual model has not been evaluated.\"\n    )\n\nprint(\"Baseline verification passed.\")\n\n\n# ----------------------------- 8. TRAIN AND SCORE -----------------------------\n\nprint(\"\\n[8/9] Training residual models...\")\n\nmodel_params = {\n    \"learning_rate\": 0.06,\n    \"max_iter\": 150,\n    \"max_leaf_nodes\": 31,\n    \"l2_regularization\": 5.0,\n    \"early_stopping\": True,\n    \"validation_fraction\": 0.1,\n    \"n_iter_no_change\": 15,\n    \"random_state\": 42,\n}\n\nspeed_model = HistGradientBoostingRegressor(**model_params)\nflow_model = HistGradientBoostingRegressor(**model_params)\n\nspeed_model.fit(X_train, y_speed)\nprint(\"Speed residual model trained.\")\n\nflow_model.fit(X_train, y_flow)\nprint(\"Flow residual model trained.\")\n\npred_speed = np.clip(\n    eval_frame[\"base_speed\"].to_numpy(dtype=float)\n    + speed_model.predict(X_holdout),\n    0.0,\n    160.0,\n)\n\npred_flow = np.clip(\n    eval_frame[\"base_flow\"].to_numpy(dtype=float)\n    + flow_model.predict(X_holdout),\n    0.0,\n    None,\n)\n\neval_frame[\"pred_speed_baseline\"] = eval_frame[\"base_speed\"]\neval_frame[\"pred_flow_baseline\"] = eval_frame[\"base_flow\"]\neval_frame[\"pred_speed_model\"] = pred_speed\neval_frame[\"pred_flow_model\"] = pred_flow\n\nmodel_metrics = calculate_scores(\n    eval_frame,\n    \"pred_speed_model\",\n    \"pred_flow_model\",\n    \"residual_model\",\n)\n\nall_metrics = pd.concat(\n    [baseline_metrics, model_metrics],\n    ignore_index=True,\n)\n\nprint(\"\\nBaseline versus residual model:\")\nprint(all_metrics.to_string(index=False))\n\nmodel_macro = float(\n    model_metrics.loc[\n        model_metrics[\"mask_regime\"].eq(\"MACRO\"), \"score\"\n    ].iloc[0]\n)\n\nprint(f\"\\nBaseline macro score:       {baseline_macro:.6f}\")\nprint(f\"Residual model macro score: {model_macro:.6f}\")\nprint(f\"Score change:               {model_macro - baseline_macro:+.6f}\")\n\n\n# ----------------------------- 9. SAVE RESULTS -----------------------------\n\nprint(\"\\n[9/9] Saving experiment artifacts...\")\n\nprediction_path = OUT / \"february_residual_predictions.csv\"\nmetrics_path = OUT / \"february_residual_metrics.csv\"\nsummary_path = OUT / \"experiment_summary.json\"\n\neval_frame[\n    KEYS + [\n        \"mask_regime\",\n        \"lanes\",\n        \"target_speed\",\n        \"target_flow\",\n        \"pred_speed_baseline\",\n        \"pred_flow_baseline\",\n        \"pred_speed_model\",\n        \"pred_flow_model\",\n    ]\n].to_csv(prediction_path, index=False)\n\nall_metrics.to_csv(metrics_path, index=False)\n\nsummary = {\n    \"panel\": PANEL,\n    \"training_targets\": int(len(X_train)),\n    \"holdout_targets\": int(len(X_holdout)),\n    \"feature_count\": int(len(FEATURES)),\n    \"known_baseline_macro\": KNOWN_BASELINE_SCORE,\n    \"recomputed_baseline_macro\": baseline_macro,\n    \"residual_model_macro\": model_macro,\n    \"score_change\": model_macro - baseline_macro,\n    \"improved_over_baseline\": bool(model_macro > baseline_macro),\n    \"status\": \"completed\",\n    \"scope\": \"February 2031 holdout, panel D7_I405_S only\",\n}\n\nwith open(summary_path, \"w\") as f:\n    json.dump(summary, f, indent=2)\n\nprint(\"\\nSaved files:\")\nprint(prediction_path)\nprint(metrics_path)\nprint(summary_path)\n\nif model_macro > baseline_macro:\n    print(\"\\nRESULT: Residual model improved the February holdout score.\")\nelse:\n    print(\"\\nRESULT: Residual model did not improve the February holdout score.\")\n    print(\"Retain the verified baseline until a better method is validated.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:19:26.065064Z","iopub.execute_input":"2026-10-19T13:19:26.065675Z","iopub.status.idle":"2026-10-19T13:21:14.908273Z","shell.execute_reply.started":"2026-10-19T13:19:26.065623Z","shell.execute_reply":"2026-10-19T13:21:14.907143Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.1\n# Cross-panel readiness audit\n# Read-only: no training and no source files modified\n# ============================================================\n\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\ndef require(condition, message):\n    if not condition:\n        raise RuntimeError(message)\n\nresults = []\n\nprint(\"STAGE 2.1 — CROSS-PANEL READINESS AUDIT\")\nprint(\"Dataset root:\", ROOT)\n\nrequire(ROOT.exists(), f\"Dataset root not found: {ROOT}\")\n\nfor panel in PANELS:\n    print(f\"\\nChecking {panel}...\")\n\n    corridor = ROOT / \"corridors\" / panel\n    truth_dir = corridor / \"train\" / \"mainline_states\"\n    masked_dir = corridor / \"train\" / \"mainline_states_masked\"\n    links_path = corridor / \"network\" / \"links.csv\"\n\n    train_path = (\n        ROOT / \"task1\" / panel / \"train\"\n        / \"sample_submission_state.csv\"\n    )\n    validation_path = (\n        ROOT / \"task1\" / panel / \"validation\"\n        / \"sample_submission_state.csv\"\n    )\n    private_path = (\n        ROOT / \"task1\" / panel / \"private\"\n        / \"sample_submission_state.csv\"\n    )\n\n    paths = {\n        \"truth_dir\": truth_dir,\n        \"masked_dir\": masked_dir,\n        \"links_csv\": links_path,\n        \"train_template\": train_path,\n        \"validation_template\": validation_path,\n        \"private_template\": private_path,\n    }\n\n    missing_paths = [\n        name for name, path in paths.items()\n        if not path.exists()\n    ]\n\n    if missing_paths:\n        print(\"  STATUS: MISSING REQUIRED PATHS\")\n        print(\"  Missing:\", missing_paths)\n        results.append({\n            \"panel\": panel,\n            \"status\": \"MISSING_PATHS\",\n            \"truth_files\": None,\n            \"masked_files\": None,\n            \"train_targets\": None,\n            \"validation_targets\": None,\n            \"private_targets\": None,\n            \"link_metadata_rows\": None,\n            \"target_links_missing_metadata\": None,\n        })\n        continue\n\n    truth_files = sorted(truth_dir.rglob(\"*.parquet\"))\n    masked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\n    if not truth_files or not masked_files:\n        print(\"  STATUS: NO PARQUET FILES\")\n        results.append({\n            \"panel\": panel,\n            \"status\": \"NO_PARQUETS\",\n            \"truth_files\": len(truth_files),\n            \"masked_files\": len(masked_files),\n            \"train_targets\": None,\n            \"validation_targets\": None,\n            \"private_targets\": None,\n            \"link_metadata_rows\": None,\n            \"target_links_missing_metadata\": None,\n        })\n        continue\n\n    # Inspect the first file from each source for required columns.\n    truth_columns = set(pd.read_parquet(truth_files[0]).columns)\n    masked_columns = set(pd.read_parquet(masked_files[0]).columns)\n\n    required_truth = {\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    }\n    required_masked = {\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\",\n    }\n\n    schema_ok = (\n        required_truth.issubset(truth_columns)\n        and required_masked.issubset(masked_columns)\n    )\n\n    train = pd.read_csv(train_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n    validation = pd.read_csv(validation_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n    private = pd.read_csv(private_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n\n    links = pd.read_csv(links_path, usecols=[\"link_id\", \"lanes\"])\n    links[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\n\n    # Compare identifiers as strings; IDs are not necessarily numeric.\n    target_links = set(\n        train[\"link_id\"].astype(\"string\").str.strip().dropna().unique()\n    )\n    metadata_links = set(links[\"link_id\"].dropna().unique())\n    missing_link_metadata = sorted(target_links - metadata_links)\n\n    duplicate_metadata_ids = int(links[\"link_id\"].duplicated().sum())\n    invalid_lanes = int(\n        (\n            pd.to_numeric(links[\"lanes\"], errors=\"coerce\").isna()\n            | (pd.to_numeric(links[\"lanes\"], errors=\"coerce\") <= 0)\n        ).sum()\n    )\n\n    duplicate_train_keys = int(\n        train.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum()\n    )\n    duplicate_validation_keys = int(\n        validation.duplicated(\n            [\"timestamp\", \"station_id\", \"link_id\"]\n        ).sum()\n    )\n    duplicate_private_keys = int(\n        private.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum()\n    )\n\n    status = (\n        \"READY_FOR_NEXT_CHECK\"\n        if (\n            schema_ok\n            and not missing_link_metadata\n            and duplicate_metadata_ids == 0\n            and invalid_lanes == 0\n            and duplicate_train_keys == 0\n            and duplicate_validation_keys == 0\n            and duplicate_private_keys == 0\n        )\n        else \"REVIEW_REQUIRED\"\n    )\n\n    results.append({\n        \"panel\": panel,\n        \"status\": status,\n        \"truth_files\": len(truth_files),\n        \"masked_files\": len(masked_files),\n        \"train_targets\": len(train),\n        \"validation_targets\": len(validation),\n        \"private_targets\": len(private),\n        \"link_metadata_rows\": len(links),\n        \"target_links_missing_metadata\": len(missing_link_metadata),\n        \"truth_schema_ok\": schema_ok,\n        \"duplicate_metadata_ids\": duplicate_metadata_ids,\n        \"invalid_lane_rows\": invalid_lanes,\n        \"duplicate_train_keys\": duplicate_train_keys,\n        \"duplicate_validation_keys\": duplicate_validation_keys,\n        \"duplicate_private_keys\": duplicate_private_keys,\n    })\n\n    print(\"  Truth files:\", len(truth_files))\n    print(\"  Masked files:\", len(masked_files))\n    print(\"  Target counts:\", len(train), len(validation), len(private))\n    print(\"  Missing target-link metadata:\", len(missing_link_metadata))\n    if missing_link_metadata:\n        print(\"  Example missing IDs:\", missing_link_metadata[:10])\n    print(\"  Schema valid:\", schema_ok)\n    print(\"  Status:\", status)\n\n    del train, validation, private, links\n    del truth_columns, masked_columns\n    del truth_files, masked_files\n    import gc\n    gc.collect()\n\nreport = pd.DataFrame(results)\n\nprint(\"\\n\" + \"=\" * 90)\nprint(\"STAGE 2.1 SUMMARY\")\nprint(\"=\" * 90)\nprint(report.to_string(index=False))\n\nreport_path = Path(\"/kaggle/working/stage2_panel_readiness_audit.csv\")\nreport.to_csv(report_path, index=False)\n\nprint(\"\\nAudit report saved to:\", report_path)\nprint(\"This audit does not train models or establish model performance.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:26:45.592823Z","iopub.execute_input":"2026-10-19T13:26:45.595335Z","iopub.status.idle":"2026-10-19T13:27:59.298212Z","shell.execute_reply.started":"2026-10-19T13:26:45.59523Z","shell.execute_reply":"2026-10-19T13:27:59.297226Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.2\n# Cross-panel label and holdout coverage audit\n# ============================================================\n\nfrom pathlib import Path\nimport gc\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nHOLDOUT_END = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\ndef normalize_keys(df):\n    df = df.copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(\"string\").str.strip()\n    df[\"link_id\"] = df[\"link_id\"].astype(\"string\").str.strip()\n    return df\n\ndef load_truth(truth_dir):\n    files = sorted(truth_dir.rglob(\"*.parquet\"))\n    if not files:\n        raise FileNotFoundError(f\"No truth parquet files in {truth_dir}\")\n\n    frames = []\n    columns = [\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    ]\n\n    for file in files:\n        frame = pd.read_parquet(file, columns=columns)\n        frames.append(frame)\n\n    truth = pd.concat(frames, ignore_index=True)\n    del frames\n    truth = normalize_keys(truth)\n    return truth\n\nrows = []\n\nfor panel in PANELS:\n    print(f\"\\nAuditing labels: {panel}\")\n\n    corridor = ROOT / \"corridors\" / panel\n    truth_dir = corridor / \"train\" / \"mainline_states\"\n    template_path = (\n        ROOT / \"task1\" / panel / \"train\"\n        / \"sample_submission_state.csv\"\n    )\n\n    if not truth_dir.exists() or not template_path.exists():\n        rows.append({\n            \"panel\": panel,\n            \"status\": \"MISSING_INPUT\",\n        })\n        print(\"  Missing truth directory or train template.\")\n        continue\n\n    template = pd.read_csv(\n        template_path,\n        usecols=KEYS + [\"mask_regime\"],\n    )\n    template = normalize_keys(template)\n\n    if template.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate keys in train template\")\n\n    dates = template[\"timestamp\"]\n\n    train_template = template.loc[\n        (dates >= TRAIN_START) & (dates < HOLDOUT_START)\n    ].copy()\n\n    feb_template = template.loc[\n        (dates >= HOLDOUT_START) & (dates < HOLDOUT_END)\n    ].copy()\n\n    truth = load_truth(truth_dir)\n\n    if truth.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate truth keys\")\n\n    # Truth coverage and labels for December–January training targets.\n    train_labels = train_template.merge(\n        truth[\n            KEYS + [\n                \"speed_kmh\", \"flow_vph\",\n                \"pct_observed\", \"is_score_eligible\",\n            ]\n        ],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True,\n    )\n\n    # Truth coverage and labels for February holdout targets.\n    feb_labels = feb_template.merge(\n        truth[\n            KEYS + [\n                \"speed_kmh\", \"flow_vph\",\n                \"pct_observed\", \"is_score_eligible\",\n            ]\n        ],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True,\n    )\n\n    def summarize(df):\n        matched = df[\"_merge\"].eq(\"both\")\n        valid_values = (\n            df[\"speed_kmh\"].notna()\n            & df[\"flow_vph\"].notna()\n        )\n        eligible = (\n            df[\"is_score_eligible\"]\n            .fillna(False)\n            .astype(bool)\n        )\n        valid = matched & valid_values & eligible\n\n        return {\n            \"targets\": len(df),\n            \"truth_matched\": int(matched.sum()),\n            \"valid_eligible_labels\": int(valid.sum()),\n            \"missing_truth_keys\": int((~matched).sum()),\n            \"invalid_or_ineligible\": int((~valid).sum()),\n        }\n\n    tr = summarize(train_labels)\n    ho = summarize(feb_labels)\n\n    status = (\n        \"READY\"\n        if (\n            tr[\"targets\"] > 0\n            and ho[\"targets\"] > 0\n            and tr[\"valid_eligible_labels\"] == tr[\"targets\"]\n            and ho[\"valid_eligible_labels\"] == ho[\"targets\"]\n        )\n        else \"REVIEW_REQUIRED\"\n    )\n\n    rows.append({\n        \"panel\": panel,\n        \"status\": status,\n        \"train_targets_dec_jan\": tr[\"targets\"],\n        \"train_truth_matched\": tr[\"truth_matched\"],\n        \"train_valid_eligible\": tr[\"valid_eligible_labels\"],\n        \"train_missing_truth\": tr[\"missing_truth_keys\"],\n        \"train_invalid_or_ineligible\": tr[\"invalid_or_ineligible\"],\n        \"feb_targets\": ho[\"targets\"],\n        \"feb_truth_matched\": ho[\"truth_matched\"],\n        \"feb_valid_eligible\": ho[\"valid_eligible_labels\"],\n        \"feb_missing_truth\": ho[\"missing_truth_keys\"],\n        \"feb_invalid_or_ineligible\": ho[\"invalid_or_ineligible\"],\n    })\n\n    print(\n        f\"  Dec-Jan targets: {tr['targets']:,}; \"\n        f\"valid eligible labels: {tr['valid_eligible_labels']:,}\"\n    )\n    print(\n        f\"  February targets: {ho['targets']:,}; \"\n        f\"valid eligible labels: {ho['valid_eligible_labels']:,}\"\n    )\n    print(\"  Status:\", status)\n\n    del template, train_template, feb_template\n    del truth, train_labels, feb_labels\n    gc.collect()\n\nreport = pd.DataFrame(rows)\n\nprint(\"\\n\" + \"=\" * 110)\nprint(\"STAGE 2.2 — LABEL COVERAGE SUMMARY\")\nprint(\"=\" * 110)\nprint(report.to_string(index=False))\n\noutput_path = Path(\n    \"/kaggle/working/stage2_label_coverage_audit.csv\"\n)\nreport.to_csv(output_path, index=False)\nprint(\"\\nSaved report:\", output_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:29:12.398653Z","iopub.execute_input":"2026-10-19T13:29:12.399059Z","iopub.status.idle":"2026-10-19T13:39:52.531178Z","shell.execute_reply.started":"2026-10-19T13:29:12.399028Z","shell.execute_reply":"2026-10-19T13:39:52.529781Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.3\n# Reconstructed benchmark gate: D7_I405_S\n#\n# Purpose:\n#   1. Rebuild historical baseline profiles.\n#   2. Build target features using masked inputs for lags.\n#   3. Train residual models on Dec 2030 + Jan 2031.\n#   4. Evaluate against Feb 2031 truth.\n#   5. Compare against Stage 1 benchmark scores.\n#\n# IMPORTANT:\n#   This is a reconstruction, not the recovered original cell.\n#   Do not expand to other panels unless this gate passes.\n# ============================================================\n\nfrom pathlib import Path\nimport gc\nimport json\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.impute import SimpleImputer\n\nwarnings.filterwarnings(\"ignore\")\n\n# -----------------------------\n# 1. Configuration\n# -----------------------------\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nCORRIDOR = ROOT / \"corridors\" / PANEL\nTRUTH_DIR = CORRIDOR / \"train\" / \"mainline_states\"\nMASKED_DIR = CORRIDOR / \"train\" / \"mainline_states_masked\"\nTEMPLATE = (\n    ROOT / \"task1\" / PANEL / \"train\"\n    / \"sample_submission_state.csv\"\n)\nLINKS_PATH = CORRIDOR / \"network\" / \"links.csv\"\n\nOUT = Path(\"/kaggle/working/stage2_benchmark_gate\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nHOLDOUT_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nHOLDOUT_END = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\nEXPECTED_BASELINE_MACRO = 0.653495\nEXPECTED_RESIDUAL_MACRO = 0.825718\nSCORE_TOLERANCE = 0.01  # diagnostic tolerance, not a guarantee\n\n# -----------------------------\n# 2. Safe loading and key types\n# -----------------------------\n\ndef normalize_keys(df):\n    df = df.copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = (\n        df[\"station_id\"].astype(\"string\").str.strip()\n    )\n    df[\"link_id\"] = (\n        df[\"link_id\"].astype(\"string\").str.strip()\n    )\n    return df\n\n\ndef load_parquet_folder(folder, columns):\n    files = sorted(folder.rglob(\"*.parquet\"))\n    if not files:\n        raise FileNotFoundError(f\"No parquet files found: {folder}\")\n\n    frames = []\n    for i, file in enumerate(files, 1):\n        frames.append(pd.read_parquet(file, columns=columns))\n        if i % 50 == 0:\n            print(f\"  Loaded {i}/{len(files)} files from {folder.name}\")\n\n    result = pd.concat(frames, ignore_index=True)\n    del frames\n    result = normalize_keys(result)\n    return result\n\n\nprint(\"Loading truth data...\")\ntruth = load_parquet_folder(\n    TRUTH_DIR,\n    KEYS + VALUE_COLS + [\"pct_observed\", \"is_score_eligible\"],\n)\n\nprint(\"Loading masked data...\")\nmasked = load_parquet_folder(\n    MASKED_DIR,\n    KEYS + VALUE_COLS,\n)\n\nprint(\"Loading official train template...\")\ntemplate = pd.read_csv(\n    TEMPLATE,\n    usecols=KEYS + [\"mask_regime\"],\n)\ntemplate = normalize_keys(template)\ntemplate[\"mask_regime\"] = (\n    template[\"mask_regime\"].astype(\"string\").str.strip()\n)\n\nif truth.duplicated(KEYS).any():\n    raise ValueError(\"Truth contains duplicate keys.\")\nif masked.duplicated(KEYS).any():\n    raise ValueError(\"Masked data contains duplicate keys.\")\nif template.duplicated(KEYS).any():\n    raise ValueError(\"Train template contains duplicate keys.\")\n\nprint(\"Truth rows:\", f\"{len(truth):,}\")\nprint(\"Masked rows:\", f\"{len(masked):,}\")\nprint(\"Template rows:\", f\"{len(template):,}\")\n\n# -----------------------------\n# 3. Load link lane metadata\n# -----------------------------\n\nlinks = pd.read_csv(LINKS_PATH, usecols=[\"link_id\", \"lanes\"])\nlinks[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\nlinks[\"lanes\"] = pd.to_numeric(links[\"lanes\"], errors=\"coerce\")\n\nif links[\"link_id\"].duplicated().any():\n    raise ValueError(\"Duplicate link IDs in lane metadata.\")\nif links[\"lanes\"].isna().any() or (links[\"lanes\"] <= 0).any():\n    raise ValueError(\"Invalid lane counts in metadata.\")\n\n# -----------------------------\n# 4. Define train and holdout\n# -----------------------------\n\ndates = template[\"timestamp\"]\n\ntrain_targets = template.loc[\n    (dates >= TRAIN_START) & (dates < HOLDOUT_START)\n].copy()\n\nholdout_targets = template.loc[\n    (dates >= HOLDOUT_START) & (dates < HOLDOUT_END)\n].copy()\n\nif train_targets.empty or holdout_targets.empty:\n    raise ValueError(\"Training or February holdout targets are empty.\")\n\ntruth_labels = truth[\n    KEYS + VALUE_COLS + [\"pct_observed\", \"is_score_eligible\"]\n].copy()\n\ntrain_targets = train_targets.merge(\n    truth_labels,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=\"_truth_match\",\n)\n\nholdout_targets = holdout_targets.merge(\n    truth_labels,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=\"_truth_match\",\n)\n\nfor name, frame in [\n    (\"train\", train_targets),\n    (\"holdout\", holdout_targets),\n]:\n    valid = (\n        frame[\"_truth_match\"].eq(\"both\")\n        & frame[\"speed_kmh\"].notna()\n        & frame[\"flow_vph\"].notna()\n        & frame[\"is_score_eligible\"].fillna(False).astype(bool)\n    )\n    if not valid.all():\n        raise ValueError(\n            f\"{name}: {int((~valid).sum()):,} targets lack \"\n            \"valid eligible truth labels.\"\n        )\n\ntrain_targets = train_targets.drop(columns=\"_truth_match\")\nholdout_targets = holdout_targets.drop(columns=\"_truth_match\")\n\nprint(\"Training targets:\", f\"{len(train_targets):,}\")\nprint(\"February holdout:\", f\"{len(holdout_targets):,}\")\n\n# -----------------------------\n# 5. Historical baseline profiles\n# -----------------------------\n\n# Profile values only use rows before the relevant target month.\n# Require pct_observed >= 75 and both targets non-null.\n\nhistory = truth.loc[\n    (truth[\"pct_observed\"] >= 75)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\nhistory[\"weekday\"] = history[\"timestamp\"].dt.dayofweek\nhistory[\"minute_of_day\"] = (\n    history[\"timestamp\"].dt.hour * 60\n    + history[\"timestamp\"].dt.minute\n)\n\ndef build_baseline(targets, month_cutoff):\n    hist = history.loc[\n        history[\"timestamp\"] < month_cutoff\n    ].copy()\n\n    if hist.empty:\n        raise ValueError(f\"No historical rows before {month_cutoff}\")\n\n    by_link_week_min = (\n        hist.groupby(\n            [\"link_id\", \"weekday\", \"minute_of_day\"],\n            observed=True,\n        )[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    by_link_week = (\n        hist.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    by_link = (\n        hist.groupby(\"link_id\", observed=True)[VALUE_COLS]\n        .mean()\n        .reset_index()\n    )\n\n    result = targets[KEYS + [\"mask_regime\"]].copy()\n    result[\"weekday\"] = result[\"timestamp\"].dt.dayofweek\n    result[\"minute_of_day\"] = (\n        result[\"timestamp\"].dt.hour * 60\n        + result[\"timestamp\"].dt.minute\n    )\n\n    result = result.merge(\n        by_link_week_min,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_profile\"),\n    )\n\n    result = result.merge(\n        by_link_week,\n        on=[\"link_id\", \"weekday\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_week\"),\n    )\n\n    result = result.merge(\n        by_link,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n        suffixes=(\"\", \"_link\"),\n    )\n\n    # Fill minute-profile gaps with link-week values, then link-wide.\n    for col in VALUE_COLS:\n        week_col = f\"{col}_week\"\n        link_col = f\"{col}_link\"\n\n        result[col] = (\n            result[col]\n            .fillna(result[week_col])\n            .fillna(result[link_col])\n        )\n\n    if result[VALUE_COLS].isna().any().any():\n        missing = int(result[VALUE_COLS].isna().any(axis=1).sum())\n        raise ValueError(\n            f\"{missing:,} targets have no historical baseline.\"\n        )\n\n    return result[KEYS + [\"mask_regime\"] + VALUE_COLS]\n\n\nprint(\"Building past-only baselines...\")\nbaseline_train = build_baseline(train_targets, HOLDOUT_START)\nbaseline_holdout = build_baseline(holdout_targets, HOLDOUT_START)\n\n# For training targets, use the December 1 cutoff for December\n# and the January 1 cutoff for January.\n# Rebuild January baselines separately to avoid using January data\n# to construct January baseline features.\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n\ndec_mask = train_targets[\"timestamp\"] < jan_start\njan_mask = ~dec_mask\n\nbaseline_train = pd.concat(\n    [\n        build_baseline(\n            train_targets.loc[dec_mask],\n            TRAIN_START,\n        ),\n        build_baseline(\n            train_targets.loc[jan_mask],\n            jan_start,\n        ),\n    ],\n    ignore_index=True,\n)\n\n# -----------------------------\n# 6. Merge baseline values and labels\n# -----------------------------\n\ndef attach_baseline(targets, baseline):\n    return targets.merge(\n        baseline.rename(columns={\n            \"speed_kmh\": \"base_speed\",\n            \"flow_vph\": \"base_flow\",\n        }),\n        on=KEYS + [\"mask_regime\"],\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\ntrain_data = attach_baseline(train_targets, baseline_train)\nholdout_data = attach_baseline(holdout_targets, baseline_holdout)\n\nfor name, frame in [\n    (\"train\", train_data),\n    (\"holdout\", holdout_data),\n]:\n    if frame[[\"base_speed\", \"base_flow\"]].isna().any().any():\n        raise ValueError(f\"{name}: baseline join left missing values.\")\n\n# -----------------------------\n# 7. Lag features from masked inputs only\n# -----------------------------\n\nmasked_lookup = masked[KEYS + VALUE_COLS].copy()\n\n# Preserve the observed series. Target truth values are never used\n# as lag inputs; lag lookups come exclusively from masked data.\nmasked_lookup = masked_lookup.rename(columns={\n    \"speed_kmh\": \"masked_speed\",\n    \"flow_vph\": \"masked_flow\",\n})\n\ndef add_lags(frame):\n    result = frame.copy()\n\n    for minutes in [5, 15, 60, 1440]:\n        lookup = masked_lookup.copy()\n        lookup[\"timestamp\"] = (\n            lookup[\"timestamp\"]\n            + pd.Timedelta(minutes=minutes)\n        )\n\n        lookup = lookup.rename(columns={\n            \"masked_speed\": f\"lag_speed_{minutes}\",\n            \"masked_flow\": f\"lag_flow_{minutes}\",\n        })\n\n        result = result.merge(\n            lookup,\n            on=KEYS,\n            how=\"left\",\n            validate=\"one_to_one\",\n        )\n\n        del lookup\n\n    return result\n\nprint(\"Building lag features...\")\ntrain_data = add_lags(train_data)\nholdout_data = add_lags(holdout_data)\n\n# -----------------------------\n# 8. Time and categorical ID features\n# -----------------------------\n\ndef add_model_features(frame):\n    result = frame.copy()\n\n    ts = result[\"timestamp\"]\n    weekday = ts.dt.dayofweek.to_numpy()\n    minute = (\n        ts.dt.hour.to_numpy() * 60\n        + ts.dt.minute.to_numpy()\n    )\n\n    result[\"weekday\"] = weekday\n    result[\"minute_of_day\"] = minute\n    result[\"tod_sin\"] = np.sin(2 * np.pi * minute / 1440)\n    result[\"tod_cos\"] = np.cos(2 * np.pi * minute / 1440)\n    result[\"weekday_sin\"] = np.sin(2 * np.pi * weekday / 7)\n    result[\"weekday_cos\"] = np.cos(2 * np.pi * weekday / 7)\n\n    # Encode IDs consistently across train and holdout.\n    # IDs remain strings in all joins.\n    return result\n\ntrain_data = add_model_features(train_data)\nholdout_data = add_model_features(holdout_data)\n\n# Map categories jointly so train and holdout share the same codes.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    combined = pd.concat(\n        [train_data[col], holdout_data[col]],\n        ignore_index=True,\n    ).astype(\"string\")\n    categories = pd.Index(combined.dropna().unique())\n\n    train_data[col + \"_code\"] = pd.Categorical(\n        train_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\n    holdout_data[col + \"_code\"] = pd.Categorical(\n        holdout_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nif len(FEATURES) != 19:\n    raise AssertionError(\"Expected exactly 19 features.\")\n\nX_train = train_data[FEATURES].replace([np.inf, -np.inf], np.nan)\nX_holdout = holdout_data[FEATURES].replace([np.inf, -np.inf], np.nan)\n\nprint(\"Feature matrices:\", X_train.shape, X_holdout.shape)\n\n# -----------------------------\n# 9. Fit residual models\n# -----------------------------\n\nmodel_params = dict(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\n# Impute missing lag values using training medians.\n# This is explicit to make the reconstructed pipeline reproducible.\nimputer = SimpleImputer(strategy=\"median\")\nX_train_i = imputer.fit_transform(X_train)\nX_holdout_i = imputer.transform(X_holdout)\n\ny_speed_resid = (\n    train_data[\"speed_kmh\"].to_numpy()\n    - train_data[\"base_speed\"].to_numpy()\n)\ny_flow_resid = (\n    train_data[\"flow_vph\"].to_numpy()\n    - train_data[\"base_flow\"].to_numpy()\n)\n\nprint(\"Fitting speed residual model...\")\nspeed_model = HistGradientBoostingRegressor(**model_params)\nspeed_model.fit(X_train_i, y_speed_resid)\n\nprint(\"Fitting flow residual model...\")\nflow_model = HistGradientBoostingRegressor(**model_params)\nflow_model.fit(X_train_i, y_flow_resid)\n\npred_speed = np.clip(\n    holdout_data[\"base_speed\"].to_numpy()\n    + speed_model.predict(X_holdout_i),\n    0,\n    160,\n)\npred_flow = np.clip(\n    holdout_data[\"base_flow\"].to_numpy()\n    + flow_model.predict(X_holdout_i),\n    0,\n    None,\n)\n\n# -----------------------------\n# 10. Score by official regime metric\n# -----------------------------\n\nevaluation = holdout_data[\n    KEYS + [\"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].copy()\n\nevaluation = evaluation.merge(\n    links,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nif evaluation[\"lanes\"].isna().any():\n    raise ValueError(\"Missing lane metadata during scoring.\")\n\nevaluation[\"baseline_speed_pred\"] = holdout_data[\"base_speed\"].to_numpy()\nevaluation[\"baseline_flow_pred\"] = holdout_data[\"base_flow\"].to_numpy()\nevaluation[\"residual_speed_pred\"] = pred_speed\nevaluation[\"residual_flow_pred\"] = pred_flow\n\ndef calculate_metrics(frame, prediction_prefix):\n    actual_speed = frame[\"speed_kmh\"].to_numpy()\n    actual_flow_lane = (\n        frame[\"flow_vph\"].to_numpy() / frame[\"lanes\"].to_numpy()\n    )\n\n    predicted_speed = frame[f\"{prediction_prefix}_speed_pred\"].to_numpy()\n    predicted_flow_lane = (\n        frame[f\"{prediction_prefix}_flow_pred\"].to_numpy()\n        / frame[\"lanes\"].to_numpy()\n    )\n\n    rmse_speed = float(\n        np.sqrt(np.mean((actual_speed - predicted_speed) ** 2))\n    )\n    rmse_flow_lane = float(\n        np.sqrt(np.mean((actual_flow_lane - predicted_flow_lane) ** 2))\n    )\n\n    speed_score = max(0.0, 1 - rmse_speed / 25)\n    flow_score = max(0.0, 1 - rmse_flow_lane / 600)\n    state_score = 0.54 * speed_score + 0.46 * flow_score\n\n    return {\n        \"targets\": len(frame),\n        \"speed_rmse\": rmse_speed,\n        \"flow_rmse_per_lane\": rmse_flow_lane,\n        \"score\": state_score,\n    }\n\nmetric_rows = []\n\nfor method in [\"baseline\", \"residual\"]:\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        subset = evaluation.loc[\n            evaluation[\"mask_regime\"].astype(\"string\") == regime\n        ]\n\n        if subset.empty:\n            raise ValueError(f\"No holdout targets for regime {regime}\")\n\n        metrics = calculate_metrics(subset, method)\n        metric_rows.append({\n            \"method\": method,\n            \"regime\": regime,\n            **metrics,\n        })\n\n    regime_scores = [\n        row[\"score\"]\n        for row in metric_rows\n        if row[\"method\"] == method\n    ]\n\n    metric_rows.append({\n        \"method\": method,\n        \"regime\": \"MACRO\",\n        \"targets\": len(evaluation),\n        \"speed_rmse\": np.nan,\n        \"flow_rmse_per_lane\": np.nan,\n        \"score\": float(np.mean(regime_scores)),\n    })\n\nmetrics = pd.DataFrame(metric_rows)\nprint(\"\\nBENCHMARK RESULTS\")\nprint(metrics.to_string(index=False))\n\nmetrics.to_csv(OUT / \"benchmark_gate_metrics.csv\", index=False)\n\n# Save predictions for further diagnosis.\nevaluation[\n    KEYS + [\n        \"mask_regime\", \"lanes\", \"speed_kmh\", \"flow_vph\",\n        \"baseline_speed_pred\", \"baseline_flow_pred\",\n        \"residual_speed_pred\", \"residual_flow_pred\",\n    ]\n].to_csv(OUT / \"benchmark_gate_predictions.csv\", index=False)\n\nbaseline_macro = float(\n    metrics.loc[\n        (metrics[\"method\"] == \"baseline\")\n        & (metrics[\"regime\"] == \"MACRO\"),\n        \"score\",\n    ].iloc[0]\n)\nresidual_macro = float(\n    metrics.loc[\n        (metrics[\"method\"] == \"residual\")\n        & (metrics[\"regime\"] == \"MACRO\"),\n        \"score\",\n    ].iloc[0]\n)\n\nsummary = {\n    \"panel\": PANEL,\n    \"training_targets\": len(train_data),\n    \"february_holdout_targets\": len(holdout_data),\n    \"feature_count\": len(FEATURES),\n    \"baseline_macro\": baseline_macro,\n    \"residual_macro\": residual_macro,\n    \"score_gain\": residual_macro - baseline_macro,\n    \"expected_baseline_macro\": EXPECTED_BASELINE_MACRO,\n    \"expected_residual_macro\": EXPECTED_RESIDUAL_MACRO,\n    \"baseline_within_tolerance\": (\n        abs(baseline_macro - EXPECTED_BASELINE_MACRO) <= SCORE_TOLERANCE\n    ),\n    \"residual_within_tolerance\": (\n        abs(residual_macro - EXPECTED_RESIDUAL_MACRO) <= SCORE_TOLERANCE\n    ),\n}\n\nwith open(OUT / \"benchmark_gate_summary.json\", \"w\") as f:\n    json.dump(summary, f, indent=2)\n\nprint(\"\\nBENCHMARK GATE SUMMARY\")\nprint(json.dumps(summary, indent=2))\nprint(\"\\nArtifacts saved in:\", OUT)\n\nif (\n    summary[\"baseline_within_tolerance\"]\n    and summary[\"residual_within_tolerance\"]\n):\n    print(\n        \"\\nGATE RESULT: PASS — scores match the recorded benchmark \"\n        \"within the configured tolerance. Review implementation \"\n        \"differences before scaling to all panels.\"\n    )\nelse:\n    print(\n        \"\\nGATE RESULT: NOT PASSED — do not scale to other panels yet. \"\n        \"Compare the baseline and residual metrics with Stage 1.\"\n    )\n\n# Release large objects after saving results.\ndel X_train_i, X_holdout_i\ngc.collect()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:54:44.09286Z","iopub.execute_input":"2026-10-19T13:54:44.093505Z","iopub.status.idle":"2026-10-19T13:57:54.861206Z","shell.execute_reply.started":"2026-10-19T13:54:44.093467Z","shell.execute_reply":"2026-10-19T13:57:54.859862Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\n# Normalize source keys.\nmasked_check = masked[KEYS + [\"speed_kmh\", \"flow_vph\"]].copy()\nmasked_check[\"timestamp\"] = pd.to_datetime(\n    masked_check[\"timestamp\"], utc=True\n)\nfor col in [\"station_id\", \"link_id\"]:\n    masked_check[col] = masked_check[col].astype(\"string\").str.strip()\n\nif masked_check.duplicated(KEYS).any():\n    raise ValueError(\"Masked source contains duplicate keys.\")\n\ntargets_check = features[KEYS].copy().reset_index(drop=True)\ntargets_check[\"timestamp\"] = pd.to_datetime(\n    targets_check[\"timestamp\"], utc=True\n)\nfor col in [\"station_id\", \"link_id\"]:\n    targets_check[col] = targets_check[col].astype(\"string\").str.strip()\n\n# Match the original source's masked lookup filtering.\nmin_time = targets_check[\"timestamp\"].min() - pd.Timedelta(days=1)\nmax_time = targets_check[\"timestamp\"].max()\n\nmasked_check = masked_check.loc[\n    masked_check[\"timestamp\"].between(min_time, max_time)\n].copy()\n\nmasked_check = masked_check.loc[\n    masked_check[\"speed_kmh\"].notna()\n    | masked_check[\"flow_vph\"].notna()\n].copy()\n\nprint(\"Target rows:\", len(targets_check))\nprint(\"Masked lookup rows:\", len(masked_check))\nprint(\"\\n=== INDEPENDENT LAG COMPARISON ===\")\n\nfor lag in LAGS:\n    lookup = targets_check.copy()\n    lookup[\"timestamp\"] -= pd.Timedelta(minutes=lag)\n\n    source = masked_check.rename(\n        columns={\n            \"speed_kmh\": \"rebuilt_speed\",\n            \"flow_vph\": \"rebuilt_flow\",\n        }\n    )\n\n    rebuilt = lookup.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n        sort=False,\n    )\n\n    for kind, rebuilt_col in [\n        (\"speed\", \"rebuilt_speed\"),\n        (\"flow\", \"rebuilt_flow\"),\n    ]:\n        current_col = f\"lag{lag}_{kind}\"\n\n        a = rebuilt[rebuilt_col].to_numpy(dtype=float)\n        b = features[current_col].to_numpy(dtype=float)\n\n        same_missing = np.array_equal(np.isnan(a), np.isnan(b))\n        valid = np.isfinite(a) & np.isfinite(b)\n\n        max_diff = (\n            float(np.max(np.abs(a[valid] - b[valid])))\n            if valid.any() else 0.0\n        )\n\n        matches = (\n            same_missing\n            and np.allclose(a[valid], b[valid], rtol=0, atol=1e-10)\n        )\n\n        print(\n            f\"Lag {lag:4d} {kind:5s}: \"\n            f\"missing_pattern_match={same_missing}, \"\n            f\"max_abs_diff={max_diff:.12g}, \"\n            f\"matches={matches}\"\n        )\n\nprint(\"\\nFinished. No models were trained.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:40:13.904572Z","iopub.execute_input":"2026-10-19T14:40:13.905045Z","iopub.status.idle":"2026-10-19T14:40:31.40124Z","shell.execute_reply.started":"2026-10-19T14:40:13.905013Z","shell.execute_reply":"2026-10-19T14:40:31.399921Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nTEMPLATE_PATH = (\n    ROOT / \"task1\" / \"D7_I405_S\" / \"train\"\n    / \"sample_submission_state.csv\"\n)\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ntemplate_check = pd.read_csv(TEMPLATE_PATH)\ntemplate_check[\"timestamp\"] = pd.to_datetime(\n    template_check[\"timestamp\"], utc=True\n)\n\nfor df in (template_check, train_data, holdout_data):\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    for col in [\"station_id\", \"link_id\"]:\n        df[col] = df[col].astype(\"string\").str.strip()\n\ntemplate_check = template_check.loc[\n    template_check[\"timestamp\"].ge(pd.Timestamp(\"2030-12-01\", tz=\"UTC\"))\n    & template_check[\"timestamp\"].lt(pd.Timestamp(\"2031-02-01\", tz=\"UTC\")),\n    KEYS,\n].copy()\n\ncurrent_train_keys = train_data[KEYS].reset_index(drop=True)\ntemplate_train_keys = template_check.reset_index(drop=True)\n\nprint(\"=== TRAINING ROW ORDER ===\")\nprint(\"Current rows:\", len(current_train_keys))\nprint(\"Template rows:\", len(template_train_keys))\nprint(\n    \"Same row-by-row order:\",\n    current_train_keys.equals(template_train_keys),\n)\n\nif len(current_train_keys) == len(template_train_keys):\n    row_match = (\n        current_train_keys.eq(template_train_keys).all(axis=1)\n    )\n    print(\"Rows matching at same position:\", int(row_match.sum()))\n    print(\"First differing positions:\", row_match.index[~row_match][:10].tolist())\n\nprint(\"\\n=== FIRST 5 KEYS ===\")\nprint(\"\\nCurrent training data:\")\nprint(current_train_keys.head().to_string(index=False))\nprint(\"\\nOfficial template:\")\nprint(template_train_keys.head().to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:42:39.079737Z","iopub.execute_input":"2026-10-19T14:42:39.080989Z","iopub.status.idle":"2026-10-19T14:42:43.067266Z","shell.execute_reply.started":"2026-10-19T14:42:39.080888Z","shell.execute_reply":"2026-10-19T14:42:43.065983Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\nprint(\"=== CURRENT MODEL INPUT AUDIT ===\")\n\nprint(\"\\nFeature order:\")\nprint(list(X_train.columns))\n\nprint(\"\\nFeature dtypes:\")\nprint(X_train.dtypes.to_string())\n\nprint(\"\\nTraining matrix:\")\nprint(\"Shape:\", X_train.shape)\nprint(\"Missing cells:\", int(X_train.isna().sum().sum()))\nprint(\"Infinite cells:\", int(np.isinf(X_train.to_numpy(dtype=float)).sum()))\n\nprint(\"\\nHoldout matrix:\")\nprint(\"Shape:\", X_holdout.shape)\nprint(\"Missing cells:\", int(X_holdout.isna().sum().sum()))\nprint(\"Infinite cells:\", int(np.isinf(X_holdout.to_numpy(dtype=float)).sum()))\n\nprint(\"\\nResidual target dtypes and statistics:\")\nfor name, values in [\n    (\"speed\", y_speed),\n    (\"flow\", y_flow),\n]:\n    values = np.asarray(values)\n    print(\n        name,\n        \"| dtype:\", values.dtype,\n        \"| rows:\", len(values),\n        \"| mean:\", float(np.nanmean(values)),\n        \"| std:\", float(np.nanstd(values)),\n    )\n\nprint(\"\\n=== TIME FEATURE CHECK ===\")\ntime_features = [\n    (\"weekday\", \"weekday\", lambda t: t.dt.dayofweek),\n    (\"minute_of_day\", \"minute_of_day\",\n     lambda t: t.dt.hour * 60 + t.dt.minute),\n]\n\nfor actual_col, _, expected_fn in time_features:\n    actual = train_data[actual_col].to_numpy()\n    expected = expected_fn(train_data[\"timestamp\"])\n    expected = expected.to_numpy()\n    equal = np.array_equal(actual, expected)\n    print(f\"{actual_col}: matches timestamp calculation = {equal}\")\n\nprint(\"\\n=== MODEL CONFIGURATION ===\")\nprint(\"Speed model:\", speed_model.get_params())\nprint(\"Speed iterations:\", getattr(speed_model, \"n_iter_\", None))\nprint(\"Flow iterations:\", getattr(flow_model, \"n_iter_\", None))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:44:36.2506Z","iopub.execute_input":"2026-10-19T14:44:36.251239Z","iopub.status.idle":"2026-10-19T14:44:36.454551Z","shell.execute_reply.started":"2026-10-19T14:44:36.251204Z","shell.execute_reply":"2026-10-19T14:44:36.452743Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\n\nprint(\"=== CATEGORY CODE VERIFICATION ===\")\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    code_col = f\"{col}_code\"\n\n    combined = pd.concat(\n        [\n            train_data[col],\n            holdout_data[col],\n        ],\n        ignore_index=True,\n    ).astype(\"string\")\n\n    categories = pd.Index(combined.dropna().unique())\n\n    expected_train = pd.Categorical(\n        train_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\n    expected_holdout = pd.Categorical(\n        holdout_data[col].astype(\"string\"),\n        categories=categories,\n    ).codes\n\n    actual_train = train_data[code_col].to_numpy()\n    actual_holdout = holdout_data[code_col].to_numpy()\n\n    print(f\"\\n{col}:\")\n    print(\n        \"Train mapping matches:\",\n        np.array_equal(actual_train, expected_train),\n    )\n    print(\n        \"Holdout mapping matches:\",\n        np.array_equal(actual_holdout, expected_holdout),\n    )\n    print(\"Unique train codes:\", len(np.unique(actual_train)))\n    print(\"Unique holdout codes:\", len(np.unique(actual_holdout)))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:45:06.397885Z","iopub.execute_input":"2026-10-19T14:45:06.399465Z","iopub.status.idle":"2026-10-19T14:45:06.943294Z","shell.execute_reply.started":"2026-10-19T14:45:06.39942Z","shell.execute_reply":"2026-10-19T14:45:06.941891Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\nprint(\"=== ORIGINAL VS CURRENT CATEGORY ENCODING ===\")\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    current_col = f\"{col}_code\"\n\n    # Encoding used in the recovered original source.\n    original_train_codes = (\n        train_data[col].astype(\"category\").cat.codes.to_numpy()\n    )\n    original_holdout_codes = (\n        holdout_data[col].astype(\"category\").cat.codes.to_numpy()\n    )\n\n    current_train_codes = train_data[current_col].to_numpy()\n    current_holdout_codes = holdout_data[current_col].to_numpy()\n\n    print(f\"\\n{col}:\")\n    print(\n        \"Train codes identical:\",\n        np.array_equal(original_train_codes, current_train_codes),\n    )\n    print(\n        \"Holdout codes identical:\",\n        np.array_equal(original_holdout_codes, current_holdout_codes),\n    )\n\n    pairs = pd.DataFrame({\n        \"id\": train_data[col].astype(\"string\"),\n        \"original_code\": original_train_codes,\n        \"current_code\": current_train_codes,\n    }).drop_duplicates()\n\n    print(\"IDs with different codes:\", int(\n        (pairs[\"original_code\"] != pairs[\"current_code\"]).sum()\n    ))\n    print(pairs.head(5).to_string(index=False))\n\nprint(\"\\n=== ORIGINAL FEATURE MATRIX PRECISION ===\")\nprint(\"Current X_train dtype counts:\")\nprint(X_train.dtypes.astype(str).value_counts().to_string())\n\nprint(\"\\nOriginal experiment used X_all.astype('float32').\")\nprint(\"No model has been retrained by this diagnostic.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:46:04.866189Z","iopub.execute_input":"2026-10-19T14:46:04.867604Z","iopub.status.idle":"2026-10-19T14:46:05.42188Z","shell.execute_reply.started":"2026-10-19T14:46:04.86756Z","shell.execute_reply":"2026-10-19T14:46:05.420926Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Rebuild original-style feature matrices without modifying X_train.\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nX_train_original_style = X_train.copy()\nX_holdout_original_style = X_holdout.copy()\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    code_col = f\"{col}_code\"\n\n    X_train_original_style[code_col] = (\n        train_data[col].astype(\"category\").cat.codes.to_numpy()\n    )\n    X_holdout_original_style[code_col] = (\n        holdout_data[col].astype(\"category\").cat.codes.to_numpy()\n    )\n\nX_train_original_style = X_train_original_style[FEATURES].astype(\"float32\")\nX_holdout_original_style = X_holdout_original_style[FEATURES].astype(\"float32\")\n\nprint(\"Original-style train shape:\", X_train_original_style.shape)\nprint(\"Original-style holdout shape:\", X_holdout_original_style.shape)\nprint(\"Train dtype:\", X_train_original_style.dtypes.unique())\nprint(\"Holdout dtype:\", X_holdout_original_style.dtypes.unique())\nprint(\"Train missing cells:\", int(X_train_original_style.isna().sum().sum()))\nprint(\"Holdout missing cells:\", int(X_holdout_original_style.isna().sum().sum()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:46:47.180222Z","iopub.execute_input":"2026-10-19T14:46:47.18063Z","iopub.status.idle":"2026-10-19T14:46:47.547853Z","shell.execute_reply.started":"2026-10-19T14:46:47.180602Z","shell.execute_reply":"2026-10-19T14:46:47.546779Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nimport numpy as np\n\noriginal_params = {\n    \"learning_rate\": 0.06,\n    \"max_iter\": 150,\n    \"max_leaf_nodes\": 31,\n    \"l2_regularization\": 5.0,\n    \"early_stopping\": True,\n    \"validation_fraction\": 0.1,\n    \"n_iter_no_change\": 15,\n    \"random_state\": 42,\n}\n\n# Use the existing residual targets, preserving their current precision.\nspeed_model_original_style = HistGradientBoostingRegressor(**original_params)\nflow_model_original_style = HistGradientBoostingRegressor(**original_params)\n\nspeed_model_original_style.fit(X_train_original_style, y_speed)\nflow_model_original_style.fit(X_train_original_style, y_flow)\n\npred_speed_original_style = np.clip(\n    holdout_data[\"base_speed\"].to_numpy(dtype=float)\n    + speed_model_original_style.predict(X_holdout_original_style),\n    0.0,\n    160.0,\n)\n\npred_flow_original_style = np.clip(\n    holdout_data[\"base_flow\"].to_numpy(dtype=float)\n    + flow_model_original_style.predict(X_holdout_original_style),\n    0.0,\n    None,\n)\n\nprint(\"Speed model iterations:\", speed_model_original_style.n_iter_)\nprint(\"Flow model iterations:\", flow_model_original_style.n_iter_)\nprint(\"Speed predictions:\", pred_speed_original_style.shape)\nprint(\"Flow predictions:\", pred_flow_original_style.shape)\nprint(\"Speed prediction mean:\", float(pred_speed_original_style.mean()))\nprint(\"Flow prediction mean:\", float(pred_flow_original_style.mean()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:47:19.208275Z","iopub.execute_input":"2026-10-19T14:47:19.208682Z","iopub.status.idle":"2026-10-19T14:47:37.33356Z","shell.execute_reply.started":"2026-10-19T14:47:19.208654Z","shell.execute_reply":"2026-10-19T14:47:37.332414Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nevaluation = holdout_data[\n    [\"mask_regime\", \"speed_kmh\", \"flow_vph\", \"base_speed\", \"base_flow\"]\n].copy()\n\nevaluation[\"pred_speed\"] = pred_speed_original_style\nevaluation[\"pred_flow\"] = pred_flow_original_style\n\nevaluation = evaluation.join(\n    holdout_data[\"link_id\"].rename(\"link_id\")\n)\nevaluation = evaluation.merge(\n    links[[\"link_id\", \"lanes\"]],\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nresults = []\n\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    part = evaluation[evaluation[\"mask_regime\"] == regime]\n\n    speed_rmse = np.sqrt(np.mean(\n        (part[\"speed_kmh\"] - part[\"pred_speed\"]) ** 2\n    ))\n\n    flow_rmse_lane = np.sqrt(np.mean(\n        (\n            (part[\"flow_vph\"] - part[\"pred_flow\"]) / part[\"lanes\"]\n        ) ** 2\n    ))\n\n    score = (\n        0.54 * max(0, 1 - speed_rmse / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n    )\n\n    results.append({\n        \"regime\": regime,\n        \"speed_RMSE\": speed_rmse,\n        \"flow_RMSE_per_lane\": flow_rmse_lane,\n        \"score\": score,\n    })\n\nmetrics_original_style = pd.DataFrame(results)\n\nprint(metrics_original_style.to_string(index=False))\nprint(f\"\\nOriginal-style macro score: {metrics_original_style['score'].mean():.6f}\")\nprint(\"Reference macro score:     0.825718\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:48:38.63651Z","iopub.execute_input":"2026-10-19T14:48:38.636883Z","iopub.status.idle":"2026-10-19T14:48:38.858248Z","shell.execute_reply.started":"2026-10-19T14:48:38.636854Z","shell.execute_reply":"2026-10-19T14:48:38.856776Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nprint(\"Feature table:\", features.shape)\nprint(\"Feature columns:\", features.columns.tolist())\nprint(\"Validation template available:\", \"validation_template\" in globals())\nprint(\"Masked data available:\", \"masked\" in globals())\nprint(\"Truth data available:\", \"truth\" in globals())\nprint(\"Link metadata available:\", \"links\" in globals())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:50:16.241143Z","iopub.execute_input":"2026-10-19T14:50:16.24231Z","iopub.status.idle":"2026-10-19T14:50:16.252743Z","shell.execute_reply.started":"2026-10-19T14:50:16.242265Z","shell.execute_reply":"2026-10-19T14:50:16.250511Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nprint(\"Feature timestamp dtype:\", features[\"timestamp\"].dtype)\nprint(\"Feature timestamp minimum:\", features[\"timestamp\"].min())\nprint(\"Feature timestamp maximum:\", features[\"timestamp\"].max())\n\nprint(\"\\nTarget month values:\")\nprint(features[\"target_month\"].value_counts(dropna=False).sort_index().to_string())\n\nprint(\"\\nValidation timestamp range:\")\nprint(validation_targets[\"timestamp\"].min())\nprint(validation_targets[\"timestamp\"].max())\n\nprint(\"\\nExisting model-related variables:\")\nfor name in [\n    \"speed_model_original_style\",\n    \"flow_model_original_style\",\n    \"X_train_original_style\",\n    \"X_holdout_original_style\",\n    \"FEATURES\",\n    \"LAGS_MINUTES\",\n]:\n    print(f\"{name}: {name in globals()}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:51:37.895677Z","iopub.execute_input":"2026-10-19T14:51:37.897587Z","iopub.status.idle":"2026-10-19T14:51:37.968462Z","shell.execute_reply.started":"2026-10-19T14:51:37.897538Z","shell.execute_reply":"2026-10-19T14:51:37.967098Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfor name in [\"history\", \"masked\", \"truth\", \"features\", \"validation_targets\"]:\n    if name not in globals():\n        print(f\"{name}: NOT FOUND\")\n        continue\n\n    obj = globals()[name]\n    print(f\"\\n{name}: type={type(obj).__name__}\")\n\n    if isinstance(obj, pd.DataFrame):\n        print(\"  shape:\", obj.shape)\n        print(\"  columns:\", obj.columns.tolist())\n        if \"timestamp\" in obj.columns and len(obj):\n            print(\"  timestamp range:\",\n                  obj[\"timestamp\"].min(), \"to\", obj[\"timestamp\"].max())\n\n    elif isinstance(obj, list):\n        print(\"  length:\", len(obj))\n        if obj:\n            print(\"  first item type:\", type(obj[0]).__name__)\n            if isinstance(obj[0], pd.DataFrame):\n                print(\"  first item shape:\", obj[0].shape)\n                print(\"  first item columns:\", obj[0].columns.tolist())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T14:53:19.153193Z","iopub.execute_input":"2026-10-19T14:53:19.153662Z","iopub.status.idle":"2026-10-19T14:53:19.269933Z","shell.execute_reply.started":"2026-10-19T14:53:19.15363Z","shell.execute_reply":"2026-10-19T14:53:19.268609Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nevaluation = holdout_data.reset_index(drop=True)[\n    [\"mask_regime\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].copy()\n\nevaluation[\"pred_speed\"] = pred_speed_original_style\nevaluation[\"pred_flow\"] = pred_flow_original_style\n\nevaluation = evaluation.merge(\n    links[[\"link_id\", \"lanes\"]],\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nassert evaluation[\"lanes\"].notna().all(), \"Missing lane counts\"\n\nresults = []\n\nfor regime, group in evaluation.groupby(\"mask_regime\"):\n    speed_rmse = np.sqrt(\n        np.mean((group[\"speed_kmh\"] - group[\"pred_speed\"]) ** 2)\n    )\n\n    flow_rmse_lane = np.sqrt(\n        np.mean(\n            ((group[\"flow_vph\"] - group[\"pred_flow\"]) / group[\"lanes\"]) ** 2\n        )\n    )\n\n    speed_score = max(0, 1 - speed_rmse / 25)\n    flow_score = max(0, 1 - flow_rmse_lane / 600)\n    score = 0.54 * speed_score + 0.46 * flow_score\n\n    results.append({\n        \"regime\": regime,\n        \"rows\": len(group),\n        \"speed_rmse\": speed_rmse,\n        \"flow_rmse_per_lane\": flow_rmse_lane,\n        \"score\": score\n    })\n\nresults_df = pd.DataFrame(results)\n\nprint(results_df.to_string(index=False))\nprint(f\"\\nFebruary Macro Score: {results_df['score'].mean():.9f}\")\nprint(\"Original reference: 0.825718402\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:02:09.051863Z","iopub.execute_input":"2026-10-19T15:02:09.052375Z","iopub.status.idle":"2026-10-19T15:02:09.259092Z","shell.execute_reply.started":"2026-10-19T15:02:09.052345Z","shell.execute_reply":"2026-10-19T15:02:09.25763Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom sklearn.metrics import mean_squared_error\n\nDATA = Path(\"/kaggle/input/competitions/2026-iee