   <td>7.48</td>\n    </tr>\n    <tr>\n      <th>58</th>\n      <td>L405S-193</td>\n      <td>1034</td>\n      <td>866</td>\n      <td>0.07</td>\n      <td>-6.89</td>\n      <td>-6.96</td>\n      <td>0.00</td>\n      <td>10.16</td>\n      <td>10.16</td>\n    </tr>\n    <tr>\n      <th>100</th>\n      <td>L405S-413</td>\n      <td>1019</td>\n      <td>857</td>\n      <td>0.06</td>\n      <td>-6.62</td>\n      <td>-6.68</td>\n      <td>0.00</td>\n      <td>9.68</td>\n      <td>9.68</td>\n    </tr>\n    <tr>\n      <th>59</th>\n      <td>L405S-194</td>\n      <td>998</td>\n      <td>890</td>\n      <td>-0.30</td>\n      <td>-6.97</td>\n      <td>-6.67</td>\n      <td>2.40</td>\n      <td>11.80</td>\n      <td>9.39</td>\n    </tr>\n    <tr>\n      <th>52</th>\n      <td>L405S-175</td>\n      <td>924</td>\n      <td>862</td>\n      <td>-0.12</td>\n      <td>-6.76</td>\n      <td>-6.64</td>\n      <td>1.95</td>\n      <td>12.06</td>\n      <td>10.12</td>\n    </tr>\n    <tr>\n      <th>51</th>\n      <td>L405S-173</td>\n      <td>978</td>\n      <td>834</td>\n      <td>0.84</td>\n      <td>-5.76</td>\n      <td>-6.60</td>\n      <td>2.04</td>\n      <td>8.63</td>\n      <td>6.59</td>\n    </tr>\n    <tr>\n      <th>89</th>\n      <td>L405S-334</td>\n      <td>999</td>\n      <td>868</td>\n      <td>0.71</td>\n      <td>-5.74</td>\n      <td>-6.45</td>\n      <td>3.90</td>\n      <td>10.25</td>\n      <td>6.35</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":101},{"cell_type":"code","source":"# R2 correction shift by day of month: February vs April\n\ndef daily_r2_corrections(frame, correction, period):\n    mask = frame[\"mask_regime\"].eq(\"R2\")\n    df = frame.loc[mask, [\"timestamp\"]].copy()\n    df[\"correction\"] = np.asarray(correction)[mask.to_numpy()]\n    df[\"day\"] = df[\"timestamp\"].dt.day\n    df[\"period\"] = period\n\n    return (\n        df.groupby([\"period\", \"day\"], observed=True)\n        .agg(\n            rows=(\"correction\", \"size\"),\n            mean_correction=(\"correction\", \"mean\"),\n            negative30_rate_pct=(\n                \"correction\", lambda x: 100 * (x < -30).mean()\n            ),\n        )\n        .reset_index()\n    )\n\nfeb_daily = daily_r2_corrections(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_daily = daily_r2_corrections(\n    private_features,\n    (\n        private_submission[\"speed_kmh\"].to_numpy()\n        - private_features[\"base_speed\"].to_numpy()\n    ),\n    \"April\"\n)\n\ndaily_compare = feb_daily.merge(\n    apr_daily,\n    on=\"day\",\n    suffixes=(\"_feb\", \"_apr\"),\n    validate=\"one_to_one\"\n)\n\ndaily_compare[\"mean_correction_change\"] = (\n    daily_compare[\"mean_correction_apr\"]\n    - daily_compare[\"mean_correction_feb\"]\n)\n\ndisplay(\n    daily_compare[\n        [\n            \"day\", \"rows_feb\", \"rows_apr\",\n            \"mean_correction_feb\", \"mean_correction_apr\",\n            \"mean_correction_change\",\n            \"negative30_rate_pct_feb\", \"negative30_rate_pct_apr\"\n        ]\n    ]\n    .sort_values(\"mean_correction_change\")\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:06:23.595184Z","iopub.execute_input":"2026-10-19T16:06:23.596564Z","iopub.status.idle":"2026-10-19T16:06:23.736872Z","shell.execute_reply.started":"2026-10-19T16:06:23.596517Z","shell.execute_reply":"2026-10-19T16:06:23.735857Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"   day  rows_feb  rows_apr  mean_correction_feb  mean_correction_apr  \\\n0    9      7208      7215                -2.07                -7.86   \n3   20      7210      7219                 2.33                -1.99   \n1   15      7061      7298                 4.31                 2.25   \n2   18      7120      7307                -2.30                 0.69   \n4   24      7181      7291                -4.78                -0.43   \n\n 