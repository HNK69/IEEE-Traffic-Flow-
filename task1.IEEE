     0           0               0                     0                    0                  0                 0                            0\n D7_I405_S    private            0           0               0                     0                    0                  0                 0                            0\n\nTRAFFIC STATISTICS (combined by panel and feature):\n     panel                   feature     rows  non_null  mean_of_file_means        min  median_of_file_medians          max\nD12_I405_N density_occ_linear_vehpkm  6997536   5840684           38.394313   0.000000               43.405432   213.750000\nD12_I405_N                  flow_vph  6997536   5840684         4123.951561 338.608775             5015.210247 11876.439287\nD12_I405_N                 occupancy  6997536   5840684            0.134717   0.000000                0.152300     0.750000\nD12_I405_N              pct_observed  6997536   6997536           77.054356   0.000000              100.000000   100.000000\nD12_I405_N                 speed_kmh  6997536   5840684          113.613513   7.143023              115.269004   120.750000\nD12_I405_S density_occ_linear_vehpkm  3459456   2887529           42.589312   0.000000               49.672352   213.750000\nD12_I405_S                  flow_vph  3459456   2887529         4720.411288 358.907933             5714.793318 12503.791330\nD12_I405_S                 occupancy  3459456   2887529            0.149436   0.000000                0.174289     0.750000\nD12_I405_S              pct_observed  3459456   3459456           77.054356   0.000000              100.000000   100.000000\nD12_I405_S                 speed_kmh  3459456   2887529          114.261361   6.319896              114.951920   120.750000\n  D12_I5_N density_occ_linear_vehpkm 20284992  16931419           41.509016   0.000000               40.555048   213.750000\n  D12_I5_N                  flow_vph 20284992  16931419         4091.232360 445.605052             4764.737639 11195.175715\n  D12_I5_N                 occupancy 20284992  16931419            0.145646   0.000000                0.142298     0.750000\n  D12_I5_N              pct_observed 20284992  20284992           77.054347   0.000000              100.000000   100.000000\n  D12_I5_N                 speed_kmh 20284992  16931419          113.049186   5.168320              117.407036   120.750000\n  D12_I5_S density_occ_linear_vehpkm  7862400   6562566           44.214850   0.983128               41.158749   213.750000\n  D12_I5_S                  flow_vph  7862400   6562566         4256.999624 463.200623             4872.266840 11578.487396\n  D12_I5_S                 occupancy  7862400   6562566            0.155140   0.003450                0.144417     0.750000\n  D12_I5_S              pct_observed  7862400   7862400           77.054358   0.000000              100.000000   100.000000\n  D12_I5_S                 speed_kmh  7862400   6562566          112.034429   4.925969              117.508154   120.750000\n  D7_I10_E density_occ_linear_vehpkm 11479104   9581346           37.849688   2.421351               39.982037   213.750000\n  D7_I10_E                  flow_vph 11479104   9581346         3894.704033 645.884504             4533.811196  9492.715577\n  D7_I10_E                 occupancy 11479104   9581346            0.132806   0.008496                0.140288     0.750000\n  D7_I10_E              pct_observed 11479104  11479104           77.054354   0.000000              100.000000   100.000000\n  D7_I10_E                 speed_kmh 11479104   9581346          110.125272   5.808958              112.791306   120.750000\n  D7_I10_W density_occ_linear_vehpkm  8412768   7021945           35.464210   1.027294               40.386537   213.750000\n  D7_I10_W                  flow_vph  8412768   7021945         3997.821206 574.445352             4660.055436  9309.901135\n  D7_I10_W                 occupancy  8412768   7021945            0.124436   0.003605                0.141707     0.750000\n  D7_I10_W              pct_observed  8412768   8412768           77.054350   0.000000              100.000000   100.000000\n  D7_I10_W                 speed_kmh  8412768   7021945          113.530389   6.636371              114.388184   120.750000\n D7_I210_E density_occ_linear_vehpkm 23351328  19490820           29.091201   0.000000               34.780982   213.750000\n D7_I210_E                  flow_vph 23351328  19490820         3182.806171 391.188169             3956.151188  9831.139995\n D7_I210_E                 occupancy 23351328  19490820            0.102074   0.000000                0.122039     0.750000\n D7_I210_E              pct_observed 23351328  23351328           77.054352   0.000000              100.000000   100.000000\n D7_I210_E                 speed_kmh 23351328  19490820          112.745129   7.816415              113.487590   120.750000\n D7_I210_W density_occ_linear_vehpkm  6368544   5315678           35.395402   0.396849               33.963957   213.750000\n D7_I210_W                  flow_vph  6368544   5315678         3309.259800 475.351296             3901.826722  9665.672016\n D7_I210_W                 occupancy  6368544   5315678            0.124194   0.001392                0.119172     0.750000\n D7_I210_W              pct_observed  6368544   6368544           77.054345   0.000000              100.000000   100.000000\n D7_I210_W                 speed_kmh  6368544   5315678          109.200303   8.270603              115.178686   120.750000\n D7_I405_N density_occ_linear_vehpkm 27675648  23100231           50.803628   0.714118               44.368472   213.750000\n D7_I405_N                  flow_vph 27675648  23100231         4398.211110 535.216318             5031.035607 12347.243562\n D7_I405_N                 occupancy 27675648  23100231            0.178258   0.002506                0.155679     0.750000\n D7_I405_N              pct_observed 27675648  27675648           77.054350   0.000000              100.000000   100.000000\n D7_I405_N                 speed_kmh 27675648  23100231          105.693214   6.813087              113.082915   120.750000\n D7_I405_S density_occ_linear_vehpkm  8570016   7153197           44.447767   1.339292               44.116116   213.750000\n D7_I405_S                  flow_vph  8570016   7153197         4262.668119 562.685368             5018.343654  9779.207402\n D7_I405_S                 occupancy  8570016   7153197            0.155957   0.004699                0.154793     0.750000\n D7_I405_S              pct_observed  8570016   8570016           77.054359   0.000000              100.000000   100.000000\n D7_I405_S                 speed_kmh  8570016   7153197          108.688911   6.327092              112.880179   120.750000\n\nFlag consistency summary:\n     panel     rows  missing_true  observed_true  imputed_true  eligible_true  missing_and_observed\nD12_I405_N  6997536       1156852        5840684       2558178        5345830                     0\nD12_I405_S  3459456        571927        2887529       1264717        2642882                     0\n  D12_I5_N 20284992       3353573       16931419       7415842       15496899                     0\n  D12_I5_S  7862400       1299834        6562566       2874357        6006551                     0\n  D7_I10_E 11479104       1897758        9581346       4196561        8769564                     0\n  D7_I10_W  8412768       1390823        7021945       3075562        6427009                     0\n D7_I210_E 23351328       3860508       19490820       8536841       17839455                     0\n D7_I210_W  6368544       1052866        5315678       2328229        4865305                     0\n D7_I405_N 27675648       4575417       23100231      10117737       21143057                     0\n D7_I405_S  8570016       1416819        7153197       3133049        6547141                     0\n\n==============================================================================\nEDA AND MASKING AUDIT FINISHED\nReports directory: /kaggle/working/trafficflow_eda_audit\n - 04_mask_file_details.csv\n - 05_mask_group_summary.csv\n - 06_template_audit.csv\n - 07_truth_audit.csv\n - 08_traffic_statistics.csv\n - 09_flag_consistency.csv\n - 10_temporal_audit.csv\n - audit_manifest.json\n==============================================================================\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\n# ============================================================\n# TASK 1 — HISTORICAL PROFILE BASELINE EVALUATION\n# Panel: D7_I405_S | Holdout: February 2031\n# ============================================================\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nREGIMES = [\"R1\", \"R2\", \"R3\"]\n\nSTART = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nEND = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\n# ------------------------------------------------------------\n# 1. Load official holdout targets\n# ------------------------------------------------------------\ntemplate_path = (\n    ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n)\n\ntemplate = pd.read_csv(\n    template_path,\n    usecols=KEYS,\n    dtype={\"station_id\": str, \"link_id\": str},\n)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n\ntemplate = template.loc[\n    (template[\"timestamp\"] >= START)\n    & (template[\"timestamp\"] < END)\n].drop_duplicates(KEYS).reset_index(drop=True)\n\nassert len(template) == 235_491, (\n    f\"Unexpected holdout target count: {len(template):,}\"\n)\n\nprint(f\"Official February targets: {len(template):,}\")\n\n# ------------------------------------------------------------\n# 2. Load historical truth, excluding the holdout period\n# ------------------------------------------------------------\ntruth_dir = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\n\nhistory_files = sorted(truth_dir.rglob(\"*.parquet\"))\nif not history_files:\n    raise RuntimeError(f\"No truth files found under {truth_dir}\")\n\nPROFILE_COLS = KEYS + [\n    \"speed_kmh\", \"flow_vph\", \"pct_observed\"\n]\n\nhistory_parts = []\n\nfor path in history_files:\n    # The filename gives the date; only use dates before the holdout.\n    date_text = path.stem.replace(\"synthetic_mainline_\", \"\")\n    file_date = pd.to_datetime(\n        date_text, format=\"%Y_%m_%d\", errors=\"coerce\"\n    )\n\n    if pd.isna(file_date) or file_date >= START.tz_localize(None):\n        continue\n\n    df = pd.read_parquet(path, columns=PROFILE_COLS)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(str)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    history_parts.append(df)\n\nif not history_parts:\n    raise RuntimeError(\"No historical files found before the holdout.\")\n\nhistory = pd.concat(history_parts, ignore_index=True)\n\n# Use reliable observed historical records only.\nhistory = history.loc[\n    (history[\"pct_observed\"] >= 75)\n    & history[\"speed_kmh\"].notna()\n    & history[\"flow_vph\"].notna()\n].copy()\n\n# Monday=0 ... Sunday=6; 288 five-minute slots per day.\nhistory[\"slot\"] = (\n    history[\"timestamp\"].dt.dayofweek * 288\n    + history[\"timestamp\"].dt.hour * 12\n    + history[\"timestamp\"].dt.minute // 5\n).astype(\"int16\")\n\ntemplate[\"slot\"] = (\n    template[\"timestamp\"].dt.dayofweek * 288\n    + template[\"timestamp\"].dt.hour * 12\n    + template[\"timestamp\"].dt.minute // 5\n).astype(\"int16\")\n\n# Profile A: link + weekday/time slot.\nprofile = (\n    history.groupby([\"link_id\", \"slot\"], observed=True)[\n        [\"speed_kmh\", \"flow_vph\"]\n    ]\n    .mean()\n    .reset_index()\n)\n\n# Profile B: link-level fallback when a slot profile is unavailable.\nlink_profile = (\n    history.groupby(\"link_id\", observed=True)[\n        [\"speed_kmh\", \"flow_vph\"]\n    ]\n    .mean()\n    .reset_index()\n)\n\nprint(f\"Historical records used: {len(history):,}\")\nprint(f\"Link/slot profiles: {len(profile):,}\")\nprint(f\"Link fallback profiles: {len(link_profile):,}\")\n\n# ------------------------------------------------------------\n# 3. Load February ground truth\n# ------------------------------------------------------------\ntruth_parts = []\n\nfor path in sorted(truth_dir.rglob(\"synthetic_mainline_2031_02_*.parquet\")):\n    df = pd.read_parquet(\n        path,\n        columns=KEYS + [\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ],\n    )\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(str)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    truth_parts.append(df)\n\nif not truth_parts:\n    raise RuntimeError(\"No February ground-truth files found.\")\n\ntruth = pd.concat(truth_parts, ignore_index=True)\n\nif truth.duplicated(KEYS).any():\n    raise RuntimeError(\"Duplicate ground-truth keys found.\")\n\n# ------------------------------------------------------------\n# 4. Load link lane counts\n# ------------------------------------------------------------\nlinks_path = ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\nlinks = pd.read_csv(links_path, dtype={\"link_id\": str})\n\nif not {\"link_id\", \"lanes\"}.issubset(links.columns):\n    raise RuntimeError(\n        f\"Expected link_id and lanes in {links_path}; \"\n        f\"found columns: {links.columns.tolist()}\"\n    )\n\nlinks = links[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nif links[\"lanes\"].isna().any() or (links[\"lanes\"] <= 0).any():\n    raise RuntimeError(\"Missing or invalid lane counts in links.csv.\")\n\n# ------------------------------------------------------------\n# 5. Evaluate each regime independently\n# ------------------------------------------------------------\nresults = []\n\nfor regime in REGIMES:\n    print(f\"\\nEvaluating {regime}...\")\n\n    mask_dir = (\n        ROOT / \"corridors\" / PANEL / \"train\"\n        / \"mainline_states_masked\" / f\"mask_regime={regime}\"\n    )\n\n    mask_files = sorted(\n        mask_dir.glob(\"synthetic_mainline_2031_02_*.parquet\")\n    )\n    if not mask_files:\n        raise RuntimeError(f\"No February masked files found for {regime}\")\n\n    regime_parts = []\n\n    for path in mask_files:\n        df = pd.read_parquet(\n            path, columns=KEYS + [\"speed_kmh\", \"flow_vph\"]\n        )\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df[\"station_id\"] = df[\"station_id\"].astype(str)\n        df[\"link_id\"] = df[\"link_id\"].astype(str)\n\n        # Official targets must be template keys with both values masked.\n        target_match = pd.MultiIndex.from_frame(df[KEYS]).isin(\n            pd.MultiIndex.from_frame(template[KEYS])\n        )\n        both_null = df[\"speed_kmh\"].isna() & df[\"flow_vph\"].isna()\n\n        selected = df.loc[target_match & both_null, KEYS]\n        if not selected.empty:\n            regime_parts.append(selected)\n\n    if not regime_parts:\n        raise RuntimeError(f\"No targets found for {regime}\")\n\n    targets = pd.concat(regime_parts, ignore_index=True).drop_duplicates(KEYS)\n\n    # Enforce the verified regime counts.\n    expected_counts = {\n        \"R1\": 19_157,\n        \"R2\": 108_110,\n        \"R3\": 108_224,\n    }\n    assert len(targets) == expected_counts[regime], (\n        f\"{regime}: expected {expected_counts[regime]:,} targets, \"\n        f\"found {len(targets):,}\"\n    )\n\n    # Join ground truth using the full official key.\n    scored = targets.merge(\n        truth[KEYS + [\"speed_kmh\", \"flow_vph\", \"is_score_eligible\"]],\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    eligible = scored[\"is_score_eligible\"].fillna(False).astype(bool)\n    if not eligible.all():\n        raise RuntimeError(\n            f\"{regime}: {int((~eligible).sum()):,} targets lack eligible truth.\"\n        )\n\n    if scored[[\"speed_kmh\", \"flow_vph\"]].isna().any().any():\n        raise RuntimeError(f\"{regime}: missing ground truth after join.\")\n\n    # Join historical link/slot profile.\n    scored[\"slot\"] = (\n        scored[\"timestamp\"].dt.dayofweek * 288\n        + scored[\"timestamp\"].dt.hour * 12\n        + scored[\"timestamp\"].dt.minute // 5\n    ).astype(\"int16\")\n\n    scored = scored.merge(\n        profile.rename(columns={\n            \"speed_kmh\": \"pred_speed_profile\",\n            \"flow_vph\": \"pred_flow_profile\",\n        }),\n        on=[\"link_id\", \"slot\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    # Fall back to link-level historical averages.\n    scored = scored.merge(\n        link_profile.rename(columns={\n            \"speed_kmh\": \"pred_speed_link\",\n            \"flow_vph\": \"pred_flow_link\",\n        }),\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    scored[\"pred_speed\"] = scored[\"pred_speed_profile\"].fillna(\n        scored[\"pred_speed_link\"]\n    )\n    scored[\"pred_flow\"] = scored[\"pred_flow_profile\"].fillna(\n        scored[\"pred_flow_link\"]\n    )\n\n    if scored[[\"pred_speed\", \"pred_flow\"]].isna().any().any():\n        missing = int(\n            scored[[\"pred_speed\", \"pred_flow\"]].isna().any(axis=1).sum()\n        )\n        raise RuntimeError(\n            f\"{regime}: {missing:,} targets have no historical profile \"\n            \"or link-level fallback.\"\n        )\n\n    # Flow metric is evaluated per lane.\n    scored = scored.merge(\n        links, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n    )\n    if scored[\"lanes\"].isna().any():\n        raise RuntimeError(f\"{regime}: missing lane counts for target links.\")\n\n    speed_rmse = np.sqrt(\n        np.mean(\n            (scored[\"pred_speed\"] - scored[\"speed_kmh\"]) ** 2\n        )\n    )\n\n    flow_per_lane_rmse = np.sqrt(\n        np.mean(\n            (\n                scored[\"pred_flow\"] / scored[\"lanes\"]\n                - scored[\"flow_vph\"] / scored[\"lanes\"]\n            ) ** 2\n        )\n    )\n\n    speed_score = max(0.0, 1.0 - speed_rmse / 25.0)\n    flow_score = max(0.0, 1.0 - flow_per_lane_rmse / 600.0)\n    state_score = 0.54 * speed_score + 0.46 * flow_score\n\n    results.append({\n        \"regime\": regime,\n        \"targets\": len(scored),\n        \"speed_RMSE\": speed_rmse,\n        \"flow_RMSE_per_lane\": flow_per_lane_rmse,\n        \"speed_score\": speed_score,\n        \"flow_score\": flow_score,\n        \"state_score\": state_score,\n    })\n\n    print(f\"Targets: {len(scored):,}\")\n    print(f\"Speed RMSE: {speed_rmse:.4f}\")\n    print(f\"Flow RMSE/lane: {flow_per_lane_rmse:.4f}\")\n    print(f\"State score: {state_score:.6f}\")\n\n# ------------------------------------------------------------\n# 6. Macro-average score\n# ------------------------------------------------------------\nresults_df = pd.DataFrame(results)\n\nprint(\"\\n========== BASELINE SUMMARY ==========\")\nprint(results_df.to_string(index=False, float_format=lambda x: f\"{x:.6f}\"))\n\nmacro_score = results_df[\"state_score\"].mean()\nprint(f\"\\nMacro-average state score: {macro_score:.6f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T09:02:37.656636Z","iopub.execute_input":"2026-10-19T09:02:37.657672Z","iopub.status.idle":"2026-10-19T09:02:54.748993Z","shell.execute_reply.started":"2026-10-19T09:02:37.657635Z","shell.execute_reply":"2026-10-19T09:02:54.748209Z"},"scrolled":true},"outputs":[{"name":"stdout","text":"Official February targets: 235,491\nHistorical records used: 5,875,161\nLink/slot profiles: 219,744\nLink fallback profiles: 109\n\nEvaluating R1...\nTargets: 19,157\nSpeed RMSE: 11.1154\nFlow RMSE/lane: 79.4165\nState score: 0.699020\n\nEvaluating R2...\nTargets: 108,110\nSpeed RMSE: 12.8175\nFlow RMSE/lane: 101.8759\nState score: 0.645038\n\nEvaluating R3...\nTargets: 108,224\nSpeed RMSE: 13.6231\nFlow RMSE/lane: 116.4972\nState score: 0.616426\n\n========== BASELINE SUMMARY ==========\nregime  targets  speed_RMSE  flow_RMSE_per_lane  speed_score  flow_score  state_score\n    R1    19157   11.115449           79.416453     0.555382    0.867639     0.699020\n    R2   108110   12.817455          101.875854     0.487302    0.830207     0.645038\n    R3   108224   13.623117          116.497210     0.455075    0.805838     0.616426\n\nMacro-average state score: 0.653495\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANEL = \"D7_I405_S\"\n\nprint(\"=\" * 75)\nprint(\"TRAFFIC FLOW BENCH — DATASET STRUCTURE AUDIT\")\nprint(\"=\" * 75)\n\nif not ROOT.exists():\n    raise FileNotFoundError(f\"Competition dataset root not found: {ROOT}\")\n\nprint(\"\\nRoot directory:\", ROOT)\n\n# 1. Top-level dataset structure\nprint(\"\\n1. TOP-LEVEL DIRECTORIES\")\nfor path in sorted(ROOT.iterdir()):\n    kind = \"DIR \" if path.is_dir() else \"FILE\"\n    print(f\"{kind} {path.name}\")\n\n# 2. Panel-specific directories\nprint(\"\\n2. PANEL DIRECTORIES\")\nfor relative in [\n    f\"corridors/{PANEL}/train\",\n    f\"task1/{PANEL}\",\n]:\n    directory = ROOT / relative\n    print(f\"\\n{relative}\")\n\n    if not directory.exists():\n        print(\"  NOT FOUND\")\n        continue\n\n    for path in sorted(directory.iterdir())[:30]:\n        print(\" \", path.name)\n\n# 3. Inspect actual parquet paths and schemas\nprint(\"\\n3. MAINLINE TRUTH FILES\")\ntruth_dir = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\ntruth_files = sorted(truth_dir.rglob(\"*.parquet\"))\n\nprint(\"Truth parquet count:\", len(truth_files))\n\nfor path in truth_files[:3]:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_parquet(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n\n    for col in [\"date\", \"timestamp\"]:\n        if col in df.columns:\n            values = pd.to_datetime(df[col], errors=\"coerce\", utc=True)\n            print(\n                f\"{col}: dtype={df[col].dtype}, \"\n                f\"min={values.min()}, max={values.max()}\"\n            )\n\n# 4. Inspect actual masked inputs\nprint(\"\\n4. MASKED INPUT FILES\")\nmasked_dir = (\n    ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\n)\nmasked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\nprint(\"Masked parquet count:\", len(masked_files))\n\nfor path in masked_files[:3]:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_parquet(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n\n# 5. Inspect Task 1 templates\nprint(\"\\n5. TASK 1 TEMPLATES\")\ntask_dir = ROOT / \"task1\" / PANEL\ntemplates = sorted(task_dir.rglob(\"sample_submission_state.csv\"))\n\nprint(\"Template count:\", len(templates))\n\nfor path in templates:\n    print(\"\\nPath:\", path.relative_to(ROOT))\n    df = pd.read_csv(path)\n    print(\"Shape:\", df.shape)\n    print(\"Columns:\", df.columns.tolist())\n    print(df.head(3).to_string(index=False))\n\n# 6. Inspect network metadata\nprint(\"\\n6. NETWORK METADATA\")\nfor name in [\n    \"links.csv\",\n    \"fd_parameters.csv\",\n    \"lwr_mainline_topology.csv\",\n]:\n    path = ROOT / \"corridors\" / PANEL / name\n\n    if path.exists():\n        df = pd.read_csv(path)\n        print(f\"\\n{name}: shape={df.shape}\")\n        print(\"Columns:\", df.columns.tolist())\n        print(df.head(3).to_string(index=False))\n    else:\n        print(f\"\\n{name}: not found at expected path\")\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"AUDIT COMPLETE — NO MODEL TRAINED\")\nprint(\"=\" * 75)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T12:46:16.468662Z","iopub.execute_input":"2026-10-19T12:46:16.469052Z","iopub.status.idle":"2026-10-19T12:46:19.32012Z","shell.execute_reply.started":"2026-10-19T12:46:16.46902Z","shell.execute_reply":"2026-10-19T12:46:19.319133Z"}},"outputs":[{"name":"stdout","text":"===========================================================================\nTRAFFIC FLOW BENCH — DATASET STRUCTURE AUDIT\n===========================================================================\n\nRoot directory: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\n\n1. TOP-LEVEL DIRECTORIES\nFILE README.md\nDIR  config\nDIR  corridors\nFILE sample_submission.csv\nFILE submission_key.csv\nDIR  task1\nDIR  task2\nDIR  task4\n\n2. PANEL DIRECTORIES\n\ncorridors/D7_I405_S/train\n  mainline_states\n  mainline_states_masked\n  ramp_states\n\ntask1/D7_I405_S\n  private\n  train\n  validation\n\n3. MAINLINE TRUTH FILES\nTruth parquet count: 273\n\nPath: corridors/D7_I405_S/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_01.parquet\nShape: (31392, 16)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\ndate: dtype=object, min=2030-06-01 00:00:00+00:00, max=2030-06-01 00:00:00+00:00\ntimestamp: dtype=object, min=2030-06-01 00:00:00+00:00, max=2030-06-01 23:55:00+00:00\n\nPath: corridors/D7_I405_S/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_02.parquet\nShape: (31392, 16)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\ndate: dtype=object, min=2030-06-02 00:00:00+00:00, max=2030-06-02 00:00:00+00:00\ntimestamp: dtype=object, min=2030-06-02 00:00:00+00:00, max=2030-06-02 23:55:00+00:00\n\nPath: corridors/D7_I405_S/train/mainline_states/year_month=2030-06/synthetic_mainline_2030_06_03.parquet\nShape: (31392, 16)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\ndate: dtype=object, min=2030-06-03 00:00:00+00:00, max=2030-06-03 00:00:00+00:00\ntimestamp: dtype=object, min=2030-06-03 00:00:00+00:00, max=2030-06-03 23:55:00+00:00\n\n4. MASKED INPUT FILES\nMasked parquet count: 273\n\nPath: corridors/D7_I405_S/train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2030_06_07.parquet\nShape: (31392, 17)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n\nPath: corridors/D7_I405_S/train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2030_06_09.parquet\nShape: (31392, 17)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n\nPath: corridors/D7_I405_S/train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2030_06_10.parquet\nShape: (31392, 17)\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n\n5. TASK 1 TEMPLATES\nTemplate count: 3\n\nPath: task1/D7_I405_S/private/sample_submission_state.csv\nShape: (243603, 7)\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\n    panel            timestamp         station_id   link_id mask_regime  speed_kmh  flow_vph\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0094 L405S-004          R3        NaN       NaN\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0035 L405S-013          R3        NaN       NaN\nD7_I405_S 2031-04-01T00:00:00Z SYN_D7_I405_S_0024 L405S-029          R3        NaN       NaN\n\nPath: task1/D7_I405_S/train/sample_submission_state.csv\nShape: (2127937, 7)\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\n    panel            timestamp         station_id   link_id mask_regime  speed_kmh  flow_vph\nD7_I405_S 2030-06-01T00:00:00Z SYN_D7_I405_S_0094 L405S-004          R3        NaN       NaN\nD7_I405_S 2030-06-01T00:00:00Z SYN_D7_I405_S_0021 L405S-005          R3        NaN       NaN\nD7_I405_S 2030-06-01T00:00:00Z SYN_D7_I405_S_0024 L405S-029          R3        NaN       NaN\n\nPath: task1/D7_I405_S/validation/sample_submission_state.csv\nShape: (271939, 7)\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\n    panel            timestamp         station_id   link_id mask_regime  speed_kmh  flow_vph\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0033 L405S-001          R1        NaN       NaN\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0019 L405S-007          R1        NaN       NaN\nD7_I405_S 2031-03-01T00:00:00Z SYN_D7_I405_S_0022 L405S-021          R1        NaN       NaN\n\n6. NETWORK METADATA\n\nlinks.csv: not found at expected path\n\nfd_parameters.csv: not found at expected path\n\nlwr_mainline_topology.csv: not found at expected path\n\n===========================================================================\nAUDIT COMPLETE — NO MODEL TRAINED\n===========================================================================\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# ============================================================\n# TASK 1 — REBUILD HISTORICAL-PROFILE BASELINE\n# D7_I405_S | February 2031 chronological holdout\n# ============================================================\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\nSTART = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nEND = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nTRUTH_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\nMASKED_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\nTEMPLATE_PATH = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\n\ndef utc(series):\n    return pd.to_datetime(series, errors=\"coerce\", utc=True)\n\ndef rmse(actual, predicted):\n    valid = actual.notna() & predicted.notna()\n    if not valid.any():\n        return np.nan\n    return float(np.sqrt(np.mean((actual[valid] - predicted[valid]) ** 2)))\n\nprint(\"=\" * 76)\nprint(\"1. LOAD HISTORICAL TRUTH\")\nprint(\"=\" * 76)\n\ntruth_files = sorted(TRUTH_DIR.rglob(\"*.parquet\"))\nif not truth_files:\n    raise FileNotFoundError(f\"No truth parquet files found: {TRUTH_DIR}\")\n\ntruth_parts = []\nfor path in truth_files:\n    # Only load dates strictly before the February holdout.\n    # Filename filtering uses the actual YYYY_MM_DD convention.\n    if \"2031_02_\" in path.name or \"2031_03_\" in path.name:\n        continue\n\n    frame = pd.read_parquet(path)\n    frame[\"timestamp\"] = utc(frame[\"timestamp\"])\n    truth_parts.append(frame)\n\ntruth = pd.concat(truth_parts, ignore_index=True)\ntruth = truth.drop_duplicates(KEYS)\nprint(\"Historical truth rows:\", len(truth))\nprint(\"Historical date range:\",\n      truth[\"timestamp\"].min(), \"to\", truth[\"timestamp\"].max())\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"2. LOAD FEBRUARY TARGET KEYS\")\nprint(\"=\" * 76)\n\n# The train template covers June 2030–February 2031.\ntemplate = pd.read_csv(TEMPLATE_PATH)\ntemplate[\"timestamp\"] = utc(template[\"timestamp\"])\ntargets = template.loc[\n    template[\"timestamp\"].ge(START)\n    & template[\"timestamp\"].lt(END)\n].copy()\n\nif targets.empty:\n    raise RuntimeError(\n        \"The train template contains no February targets. \"\n        \"Cannot proceed with this holdout.\"\n    )\n\ntargets = targets.drop_duplicates(KEYS)\nprint(\"February template targets:\", len(targets))\nprint(\"Target regime counts:\")\nprint(targets[\"mask_regime\"].value_counts().to_string())\n\n# Match holdout targets to truth.\nholdout = targets[KEYS + [\"mask_regime\"]].merge(\n    pd.concat([\n        pd.read_parquet(p)\n        for p in truth_files\n        if \"2031_02_\" in p.name\n    ], ignore_index=True).assign(\n        timestamp=lambda d: utc(d[\"timestamp\"])\n    ),\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n    indicator=True\n)\n\nmatched = int(holdout[\"_merge\"].eq(\"both\").sum())\nprint(\"Targets matched to February truth:\", matched, \"/\", len(holdout))\n\nif matched != len(holdout):\n    print(holdout.loc[holdout[\"_merge\"].ne(\"both\"), KEYS].head(10))\n    raise ValueError(\"Some February target keys did not match truth.\")\n\nholdout = holdout.drop(columns=\"_merge\")\n\nif \"is_score_eligible\" in holdout.columns:\n    holdout = holdout.loc[\n        holdout[\"is_score_eligible\"].fillna(False).astype(bool)\n    ].copy()\n\nprint(\"Eligible holdout rows:\", len(holdout))\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"3. BUILD HISTORICAL PROFILE\")\nprint(\"=\" * 76)\n\n# Keep reliable historical records only.\nhist = truth.copy()\nhist[\"pct_observed\"] = pd.to_numeric(hist[\"pct_observed\"], errors=\"coerce\")\nhist[\"speed_kmh\"] = pd.to_numeric(hist[\"speed_kmh\"], errors=\"coerce\")\nhist[\"flow_vph\"] = pd.to_numeric(hist[\"flow_vph\"], errors=\"coerce\")\n\nhist = hist.loc[\n    hist[\"timestamp\"].lt(START)\n    & hist[\"pct_observed\"].ge(75)\n    & hist[\"speed_kmh\"].notna()\n    & hist[\"flow_vph\"].notna()\n].copy()\n\nhist[\"minute_of_day\"] = (\n    hist[\"timestamp\"].dt.hour * 60 + hist[\"timestamp\"].dt.minute\n)\nhist[\"weekday\"] = hist[\"timestamp\"].dt.dayofweek\nhist[\"time_bin\"] = hist[\"weekday\"] * 288 + (\n    hist[\"minute_of_day\"] // 5\n)\n\nprofile = (\n    hist.groupby([\"link_id\", \"time_bin\"], as_index=False)\n    .agg(\n        profile_speed=(\"speed_kmh\", \"mean\"),\n        profile_flow=(\"flow_vph\", \"mean\")\n    )\n)\n\nlink_profile = (\n    hist.groupby(\"link_id\", as_index=False)\n    .agg(\n        fallback_speed=(\"speed_kmh\", \"mean\"),\n        fallback_flow=(\"flow_vph\", \"mean\")\n    )\n)\n\nholdout[\"minute_of_day\"] = (\n    holdout[\"timestamp\"].dt.hour * 60 + holdout[\"timestamp\"].dt.minute\n)\nholdout[\"weekday\"] = holdout[\"timestamp\"].dt.dayofweek\nholdout[\"time_bin\"] = holdout[\"weekday\"] * 288 + (\n    holdout[\"minute_of_day\"] // 5\n)\n\nholdout = holdout.merge(\n    profile,\n    on=[\"link_id\", \"time_bin\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nholdout = holdout.merge(\n    link_profile,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nholdout[\"pred_speed\"] = holdout[\"profile_speed\"].fillna(\n    holdout[\"fallback_speed\"]\n)\nholdout[\"pred_flow\"] = holdout[\"profile_flow\"].fillna(\n    holdout[\"fallback_flow\"]\n)\n\nprint(\"Missing speed predictions:\", int(holdout[\"pred_speed\"].isna().sum()))\nprint(\"Missing flow predictions:\", int(holdout[\"pred_flow\"].isna().sum()))\n\nif holdout[[\"pred_speed\", \"pred_flow\"]].isna().any().any():\n    raise ValueError(\"Baseline produced missing predictions.\")\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"4. SCORE BY REGIME\")\nprint(\"=\" * 76)\n\n# Locate lane counts in the actual truth files if available.\nlane_col = None\nif \"lanes\" in holdout.columns:\n    lane_col = \"lanes\"\nelse:\n    # Search nearby metadata files instead of assuming one exact location.\n    metadata_candidates = list(\n        (ROOT / \"corridors\" / PANEL).rglob(\"links.csv\")\n    )\n    for metadata_path in metadata_candidates:\n        metadata = pd.read_csv(metadata_path)\n        if {\"link_id\", \"lanes\"}.issubset(metadata.columns):\n            holdout = holdout.merge(\n                metadata[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\"),\n                on=\"link_id\",\n                how=\"left\",\n                validate=\"many_to_one\"\n            )\n            lane_col = \"lanes\"\n            print(\"Lane metadata loaded from:\", metadata_path)\n            break\n\nif lane_col is None:\n    print(\n        \"WARNING: Lane metadata unavailable. Flow RMSE per lane cannot \"\n        \"be computed correctly, so the official state score is withheld.\"\n    )\n\nresults = []\n\nfor regime, group in holdout.groupby(\"mask_regime\"):\n    speed_rmse = rmse(group[\"speed_kmh\"], group[\"pred_speed\"])\n    flow_rmse_total = rmse(group[\"flow_vph\"], group[\"pred_flow\"])\n\n    if lane_col is not None:\n        lanes = pd.to_numeric(group[lane_col], errors=\"coerce\")\n        valid = (\n            group[\"flow_vph\"].notna()\n            & group[\"pred_flow\"].notna()\n            & lanes.notna()\n            & lanes.gt(0)\n        )\n        flow_rmse_lane = (\n            float(np.sqrt(np.mean(\n                ((group.loc[valid, \"flow_vph\"]\n                  - group.loc[valid, \"pred_flow\"])\n                 / lanes.loc[valid]) ** 2\n            )))\n            if valid.any() else np.nan\n        )\n        state_score = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n            if np.isfinite(speed_rmse) and np.isfinite(flow_rmse_lane)\n            else np.nan\n        )\n    else:\n        flow_rmse_lane = np.nan\n        state_score = np.nan\n\n    results.append({\n        \"regime\": regime,\n        \"targets\": len(group),\n        \"speed_RMSE\": speed_rmse,\n        \"flow_RMSE_total\": flow_rmse_total,\n        \"flow_RMSE_per_lane\": flow_rmse_lane,\n        \"state_score\": state_score\n    })\n\nresults_df = pd.DataFrame(results)\nprint(results_df.to_string(index=False))\n\nif results_df[\"state_score\"].notna().all():\n    macro_score = float(results_df[\"state_score\"].mean())\n    print(\"\\nRebuilt baseline macro score:\", round(macro_score, 6))\nelse:\n    macro_score = np.nan\n    print(\"\\nMacro score not computed because lane-normalized flow errors \"\n          \"could not be verified.\")\n\nprint(\"\\n\" + \"=\" * 76)\nprint(\"5. SAVE RECONSTRUCTED BASELINE OUTPUTS\")\nprint(\"=\" * 76)\n\nOUT = Path(\"/kaggle/working/trafficflow_task1_rebuild\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nholdout[\n    KEYS + [\"mask_regime\", \"speed_kmh\", \"flow_vph\", \"pred_speed\", \"pred_flow\"]\n].to_csv(OUT / \"february_baseline_predictions.csv\", index=False)\n\nresults_df.to_csv(OUT / \"february_baseline_metrics.csv\", index=False)\n\nprint(\"Saved predictions:\", OUT / \"february_baseline_predictions.csv\")\nprint(\"Saved metrics:\", OUT / \"february_baseline_metrics.csv\")\nprint(\"\\nBaseline rebuild complete. No ML model was trained.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T12:47:03.838272Z","iopub.execute_input":"2026-10-19T12:47:03.838632Z","iopub.status.idle":"2026-10-19T12:47:35.515001Z","shell.execute_reply.started":"2026-10-19T12:47:03.838604Z","shell.execute_reply":"2026-10-19T12:47:35.512953Z"}},"outputs":[{"name":"stdout","text":"============================================================================\n1. LOAD HISTORICAL TRUTH\n============================================================================\nHistorical truth rows: 7691040\nHistorical date range: 2030-06-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\n\n============================================================================\n2. LOAD FEBRUARY TARGET KEYS\n============================================================================\nFebruary template targets: 235491\nTarget regime counts:\nmask_regime\nR3    108224\nR2    108110\nR1     19157\nTargets matched to February truth: 235491 / 235491\nEligible holdout rows: 235491\n\n============================================================================\n3. BUILD HISTORICAL PROFILE\n============================================================================\nMissing speed predictions: 0\nMissing flow predictions: 0\n\n============================================================================\n4. SCORE BY REGIME\n============================================================================\nLane metadata loaded from: /kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public/corridors/D7_I405_S/network/links.csv\nregime  targets  speed_RMSE  flow_RMSE_total  flow_RMSE_per_lane  state_score\n    R1    19157   11.115449       337.130857           79.416453     0.699020\n    R2   108110   12.817455       430.072121          101.875854     0.645038\n    R3   108224   13.623117       492.560441          116.497210     0.616426\n\nRebuilt baseline macro score: 0.653495\n\n============================================================================\n5. SAVE RECONSTRUCTED BASELINE OUTPUTS\n============================================================================\nSaved predictions: /kaggle/working/trafficflow_task1_rebuild/february_baseline_predictions.csv\nSaved metrics: /kaggle/working/trafficflow_task1_rebuild/february_baseline_metrics.csv\n\nBaseline rebuild complete. No ML model was trained.\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"\n# =====================================================================\n# IEEETrafficFlow — TASK 1: RESIDUAL-LEARNING EXPERIMENT\n# Complete standalone experiment | Panel: D7_I405_S\n#\n# Training: December 2030 + January 2031 official target keys\n# Holdout:   February 2031 official target keys\n# Baseline benchmark from previous verified experiment: 0.653495\n#\n# No dependency on variables from previous notebook cells.\n# =====================================================================\n\nimport gc\nimport json\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nwarnings.filterwarnings(\"ignore\", category=FutureWarning)\n\n# ----------------------------- CONFIG -----------------------------\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nPANEL = \"D7_I405_S\"\n\nTRUTH_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\nMASKED_DIR = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states_masked\"\nTEMPLATE_PATH = ROOT / \"task1\" / PANEL / \"train\" / \"sample_submission_state.csv\"\nLINKS_PATH = ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\n\nOUT = Path(\"/kaggle/working/trafficflow_residual_experiment\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nTRAIN_START = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\nFEB_START = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\nMAR_START = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\nKNOWN_BASELINE_SCORE = 0.653495\nBASELINE_TOLERANCE = 0.002\n\nLAGS_MINUTES = [5, 15, 60, 1440]\n\n\n# ----------------------------- HELPERS -----------------------------\n\ndef require(condition, message):\n    if not condition:\n        raise RuntimeError(message)\n\n\ndef load_parquets(folder, columns):\n    files = sorted(folder.rglob(\"*.parquet\"))\n    require(files, f\"No parquet files found: {folder}\")\n\n    frames = []\n    for i, path in enumerate(files, 1):\n        frames.append(pd.read_parquet(path, columns=columns))\n        if i % 50 == 0 or i == len(files):\n            print(f\"  Loaded {i}/{len(files)} files: {folder.name}\")\n\n    return pd.concat(frames, ignore_index=True)\n\n\ndef normalize_ids(frame):\n    \"\"\"Preserve real IDs such as L405S-406; never cast IDs to integers.\"\"\"\n    frame = frame.copy()\n    for col in [\"station_id\", \"link_id\"]:\n        frame[col] = frame[col].astype(\"string\").str.strip()\n    return frame\n\n\ndef rmse(actual, predicted):\n    actual = np.asarray(actual, dtype=np.float64)\n    predicted = np.asarray(predicted, dtype=np.float64)\n    return float(np.sqrt(np.mean((actual - predicted) ** 2)))\n\n\ndef add_time_features(frame):\n    frame = frame.copy()\n    ts = frame[\"timestamp\"]\n\n    frame[\"dow\"] = ts.dt.dayofweek.astype(\"int8\")\n    frame[\"minute_of_day\"] = (\n        ts.dt.hour * 60 + ts.dt.minute\n    ).astype(\"int16\")\n\n    frame[\"tod_sin\"] = np.sin(\n        2 * np.pi * frame[\"minute_of_day\"] / 1440.0\n    )\n    frame[\"tod_cos\"] = np.cos(\n        2 * np.pi * frame[\"minute_of_day\"] / 1440.0\n    )\n    frame[\"dow_sin\"] = np.sin(\n        2 * np.pi * frame[\"dow\"] / 7.0\n    )\n    frame[\"dow_cos\"] = np.cos(\n        2 * np.pi * frame[\"dow\"] / 7.0\n    )\n\n    return frame\n\n\n# ----------------------------- 1. LOAD DATA -----------------------------\n\nprint(\"\\n[1/9] Loading source data...\")\n\ntruth = load_parquets(\n    TRUTH_DIR,\n    [\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    ],\n)\n\nmasked = load_parquets(\n    MASKED_DIR,\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"],\n)\n\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n\ntruth = normalize_ids(truth)\nmasked = normalize_ids(masked)\n\ntemplate = pd.read_csv(TEMPLATE_PATH)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\ntemplate = normalize_ids(template)\n\nlinks = pd.read_csv(LINKS_PATH)\nrequire(\n    {\"link_id\", \"lanes\"}.issubset(links.columns),\n    f\"Unexpected links.csv columns: {links.columns.tolist()}\",\n)\nlinks[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\nlinks[\"lanes\"] = pd.to_numeric(links[\"lanes\"], errors=\"coerce\")\n\nrequire(links[\"link_id\"].notna().all(), \"Missing link IDs in links.csv.\")\nrequire(links[\"lanes\"].notna().all(), \"Missing/non-numeric lane counts.\")\nrequire((links[\"lanes\"] > 0).all(), \"Lane counts must be positive.\")\nrequire(not links[\"link_id\"].duplicated().any(), \"Duplicate link IDs in links.csv.\")\n\nfor name, frame in [\n    (\"truth\", truth),\n    (\"masked\", masked),\n    (\"template\", template),\n]:\n    require(frame[KEYS].notna().all().all(), f\"{name} has null target keys.\")\n    require(\n        not frame.duplicated(KEYS).any(),\n        f\"{name} contains duplicate target keys.\",\n    )\n\nprint(f\"Truth rows:  {len(truth):,}\")\nprint(f\"Masked rows: {len(masked):,}\")\nprint(f\"Template rows: {len(template):,}\")\nprint(\"Link metadata rows:\", len(links))\n\n\n# ----------------------------- 2. TARGET KEYS -----------------------------\n\nprint(\"\\n[2/9] Preparing official training and February holdout targets...\")\n\ntarget_keys = template.loc[\n    template[\"timestamp\"].ge(TRAIN_START)\n    & template[\"timestamp\"].lt(MAR_START),\n    KEYS + [\"mask_regime\"],\n].copy()\n\ntarget_keys[\"target_month\"] = target_keys[\"timestamp\"].dt.strftime(\"%Y-%m\")\n\ntrain_keys = target_keys.loc[\n    target_keys[\"timestamp\"].lt(FEB_START)\n].copy()\n\nholdout_keys = target_keys.loc[\n    target_keys[\"timestamp\"].ge(FEB_START)\n    & target_keys[\"timestamp\"].lt(MAR_START)\n].copy()\n\nrequire(\n    len(train_keys) == 479_688,\n    f\"Expected 479,688 Dec-Jan targets; found {len(train_keys):,}.\",\n)\nrequire(\n    len(holdout_keys) == 235_491,\n    f\"Expected 235,491 February targets; found {len(holdout_keys):,}.\",\n)\n\nprint(\"December-January training targets:\", f\"{len(train_keys):,}\")\nprint(\"February holdout targets:\", f\"{len(holdout_keys):,}\")\n\n\n# ----------------------------- 3. LABELS -----------------------------\n\nprint(\"\\n[3/9] Joining ground-truth labels once...\")\n\nlabels = truth[\n    KEYS + [\"speed_kmh\", \"flow_vph\", \"is_score_eligible\"]\n].rename(\n    columns={\n        \"speed_kmh\": \"target_speed\",\n        \"flow_vph\": \"target_flow\",\n        \"is_score_eligible\": \"target_eligible\",\n    }\n).copy()\n\ntrain_keys = train_keys.merge(\n    labels, on=KEYS, how=\"left\",\n    validate=\"one_to_one\", indicator=\"_label_match\",\n)\nholdout_keys = holdout_keys.merge(\n    labels, on=KEYS, how=\"left\",\n    validate=\"one_to_one\", indicator=\"_label_match\",\n)\n\nrequire(\n    train_keys[\"_label_match\"].eq(\"both\").all(),\n    \"Some training targets did not match truth.\",\n)\nrequire(\n    holdout_keys[\"_label_match\"].eq(\"both\").all(),\n    \"Some February targets did not match truth.\",\n)\n\nfor name, frame in [\n    (\"training\", train_keys),\n    (\"holdout\", holdout_keys),\n]:\n    valid = (\n        frame[\"target_eligible\"].fillna(False).astype(bool)\n        & frame[\"target_speed\"].notna()\n        & frame[\"target_flow\"].notna()\n    )\n    require(valid.all(), f\"{name} has ineligible or missing target labels.\")\n\ntrain_keys.drop(columns=\"_label_match\", inplace=True)\nholdout_keys.drop(columns=\"_label_match\", inplace=True)\n\n# Only these target labels are used for training or evaluation.\nall_targets = pd.concat(\n    [train_keys, holdout_keys],\n    ignore_index=True,\n)\n\ndel labels\ngc.collect()\n\n\n# ----------------------------- 4. PAST-ONLY PROFILES -----------------------------\n\nprint(\"\\n[4/9] Building month-specific historical profiles...\")\n\ndef build_profile(month_targets, month_start):\n    # Strictly earlier than the first instant of the target month.\n    history = truth.loc[\n        (truth[\"timestamp\"] < month_start)\n        & (truth[\"pct_observed\"] >= 75)\n        & truth[\"speed_kmh\"].notna()\n        & truth[\"flow_vph\"].notna(),\n        [\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"],\n    ].copy()\n\n    require(len(history) > 0, f\"No usable history before {month_start}.\")\n\n    history = add_time_features(history)\n    query = add_time_features(month_targets[KEYS].copy())\n\n    profile = (\n        history.groupby(\n            [\"link_id\", \"dow\", \"minute_of_day\"],\n            observed=True,\n        )[[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"base_speed\",\n                \"flow_vph\": \"base_flow\",\n            }\n        )\n    )\n\n    weekday_profile = (\n        history.groupby([\"link_id\", \"dow\"], observed=True)\n        [[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"weekday_speed\",\n                \"flow_vph\": \"weekday_flow\",\n            }\n        )\n    )\n\n    link_profile = (\n        history.groupby(\"link_id\", observed=True)\n        [[\"speed_kmh\", \"flow_vph\"]]\n        .mean()\n        .reset_index()\n        .rename(\n            columns={\n                \"speed_kmh\": \"link_speed\",\n                \"flow_vph\": \"link_flow\",\n            }\n        )\n    )\n\n    query = query.merge(\n        profile,\n        on=[\"link_id\", \"dow\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    query = query.merge(\n        weekday_profile,\n        on=[\"link_id\", \"dow\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    query = query.merge(\n        link_profile,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    query[\"base_speed\"] = (\n        query[\"base_speed\"]\n        .fillna(query[\"weekday_speed\"])\n        .fillna(query[\"link_speed\"])\n    )\n    query[\"base_flow\"] = (\n        query[\"base_flow\"]\n        .fillna(query[\"weekday_flow\"])\n        .fillna(query[\"link_flow\"])\n    )\n\n    require(\n        query[[\"base_speed\", \"base_flow\"]].notna().all().all(),\n        f\"Uncovered profile rows for month starting {month_start}.\",\n    )\n\n    return query[KEYS + [\"base_speed\", \"base_flow\"]]\n\n\nprofile_parts = []\n\nfor month in [\"2030-12\", \"2031-01\", \"2031-02\"]:\n    month_start = pd.Timestamp(month + \"-01\", tz=\"UTC\")\n\n    month_keys = target_keys.loc[\n        target_keys[\"target_month\"].eq(month),\n        KEYS,\n    ].copy()\n\n    require(len(month_keys) > 0, f\"No target keys for {month}.\")\n\n    month_profile = build_profile(month_keys, month_start)\n    profile_parts.append(month_profile)\n\n    print(\n        f\"  {month}: {len(month_profile):,} rows; \"\n        f\"profile cutoff={month_start}\"\n    )\n\n    del month_keys, month_profile\n    gc.collect()\n\nprofiles = pd.concat(profile_parts, ignore_index=True)\n\nrequire(\n    not profiles.duplicated(KEYS).any(),\n    \"Duplicate keys in historical profiles.\",\n)\n\nfeatures = all_targets.merge(\n    profiles,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\",\n)\n\nrequire(\n    features[[\"base_speed\", \"base_flow\"]].notna().all().all(),\n    \"Missing baseline profile values.\",\n)\n\ndel profile_parts, profiles, all_targets\ngc.collect()\n\n\n# ----------------------------- 5. MASKED LAG FEATURES -----------------------------\n\nprint(\"\\n[5/9] Building masked-only lag features...\")\n\n# Preserve raw IDs here. No numeric conversion of link_id.\nfeatures = features.reset_index(drop=True)\nfeatures[\"_row_id\"] = np.arange(len(features), dtype=np.int64)\n\nmin_source_time = features[\"timestamp\"].min() - pd.Timedelta(days=1)\nmax_source_time = features[\"timestamp\"].max()\n\nmasked_source = masked.loc[\n    masked[\"timestamp\"].ge(min_source_time)\n    & masked[\"timestamp\"].le(max_source_time),\n    KEYS + [\"speed_kmh\", \"flow_vph\"],\n].copy()\n\n# Null masked values naturally become NaN after a join.\nmasked_source = masked_source.loc[\n    masked_source[\"speed_kmh\"].notna()\n    | masked_source[\"flow_vph\"].notna()\n].copy()\n\nfor lag in LAGS_MINUTES:\n    print(f\"  Joining {lag}-minute lag...\")\n\n    lookup = features[[\"_row_id\"] + KEYS].copy()\n    lookup[\"timestamp\"] = (\n        lookup[\"timestamp\"] - pd.Timedelta(minutes=lag)\n    )\n\n    source = masked_source.rename(\n        columns={\n            \"speed_kmh\": f\"lag{lag}_speed\",\n            \"flow_vph\": f\"lag{lag}_flow\",\n        }\n    )\n\n    joined = lookup.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n    require(len(joined) == len(features), f\"Row count changed for lag {lag}.\")\n\n    joined = joined.set_index(\"_row_id\")\n\n    features[f\"lag{lag}_speed\"] = (\n        joined[f\"lag{lag}_speed\"]\n        .reindex(features[\"_row_id\"])\n        .to_numpy()\n    )\n    features[f\"lag{lag}_flow\"] = (\n        joined[f\"lag{lag}_flow\"]\n        .reindex(features[\"_row_id\"])\n        .to_numpy()\n    )\n\n    del lookup, source, joined\n    gc.collect()\n\ndel masked_source, masked\ngc.collect()\n\n\n# ----------------------------- 6. MODEL FEATURES -----------------------------\n\nprint(\"\\n[6/9] Preparing model features...\")\n\nfeatures = add_time_features(features)\n\n# Keep raw IDs in `features` for evaluation and metadata joins.\n# Encode only the dedicated model matrix.\nFEATURES = [\n    \"base_speed\",\n    \"base_flow\",\n    \"dow\",\n    \"minute_of_day\",\n    \"tod_sin\",\n    \"tod_cos\",\n    \"dow_sin\",\n    \"dow_cos\",\n] + [\n    f\"lag{lag}_{kind}\"\n    for lag in LAGS_MINUTES\n    for kind in [\"speed\", \"flow\"]\n]\n\nX_all = features[FEATURES].astype(\"float32\").copy()\n\n# Stable categorical codes are derived jointly from training and holdout IDs.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    X_all[col] = (\n        features[col].astype(\"string\").astype(\"category\").cat.codes\n    ).astype(\"float32\")\n\n# Add encoded ID columns to the model matrix.\nX_all[\"station_id\"] = (\n    features[\"station_id\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\nX_all[\"link_id\"] = (\n    features[\"link_id\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\nX_all[\"mask_regime\"] = (\n    features[\"mask_regime\"].astype(\"category\").cat.codes.astype(\"float32\")\n)\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"station_id\", \"link_id\", \"mask_regime\",\n    \"dow\", \"minute_of_day\", \"tod_sin\", \"tod_cos\", \"dow_sin\", \"dow_cos\",\n] + [\n    f\"lag{lag}_{kind}\"\n    for lag in LAGS_MINUTES\n    for kind in [\"speed\", \"flow\"]\n]\n\ntrain_mask = features[\"timestamp\"].lt(FEB_START)\nholdout_mask = (\n    features[\"timestamp\"].ge(FEB_START)\n    & features[\"timestamp\"].lt(MAR_START)\n)\n\nX_train = X_all.loc[train_mask, FEATURES].copy()\nX_holdout = X_all.loc[holdout_mask, FEATURES].copy()\n\ny_speed = (\n    features.loc[train_mask, \"target_speed\"].to_numpy(dtype=np.float32)\n    - features.loc[train_mask, \"base_speed\"].to_numpy(dtype=np.float32)\n)\ny_flow = (\n    features.loc[train_mask, \"target_flow\"].to_numpy(dtype=np.float32)\n    - features.loc[train_mask, \"base_flow\"].to_numpy(dtype=np.float32)\n)\n\nrequire(len(X_train) == 479_688, \"Unexpected training matrix size.\")\nrequire(len(X_holdout) == 235_491, \"Unexpected holdout matrix size.\")\nrequire(\n    np.isfinite(y_speed).all() and np.isfinite(y_flow).all(),\n    \"Non-finite residual labels.\",\n)\n\nprint(\"Training matrix:\", X_train.shape)\nprint(\"Holdout matrix:\", X_holdout.shape)\nprint(\"Training missing feature cells:\", int(X_train.isna().sum().sum()))\nprint(\"Holdout missing feature cells:\", int(X_holdout.isna().sum().sum()))\n\n\n# ----------------------------- 7. BASELINE CHECK -----------------------------\n\nprint(\"\\n[7/9] Checking the February baseline...\")\n\n# Use the untouched string link IDs from `features`.\neval_frame = features.loc[\n    holdout_mask,\n    KEYS + [\n        \"mask_regime\",\n        \"target_speed\",\n        \"target_flow\",\n        \"base_speed\",\n        \"base_flow\",\n    ],\n].copy()\n\n# Metadata IDs remain strings such as L405S-406.\neval_frame[\"link_id\"] = eval_frame[\"link_id\"].astype(\"string\").str.strip()\nlane_metadata = links[[\"link_id\", \"lanes\"]].copy()\nlane_metadata[\"link_id\"] = lane_metadata[\"link_id\"].astype(\"string\").str.strip()\n\neval_frame = eval_frame.merge(\n    lane_metadata,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nmissing_lane_ids = eval_frame.loc[\n    eval_frame[\"lanes\"].isna(), \"link_id\"\n].drop_duplicates().tolist()\n\nrequire(\n    not missing_lane_ids,\n    f\"Lane metadata missing for link IDs: {missing_lane_ids[:20]}\",\n)\nrequire((eval_frame[\"lanes\"] > 0).all(), \"Invalid lanes in holdout.\")\n\ndef calculate_scores(frame, speed_column, flow_column, experiment_name):\n    rows = []\n\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        part = frame.loc[frame[\"mask_regime\"].eq(regime)].copy()\n        require(len(part) > 0, f\"No evaluation rows for {regime}.\")\n\n        speed_error = rmse(\n            part[\"target_speed\"],\n            part[speed_column],\n        )\n\n        flow_error_per_lane = rmse(\n            part[\"target_flow\"].to_numpy(dtype=float)\n            / part[\"lanes\"].to_numpy(dtype=float),\n            part[flow_column].to_numpy(dtype=float)\n            / part[\"lanes\"].to_numpy(dtype=float),\n        )\n\n        speed_score = max(0.0, 1.0 - speed_error / 25.0)\n        flow_score = max(0.0, 1.0 - flow_error_per_lane / 600.0)\n        state_score = 0.54 * speed_score + 0.46 * flow_score\n\n        rows.append({\n            \"experiment\": experiment_name,\n            \"mask_regime\": regime,\n            \"n_targets\": len(part),\n            \"speed_RMSE\": speed_error,\n            \"flow_RMSE_per_lane\": flow_error_per_lane,\n            \"score\": state_score,\n        })\n\n    result = pd.DataFrame(rows)\n    result.loc[len(result)] = {\n        \"experiment\": experiment_name,\n        \"mask_regime\": \"MACRO\",\n        \"n_targets\": len(frame),\n        \"speed_RMSE\": np.nan,\n        \"flow_RMSE_per_lane\": np.nan,\n        \"score\": result[\"score\"].mean(),\n    }\n    return result\n\nbaseline_metrics = calculate_scores(\n    eval_frame,\n    \"base_speed\",\n    \"base_flow\",\n    \"baseline\",\n)\n\nbaseline_macro = float(\n    baseline_metrics.loc[\n        baseline_metrics[\"mask_regime\"].eq(\"MACRO\"), \"score\"\n    ].iloc[0]\n)\n\nprint(baseline_metrics.to_string(index=False))\nprint(f\"\\nRecomputed baseline: {baseline_macro:.6f}\")\nprint(f\"Known reference:     {KNOWN_BASELINE_SCORE:.6f}\")\n\nif abs(baseline_macro - KNOWN_BASELINE_SCORE) > BASELINE_TOLERANCE:\n    raise RuntimeError(\n        \"Baseline verification failed. Model training stopped. \"\n        f\"Recomputed={baseline_macro:.6f}, \"\n        f\"reference={KNOWN_BASELINE_SCORE:.6f}. \"\n        \"The residual model has not been evaluated.\"\n    )\n\nprint(\"Baseline verification passed.\")\n\n\n# ----------------------------- 8. TRAIN AND SCORE -----------------------------\n\nprint(\"\\n[8/9] Training residual models...\")\n\nmodel_params = {\n    \"learning_rate\": 0.06,\n    \"max_iter\": 150,\n    \"max_leaf_nodes\": 31,\n    \"l2_regularization\": 5.0,\n    \"early_stopping\": True,\n    \"validation_fraction\": 0.1,\n    \"n_iter_no_change\": 15,\n    \"random_state\": 42,\n}\n\nspeed_model = HistGradientBoostingRegressor(**model_params)\nflow_model = HistGradientBoostingRegressor(**model_params)\n\nspeed_model.fit(X_train, y_speed)\nprint(\"Speed residual model trained.\")\n\nflow_model.fit(X_train, y_flow)\nprint(\"Flow residual model trained.\")\n\npred_speed = np.clip(\n    eval_frame[\"base_speed\"].to_numpy(dtype=float)\n    + speed_model.predict(X_holdout),\n    0.0,\n    160.0,\n)\n\npred_flow = np.clip(\n    eval_frame[\"base_flow\"].to_numpy(dtype=float)\n    + flow_model.predict(X_holdout),\n    0.0,\n    None,\n)\n\neval_frame[\"pred_speed_baseline\"] = eval_frame[\"base_speed\"]\neval_frame[\"pred_flow_baseline\"] = eval_frame[\"base_flow\"]\neval_frame[\"pred_speed_model\"] = pred_speed\neval_frame[\"pred_flow_model\"] = pred_flow\n\nmodel_metrics = calculate_scores(\n    eval_frame,\n    \"pred_speed_model\",\n    \"pred_flow_model\",\n    \"residual_model\",\n)\n\nall_metrics = pd.concat(\n    [baseline_metrics, model_metrics],\n    ignore_index=True,\n)\n\nprint(\"\\nBaseline versus residual model:\")\nprint(all_metrics.to_string(index=False))\n\nmodel_macro = float(\n    model_metrics.loc[\n        model_metrics[\"mask_regime\"].eq(\"MACRO\"), \"score\"\n    ].iloc[0]\n)\n\nprint(f\"\\nBaseline macro score:       {baseline_macro:.6f}\")\nprint(f\"Residual model macro score: {model_macro:.6f}\")\nprint(f\"Score change:               {model_macro - baseline_macro:+.6f}\")\n\n\n# ----------------------------- 9. SAVE RESULTS -----------------------------\n\nprint(\"\\n[9/9] Saving experiment artifacts...\")\n\nprediction_path = OUT / \"february_residual_predictions.csv\"\nmetrics_path = OUT / \"february_residual_metrics.csv\"\nsummary_path = OUT / \"experiment_summary.json\"\n\neval_frame[\n    KEYS + [\n        \"mask_regime\",\n        \"lanes\",\n        \"target_speed\",\n        \"target_flow\",\n        \"pred_speed_baseline\",\n        \"pred_flow_baseline\",\n        \"pred_speed_model\",\n        \"pred_flow_model\",\n    ]\n].to_csv(prediction_path, index=False)\n\nall_metrics.to_csv(metrics_path, index=False)\n\nsummary = {\n    \"panel\": PANEL,\n    \"training_targets\": int(len(X_train)),\n    \"holdout_targets\": int(len(X_holdout)),\n    \"feature_count\": int(len(FEATURES)),\n    \"known_baseline_macro\": KNOWN_BASELINE_SCORE,\n    \"recomputed_baseline_macro\": baseline_macro,\n    \"residual_model_macro\": model_macro,\n    \"score_change\": model_macro - baseline_macro,\n    \"improved_over_baseline\": bool(model_macro > baseline_macro),\n    \"status\": \"completed\",\n    \"scope\": \"February 2031 holdout, panel D7_I405_S only\",\n}\n\nwith open(summary_path, \"w\") as f:\n    json.dump(summary, f, indent=2)\n\nprint(\"\\nSaved files:\")\nprint(prediction_path)\nprint(metrics_path)\nprint(summary_path)\n\nif model_macro > baseline_macro:\n    print(\"\\nRESULT: Residual model improved the February holdout score.\")\nelse:\n    print(\"\\nRESULT: Residual model did not improve the February holdout score.\")\n    print(\"Retain the verified baseline until a better method is validated.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T13:19:26.065064Z","iopub.execute_input":"2026-10-19T13:19:26.065675Z","iopub.status.idle":"2026-10-19T13:21:14.908273Z","shell.execute_reply.started":"2026-10-19T13:19:26.065623Z","shell.execute_reply":"2026-10-19T13:21:14.907143Z"}},"outputs":[{"name":"stdout","text":"\n[1/9] Loading source data...\n  Loaded 50/273 files: mainline_states\n  Loaded 100/273 files: mainline_states\n  Loaded 150/273 files: mainline_states\n  Loaded 200/273 files: mainline_states\n  Loaded 250/273 files: mainline_states\n  Loaded 273/273 files: mainline_states\n  Loaded 50/273 files: mainline_states_masked\n  Loaded 100/273 files: mainline_states_masked\n  Loaded 150/273 files: mainline_states_masked\n  Loaded 200/273 files: mainline_states_masked\n  Loaded 250/273 files: mainline_states_masked\n  Loaded 273/273 files: mainline_states_masked\nTruth rows:  8,570,016\nMasked rows: 8,570,016\nTemplate rows: 2,127,937\nLink metadata rows: 109\n\n[2/9] Preparing official training and February holdout targets...\nDecember-January training targets: 479,688\nFebruary holdout targets: 235,491\n\n[3/9] Joining ground-truth labels once...\n\n[4/9] Building month-specific historical profiles...\n  2030-12: 244,890 rows; profile cutoff=2030-12-01 00:00:00+00:00\n  2031-01: 234,798 rows; profile cutoff=2031-01-01 00:00:00+00:00\n  2031-02: 235,491 rows; profile cutoff=2031-02-01 00:00:00+00:00\n\n[5/9] Building masked-only lag features...\n  Joining 5-minute lag...\n  Joining 15-minute lag...\n  Joining 60-minute lag...\n  Joining 1440-minute lag...\n\n[6/9] Preparing model features...\nTraining matrix: (479688, 19)\nHoldout matrix: (235491, 19)\nTraining missing feature cells: 1645088\nHoldout missing feature cells: 831660\n\n[7/9] Checking the February baseline...\nexperiment mask_regime  n_targets  speed_RMSE  flow_RMSE_per_lane    score\n  baseline          R1      19157   11.115449           79.416453 0.699020\n  baseline          R2     108110   12.817455          101.875854 0.645038\n  baseline          R3     108224   13.623117          116.497210 0.616426\n  baseline       MACRO     235491         NaN                 NaN 0.653495\n\nRecomputed baseline: 0.653495\nKnown reference:     0.653495\nBaseline verification passed.\n\n[8/9] Training residual models...\nSpeed residual model trained.\nFlow residual model trained.\n\nBaseline versus residual model:\n    experiment mask_regime  n_targets  speed_RMSE  flow_RMSE_per_lane    score\n      baseline          R1      19157   11.115449           79.416453 0.699020\n      baseline          R2     108110   12.817455          101.875854 0.645038\n      baseline          R3     108224   13.623117          116.497210 0.616426\n      baseline       MACRO     235491         NaN                 NaN 0.653495\nresidual_model          R1      19157    4.768476           56.288568 0.853846\nresidual_model          R2     108110    5.299007           60.753642 0.838964\nresidual_model          R3     108224    7.400609           72.784774 0.784345\nresidual_model       MACRO     235491         NaN                 NaN 0.825718\n\nBaseline macro score:       0.653495\nResidual model macro score: 0.825718\nScore change:               +0.172224\n\n[9/9] Saving experiment artifacts...\n\nSaved files:\n/kaggle/working/trafficflow_residual_experiment/february_residual_predictions.csv\n/kaggle/working/trafficflow_residual_experiment/february_residual_metrics.csv\n/kaggle/working/trafficflow_residual_experiment/experiment_summary.json\n\nRESULT: Residual model improved the February holdout score.\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"\n# ============================================================\n# IEEETrafficFlow — STAGE 2.1\n# Cross-panel readiness audit\n# Read-only: no training and no source files modified\n# ============================================================\n\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\ndef require(condition, message):\n    if not condition:\n        raise RuntimeError(message)\n\nresults = []\n\nprint(\"STAGE 2.1 — CROSS-PANEL READINESS AUDIT\")\nprint(\"Dataset root:\", ROOT)\n\nrequire(ROOT.exists(), f\"Dataset root not found: {ROOT}\")\n\nfor panel in PANELS:\n    print(f\"\\nChecking {panel}...\")\n\n    corridor = ROOT / \"corridors\" / panel\n    truth_dir = corridor / \"train\" / \"mainline_states\"\n    masked_dir = corridor / \"train\" / \"mainline_states_masked\"\n    links_path = corridor / \"network\" / \"links.csv\"\n\n    train_path = (\n        ROOT / \"task1\" / panel / \"train\"\n        / \"sample_submission_state.csv\"\n    )\n    validation_path = (\n        ROOT / \"task1\" / panel / \"validation\"\n        / \"sample_submission_state.csv\"\n    )\n    private_path = (\n        ROOT / \"task1\" / panel / \"private\"\n        / \"sample_submission_state.csv\"\n    )\n\n    paths = {\n        \"truth_dir\": truth_dir,\n        \"masked_dir\": masked_dir,\n        \"links_csv\": links_path,\n        \"train_template\": train_path,\n        \"validation_template\": validation_path,\n        \"private_template\": private_path,\n    }\n\n    missing_paths = [\n        name for name, path in paths.items()\n        if not path.exists()\n    ]\n\n    if missing_paths:\n        print(\"  STATUS: MISSING REQUIRED PATHS\")\n        print(\"  Missing:\", missing_paths)\n        results.append({\n            \"panel\": panel,\n            \"status\": \"MISSING_PATHS\",\n            \"truth_files\": None,\n            \"masked_files\": None,\n            \"train_targets\": None,\n            \"validation_targets\": None,\n            \"private_targets\": None,\n            \"link_metadata_rows\": None,\n            \"target_links_missing_metadata\": None,\n        })\n        continue\n\n    truth_files = sorted(truth_dir.rglob(\"*.parquet\"))\n    masked_files = sorted(masked_dir.rglob(\"*.parquet\"))\n\n    if not truth_files or not masked_files:\n        print(\"  STATUS: NO PARQUET FILES\")\n        results.append({\n            \"panel\": panel,\n            \"status\": \"NO_PARQUETS\",\n            \"truth_files\": len(truth_files),\n            \"masked_files\": len(masked_files),\n            \"train_targets\": None,\n            \"validation_targets\": None,\n            \"private_targets\": None,\n            \"link_metadata_rows\": None,\n            \"target_links_missing_metadata\": None,\n        })\n        continue\n\n    # Inspect the first file from each source for required columns.\n    truth_columns = set(pd.read_parquet(truth_files[0]).columns)\n    masked_columns = set(pd.read_parquet(masked_files[0]).columns)\n\n    required_truth = {\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\", \"pct_observed\",\n        \"is_score_eligible\",\n    }\n    required_masked = {\n        \"timestamp\", \"station_id\", \"link_id\",\n        \"speed_kmh\", \"flow_vph\",\n    }\n\n    schema_ok = (\n        required_truth.issubset(truth_columns)\n        and required_masked.issubset(masked_columns)\n    )\n\n    train = pd.read_csv(train_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n    validation = pd.read_csv(validation_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n    private = pd.read_csv(private_path, usecols=[\n        \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n    ])\n\n    links = pd.read_csv(links_path, usecols=[\"link_id\", \"lanes\"])\n    links[\"link_id\"] = links[\"link_id\"].astype(\"string\").str.strip()\n\n    # Compare identifiers as strings; IDs are not necessarily numeric.\n    target_links = set(\n        train[\"link_id\"].astype(\"string\").str.strip().dropna().unique()\n    )\n    metadata_links = set(links[\"link_id\"].dropna().unique())\n    missing_link_metadata = sorted(target_links - metadata_links)\n\n    duplicate_metadata_ids = int(links[\"link_id\"].duplicated().sum())\n    invalid_lanes = int(\n        (\n            pd.to_numeric(links[\"lanes\"], errors=\"coerce\").isna()\n            | (pd.to_numeric(links[\"lanes\"], errors=\"coerce\") <= 0)\n        ).sum()\n    )\n\n    duplicate_train_keys = int(\n        train.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum()\n    )\n    duplicate_validation_keys = int(\n        validation.duplicated(\n            [\"timestamp\", \"station_id\", \"link_id\"]\n        ).sum()\n    )\n    duplicate_private_keys = int(\n        private.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum()\n    )\n\n    status = (\n        \"READY_FOR_NEXT_CHECK\"\n        if (\n            schema_ok\n            and not missing_link_metadata\n            and duplicate_metadata_ids == 0\n            and invalid_lanes == 0\n            and duplicate_train_keys == 0\n            and duplicate_validation_keys == 0\n            and duplicate_private_keys == 0\n        )\n        else \"REVIEW_REQUIRED\"\n    )\n\n    results.append({\n        \"panel\": panel,\n        \"status\": status,\n        \"truth_files\": len(truth_files),\n        \"masked_files\": len(masked_files),\n        \"train_targets\": len(train),\n        \"validation_targets\": len(validation),\n        \"private_targets\": len(private),\n        \"link_metadata_rows\": len(links),\n        \"target_links_missing_metadata\": len(missing_link_metadata),\n        \"truth_schema_ok\": schema_ok,\n        \"duplicate_metadata_ids\": duplicate_metadata_ids,\n        \"invalid_lane_rows\": invalid_lanes,\n        \"duplicate_train_keys\": duplicate_train_keys,\n        \"duplicate_validation_keys\": duplicate_validation_keys,\n        \"duplicate_private_keys\": duplicate_private_keys,\n    })\n\n    print(\"  Truth files:\", len(truth_files))\n    print(\"  Masked files:\", len(masked_files))\n    print(\"  Target counts:\", len(train), len(validation), len(private))\n    print(\"  Missing target-link metadata:\", len(missing_link_metadata))\n    if missing_link_metadata:\n        print(\"  Example missing IDs:\", missing_link_metadata[:10])\n    print(\"  Schema valid:\", schema_ok)\n    print(\"  Status:\", status)\n\n    del train, validation, private, links\n    del truth_columns, masked_columns\n    del truth_files, masked_files\n    import gc\n    gc.collect()\n\nreport = pd.DataFrame(results)\n\nprint(\"\\n\" + \"=\" * 90)\nprint(\"STAGE 2.1 SUMMARY\")\nprint(\"=\" * 90)\npr