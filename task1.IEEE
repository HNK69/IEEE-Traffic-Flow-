base = ROOT / \"corridors\" / panel\n\ntruth_file = next(\n    (base / \"train\" / \"mainline_states\").rglob(\"*.parquet\")\n)\nmasked_file = next(\n    (base / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\ntruth_sample = pd.read_parquet(truth_file)\nmasked_sample = pd.read_parquet(masked_file)\n\nprint(\"Truth file:\", truth_file.relative_to(ROOT))\nprint(\"Truth shape:\", truth_sample.shape)\nprint(\"Truth columns:\", truth_sample.columns.tolist())\n\nprint(\"\\nMasked file:\", masked_file.relative_to(ROOT))\nprint(\"Masked shape:\", masked_sample.shape)\nprint(\"Masked columns:\", masked_sample.columns.tolist())\n\nprint(\"\\nTruth eligible:\", int(truth_sample[\"is_score_eligible\"].sum()))\nprint(\"Masked regimes:\", masked_sample[\"mask_regime\"].value_counts().to_dict())\n\ndel truth_sample, masked_sample\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:59:20.254642Z","iopub.execute_input":"2026-10-19T17:59:20.255111Z","iopub.status.idle":"2026-10-19T17:59:21.458149Z","shell.execute_reply.started":"2026-10-19T17:59:20.255079Z","shell.execute_reply":"2026-10-19T17:59:21.457173Z"}},"outputs":[{"name":"stdout","text":"Truth file: corridors/D12_I405_N/train/mainline_states/year_month=2031-02/synthetic_mainline_2031_02_08.parquet\nTruth shape: (25632, 16)\nTruth columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n\nMasked file: corridors/D12_I405_N/train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2031_01_10.parquet\nMasked shape: (25632, 17)\nMasked columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n\nTruth eligible: 19640\nMasked regimes: {'R1': 25632}\n","output_type":"stream"},{"execution_count":160,"output_type":"execute_result","data":{"text/plain":"0"},"metadata":{}}],"execution_count":160},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nWORK = Path(\"/kaggle/working\")\npanel = \"D12_I405_N\"\n\n# Panel-specific link metadata\nlinks_next = pd.read_csv(\n    ROOT / \"corridors\" / panel / \"network\" / \"links.csv\"\n)\n\n# Official prediction templates\nval_template = pd.read_csv(\n    ROOT / \"task1\" / panel / \"validation\" / \"sample_submission_state.csv\"\n)\npriv_template = pd.read_csv(\n    ROOT / \"task1\" / panel / \"private\" / \"sample_submission_state.csv\"\n)\n\nprint(\"Panel:\", panel)\nprint(\"Links:\", links_next.shape)\nprint(\"Validation template:\", val_template.shape)\nprint(\"Private template:\", priv_template.shape)\nprint(\"Expected total:\", len(val_template) + len(priv_template))\nprint(\"Existing checkpoint:\", len(predictions))\n\nassert links_next[\"link_id\"].is_unique\nassert not val_template.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any()\nassert not priv_template.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any()\n\nprint(\"Template checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:04:24.19974Z","iopub.execute_input":"2026-10-19T18:04:24.200312Z","iopub.status.idle":"2026-10-19T18:04:25.127199Z","shell.execute_reply.started":"2026-10-19T18:04:24.200271Z","shell.execute_reply":"2026-10-19T18:04:25.125723Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I405_N\nLinks: (89, 5)\nValidation template: (203337, 7)\nPrivate template: (192164, 7)\nExpected total: 395501\nExisting checkpoint: 515542\nTemplate checks passed.\n","output_type":"stream"}],"execution_count":163},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I405_N\"\ntruth_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n\nneeded_cols = [\n    \"timestamp\", \"station_id\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"is_score_eligible\",\n]\n\nfiles = sorted(truth_dir.rglob(\"*.parquet\"))\nselected = [\n    p for p in files\n    if any(month in str(p) for month in [\"year_month=2030-12\", \"year_month=2031-01\"])\n]\n\nprint(\"Selected files:\", len(selected))\n\nparts = []\nfor i, path in enumerate(selected, 1):\n    df = pd.read_parquet(path, columns=needed_cols)\n    df = df.loc[df[\"is_score_eligible\"].eq(True)]\n    parts.append(df.drop(columns=\"is_score_eligible\"))\n\n    del df\n    if i % 10 == 0:\n        print(f\"Loaded {i}/{len(selected)} files\")\n\nhistory_next = pd.concat(parts, ignore_index=True)\ndel parts\ngc.collect()\n\nhistory_next[\"timestamp\"] = pd.to_datetime(\n    history_next[\"timestamp\"], utc=True\n)\n\nprint(\"History rows:\", len(history_next))\nprint(\"Date range:\", history_next[\"timestamp\"].min(),\n      \"to\", history_next[\"timestamp\"].max())\nprint(\"Memory (GiB):\",\n      round(history_next.memory_usage(deep=True).sum() / 1024**3, 2))\n\nprint(\"Available RAM check:\")\nwith open(\"/proc/meminfo\") as f:\n    available_kib = int(\n        next(line.split()[1] for line in f\n             if line.startswith(\"MemAvailable:\"))\n    )\nprint(round(available_kib / 1024**2, 2), \"GiB\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:07:11.124467Z","iopub.execute_input":"2026-10-19T18:07:11.124999Z","iopub.status.idle":"2026-10-19T18:07:15.239227Z","shell.execute_reply.started":"2026-10-19T18:07:11.124964Z","shell.execute_reply":"2026-10-19T18:07:15.237883Z"}},"outputs":[{"name":"stdout","text":"Selected files: 62\nLoaded 10/62 files\nLoaded 20/62 files\nLoaded 30/62 files\nLoaded 40/62 files\nLoaded 50/62 files\nLoaded 60/62 files\nHistory rows: 1214879\nDate range: 2030-12-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\nMemory (GiB): 0.17\nAvailable RAM check:\n19.03 GiB\n","output_type":"stream"}],"execution_count":165},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I405_N\"\nmasked_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states_masked\"\n\nneeded_cols = [\n    \"timestamp\", \"station_id\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\",\n]\n\nfiles = sorted(masked_dir.rglob(\"*.parquet\"))\nparts = []\n\nfor i, path in enumerate(files, 1):\n    df = pd.read_parquet(path, columns=needed_cols)\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n    # Filter by actual timestamps, not directory names.\n    keep = (\n        ((ts >= \"2030-12-01\") & (ts < \"2031-02-01\"))\n        & df[\"is_observed\"].eq(True)\n    )\n    df = df.loc[keep].copy()\n\n    if not df.empty:\n        df = df.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\",\n        })\n        parts.append(df.drop(columns=\"is_observed\"))\n\n    del df, ts, keep\n\n    if i % 25 == 0:\n        gc.collect()\n        print(f\"Scanned {i}/{len(files)} files\")\n\nif not parts:\n    raise ValueError(\"No observed masked rows found for Dec 2030–Jan 2031.\")\n\nmasked_next = pd.concat(parts, ignore_index=True)\ndel parts\ngc.collect()\n\nmasked_next[\"timestamp\"] = pd.to_datetime(\n    masked_next[\"timestamp\"], utc=True\n)\n\nprint(\"Masked lookup rows:\", len(masked_next))\nprint(\"Date range:\", masked_next[\"timestamp\"].min(),\n      \"to\", masked_next[\"timestamp\"].max())\nprint(\"Regimes:\", masked_next[\"mask_regime\"].value_counts().to_dict())\nprint(\"Memory (GiB):\",\n      round(masked_next.memory_usage(deep=True).sum() / 1024**3, 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:09:16.764011Z","iopub.execute_input":"2026-10-19T18:09:16.765226Z","iopub.status.idle":"2026-10-19T18:09:34.426762Z","shell.execute_reply.started":"2026-10-19T18:09:16.765177Z","shell.execute_reply":"2026-10-19T18:09:34.425258Z"}},"outputs":[{"name":"stdout","text":"Scanned 25/273 files\nScanned 50/273 files\nScanned 75/273 files\nScanned 100/273 files\nScanned 125/273 files\nScanned 150/273 files\nScanned 175/273 files\nScanned 200/273 files\nScanned 225/273 files\nScanned 250/273 files\nMasked lookup rows: 1327024\nDate range: 2030-12-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\nRegimes: {'R2': 491697, 'R3': 428500, 'R1': 406827}\nMemory (GiB): 0.25\n","output_type":"stream"}],"execution_count":167},{"cell_type":"code","source":"KEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nfor name, df in [\n    (\"history_next\", history_next),\n    (\"masked_next\", masked_next),\n]:\n    print(f\"\\n{name}:\")\n    print(\"Rows:\", len(df))\n    print(\"Duplicate keys:\", int(df.duplicated(KEYS).sum()))\n    print(\"Null keys:\", int(df[KEYS].isna().any(axis=1).sum()))\n    print(\"Unique links:\", df[\"link_id\"].nunique())\n    print(\"Unique stations:\", df[\"station_id\"].nunique())\n\nprint(\"\\nTarget templates:\")\nprint(\"Validation:\", len(val_template))\nprint(\"Private:\", len(priv_template))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:12:26.960924Z","iopub.execute_input":"2026-10-19T18:12:26.961447Z","iopub.status.idle":"2026-10-19T18:12:28.22814Z","shell.execute_reply.started":"2026-10-19T18:12:26.961414Z","shell.execute_reply":"2026-10-19T18:12:28.226791Z"}},"outputs":[{"name":"stdout","text":"\nhistory_next:\nRows: 1214879\nDuplicate keys: 0\nNull keys: 0\nUnique links: 89\nUnique stations: 89\n\nmasked_next:\nRows: 1327024\nDuplicate keys: 0\nNull keys: 0\nUnique links: 89\nUnique stations: 89\n\nTarget templates:\nValidation: 203337\nPrivate: 192164\n","output_type":"stream"}],"execution_count":168},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport gc\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\n# 1. December history only: strictly before January.\ndec_history = history_next.loc[\n    history_next[\"timestamp\"] < pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\ndec_history[\"weekday\"] = dec_history[\"timestamp\"].dt.dayofweek\ndec_history[\"minute_of_day\"] = (\n    dec_history[\"timestamp\"].dt.hour * 60\n    + dec_history[\"timestamp\"].dt.minute\n)\n\n# 2. Build baseline profiles from December.\nprofile_min = (\n    dec_history.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"], observed=True\n    )[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\nprofile_week = (\n    dec_history.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\nprofile_link = (\n    dec_history.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\n\n# 3. January eligible labels with their assigned mask regimes.\njan_labels = history_next.loc[\n    history_next[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\njan_labels = jan_labels.merge(\n    masked_next[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\",\n)\n\njan_labels[\"weekday\"] = jan_labels[\"timestamp\"].dt.dayofweek\njan_labels[\"minute_of_day\"] = (\n    jan_labels[\"timestamp\"].dt.hour * 60\n    + jan_labels[\"timestamp\"].dt.minute\n)\n\n# 4. Attach baseline, with link-wide fallback.\njan_features = jan_labels.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    suffixes=(\"\", \"_profile\"),\n    validate=\"many_to_one\",\n)\n\nfor col in VALUE_COLS:\n    jan_features = jan_features.merge(\n        profile_week.rename(columns={col: f\"{col}_week\"})[\n            [\"link_id\", \"weekday\", f\"{col}_week\"]\n        ],\n        on=[\"link_id\", \"weekday\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    jan_features = jan_features.merge(\n        profile_link.rename(columns={col: f\"{col}_link\"})[\n            [\"link_id\", f\"{col}_link\"]\n        ],\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    jan_features[col] = (\n        jan_features[col]\n        .fillna(jan_features[f\"{col}_week\"])\n        .fillna(jan_features[f\"{col}_link\"])\n    )\n\njan_features = jan_features.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\",\n})\njan_features[\"base_speed\"] = jan_features[\"target_speed\"]\njan_features[\"base_flow\"] = jan_features[\"target_flow\"]\n\n# 5. Add masked lag values at t-5, t-15, t-60, t-1440 minutes.\nlag_source = masked_next[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source.copy()\n    lag[\"timestamp\"] = lag[\"timestamp\"] + pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\",\n    })\n    jan_features = jan_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n    del lag\n    gc.collect()\n\n# 6. Time features and panel-local categorical encodings.\nts = jan_features[\"timestamp\"]\nweekday = ts.dt.dayofweek.to_numpy()\nminute = ts.dt.hour.to_numpy() * 60 + ts.dt.minute.to_numpy()\n\njan_features[\"weekday\"] = weekday\njan_features[\"minute_of_day\"] = minute\njan_features[\"tod_sin\"] = np.sin(2 * np.pi * minute / 1440)\njan_features[\"tod_cos\"] = np.cos(2 * np.pi * minute / 1440)\njan_features[\"weekday_sin\"] = np.sin(2 * np.pi * weekday / 7)\njan_features[\"weekday_cos\"] = np.cos(2 * np.pi * weekday / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    jan_features[f\"{col}_code\"] = pd.Categorical(\n        jan_features[col],\n        categories=sorted(jan_features[col].dropna().unique()),\n    ).codes\n\nprint(\"January training rows:\", len(jan_features))\nprint(\"Missing baselines:\", int(\n    jan_features[[\"base_speed\", \"base_flow\"]].isna().any(axis=1).sum()\n))\nprint(\"Missing lag values:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].isna().any(axis=1).sum()\n))\nprint(\"Memory (GiB):\", round(\n    jan_features.memory_usage(deep=True).sum() / 1024**3, 2\n))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:13:06.531188Z","iopub.execute_input":"2026-10-19T18:13:06.531708Z","iopub.status.idle":"2026-10-19T18:13:18.768616Z","shell.execute_reply.started":"2026-10-19T18:13:06.531676Z","shell.execute_reply":"2026-10-19T18:13:18.767582Z"}},"outputs":[{"name":"stdout","text":"January training rows: 607319\nMissing baselines: 0\nMissing lag values: 521023\nMemory (GiB): 0.21\n","output_type":"stream"}],"execution_count":169},{"cell_type":"code","source":"lag_cols = [\n    f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]\n] + [\n    f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]\n]\n\nprint(\"Missing fraction per lag:\")\nprint(jan_features[lag_cols].isna().mean().sort_index().to_string())\n\nprint(\"\\nNon-missing count per lag:\")\nprint(jan_features[lag_cols].notna().sum().to_string())\n\nprint(\"\\nMasked source timestamp range:\")\nprint(masked_next[\"timestamp\"].min(), \"to\", masked_next[\"timestamp\"].max())\n\nprint(\"\\nJanuary target timestamp range:\")\nprint(jan_features[\"timestamp\"].min(), \"to\", jan_features[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:18:16.380093Z","iopub.execute_input":"2026-10-19T18:18:16.380584Z","iopub.status.idle":"2026-10-19T18:18:16.464615Z","shell.execute_reply.started":"2026-10-19T18:18:16.380553Z","shell.execute_reply":"2026-10-19T18:18:16.463438Z"}},"outputs":[{"name":"stdout","text":"Missing fraction per lag:\nlag_flow_1440     0.403465\nlag_flow_15       0.389617\nlag_flow_5        0.382489\nlag_flow_60       0.403921\nlag_speed_1440    0.403465\nlag_speed_15      0.389617\nlag_speed_5       0.382489\nlag_speed_60      0.403921\n\nNon-missing count per lag:\nlag_speed_5       375026\nlag_speed_15      370697\nlag_speed_60      362010\nlag_speed_1440    362287\nlag_flow_5        375026\nlag_flow_15       370697\nlag_flow_60       362010\nlag_flow_1440     362287\n\nMasked source timestamp range:\n2030-12-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\n\nJanuary target timestamp range:\n2031-01-01 00:00:00+00:00 to 2031-01-31 23:55:00+00:00\n","output_type":"stream"}],"execution_count":170},{"cell_type":"code","source":"print(\"Masked observation flags:\")\nprint(masked_next[[\"masked_speed\", \"masked_flow\"]].isna().mean())\n\nprint(\"\\nTarget labels:\")\nprint(jan_features[[\"target_speed\", \"target_flow\"]].isna().mean())\n\nprint(\"\\nRows with all four speed lags:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].notna().all(axis=1).sum()\n))\n\nprint(\"Rows with no speed lags:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].isna().all(axis=1).sum()\n))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:18:49.356949Z","iopub.execute_input":"2026-10-19T18:18:49.358162Z","iopub.status.idle":"2026-10-19T18:18:49.413127Z","shell.execute_reply.started":"2026-10-19T18:18:49.358121Z","shell.execute_reply":"2026-10-19T18:18:49.41179Z"}},"outputs":[{"name":"stdout","text":"Masked observation flags:\nmasked_speed    0.305389\nmasked_flow     0.305389\ndtype: float64\n\nTarget labels:\ntarget_speed    0.0\ntarget_flow     0.0\ndtype: float64\n\nRows with all four speed lags: 86296\nRows with no speed lags: 17168\n","output_type":"stream"}],"execution_count":171},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. Preserve January ground-truth labels separately\njan_targets = history_next.loc[\n    history_next[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"),\n    KEYS + VALUE_COLS\n].copy()\n\njan_targets = jan_targets.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\"\n})\n\n# Only retain targets with a valid mask-regime assignment\njan_targets = jan_targets.merge(\n    masked_next[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# 2. Build the baseline exclusively from December truth\ndec_history = history_next.loc[\n    history_next[\"timestamp\"] < pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\ndec_history[\"weekday\"] = dec_history[\"timestamp\"].dt.dayofweek\ndec_history[\"minute_of_day\"] = (\n    dec_history[\"timestamp\"].dt.hour * 60\n    + dec_history[\"timestamp\"].dt.minute\n)\n\nprofile_min = (\n    dec_history.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week = (\n    dec_history.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link = (\n    dec_history.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 3. Join profiles without overwriting the target labels\njan_features_fixed = jan_targets.copy()\n\njan_features_fixed[\"weekday\"] = jan_features_fixed[\"timestamp\"].dt.dayofweek\njan_features_fixed[\"minute_of_day\"] = (\n    jan_features_fixed[\"timestamp\"].dt.hour * 60\n    + jan_features_fixed[\"timestamp\"].dt.minute\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfor target, candidates in [\n    (\"speed\", [\"base_speed_min\", \"base_speed_week\", \"base_speed_link\"]),\n    (\"flow\", [\"base_flow_min\", \"base_flow_week\", \"base_flow_link\"])\n]:\n    jan_features_fixed[f\"base_{target}\"] = (\n        jan_features_fixed[candidates[0]]\n        .fillna(jan_features_fixed[candidates[1]])\n        .fillna(jan_features_fixed[candidates[2]])\n    )\n\n# 4. Attach observed-value lags\nlag_source = masked_next[\n    KEYS + [\"masked_speed\", \"masked_flow\"]\n].copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source.copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    jan_features_fixed = jan_features_fixed.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 5. Time features\njan_features_fixed[\"tod_sin\"] = np.sin(\n    2 * np.pi * jan_features_fixed[\"minute_of_day\"] / 1440\n)\njan_features_fixed[\"tod_cos\"] = np.cos(\n    2 * np.pi * jan_features_fixed[\"minute_of_day\"] / 1440\n)\njan_features_fixed[\"weekday_sin\"] = np.sin(\n    2 * np.pi * jan_features_fixed[\"weekday\"] / 7\n)\njan_features_fixed[\"weekday_cos\"] = np.cos(\n    2 * np.pi * jan_features_fixed[\"weekday\"] / 7\n)\n\n# Stable categorical codes\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    jan_features_fixed[f\"{col}_code\"] = (\n        pd.Categorical(\n            jan_features_fixed[col],\n            categories=sorted(jan_features_fixed[col].dropna().unique())\n        ).codes\n    )\n\n# 6. Validate before training\nassert len(jan_features_fixed) == len(jan_targets)\nassert jan_features_fixed[[\"target_speed\", \"target_flow\"]].notna().all().all()\nassert jan_features_fixed[[\"base_speed\", \"base_flow\"]].notna().all().all()\nassert not jan_features_fixed.duplicated(KEYS).any()\n\nprint(\"Rows:\", len(jan_features_fixed))\nprint(\"Target label missingness:\")\nprint(jan_features_fixed[[\"target_speed\", \"target_flow\"]].isna().mean())\nprint(\"\\nBaseline missingness:\")\nprint(jan_features_fixed[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"\\nBaseline vs target correlation (sanity check):\")\nprint(jan_features_fixed[[\n    \"target_speed\", \"base_speed\", \"target_flow\", \"base_flow\"\n]].corr().round(3))\nprint(\"\\nFeature table ready:\", jan_features_fixed.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:23:13.22908Z","iopub.execute_input":"2026-10-19T18:23:13.230179Z","iopub.status.idle":"2026-10-19T18:23:22.642748Z","shell.execute_reply.started":"2026-10-19T18:23:13.230133Z","shell.execute_reply":"2026-10-19T18:23:22.641636Z"}},"outputs":[{"name":"stdout","text":"Rows: 607319\nTarget label missingness:\ntarget_speed    0.0\ntarget_flow     0.0\ndtype: float64\n\nBaseline missingness:\nbase_speed    0.0\nbase_flow     0.0\ndtype: float64\n\nBaseline vs target correlation (sanity check):\n              target_speed  base_speed  target_flow  base_flow\ntarget_speed         1.000       0.837       -0.140     -0.131\nbase_speed           0.837       1.000       -0.146     -0.151\ntarget_flow         -0.140      -0.146        1.000      0.984\nbase_flow           -0.131      -0.151        0.984      1.000\n\nFeature table ready: (607319, 31)\n","output_type":"stream"}],"execution_count":172},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\nimport gc\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\"\n]\n\ndf = jan_features_fixed.sort_values(\"timestamp\").reset_index(drop=True)\n\n# Chronological holdout: final 20% of January timestamps\nunique_times = np.sort(df[\"timestamp\"].unique())\ncut_idx = int(len(unique_times) * 0.8)\nval_start = unique_times[cut_idx]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\nX_train = train[FEATURES]\nX_valid = valid[FEATURES]\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(\"Holdout begins:\", pd.Timestamp(val_start))\nprint(\"Training date range:\", train[\"timestamp\"].min(), \"to\", train[\"timestamp\"].max())\nprint(\"Holdout date range:\", valid[\"timestamp\"].min(), \"to\", valid[\"timestamp\"].max())\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\n# Train residual targets, not raw targets\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    X_train,\n    train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    X_train,\n    train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy() + speed_model_next.predict(X_valid),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy() + flow_model_next.predict(X_valid),\n    0, None\n)\n\nspeed_rmse = mean_squared_error(\n    valid[\"target_speed\"], speed_pred\n) ** 0.5\nflow_rmse = mean_squared_error(\n    valid[\"target_flow\"], flow_pred\n) ** 0.5\n\nprint(f\"\\nHoldout speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Holdout flow RMSE:  {flow_rmse:.4f} vph\")\nprint(\"\\nModels trained successfully.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:24:27.669166Z","iopub.execute_input":"2026-10-19T18:24:27.669587Z","iopub.status.idle":"2026-10-19T18:24:44.828599Z","shell.execute_reply.started":"2026-10-19T18:24:27.669557Z","shell.execute_reply":"2026-10-19T18:24:44.827433Z"}},"outputs":[{"name":"stdout","text":"Training rows: 485560\nHoldout rows: 121759\nHoldout begins: 2031-01-25 19:10:00+00:00\nTraining date range: 2031-01-01 00:00:00+00:00 to 2031-01-25 19:05:00+00:00\nHoldout date range: 2031-01-25 19:10:00+00:00 to 2031-01-31 23:55:00+00:00\n\nHoldout speed RMSE: 3.6997 km/h\nHoldout flow RMSE:  407.9385 vph\n\nModels trained successfully.\n","output_type":"stream"}],"execution_count":173},{"cell_type":"code","source":"from sklearn.metrics import mean_squared_error\nimport numpy as np\n\n# Merge lane counts for this panel\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nholdout_eval = valid[\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\n\nholdout_eval[\"pred_speed\"] = speed_pred\nholdout_eval[\"pred_flow\"] = flow_pred\n\nholdout_eval = holdout_eval.merge(\n    lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert holdout_eval[\"lanes\"].notna().all()\nassert (holdout_eval[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean(\n    (holdout_eval[\"target_speed\"] - holdout_eval[\"pred_speed\"]) ** 2\n))\n\nflow_per_lane_rmse = np.sqrt(np.mean(\n    ((holdout_eval[\"target_flow\"] - holdout_eval[\"pred_flow\"])\n     / holdout_eval[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_per_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(f\"Speed RMSE:             {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane:     {flow_per_lane_rmse:.4f}\")\nprint(f\"Speed score:            {S_speed:.5f}\")\nprint(f\"Flow score:             {S_flow:.5f}\")\nprint(f\"Estimated panel score:  {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:26:46.700593Z","iopub.execute_input":"2026-10-19T18:26:46.701149Z","iopub.status.idle":"2026-10-19T18:26:46.776481Z","shell.execute_reply.started":"2026-10-19T18:26:46.701115Z","shell.execute_reply":"2026-10-19T18:26:46.775088Z"}},"outputs":[{"name":"stdout","text":"Speed RMSE:             3.6997 km/h\nFlow RMSE per lane:     84.5416\nSpeed score:            0.85201\nFlow score:             0.85910\nEstimated panel score:  0.85527\n","output_type":"stream"}],"execution_count":174},{"cell_type":"code","source":"print(\"Panel:\", panel)\n\nprint(\"\\nValidation template:\")\nprint(\"Rows:\", len(val_template))\nprint(val_template.head(3).to_string(index=False))\n\nprint(\"\\nPrivate template:\")\nprint(\"Rows:\", len(priv_template))\nprint(priv_template.head(3).to_string(index=False))\n\nprint(\"\\nTraining feature columns:\")\nprint(jan_features_fixed.columns.tolist())\n\nprint(\"\\nModel feature columns:\")\nprint(FEATURES)\n\nprint(\"\\nTimestamp ranges:\")\nprint(\"Validation:\", val_template[\"timestamp\"].min(), \"to\",\n      val_template[\"timestamp\"].max())\nprint(\"Private:\", priv_template[\"timestamp\"].min(), \"to\",\n      priv_template[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:27:46.934609Z","iopub.execute_input":"2026