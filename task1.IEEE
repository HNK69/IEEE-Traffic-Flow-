        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    april = april.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    del src\n    gc.collect()\n\n# 4. Use observed April values for lags when available.\napril_observed = april.loc[\n    april[\"is_observed\"].eq(1),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\"speed_kmh\": \"obs_speed\", \"flow_vph\": \"obs_flow\"})\n\nfor lag in LAGS:\n    src = april_observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"april_lag_speed_{lag}\",\n        \"obs_flow\": f\"april_lag_flow_{lag}\",\n    })\n    april = april.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    april[f\"lag_speed_{lag}\"] = april[f\"lag_speed_{lag}\"].fillna(\n        april[f\"april_lag_speed_{lag}\"]\n    )\n    april[f\"lag_flow_{lag}\"] = april[f\"lag_flow_{lag}\"].fillna(\n        april[f\"april_lag_flow_{lag}\"]\n    )\n    april.drop(\n        columns=[f\"april_lag_speed_{lag}\", f\"april_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar features and the training category mappings.\napril[\"weekday\"] = april[\"timestamp\"].dt.weekday\napril[\"minute_of_day\"] = april[\"timestamp\"].dt.hour * 60 + april[\"timestamp\"].dt.minute\napril[\"tod_sin\"] = np.sin(2 * np.pi * april[\"minute_of_day\"] / 1440)\napril[\"tod_cos\"] = np.cos(2 * np.pi * april[\"minute_of_day\"] / 1440)\napril[\"weekday_sin\"] = np.sin(2 * np.pi * april[\"weekday\"] / 7)\napril[\"weekday_cos\"] = np.cos(2 * np.pi * april[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    april[col + \"_code\"] = (\n        april[col].map(category_maps_d12s[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict the full April panel.\nX_april = april[FEATURES_D12S].replace([np.inf, -np.inf], np.nan)\napril[\"pred_speed\"] = np.clip(\n    april[\"base_speed\"].to_numpy()\n    + speed_model_d12s_final.predict(X_april),\n    0, 160,\n)\napril[\"pred_flow\"] = np.clip(\n    april[\"base_flow\"].to_numpy()\n    + flow_model_d12s_final.predict(X_april),\n    0, None,\n)\n\n# 7. Align exactly to the official private template.\nprivate_template = pd.read_csv(\n    ROOT / \"task1\" / PANEL / \"private\" / \"sample_submission_state.csv\"\n)\nprivate_template[\"timestamp\"] = pd.to_datetime(\n    private_template[\"timestamp\"], utc=True\n)\n\npred_source = april[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"pred_speed\", \"pred_flow\"]\n].copy()\n\njoin_keys = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\nassert not pred_source.duplicated(join_keys).any()\n\nprivate_template[\"_row_order\"] = np.arange(len(private_template))\nprivate_result = private_template.merge(\n    pred_source,\n    on=join_keys,\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n).sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(private_result) == 107_416\nassert private_result[\"pred_speed\"].notna().all(), (\n    f\"Missing speed predictions: {private_result['pred_speed'].isna().sum()}\"\n)\nassert private_result[\"pred_flow\"].notna().all(), (\n    f\"Missing flow predictions: {private_result['pred_flow'].isna().sum()}\"\n)\n\nprivate_result[\"speed_kmh\"] = private_result[\"pred_speed\"]\nprivate_result[\"flow_vph\"] = private_result[\"pred_flow\"]\n\nout_path = WORK / \"D12_I405_S_april_predictions_verified.csv\"\nprivate_result[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n     \"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].to_csv(out_path, index=False)\n\nprint(\"Private predictions:\", len(private_result))\nprint(\"Missing speed:\", private_result[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", private_result[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Official private template order preserved.\")","metadata":{"trusted":true,"exec