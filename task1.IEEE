.read_csv(path)\n\n    template[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n    pred[\"timestamp\"] = pd.to_datetime(pred[\"timestamp\"], utc=True)\n\n    assert len(pred) == len(template), f\"{split}: row count mismatch\"\n    assert pred[KEYS_OUT].equals(template[KEYS_OUT]), \\\n        f\"{split}: keys/order mismatch\"\n    assert not pred.duplicated(KEYS_OUT).any(), f\"{split}: duplicate keys\"\n    assert pred[[\"speed_kmh\", \"flow_vph\"]].notna().all().all(), \\\n        f\"{split}: missing predictions\"\n    assert pred[\"speed_kmh\"].between(0, 160).all()\n    assert (pred[\"flow_vph\"] >= 0).all()\n\n    print(f\"PASS — {split}: {len(pred):,} rows; keys, order, and values valid\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:31:21.75547Z","iopub.execute_input":"2026-10-19T19:31:21.755991Z","iopub.status.idle":"2026-10-19T19:31:23.159122Z","shell.execute_reply.started":"2026-10-19T19:31:21.755954Z","shell.execute_reply":"2026-10-19T19:31:23.157936Z"}},"outputs":[{"name":"stdout","text":"PASS — validation: 203,337 rows; keys, order, and values valid\nPASS — private: 192,164 rows; keys, order, and values valid\n","output_type":"stream"}],"execution_count":198},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nprint(\"WORK:\", WORK)\n\nfor path in sorted(Path(WORK).glob(\"*predictions*.csv\")):\n    print(f\"{path.name:48s} {path.stat().st_size / 1024**2:.2f} MiB\")\n\nprint(\"\\nPanels remaining:\")\nremaining = [\n    \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\",\n    \"D7_I210_W\", \"D7_I405_N\", \"D7_I405_S\"\n]\nprint(remaining)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:32:56.34835Z","iopub.execute_input":"2026-10-19T19:32:56.348854Z","iopub.status.idle":"2026-10-19T19:32:56.359008Z","shell.execute_reply.started":"2026-10-19T19:32:56.348821Z","shell.execute_reply":"2026-10-19T19:32:56.357806Z"}},"outputs":[{"name":"stdout","text":"WORK: /kaggle/working\nD12_I405_N_april_predictions.csv                 19.61 MiB\nD12_I405_N_march_predictions.csv                 20.75 MiB\nD12_I405_N_march_predictions_corrected.csv       20.75 MiB\nmarch_validation_predictions.csv                 27.21 MiB\ntask1_predictions_checkpoint.csv                 69.01 MiB\n\nPanels remaining:\n['D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I405_N', 'D7_I405_S']\n","output_type":"stream"}],"execution_count":199},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\npanels_remaining = [\n    \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\",\n    \"D7_I210_W\", \"D7_I405_N\", \"D7_I405_S\"\n]\n\nfor p in panels_remaining:\n    root = ROOT / \"corridors\" / p / \"train\"\n\n    truth_files = list(\n        (root / \"mainline_states\").rglob(\"*.parquet\")\n    )\n    masked_files = list(\n        (root / \"mainline_states_masked\").rglob(\"*.parquet\")\n    )\n\n    truth_feb = 0\n    eligible_feb = 0\n    masked_feb_all = 0\n    masked_feb_observed = 0\n\n    # February ground truth\n    for f in truth_files:\n        if \"year_month=2031-02\" not in str(f):\n            continue\n\n        d = pd.read_parquet(\n            f, columns=[\"is_score_eligible\"]\n        )\n        truth_feb += len(d)\n        eligible_feb += int(d[\"is_score_eligible\"].eq(1).sum())\n        del d\n\n    # February mask assignments, including unobserved rows\n    for f in masked_files:\n        d = pd.read_parquet(\n            f,\n            columns=[\"timestamp\", \"is_observed\", \"mask_regime\"]\n        )\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (\n            (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n            & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        )\n        d = d.loc[keep]\n        masked_feb_all += len(d)\n        masked_feb_observed += int(d[\"is_observed\"].eq(1).sum())\n        del d\n\n    print(\n        f\"{p}: truth={truth_feb:,}, eligible={eligible_feb:,}, \"\n        f\"masked_all={masked_feb_all:,}, \"\n        f\"masked_observed={masked_feb_observed:,}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:33:39.145293Z","iopub.execute_input":"2026-10-19T19:33:39.14574Z","iopub.status.idle":"2026-10-19T19:35:25.59323Z","shell.execute_reply.started":"2026-10-19T19:33:39.145708Z","shell.execute_reply":"2026-10-19T19:35:25.591733Z"}},"outputs":[{"name":"stdout","text":"D12_I405_S: truth=354,816, eligible=271,374, masked_all=354,816, masked_observed=296,831\nD12_I5_N: truth=2,080,512, eligible=1,588,503, masked_all=2,080,512, masked_observed=1,735,959\nD12_I5_S: truth=806,400, eligible=616,266, masked_all=806,400, masked_observed=673,082\nD7_I10_E: truth=1,177,344, eligible=899,458, masked_all=1,177,344, masked_observed=982,763\nD7_I10_W: truth=862,848, eligible=659,049, masked_all=862,848, masked_observed=719,993\nD7_I210_E: truth=2,395,008, eligible=1,829,808, masked_all=2,395,008, masked_observed=1,999,305\nD7_I210_W: truth=653,184, eligible=498,755, masked_all=653,184, masked_observed=544,986\nD7_I405_N: truth=2,838,528, eligible=2,169,356, masked_all=2,838,528, masked_observed=2,370,377\nD7_I405_S: truth=878,976, eligible=671,980, masked_all=878,976, masked_observed=733,947\n","output_type":"stream"}],"execution_count":200},{"cell_type":"code","source":"\nimport gc\nimport pandas as pd\nfrom pathlib import Path\n\ndef load_february_training_data(panel_name):\n    \"\"\"\n    Load all eligible February labels and attach mask regimes from\n    the complete masked dataset, including unobserved rows.\n    Lag values are not constructed here.\n    \"\"\"\n    root = ROOT / \"corridors\" / panel_name / \"train\"\n    truth_root = root / \"mainline_states\"\n    masked_root = root / \"mainline_states_masked\"\n\n    start = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\n    end = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\n    # 1. Load all eligible February ground-truth labels\n    truth_parts = []\n\n    for path in truth_root.rglob(\"*.parquet\"):\n        if \"year_month=2031-02\" not in str(path):\n            continue\n\n        d = pd.read_parquet(\n            path,\n            columns=[\n                \"timestamp\", \"station_id\", \"link_id\",\n                \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n            ]\n        )\n\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (\n            (ts >= start) & (ts < end)\n            & d[\"is_score_eligible\"].eq(1)\n        )\n\n        if keep.any():\n            part = d.loc[\n                keep,\n                [\"timestamp\", \"station_id\", \"link_id\",\n                 \"speed_kmh\", \"flow_vph\"]\n            ].copy()\n            part[\"timestamp\"] = ts.loc[keep]\n            truth_parts.append(part)\n\n        del d\n        gc.collect()\n\n    if not truth_parts:\n        raise ValueError(f\"No eligible February labels found for {panel_name}\")\n\n    truth_df = pd.concat(truth_parts, ignore_index=True)\n    del truth_parts\n    gc.collect()\n\n    truth_df = truth_df.rename(columns={\n        \"speed_kmh\": \"target_speed\",\n        \"flow_vph\": \"target_flow\"\n    })\n\n    keys = [\"timestamp\", \"station_id\", \"link_id\"]\n\n    if truth_df.duplicated(keys).any():\n        raise ValueError(f\"{panel_name}: duplicate truth keys\")\n\n    # 2. Read ALL February mask assignments, not just observed rows\n    regime_parts = []\n\n    for path in masked_root.rglob(\"*.parquet\"):\n        d = pd.read_parquet(\n            path,\n            columns=[\n                \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n            ]\n        )\n\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (ts >= start) & (ts < end)\n\n        if keep.any():\n            part = d.loc[keep, keys + [\"mask_regime\"]].copy()\n            part[\"timestamp\"] = ts.loc[keep]\n            regime_parts.append(part)\n\n        del d\n        gc.collect()\n\n    if not regime_parts:\n        raise ValueError(f\"{panel_name}: no February mask assignments found\")\n\n    regimes_df = pd.concat(regime_parts, ignore_index=True)\n    del regime_parts\n    gc.collect()\n\n    if regimes_df.duplicated(keys).any():\n        raise ValueError(f\"{panel_name}: duplicate mask assignment keys\")\n\n    # 3. Attach regime to every eligible label\n    training_df = truth_df.merge(\n        regimes_df,\n        on=keys,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True\n    )\n\n    missing_regime = int(training_df[\"_merge\"].ne(\"both\").sum())\n    training_df = training_df.drop(columns=\"_merge\")\n\n    if missing_regime:\n        raise ValueError(\n            f\"{panel_name}: {missing_regime:,} eligible labels \"\n            \"have no mask-regime assignment\"\n        )\n\n    if training_df[\"mask_regime\"].isna().any():\n        raise ValueError(f\"{panel_name}: missing mask regimes\")\n\n    if training_df[[\"target_speed\", \"target_flow\"]].isna().any().any():\n        raise ValueError(f\"{panel_name}: missing eligible target values\")\n\n    print(f\"\\n{panel_name} — February training data\")\n    print(\"Eligible labels:\", f\"{len(training_df):,}\")\n    print(\"Regime counts:\")\n    print(training_df[\"mask_regime\"].value_counts().sort_index().to_string())\n    print(\"Duplicate keys:\", training_df.duplicated(keys).sum())\n    print(\"Missing regimes:\", training_df[\"mask_regime\"].isna().sum())\n\n    return training_df, regimes_df\n\n\n# Test the function on the next panel only.\npanel_test = \"D12_I405_S\"\ntraining_d12s, regimes_d12s = load_february_training_data(panel_test)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:40:17.988627Z","iopub.execute_input":"2026-10-19T19:40:17.989211Z","iopub.status.idle":"2026-10-19T19:42:56.596155Z","shell.execute_reply.started":"2026-10-19T19:40:17.989176Z","shell.execute_reply":"2026-10-19T19:42:56.594985Z"}},"outputs":[{"name":"stdout","text":"\nD12_I405_S — February training data\nEligible labels: 271,374\nRegime counts:\nmask_regime\nR1     38817\nR2    116237\nR3    116320\nDuplicate keys: 0\nMissing regimes: 0\n","output_type":"stream"}],"execution_count":201},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# Uses the existing ROOT, WORK, training_d12s, regimes_d12s\n# and KEYS variables from your previous cells.\n\nPANEL = \"D12_I405_S\"\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\ndef load_observed_february_and_january(panel_name):\n    masked_root = ROOT / \"corridors\" / panel_name / \"train\" / \"mainline_states_masked\"\n    frames = []\n\n    for f in masked_root.rglob(\"*.parquet\"):\n        # Read one file at a time; filter by actual timestamps.\n        df = pd.read_parquet(f)\n        if \"timestamp\" not in df.columns:\n            continue\n\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df = df[\n            (df[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n            (df[\"timestamp\"] <  pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        ]\n\n        if df.empty:\n            del df\n            continue\n\n        # Lag sources must be observed; regime mapping is handled separately.\n        df = df.loc[\n            df[\"is_observed\"].eq(1),\n            KEYS + [\"speed_kmh\", \"flow_vph\"]\n        ].copy()\n\n        if not df.empty:\n            frames.append(df)\n\n        del df\n        gc.collect()\n\n    if not frames:\n        raise ValueError(f\"No observed January/February data found for {panel_name}\")\n\n    observed = pd.concat(frames, ignore_index=True)\n    del frames\n    gc.collect()\n\n    if observed.duplicated(KEYS).any():\n        raise ValueError(\"Duplicate observed keys found in January/February data\")\n\n    observed = observed.rename(columns={\n        \"speed_kmh\": \"obs_speed\",\n        \"flow_vph\": \"obs_flow\"\n    })\n\n    return observed\n\n\ndef add_observed_lags(target_df, observed_df):\n    out = target_df.copy()\n    observed_df = observed_df.sort_values(KEYS)\n\n    for lag in LAGS:\n        source = observed_df[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n        source[\"timestamp\"] = source[\"timestamp\"] + pd.Timedelta(minutes=lag)\n        source = source.rename(columns={\n            \"obs_speed\": f\"lag_speed_{lag}\",\n            \"obs_flow\": f\"lag_flow_{lag}\"\n        })\n\n        out = out.merge(source, on=KEYS, how=\"left\", validate=\"one_to_one\")\n        del source\n        gc.collect()\n\n    return out\n\n\n# 1. Load observed history (January + February).\nobserved_d12s = load_observed_february_and_january(PANEL)\n\n# 2. Build target features. training_d12s already contains every eligible\n#    February label and its mask_regime.\ntraining_d12s[\"timestamp\"] = pd.to_datetime(\n    training_d12s[\"timestamp\"], utc=True\n)\n\nfeb_features_d12s = add_observed_lags(training_d12s, observed_d12s)\n\n# 3. Basic integrity checks.\nassert len(feb_features_d12s) == 271_374\nassert feb_features_d12s[\"mask_regime\"].notna().all()\nassert feb_features_d12s.duplicated(KEYS).sum() == 0\n\nlag_cols = [c for c in feb_features_d12s.columns if c.startswith(\"lag_\")]\nprint(\"Panel:\", PANEL)\nprint(\"Training rows:\", len(feb_features_d12s))\nprint(\"Regime counts:\\n\", feb_features_d12s[\"mask_regime\"].value_counts().sort_index())\nprint(\"Lag columns:\", lag_cols)\nprint(\"Missing lag values:\\n\", feb_features_d12s[lag_cols].isna().sum())\nprint(\"Feature-building integrity checks passed.\")\n\ndel observed_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:43:51.560203Z","iopub.execute_input":"2026-10-19T19:43:51.560649Z","iopub.status.idle":"2026-10-19T19:44:32.345071Z","shell.execute_reply.started":"2026-10-19T19:43:51.560618Z","shell.execute_reply":"2026-10-19T19:44:32.343391Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I405_S\nTraining rows: 271374\nRegime counts:\n mask_regime\nR1     38817\nR2    116237\nR3    116320\nName: count, dtype: int64\nLag columns: ['lag_speed_5', 'lag_flow_5', 'lag_speed_15', 'lag_flow_15', 'lag_speed_60', 'lag_flow_60', 'lag_speed_1440', 'lag_flow_1440']\nMissing lag values:\n lag_speed_5       116220\nlag_flow_5        116220\nlag_speed_15      118371\nlag_flow_15       118371\nlag_speed_60      121811\nlag_flow_60       121811\nlag_speed_1440    121333\nlag_flow_1440     121333\ndtype: int64\nFeature-building integrity checks passed.\n","output_type":"stream"},{"execution_count":202,"output_type":"execute_result","data":{"text/plain":"0"},"metadata":{}}],"execution_count":202},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\ntruth_root = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\n\n# Load January ground-truth history only.\njan_parts = []\n\nfor f in truth_root.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n\n    df = pd.read_parquet(f)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df = df[\n        (df[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (df[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n\n    if not df.empty:\n        jan_parts.append(\n            df[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del df\n    gc.collect()\n\nif not jan_parts:\n    raise ValueError(\"No January 2031 ground-truth files found.\")\n\njan_truth_d12s = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\njan_truth_d12s[\"weekday\"] = jan_truth_d12s[\"timestamp\"].dt.weekday\njan_truth_d12s[\"minute_of_day\"] = (\n    jan_truth_d12s[\"timestamp\"].dt.hour * 60\n    + jan_truth_d12s[\"timestamp\"].dt.minute\n)\n\n# Robust historical profile at link × weekday × time-of-day.\nprofile_d12s = (\n    jan_truth_d12s.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n    )\n    .agg(\n        base_speed=(\"speed_kmh\", \"median\"),\n        base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\n# Fallback profiles if a link × weekday × minute combination is absent.\nlink_profile_d12s = (\n    jan_truth_d12s.groupby(\"link_id\", as_index=False)\n    .agg(\n        link_base_speed=(\"speed_kmh\", \"median\"),\n        link_base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\n# Add calendar features to February.\nfeb_features_d12s[\"timestamp\"] = pd.to_datetime(\n    feb_features_d12s[\"timestamp\"], utc=True\n)\nfeb_features_d12s[\"weekday\"] = feb_features_d12s[\"timestamp\"].dt.weekday\nfeb_features_d12s[\"minute_of_day\"] = (\n    feb_features_d12s[\"timestamp\"].dt.hour * 60\n    + feb_features_d12s[\"timestamp\"].dt.minute\n)\n\n# Remove any partially created baseline columns before rebuilding.\nfeb_features_d12s = feb_features_d12s.drop(\n    columns=[\n        \"base_speed\", \"base_flow\",\n        \"link_base_speed\", \"link_base_flow\",\n    ],\n    errors=\"ignore\",\n)\n\nfeb_features_d12s = feb_features_d12s.merge(\n    profile_d12s,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_d12s = feb_features_d12s.merge(\n    link_profile_d12s,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_d12s[\"base_speed\"] = feb_features_d12s[\"base_speed\"].fillna(\n    feb_features_d12s[\"link_base_speed\"]\n)\nfeb_features_d12s[\"base_flow\"] = feb_features_d12s[\"base_flow\"].fillna(\n    feb_features_d12s[\"link_base_flow\"]\n)\n\n# Verify baseline coverage.\nassert len(feb_features_d12s) == 271_374\nassert feb_features_d12s[\"base_speed\"].notna().all()\nassert feb_features_d12s[\"base_flow\"].notna().all()\nassert feb_features_d12s.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n).sum() == 0\n\nprint(\"Baseline profiles attached successfully.\")\nprint(\"February rows:\", f\"{len(feb_features_d12s):,}\")\nprint(\"Missing base_speed:\", feb_features_d12s[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_d12s[\"base_flow\"].isna().sum())\nprint(\"Baseline profile rows:\", f\"{len(profile_d12s):,}\")\n\ndel jan_truth_d12s, profile_d12s, link_profile_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:52:08.272723Z","iopub.execute_input":"2026-10-19T19:52:08.273227Z","iopub.status.idle":"2026-10-19T19:52:26.409678Z","shell.execute_reply.started":"2026-10-19T19:52:08.273198Z","shell.execute_reply":"2026-10-19T19:52:26.408565Z"}},"outputs":[{"name":"stdout","text":"Baseline profiles attached successfully.\nFebruary rows: 271,374\nMissing base_speed: 0\nMissing base_flow: 0\nBaseline profile rows: 88,704\n","output_type":"stream"},{"execution_count":204,"output_type":"execute_result","data":{"text/plain":"52"},"metadata":{}}],"execution_count":204},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL = \"D12_I405_S\"\ndf = feb_features_d12s.sort_values(\"timestamp\").copy()\ndf[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n# Calendar features\ndf[\"weekday\"] = df[\"timestamp\"].dt.weekday\ndf[\"minute_of_day\"] = df[\"timestamp\"].dt.hour * 60 + df[\"timestamp\"].dt.minute\ndf[\"tod_sin\"] = np.sin(2 * np.pi * df[\"minute_of_day\"] / 1440)\ndf[\"tod_cos\"] = np.cos(2 * np.pi * df[\"minute_of_day\"] / 1440)\ndf[\"weekday_sin\"] = np.sin(2 * np.pi * df[\"weekday\"] / 7)\ndf[\"weekday_cos\"] = np.cos(2 * np.pi * df[\"weekday\"] / 7)\n\n# Encode IDs consistently within this panel's training data\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    df[col + \"_code\"] = pd.Categorical(df[col]).codes\n\nFEATURES_D12S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\n# Chronological holdout: last 20% of unique timestamps\nunique_times = np.sort(df[\"timestamp\"].unique())\nval_start = unique_times[int(len(unique_times) * 0.8)]\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_d12s = make_model()\nflow_model_d12s = make_model()\n\nspeed_model_d12s.fit(\n    train[FEATURES_D12S],\n    train[\"target_speed\"] - train[\"base_speed\"],\n)\nflow_model_d12s.fit(\n    train[FEATURES_D12S],\n    train[\"target_flow\"] - train[\"base_flow\"],\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy()\n    + speed_model_d12s.predict(valid[FEATURES_D12S]),\n    0, 160,\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy()\n    + flow_model_d12s.predict(valid[FEATURES_D12S]),\n    0, None,\n)\n\n# Correct metadata for D12_I405_S\nlinks_d12s = pd.read_csv(\n    ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\n)\nlane_map_d12s = links_d12s[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev = valid[[\"link_id\", \"target_speed\", \"target_flow\"]].copy()\nev[\"pred_speed\"] = speed_pred\nev[\"pred_flow\"] = flow_pred\nev = ev.merge(\n    lane_map_d12s, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert ev[\"lanes\"].notna().all() and (ev[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean((ev[\"target_speed\"] - ev[\"pred_speed\"]) ** 2))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((ev[\"target_flow\"] - ev[\"pred_flow\"]) / ev[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Panel:\", PANEL)\nprint(\"Training rows:\", f\"{len(train):,}\")\nprint(\"Holdout rows:\", f\"{len(valid):,}\")\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"S_speed: {S_speed:.6f}\")\nprint(f\"S_flow: {S_flow:.6f}\")\nprint(f\"Estimated state score: {S_state:.6f}\")\n\ndel df, train, valid, ev, links_d12s, lane_map_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:55:19.910251Z","iopub.execute_input":"2026-10-19T19:55:19.910646Z","iopub.status.idle":"2026-10-19T19:55:28.971624Z","shell.execute_reply.started":"2026-10-19T19:55:19.910618Z","shell.execute_reply":"2026-10-19T19:55:28.970666Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I405_S\nTraining rows: 216,975\nHoldout rows: 54,399\nSpeed RMSE: 3.7532 km/h\nFlow RMSE per lane: 90.8497\nS_speed: 0.849871\nS_flow: 0.848584\nEstimated state score: 0.849279\n","output_type":"stream"},{"execution_count":207,"output_type":"execute_result","data":{"text/plain":"60"},"metadata":{}}],"execution_count":207},{"cell_type":"code","source":"import gc\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL = \"D12_I405_S\"\n\n# Recreate the feature columns consistently.\nfinal_train_d12s = feb_features_d12s.copy()\nfinal_train_d12s[\"timestamp\"] = pd.to_datetime(\n    final_train_d12s[\"timestamp\"], utc=True\n)\n\nfinal_train_d12s[\"weekday\"] = final_train_d12s[\"timestamp\"].dt.weekday\nfinal_train_d12s[\"minute_of_day\"] = (\n    final_train_d12s[\"timestamp\"].dt.hour * 60\n    + final_train_d12s[\"timestamp\"].dt.minute\n)\nfinal_train_d12s[\"tod_sin\"] = np.sin(\n    2 * np.pi * final_train_d12s[\"minute_of_day\"] / 1440\n)\nfinal_train_d12s[\"tod_cos\"] = np.cos(\n    2 * np.pi * final_train_d12s[\"minute_of_day\"] / 1440\n)\nfinal_train_d12s[\"weekday_sin\"] = np.sin(\n    2 * np.pi * final_train_d12s[\"weekday\"] / 7\n)\nfinal_train_d12s[\"weekday_cos\"] = np.cos(\n    2 * np.pi * final_train_d12s[\"weekday\"] / 7\n)\n\n# Reuse the same feature schema as the evaluated model.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    final_train_d12s[col + \"_code\"] = pd.Categorical(\n        final_train_d12s[col]\n    ).codes\n\nFEATURES_D12S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nassert len(final_train_d12s) == 271_374\nassert final_train_d12s[FEATURES_D12S].notna().all(axis=None) or (\n    final_train_d12s[FEATURES_D12S].isna().sum().sum() > 0\n)\n\ndef make_final_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_d12s_final = make_final_model()\nflow_model_d12s_final = make_final_model()\n\nspeed_model_d12s_final.fit(\n    final_train_d12s[FEATURES_D12S],\n    final_train_d12s[\"target_speed\"] - final_train_d12s[\"base_speed\"],\n)\nflow_model_d12s_final.fit(\n    final_train_d12s[FEATURES_D12S],\n    final_train_d12s[\"target_flow\"] - final_train_d12s[\"base_flow\"],\n)\n\nprint(\"Final models fitted on all eligible February rows.\")\nprint(\"Training rows:\", f\"{len(final_train_d12s):,}\")\nprint(\"Feature count:\", len(FEATURES_D12S))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:58:54.847708Z","iopub.execute_input":"2026-10-19T19:58:54.849229Z","iopub.status.idle":"2026-10-19T19:59:04.722677Z","shell.execute_reply.started":"2026-10-19T19:58:54.849184Z","shell.execute_reply":"2026-10-19T19:59:04.721356Z"}},"outputs":[{"name":"stdout","text":"Final models fitted on all eligible February rows.\nTraining rows: 271,374\nFeature count: 19\n","output_type":"stream"}],"execution_count":208},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nPANEL = \"D12_I405_S\"\npanel_root = ROOT / \"corridors\" / PANEL\n\n# Persist category mappings from the training data.\ncategory_maps_d12s = {\n    col: {\n        value: code\n        for code, value in enumerate(\n            pd.Categorical(final_train_d12s[col]).categories\n        )\n    }\n    for col in [\"station_id\", \"link_id\", \"mask_regime\"]\n}\n\nprint(\"Panel:\", PANEL)\nprint(\"Training category counts:\")\nfor col, mapping in category_maps_d12s.items():\n    print(f\"  {col}: {len(mapping):,} categories\")\n\nfor split in [\"validation\", \"private\"]:\n    masked_root = panel_root / split / \"mainline_states_masked\"\n    files = list(masked_root.rglob(\"*.parquet\"))\n    print(f\"{split}: {len(files)} parquet files; exists={masked_root.exists()}\")\n\nprint(\"Feature schema ready:\", len(FEATURES_D12S), \"features\")\nprint(\"Models ready:\", \n      hasattr(speed_model_d12s_final, \"predict\"),\n      hasattr(flow_model_d12s_final, \"predict\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:03:13.604286Z","iopub.execute_input":"2026-10-19T20:03:13.604825Z","iopub.status.idle":"2026-10-19T20:03:13.705498Z","shell.execute_reply.started":"2026-10-19T20:03:13.604761Z","shell.execute_reply":"2026-10-19T20:03:13.704419Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I405_S\nTraining category counts:\n  station_id: 44 categories\n  link_id: 44 categories\n  mask_regime: 3 categories\nvalidation: 31 parquet files; exists=True\nprivate: 30 parquet files; exists=True\nFeature schema ready: 19 features\nModels ready: True True\n","output_type":"stream"}],"execution_count":209},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\nval_root = ROOT / \"corridors\" / PANEL / \"validation\" / \"mainline_states_masked\"\n\nfiles = sorted(val_root.rglob(\"*.parquet\"))\nassert len(files) == 31, f\"Expected 31 validation files, found {len(files)}\"\n\nsample = pd.read_parquet(files[0])\nprint(\"Sample file:\", files[0].name)\nprint(\"Columns:\", sample.columns.tolist())\nprint(\"Rows in sample file:\", len(sample))\nprint(\"\\nMask regime counts:\")\nprint(sample[\"mask_regime\"].value_counts(dropna=False))\nprint(\"\\nObserved counts:\")\nprint(sample[\"is_observed\"].value_counts(dropna=False))\nprint(\"\\nTimestamp range:\")\nprint(pd.to_datetime(sample[\"timestamp\"], utc=True).min(),\n      \"to\",\n      pd.to_datetime(sample[\"timestamp\"], utc=True).max())\n\ndel sample","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:04:13.016519Z","iopub.execute_input":"2026-10-19T20:04:13.01701Z","iopub.status.idle":"2026-10-19T20:04:13.123846Z","shell.execute_reply.started":"2026-10-19T20:04:13.016969Z","shell.execute_reply":"2026-10-19T20:04:13.121427Z"}},"outputs":[{"name":"stdout","text":"Sample file: synthetic_mainline_2031_03_01.parquet\nColumns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\nRows in sample file: 12672\n\nMask regime counts:\nmask_regime\nR1    12672\nName: count, dtype: int64\n\nObserved counts:\nis_observed\n1    10458\n0     2214\nName: count, dtype: int64\n\nTimestamp range:\n2031-03-01 00:00:00+00:00 to 2031-03-01 23:55:00+00:00\n","output_type":"stream"}],"execution_count":210},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\nPANEL = \"D12_I405_S\"\npanel_root = ROOT / \"corridors\" / PANEL\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\n# 1. Load January ground-truth data to recreate historical baseline profiles.\ntruth_root = panel_root / \"train\" / \"mainline_states\"\njan_parts = []\n\nfor f in truth_root.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n    if not x.empty:\n        jan_parts.append(x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy())\n    del x\n    gc.collect()\n\nif not jan_parts:\n    raise ValueError(\"January 2031 truth data not found.\")\n\njan = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\njan[\"weekday\"] = jan[\"timestamp\"].dt.weekday\njan[\"minute_of_day\"] = jan[\"timestamp\"].dt.hour * 60 + jan[\"timestamp\"].dt.minute\n\nprofile = jan.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile = jan.groupby(\"link_id\", as_index=False).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\n# 2. Load observed Jan/Feb history for lag features.\nmasked_train_root = panel_root / \"train\" / \"mainline_states_masked\"\nobs_parts = []\n\nfor f in masked_train_root.rglob(\"*.parquet\"):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-03-01\", tz=\"UTC\")) &\n        x[\"is_observed\"].eq(1)\n    ]\n    if not x.empty:\n        obs_parts.append(x[KEYS + [\"speed_kmh\", \"flow_vph\"]].copy())\n    del x\n    gc.collect()\n\nobserved = pd.concat(obs_parts, ignore_index=True)\ndel obs_parts\ngc.collect()\n\nobserved = observed.rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\nif observed.duplicated(KEYS).any():\n    raise ValueError(\"Duplicate observed keys in training history.\")\n\n# 3. Read March validation rows; preserve all keys and template order.\nval_root = panel_root / \"validation\" / \"mainline_states_masked\"\nval_parts = []\n\nfor f in sorted(val_root.rglob(\"*.parquet\")):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    val_parts.append(x)\n    del x\n    gc.collect()\n\nmarch = pd.concat(val_parts, ignore_index=True)\ndel val_parts\ngc.collect()\n\nmarch[\"timestamp\"] = pd.to_datetime(march[\"timestamp\"], utc=True)\nmarch[\"weekday\"] = march[\"timestamp\"].dt.weekday\nmarch[\"minute_of_day\"] = march[\"timestamp\"].dt.hour * 60 + march[\"timestamp\"].dt.minute\n\n# Baseline profile lookup, only from January.\nmarch = march.merge(\n    profile,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch = march.merge(link_profile, on=\"link_id\", how=\"left\", validate=\"many_to_one\")\nmarch[\"base_speed\"] = march[\"base_speed\"].fillna(march[\"link_base_speed\"])\nmarch[\"base_flow\"] = march[\"base_flow\"].fillna(march[\"link_base_flow\"])\n\n# 4. Lag features from observed history, shifted forward by the lag interval.\nfor lag in LAGS:\n    src = observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] = src[\"timestamp\"] + pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    march = march.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    del src\n    gc.collect()\n\n# March observations can also supply earlier lags for later March rows.\nmarch_observed = march.loc[\n    march[\"is_observed\"].eq(1),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\"speed_kmh\": \"obs_speed\", \"flow_vph\": \"obs_flow\"})\n\nfor lag in LAGS:\n    src = march_observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] = src[\"timestamp\"] + pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"march_lag_speed_{lag}\",\n        \"obs_flow\": f\"march_lag_flow_{lag}\",\n    })\n    march = march.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    march[f\"lag_speed_{lag}\"] = march[f\"lag_speed_{lag}\"].fillna(\n        march[f\"march_lag_speed_{lag}\"]\n    )\n    march[f\"lag_flow_{lag}\"] = march[f\"lag_flow_{lag}\"].fillna(\n        march[f\"march_lag_flow_{lag}\"]\n    )\n    march.drop(columns=[f\"march_lag_speed_{lag}\", f\"march_lag_flow_{lag}\"], inplace=True)\n    del src\n    gc.collect()\n\n# 5. Apply training category mappings.\nmarch[\"weekday\"] = march[\"timestamp\"].dt.weekday\nmarch[\"minute_of_day\"] = march[\"timestamp\"].dt.hour * 60 + march[\"timestamp\"].dt.minute\nmarch[\"tod_sin\"] = np.sin(2 * np.pi * march[\"minute_of_day\"] / 1440)\nmarch[\"tod_cos\"] = np.cos(2 * np.pi * march[\"minute_of_day\"] / 1440)\nmarch[\"weekday_sin\"] = np.sin(2 * np.pi * march[\"weekday\"] / 7)\nmarch[\"weekday_cos\"] = np.cos(2 * np.pi * march[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    march[col + \"_code\"] = (\n        march[col].map(category_maps_d12s[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict.\nX_march = march[FEATURES_D12S].replace([np.inf, -np.inf], np.nan)\nmarch[\"pred_speed\"] = np.clip(\n    march[\"base_speed\"].to_numpy() + speed_model_d12s_final.predict(X_march),\n    0, 160,\n)\nmarch[\"pred_flow\"] = np.clip(\n    march[\"base_flow\"].to_numpy() + flow_model_d12s_final.predict(X_march),\n    0, None,\n)\n\n# 7. Verify against official validation template.\ntemplate_path = ROOT / \"task1\" / PANEL / \"validation\" / \"sample_submission_state.csv\"\nif not template_path.exists():\n    # Fall back to the unified task template, if panel-specific template isn't present.\n    template_path = ROOT / \"task1\" / \"sample_submission.csv\"\n\ntemplate = pd.read_csv(template_path)\nif \"panel\" in template.columns:\n    template = template[template[\"panel\"].eq(PANEL)].copy()\n\n# Match prediction keys to template columns.\nkey_candidates = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\nfor c in key_candidates:\n    if c not in template.columns:\n        raise ValueError(f\"Template missing expected key column: {c}\")\n\nmarch_keys = march[key_candidates].copy()\ntemplate_keys = template[key_candidates].copy()\nmarch_keys[\"timestamp\"] = pd.to_datetime(march_keys[\"timestamp\"], utc=True)\ntemplate_keys[\"timestamp\"] = pd.to_datetime(template_keys[\"timestamp\"], utc=True)\n\nassert not march_keys.duplicated(key_candidates).any()\nassert len(march_keys) == len(template_keys), (len(march_keys), len(template_keys))\nassert march_keys.reset_index(drop=True).equals(template_keys.reset_index(drop=True)), \\\n    \"Prediction keys/order do not match the official validation template.\"\n\nout_path = WORK / \"D12_I405_S_march_predictions_verified.csv\"\nmarch[KEYS + [\"mask_regime\", \"pred_speed\", \"pred_flow\"]].to_csv(out_path, index=False)\n\nprint(\"Validation predictions generated:\", len(march))\nprint(\"Missing speed predictions:\", march[\"pred_speed\"].isna().sum())\nprint(\"Missing flow predictions:\", march[\"pred_flow\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Template key/order verification passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:06:27.666121Z","iopub.execute_input":"2026-10-19T20:06:27.666584Z","iopub.status.idle":"2026-10-19T20:09:47.340517Z","shell.execute_reply.started":"2026-10-19T20:06:27.666554Z","shell.execute_reply":"2026-10-19T20:09:47.338739Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAssertionError\u001b[0m                            Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_48/2379235826.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    189\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    190\u001b[0m \u001b[0;32massert\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0mmarch_keys\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mduplicated\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey_candidates\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0many\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 191\u001b[0;31m \u001b[0;32massert\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mmarch_keys\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m==\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mtemplate_keys\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m(\u001b[0m\u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mmarch_keys\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mtemplate_keys\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    192\u001b[0m \u001b[0;32massert\u001b[0m \u001b[0mmarch_keys\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mreset_index\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mdrop\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;32mTrue\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mequals\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mtemplate_keys\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mreset_index\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mdrop\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;32mTrue\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;31m \u001b[0m\u001b[0;31m\\\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    193\u001b[0m     \u001b[0;34m\"Prediction keys/order do not match the official validation template.\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mAssertionError\u001b[0m: (392832, 93718)"],"ename":"AssertionError","evalue":"(392832, 93718)","output_type":"error"}],"execution_count":211},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\n\ntemplate_path = (\n    ROOT / \"task1\" / PANEL / \"validation\" / \"sample_submission_state.csv\"\n)\ntemplate = pd.read_csv(template_path)\n\nKEYS_OUT = [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n\n# Normalize join keys.\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\nmarch[\"timestamp\"] = pd.to_datetime(march[\"timestamp\"], utc=True)\n\n# Select only the keys required by the official template.\npred_source = march[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any(), \"Duplicate prediction keys found.\"\n\n# Left join from template: guarantees official row order and exact row coverage.\ntemplate[\"_row_order\"] = np.arange(len(template))\n\nresult = template.merge(\n    pred_source,\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n)\n\nresult = result.sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(result) == len(template)\nassert result[\"pred_speed\"].notna().all(), (\n    f\"Missing speed predictions: {result['pred_speed'].isna().sum()}\"\n)\nassert result[\"pred_flow\"].notna().all(), (\n    f\"Missing flow predictions: {result['pred_flow'].isna().sum()}\"\n)\n\n# Fill only the target columns; retain template identifiers and order.\nresult[\"speed_kmh\"] = result[\"pred_speed\"]\nresult[\"flow_vph\"] = result[\"pred_flow\"]\n\nout_path = WORK / \"D12_I405_S_march_predictions_verified.csv\"\nresult[[\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n        \"mask_regime\", \"speed_kmh\", \"flow_vph\"]].to_csv(out_path, index=False)\n\nprint(\"Rows:\", len(result))\nprint(\"Missing speed:\", result[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", result[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Official template order preserved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:12:26.897172Z","iopub.execute_input":"2026-10-19T20:12:26.897545Z","iopub.status.idle":"2026-10-19T20:12:28.778713Z","shell.execute_reply.started":"2026-10-19T20:12:26.897517Z","shell.execute_reply":"2026-10-19T20:12:28.777379Z"}},"outputs":[{"name":"stdout","text":"Rows: 93718\nMissing speed: 0\nMissing flow: 0\nSaved: /kaggle/working/D12_I405_S_march_predictions_verified.csv\nOfficial template order preserved.\n","output_type":"stream"}],"execution_count":213},{"cell_type":"code","source":"PANEL = \"D12_I405_S\"\n\nprivate_template_path = (\n    ROOT / \"task1\" / PANEL / \"private\" / \"sample_submission_state.csv\"\n)\n\nprint(\"Private template exists:\", private_template_path.exists())\n\nif private_template_path.exists():\n    private_template = pd.read_csv(private_template_path)\n    print(\"Expected private rows:\", len(private_template))\n    print(\"Columns:\", private_template.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:13:58.882624Z","iopub.execute_input":"2026-10-19T20:13:58.883126Z","i