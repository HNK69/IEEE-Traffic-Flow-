flow_vph\"}.issubset(sample.columns))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:42:23.324466Z","iopub.execute_input":"2026-10-19T15:42:23.326675Z","iopub.status.idle":"2026-10-19T15:42:23.550221Z","shell.execute_reply.started":"2026-10-19T15:42:23.326615Z","shell.execute_reply":"2026-10-19T15:42:23.548922Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nDATA = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nprivate_template_path = DATA / \"task1/D7_I405_S/private/sample_submission_state.csv\"\nprivate_masked_dir = DATA / \"corridors/D7_I405_S/private/mainline_states_masked\"\n\nprivate_template = pd.read_csv(private_template_path)\nprivate_template[\"timestamp\"] = pd.to_datetime(\n    private_template[\"timestamp\"], utc=True\n)\n\nprivate_files = sorted(private_masked_dir.rglob(\"*.parquet\"))\n\nprint(\"Private template:\", private_template.shape)\nprint(\"Private masked files:\", len(private_files))\nprint(\"Date range:\", private_template[\"timestamp\"].min(),\n      \"to\", private_template[\"timestamp\"].max())\nprint(\"Columns:\", private_template.columns.tolist())\nprint(private_template.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:42:58.88512Z","iopub.execute_input":"2026-10-19T15:42:58.88554Z","iopub.status.idle":"2026-10-19T15:42:59.227255Z","shell.execute_reply.started":"2026-10-19T15:42:58.885513Z","shell.execute_reply":"2026-10-19T15:42:59.226013Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nprivate_masked_dir = (\n    DATA / \"corridors/D7_I405_S/private/mainline_states_masked\"\n)\n\n# Load April masked data\nprivate_raw = pd.concat(\n    [pd.read_parquet(p) for p in sorted(private_masked_dir.rglob(\"*.parquet\"))],\n    ignore_index=True\n)\nprivate_raw[\"timestamp\"] = pd.to_datetime(private_raw[\"timestamp\"], utc=True)\n\nprint(\"Private masked shape:\", private_raw.shape)\nprint(\"Duplicate keys:\", private_raw.duplicated(KEYS).sum())\n\n# Create baseline from all eligible historical truth available through February\nprivate_targets = private_template[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].copy()\n\nprivate_baseline = build_baseline(\n    private_targets,\n    pd.Timestamp(\"2031-04-01\", tz=\"UTC\")\n)\n\nprint(\"Private baseline:\", private_baseline.shape)\nprint(\"Missing baseline values:\",\n      private_baseline[VALUE_COLS].isna().any(axis=1).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:45:00.919192Z","iopub.execute_input":"2026-10-19T15:45:00.919703Z","iopub.status.idle":"2026-10-19T15:45:08.727596Z","shell.execute_reply.started":"2026-10-19T15:45:00.919672Z","shell.execute_reply":"2026-10-19T15:45:08.726546Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 1. Create lookup from private masked observations\nprivate_lookup = private_raw[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"masked_speed\",\n    \"flow_vph\": \"masked_flow\",\n})\n\n# Keep the existing add_lags lookup intact\n_original_masked_lookup = masked_lookup\nmasked_lookup = pd.concat(\n    [_original_masked_lookup, private_lookup],\n    ignore_index=True\n).drop_duplicates(KEYS, keep=\"last\")\n\n# 2. Build April features\nprivate_features = attach_baseline(private_targets, private_baseline)\nprivate_features = add_lags(private_features)\nprivate_features = add_model_features(private_features)\n\n# 3. Match training category codes\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = sorted(features[col].astype(str).unique())\n    mapping = {value: i for i, value in enumerate(categories)}\n    private_features[f\"{col}_code\"] = (\n        private_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n\n# 4. Match model feature names\nprivate_features = private_features.rename(columns={\n    \"lag_speed_5\": \"lag_speed_5\", \"lag_flow_5\": \"lag_flow_5\",\n    \"lag_speed_15\": \"lag_speed_15\", \"lag_flow_15\": \"lag_flow_15\",\n    \"lag_speed_60\": \"lag_speed_60\", \"lag_flow_60\": \"lag_flow_60\",\n    \"lag_speed_1440\": \"lag_speed_1440\", \"lag_flow_1440\": \"lag_flow_1440\",\n    \"dow\": \"weekday\", \"dow_sin\": \"weekday_sin\", \"dow_cos\": \"weekday_cos\",\n})\n\nassert all(c in private_features.columns for c in FEATURES)\n\nX_private = private_features[FEATURES].astype(\"float32\")\n\n# 5. Predict residuals and add baselines\nprivate_submission = private_template.copy()\nprivate_submission[\"speed_kmh\"] = np.clip(\n    private_features[\"base_speed\"].to_numpy()\n    + speed_model_original_style.predict(X_private),\n    0, 160\n)\nprivate_submission[\"flow_vph\"] = np.clip(\n    private_features[\"base_flow\"].to_numpy()\n    + flow_model_original_style.predict(X_private),\n    0, None\n)\n\n# 6. Validate and save\nassert len(private_submission) == len(private_template)\nassert private_submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert private_submission[[\"timestamp\", \"station_id\", \"link_id\"]].equals(\n    private_template[[\"timestamp\", \"station_id\", \"link_id\"]]\n)\n\noutput_path = \"/kaggle/working/private_submission.csv\"\nprivate_submission.to_csv(output_path, index=False)\n\nprint(\"Saved:\", output_path)\nprint(\"Shape:\", private_submission.shape)\ndisplay(private_submission.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:47:06.394105Z","iopub.execute_input":"2026-10-19T15:47:06.394623Z","iopub.status.idle":"2026-10-19T15:48:04.643735Z","shell.execute_reply.started":"2026-10-19T15:47:06.39459Z","shell.execute_reply":"2026-10-19T15:48:04.642685Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Final private submission validation\nassert len(private_submission) == 243603\nassert private_submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert private_submission[\"speed_kmh\"].between(0, 160).all()\nassert (private_submission[\"flow_vph\"] >= 0).all()\nassert private_submission[[\"timestamp\", \"station_id\", \"link_id\"]].equals(\n    private_template[[\"timestamp\", \"station_id\", \"link_id\"]]\n)\n\nprivate_submission.to_csv(\n    \"/kaggle/working/private_submission.csv\",\n    index=False\n)\n\nprint(\"PASS — all integrity checks passed.\")\nprint(\"File: /kaggle/working/private_submission.csv\")\nprint(\"\\nPrediction summary:\")\ndisplay(private_submission[[\"speed_kmh\", \"flow_vph\"]].describe())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:48:51.678716Z","iopub.execute_input":"2026-10-19T15:48:51.679918Z","iopub.status.idle":"2026-10-19T15:48:55.308358Z","shell.execute_reply.started":"2026-10-19T15:48:51.679835Z","shell.execute_reply":"2026-10-19T15:48:55.307044Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"Speed below 40 km/h:\",\n      (private_submission[\"speed_kmh\"] < 40).sum())\nprint(\"Speed above 130 km/h:\",\n      (private_submission[\"speed_kmh\"] > 130).sum())\n\ndisplay(\n    private_submission[\n        (private_submission[\"speed_kmh\"] < 40) |\n        (private_submission[\"speed_kmh\"] > 130)\n    ].head(15)\n)\n\nlag_cols = [\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n]\n\nprint(\"\\nLag missingness:\")\ndisplay(private_features[lag_cols].isna().mean().to_frame(\"missing_fraction\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:49:48.311347Z","iopub.execute_input":"2026-10-19T15:49:48.311743Z","iopub.status.idle":"2026-10-19T15:49:48.356037Z","shell.execute_reply.started":"2026-10-19T15:49:48.311714Z","shell.execute_reply":"2026-10-19T15:49:48.354767Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Inspect the low-speed predictions and their available lag context\nextreme = private_submission.loc[\n    private_submission[\"speed_kmh\"] < 40,\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n     \"speed_kmh\", \"flow_vph\"]\n].copy()\n\nextreme = extreme.merge(\n    private_features[\n        [\"timestamp\", \"station_id\", \"link_id\",\n         \"base_speed\", \"base_flow\",\n         \"lag_speed_5\", \"lag_speed_15\",\n         \"lag_speed_60\", \"lag_speed_1440\"]\n    ],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nprint(\"Low-speed rows:\", len(extreme))\nprint(\"\\nBaseline speed statistics:\")\ndisplay(extreme[[\"base_speed\", \"speed_kmh\", \"flow_vph\"]].describe())\n\nprint(\"\\nLag availability among low-speed rows:\")\ndisplay(extreme[\n    [\"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\", \"lag_speed_1440\"]\n].isna().mean().to_frame(\"missing_fraction\"))\n\nprint(\"\\nExamples:\")\ndisplay(extreme.head(10))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:50:45.647098Z","iopub.execute_input":"2026-10-19T15:50:45.647526Z","iopub.status.idle":"2026-10-19T15:50:45.863218Z","shell.execute_reply.started":"2026-10-19T15:50:45.647496Z","shell.execute_reply":"2026-10-19T15:50:45.861793Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Verify lag lookup alignment for a few low-speed rows\ncheck = extreme.head(10)[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\"]\n].copy()\n\nfor lag in LAGS_MINUTES:\n    check[f\"expected_t_minus_{lag}\"] = (\n        check[\"timestamp\"] - pd.Timedelta(minutes=lag)\n    )\n\nprint(\"Lag lookup uses timestamp + lag before merging.\")\nprint(\"For a target at time T, the intended lag must come from T - lag.\")\ndisplay(check)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:51:50.566782Z","iopub.execute_input":"2026-10-19T15:51:50.567738Z","iopub.status.idle":"2026-10-19T15:51:50.591086Z","shell.execute_reply.started":"2026-10-19T15:51:50.5677Z","shell.execute_reply":"2026-10-19T15:51:50.589827Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Verify actual lag values directly from private masked data\nsample = extreme.head(10)[[\"timestamp\", \"station_id\", \"link_id\"]].copy()\n\nfor lag in LAGS_MINUTES:\n    lookup = private_lookup.copy()\n    lookup[\"timestamp\"] += pd.Timedelta(minutes=lag)\n\n    lookup = lookup.rename(columns={\n        \"masked_speed\": f\"check_lag_{lag}\"\n    })\n\n    sample = sample.merge(\n        lookup[[\"timestamp\", \"station_id\", \"link_id\", f\"check_lag_{lag}\"]],\n        on=[\"timestamp\", \"station_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\nfor lag in LAGS_MINUTES:\n    existing = f\"lag_speed_{lag}\"\n    checked = f\"check_lag_{lag}\"\n    if existing in extreme.columns:\n        same = np.isclose(\n            extreme.head(10)[existing].to_numpy(),\n            sample[checked].to_numpy(),\n            equal_nan=True\n        )\n        print(f\"{lag}-minute lag matches:\", int(same.sum()), \"/ 10\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:52:18.01522Z","iopub.execute_input":"2026-10-19T15:52:18.01564Z","iopub.status.idle":"2026-10-19T15:52:20.603067Z","shell.execute_reply.started":"2026-10-19T15:52:18.015611Z","shell.execute_reply":"2026-10-19T15:52:20.602051Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Check how much the model changes the baseline for low-speed predictions\ndiagnostic = extreme.copy()\n\ndiagnostic[\"speed_correction\"] = (\n    diagnostic[\"speed_kmh\"] - diagnostic[\"base_speed\"]\n)\n\nprint(\"Speed correction statistics:\")\ndisplay(diagnostic[\"speed_correction\"].describe())\n\nprint(\"Large downward corrections (< -30 km/h):\",\n      (diagnostic[\"speed_correction\"] < -30).sum())\n\ndisplay(\n    diagnostic.nsmallest(10, \"speed_correction\")[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"speed_kmh\", \"speed_correction\", \"flow_vph\"]\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:52:54.423417Z","iopub.execute_input":"2026-10-19T15:52:54.423842Z","iopub.status.idle":"2026-10-19T15:52:54.458143Z","shell.execute_reply.started":"2026-10-19T15:52:54.423812Z","shell.execute_reply":"2026-10-19T15:52:54.457123Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare residual correction distributions: February vs April\n\nfeb_correction = (\n    pred_speed_original_style\n    - holdout_data[\"base_speed\"].to_numpy()\n)\n\napr_correction = (\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy()\n)\n\nprint(\"February correction distribution:\")\nprint(pd.Series(feb_correction).describe())\n\nprint(\"\\nApril correction distribution:\")\nprint(pd.Series(apr_correction).describe())\n\nprint(\"\\nFraction with correction below -30 km/h:\")\nprint(\"February:\", (feb_correction < -30).mean())\nprint(\"April:   \", (apr_correction < -30).mean())\n\nprint(\"\\nFraction with correction below -60 km/h:\")\nprint(\"February:\", (feb_correction < -60).mean())\nprint(\"April:   \", (apr_correction < -60).mean())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:53:19.163375Z","iopub.execute_input":"2026-10-19T15:53:19.163839Z","iopub.status.idle":"2026-10-19T15:53:19.211144Z","shell.execute_reply.started":"2026-10-19T15:53:19.16381Z","shell.execute_reply":"2026-10-19T15:53:19.210065Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare residual correction tails by masking regime\nfor name, frame, corrections in [\n    (\"February\", holdout_data, feb_correction),\n    (\"April\", private_features, apr_correction),\n]:\n    tmp = pd.DataFrame({\n        \"mask_regime\": frame[\"mask_regime\"].to_numpy(),\n        \"correction\": corrections,\n    })\n\n    print(f\"\\n{name}\")\n    display(\n        tmp.groupby(\"mask_regime\")[\"correction\"]\n        .agg(\n            count=\"size\",\n            mean=\"mean\",\n            median=\"median\",\n            std=\"std\",\n            below_minus30=lambda s: (s < -30).mean(),\n            below_minus60=lambda s: (s < -60).mean(),\n        )\n        .round(4)\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:54:00.473275Z","iopub.execute_input":"2026-10-19T15:54:00.47429Z","iopub.status.idle":"2026-10-19T15:54:00.682951Z","shell.execute_reply.started":"2026-10-19T15:54:00.474244Z","shell.execute_reply":"2026-10-19T15:54:00.681651Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Analyze extreme speed corrections by regime and lag availability\ndiag = private_features[\n    [\"mask_regime\", \"lag_speed_5\", \"lag_speed_15\",\n     \"lag_speed_60\", \"lag_speed_1440\"]\n].copy()\n\ndiag[\"correction\"] = apr_correction\ndiag[\"extreme\"] = diag[\"correction\"] < -30\ndiag[\"recent_lags_missing\"] = diag[\n    [\"lag_speed_5\", \"lag_speed_15\"]\n].isna().all(axis=1)\n\nprint(\"By regime:\")\ndisplay(\n    diag.groupby(\"mask_regime\").agg(\n        rows=(\"extreme\", \"size\"),\n        extreme_rate=(\"extreme\", \"mean\"),\n        extreme_with_both_recent_lags_missing=(\n            \"recent_lags_missing\",\n            \"mean\"\n        ),\n    ).round(4)\n)\n\nprint(\"\\nExtreme corrections vs others:\")\ndisplay(\n    diag.groupby(\"extreme\").agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        recent_lags_missing=(\"recent_lags_missing\", \"mean\"),\n        lag5_missing=(\"lag_speed_5\", lambda s: s.isna().mean()),\n        lag15_missing=(\"lag_speed_15\", lambda s: s.isna().mean()),\n        lag60_missing=(\"lag_speed_60\", lambda s: s.isna().mean()),\n        lag1440_missing=(\"lag_speed_1440\", lambda s: s.isna().mean()),\n    ).round(4)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:54:50.062141Z","iopub.execute_input":"2026-10-19T15:54:50.062975Z","iopub.status.idle":"2026-10-19T15:54:50.186566Z","shell.execute_reply.started":"2026-10-19T15:54:50.062934Z","shell.execute_reply":"2026-10-19T15:54:50.18559Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare recent lag speeds for extreme vs normal predictions\ndiag[\"lag5_low\"] = diag[\"lag_speed_5\"] < 40\ndiag[\"lag15_low\"] = diag[\"lag_speed_15\"] < 40\ndiag[\"both_recent_lags_low\"] = diag[\"lag5_low\"] & diag[\"lag15_low\"]\n\nprint(\"Recent speed-lag behavior:\")\ndisplay(\n    diag.groupby(\"extreme\").agg(\n        rows=(\"correction\", \"size\"),\n        lag5_available=(\"lag_speed_5\", lambda s: s.notna().mean()),\n        lag5_below_40=(\"lag5_low\", \"mean\"),\n        lag15_below_40=(\"lag15_low\", \"mean\"),\n        both_recent_below_40=(\"both_recent_lags_low\", \"mean\"),\n        median_lag5=(\"lag_speed_5\", \"median\"),\n        median_lag15=(\"lag_speed_15\", \"median\"),\n    ).round(4)\n)\n\nprint(\"\\nExtreme corrections where both recent lags are available and >= 40:\")\nsuspect = diag[\n    diag[\"extreme\"]\n    & diag[\"lag_speed_5\"].notna()\n    & diag[\"lag_speed_15\"].notna()\n    & (diag[\"lag_speed_5\"] >= 40)\n    & (diag[\"lag_speed_15\"] >= 40)\n]\nprint(\"Rows:\", len(suspect))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:55:26.246878Z","iopub.execute_input":"2026-10-19T15:55:26.2473Z","iopub.status.idle":"2026-10-19T15:55:26.332324Z","shell.execute_reply.started":"2026-10-19T15:55:26.247273Z","shell.execute_reply":"2026-10-19T15:55:26.331155Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Inspect extreme corrections despite normal recent lag speeds\nsuspect_idx = diag.index[\n    diag[\"extreme\"]\n    & diag[\"lag_speed_5\"].notna()\n    & diag[\"lag_speed_15\"].notna()\n    & (diag[\"lag_speed_5\"] >= 40)\n    & (diag[\"lag_speed_15\"] >= 40)\n]\n\nsuspect_rows = private_features.loc[\n    suspect_idx,\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n     \"base_speed\", \"base_flow\",\n     \"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\", \"lag_speed_1440\"]\n].copy()\n\nsuspect_rows[\"pred_speed\"] = private_submission.loc[\n    suspect_idx, \"speed_kmh\"\n].to_numpy()\n\nsuspect_rows[\"speed_correction\"] = (\n    suspect_rows[\"pred_speed\"] - suspect_rows[\"base_speed\"]\n)\n\nprint(\"Suspect rows:\", len(suspect_rows))\ndisplay(\n    suspect_rows.sort_values(\"speed_correction\").head(20)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:57:07.890127Z","iopub.execute_input":"2026-10-19T15:57:07.890653Z","iopub.status.idle":"2026-10-19T15:57:07.954338Z","shell.execute_reply.started":"2026-10-19T15:57:07.890622Z","shell.execute_reply":"2026-10-19T15:57:07.953166Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Diagnose extreme February corrections when recent lags look normal\nfeb_diag = holdout_data.copy()\n\nfeb_diag[\"pred_speed\"] = pred_speed_original_style\nfeb_diag[\"correction\"] = (\n    feb_diag[\"pred_speed\"] - feb_diag[\"base_speed\"].to_numpy()\n)\n\n# Use lag columns from the February feature matrix\nfor col in [\"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\", \"lag_speed_1440\"]:\n    if col in X_holdout_original_style.columns:\n        feb_diag[col] = X_holdout_original_style[col].to_numpy()\n\nfeb_diag[\"extreme\"] = feb_diag[\"correction\"] < -60\nfeb_diag[\"recent_normal\"] = (\n    feb_diag[\"lag_speed_5\"].ge(40)\n    & feb_diag[\"lag_speed_15\"].ge(40)\n    & feb_diag[\"lag_speed_60\"].ge(80)\n)\n\nprint(\"February extreme corrections:\", int(feb_diag[\"extreme\"].sum()))\nprint(\"Extreme corrections with normal recent context:\",\n      int((feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"]).sum()))\n\ndisplay(\n    feb_diag.loc[\n        feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"],\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"pred_speed\", \"correction\",\n         \"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]\n    ].head(15)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:57:41.217084Z","iopub.execute_input":"2026-10-19T15:57:41.218047Z","iopub.status.idle":"2026-10-19T15:57:41.332015Z","shell.execute_reply.started":"2026-10-19T15:57:41.218013Z","shell.execute_reply":"2026-10-19T15:57:41.330844Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Evaluate the two February cases against actual validation labels\nfeb_cases = feb_diag.loc[\n    feb_diag[\"extreme\"] & feb_diag[\"recent_normal\"]\n].copy()\n\n# Join actual February speed labels\nfeb_cases = feb_cases.merge(\n    holdout_truth[[\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\"]],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    suffixes=(\"\", \"_actual\"),\n    validate=\"one_to_one\"\n)\n\nfeb_cases[\"actual_speed\"] = feb_cases[\"speed_kmh_actual\"]\nfeb_cases[\"prediction_error\"] = (\n    feb_cases[\"pred_speed\"] - feb_cases[\"actual_speed\"]\n).abs()\n\ndisplay(\n    feb_cases[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"pred_speed\", \"actual_speed\", \"prediction_error\",\n         \"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:58:15.891537Z","iopub.execute_input":"2026-10-19T15:58:15.892Z","iopub.status.idle":"2026-10-19T15:58:16.078584Z","shell.execute_reply.started":"2026-10-19T15:58:15.891967Z","shell.execute_reply":"2026-10-19T15:58:16.077576Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Test speed-correction caps on February holdout\ny_actual = holdout_truth[\"speed_kmh\"].to_numpy()\nbase = holdout_data[\"base_speed\"].to_numpy()\nraw_pred = pred_speed_original_style.copy()\n\ndef speed_rmse(pred):\n    valid = np.isfinite(y_actual) & np.isfinite(pred)\n    return np.sqrt(np.mean((y_actual[valid] - pred[valid]) ** 2))\n\nprint(\"February speed RMSE, original:\", round(speed_rmse(raw_pred), 4))\n\nfor cap in [40, 50, 60, 70, 80]:\n    correction = raw_pred - base\n    capped_pred = base + np.maximum(correction, -cap)\n    capped_pred = np.clip(capped_pred, 0, 160)\n    print(\n        f\"Lower correction cap -{cap:2d} km/h | \"\n        f\"speed RMSE: {speed_rmse(capped_pred):.4f}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:59:13.359557Z","iopub.execute_input":"2026-10-19T15:59:13.360061Z","iopub.status.idle":"2026-10-19T15:59:13.404146Z","shell.execute_reply.started":"2026-10-19T15:59:13.360028Z","shell.execute_reply":"2026-10-19T15:59:13.4025Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare February vs April correction behavior by recent-lag availability\ndef correction_summary(name, frame, correction_col):\n    frame = frame.copy()\n    frame[\"recent_lags_missing\"] = (\n        frame[\"lag_speed_5\"].isna() | frame[\"lag_speed_15\"].isna()\n    )\n    frame[\"large_negative\"] = frame[correction_col] < -30\n\n    result = (\n        frame.groupby([\"mask_regime\", \"recent_lags_missing\"], observed=True)\n        .agg(\n            rows=(correction_col, \"size\"),\n            mean_correction=(correction_col, \"mean\"),\n            large_negative_rate=(\"large_negative\", \"mean\"),\n        )\n        .reset_index()\n    )\n    result.insert(0, \"period\", name)\n    return result\n\nfeb_compare = feb_diag.copy()\nfeb_compare[\"correction_value\"] = feb_compare[\"correction\"]\n\napr_compare = private_features.copy()\napr_compare[\"correction_value\"] = (\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy()\n)\n\ncomparison = pd.concat([\n    correction_summary(\"February\", feb_compare, \"correction_value\"),\n    correction_summary(\"April\", apr_compare, \"correction_value\"),\n], ignore_index=True)\n\ncomparison[\"large_negative_rate_pct\"] = (\n    100 * comparison.pop(\"large_negative_rate\")\n).round(2)\n\ndisplay(comparison.round(3))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:00:04.959677Z","iopub.execute_input":"2026-10-19T16:00:04.960126Z","iopub.status.idle":"2026-10-19T16:00:05.249203Z","shell.execute_reply.started":"2026-10-19T16:00:04.960096Z","shell.execute_reply":"2026-10-19T16:00:05.248084Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# February speed error by model correction range\nfeb_eval = feb_diag.copy()\n\nfeb_eval[\"actual_speed\"] = holdout_truth[\"speed_kmh\"].to_numpy()\nfeb_eval[\"abs_error\"] = (\n    feb_eval[\"pred_speed\"] - feb_eval[\"actual_speed\"]\n).abs()\n\nfeb_eval[\"correction_band\"] = pd.cut(\n    feb_eval[\"correction\"],\n    bins=[-np.inf, -60, -40, -30, -20, 0, 20, np.inf],\n    labels=[\n        \"< -60\", \"-60 to -40\", \"-40 to -30\",\n        \"-30 to -20\", \"-20 to 0\", \"0 to 20\", \"> 20\"\n    ],\n    right=False\n)\n\ndisplay(\n    feb_eval.groupby(\"correction_band\", observed=True)\n    .agg(\n        rows=(\"abs_error\", \"size\"),\n        speed_rmse=(\"abs_error\", lambda x: np.sqrt(np.mean(x**2))),\n        mean_abs_error=(\"abs_error\", \"mean\"),\n        mean_actual_speed=(\"actual_speed\", \"mean\"),\n        mean_predicted_speed=(\"pred_speed\", \"mean\"),\n    )\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:00:42.927357Z","iopub.execute_input":"2026-10-19T16:00:42.92777Z","iopub.status.idle":"2026-10-19T16:00:43.064432Z","shell.execute_reply.started":"2026-10-19T16:00:42.927739Z","shell.execute_reply":"2026-10-19T16:00:43.06272Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare February vs April R2 under similar recent traffic conditions\n\ndef prepare_period(frame, correction, period):\n    df = frame.copy()\n    df[\"correction\"] = np.asarray(correction)\n    df[\"period\"] = period\n\n    # Bucket recent observed speeds; missing values remain identifiable\n    for col in [\"lag_speed_5\", \"lag_speed_15\", \"lag_speed_60\"]:\n        df[col + \"_band\"] = pd.cut(\n            df[col],\n            bins=[-np.inf, 40, 60, 80, 100, np.inf],\n            labels=[\"<40\", \"40-60\", \"60-80\", \"80-100\", \">100\"]\n        ).astype(\"object\").fillna(\"Missing\")\n\n    return df\n\nfeb_r2 = prepare_period(\n    feb_diag.loc[feb_diag[\"mask_regime\"].eq(\"R2\")],\n    feb_diag.loc[feb_diag[\"mask_regime\"].eq(\"R2\"), \"correction\"],\n    \"February\"\n)\n\napr_r2 = prepare_period(\n    private_features.loc[private_features[\"mask_regime\"].eq(\"R2\")],\n    (\n        private_submission.loc[\n            private_features[\"mask_regime\"].eq(\"R2\"), \"speed_kmh\"\n        ].to_numpy()\n        - private_features.loc[\n            private_features[\"mask_regime\"].eq(\"R2\"), \"base_speed\"\n        ].to_numpy()\n    ),\n    \"April\"\n)\n\nboth_r2 = pd.concat([feb_r2, apr_r2], ignore_index=True)\n\ncomparison_r2 = (\n    both_r2.groupby(\n        [\"period\", \"lag_speed_5_band\", \"lag_speed_15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        negative30_rate=(\"correction\", lambda x: (x < -30).mean()),\n    )\n    .reset_index()\n)\n\ncomparison_r2[\"negative30_rate_pct\"] = (\n    100 * comparison_r2.pop(\"negative30_rate\")\n).round(2)\n\n# Keep conditions with enough observations for a meaningful comparison\ncomparison_r2 = comparison_r2.loc[comparison_r2[\"rows\"] >= 100]\n\ndisplay(\n    comparison_r2.sort_values(\n        [\"lag_speed_5_band\", \"lag_speed_15_band\", \"period\"]\n    ).round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:02:37.744386Z","iopub.execute_input":"2026-10-19T16:02:37.744858Z","iopub.status.idle":"2026-10-19T16:02:38.297969Z","shell.execute_reply.started":"2026-10-19T16:02:37.744831Z","shell.execute_reply":"2026-10-19T16:02:38.296031Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare February vs April R2 corrections by time of day\n\ndef make_tod_table(df, correction, period):\n    out = df[[\"timestamp\", \"mask_regime\"]].copy()\n    out[\"correction\"] = np.asarray(correction)\n    out = out[out[\"mask_regime\"].eq(\"R2\")].copy()\n\n    # UTC timestamps, consistent with the existing notebook\n    hour = out[\"timestamp\"].dt.hour\n    out[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n    out[\"period\"] = period\n    return out\n\nfeb_tod = make_tod_table(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_tod = make_tod_table(\n    private_features,\n    (\n        private_submission[\"speed_kmh\"].to_numpy()\n        - private_features[\"base_speed\"].to_numpy()\n    ),\n    \"April\"\n)\n\ntod_comparison = (\n    pd.concat([feb_tod, apr_tod], ignore_index=True)\n    .groupby([\"period\", \"time_period\"], observed=True)\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        negative30_rate=(\"correction\", lambda x: (x < -30).mean() * 100),\n    )\n    .reset_index()\n)\n\ndisplay(tod_comparison.round(2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:03:02.92462Z","iopub.execute_input":"2026-10-19T16:03:02.925178Z","iopub.status.idle":"2026-10-19T16:03:03.099607Z","shell.execute_reply.started":"2026-10-19T16:03:02.925148Z","shell.execute_reply":"2026-10-19T16:03:03.09777Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# R2: compare midday/evening corrections by recent lag-speed conditions\n\ndef make_r2_detail(frame, correction, period):\n    df = frame.loc[frame[\"mask_regime\"].eq(\"R2\")].copy()\n    df[\"correction\"] = np.asarray(correction)[\n        frame[\"mask_regime\"].eq(\"R2\").to_numpy()\n    ]\n\n    hour = df[\"timestamp\"].dt.hour\n    df[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n\n    df[\"lag5_band\"] = pd.cut(\n        df[\"lag_speed_5\"],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"lag15_band\"] = pd.cut(\n        df[\"lag_speed_15\"],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"period\"] = period\n    return df\n\nfeb_r2_detail = make_r2_detail(\n    feb_diag, feb_diag[\"correction\"].to_numpy(), \"February\"\n)\n\napr_r2_detail = make_r2_detail(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\ndetail = pd.concat([feb_r2_detail, apr_r2_detail], ignore_index=True)\n\nresult = (\n    detail.loc[detail[\"time_period\"].isin([\"Midday\", \"Evening peak\"])]\n    .groupby(\n        [\"period\", \"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        negative30_rate_pct=(\"correction\", lambda x: 100 * (x < -30).mean())\n    )\n    .reset_index()\n)\n\ndisplay(\n    result.loc[result[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\", \"period\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:03:42.629491Z","iopub.execute_input":"2026-10-19T16:03:42.630002Z","iopub.status.idle":"2026-10-19T16:03:43.139269Z","shell.execute_reply.started":"2026-10-19T16:03:42.629961Z","shell.execute_reply":"2026-10-19T16:03:43.138251Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# February R2: evaluate errors by time of day and recent lag speeds\n\nfeb_error_check = feb_diag.loc[\n    feb_diag[\"mask_regime\"].eq(\"R2\")\n].copy()\n\nfeb_error_check[\"actual_speed\"] = holdout_truth.loc[\n    feb_diag[\"mask_regime\"].eq(\"R2\"), \"speed_kmh\"\n].to_numpy()\n\nfeb_error_check[\"error\"] = (\n    feb_error_check[\"pred_speed\"] - feb_error_check[\"actual_speed\"]\n)\n\nhour = feb_error_check[\"timestamp\"].dt.hour\nfeb_error_check[\"time_period\"] = pd.cut(\n    hour,\n    bins=[-1, 5, 9, 15, 19, 23],\n    labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n)\n\nfor col, band_col in [\n    (\"lag_speed_5\", \"lag5_band\"),\n    (\"lag_speed_15\", \"lag15_band\"),\n]:\n    feb_error_check[band_col] = pd.cut(\n        feb_error_check[col],\n        bins=[-np.inf, 40, 60, 80, np.inf],\n        labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n    ).astype(\"object\").fillna(\"Missing\")\n\nfeb_error_summary = (\n    feb_error_check.loc[\n        feb_error_check[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"error\", \"size\"),\n        speed_rmse=(\"error\", lambda x: np.sqrt(np.mean(x**2))),\n        mean_error=(\"error\", \"mean\"),\n        actual_speed_mean=(\"actual_speed\", \"mean\"),\n        predicted_speed_mean=(\"pred_speed\", \"mean\"),\n    )\n    .reset_index()\n)\n\ndisplay(\n    feb_error_summary.loc[feb_error_summary[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:04:31.870567Z","iopub.execute_input":"2026-10-19T16:04:31.871455Z","iopub.status.idle":"2026-10-19T16:04:32.139454Z","shell.execute_reply.started":"2026-10-19T16:04:31.871414Z","shell.execute_reply":"2026-10-19T16:04:32.138011Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# February R2: compare baseline vs final model by time and lag availability\n\nfeb_baseline_check = feb_error_check.copy()\n\nfeb_baseline_check[\"baseline_speed\"] = (\n    holdout_data.loc[\n        feb_diag[\"mask_regime\"].eq(\"R2\"), \"base_speed\"\n    ].to_numpy()\n)\n\nfeb_baseline_check[\"baseline_error\"] = (\n    feb_baseline_check[\"baseline_speed\"]\n    - feb_baseline_check[\"actual_speed\"]\n)\n\nfeb_baseline_check[\"final_sq_error\"] = feb_baseline_check[\"error\"] ** 2\nfeb_baseline_check[\"baseline_sq_error\"] = (\n    feb_baseline_check[\"baseline_error\"] ** 2\n)\n\nresult = (\n    feb_baseline_check.loc[\n        feb_baseline_check[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"error\", \"size\"),\n        baseline_rmse=(\n            \"baseline_sq_error\", lambda x: np.sqrt(x.mean())\n        ),\n        model_rmse=(\n            \"final_sq_error\", lambda x: np.sqrt(x.mean())\n        ),\n        baseline_bias=(\"baseline_error\", \"mean\"),\n        model_bias=(\"error\", \"mean\"),\n    )\n    .reset_index()\n)\n\nresult[\"rmse_change\"] = result[\"model_rmse\"] - result[\"baseline_rmse\"]\n\ndisplay(\n    result.loc[result[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\"])\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:05:03.205738Z","iopub.execute_input":"2026-10-19T16:05:03.206181Z","iopub.status.idle":"2026-10-19T16:05:03.331681Z","shell.execute_reply.started":"2026-10-19T16:05:03.206152Z","shell.execute_reply":"2026-10-19T16:05:03.330599Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# April vs February R2 correction shift by link\ndef link_corrections(frame, correction, period):\n    df = frame.loc[frame[\"mask_regime\"].eq(\"R2\"), [\"link_id\"]].copy()\n    df[\"correction\"] = np.asarray(correction)[\n        frame[\"mask_regime\"].eq(\"R2\").to_numpy()\n    ]\n    df[\"period\"] = period\n\n    return (\n        df.groupby([\"period\", \"link_id\"], observed=True)\n        .agg(\n            rows=(\"correction\", \"size\"),\n            mean_correction=(\"correction\", \"mean\"),\n            negative30_rate=(\"correction\", lambda x: 100 * (x < -30).mean()),\n        )\n        .reset_index()\n    )\n\nfeb_link = link_corrections(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_link = link_corrections(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\nlink_compare = feb_link.merge(\n    apr_link,\n    on=\"link_id\",\n    suffixes=(\"_feb\", \"_apr\"),\n    validate=\"one_to_one\"\n)\n\nlink_compare[\"mean_correction_change\"] = (\n    link_compare[\"mean_correction_apr\"]\n    - link_compare[\"mean_correction_feb\"]\n)\nlink_compare[\"negative30_rate_change_pp\"] = (\n    link_compare[\"negative30_rate_apr\"]\n    - link_compare[\"negative30_rate_feb\"]\n)\n\ndisplay(\n    link_compare.loc[\n        (link_compare[\"rows_feb\"] >= 100)\n        & (link_compare[\"rows_apr\"] >= 100)\n    ]\n    .sort_values(\"mean_correction_change\")\n    [[\n        \"link_id\", \"rows_feb\", \"rows_apr\",\n        \"mean_correction_feb\", \"mean_correction_apr\",\n        \"mean_correction_change\",\n        \"negative30_rate_feb\", \"negative30_rate_apr\",\n        \"negative30_rate_change_pp\",\n    ]]\n    .head(15)\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:05:40.232262Z","iopub.execute_input":"2026-10-19T16:05:40.232675Z","iopub.status.idle":"2026-10-19T16:05:40.462419Z","shell.execute_reply.started":"2026-10-19T16:05:40.232644Z","shell.execute_reply":"2026-10-19T16:05:40.461438Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# R2 correction shift by day of month: February vs April\n\ndef daily_r2_corrections(frame, correction, period):\n    mask = frame[\"mask_regime\"].eq(\"R2\")\n    df = frame.loc[mask, [\"timestamp\"]].copy()\n    df[\"correction\"] = np.asarray(correction)[mask.to_numpy()]\n    df[\"day\"] = df[\"timestamp\"].dt.day\n    df[\"period\"] = period\n\n    return (\n        df.groupby([\"period\", \"day\"], observed=True)\n        .agg(\n            rows=(\"correction\", \"size\"),\n            mean_correction=(\"correction\", \"mean\"),\n            negative30_rate_pct=(\n                \"correction\", lambda x: 100 * (x < -30).mean()\n            ),\n        )\n        .reset_index()\n    )\n\nfeb_daily = daily_r2_corrections(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_daily = daily_r2_corrections(\n    private_features,\n    (\n        private_submission[\"speed_kmh\"].to_numpy()\n        - private_features[\"base_speed\"].to_numpy()\n    ),\n    \"April\"\n)\n\ndaily_compare = feb_daily.merge(\n    apr_daily,\n    on=\"day\",\n    suffixes=(\"_feb\", \"_apr\"),\n    validate=\"one_to_one\"\n)\n\ndaily_compare[\"mean_correction_change\"] = (\n    daily_compare[\"mean_correction_apr\"]\n    - daily_compare[\"mean_correction_feb\"]\n)\n\ndisplay(\n    daily_compare[\n        [\n            \"day\", \"rows_feb\", \"rows_apr\",\n            \"mean_correction_feb\", \"mean_correction_apr\",\n            \"mean_correction_change\",\n            \"negative30_rate_pct_feb\", \"negative30_rate_pct_apr\"\n        ]\n    ]\n    .sort_values(\"mean_correction_change\")\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:06:23.595184Z","iopub.execute_input":"2026-10-19T16:06:23.596564Z","iopub.status.idle":"2026-10-19T16:06:23.736872Z","shell.execute_reply.started":"2026-10-19T16:06:23.596517Z","shell.execute_reply":"2026-10-19T16:06:23.735857Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"February R2 days:\", sorted(feb_daily[\"day\"].unique()))\nprint(\"April R2 days:\", sorted(apr_daily[\"day\"].unique()))\n\nprint(\"\\nRows per day:\")\ndisplay(\n    pd.concat([\n        feb_daily.assign(period=\"February\"),\n        apr_daily.assign(period=\"April\")\n    ])\n    .groupby([\"period\", \"day\"], observed=True)[\"rows\"]\n    .sum()\n    .unstack(\"period\")\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:06:51.600202Z","iopub.execute_input":"2026-10-19T16:06:51.6006Z","iopub.status.idle":"2026-10-19T16:06:51.658188Z","shell.execute_reply.started":"2026-10-19T16:06:51.60057Z","shell.execute_reply":"2026-10-19T16:06:51.657076Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Rebuild daily comparison and report coverage correctly\n\nfeb_daily = daily_r2_corrections(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_daily = daily_r2_corrections(\n    private_features,\n    (\n        private_submission[\"speed_kmh\"].to_numpy()\n        - private_features[\"base_speed\"].to_numpy()\n    ),\n    \"April\"\n)\n\nprint(\"February days available:\", len(feb_daily))\nprint(\"April days available:\", len(apr_daily))\nprint(\"Common day numbers:\",\n      sorted(set(feb_daily[\"day\"]) & set(apr_daily[\"day\"])))\n\ndaily_compare = feb_daily.merge(\n    apr_daily,\n    on=\"day\",\n    suffixes=(\"_feb\", \"_apr\"),\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\ndaily_compare[\"mean_correction_change\"] = (\n    daily_compare[\"mean_correction_apr\"]\n    - daily_compare[\"mean_correction_feb\"]\n)\n\ndisplay(\n    daily_compare[\n        [\n            \"day\", \"rows_feb\", \"rows_apr\",\n            \"mean_correction_feb\", \"mean_correction_apr\",\n            \"mean_correction_change\",\n            \"negative30_rate_pct_feb\",\n            \"negative30_rate_pct_apr\",\n        ]\n    ].sort_values(\"day\").round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:07:58.332502Z","iopub.execute_input":"2026-10-19T16:07:58.33296Z","iopub.status.idle":"2026-10-19T16:07:58.465151Z","shell.execute_reply.started":"2026-10-19T16:07:58.332924Z","shell.execute_reply":"2026-10-19T16:07:58.463959Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Inspect historical ground-truth coverage by month\ntruth_check = truth.copy()\ntruth_check[\"timestamp\"] = pd.to_datetime(truth_check[\"timestamp\"], utc=True)\ntruth_check[\"month\"] = truth_check[\"timestamp\"].dt.to_period(\"M\").astype(str)\n\ndisplay(\n    truth_check.groupby(\"month\", observed=True)\n    .agg(\n        rows=(\"timestamp\", \"size\"),\n        eligible_rows=(\"is_score_eligible\", \"sum\"),\n        speed_available=(\"speed_kmh\", \"count\"),\n        flow_available=(\"flow_vph\", \"count\"),\n    )\n    .reset_index()\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:09:18.599114Z","iopub.execute_input":"2026-10-19T16:09:18.599553Z","iopub.status.idle":"2026-10-19T16:09:27.457789Z","shell.execute_reply.started":"2026-10-19T16:09:18.599525Z","shell.execute_reply":"2026-10-19T16:09:27.456397Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Check prerequisites for a leakage-safe temporal validation\n\nrequired = [\n    \"truth\", \"masked_lookup\", \"KEYS\", \"VALUE_COLS\",\n    \"build_baseline\", \"attach_baseline\",\n    \"add_lags\", \"add_model_features\",\n    \"FEATURES\",\n]\n\nfor name in required:\n    print(f\"{name}: {'OK' if name in globals() else 'MISSING'}\")\n\nprint(\"\\nExisting model variables:\")\nfor name in [\n    \"speed_model_original_style\",\n    \"flow_model_original_style\",\n]:\n    print(f\"{name}: {'OK' if name in globals() else 'MISSING'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:09:52.342323Z","iopub.execute_input":"2026-10-19T16:09:52.342842Z","iopub.status.idle":"2026-10-19T16:09:52.351391Z","shell.execute_reply.started":"2026-10-19T16:09:52.342811Z","shell.execute_reply":"2026-10-19T16:09:52.350251Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# January 2031 temporal holdout: prepare targets and features\nimport pandas as pd\nimport numpy as np\n\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\nfeb_start = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\ndec_start = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\n\n# Ground-truth labels for January evaluation\njan_truth = truth.loc[\n    (truth[\"timestamp\"] >= jan_start)\n    & (truth[\"timestamp\"] < feb_start)\n    & truth[\"is_score_eligible\"].eq(1)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\nprint(\"Eligible January truth rows:\", len(jan_truth))\n\n# Targets use the same timestamp/station/link keys and regime as the pipeline\njan_targets = jan_truth[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].merge(\n    masked_lookup[[\"timestamp\", \"station_id\", \"link_id\"]],\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# Attach the regime from the corresponding masked data if it isn't already present\n# (truth labels are used only for evaluation, never as model input)\nif \"mask_regime\" not in jan_targets.columns:\n    jan_regime = features.loc[\n        features[\"timestamp\"].between(jan_start, feb_start, inclusive=\"left\"),\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n    ].drop_duplicates([\"timestamp\", \"station_id\", \"link_id\"])\n    jan_targets = jan_targets.merge(\n        jan_regime,\n        on=[\"timestamp\", \"station_id\", \"link_id\"],\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n# Baseline is computed using history before January\njan_baseline = build_baseline(jan_targets, jan_start)\njan_features = attach_baseline(jan_targets, jan_baseline)\njan_features = add_lags(jan_features)\njan_features = add_model_features(jan_features)\n\nprint(\"January feature rows:\", len(jan_features))\nprint(\"Missing baseline speed:\", jan_features[\"base_speed\"].isna().sum())\nprint(\"Missing baseline flow:\", jan_features[\"base_flow\"].isna().sum())\nprint(\"Feature columns prepared:\", len(jan_features.columns))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:10:43.118081Z","iopub.execute_input":"2026-10-19T16:10:43.11862Z","iopub.status.idle":"2026-10-19T16:11:45.777448Z","shell.execute_reply.started":"2026-10-19T16:10:43.118588Z","shell.execute_reply":"2026-10-19T16:11:45.776227Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Inspect available training months and expected feature schema\n\nprint(\"Existing feature rows by month:\")\ndisplay(\n    features.assign(\n        month=features[\"timestamp\"].dt.strftime(\"%Y-%m\")\n    ).groupby(\"month\", observed=True)\n    .agg(\n        rows=(\"timestamp\", \"size\"),\n        eligible_targets=(\"target_eligible\", \"sum\"),\n    )\n    .reset_index()\n)\n\nprint(\"\\nFeature schema:\")\nprint(\"FEATURES count:\", len(FEATURES))\nprint(\"Model expected features:\", speed_model_original_style.n_features_in_)\nprint(\"Model feature names:\", list(speed_model_original_style.feature_names_in_))\n\nprint(\"\\nJanuary feature columns:\")\nprint(jan_features.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:12:32.007699Z","iopub.execute_input":"2026-10-19T16:12:32.00913Z","iopub.status.idle":"2026-10-19T16:12:37.171523Z","shell.execute_reply.started":"2026-10-19T16:12:32.009085Z","shell.execute_reply":"2026-10-19T16:12:37.170386Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Verify pre-January training data and target columns\n\npre_jan = features.loc[features[\"timestamp\"] < jan_start].copy()\n\nprint(\"Pre-January rows:\", len(pre_jan))\nprint(\"Target columns available:\",\n      [c for c in [\"target_speed\", \"target_flow\", \"speed_kmh\", \"flow_vph\"]\n       if c in pre_jan.columns])\n\nprint(\"Target missingness:\")\nfor col in [\"target_speed\", \"target_flow\"]:\n    if col in pre_jan.columns:\n        print(f\"{col}: {pre_jan[col].isna().sum()} missing\")\n\nprint(\"\\nID mappings available:\")\nfor col in [\"station_id_code\", \"link_id_code\", \"mask_regime_code\"]:\n    print(f\"{col}: {col in features.columns}\")\n\nprint(\"\\nLag lookup columns:\")\nprint(masked_lookup.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:16:39.578626Z","iopub.execute_input":"2026-10-19T16:16:39.579589Z","iopub.status.idle":"2026-10-19T16:16:39.706411Z","shell.execute_reply.started":"2026-10-19T16:16:39.579442Z","shell.execute_reply":"2026-10-19T16:16:39.704704Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Fix feature names for the January temporal validation\n\n# Rename the existing training feature columns to match the model schema\nrename_map = {\n    \"lag5_speed\": \"lag_speed_5\",\n    \"lag5_flow\": \"lag_flow_5\",\n    \"lag15_speed\": \"lag_speed_15\",\n    \"lag15_flow\": \"lag_flow_15\",\n    \"lag60_speed\": \"lag_speed_60\",\n    \"lag60_flow\": \"lag_flow_60\",\n    \"lag1440_speed\": \"lag_speed_1440\",\n    \"lag1440_flow\": \"lag_flow_1440\",\n    \"dow\": \"weekday\",\n    \"dow_sin\": \"weekday_sin\",\n    \"dow_cos\": \"weekday_cos\",\n}\n\nfeatures = features.rename(columns=rename_map)\n\n# Add sorted category codes to the training and January frames\ncategory_maps = {}\nfor col, code_col in [\n    (\"station_id\", \"station_id_code\"),\n    (\"link_id\", \"link_id_code\"),\n    (\"mask_regime\", \"mask_regime_code\"),\n]:\n    categories = sorted(features[col].astype(str).unique())\n    category_maps[col] = {value: i for i, value in enumerate(categories)}\n\n    features[code_col] = (\n        features[col].astype(str).map(category_maps[col]).astype(\"float32\")\n    )\n    jan_features[code_col] = (\n        jan_features[col].astype(str).map(category_maps[col]).astype(\"float32\")\n    )\n\nX_pre_jan = features.loc[\n    features[\"timestamp\"] < jan_start, FEATURES\n].astype(\"float32\").copy()\n\nX_jan = jan_features[FEATURES].astype(\"float32\").copy()\n\nprint(\"Training matrix:\", X_pre_jan.shape)\nprint(\"January matrix:\", X_jan.shape)\nprint(\"Feature order matches:\", list(X_pre_jan.columns) == list(X_jan.columns))\nprint(\"Training NaNs:\", int(X_pre_jan.isna().sum().sum()))\nprint(\"January NaNs:\", int(X_jan.isna().sum().sum()))\nprint(\"Unmapped January IDs:\", {\n    code: int(jan_features[code].isna().sum())\n    for code in [\"station_id_code\", \"link_id_code\", \"mask_regime_code\"]\n})","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:17:37.195563Z","iopub.execute_input":"2026-10-19T16:17:37.196066Z","iopub.status.idle":"2026-10-19T16:17:38.339205Z","shell.execute_reply.started":"2026-10-19T16:17:37.196036Z","shell.execute_reply":"2026-10-19T16:17:38.33769Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Diagnose missing feature values and category mapping coverage\n\nprint(\"Training NaNs by feature:\")\ndisplay(\n    X_pre_jan.isna().sum()\n    .sort_values(ascending=False)\n    .rename(\"missing_rows\")\n    .to_frame()\n    .query(\"missing_rows > 0\")\n)\n\nprint(\"\\nJanuary NaNs by feature:\")\ndisplay(\n    X_jan.isna().sum()\n    .sort_values(ascending=False)\n    .rename(\"missing_rows\")\n    .to_frame()\n    .query(\"missing_rows > 0\")\n)\n\nprint(\"\\nRegime categories:\")\nprint(\"Training features:\", sorted(features[\"mask_regime\"].astype(str).unique()))\nprint(\"January features:\", sorted(jan_features[\"mask_regime\"].astype(str).unique()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:18:20.966016Z","iopub.execute_input":"2026-10-19T16:18:20.9665Z","iopub.status.idle":"2026-10-19T16:18:21.263132Z","shell.execute_reply.started":"2026-10-19T16:18:20.966471Z","shell.execute_reply":"2026-10-19T16:18:21.262057Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Find where January's mask_regime values are missing\n\nprint(\"Missing regimes in jan_targets:\")\nprint(jan_targets[\"mask_regime\"].isna().sum())\n\nprint(\"\\nColumns in jan_targets:\")\nprint(jan_targets.columns.tolist())\n\nprint(\"\\nMissing-regime examples:\")\ndisplay(\n    jan_targets.loc[\n        jan_targets[\"mask_regime\"].isna(),\n        [\"timestamp\", \"station_id\", \"link_id\"]\n    ].head(10)\n)\n\nprint(\"\\nRegime missingness in source truth:\")\nprint(\n    truth.loc[\n        (truth[\"timestamp\"] >= jan_start)\n        & (truth[\"timestamp\"] < feb_start),\n        \"mask_regime\"\n    ].isna().sum()\n    if \"mask_regime\" in truth.columns\n    else \"truth has no mask_regime column\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:19:46.766169Z","iopub.execute_input":"2026-10-19T16:19:46.766558Z","iopub.status.idle":"2026-10-19T16:19:46.917591Z","shell.execute_reply.started":"2026-10-19T16:19:46.76653Z","shell.execute_reply":"2026-10-19T16:19:46.916263Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\n\nJAN_MASKED_DIR = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\nprint(\"Directory exists:\", JAN_MASKED_DIR.exists())\nprint(\"Parquet files:\", len(list(JAN_MASKED_DIR.rglob(\"*.parquet\"))))\n\nsample_path = next(JAN_MASKED_DIR.rglob(\"*.parquet\"))\nsample = pd.read_parquet(sample_path)\n\nprint(\"\\nSample file:\", sample_path)\nprint(\"Columns:\", sample.columns.tolist())\ndisplay(sample.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:20:38.362439Z","iopub.execute_input":"2026-10-19T16:20:38.36297Z","iopub.status.idle":"2026-10-19T16:20:38.608386Z","shell.execute_reply.started":"2026-10-19T16:20:38.362939Z","shell.execute_reply":"2026-10-19T16:20:38.607373Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nJAN_MASKED_DIR = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\n# Load only January masked records and the columns needed for regime mapping\njan_regime_parts = []\n\nfor path in JAN_MASKED_DIR.rglob(\"*.parquet\"):\n    if \"2031_01_\" not in path.name:\n        continue\n\n    part = pd.read_parquet(\n        path,\n        columns=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n    )\n    jan_regime_parts.append(part)\n\njan_regime_lookup = pd.concat(jan_regime_parts, ignore_index=True)\njan_regime_lookup[\"timestamp\"] = pd.to_datetime(\n    jan_regime_lookup[\"timestamp\"], utc=True\n)\n\njan_regime_lookup = jan_regime_lookup.drop_duplicates(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n)\n\n# Replace the missing regime values using the true masked-data assignments\njan_targets = jan_targets.drop(columns=[\"mask_regime\"]).merge(\n    jan_regime_lookup,\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nprint(\"January target rows:\", len(jan_targets))\nprint(\"Missing regime assignments:\", jan_targets[\"mask_regime\"].isna().sum())\ndisplay(jan_targets[\"mask_regime\"].value_counts(dropna=False))\n\n# Rebuild January features with pre-January baseline and masked lag data\njan_baseline = build_baseline(jan_targets, jan_start)\njan_features = attach_baseline(jan_targets, jan_baseline)\njan_features = add_lags(jan_features)\njan_features = add_model_features(jan_features)\n\nprint(\"\\nJanuary feature rows:\", len(jan_features))\nprint(\"Missing baseline speed:\", jan_features[\"base_speed\"].isna().sum())\nprint(\"Missing baseline flow:\", jan_features[\"base_flow\"].isna().sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:21:13.754671Z","iopub.execute_input":"2026-10-19T16:21:13.755098Z","iopub.status.idle":"2026-10-19T16:22:07.252258Z","shell.execute_reply.started":"2026-10-19T16:21:13.755068Z","shell.execute_reply":"2026-10-19T16:22:07.250883Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Build December training features for January temporal validation\n\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/\"\n    \"kaggle_public/corridors/D7_I405_S/train/mainline_states_masked\"\n)\n\ndec_start = pd.Timestamp(\"2030-12-01\", tz=\"UTC\")\njan_start = pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n\n# December eligible labels; used as training targets only\ndec_truth = truth.loc[\n    (truth[\"timestamp\"] >= dec_start)\n    & (truth[\"timestamp\"] < jan_start)\n    & truth[\"is_score_eligible\"].eq(1)\n    & truth[\"speed_kmh\"].notna()\n    & truth[\"flow_vph\"].notna()\n].copy()\n\n# Load December regimes from masked parquet files\ndec_parts = []\nfor path in ROOT.rglob(\"*.parquet\"):\n    if \"2030_12_\" not in path.name:\n        continue\n    dec_parts.append(\n        pd.read_parquet(\n            path,\n            columns=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n        )\n    )\n\ndec_regime_lookup = pd.concat(dec_parts, ignore_index=True)\ndec_regime_lookup[\"timestamp\"] = pd.to_datetime(\n    dec_regime_lookup[\"timestamp\"], utc=True\n)\ndec_regime_lookup = dec_regime_lookup.drop_duplicates(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n)\n\ndec_targets = dec_truth[\n    [\"timestamp\", \"station_id\", \"link_id\", \"speed_kmh\", \"flow_vph\"]\n].merge(\n    dec_regime_lookup,\n    on=[\"timestamp\", \"station_id\", \"link_id\"],\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nassert dec_targets[\"mask_regime\"].notna().all(), \"Missing December regimes\"\n\n# Build baseline from history strictly before December 1\ndec_baseline = build_baseline(dec_targets, dec_start)\ndec_features = attach_baseline(dec_targets, dec_baseline)\ndec_features = add_lags(dec_features)\ndec_features = add_model_features(dec_features)\n\n# Match the existing 19-feature schema\ndec_features = dec_features.rename(columns={\n    \"lag5_speed\": \"lag_speed_5\",\n    \"lag5_flow\": \"lag_flow_5\",\n    \"lag15_speed\": \"lag_speed_15\",\n    \"lag15_flow\": \"lag_flow_15\",\n    \"lag60_speed\": \"lag_speed_60\",\n    \"lag60_flow\": \"lag_flow_60\",\n    \"lag1440_speed\": \"lag_speed_1440\",\n    \"lag1440_flow\": \"lag_flow_1440\",\n    \"dow\": \"weekday\",\n    \"dow_sin\": \"weekday_sin\",\n    \"dow_cos\": \"weekday_cos\",\n})\n\n# Consistent sorted categorical codes across December and January\nfor col, code_col in [\n    (\"station_id\", \"station_id_code\"),\n    (\"link_id\", \"link_id_code\"),\n    (\"mask_regime\", \"mask_regime_code\"),\n]:\n    categories = sorted(\n        set(dec_features[col].astype(str))\n        | set(jan_features[col].astype(str))\n    )\n    mapping = {value: i for i, value in enumerate(categories)}\n\n    dec_features[code_col] = (\n        dec_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n    jan_features[code_col] = (\n        jan_features[col].astype(str).map(mapping).astype(\"float32\")\n    )\n\nX_dec = dec_features[FEATURES].astype(\"float32\")\nX_jan = jan_features[FEATURES].astype(\"float32\")\n\nprint(\"December training rows:\", len(X_dec))\nprint(\"January validation rows:\", len(X_jan))\nprint(\"December missing regimes:\", dec_features[\"mask_regime\"].isna().sum())\nprint(\"January missing regimes:\", jan_features[\"mask_regime\"].isna().sum())\nprint(\"December missing baseline:\", dec_features[[\"base_speed\", \"base_flow\"]].isna().sum().sum())\nprint(\"January missing baseline:\", jan_features[[\"base_speed\", \"base_flow\"]].isna().sum().sum())\nprint(\"Feature count:\", X_dec.shape[1])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:22:57.333184Z","iopub.execute_input":"2026-10-19T16:22:57.333648Z","iopub.status.idle":"2026-10-19T16:23:50.739082Z","shell.execute_reply.started":"2026-10-19T16:22:57.333615Z","shell.execute_reply":"2026-10-19T16:23:50.737831Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\n# Train targets are residuals relative to the December baseline\ny_dec_speed = (\n    dec_features[\"speed_kmh\"].to_numpy()\n    - dec_features[\"base_speed\"].to_numpy()\n)\ny_dec_flow = (\n    dec_features[\"flow_vph\"].to_numpy()\n    - dec_features[\"base_flow\"].to_numpy()\n)\n\njan_base_speed = jan_features[\"base_speed\"].to_numpy()\njan_base_flow = jan_features[\"base_flow\"].to_numpy()\n\n# Independent temporal-validation models\njan_speed_model = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\njan_flow_model = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\njan_speed_model.fit(X_dec, y_dec_speed)\njan_flow_model.fit(X_dec, y_dec_flow)\n\n# Predict January; labels are used only for evaluation\njan_pred_speed = np.clip(\n    jan_base_speed + jan_speed_model.predict(X_jan), 0, 160\n)\njan_pred_flow = np.clip(\n    jan_base_flow + jan_flow_model.predict(X_jan), 0, None\n)\n\njan_actual_speed = jan_features[\"speed_kmh\"].to_numpy()\njan_actual_flow = jan_features[\"flow_vph\"].to_numpy()\n\n# Official metric: macro-average over R1/R2/R3\njan_eval = jan_features[[\"mask_regime\"]].copy()\njan_eval[\"speed_actual\"] = jan_actual_speed\njan_eval[\"flow_actual\"] = jan_actual_flow\njan_eval[\"speed_pred\"] = jan_pred_speed\njan_eval[\"flow_pred\"] = jan_pred_flow\njan_eval[\"speed_base\"] = jan_base_speed\njan_eval[\"flow_base\"] = jan_base_flow\n\nrows = []\nfor regime, group in jan_eval.groupby(\"mask_regime\", observed=True):\n    speed_rmse_model = np.sqrt(\n        mean_squared_error(group[\"speed_actual\"], group[\"speed_pred\"])\n    )\n    flow_rmse_lane_model = np.sqrt(\n        np.mean(\n            (\n                (group[\"flow_actual\"] - group[\"flow_pred\"])\n                / 1.0\n            ) ** 2\n        )\n    )\n\n    speed_rmse_base = np.sqrt(\n        mean_squared_error(group[\"speed_actual\"], group[\"speed_base\"])\n    )\n    flow_rmse_lane_base = np.sqrt(\n        np.mean(\n            (\n                (group[\"flow_actual\"] - group[\"flow_base\"])\n                / 1.0\n            ) ** 2\n        )\n    )\n\n    score_model = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_model / 600)\n    )\n    score_base = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_base / 600)\n    )\n\n    rows.append({\n        \"regime\": regime,\n        \"rows\": len(group),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_baseline\": flow_rmse_lane_base,\n        \"flow_rmse_model\": flow_rmse_lane_model,\n        \"score_baseline\": score_base,\n        \"score_model\": score_model,\n    })\n\njan_results = pd.DataFrame(rows)\ndisplay(jan_results.round(4))\n\nprint(\"January baseline macro score:\",\n      round(jan_results[\"score_baseline\"].mean(), 6))\nprint(\"January residual-model macro score:\",\n      round(jan_results[\"score_model\"].mean(), 6))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:30:18.004799Z","iopub.execute_input":"2026-10-19T16:30:18.006625Z","iopub.status.idle":"2026-10-19T16:30:50.127408Z","shell.execute_reply.started":"2026-10-19T16:30:18.00657Z","shell.execute_reply":"2026-10-19T16:30:50.126477Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Inspect available lane-count metadata\nprint(\"Truth columns:\", truth.columns.tolist())\nprint(\"January feature columns:\", jan_features.columns.tolist())\n\nfor name in [\"metadata\", \"links\", \"link_metadata\", \"station_metadata\"]:\n    if name in globals():\n        obj = globals()[name]\n        print(f\"\\n{name}: {type(obj).__name__}\")\n        if hasattr(obj, \"columns\"):\n            print(obj.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:31:35.060336Z","iopub.execute_input":"2026-10-19T16:31:35.060834Z","iopub.status.idle":"2026-10-19T16:31:35.074746Z","shell.execute_reply.started":"2026-10-19T16:31:35.060803Z","shell.execute_reply":"2026-10-19T16:31:35.071776Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Recalculate January validation using the official lane-normalized metric\n\njan_eval_lanes = jan_eval.merge(\n    metadata[[\"link_id\", \"lanes\"]],\n    left_index=False,\n    right_index=False,\n    left_on=jan_features[\"link_id\"],\n    right_on=metadata[\"link_id\"],\n    how=\"left\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:10.357874Z","iopub.execute_input":"2026-10-19T16:32:10.358349Z","iopub.status.idle":"2026-10-19T16:32:10.596215Z","shell.execute_reply.started":"2026-10-19T16:32:10.358294Z","shell.execute_reply":"2026-10-19T16:32:10.595141Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Attach lane counts by link_id\njan_eval_lanes = jan_eval.copy()\njan_eval_lanes[\"link_id\"] = jan_features[\"link_id\"].to_numpy()\n\njan_eval_lanes = jan_eval_lanes.merge(\n    metadata[[\"link_id\", \"lanes\"]],\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nassert jan_eval_lanes[\"lanes\"].notna().all(), \"Missing lane counts\"\nassert (jan_eval_lanes[\"lanes\"] > 0).all(), \"Invalid lane counts\"\n\nrows = []\nfor regime, g in jan_eval_lanes.groupby(\"mask_regime\", observed=True):\n    speed_rmse_base = np.sqrt(\n        np.mean((g[\"speed_actual\"] - g[\"speed_base\"]) ** 2)\n    )\n    speed_rmse_model = np.sqrt(\n        np.mean((g[\"speed_actual\"] - g[\"speed_pred\"]) ** 2)\n    )\n\n    flow_rmse_base = np.sqrt(\n        np.mean(((g[\"flow_actual\"] - g[\"flow_base\"]) / g[\"lanes\"]) ** 2)\n    )\n    flow_rmse_model = np.sqrt(\n        np.mean(((g[\"flow_actual\"] - g[\"flow_pred\"]) / g[\"lanes\"]) ** 2)\n    )\n\n    score_base = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_base / 600)\n    )\n    score_model = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_model / 600)\n    )\n\n    rows.append({\n        \"regime\": regime,\n        \"rows\": len(g),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_lane_baseline\": flow_rmse_base,\n        \"flow_rmse_lane_model\": flow_rmse_model,\n        \"score_baseline\": score_base,\n        \"score_model\": score_model,\n    })\n\njan_official_results = pd.DataFrame(rows)\ndisplay(jan_official_results.round(4))\n\nprint(\n    \"January baseline macro score:\",\n    round(jan_official_results[\"score_baseline\"].mean(), 6)\n)\nprint(\n    \"January residual-model macro score:\",\n    round(jan_official_results[\"score_model\"].mean(), 6)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:16.707568Z","iopub.execute_input":"2026-10-19T16:32:16.707977Z","iopub.status.idle":"2026-10-19T16:32:17.123221Z","shell.execute_reply.started":"2026-10-19T16:32:16.707946Z","shell.execute_reply":"2026-10-19T16:32:17.122067Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# January temporal-holdout correction distribution\njan_eval_lanes[\"correction\"] = (\n    jan_eval_lanes[\"speed_pred\"] - jan_eval_lanes[\"speed_base\"]\n)\n\ndisplay(\n    jan_eval_lanes.groupby(\"mask_regime\", observed=True)\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        median_correction=(\"correction\", \"median\"),\n        correction_std=(\"correction\", \"std\"),\n        below_minus_30_pct=(\n            \"correction\", lambda x: 100 * (x < -30).mean()\n        ),\n        below_minus_60_pct=(\n            \"correction\", lambda x: 100 * (x < -60).mean()\n        ),\n    )\n    .round(3)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:32:54.792229Z","iopub.execute_input":"2026-10-19T16:32:54.792642Z","iopub.status.idle":"2026-10-19T16:32:54.953773Z","shell.execute_reply.started":"2026-10-19T16:32:54.792612Z","shell.execute_reply":"2026-10-19T16:32:54.952631Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Compare January holdout vs February vs April for R2 midday/evening\n# using the same lag-speed buckets\n\ndef correction_detail(frame, correction, period):\n    mask = frame[\"mask_regime\"].eq(\"R2\")\n    df = frame.loc[mask].copy()\n    df[\"correction\"] = np.asarray(correction)[mask.to_numpy()]\n\n    hour = df[\"timestamp\"].dt.hour\n    df[\"time_period\"] = pd.cut(\n        hour,\n        bins=[-1, 5, 9, 15, 19, 23],\n        labels=[\"Night\", \"Morning peak\", \"Midday\", \"Evening peak\", \"Late evening\"]\n    )\n\n    for col, out_col in [\n        (\"lag_speed_5\", \"lag5_band\"),\n        (\"lag_speed_15\", \"lag15_band\"),\n    ]:\n        df[out_col] = pd.cut(\n            df[col],\n            bins=[-np.inf, 40, 60, 80, np.inf],\n            labels=[\"<40\", \"40-60\", \"60-80\", \">80\"]\n        ).astype(\"object\").fillna(\"Missing\")\n\n    df[\"period\"] = period\n    return df\n\njan_r2_detail = correction_detail(\n    jan_features,\n    jan_eval_lanes[\"correction\"].to_numpy(),\n    \"January\"\n)\n\nfeb_r2_detail = correction_detail(\n    feb_diag,\n    feb_diag[\"correction\"].to_numpy(),\n    \"February\"\n)\n\napr_r2_detail = correction_detail(\n    private_features,\n    private_submission[\"speed_kmh\"].to_numpy()\n    - private_features[\"base_speed\"].to_numpy(),\n    \"April\"\n)\n\nall_detail = pd.concat(\n    [jan_r2_detail, feb_r2_detail, apr_r2_detail],\n    ignore_index=True\n)\n\ncomparison = (\n    all_detail.loc[\n        all_detail[\"time_period\"].isin([\"Midday\", \"Evening peak\"])\n    ]\n    .groupby(\n        [\"period\", \"time_period\", \"lag5_band\", \"lag15_band\"],\n        observed=True\n    )\n    .agg(\n        rows=(\"correction\", \"size\"),\n        mean_correction=(\"correction\", \"mean\"),\n        negative30_rate_pct=(\n            \"correction\", lambda x: 100 * (x < -30).mean()\n        ),\n    )\n    .reset_index()\n)\n\ndisplay(\n    comparison.loc[comparison[\"rows\"] >= 100]\n    .sort_values([\"time_period\", \"lag5_band\", \"lag15_band\", \"period\"])\n    .round(2)\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:37:23.017812Z","iopub.execute_input":"2026-10-19T16:37:23.018891Z","iopub.status.idle":"2026-10-19T16:37:23.818567Z","shell.execute_reply.started":"2026-10-19T16:37:23.018849Z","shell.execute_reply":"2026-10-19T16:37:23.816982Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\ndf = jan_eval_lanes.copy()\n\n# Add timestamp and time-of-day categories\ndf[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\ndf[\"hour\"] = df[\"timestamp\"].dt.hour\n\ndf[\"time_period\"] = pd.cut(\n    df[\"hour\"],\n    bins=[-1, 5, 9, 15, 19, 23],\n    labels=[\n        \"Night\",\n        \"Morning peak\",\n        \"Midday\",\n        \"Evening peak\",\n        \"Late evening\",\n    ],\n)\n\ndef calculate_metrics(g):\n    speed_actual = g[\"speed_actual\"].to_numpy()\n    speed_pred = g[\"speed_pred\"].to_numpy()\n    speed_base = g[\"speed_base\"].to_numpy()\n\n    flow_actual = g[\"flow_actual\"].to_numpy()\n    flow_pred = g[\"flow_pred\"].to_numpy()\n    flow_base = g[\"flow_base\"].to_numpy()\n    lanes = g[\"lanes\"].to_numpy()\n\n    speed_rmse_model = np.sqrt(np.mean((speed_actual - speed_pred) ** 2))\n    speed_rmse_base = np.sqrt(np.mean((speed_actual - speed_base) ** 2))\n\n    flow_rmse_lane_model = np.sqrt(\n        np.mean(((flow_actual - flow_pred) / lanes) ** 2)\n    )\n    flow_rmse_lane_base = np.sqrt(\n        np.mean(((flow_actual - flow_base) / lanes) ** 2)\n    )\n\n    model_score = (\n        0.54 * max(0, 1 - speed_rmse_model / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_model / 600)\n    )\n    baseline_score = (\n        0.54 * max(0, 1 - speed_rmse_base / 25)\n        + 0.46 * max(0, 1 - flow_rmse_lane_base / 600)\n    )\n\n    return pd.Series({\n        \"rows\": len(g),\n        \"speed_rmse_baseline\": speed_rmse_base,\n        \"speed_rmse_model\": speed_rmse_model,\n        \"flow_rmse_lane_baseline\": flow_rmse_lane_base,\n        \"flow_rmse_lane_model\": flow_rmse_lane_model,\n        \"baseline_score\": baseline_score,\n        \"model_score\": model_score,\n        \"score_gain\": model_score - baseline_score,\n    })\n\nresults = (\n    df.groupby([\"mask_regime\", \"time_period\"], observed=True)\n      .apply(calculate_metrics, include_groups=False)\n      .reset_index()\n      .sort_values([\"mask_regime\", \"time_period\"])\n)\n\ndisplay(results.round(4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:39:22.831774Z","iopub.execute_input":"2026-10-19T16:39:22.832671Z","iopub.status.idle":"2026-10-19T16:39:26.042165Z","shell.execute_reply.started":"2026-10-19T16:39:22.832628Z","shell.execute_reply":"2026-10-19T16:39:26.040211Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# Restore timestamp and link_id using the original row order\nr2_night = jan_eval_lanes.copy()\nr2_night[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\nr2_night[\"link_id\"] = jan_features[\"link_id\"].to_numpy()\n\nr2_night = r2_night.loc[\n    r2_night[\"mask_regime\"].eq(\"R2\")\n    & r2_night[\"timestamp\"].dt.hour.lt(6)\n].copy()\n\nfor name in [\"baseline\", \"model\"]:\n    speed_pred = (\n        r2_night[\"speed_base\"].to_numpy()\n        if name == \"baseline\"\n        else r2_night[\"speed_pred\"].to_numpy()\n    )\n    flow_pred = (\n        r2_night[\"flow_base\"].to_numpy()\n        if name == \"baseline\"\n        else r2_night[\"flow_pred\"].to_numpy()\n    )\n\n    speed_rmse = np.sqrt(\n        np.mean((r2_night[\"speed_actual\"].to_numpy() - speed_pred) ** 2)\n    )\n    flow_rmse_lane = np.sqrt(\n        np.mean(\n            (\n                (r2_night[\"flow_actual\"].to_numpy() - flow_pred)\n                / r2_night[\"lanes\"].to_numpy()\n            ) ** 2\n        )\n    )\n\n    print(\n        f\"{name:8s} | speed RMSE: {speed_rmse:.4f} | \"\n        f\"flow RMSE/lane: {flow_rmse_lane:.4f}\"\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:46:30.470285Z","iopub.execute_input":"2026-10-19T16:46:30.470769Z","iopub.status.idle":"2026-10-19T16:46:33.866191Z","shell.execute_reply.started":"2026-10-19T16:46:30.470712Z","shell.execute_reply":"2026-10-19T16:46:33.864724Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport numpy as np\nimport pandas as pd\n\ntest = jan_eval_lanes.copy()\ntest[\"timestamp\"] = jan_features[\"timestamp\"].to_numpy()\n\n# Candidate: use baseline predictions for R2 from 00:00–05:59\nfallback = (\n    test[\"mask_regime\"].eq(\"R2\")\n    & test[\"timestamp\"].dt.hour.lt(6)\n)\n\nspeed_candidate = test[\"speed_pred\"].to_numpy().copy()\nflow_candidate = test[\"flow_pred\"].to_numpy().copy()\n\nspeed_candidate[fallback.to_numpy()] = test.loc[fallback, \"speed_base\"].to_numpy()\nflow_candidate[fallback.to_numpy()] = test.loc[fallback, \"flow_base\"].to_numpy()\n\ndef official_score(speed_pred, flow_pred, data):\n    scores = []\n\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        mask = data[\"mask_regime\"].eq(regime).to_numpy()\n        g = data.loc[mask]\n\n        speed_rmse = np.sqrt(np.mean(\n            (g[\"speed_actual\"].to_numpy() - speed_pred[mask]) ** 2\n        ))\n        flow_rmse_lane = np.sqrt(np.mean(\n            (\n                (g[\"flow_actual\"].to_numpy() - flow_pred[mask])\n                / g[\"lanes\"].to_numpy()\n            ) ** 2\n        ))\n\n        score = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n        )\n        scores.append(score)\n        print(\n            f\"{regime}: score={score:.6f}, \"\n            f\"speed_RMSE={speed_rmse:.4f}, \"\n            f\"flow_RMSE/lane={flow_rmse_lane:.4f}\"\n        )\n\n    return np.mean(scores)\n\nprint(\"CURRENT MODEL\")\ncurrent_score = official_score(\n    test[\"speed_pred\"].to_numpy(),\n    test[\"flow_pred\"].to_numpy(),\n    test\n)\n\nprint(\"\\nR2 NIGHT BASELINE FALLBACK\")\ncandidate_score = official_score(\n    speed_candidate, flow_candidate, test\n)\n\nprint(f\"\\nCurrent macro score:   {current_score:.6f}\")\nprint(f\"Candidate macro score: {candidate_score:.6f}\")\nprint(f\"Score difference:      {candidate_score - current_score:+.6f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:47:08.317836Z","iopub.execute_input":"2026-10-19T16:47:08.318321Z","iopub.status.idle":"2026-10-19T16:47:11.919035Z","shell.execute_reply.started":"2026-10-19T16:47:08.31829Z","shell.execute_reply":"2026-10-19T16:47:11.917939Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport os\nimport numpy as np\nimport pandas as pd\n\n# 1. Verify required objects and submission file\nrequired = [\n    \"jan_eval_lanes\", \"jan_features\",\n    \"speed_model_original_style\", \"flow_model_original_style\",\n    \"FEATURES\",\n]\nmissing = [name for name in required if name not in globals()]\nif missing:\n    raise NameError(f\"Missing required notebook objects: {missing}\")\n\nsubmission_path = \"/kaggle/working/private_submission.csv\"\nif not os.path.isfile(submission_path):\n    raise FileNotFoundError(f\"Submission file not found: {submission_path}\")\n\nsubmission = pd.read_csv(submission_path)\n\n# 2. Verify January evaluation data\ndata = jan_eval_lanes.copy()\nif len(data) != len(jan_features):\n    raise ValueError(\n        f\"Row mismatch: jan_eval_lanes={len(data)}, \"\n        f\"jan_features={len(jan_features)}\"\n    )\n\ndata[\"timestamp\"] = pd.to_datetime(\n    jan_features[\"timestamp\"].to_numpy(), utc=True\n)\n\nrequired_cols = [\n    \"mask_regime\", \"speed_actual\", \"flow_actual\",\n    \"speed_pred\", \"flow_pred\", \"speed_base\", \"flow_base\", \"lanes\",\n]\nmissing_cols = [c for c in required_cols if c not in data.columns]\nif missing_cols:\n    raise KeyError(f\"Missing evaluation columns: {missing_cols}\")\n\nif data[required_cols].isna().any().any():\n    raise ValueError(\"Evaluation data contains missing values.\")\nif (data[\"lanes\"] <= 0).any():\n    raise ValueError(\"Invalid lane counts.\")\nif not set(data[\"mask_regime\"].unique()).issubset({\"R1\", \"R2\", \"R3\"}):\n    raise ValueError(\"Unexpected mask regime values.\")\n\n# 3. Recompute the original and candidate official macro scores\ndef score_by_regime(frame, speed_pred, flow_pred):\n    output = {}\n    for regime in [\"R1\", \"R2\", \"R3\"]:\n        mask = frame[\"mask_regime\"].eq(regime).to_numpy()\n        g = frame.loc[mask]\n\n        speed_rmse = np.sqrt(np.mean(\n            (g[\"speed_actual\"].to_numpy() - speed_pred[mask]) ** 2\n        ))\n        flow_rmse_lane = np.sqrt(np.mean(\n            (\n                (g[\"flow_actual\"].to_numpy() - flow_pred[mask])\n                / g[\"lanes\"].to_numpy()\n            ) ** 2\n        ))\n\n        output[regime] = (\n            0.54 * max(0, 1 - speed_rmse / 25)\n            + 0.46 * max(0, 1 - flow_rmse_lane / 600)\n        )\n    return output\n\ncurrent_speed = data[\"speed_pred\"].to_numpy(copy=True)\ncurrent_flow = data[\"flow_pred\"].to_numpy(copy=True)\n\nfallback_mask = (\n    data[\"mask_regime\"].eq(\"R2\")\n    & data[\"timestamp\"].dt.hour.lt(6)\n).to_numpy()\n\ncandidate_speed = current_speed.copy()\ncandidate_flow = current_flow.copy()\n\ncandidate_speed[fallback_mask] = data.loc[\n    fallback_mask, \"speed_base\"\n].to_numpy()\ncandidate_flow[fallback_mask] = data.loc[\n    fallback_mask, \"flow_base\"\n].to_numpy()\n\ncurrent_scores = score_by_regime(data, current_speed, current_flow)\ncandidate_scores = score_by_regime(data, candidate_speed, candidate_flow)\n\nprint(\"JANUARY VALIDATION\")\nprint(f\"Rows evaluated: {len(data):,}\")\nprint(f\"Fallback rows:  {fallback_mask.sum():,}\")\nprint(f\"Fallback affects only R2, hours 00:00–05:59: \"\n      f\"{data.loc[fallback_mask, 'mask_regime'].eq('R2').all() and data.loc[fallback_mask, 'timestamp'].dt.hour.lt(6).all()}\")\n\nprint(\"\\nRegime scores\")\nfor regime in [\"R1\", \"R2\", \"R3\"]:\n    print(\n        f\"{regime}: current={current_scores[regime]:.6f}, \"\n        f\"candidate={candidate_scores[regime]:.6f}, \"\n        f\"delta={candidate_scores[regime] - current_scores[regime]:+.6f}\"\n    )\n\ncurrent_macro = np.mean(list(current_scores.values()))\ncandidate_macro = np.mean(list(candidate_scores.values()))\n\nprint(f\"\\nCurrent macro score:   {current_macro:.6f}\")\nprint(f\"Candidate macro score: {candidate_macro:.6f}\")\nprint(f\"Macro score change:    {candidate_macro - current_macro:+.6f}\")\n\nprint(\"\\nEXISTING SUBMISSION — READ-ONLY CHECK\")\nprint(f\"Path: {submission_path}\")\nprint(f\"Rows: {len(submission):,}\")\nprint(f\"Columns: {submission.columns.tolist()}\")\nprint(f\"Missing values: {int(submission.isna().sum().sum())}\")\nprint(f\"Speed range: {submission['speed_kmh'].min():.3f} to \"\n      f\"{submission['speed_kmh'].max():.3f}\")\nprint(f\"Flow range: {submission['flow_vph'].min():.3f} to \"\n      f\"{submission['flow_vph'].max():.3f}\")\n\nassert np.isfinite(current_macro) and np.isfinite(candidate_macro)\nassert submission[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert submission[\"speed_kmh\"].between(0, 160).all()\nassert (submission[\"flow_vph\"] >= 0).all()\n\nprint(\"\\nPASS: validation completed; existing submission was not modified.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T16:55:06.628481Z","iopub.execute_input":"2026-10-19T16:55:06.629172Z","iopub.status.idle":"2026-10-19T16:55:13.002646Z","shell.execute_reply.started":"2026-10-19T16:55:06.629129Z","shell.execute_reply":"2026-10-19T16:55:13.001524Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nroot = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\ntemplate_path = (\n    root / \"task1\" / \"D7_I405_S\" /\n    \"private\" / \"sample_submission_state.csv\"\n)\nsubmission_path = Path(\"/kaggle/working/private_submission.csv\")\n\ntemplate = pd.read_csv(template_path)\nsubmission = pd.read_csv(submission_path)\n\nprint(\"Template rows/columns:\", template.shape)\nprint(\"Submission rows/columns:\", submission.shape)\n\nkey_cols = [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n\nprint(\"\\nTemplate columns:\", template.columns.tolist())\nprint(\"Submission columns:\", submission.columns.tolist())\n\n# Compare each key column independently\nfor col in key_cols:\n    if col not in template.columns or col not in submission.columns:\n        print(f\"\\n{col}: MISSING FROM ONE FILE\")\n        continue\n\n    a = template[col].astype(\"string\").fillna(\"<NA>\").reset_index(drop=True)\n    b = submission[col].astype(\"string\").fillna(\"<NA>\").reset_index(drop=True)\n\n    same = a.equals(b)\n    mismatch = a.ne(b)\n\n    print(f\"\\n{col}: exact row-by-row match = {same}\")\n    print(\"Template first values:\", a.head(3).tolist())\n    print(\"Submission first values:\", b.head(3).tolist())\n\n    if not same:\n        print(\"Mismatched row count:\", int(mismatch.sum()))\n        print(\"First mismatches:\")\n        print(pd.DataFrame({\n            \"row\": mismatch[mismatch].index[:5],\n            \"template\": a[mismatch].head(5).to_list(),\n            \"submission\": b[mismatch].head(5).to_list(),\n        }).to_string(index=False))\n\n# Check duplicate keys\nprint(\"\\nDuplicate template keys:\", int(template.duplicated(key_cols).sum()))\nprint(\"Duplicate submission keys:\", int(submission.duplicated(key_cols).sum()))\n\n# Check whether the same keys exist, regardless of row order\ntemplate_keys = set(map(tuple, template[key_cols].astype(str).to_numpy()))\nsubmission_keys = set(map(tuple, submission[key_cols].astype(str).to_numpy()))\n\nprint(\"Keys only in template:\", len(template_keys - submission_keys))\nprint(\"Keys only in submission:\", len(submission_keys - template_keys))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:02:28.183112Z","iopub.execute_input":"2026-10-19T17:02:28.183435Z","iopub.status.idle":"2026-10-19T17:02:30.51542Z","shell.execute_reply.started":"2026-10-19T17:02:28.183411Z","shell.execute_reply":"2026-10-19T17:02:30.513838Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\nroot = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\ntemplate_path = (\n    root / \"task1\" / \"D7_I405_S\" /\n    \"private\" / \"sample_submission_state.csv\"\n)\nsubmission_path = Path(\"/kaggle/working/private_submission.csv\")\n\ntemplate = pd.read_csv(template_path)\nsubmission = pd.read_csv(submission_path)\n\nkey_cols = [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\nassert list(template.columns) == list(submission.columns), \"Column mismatch.\"\nassert len(template) == len(submission), \"Row-count mismatch.\"\n\n# Normalize timestamp representations to UTC before comparison.\ntemplate_ts = pd.to_datetime(template[\"timestamp\"], utc=True)\nsubmission_ts = pd.to_datetime(submission[\"timestamp\"], utc=True)\n\nassert template_ts.equals(submission_ts), (\n    \"Timestamp values or row order genuinely differ.\"\n)\n\n# Compare all other key columns in row order.\nother_keys = [c for c in key_cols if c != \"timestamp\"]\nfor col in other_keys:\n    a = template[col].astype(\"string\").fillna(\"<NA>\").reset_index(drop=True)\n    b = submission[col].astype(\"string\").fillna(\"<NA>\").reset_index(drop=True)\n    assert a.equals(b), f\"Key mismatch in {col}.\"\n\n# Prediction integrity.\npred_cols = [\"speed_kmh\", \"flow_vph\"]\npred = submission[pred_cols].to_numpy(dtype=float)\n\nassert np.isfinite(pred).all(), \"Non-finite predictions.\"\nassert submission[\"speed_kmh\"].between(0, 160).all(), \"Invalid speeds.\"\nassert (submission[\"flow_vph\"] >= 0).all(), \"Negative flows.\"\nassert not submission.duplicated(key_cols).any(), \"Duplicate submission keys.\"\n\nprint(\"PASS: columns and row count match the official template.\")\nprint(\"PASS: timestamps match after UTC normalization.\")\nprint(\"PASS: all other keys match in exact row order.\")\nprint(\"PASS: predictions are finite and within valid ranges.\")\nprint(f\"Final submission: {submission_path}\")\nprint(f\"Rows: {len(submission):,}\")\nprint(f\"File size: {submission_path.stat().st_size:,} bytes\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:02:56.882966Z","iopub.execute_input":"2026-10-19T17:02:56.883385Z","iopub.status.idle":"2026-10-19T17:02:57.821125Z","shell.execute_reply.started":"2026-10-19T17:02:56.883357Z","shell.execute_reply":"2026-10-19T17:02:57.819739Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\nroot = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nkey_path = root / \"submission_key.csv\"\n\nkey = pd.read_csv(key_path, low_memory=False)\n\nprint(\"Rows:\", len(key))\nprint(\"Columns:\", key.columns.tolist())\nprint(\"\\nRows per task:\")\nprint(key.groupby(\"task\", dropna=False).size().to_string())\n\nprint(\"\\nMissing values by task:\")\nfor task, group in key.groupby(\"task\", dropna=False):\n    print(f\"\\nTask = {task!r}, rows = {len(group):,}\")\n    for col in [\n        \"split\", \"panel\", \"timestamp\", \"station_id\",\n        \"link_id\", \"mask_regime\", \"window_id\",\n        \"departure_time\", \"path_id\",\n    ]:\n        if col in group.columns:\n            print(f\"  {col}: {group[col].isna().sum():,} missing\")\n\nprint(\"\\nSample rows with missing timestamps:\")\nprint(key.loc[key[\"timestamp\"].isna()].groupby(\"task\").size().to_string())\nprint(key.loc[key[\"timestamp\"].isna()].head(5).to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:13:47.799526Z","iopub.execute_input":"2026-10-19T17:13:47.800084Z","iopub.status.idle":"2026-10-19T17:14:10.288156Z","shell.execute_reply.started":"2026-10-19T17:13:47.800048Z","shell.execute_reply":"2026-10-19T17:14:10.286435Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nWORK = Path(\"/kaggle/working\")\n\nkey = pd.read_csv(ROOT / \"submission_key.csv\", low_memory=False)\nstate = key.loc[key[\"task\"].eq(\"state\")].copy()\n\nprint(\"=== 1. Existing prediction artifacts ===\")\nfor p in sorted(WORK.glob(\"*.csv\")):\n    print(f\"{p.name:45s} {p.stat().st_size:>12,} bytes\")\n\nprint(\"\\n=== 2. Official Task 1 coverage required ===\")\nprint(\"Total state rows:\", f\"{len(state):,}\")\nprint(\"\\nRows by split and panel:\")\nprint(\n    state.groupby([\"split\", \"panel\"], observed=True)\n    .size()\n    .unstack(fill_value=0)\n    .to_string()\n)\n\n# Load the two prediction files already used in our pipeline.\nmarch_path = WORK / \"march_validation_predictions.csv\"\napril_path = WORK / \"private_submission.csv\"\n\npred_frames = []\nfor path, split in [\n    (march_path, \"validation\"),\n    (april_path, \"private\"),\n]:\n    if not path.exists():\n        print(f\"\\nMISSING FILE: {path}\")\n        continue\n\n    df = pd.read_csv(path, low_memory=False)\n    df[\"split\"] = split\n    pred_frames.append(df)\n\nif not pred_frames:\n    raise FileNotFoundError(\"Neither existing prediction file was found.\")\n\npred = pd.concat(pred_frames, ignore_index=True)\n\nkeys = [\n    \"split\", \"panel\", \"timestamp\",\n    \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nfor df in [state, pred]:\n    for col in [\"split\", \"panel\", \"station_id\", \"link_id\", \"mask_regime\"]:\n        df[col] = df[col].astype(\"string\").str.strip()\n    df[\"_ts\"] = pd.to_datetime(df[\"timestamp\"], utc=True, errors=\"coerce\")\n\nif state[\"_ts\"].isna().any():\n    raise ValueError(\"Official state key has invalid timestamps.\")\nif pred[\"_ts\"].isna().any():\n    raise ValueError(\"Prediction file has invalid timestamps.\")\n\nmatch_keys = [\n    \"split\", \"panel\", \"_ts\",\n    \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nif pred.duplicated(match_keys).any():\n    raise ValueError(\"Duplicate keys found in prediction artifacts.\")\n\ncoverage = state[match_keys].merge(\n    pred[match_keys],\n    on=match_keys,\n    how=\"left\",\n    indicator=True,\n    validate=\"one_to_one\"\n)\n\nmissing_keys = coverage.loc[coverage[\"_merge\"].eq(\"left_only\"), match_keys]\n\nprint(\"\\n=== 3. Missing prediction coverage ===\")\nprint(\"Matched official state rows:\", f\"{len(coverage)-len(missing_keys):,}\")\nprint(\"Missing official state rows:\", f\"{len(missing_keys):,}\")\n\nif missing_keys.empty:\n    print(\"All state rows are covered by these artifacts.\")\nelse:\n    missing_summary = (\n        missing_keys.groupby([\"split\", \"panel\"], observed=True)\n        .size()\n        .sort_values(ascending=False)\n    )\n    print(\"\\nMissing rows by split and panel:\")\n    print(missing_summary.to_string())\n\nprint(\"\\n=== 4. Existing prediction coverage ===\")\nprint(\n    pred.groupby([\"split\", \"panel\"], observed=True)\n    .size()\n    .sort_values(ascending=False)\n    .to_string()\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:29:41.325473Z","iopub.execute_input":"2026-10-19T17:29:41.326568Z","iopub.status.idle":"2026-10-19T17:30:30.574232Z","shell.execute_reply.started":"2026-10-19T17:29:41.326511Z","shell.execute_reply":"2026-10-19T17:30:30.573176Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nWORK = Path(\"/kaggle/working\")\n\n# 1. Inspect the existing audits\nfor name in [\n    \"stage2_label_coverage_audit.csv\",\n    \"stage2_panel_readiness_audit.csv\",\n]:\n    path = WORK / name\n    print(f\"\\n{'=' * 20} {name} {'=' * 20}\")\n    if path.exists():\n        df = pd.read_csv(path)\n        print(\"Shape:\", df.shape)\n        print(\"Columns:\", df.columns.tolist())\n        print(df.to_string(index=False))\n    else:\n        print(\"Not found:\", path)\n\n# 2. Inspect input folder structure for reusable artifacts\nprint(\"\\n================ INPUT FILE INVENTORY ================\")\nfor folder in [\n    ROOT / \"task1\",\n    ROOT / \"corridors\",\n]:\n    print(f\"\\nFolder: {folder}\")\n    if folder.exists():\n        for path in sorted(folder.iterdir()):\n            print(path.name, \"[directory]\" if path.is_dir() else f\"[{path.stat().st_size:,} bytes]\")\n\n# 3. Check common working-directory model and prediction artifacts\nprint(\"\\n================ WORKING ARTIFACTS ================\")\nfor pattern in [\"*.pkl\", \"*.joblib\", \"*.parquet\", \"*.csv\", \"*.ipynb\"]:\n    paths = sorted(WORK.glob(pattern))\n    print(f\"\\n{pattern}: {len(paths)} file(s)\")\n    for path in paths[:40]:\n        print(\" \", path.name, f\"({path.stat().st_size:,} bytes)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:33:33.622801Z","iopub.execute_input":"2026-10-19T17:33:33.624264Z","iopub.status.idle":"2026-10-19T17:33:33.692271Z","shell.execute_reply.started":"2026-10-19T17:33:33.624219Z","shell.execute_reply":"2026-10-19T17:33:33.691047Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanels = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\nfor panel in panels:\n    print(f\"\\n{'=' * 18} {panel} {'=' * 18}\")\n    base = ROOT / \"corridors\" / panel\n    task_base = ROOT / \"task1\" / panel\n\n    for split in [\"train\", \"validation\", \"private\"]:\n        folder = base / split\n        print(f\"\\n{split}:\")\n\n        if not folder.exists():\n            print(\"  Missing directory:\", folder)\n            continue\n\n        for subfolder in [\n            \"mainline_states\",\n            \"mainline_states_masked\",\n        ]:\n            p = folder / subfolder\n            if not p.exists():\n                continue\n\n            files = sorted(p.glob(\"*.parquet\"))\n            print(f\"  {subfolder}: {len(files)} parquet files\")\n\n            if files:\n                sample = pd.read_parquet(files[0])\n                print(\"    Sample file:\", files[0].name)\n                print(\"    Columns:\", sample.columns.tolist())\n                print(\"    Rows in sample:\", len(sample))\n\n    print(\"\\nTask 1 templates:\")\n    for split in [\"validation\", \"private\"]:\n        p = task_base / split / \"sample_submission_state.csv\"\n        if p.exists():\n            t = pd.read_csv(p, nrows=3)\n            print(f\"  {split}: columns={t.columns.tolist()}\")\n            print(\"    Example rows:\")\n            print(t.to_string(index=False))\n        else:\n            print(f\"  {split}: template not found\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:34:40.235221Z","iopub.execute_input":"2026-10-19T17:34:40.235642Z","iopub.status.idle":"2026-10-19T17:34:40.825005Z","shell.execute_reply.started":"2026-10-19T17:34:40.235612Z","shell.execute_reply":"2026-10-19T17:34:40.8237Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom pathlib import Path\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanels = [\n    \"D12_I405_N\", \"D12_I405_S\",\n    \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\",\n    \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\nfor panel in panels:\n    print(f\"\\n{'=' * 15} {panel} {'=' * 15}\")\n    base = ROOT / \"corridors\" / panel\n\n    for split, folders in [\n        (\"train\", [\"mainline_states\", \"mainline_states_masked\"]),\n        (\"validation\", [\"mainline_states_masked\"]),\n        (\"private\", [\"mainline_states_masked\"]),\n    ]:\n        for folder_name in folders:\n            folder = base / split / folder_name\n\n            if not folder.exists():\n                print(f\"{split}/{folder_name}: DIRECTORY MISSING\")\n                continue\n\n            # Recursive search handles partitioned/nested Parquet directories.\n            files = sorted(folder.rglob(\"*.parquet\"))\n            print(f\"{split}/{folder_name}: {len(files)} Parquet files\")\n\n            if files:\n                sample_path = files[0]\n                sample = pd.read_parquet(sample_path)\n                print(\"  Sample:\", sample_path.relative_to(ROOT))\n                print(\"  Columns:\", sample.columns.tolist())\n                print(\"  Sample rows:\", len(sample))\n\n                # Show a few paths to identify the actual directory structure.\n                for p in files[:3]:\n                    print(\"  File:\", p.relative_to(ROOT))\n\n    task_base = ROOT / \"task1\" / panel\n    for split in [\"validation\", \"private\"]:\n        path = task_base / split / \"sample_submission_state.csv\"\n        if path.exists():\n            template = pd.read_csv(path)\n            print(\n                f\"Task template {split}: {len(template):,} rows, \"\n                f\"{template['timestamp'].nunique():,} timestamps\"\n            )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:37:14.608792Z","iopub.execute_input":"2026-10-19T17:37:14.609295Z","iopub.status.idle":"2026-10-19T17:37:28.456305Z","shell.execute_reply.started":"2026-10-19T17:37:14.609266Z","shell.execute_reply":"2026-10-19T17:37:28.45503Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nfor panel in [\"D7_I405_S\", \"D12_I405_N\"]:\n    path = ROOT / \"corridors\" / panel / \"network\" / \"links.csv\"\n    df = pd.read_csv(path)\n\n    print(f\"\\n{panel}: {df.shape}\")\n    print(\"Columns:\", df.columns.tolist())\n    print(df.head(3).to_string(index=False))\n\n    del df","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:58:26.121375Z","iopub.execute_input":"2026-10-19T17:58:26.121767Z","iopub.status.idle":"2026-10-19T17:58:26.157427Z","shell.execute_reply.started":"2026-10-19T17:58:26.121739Z","shell.execute_reply":"2026-10-19T17:58:26.156477Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I405_N\"\nbase = ROOT / \"corridors\" / panel\n\ntruth_file = next(\n    (base / \"train\" / \"mainline_states\").rglob(\"*.parquet\")\n)\nmasked_file = next(\n    (base / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\ntruth_sample = pd.read_parquet(truth_file)\nmasked_sample = pd.read_parquet(masked_file)\n\nprint(\"Truth file:\", truth_file.relative_to(ROOT))\nprint(\"Truth shape:\", truth_sample.shape)\nprint(\"Truth columns:\", truth_sample.columns.tolist())\n\nprint(\"\\nMasked file:\", masked_file.relative_to(ROOT))\nprint(\"Masked shape:\", masked_sample.shape)\nprint(\"Masked columns:\", masked_sample.columns.tolist())\n\nprint(\"\\nTruth eligible:\", int(truth_sample[\"is_score_eligible\"].sum()))\nprint(\"Masked regimes:\", masked_sample[\"mask_regime\"].value_counts().to_dict())\n\ndel truth_sample, masked_sample\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T17:59:20.254642Z","iopub.execute_input":"2026-10-19T17:59:20.255111Z","iopub.status.idle":"2026-10-19T17:59:21.458149Z","shell.execute_reply.started":"2026-10-19T17:59:20.255079Z","shell.execute_reply":"2026-10-19T17:59:21.457173Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nWORK = Path(\"/kaggle/working\")\npanel = \"D12_I405_N\"\n\n# Panel-specific link metadata\nlinks_next = pd.read_csv(\n    ROOT / \"corridors\" / panel / \"network\" / \"links.csv\"\n)\n\n# Official prediction templates\nval_template = pd.read_csv(\n    ROOT / \"task1\" / panel / \"validation\" / \"sample_submission_state.csv\"\n)\npriv_template = pd.read_csv(\n    ROOT / \"task1\" / panel / \"private\" / \"sample_submission_state.csv\"\n)\n\nprint(\"Panel:\", panel)\nprint(\"Links:\", links_next.shape)\nprint(\"Validation template:\", val_template.shape)\nprint(\"Private template:\", priv_template.shape)\nprint(\"Expected total:\", len(val_template) + len(priv_template))\nprint(\"Existing checkpoint:\", len(predictions))\n\nassert links_next[\"link_id\"].is_unique\nassert not val_template.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any()\nassert not priv_template.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any()\n\nprint(\"Template checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:04:24.19974Z","iopub.execute_input":"2026-10-19T18:04:24.200312Z","iopub.status.idle":"2026-10-19T18:04:25.127199Z","shell.execute_reply.started":"2026-10-19T18:04:24.200271Z","shell.execute_reply":"2026-10-19T18:04:25.125723Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I405_N\"\ntruth_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states\"\n\nneeded_cols = [\n    \"timestamp\", \"station_id\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"is_score_eligible\",\n]\n\nfiles = sorted(truth_dir.rglob(\"*.parquet\"))\nselected = [\n    p for p in files\n    if any(month in str(p) for month in [\"year_month=2030-12\", \"year_month=2031-01\"])\n]\n\nprint(\"Selected files:\", len(selected))\n\nparts = []\nfor i, path in enumerate(selected, 1):\n    df = pd.read_parquet(path, columns=needed_cols)\n    df = df.loc[df[\"is_score_eligible\"].eq(True)]\n    parts.append(df.drop(columns=\"is_score_eligible\"))\n\n    del df\n    if i % 10 == 0:\n        print(f\"Loaded {i}/{len(selected)} files\")\n\nhistory_next = pd.concat(parts, ignore_index=True)\ndel parts\ngc.collect()\n\nhistory_next[\"timestamp\"] = pd.to_datetime(\n    history_next[\"timestamp\"], utc=True\n)\n\nprint(\"History rows:\", len(history_next))\nprint(\"Date range:\", history_next[\"timestamp\"].min(),\n      \"to\", history_next[\"timestamp\"].max())\nprint(\"Memory (GiB):\",\n      round(history_next.memory_usage(deep=True).sum() / 1024**3, 2))\n\nprint(\"Available RAM check:\")\nwith open(\"/proc/meminfo\") as f:\n    available_kib = int(\n        next(line.split()[1] for line in f\n             if line.startswith(\"MemAvailable:\"))\n    )\nprint(round(available_kib / 1024**2, 2), \"GiB\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:07:11.124467Z","iopub.execute_input":"2026-10-19T18:07:11.124999Z","iopub.status.idle":"2026-10-19T18:07:15.239227Z","shell.execute_reply.started":"2026-10-19T18:07:11.124964Z","shell.execute_reply":"2026-10-19T18:07:15.237883Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I405_N\"\nmasked_dir = ROOT / \"corridors\" / panel / \"train\" / \"mainline_states_masked\"\n\nneeded_cols = [\n    \"timestamp\", \"station_id\", \"link_id\",\n    \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\",\n]\n\nfiles = sorted(masked_dir.rglob(\"*.parquet\"))\nparts = []\n\nfor i, path in enumerate(files, 1):\n    df = pd.read_parquet(path, columns=needed_cols)\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n    # Filter by actual timestamps, not directory names.\n    keep = (\n        ((ts >= \"2030-12-01\") & (ts < \"2031-02-01\"))\n        & df[\"is_observed\"].eq(True)\n    )\n    df = df.loc[keep].copy()\n\n    if not df.empty:\n        df = df.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\",\n        })\n        parts.append(df.drop(columns=\"is_observed\"))\n\n    del df, ts, keep\n\n    if i % 25 == 0:\n        gc.collect()\n        print(f\"Scanned {i}/{len(files)} files\")\n\nif not parts:\n    raise ValueError(\"No observed masked rows found for Dec 2030–Jan 2031.\")\n\nmasked_next = pd.concat(parts, ignore_index=True)\ndel parts\ngc.collect()\n\nmasked_next[\"timestamp\"] = pd.to_datetime(\n    masked_next[\"timestamp\"], utc=True\n)\n\nprint(\"Masked lookup rows:\", len(masked_next))\nprint(\"Date range:\", masked_next[\"timestamp\"].min(),\n      \"to\", masked_next[\"timestamp\"].max())\nprint(\"Regimes:\", masked_next[\"mask_regime\"].value_counts().to_dict())\nprint(\"Memory (GiB):\",\n      round(masked_next.memory_usage(deep=True).sum() / 1024**3, 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:09:16.764011Z","iopub.execute_input":"2026-10-19T18:09:16.765226Z","iopub.status.idle":"2026-10-19T18:09:34.426762Z","shell.execute_reply.started":"2026-10-19T18:09:16.765177Z","shell.execute_reply":"2026-10-19T18:09:34.425258Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"KEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nfor name, df in [\n    (\"history_next\", history_next),\n    (\"masked_next\", masked_next),\n]:\n    print(f\"\\n{name}:\")\n    print(\"Rows:\", len(df))\n    print(\"Duplicate keys:\", int(df.duplicated(KEYS).sum()))\n    print(\"Null keys:\", int(df[KEYS].isna().any(axis=1).sum()))\n    print(\"Unique links:\", df[\"link_id\"].nunique())\n    print(\"Unique stations:\", df[\"station_id\"].nunique())\n\nprint(\"\\nTarget templates:\")\nprint(\"Validation:\", len(val_template))\nprint(\"Private:\", len(priv_template))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:12:26.960924Z","iopub.execute_input":"2026-10-19T18:12:26.961447Z","iopub.status.idle":"2026-10-19T18:12:28.22814Z","shell.execute_reply.started":"2026-10-19T18:12:26.961414Z","shell.execute_reply":"2026-10-19T18:12:28.226791Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport gc\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\n# 1. December history only: strictly before January.\ndec_history = history_next.loc[\n    history_next[\"timestamp\"] < pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\ndec_history[\"weekday\"] = dec_history[\"timestamp\"].dt.dayofweek\ndec_history[\"minute_of_day\"] = (\n    dec_history[\"timestamp\"].dt.hour * 60\n    + dec_history[\"timestamp\"].dt.minute\n)\n\n# 2. Build baseline profiles from December.\nprofile_min = (\n    dec_history.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"], observed=True\n    )[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\nprofile_week = (\n    dec_history.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\nprofile_link = (\n    dec_history.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean()\n    .reset_index()\n)\n\n# 3. January eligible labels with their assigned mask regimes.\njan_labels = history_next.loc[\n    history_next[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\njan_labels = jan_labels.merge(\n    masked_next[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\",\n)\n\njan_labels[\"weekday\"] = jan_labels[\"timestamp\"].dt.dayofweek\njan_labels[\"minute_of_day\"] = (\n    jan_labels[\"timestamp\"].dt.hour * 60\n    + jan_labels[\"timestamp\"].dt.minute\n)\n\n# 4. Attach baseline, with link-wide fallback.\njan_features = jan_labels.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    suffixes=(\"\", \"_profile\"),\n    validate=\"many_to_one\",\n)\n\nfor col in VALUE_COLS:\n    jan_features = jan_features.merge(\n        profile_week.rename(columns={col: f\"{col}_week\"})[\n            [\"link_id\", \"weekday\", f\"{col}_week\"]\n        ],\n        on=[\"link_id\", \"weekday\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    jan_features = jan_features.merge(\n        profile_link.rename(columns={col: f\"{col}_link\"})[\n            [\"link_id\", f\"{col}_link\"]\n        ],\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    jan_features[col] = (\n        jan_features[col]\n        .fillna(jan_features[f\"{col}_week\"])\n        .fillna(jan_features[f\"{col}_link\"])\n    )\n\njan_features = jan_features.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\",\n})\njan_features[\"base_speed\"] = jan_features[\"target_speed\"]\njan_features[\"base_flow\"] = jan_features[\"target_flow\"]\n\n# 5. Add masked lag values at t-5, t-15, t-60, t-1440 minutes.\nlag_source = masked_next[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source.copy()\n    lag[\"timestamp\"] = lag[\"timestamp\"] + pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\",\n    })\n    jan_features = jan_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n    del lag\n    gc.collect()\n\n# 6. Time features and panel-local categorical encodings.\nts = jan_features[\"timestamp\"]\nweekday = ts.dt.dayofweek.to_numpy()\nminute = ts.dt.hour.to_numpy() * 60 + ts.dt.minute.to_numpy()\n\njan_features[\"weekday\"] = weekday\njan_features[\"minute_of_day\"] = minute\njan_features[\"tod_sin\"] = np.sin(2 * np.pi * minute / 1440)\njan_features[\"tod_cos\"] = np.cos(2 * np.pi * minute / 1440)\njan_features[\"weekday_sin\"] = np.sin(2 * np.pi * weekday / 7)\njan_features[\"weekday_cos\"] = np.cos(2 * np.pi * weekday / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    jan_features[f\"{col}_code\"] = pd.Categorical(\n        jan_features[col],\n        categories=sorted(jan_features[col].dropna().unique()),\n    ).codes\n\nprint(\"January training rows:\", len(jan_features))\nprint(\"Missing baselines:\", int(\n    jan_features[[\"base_speed\", \"base_flow\"]].isna().any(axis=1).sum()\n))\nprint(\"Missing lag values:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].isna().any(axis=1).sum()\n))\nprint(\"Memory (GiB):\", round(\n    jan_features.memory_usage(deep=True).sum() / 1024**3, 2\n))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:13:06.531188Z","iopub.execute_input":"2026-10-19T18:13:06.531708Z","iopub.status.idle":"2026-10-19T18:13:18.768616Z","shell.execute_reply.started":"2026-10-19T18:13:06.531676Z","shell.execute_reply":"2026-10-19T18:13:18.767582Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"lag_cols = [\n    f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]\n] + [\n    f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]\n]\n\nprint(\"Missing fraction per lag:\")\nprint(jan_features[lag_cols].isna().mean().sort_index().to_string())\n\nprint(\"\\nNon-missing count per lag:\")\nprint(jan_features[lag_cols].notna().sum().to_string())\n\nprint(\"\\nMasked source timestamp range:\")\nprint(masked_next[\"timestamp\"].min(), \"to\", masked_next[\"timestamp\"].max())\n\nprint(\"\\nJanuary target timestamp range:\")\nprint(jan_features[\"timestamp\"].min(), \"to\", jan_features[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:18:16.380093Z","iopub.execute_input":"2026-10-19T18:18:16.380584Z","iopub.status.idle":"2026-10-19T18:18:16.464615Z","shell.execute_reply.started":"2026-10-19T18:18:16.380553Z","shell.execute_reply":"2026-10-19T18:18:16.463438Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"Masked observation flags:\")\nprint(masked_next[[\"masked_speed\", \"masked_flow\"]].isna().mean())\n\nprint(\"\\nTarget labels:\")\nprint(jan_features[[\"target_speed\", \"target_flow\"]].isna().mean())\n\nprint(\"\\nRows with all four speed lags:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].notna().all(axis=1).sum()\n))\n\nprint(\"Rows with no speed lags:\", int(\n    jan_features[\n        [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    ].isna().all(axis=1).sum()\n))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:18:49.356949Z","iopub.execute_input":"2026-10-19T18:18:49.358162Z","iopub.status.idle":"2026-10-19T18:18:49.413127Z","shell.execute_reply.started":"2026-10-19T18:18:49.358121Z","shell.execute_reply":"2026-10-19T18:18:49.41179Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. Preserve January ground-truth labels separately\njan_targets = history_next.loc[\n    history_next[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"),\n    KEYS + VALUE_COLS\n].copy()\n\njan_targets = jan_targets.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\"\n})\n\n# Only retain targets with a valid mask-regime assignment\njan_targets = jan_targets.merge(\n    masked_next[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# 2. Build the baseline exclusively from December truth\ndec_history = history_next.loc[\n    history_next[\"timestamp\"] < pd.Timestamp(\"2031-01-01\", tz=\"UTC\")\n].copy()\n\ndec_history[\"weekday\"] = dec_history[\"timestamp\"].dt.dayofweek\ndec_history[\"minute_of_day\"] = (\n    dec_history[\"timestamp\"].dt.hour * 60\n    + dec_history[\"timestamp\"].dt.minute\n)\n\nprofile_min = (\n    dec_history.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week = (\n    dec_history.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link = (\n    dec_history.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 3. Join profiles without overwriting the target labels\njan_features_fixed = jan_targets.copy()\n\njan_features_fixed[\"weekday\"] = jan_features_fixed[\"timestamp\"].dt.dayofweek\njan_features_fixed[\"minute_of_day\"] = (\n    jan_features_fixed[\"timestamp\"].dt.hour * 60\n    + jan_features_fixed[\"timestamp\"].dt.minute\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\njan_features_fixed = jan_features_fixed.merge(\n    profile_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfor target, candidates in [\n    (\"speed\", [\"base_speed_min\", \"base_speed_week\", \"base_speed_link\"]),\n    (\"flow\", [\"base_flow_min\", \"base_flow_week\", \"base_flow_link\"])\n]:\n    jan_features_fixed[f\"base_{target}\"] = (\n        jan_features_fixed[candidates[0]]\n        .fillna(jan_features_fixed[candidates[1]])\n        .fillna(jan_features_fixed[candidates[2]])\n    )\n\n# 4. Attach observed-value lags\nlag_source = masked_next[\n    KEYS + [\"masked_speed\", \"masked_flow\"]\n].copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source.copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    jan_features_fixed = jan_features_fixed.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 5. Time features\njan_features_fixed[\"tod_sin\"] = np.sin(\n    2 * np.pi * jan_features_fixed[\"minute_of_day\"] / 1440\n)\njan_features_fixed[\"tod_cos\"] = np.cos(\n    2 * np.pi * jan_features_fixed[\"minute_of_day\"] / 1440\n)\njan_features_fixed[\"weekday_sin\"] = np.sin(\n    2 * np.pi * jan_features_fixed[\"weekday\"] / 7\n)\njan_features_fixed[\"weekday_cos\"] = np.cos(\n    2 * np.pi * jan_features_fixed[\"weekday\"] / 7\n)\n\n# Stable categorical codes\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    jan_features_fixed[f\"{col}_code\"] = (\n        pd.Categorical(\n            jan_features_fixed[col],\n            categories=sorted(jan_features_fixed[col].dropna().unique())\n        ).codes\n    )\n\n# 6. Validate before training\nassert len(jan_features_fixed) == len(jan_targets)\nassert jan_features_fixed[[\"target_speed\", \"target_flow\"]].notna().all().all()\nassert jan_features_fixed[[\"base_speed\", \"base_flow\"]].notna().all().all()\nassert not jan_features_fixed.duplicated(KEYS).any()\n\nprint(\"Rows:\", len(jan_features_fixed))\nprint(\"Target label missingness:\")\nprint(jan_features_fixed[[\"target_speed\", \"target_flow\"]].isna().mean())\nprint(\"\\nBaseline missingness:\")\nprint(jan_features_fixed[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"\\nBaseline vs target correlation (sanity check):\")\nprint(jan_features_fixed[[\n    \"target_speed\", \"base_speed\", \"target_flow\", \"base_flow\"\n]].corr().round(3))\nprint(\"\\nFeature table ready:\", jan_features_fixed.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:23:13.22908Z","iopub.execute_input":"2026-10-19T18:23:13.230179Z","iopub.status.idle":"2026-10-19T18:23:22.642748Z","shell.execute_reply.started":"2026-10-19T18:23:13.230133Z","shell.execute_reply":"2026-10-19T18:23:22.641636Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\nimport gc\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\"\n]\n\ndf = jan_features_fixed.sort_values(\"timestamp\").reset_index(drop=True)\n\n# Chronological holdout: final 20% of January timestamps\nunique_times = np.sort(df[\"timestamp\"].unique())\ncut_idx = int(len(unique_times) * 0.8)\nval_start = unique_times[cut_idx]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\nX_train = train[FEATURES]\nX_valid = valid[FEATURES]\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(\"Holdout begins:\", pd.Timestamp(val_start))\nprint(\"Training date range:\", train[\"timestamp\"].min(), \"to\", train[\"timestamp\"].max())\nprint(\"Holdout date range:\", valid[\"timestamp\"].min(), \"to\", valid[\"timestamp\"].max())\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\n# Train residual targets, not raw targets\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    X_train,\n    train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    X_train,\n    train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy() + speed_model_next.predict(X_valid),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy() + flow_model_next.predict(X_valid),\n    0, None\n)\n\nspeed_rmse = mean_squared_error(\n    valid[\"target_speed\"], speed_pred\n) ** 0.5\nflow_rmse = mean_squared_error(\n    valid[\"target_flow\"], flow_pred\n) ** 0.5\n\nprint(f\"\\nHoldout speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Holdout flow RMSE:  {flow_rmse:.4f} vph\")\nprint(\"\\nModels trained successfully.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:24:27.669166Z","iopub.execute_input":"2026-10-19T18:24:27.669587Z","iopub.status.idle":"2026-10-19T18:24:44.828599Z","shell.execute_reply.started":"2026-10-19T18:24:27.669557Z","shell.execute_reply":"2026-10-19T18:24:44.827433Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.metrics import mean_squared_error\nimport numpy as np\n\n# Merge lane counts for this panel\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nholdout_eval = valid[\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\n\nholdout_eval[\"pred_speed\"] = speed_pred\nholdout_eval[\"pred_flow\"] = flow_pred\n\nholdout_eval = holdout_eval.merge(\n    lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert holdout_eval[\"lanes\"].notna().all()\nassert (holdout_eval[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean(\n    (holdout_eval[\"target_speed\"] - holdout_eval[\"pred_speed\"]) ** 2\n))\n\nflow_per_lane_rmse = np.sqrt(np.mean(\n    ((holdout_eval[\"target_flow\"] - holdout_eval[\"pred_flow\"])\n     / holdout_eval[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_per_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(f\"Speed RMSE:             {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane:     {flow_per_lane_rmse:.4f}\")\nprint(f\"Speed score:            {S_speed:.5f}\")\nprint(f\"Flow score:             {S_flow:.5f}\")\nprint(f\"Estimated panel score:  {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:26:46.700593Z","iopub.execute_input":"2026-10-19T18:26:46.701149Z","iopub.status.idle":"2026-10-19T18:26:46.776481Z","shell.execute_reply.started":"2026-10-19T18:26:46.701115Z","shell.execute_reply":"2026-10-19T18:26:46.775088Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"Panel:\", panel)\n\nprint(\"\\nValidation template:\")\nprint(\"Rows:\", len(val_template))\nprint(val_template.head(3).to_string(index=False))\n\nprint(\"\\nPrivate template:\")\nprint(\"Rows:\", len(priv_template))\nprint(priv_template.head(3).to_string(index=False))\n\nprint(\"\\nTraining feature columns:\")\nprint(jan_features_fixed.columns.tolist())\n\nprint(\"\\nModel feature columns:\")\nprint(FEATURES)\n\nprint(\"\\nTimestamp ranges:\")\nprint(\"Validation:\", val_template[\"timestamp\"].min(), \"to\",\n      val_template[\"timestamp\"].max())\nprint(\"Private:\", priv_template[\"timestamp\"].min(), \"to\",\n      priv_template[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:27:46.934609Z","iopub.execute_input":"2026-10-19T18:27:46.936893Z","iopub.status.idle":"2026-10-19T18:27:47.031255Z","shell.execute_reply.started":"2026-10-19T18:27:46.936836Z","shell.execute_reply":"2026-10-19T18:27:47.029739Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_root = ROOT / \"task1\" / panel\n\nfor split in [\"train\", \"validation\", \"private\"]:\n    split_root = panel_root / split\n    files = list(split_root.rglob(\"*.parquet\"))\n    print(f\"{split}: {len(files)} parquet files\")\n    if files:\n        print(\" Example:\", files[0].relative_to(panel_root))\n\nprint(\"\\nTraining history ends:\",\n      history_next[\"timestamp\"].max())\n\nprint(\"Validation begins:\",\n      pd.to_datetime(val_template[\"timestamp\"], utc=True).min())\n\nprint(\"Private begins:\",\n      pd.to_datetime(priv_template[\"timestamp\"], utc=True).min())\n\nprint(\"\\nObserved-value columns available:\")\nprint(masked_next.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:28:32.419409Z","iopub.execute_input":"2026-10-19T18:28:32.419824Z","iopub.status.idle":"2026-10-19T18:28:32.590813Z","shell.execute_reply.started":"2026-10-19T18:28:32.419797Z","shell.execute_reply":"2026-10-19T18:28:32.58947Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\n\nprint(\"ROOT:\", ROOT)\n\nfor folder in [\n    ROOT / \"task1\" / panel,\n    ROOT / \"corridors\" / panel,\n]:\n    print(f\"\\n{folder}\")\n    if folder.exists():\n        for path in list(folder.iterdir())[:15]:\n            print(\" \", path.name, \"(dir)\" if path.is_dir() else \"(file)\")\n    else:\n        print(\" Folder not found\")\n\nprint(\"\\nPreviously discovered file collections:\")\nfor name in [\"truth_files\", \"masked_files\", \"train_truth_files\",\n             \"train_masked_files\", \"val_masked_files\", \"private_masked_files\"]:\n    obj = globals().get(name)\n    if obj is not None:\n        print(name, len(obj))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:30:26.076709Z","iopub.execute_input":"2026-10-19T18:30:26.078088Z","iopub.status.idle":"2026-10-19T18:30:26.31497Z","shell.execute_reply.started":"2026-10-19T18:30:26.078034Z","shell.execute_reply":"2026-10-19T18:30:26.313921Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\n\nfor split in [\"train\", \"validation\", \"private\"]:\n    folder = ROOT / \"corridors\" / panel / split\n    files = list(folder.rglob(\"*.parquet\"))\n\n    print(f\"\\n{split}: {len(files)} parquet files\")\n    for p in files[:5]:\n        print(\" \", p.relative_to(folder))\n\n# Inspect the task1 split templates and files too\nfor split in [\"train\", \"validation\", \"private\"]:\n    folder = ROOT / \"task1\" / panel / split\n    print(f\"\\nTask1 {split}:\")\n    for p in list(folder.rglob(\"*\"))[:8]:\n        print(\" \", p.relative_to(folder))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:30:56.036787Z","iopub.execute_input":"2026-10-19T18:30:56.037285Z","iopub.status.idle":"2026-10-19T18:30:56.270622Z","shell.execute_reply.started":"2026-10-19T18:30:56.037256Z","shell.execute_reply":"2026-10-19T18:30:56.269629Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_root = ROOT / \"corridors\" / panel\n\nfor split in [\"train\", \"validation\", \"private\"]:\n    files = list((panel_root / split).rglob(\"*.parquet\"))\n    print(f\"\\n--- {split.upper()} ---\")\n\n    if not files:\n        print(\"No parquet files found\")\n        continue\n\n    sample = pd.read_parquet(files[0])\n    print(\"Sample file:\", files[0].name)\n    print(\"Columns:\", sample.columns.tolist())\n    print(\"Rows:\", len(sample))\n    print(sample.head(2).to_string(index=False))\n    print(\"Timestamp range:\",\n          sample[\"timestamp\"].min(), \"to\", sample[\"timestamp\"].max())\n    del sample\n\nprint(\"\\nValidation template rows:\", len(val_template))\nprint(\"Private template rows:\", len(priv_template))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:31:52.351753Z","iopub.execute_input":"2026-10-19T18:31:52.353115Z","iopub.status.idle":"2026-10-19T18:31:52.571303Z","shell.execute_reply.started":"2026-10-19T18:31:52.353067Z","shell.execute_reply":"2026-10-19T18:31:52.570254Z"},"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_root = ROOT / \"corridors\" / panel\n\nfor split, month in [\n    (\"train\", \"2031-02\"),\n    (\"validation\", \"2031-03\"),\n    (\"private\", \"2031-04\"),\n]:\n    files = sorted(\n        (panel_root / split / \"mainline_states\").rglob(\"*.parquet\")\n    )\n\n    print(f\"\\n--- {split.upper()} / {month} ---\")\n    print(\"Mainline files:\", len(files))\n\n    if not files:\n        print(\"No mainline files found.\")\n        continue\n\n    sample_path = files[0]\n    sample = pd.read_parquet(sample_path)\n\n    print(\"Sample:\", sample_path.name)\n    print(\"Columns:\", sample.columns.tolist())\n    print(\"Rows:\", len(sample))\n    print(\"Observed:\", int(sample[\"is_observed\"].sum()))\n    print(\"Timestamp range:\",\n          sample[\"timestamp\"].min(), \"to\", sample[\"timestamp\"].max())\n\n    del sample","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:32:41.345611Z","iopub.execute_input":"2026-10-19T18:32:41.346026Z","iopub.status.idle":"2026-10-19T18:32:41.441974Z","shell.execute_reply.started":"2026-10-19T18:32:41.345991Z","shell.execute_reply":"2026-10-19T18:32:41.440782Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\n\nfor split in [\"train\", \"validation\", \"private\"]:\n    folder = ROOT / \"corridors\" / panel / split\n\n    print(f\"\\n--- {split.upper()} subdirectories ---\")\n    for p in sorted(folder.iterdir()):\n        if p.is_dir():\n            print(p.name)\n\n    print(\"\\nMainline-like parquet files:\")\n    files = [\n        p for p in folder.rglob(\"*.parquet\")\n        if \"mainline\" in p.name.lower()\n    ]\n    print(\"Count:\", len(files))\n    for p in files[:5]:\n        print(p.relative_to(folder))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:34:17.839784Z","iopub.execute_input":"2026-10-19T18:34:17.840867Z","iopub.status.idle":"2026-10-19T18:34:18.075184Z","shell.execute_reply.started":"2026-10-19T18:34:17.840824Z","shell.execute_reply":"2026-10-19T18:34:18.073358Z"},"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_root = ROOT / \"corridors\" / panel\n\nfor split, month in [\n    (\"train\", \"2031-02\"),\n    (\"validation\", \"2031-03\"),\n    (\"private\", \"2031-04\"),\n]:\n    folder = panel_root / split / (\n        \"mainline_states_masked\"\n    )\n\n    files = sorted(folder.rglob(\"*.parquet\"))\n    print(f\"\\n--- {split.upper()} ---\")\n    print(\"Files:\", len(files))\n\n    if not files:\n        continue\n\n    sample_path = next(\n        (p for p in files if month in str(p)),\n        files[0]\n    )\n\n    sample = pd.read_parquet(sample_path)\n    print(\"Sample:\", sample_path.name)\n    print(\"Columns:\", sample.columns.tolist())\n    print(\"Rows:\", len(sample))\n    print(\"Timestamp range:\",\n          sample[\"timestamp\"].min(), \"to\", sample[\"timestamp\"].max())\n    print(\"Observed rows:\", int(sample[\"is_observed\"].sum()))\n    print(\"Missing rows:\", int(sample[\"is_missing\"].sum()))\n    del sample","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:35:08.688502Z","iopub.execute_input":"2026-10-19T18:35:08.689847Z","iopub.status.idle":"2026-10-19T18:35:08.838617Z","shell.execute_reply.started":"2026-10-19T18:35:08.689763Z","shell.execute_reply":"2026-10-19T18:35:08.837343Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport numpy as np\nimport gc\n\npanel_root = ROOT / \"corridors\" / panel\ntrain_root = panel_root / \"train\"\n\n# Load January ground truth for baseline construction\ntruth_files = sorted(\n    (train_root / \"mainline_states\").rglob(\"*.parquet\")\n)\n\nhistory_parts = []\n\nfor path in truth_files:\n    # Partition folders are not sufficient for filtering;\n    # filter the actual timestamps after reading.\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (df[\"is_score_eligible\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        history_parts.append(part)\n\n    del df\n    gc.collect()\n\nhistory_feb = pd.concat(history_parts, ignore_index=True)\ndel history_parts\ngc.collect()\n\n# Load February masked observations\nmasked_files_feb = sorted(\n    (train_root / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\nmasked_parts = []\n\nfor path in masked_files_feb:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        masked_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_feb = pd.concat(masked_parts, ignore_index=True)\ndel masked_parts\ngc.collect()\n\nprint(\"January history rows:\", len(history_feb))\nprint(\"January date range:\",\n      history_feb[\"timestamp\"].min(), \"to\",\n      history_feb[\"timestamp\"].max())\nprint(\"February observed rows:\", len(masked_feb))\nprint(\"February date range:\",\n      masked_feb[\"timestamp\"].min(), \"to\",\n      masked_feb[\"timestamp\"].max())\nprint(\"Duplicate history keys:\", history_feb.duplicated(KEYS).sum())\nprint(\"Duplicate masked keys:\", masked_feb.duplicated(KEYS).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:36:30.6352Z","iopub.execute_input":"2026-10-19T18:36:30.635619Z","iopub.status.idle":"2026-10-19T18:41:27.068493Z","shell.execute_reply.started":"2026-10-19T18:36:30.63558Z","shell.execute_reply":"2026-10-19T18:41:27.067107Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Build February supervised training features without target leakage\n\nimport pandas as pd\nimport numpy as np\nimport gc\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nVALUE_COLS = [\"speed_kmh\", \"flow_vph\"]\n\n# 1. February ground truth: labels only\nfeb_truth_parts = []\n\ntruth_files = sorted(\n    (train_root / \"mainline_states\").rglob(\"*.parquet\")\n)\n\nfor path in truth_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (df[\"is_score_eligible\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, KEYS + VALUE_COLS].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        feb_truth_parts.append(part)\n\n    del df\n    gc.collect()\n\nfeb_targets = pd.concat(feb_truth_parts, ignore_index=True)\ndel feb_truth_parts\ngc.collect()\n\nfeb_targets = feb_targets.rename(columns={\n    \"speed_kmh\": \"target_speed\",\n    \"flow_vph\": \"target_flow\"\n})\n\n# 2. Join each target to its assigned mask regime\nfeb_targets = feb_targets.merge(\n    masked_feb[KEYS + [\"mask_regime\"]],\n    on=KEYS,\n    how=\"inner\",\n    validate=\"one_to_one\"\n)\n\n# 3. January historical profiles\njan_profile = history_feb.copy()\njan_profile[\"weekday\"] = jan_profile[\"timestamp\"].dt.dayofweek\njan_profile[\"minute_of_day\"] = (\n    jan_profile[\"timestamp\"].dt.hour * 60\n    + jan_profile[\"timestamp\"].dt.minute\n)\n\nprofile_min = (\n    jan_profile.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week = (\n    jan_profile.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link = (\n    jan_profile.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 4. Create feature table\nfeb_features = feb_targets.copy()\nfeb_features[\"weekday\"] = feb_features[\"timestamp\"].dt.dayofweek\nfeb_features[\"minute_of_day\"] = (\n    feb_features[\"timestamp\"].dt.hour * 60\n    + feb_features[\"timestamp\"].dt.minute\n)\n\nfeb_features = feb_features.merge(\n    profile_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nfeb_features = feb_features.merge(\n    profile_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nfeb_features = feb_features.merge(\n    profile_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfeb_features[\"base_speed\"] = (\n    feb_features[\"base_speed_min\"]\n    .fillna(feb_features[\"base_speed_week\"])\n    .fillna(feb_features[\"base_speed_link\"])\n)\nfeb_features[\"base_flow\"] = (\n    feb_features[\"base_flow_min\"]\n    .fillna(feb_features[\"base_flow_week\"])\n    .fillna(feb_features[\"base_flow_link\"])\n)\n\n# 5. Observed-value lags, including January for 1440-minute lags\nlag_source = pd.concat([\n    history_feb[KEYS + VALUE_COLS].rename(columns={\n        \"speed_kmh\": \"masked_speed\",\n        \"flow_vph\": \"masked_flow\"\n    }),\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\n# Keep only observed source values and avoid duplicate keys\nlag_source = lag_source.drop_duplicates(KEYS, keep=\"last\")\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    feb_features = feb_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 6. Time and categorical features\nfeb_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * feb_features[\"minute_of_day\"] / 1440\n)\nfeb_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * feb_features[\"minute_of_day\"] / 1440\n)\nfeb_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * feb_features[\"weekday\"] / 7\n)\nfeb_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * feb_features[\"weekday\"] / 7\n)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    feb_features[f\"{col}_code\"] = pd.Categorical(\n        feb_features[col],\n        categories=sorted(feb_features[col].dropna().unique())\n    ).codes\n\n# 7. Checks\nassert feb_features[[\"target_speed\", \"target_flow\"]].notna().all().all()\nassert feb_features[[\"base_speed\", \"base_flow\"]].notna().all().all()\nassert not feb_features.duplicated(KEYS).any()\n\nprint(\"February feature rows:\", len(feb_features))\nprint(\"Target missingness:\")\nprint(feb_features[[\"target_speed\", \"target_flow\"]].isna().mean())\nprint(\"\\nBaseline missingness:\")\nprint(feb_features[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"\\nLag missingness:\")\nprint(feb_features[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"\\nFeature table shape:\", feb_features.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:48:23.925081Z","iopub.execute_input":"2026-10-19T18:48:23.925506Z","iopub.status.idle":"2026-10-19T18:51:00.730136Z","shell.execute_reply.started":"2026-10-19T18:48:23.925476Z","shell.execute_reply":"2026-10-19T18:51:00.72902Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\nimport numpy as np\nimport pandas as pd\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\"\n]\n\ndf = feb_features.sort_values(\"timestamp\").reset_index(drop=True)\n\nunique_times = np.sort(df[\"timestamp\"].unique())\ncut_idx = int(len(unique_times) * 0.8)\nval_start = unique_times[cut_idx]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\nX_train = train[FEATURES]\nX_valid = valid[FEATURES]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    X_train, train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    X_train, train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy() + speed_model_next.predict(X_valid),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy() + flow_model_next.predict(X_valid),\n    0, None\n)\n\n# Competition metric: lane-normalized flow RMSE\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\neval_df = valid[\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\neval_df[\"pred_speed\"] = speed_pred\neval_df[\"pred_flow\"] = flow_pred\neval_df = eval_df.merge(\n    lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert eval_df[\"lanes\"].notna().all()\nassert (eval_df[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean(\n    (eval_df[\"target_speed\"] - eval_df[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((eval_df[\"target_flow\"] - eval_df[\"pred_flow\"])\n     / eval_df[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(\"Holdout starts:\", pd.Timestamp(val_start))\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"Estimated state score: {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:51:44.661692Z","iopub.execute_input":"2026-10-19T18:51:44.662446Z","iopub.status.idle":"2026-10-19T18:51:59.656265Z","shell.execute_reply.started":"2026-10-19T18:51:44.662412Z","shell.execute_reply":"2026-10-19T18:51:59.655151Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\nval_masked_files = sorted(\n    (panel_root / \"validation\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\nmarch_parts = []\n\nfor path in val_masked_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-04-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        march_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_march = pd.concat(march_parts, ignore_index=True)\ndel march_parts\ngc.collect()\n\nprint(\"March observed rows:\", len(masked_march))\nprint(\"Timestamp range:\",\n      masked_march[\"timestamp\"].min(), \"to\",\n      masked_march[\"timestamp\"].max())\nprint(\"Duplicate keys:\", masked_march.duplicated(KEYS).sum())\nprint(\"Missing masked values:\")\nprint(masked_march[[\"masked_speed\", \"masked_flow\"]].isna().mean())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T18:56:54.451186Z","iopub.execute_input":"2026-10-19T18:56:54.45168Z","iopub.status.idle":"2026-10-19T18:57:12.917998Z","shell.execute_reply.started":"2026-10-19T18:56:54.451651Z","shell.execute_reply":"2026-10-19T18:57:12.916442Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. History for profile baselines: January + February ground truth.\n# Use only data strictly before March.\nhistory_mar = pd.concat([\n    history_feb,\n    feb_targets[KEYS + [\"target_speed\", \"target_flow\"]].rename(columns={\n        \"target_speed\": \"speed_kmh\",\n        \"target_flow\": \"flow_vph\"\n    })\n], ignore_index=True)\n\nhistory_mar = history_mar.drop_duplicates(KEYS, keep=\"last\")\nhistory_mar[\"weekday\"] = history_mar[\"timestamp\"].dt.dayofweek\nhistory_mar[\"minute_of_day\"] = (\n    history_mar[\"timestamp\"].dt.hour * 60\n    + history_mar[\"timestamp\"].dt.minute\n)\n\nprofile_min_mar = (\n    history_mar.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"],\n        observed=True\n    )[VALUE_COLS].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprofile_week_mar = (\n    history_mar.groupby([\"link_id\", \"weekday\"], observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprofile_link_mar = (\n    history_mar.groupby(\"link_id\", observed=True)[VALUE_COLS]\n    .mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\n# 2. Start from March masked rows, including unobserved targets\nmarch_targets = val_template.copy()\nmarch_targets[\"timestamp\"] = pd.to_datetime(\n    march_targets[\"timestamp\"], utc=True\n)\n\nmarch_features = march_targets[KEYS + [\"mask_regime\"]].copy()\nmarch_features[\"weekday\"] = march_features[\"timestamp\"].dt.dayofweek\nmarch_features[\"minute_of_day\"] = (\n    march_features[\"timestamp\"].dt.hour * 60\n    + march_features[\"timestamp\"].dt.minute\n)\n\nmarch_features = march_features.merge(\n    profile_min_mar,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nmarch_features = march_features.merge(\n    profile_week_mar,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\nmarch_features = march_features.merge(\n    profile_link_mar,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nmarch_features[\"base_speed\"] = (\n    march_features[\"base_speed_min\"]\n    .fillna(march_features[\"base_speed_week\"])\n    .fillna(march_features[\"base_speed_link\"])\n)\nmarch_features[\"base_flow\"] = (\n    march_features[\"base_flow_min\"]\n    .fillna(march_features[\"base_flow_week\"])\n    .fillna(march_features[\"base_flow_link\"])\n)\n\n# 3. Build lag source from January, February, and March observed data\nfeb_observed = masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n\nlag_source_mar = pd.concat([\n    history_feb[KEYS + VALUE_COLS].rename(columns={\n        \"speed_kmh\": \"masked_speed\",\n        \"flow_vph\": \"masked_flow\"\n    }),\n    feb_observed,\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\nlag_source_mar = lag_source_mar.drop_duplicates(KEYS, keep=\"last\")\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_mar[KEYS + [\"masked_speed\", \"masked_flow\"]].copy()\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    march_features = march_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# 4. Time features\nmarch_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * march_features[\"minute_of_day\"] / 1440\n)\nmarch_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * march_features[\"minute_of_day\"] / 1440\n)\nmarch_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * march_features[\"weekday\"] / 7\n)\nmarch_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * march_features[\"weekday\"] / 7\n)\n\n# 5. Use training category mappings, not new March mappings\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    mapping = {\n        value: i\n        for i, value in enumerate(\n            sorted(feb_features[col].dropna().unique())\n        )\n    }\n    march_features[f\"{col}_code\"] = (\n        march_features[col].map(mapping).fillna(-1).astype(\"int32\")\n    )\n\n# 6. Validate\nassert len(march_features) == len(val_template)\nassert not march_features.duplicated(KEYS).any()\nassert march_features[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\nprint(\"March features:\", march_features.shape)\nprint(\"Baseline missingness:\")\nprint(march_features[[\"base_speed\", \"base_flow\"]].isna().mean())\nprint(\"Lag missingness:\")\nprint(march_features[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"Rows:\", len(march_features))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:04:58.119954Z","iopub.execute_input":"2026-10-19T19:04:58.120544Z","iopub.status.idle":"2026-10-19T19:05:09.617857Z","shell.execute_reply.started":"2026-10-19T19:04:58.12051Z","shell.execute_reply":"2026-10-19T19:05:09.616693Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Verify model feature schema\nassert list(march_features[FEATURES].columns) == FEATURES\nassert list(feb_features[FEATURES].columns) == FEATURES\n\n# Generate predictions\nmarch_pred_speed = np.clip(\n    march_features[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(march_features[FEATURES]),\n    0, 160\n)\n\nmarch_pred_flow = np.clip(\n    march_features[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(march_features[FEATURES]),\n    0, None\n)\n\n# Build prediction table using the exact template key order\nmarch_predictions = march_features[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].copy()\n\nmarch_predictions[\"panel\"] = panel\nmarch_predictions[\"speed_kmh\"] = march_pred_speed\nmarch_predictions[\"flow_vph\"] = march_pred_flow\n\n# Restore the template's row order via a stable merge\ntemplate_keys = val_template.copy()\ntemplate_keys[\"timestamp\"] = pd.to_datetime(\n    template_keys[\"timestamp\"], utc=True\n)\n\nmarch_predictions = template_keys[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].merge(\n    march_predictions[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"speed_kmh\", \"flow_vph\"]\n    ],\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\nassert len(march_predictions) == len(val_template)\nassert march_predictions[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert march_predictions[\"speed_kmh\"].between(0, 160).all()\nassert (march_predictions[\"flow_vph\"] >= 0).all()\n\n# Save a separate checkpoint; don't overwrite the existing combined checkpoint\nmarch_path = WORK / \"D12_I405_N_march_predictions.csv\"\nmarch_predictions.to_csv(march_path, index=False)\n\nprint(\"March predictions:\", len(march_predictions))\nprint(\"Speed range:\",\n      march_predictions[\"speed_kmh\"].min(),\n      \"to\", march_predictions[\"speed_kmh\"].max())\nprint(\"Flow range:\",\n      march_predictions[\"flow_vph\"].min(),\n      \"to\", march_predictions[\"flow_vph\"].max())\nprint(\"Saved:\", march_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:08:44.014683Z","iopub.execute_input":"2026-10-19T19:08:44.016164Z","iopub.status.idle":"2026-10-19T19:08:50.926693Z","shell.execute_reply.started":"2026-10-19T19:08:44.016119Z","shell.execute_reply":"2026-10-19T19:08:50.925551Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"January history rows:\", len(history_feb))\nprint(\"February masked observed rows:\", len(masked_feb))\nprint(\"March masked observed rows:\", len(masked_march))\n\nprint(\"\\nJanuary history date range:\")\nprint(history_feb[\"timestamp\"].min(), \"to\",\n      history_feb[\"timestamp\"].max())\n\nprint(\"\\nFebruary masked date range:\")\nprint(masked_feb[\"timestamp\"].min(), \"to\",\n      masked_feb[\"timestamp\"].max())\n\nprint(\"\\nMarch masked date range:\")\nprint(masked_march[\"timestamp\"].min(), \"to\",\n      masked_march[\"timestamp\"].max())\n\nprint(\"\\nLag source currently includes:\")\nprint(\"January truth:\", len(history_feb))\nprint(\"February observed:\", len(masked_feb))\nprint(\"March observed:\", len(masked_march))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:11:39.519714Z","iopub.execute_input":"2026-10-19T19:11:39.521477Z","iopub.status.idle":"2026-10-19T19:11:39.583192Z","shell.execute_reply.started":"2026-10-19T19:11:39.521351Z","shell.execute_reply":"2026-10-19T19:11:39.577482Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\nimport gc\n\njan_masked_files = sorted(\n    (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n)\n\njan_parts = []\n\nfor path in jan_masked_files:\n    df = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(df[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\"))\n        & (ts < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (df[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        part = df.loc[keep, [\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n        ]].copy()\n        part[\"timestamp\"] = ts.loc[keep]\n        part = part.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        jan_parts.append(part)\n\n    del df\n    gc.collect()\n\nmasked_jan = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\nprint(\"January masked observed rows:\", len(masked_jan))\nprint(\"Duplicate keys:\", masked_jan.duplicated(KEYS).sum())\nprint(\"Missing masked values:\")\nprint(masked_jan[[\"masked_speed\", \"masked_flow\"]].isna().mean())\nprint(\"Date range:\",\n      masked_jan[\"timestamp\"].min(), \"to\",\n      masked_jan[\"timestamp\"].max())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:13:47.769237Z","iopub.execute_input":"2026-10-19T19:13:47.770307Z","iopub.status.idle":"2026-10-19T19:16:07.686331Z","shell.execute_reply.started":"2026-10-19T19:13:47.770258Z","shell.execute_reply":"2026-10-19T19:16:07.684212Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# Combine only genuinely observed masked values\nlag_source_corrected = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]]\n], ignore_index=True)\n\nassert not lag_source_corrected.duplicated(KEYS).any()\n\n# Remove previous lag columns before rebuilding\nlag_cols = (\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    + [f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]]\n)\n\nfeb_features_corrected = feb_features.drop(\n    columns=lag_cols, errors=\"ignore\"\n).copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_corrected[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    feb_features_corrected = feb_features_corrected.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n    del lag\n    gc.collect()\n\nassert len(feb_features_corrected) == len(feb_features)\nassert not feb_features_corrected.duplicated(KEYS).any()\n\nprint(\"Corrected February features:\", feb_features_corrected.shape)\nprint(\"Lag missingness:\")\nprint(feb_features_corrected[\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n].isna().mean())\nprint(\"Target missingness:\")\nprint(feb_features_corrected[[\"target_speed\", \"target_flow\"]].isna().mean())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:21:07.698256Z","iopub.execute_input":"2026-10-19T19:21:07.698996Z","iopub.status.idle":"2026-10-19T19:21:15.475688Z","shell.execute_reply.started":"2026-10-19T19:21:07.698927Z","shell.execute_reply":"2026-10-19T19:21:15.474495Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.ensemble import HistGradientBoostingRegressor\nimport numpy as np\nimport pandas as pd\n\ndf = feb_features_corrected.sort_values(\"timestamp\").reset_index(drop=True)\n\nunique_times = np.sort(df[\"timestamp\"].unique())\nval_start = unique_times[int(len(unique_times) * 0.8)]\n\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42\n    )\n\nspeed_model_next = make_model()\nflow_model_next = make_model()\n\nspeed_model_next.fit(\n    train[FEATURES],\n    train[\"target_speed\"] - train[\"base_speed\"]\n)\nflow_model_next.fit(\n    train[FEATURES],\n    train[\"target_flow\"] - train[\"base_flow\"]\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(valid[FEATURES]),\n    0, 160\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(valid[FEATURES]),\n    0, None\n)\n\nlane_map = links_next[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\nev = valid[[\"link_id\", \"target_speed\", \"target_flow\"]].copy()\nev[\"pred_speed\"] = speed_pred\nev[\"pred_flow\"] = flow_pred\nev = ev.merge(lane_map, on=\"link_id\", how=\"left\", validate=\"many_to_one\")\n\nassert ev[\"lanes\"].notna().all() and (ev[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean((ev[\"target_speed\"] - ev[\"pred_speed\"]) ** 2))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((ev[\"target_flow\"] - ev[\"pred_flow\"]) / ev[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Training rows:\", len(train))\nprint(\"Holdout rows:\", len(valid))\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"Estimated state score: {S_state:.5f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:22:18.734397Z","iopub.execute_input":"2026-10-19T19:22:18.734968Z","iopub.status.idle":"2026-10-19T19:22:33.110106Z","shell.execute_reply.started":"2026-10-19T19:22:18.734929Z","shell.execute_reply":"2026-10-19T19:22:33.10902Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport gc\n\n# 1. Build observed-only lag source across Jan–Mar\nlag_source_mar = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]],\n], ignore_index=True)\n\nassert not lag_source_mar.duplicated(KEYS).any()\n\n# 2. Rebuild March lag columns\nlag_cols = (\n    [f\"lag_speed_{m}\" for m in [5, 15, 60, 1440]]\n    + [f\"lag_flow_{m}\" for m in [5, 15, 60, 1440]]\n)\n\nmarch_features_final = march_features.drop(\n    columns=lag_cols, errors=\"ignore\"\n).copy()\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source_mar[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    march_features_final = march_features_final.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n    del lag\n    gc.collect()\n\n# 3. Verify the exact model feature schema\nassert all(c in march_features_final.columns for c in FEATURES)\nassert len(march_features_final) == len(val_template)\nassert not march_features_final.duplicated(KEYS).any()\nassert march_features_final[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\n# 4. Predict using the corrected February-trained models\nmarch_speed_final = np.clip(\n    march_features_final[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(march_features_final[FEATURES]),\n    0, 160\n)\n\nmarch_flow_final = np.clip(\n    march_features_final[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(march_features_final[FEATURES]),\n    0, None\n)\n\n# 5. Reconstruct predictions in exact template order\nmarch_predictions_final = val_template.copy()\nmarch_predictions_final[\"timestamp\"] = pd.to_datetime(\n    march_predictions_final[\"timestamp\"], utc=True\n)\n\npred_values = march_features_final[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n].copy()\npred_values[\"speed_kmh\"] = march_speed_final\npred_values[\"flow_vph\"] = march_flow_final\n\nmarch_predictions_final = march_predictions_final.drop(\n    columns=[\"speed_kmh\", \"flow_vph\"]\n).merge(\n    pred_values,\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\n# 6. Validate and save a separate final checkpoint\nassert len(march_predictions_final) == len(val_template)\nassert march_predictions_final[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert march_predictions_final[\"speed_kmh\"].between(0, 160).all()\nassert (march_predictions_final[\"flow_vph\"] >= 0).all()\n\nmarch_path_final = WORK / \"D12_I405_N_march_predictions_corrected.csv\"\nmarch_predictions_final.to_csv(march_path_final, index=False)\n\nprint(\"Rows:\", len(march_predictions_final))\nprint(\"Missing predictions:\",\n      int(march_predictions_final[[\"speed_kmh\", \"flow_vph\"]].isna().any(axis=1).sum()))\nprint(\"Speed range:\",\n      march_predictions_final[\"speed_kmh\"].min(),\n      \"to\", march_predictions_final[\"speed_kmh\"].max())\nprint(\"Flow range:\",\n      march_predictions_final[\"flow_vph\"].min(),\n      \"to\", march_predictions_final[\"flow_vph\"].max())\nprint(\"Saved:\", march_path_final)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:24:23.864609Z","iopub.execute_input":"2026-10-19T19:24:23.866293Z","iopub.status.idle":"2026-10-19T19:24:39.530019Z","shell.execute_reply.started":"2026-10-19T19:24:23.866247Z","shell.execute_reply":"2026-10-19T19:24:39.528807Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# ============================================================\n# 1. PRE-FLIGHT CHECKS\n# ============================================================\nassert panel == \"D12_I405_N\"\nassert \"speed_model_next\" in globals()\nassert \"flow_model_next\" in globals()\nassert \"masked_jan\" in globals()\nassert \"masked_feb\" in globals()\nassert \"masked_march\" in globals()\nassert \"history_mar\" in globals()\nassert \"priv_template\" in globals()\n\npanel_root = ROOT / \"corridors\" / panel\nprivate_root = panel_root / \"private\" / \"mainline_states_masked\"\n\napril_files = sorted(private_root.rglob(\"*.parquet\"))\nassert len(april_files) > 0, f\"No April masked files found: {private_root}\"\n\napril_start = pd.Timestamp(\"2031-04-01\", tz=\"UTC\")\nmay_start = pd.Timestamp(\"2031-05-01\", tz=\"UTC\")\n\n# ============================================================\n# 2. LOAD APRIL OBSERVED MASKED DATA\n# ============================================================\napril_parts = []\n\nfor path in april_files:\n    part = pd.read_parquet(\n        path,\n        columns=[\n            \"timestamp\", \"station_id\", \"link_id\",\n            \"speed_kmh\", \"flow_vph\", \"is_observed\", \"mask_regime\"\n        ]\n    )\n\n    ts = pd.to_datetime(part[\"timestamp\"], utc=True)\n    keep = (\n        (ts >= april_start)\n        & (ts < may_start)\n        & (part[\"is_observed\"] == 1)\n    )\n\n    if keep.any():\n        out = part.loc[\n            keep,\n            [\n                \"timestamp\", \"station_id\", \"link_id\",\n                \"speed_kmh\", \"flow_vph\", \"mask_regime\"\n            ]\n        ].copy()\n\n        out[\"timestamp\"] = ts.loc[keep]\n        out = out.rename(columns={\n            \"speed_kmh\": \"masked_speed\",\n            \"flow_vph\": \"masked_flow\"\n        })\n        april_parts.append(out)\n\n    del part\n    gc.collect()\n\nassert april_parts, \"No observed April rows were loaded.\"\n\nmasked_april = pd.concat(april_parts, ignore_index=True)\ndel april_parts\ngc.collect()\n\nassert not masked_april.duplicated(KEYS).any(), \\\n    \"Duplicate April observation keys found.\"\n\nprint(\"April observed rows:\", len(masked_april))\nprint(\"April range:\", masked_april[\"timestamp\"].min(),\n      \"to\", masked_april[\"timestamp\"].max())\n\n# ============================================================\n# 3. PREPARE APRIL TEMPLATE AND BASELINES\n# ============================================================\napril_template = priv_template.copy()\napril_template[\"timestamp\"] = pd.to_datetime(\n    april_template[\"timestamp\"], utc=True\n)\n\nassert len(april_template) == 192164\nassert april_template[\"timestamp\"].ge(april_start).all()\nassert april_template[\"timestamp\"].lt(may_start).all()\nassert not april_template.duplicated(KEYS).any()\n\n# Use only pre-April historical truth for the baseline profiles.\nhist = history_mar.copy()\nhist[\"weekday\"] = hist[\"timestamp\"].dt.dayofweek\nhist[\"minute_of_day\"] = (\n    hist[\"timestamp\"].dt.hour * 60 + hist[\"timestamp\"].dt.minute\n)\n\nprof_min = (\n    hist.groupby([\"link_id\", \"weekday\", \"minute_of_day\"], observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_min\",\n        \"flow_vph\": \"base_flow_min\"\n    })\n)\n\nprof_week = (\n    hist.groupby([\"link_id\", \"weekday\"], observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_week\",\n        \"flow_vph\": \"base_flow_week\"\n    })\n)\n\nprof_link = (\n    hist.groupby(\"link_id\", observed=True)\n    [[\"speed_kmh\", \"flow_vph\"]].mean().reset_index()\n    .rename(columns={\n        \"speed_kmh\": \"base_speed_link\",\n        \"flow_vph\": \"base_flow_link\"\n    })\n)\n\napril_features = april_template[\n    KEYS + [\"mask_regime\"]\n].copy()\n\napril_features[\"weekday\"] = april_features[\"timestamp\"].dt.dayofweek\napril_features[\"minute_of_day\"] = (\n    april_features[\"timestamp\"].dt.hour * 60\n    + april_features[\"timestamp\"].dt.minute\n)\n\napril_features = april_features.merge(\n    prof_min,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\napril_features = april_features.merge(\n    prof_week,\n    on=[\"link_id\", \"weekday\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\napril_features = april_features.merge(\n    prof_link,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\napril_features[\"base_speed\"] = (\n    april_features[\"base_speed_min\"]\n    .fillna(april_features[\"base_speed_week\"])\n    .fillna(april_features[\"base_speed_link\"])\n)\napril_features[\"base_flow\"] = (\n    april_features[\"base_flow_min\"]\n    .fillna(april_features[\"base_flow_week\"])\n    .fillna(april_features[\"base_flow_link\"])\n)\n\nassert april_features[[\"base_speed\", \"base_flow\"]].notna().all().all(), \\\n    \"April baseline has missing values.\"\n\n# ============================================================\n# 4. OBSERVED-ONLY LAGS ACROSS JANUARY–APRIL\n# ============================================================\nlag_source = pd.concat([\n    masked_jan[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_feb[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_march[KEYS + [\"masked_speed\", \"masked_flow\"]],\n    masked_april[KEYS + [\"masked_speed\", \"masked_flow\"]],\n], ignore_index=True)\n\nassert not lag_source.duplicated(KEYS).any(), \\\n    \"Duplicate keys in combined lag source.\"\n\nfor minutes in [5, 15, 60, 1440]:\n    lag = lag_source[\n        KEYS + [\"masked_speed\", \"masked_flow\"]\n    ].copy()\n\n    lag[\"timestamp\"] += pd.Timedelta(minutes=minutes)\n    lag = lag.rename(columns={\n        \"masked_speed\": f\"lag_speed_{minutes}\",\n        \"masked_flow\": f\"lag_flow_{minutes}\"\n    })\n\n    april_features = april_features.merge(\n        lag,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n    del lag\n    gc.collect()\n\n# ============================================================\n# 5. TIME FEATURES AND TRAINING CATEGORY MAPPINGS\n# ============================================================\napril_features[\"tod_sin\"] = np.sin(\n    2 * np.pi * april_features[\"minute_of_day\"] / 1440\n)\napril_features[\"tod_cos\"] = np.cos(\n    2 * np.pi * april_features[\"minute_of_day\"] / 1440\n)\napril_features[\"weekday_sin\"] = np.sin(\n    2 * np.pi * april_features[\"weekday\"] / 7\n)\napril_features[\"weekday_cos\"] = np.cos(\n    2 * np.pi * april_features[\"weekday\"] / 7\n)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    mapping = {\n        value: i\n        for i, value in enumerate(\n            sorted(feb_features_corrected[col].dropna().unique())\n        )\n    }\n    april_features[f\"{col}_code\"] = (\n        april_features[col].map(mapping).fillna(-1).astype(\"int32\")\n    )\n\nassert all(c in april_features.columns for c in FEATURES)\nassert len(april_features) == len(april_template)\nassert not april_features.duplicated(KEYS).any()\n\n# ============================================================\n# 6. PREDICT\n# ============================================================\nX_april = april_features[FEATURES]\n\napril_speed = np.clip(\n    april_features[\"base_speed\"].to_numpy()\n    + speed_model_next.predict(X_april),\n    0, 160\n)\napril_flow = np.clip(\n    april_features[\"base_flow\"].to_numpy()\n    + flow_model_next.predict(X_april),\n    0, None\n)\n\n# Reattach predictions using the official template keys.\napril_values = april_features[\n    KEYS + [\"mask_regime\"]\n].copy()\napril_values[\"speed_kmh\"] = april_speed\napril_values[\"flow_vph\"] = april_flow\n\napril_predictions = april_template.drop(\n    columns=[\"speed_kmh\", \"flow_vph\"]\n).merge(\n    april_values,\n    on=KEYS + [\"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False\n)\n\n# ============================================================\n# 7. STRICT VALIDATION AND CHECKPOINT\n# ============================================================\nassert len(april_predictions) == len(april_template)\nassert april_predictions[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert april_predictions[\"speed_kmh\"].between(0, 160).all()\nassert (april_predictions[\"flow_vph\"] >= 0).all()\nassert april_predictions[KEYS].equals(april_template[KEYS]), \\\n    \"Prediction row order or keys differ from template.\"\n\napril_path = WORK / \"D12_I405_N_april_predictions.csv\"\napril_predictions.to_csv(april_path, index=False)\n\nassert april_path.exists() and april_path.stat().st_size > 0\n\nprint(\"\\nAPRIL PREDICTIONS SAVED\")\nprint(\"Rows:\", len(april_predictions))\nprint(\"Missing predictions:\",\n      int(april_predictions[[\"speed_kmh\", \"flow_vph\"]].isna().any(axis=1).sum()))\nprint(\"Speed range:\",\n      round(april_predictions[\"speed_kmh\"].min(), 3),\n      \"to\", round(april_predictions[\"speed_kmh\"].max(), 3))\nprint(\"Flow range:\",\n      round(april_predictions[\"flow_vph\"].min(), 3),\n      \"to\", round(april_predictions[\"flow_vph\"].max(), 3))\nprint(\"File:\", april_path)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:26:32.228098Z","iopub.execute_input":"2026-10-19T19:26:32.229514Z","iopub.status.idle":"2026-10-19T19:27:06.729346Z","shell.execute_reply.started":"2026-10-19T19:26:32.22946Z","shell.execute_reply":"2026-10-19T19:27:06.727999Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\n\npred_path = WORK / \"D12_I405_N_march_predictions_corrected.csv\"\ntemplate_path = (\n    ROOT / \"task1\" / panel / \"validation\" / \"sample_submission_state.csv\"\n)\n\npred = pd.read_csv(pred_path)\ntemplate = pd.read_csv(template_path)\n\nKEYS_OUT = [\n    \"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nprint(\"Prediction shape:\", pred.shape)\nprint(\"Template shape:\", template.shape)\nprint(\"\\nPrediction dtypes:\")\nprint(pred[KEYS_OUT].dtypes.to_string())\nprint(\"\\nTemplate dtypes:\")\nprint(template[KEYS_OUT].dtypes.to_string())\n\n# Normalize timestamp representation before comparing\npred[\"timestamp\"] = pd.to_datetime(pred[\"timestamp\"], utc=True)\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n\nprint(\"\\nExact keys/order match after timestamp normalization:\",\n      pred[KEYS_OUT].equals(template[KEYS_OUT]))\n\nprint(\"Prediction duplicate keys:\", pred.duplicated(KEYS_OUT).sum())\nprint(\"Template duplicate keys:\", template.duplicated(KEYS_OUT).sum())\n\n# Check whether all template keys exist in predictions\ncomparison = template[KEYS_OUT].merge(\n    pred[KEYS_OUT],\n    on=KEYS_OUT,\n    how=\"outer\",\n    indicator=True\n)\nprint(\"\\nKey match counts:\")\nprint(comparison[\"_merge\"].value_counts().to_string())\n\nprint(\"\\nFirst five rows — template:\")\nprint(template[KEYS_OUT].head().to_string(index=False))\nprint(\"\\nFirst five rows — predictions:\")\nprint(pred[KEYS_OUT].head().to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:29:10.636156Z","iopub.execute_input":"2026-10-19T19:29:10.636571Z","iopub.status.idle":"2026-10-19T19:29:11.846891Z","shell.execute_reply.started":"2026-10-19T19:29:10.63654Z","shell.execute_reply":"2026-10-19T19:29:11.844832Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\n\nKEYS_OUT = [\n    \"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n]\n\nchecks = [\n    (\"validation\", WORK / \"D12_I405_N_march_predictions_corrected.csv\"),\n    (\"private\", WORK / \"D12_I405_N_april_predictions.csv\"),\n]\n\nfor split, path in checks:\n    template = pd.read_csv(\n        ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n    )\n    pred = pd.read_csv(path)\n\n    template[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\n    pred[\"timestamp\"] = pd.to_datetime(pred[\"timestamp\"], utc=True)\n\n    assert len(pred) == len(template), f\"{split}: row count mismatch\"\n    assert pred[KEYS_OUT].equals(template[KEYS_OUT]), \\\n        f\"{split}: keys/order mismatch\"\n    assert not pred.duplicated(KEYS_OUT).any(), f\"{split}: duplicate keys\"\n    assert pred[[\"speed_kmh\", \"flow_vph\"]].notna().all().all(), \\\n        f\"{split}: missing predictions\"\n    assert pred[\"speed_kmh\"].between(0, 160).all()\n    assert (pred[\"flow_vph\"] >= 0).all()\n\n    print(f\"PASS — {split}: {len(pred):,} rows; keys, order, and values valid\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:31:21.75547Z","iopub.execute_input":"2026-10-19T19:31:21.755991Z","iopub.status.idle":"2026-10-19T19:31:23.159122Z","shell.execute_reply.started":"2026-10-19T19:31:21.755954Z","shell.execute_reply":"2026-10-19T19:31:23.157936Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nprint(\"WORK:\", WORK)\n\nfor path in sorted(Path(WORK).glob(\"*predictions*.csv\")):\n    print(f\"{path.name:48s} {path.stat().st_size / 1024**2:.2f} MiB\")\n\nprint(\"\\nPanels remaining:\")\nremaining = [\n    \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\",\n    \"D7_I210_W\", \"D7_I405_N\", \"D7_I405_S\"\n]\nprint(remaining)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:32:56.34835Z","iopub.execute_input":"2026-10-19T19:32:56.348854Z","iopub.status.idle":"2026-10-19T19:32:56.359008Z","shell.execute_reply.started":"2026-10-19T19:32:56.348821Z","shell.execute_reply":"2026-10-19T19:32:56.357806Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\npanels_remaining = [\n    \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\",\n    \"D7_I210_W\", \"D7_I405_N\", \"D7_I405_S\"\n]\n\nfor p in panels_remaining:\n    root = ROOT / \"corridors\" / p / \"train\"\n\n    truth_files = list(\n        (root / \"mainline_states\").rglob(\"*.parquet\")\n    )\n    masked_files = list(\n        (root / \"mainline_states_masked\").rglob(\"*.parquet\")\n    )\n\n    truth_feb = 0\n    eligible_feb = 0\n    masked_feb_all = 0\n    masked_feb_observed = 0\n\n    # February ground truth\n    for f in truth_files:\n        if \"year_month=2031-02\" not in str(f):\n            continue\n\n        d = pd.read_parquet(\n            f, columns=[\"is_score_eligible\"]\n        )\n        truth_feb += len(d)\n        eligible_feb += int(d[\"is_score_eligible\"].eq(1).sum())\n        del d\n\n    # February mask assignments, including unobserved rows\n    for f in masked_files:\n        d = pd.read_parquet(\n            f,\n            columns=[\"timestamp\", \"is_observed\", \"mask_regime\"]\n        )\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (\n            (ts >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n            & (ts < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        )\n        d = d.loc[keep]\n        masked_feb_all += len(d)\n        masked_feb_observed += int(d[\"is_observed\"].eq(1).sum())\n        del d\n\n    print(\n        f\"{p}: truth={truth_feb:,}, eligible={eligible_feb:,}, \"\n        f\"masked_all={masked_feb_all:,}, \"\n        f\"masked_observed={masked_feb_observed:,}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:33:39.145293Z","iopub.execute_input":"2026-10-19T19:33:39.14574Z","iopub.status.idle":"2026-10-19T19:35:25.59323Z","shell.execute_reply.started":"2026-10-19T19:33:39.145708Z","shell.execute_reply":"2026-10-19T19:35:25.591733Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport gc\nimport pandas as pd\nfrom pathlib import Path\n\ndef load_february_training_data(panel_name):\n    \"\"\"\n    Load all eligible February labels and attach mask regimes from\n    the complete masked dataset, including unobserved rows.\n    Lag values are not constructed here.\n    \"\"\"\n    root = ROOT / \"corridors\" / panel_name / \"train\"\n    truth_root = root / \"mainline_states\"\n    masked_root = root / \"mainline_states_masked\"\n\n    start = pd.Timestamp(\"2031-02-01\", tz=\"UTC\")\n    end = pd.Timestamp(\"2031-03-01\", tz=\"UTC\")\n\n    # 1. Load all eligible February ground-truth labels\n    truth_parts = []\n\n    for path in truth_root.rglob(\"*.parquet\"):\n        if \"year_month=2031-02\" not in str(path):\n            continue\n\n        d = pd.read_parquet(\n            path,\n            columns=[\n                \"timestamp\", \"station_id\", \"link_id\",\n                \"speed_kmh\", \"flow_vph\", \"is_score_eligible\"\n            ]\n        )\n\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (\n            (ts >= start) & (ts < end)\n            & d[\"is_score_eligible\"].eq(1)\n        )\n\n        if keep.any():\n            part = d.loc[\n                keep,\n                [\"timestamp\", \"station_id\", \"link_id\",\n                 \"speed_kmh\", \"flow_vph\"]\n            ].copy()\n            part[\"timestamp\"] = ts.loc[keep]\n            truth_parts.append(part)\n\n        del d\n        gc.collect()\n\n    if not truth_parts:\n        raise ValueError(f\"No eligible February labels found for {panel_name}\")\n\n    truth_df = pd.concat(truth_parts, ignore_index=True)\n    del truth_parts\n    gc.collect()\n\n    truth_df = truth_df.rename(columns={\n        \"speed_kmh\": \"target_speed\",\n        \"flow_vph\": \"target_flow\"\n    })\n\n    keys = [\"timestamp\", \"station_id\", \"link_id\"]\n\n    if truth_df.duplicated(keys).any():\n        raise ValueError(f\"{panel_name}: duplicate truth keys\")\n\n    # 2. Read ALL February mask assignments, not just observed rows\n    regime_parts = []\n\n    for path in masked_root.rglob(\"*.parquet\"):\n        d = pd.read_parquet(\n            path,\n            columns=[\n                \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"\n            ]\n        )\n\n        ts = pd.to_datetime(d[\"timestamp\"], utc=True)\n        keep = (ts >= start) & (ts < end)\n\n        if keep.any():\n            part = d.loc[keep, keys + [\"mask_regime\"]].copy()\n            part[\"timestamp\"] = ts.loc[keep]\n            regime_parts.append(part)\n\n        del d\n        gc.collect()\n\n    if not regime_parts:\n        raise ValueError(f\"{panel_name}: no February mask assignments found\")\n\n    regimes_df = pd.concat(regime_parts, ignore_index=True)\n    del regime_parts\n    gc.collect()\n\n    if regimes_df.duplicated(keys).any():\n        raise ValueError(f\"{panel_name}: duplicate mask assignment keys\")\n\n    # 3. Attach regime to every eligible label\n    training_df = truth_df.merge(\n        regimes_df,\n        on=keys,\n        how=\"left\",\n        validate=\"one_to_one\",\n        indicator=True\n    )\n\n    missing_regime = int(training_df[\"_merge\"].ne(\"both\").sum())\n    training_df = training_df.drop(columns=\"_merge\")\n\n    if missing_regime:\n        raise ValueError(\n            f\"{panel_name}: {missing_regime:,} eligible labels \"\n            \"have no mask-regime assignment\"\n        )\n\n    if training_df[\"mask_regime\"].isna().any():\n        raise ValueError(f\"{panel_name}: missing mask regimes\")\n\n    if training_df[[\"target_speed\", \"target_flow\"]].isna().any().any():\n        raise ValueError(f\"{panel_name}: missing eligible target values\")\n\n    print(f\"\\n{panel_name} — February training data\")\n    print(\"Eligible labels:\", f\"{len(training_df):,}\")\n    print(\"Regime counts:\")\n    print(training_df[\"mask_regime\"].value_counts().sort_index().to_string())\n    print(\"Duplicate keys:\", training_df.duplicated(keys).sum())\n    print(\"Missing regimes:\", training_df[\"mask_regime\"].isna().sum())\n\n    return training_df, regimes_df\n\n\n# Test the function on the next panel only.\npanel_test = \"D12_I405_S\"\ntraining_d12s, regimes_d12s = load_february_training_data(panel_test)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:40:17.988627Z","iopub.execute_input":"2026-10-19T19:40:17.989211Z","iopub.status.idle":"2026-10-19T19:42:56.596155Z","shell.execute_reply.started":"2026-10-19T19:40:17.989176Z","shell.execute_reply":"2026-10-19T19:42:56.594985Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\n# Uses the existing ROOT, WORK, training_d12s, regimes_d12s\n# and KEYS variables from your previous cells.\n\nPANEL = \"D12_I405_S\"\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\ndef load_observed_february_and_january(panel_name):\n    masked_root = ROOT / \"corridors\" / panel_name / \"train\" / \"mainline_states_masked\"\n    frames = []\n\n    for f in masked_root.rglob(\"*.parquet\"):\n        # Read one file at a time; filter by actual timestamps.\n        df = pd.read_parquet(f)\n        if \"timestamp\" not in df.columns:\n            continue\n\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df = df[\n            (df[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n            (df[\"timestamp\"] <  pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        ]\n\n        if df.empty:\n            del df\n            continue\n\n        # Lag sources must be observed; regime mapping is handled separately.\n        df = df.loc[\n            df[\"is_observed\"].eq(1),\n            KEYS + [\"speed_kmh\", \"flow_vph\"]\n        ].copy()\n\n        if not df.empty:\n            frames.append(df)\n\n        del df\n        gc.collect()\n\n    if not frames:\n        raise ValueError(f\"No observed January/February data found for {panel_name}\")\n\n    observed = pd.concat(frames, ignore_index=True)\n    del frames\n    gc.collect()\n\n    if observed.duplicated(KEYS).any():\n        raise ValueError(\"Duplicate observed keys found in January/February data\")\n\n    observed = observed.rename(columns={\n        \"speed_kmh\": \"obs_speed\",\n        \"flow_vph\": \"obs_flow\"\n    })\n\n    return observed\n\n\ndef add_observed_lags(target_df, observed_df):\n    out = target_df.copy()\n    observed_df = observed_df.sort_values(KEYS)\n\n    for lag in LAGS:\n        source = observed_df[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n        source[\"timestamp\"] = source[\"timestamp\"] + pd.Timedelta(minutes=lag)\n        source = source.rename(columns={\n            \"obs_speed\": f\"lag_speed_{lag}\",\n            \"obs_flow\": f\"lag_flow_{lag}\"\n        })\n\n        out = out.merge(source, on=KEYS, how=\"left\", validate=\"one_to_one\")\n        del source\n        gc.collect()\n\n    return out\n\n\n# 1. Load observed history (January + February).\nobserved_d12s = load_observed_february_and_january(PANEL)\n\n# 2. Build target features. training_d12s already contains every eligible\n#    February label and its mask_regime.\ntraining_d12s[\"timestamp\"] = pd.to_datetime(\n    training_d12s[\"timestamp\"], utc=True\n)\n\nfeb_features_d12s = add_observed_lags(training_d12s, observed_d12s)\n\n# 3. Basic integrity checks.\nassert len(feb_features_d12s) == 271_374\nassert feb_features_d12s[\"mask_regime\"].notna().all()\nassert feb_features_d12s.duplicated(KEYS).sum() == 0\n\nlag_cols = [c for c in feb_features_d12s.columns if c.startswith(\"lag_\")]\nprint(\"Panel:\", PANEL)\nprint(\"Training rows:\", len(feb_features_d12s))\nprint(\"Regime counts:\\n\", feb_features_d12s[\"mask_regime\"].value_counts().sort_index())\nprint(\"Lag columns:\", lag_cols)\nprint(\"Missing lag values:\\n\", feb_features_d12s[lag_cols].isna().sum())\nprint(\"Feature-building integrity checks passed.\")\n\ndel observed_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:43:51.560203Z","iopub.execute_input":"2026-10-19T19:43:51.560649Z","iopub.status.idle":"2026-10-19T19:44:32.345071Z","shell.execute_reply.started":"2026-10-19T19:43:51.560618Z","shell.execute_reply":"2026-10-19T19:44:32.343391Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\ntruth_root = ROOT / \"corridors\" / PANEL / \"train\" / \"mainline_states\"\n\n# Load January ground-truth history only.\njan_parts = []\n\nfor f in truth_root.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n\n    df = pd.read_parquet(f)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df = df[\n        (df[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (df[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n\n    if not df.empty:\n        jan_parts.append(\n            df[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del df\n    gc.collect()\n\nif not jan_parts:\n    raise ValueError(\"No January 2031 ground-truth files found.\")\n\njan_truth_d12s = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\njan_truth_d12s[\"weekday\"] = jan_truth_d12s[\"timestamp\"].dt.weekday\njan_truth_d12s[\"minute_of_day\"] = (\n    jan_truth_d12s[\"timestamp\"].dt.hour * 60\n    + jan_truth_d12s[\"timestamp\"].dt.minute\n)\n\n# Robust historical profile at link × weekday × time-of-day.\nprofile_d12s = (\n    jan_truth_d12s.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n    )\n    .agg(\n        base_speed=(\"speed_kmh\", \"median\"),\n        base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\n# Fallback profiles if a link × weekday × minute combination is absent.\nlink_profile_d12s = (\n    jan_truth_d12s.groupby(\"link_id\", as_index=False)\n    .agg(\n        link_base_speed=(\"speed_kmh\", \"median\"),\n        link_base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\n# Add calendar features to February.\nfeb_features_d12s[\"timestamp\"] = pd.to_datetime(\n    feb_features_d12s[\"timestamp\"], utc=True\n)\nfeb_features_d12s[\"weekday\"] = feb_features_d12s[\"timestamp\"].dt.weekday\nfeb_features_d12s[\"minute_of_day\"] = (\n    feb_features_d12s[\"timestamp\"].dt.hour * 60\n    + feb_features_d12s[\"timestamp\"].dt.minute\n)\n\n# Remove any partially created baseline columns before rebuilding.\nfeb_features_d12s = feb_features_d12s.drop(\n    columns=[\n        \"base_speed\", \"base_flow\",\n        \"link_base_speed\", \"link_base_flow\",\n    ],\n    errors=\"ignore\",\n)\n\nfeb_features_d12s = feb_features_d12s.merge(\n    profile_d12s,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_d12s = feb_features_d12s.merge(\n    link_profile_d12s,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_d12s[\"base_speed\"] = feb_features_d12s[\"base_speed\"].fillna(\n    feb_features_d12s[\"link_base_speed\"]\n)\nfeb_features_d12s[\"base_flow\"] = feb_features_d12s[\"base_flow\"].fillna(\n    feb_features_d12s[\"link_base_flow\"]\n)\n\n# Verify baseline coverage.\nassert len(feb_features_d12s) == 271_374\nassert feb_features_d12s[\"base_speed\"].notna().all()\nassert feb_features_d12s[\"base_flow\"].notna().all()\nassert feb_features_d12s.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n).sum() == 0\n\nprint(\"Baseline profiles attached successfully.\")\nprint(\"February rows:\", f\"{len(feb_features_d12s):,}\")\nprint(\"Missing base_speed:\", feb_features_d12s[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_d12s[\"base_flow\"].isna().sum())\nprint(\"Baseline profile rows:\", f\"{len(profile_d12s):,}\")\n\ndel jan_truth_d12s, profile_d12s, link_profile_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:52:08.272723Z","iopub.execute_input":"2026-10-19T19:52:08.273227Z","iopub.status.idle":"2026-10-19T19:52:26.409678Z","shell.execute_reply.started":"2026-10-19T19:52:08.273198Z","shell.execute_reply":"2026-10-19T19:52:26.408565Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL = \"D12_I405_S\"\ndf = feb_features_d12s.sort_values(\"timestamp\").copy()\ndf[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n# Calendar features\ndf[\"weekday\"] = df[\"timestamp\"].dt.weekday\ndf[\"minute_of_day\"] = df[\"timestamp\"].dt.hour * 60 + df[\"timestamp\"].dt.minute\ndf[\"tod_sin\"] = np.sin(2 * np.pi * df[\"minute_of_day\"] / 1440)\ndf[\"tod_cos\"] = np.cos(2 * np.pi * df[\"minute_of_day\"] / 1440)\ndf[\"weekday_sin\"] = np.sin(2 * np.pi * df[\"weekday\"] / 7)\ndf[\"weekday_cos\"] = np.cos(2 * np.pi * df[\"weekday\"] / 7)\n\n# Encode IDs consistently within this panel's training data\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    df[col + \"_code\"] = pd.Categorical(df[col]).codes\n\nFEATURES_D12S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\n# Chronological holdout: last 20% of unique timestamps\nunique_times = np.sort(df[\"timestamp\"].unique())\nval_start = unique_times[int(len(unique_times) * 0.8)]\ntrain = df[df[\"timestamp\"] < val_start]\nvalid = df[df[\"timestamp\"] >= val_start]\n\ndef make_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_d12s = make_model()\nflow_model_d12s = make_model()\n\nspeed_model_d12s.fit(\n    train[FEATURES_D12S],\n    train[\"target_speed\"] - train[\"base_speed\"],\n)\nflow_model_d12s.fit(\n    train[FEATURES_D12S],\n    train[\"target_flow\"] - train[\"base_flow\"],\n)\n\nspeed_pred = np.clip(\n    valid[\"base_speed\"].to_numpy()\n    + speed_model_d12s.predict(valid[FEATURES_D12S]),\n    0, 160,\n)\nflow_pred = np.clip(\n    valid[\"base_flow\"].to_numpy()\n    + flow_model_d12s.predict(valid[FEATURES_D12S]),\n    0, None,\n)\n\n# Correct metadata for D12_I405_S\nlinks_d12s = pd.read_csv(\n    ROOT / \"corridors\" / PANEL / \"network\" / \"links.csv\"\n)\nlane_map_d12s = links_d12s[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev = valid[[\"link_id\", \"target_speed\", \"target_flow\"]].copy()\nev[\"pred_speed\"] = speed_pred\nev[\"pred_flow\"] = flow_pred\nev = ev.merge(\n    lane_map_d12s, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\n\nassert ev[\"lanes\"].notna().all() and (ev[\"lanes\"] > 0).all()\n\nspeed_rmse = np.sqrt(np.mean((ev[\"target_speed\"] - ev[\"pred_speed\"]) ** 2))\nflow_lane_rmse = np.sqrt(np.mean(\n    ((ev[\"target_flow\"] - ev[\"pred_flow\"]) / ev[\"lanes\"]) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_lane_rmse / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Panel:\", PANEL)\nprint(\"Training rows:\", f\"{len(train):,}\")\nprint(\"Holdout rows:\", f\"{len(valid):,}\")\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse:.4f}\")\nprint(f\"S_speed: {S_speed:.6f}\")\nprint(f\"S_flow: {S_flow:.6f}\")\nprint(f\"Estimated state score: {S_state:.6f}\")\n\ndel df, train, valid, ev, links_d12s, lane_map_d12s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:55:19.910251Z","iopub.execute_input":"2026-10-19T19:55:19.910646Z","iopub.status.idle":"2026-10-19T19:55:28.971624Z","shell.execute_reply.started":"2026-10-19T19:55:19.910618Z","shell.execute_reply":"2026-10-19T19:55:28.970666Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL = \"D12_I405_S\"\n\n# Recreate the feature columns consistently.\nfinal_train_d12s = feb_features_d12s.copy()\nfinal_train_d12s[\"timestamp\"] = pd.to_datetime(\n    final_train_d12s[\"timestamp\"], utc=True\n)\n\nfinal_train_d12s[\"weekday\"] = final_train_d12s[\"timestamp\"].dt.weekday\nfinal_train_d12s[\"minute_of_day\"] = (\n    final_train_d12s[\"timestamp\"].dt.hour * 60\n    + final_train_d12s[\"timestamp\"].dt.minute\n)\nfinal_train_d12s[\"tod_sin\"] = np.sin(\n    2 * np.pi * final_train_d12s[\"minute_of_day\"] / 1440\n)\nfinal_train_d12s[\"tod_cos\"] = np.cos(\n    2 * np.pi * final_train_d12s[\"minute_of_day\"] / 1440\n)\nfinal_train_d12s[\"weekday_sin\"] = np.sin(\n    2 * np.pi * final_train_d12s[\"weekday\"] / 7\n)\nfinal_train_d12s[\"weekday_cos\"] = np.cos(\n    2 * np.pi * final_train_d12s[\"weekday\"] / 7\n)\n\n# Reuse the same feature schema as the evaluated model.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    final_train_d12s[col + \"_code\"] = pd.Categorical(\n        final_train_d12s[col]\n    ).codes\n\nFEATURES_D12S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nassert len(final_train_d12s) == 271_374\nassert final_train_d12s[FEATURES_D12S].notna().all(axis=None) or (\n    final_train_d12s[FEATURES_D12S].isna().sum().sum() > 0\n)\n\ndef make_final_model():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_d12s_final = make_final_model()\nflow_model_d12s_final = make_final_model()\n\nspeed_model_d12s_final.fit(\n    final_train_d12s[FEATURES_D12S],\n    final_train_d12s[\"target_speed\"] - final_train_d12s[\"base_speed\"],\n)\nflow_model_d12s_final.fit(\n    final_train_d12s[FEATURES_D12S],\n    final_train_d12s[\"target_flow\"] - final_train_d12s[\"base_flow\"],\n)\n\nprint(\"Final models fitted on all eligible February rows.\")\nprint(\"Training rows:\", f\"{len(final_train_d12s):,}\")\nprint(\"Feature count:\", len(FEATURES_D12S))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T19:58:54.847708Z","iopub.execute_input":"2026-10-19T19:58:54.849229Z","iopub.status.idle":"2026-10-19T19:59:04.722677Z","shell.execute_reply.started":"2026-10-19T19:58:54.849184Z","shell.execute_reply":"2026-10-19T19:59:04.721356Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nPANEL = \"D12_I405_S\"\npanel_root = ROOT / \"corridors\" / PANEL\n\n# Persist category mappings from the training data.\ncategory_maps_d12s = {\n    col: {\n        value: code\n        for code, value in enumerate(\n            pd.Categorical(final_train_d12s[col]).categories\n        )\n    }\n    for col in [\"station_id\", \"link_id\", \"mask_regime\"]\n}\n\nprint(\"Panel:\", PANEL)\nprint(\"Training category counts:\")\nfor col, mapping in category_maps_d12s.items():\n    print(f\"  {col}: {len(mapping):,} categories\")\n\nfor split in [\"validation\", \"private\"]:\n    masked_root = panel_root / split / \"mainline_states_masked\"\n    files = list(masked_root.rglob(\"*.parquet\"))\n    print(f\"{split}: {len(files)} parquet files; exists={masked_root.exists()}\")\n\nprint(\"Feature schema ready:\", len(FEATURES_D12S), \"features\")\nprint(\"Models ready:\", \n      hasattr(speed_model_d12s_final, \"predict\"),\n      hasattr(flow_model_d12s_final, \"predict\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:03:13.604286Z","iopub.execute_input":"2026-10-19T20:03:13.604825Z","iopub.status.idle":"2026-10-19T20:03:13.705498Z","shell.execute_reply.started":"2026-10-19T20:03:13.604761Z","shell.execute_reply":"2026-10-19T20:03:13.704419Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\nval_root = ROOT / \"corridors\" / PANEL / \"validation\" / \"mainline_states_masked\"\n\nfiles = sorted(val_root.rglob(\"*.parquet\"))\nassert len(files) == 31, f\"Expected 31 validation files, found {len(files)}\"\n\nsample = pd.read_parquet(files[0])\nprint(\"Sample file:\", files[0].name)\nprint(\"Columns:\", sample.columns.tolist())\nprint(\"Rows in sample file:\", len(sample))\nprint(\"\\nMask regime counts:\")\nprint(sample[\"mask_regime\"].value_counts(dropna=False))\nprint(\"\\nObserved counts:\")\nprint(sample[\"is_observed\"].value_counts(dropna=False))\nprint(\"\\nTimestamp range:\")\nprint(pd.to_datetime(sample[\"timestamp\"], utc=True).min(),\n      \"to\",\n      pd.to_datetime(sample[\"timestamp\"], utc=True).max())\n\ndel sample","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:04:13.016519Z","iopub.execute_input":"2026-10-19T20:04:13.01701Z","iopub.status.idle":"2026-10-19T20:04:13.123846Z","shell.execute_reply.started":"2026-10-19T20:04:13.016969Z","shell.execute_reply":"2026-10-19T20:04:13.121427Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\nPANEL = \"D12_I405_S\"\npanel_root = ROOT / \"corridors\" / PANEL\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\n# 1. Load January ground-truth data to recreate historical baseline profiles.\ntruth_root = panel_root / \"train\" / \"mainline_states\"\njan_parts = []\n\nfor f in truth_root.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n    if not x.empty:\n        jan_parts.append(x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy())\n    del x\n    gc.collect()\n\nif not jan_parts:\n    raise ValueError(\"January 2031 truth data not found.\")\n\njan = pd.concat(jan_parts, ignore_index=True)\ndel jan_parts\ngc.collect()\n\njan[\"weekday\"] = jan[\"timestamp\"].dt.weekday\njan[\"minute_of_day\"] = jan[\"timestamp\"].dt.hour * 60 + jan[\"timestamp\"].dt.minute\n\nprofile = jan.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile = jan.groupby(\"link_id\", as_index=False).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\n# 2. Load observed Jan/Feb history for lag features.\nmasked_train_root = panel_root / \"train\" / \"mainline_states_masked\"\nobs_parts = []\n\nfor f in masked_train_root.rglob(\"*.parquet\"):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-03-01\", tz=\"UTC\")) &\n        x[\"is_observed\"].eq(1)\n    ]\n    if not x.empty:\n        obs_parts.append(x[KEYS + [\"speed_kmh\", \"flow_vph\"]].copy())\n    del x\n    gc.collect()\n\nobserved = pd.concat(obs_parts, ignore_index=True)\ndel obs_parts\ngc.collect()\n\nobserved = observed.rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\nif observed.duplicated(KEYS).any():\n    raise ValueError(\"Duplicate observed keys in training history.\")\n\n# 3. Read March validation rows; preserve all keys and template order.\nval_root = panel_root / \"validation\" / \"mainline_states_masked\"\nval_parts = []\n\nfor f in sorted(val_root.rglob(\"*.parquet\")):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    val_parts.append(x)\n    del x\n    gc.collect()\n\nmarch = pd.concat(val_parts, ignore_index=True)\ndel val_parts\ngc.collect()\n\nmarch[\"timestamp\"] = pd.to_datetime(march[\"timestamp\"], utc=True)\nmarch[\"weekday\"] = march[\"timestamp\"].dt.weekday\nmarch[\"minute_of_day\"] = march[\"timestamp\"].dt.hour * 60 + march[\"timestamp\"].dt.minute\n\n# Baseline profile lookup, only from January.\nmarch = march.merge(\n    profile,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch = march.merge(link_profile, on=\"link_id\", how=\"left\", validate=\"many_to_one\")\nmarch[\"base_speed\"] = march[\"base_speed\"].fillna(march[\"link_base_speed\"])\nmarch[\"base_flow\"] = march[\"base_flow\"].fillna(march[\"link_base_flow\"])\n\n# 4. Lag features from observed history, shifted forward by the lag interval.\nfor lag in LAGS:\n    src = observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] = src[\"timestamp\"] + pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    march = march.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    del src\n    gc.collect()\n\n# March observations can also supply earlier lags for later March rows.\nmarch_observed = march.loc[\n    march[\"is_observed\"].eq(1),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\"speed_kmh\": \"obs_speed\", \"flow_vph\": \"obs_flow\"})\n\nfor lag in LAGS:\n    src = march_observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] = src[\"timestamp\"] + pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"march_lag_speed_{lag}\",\n        \"obs_flow\": f\"march_lag_flow_{lag}\",\n    })\n    march = march.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    march[f\"lag_speed_{lag}\"] = march[f\"lag_speed_{lag}\"].fillna(\n        march[f\"march_lag_speed_{lag}\"]\n    )\n    march[f\"lag_flow_{lag}\"] = march[f\"lag_flow_{lag}\"].fillna(\n        march[f\"march_lag_flow_{lag}\"]\n    )\n    march.drop(columns=[f\"march_lag_speed_{lag}\", f\"march_lag_flow_{lag}\"], inplace=True)\n    del src\n    gc.collect()\n\n# 5. Apply training category mappings.\nmarch[\"weekday\"] = march[\"timestamp\"].dt.weekday\nmarch[\"minute_of_day\"] = march[\"timestamp\"].dt.hour * 60 + march[\"timestamp\"].dt.minute\nmarch[\"tod_sin\"] = np.sin(2 * np.pi * march[\"minute_of_day\"] / 1440)\nmarch[\"tod_cos\"] = np.cos(2 * np.pi * march[\"minute_of_day\"] / 1440)\nmarch[\"weekday_sin\"] = np.sin(2 * np.pi * march[\"weekday\"] / 7)\nmarch[\"weekday_cos\"] = np.cos(2 * np.pi * march[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    march[col + \"_code\"] = (\n        march[col].map(category_maps_d12s[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict.\nX_march = march[FEATURES_D12S].replace([np.inf, -np.inf], np.nan)\nmarch[\"pred_speed\"] = np.clip(\n    march[\"base_speed\"].to_numpy() + speed_model_d12s_final.predict(X_march),\n    0, 160,\n)\nmarch[\"pred_flow\"] = np.clip(\n    march[\"base_flow\"].to_numpy() + flow_model_d12s_final.predict(X_march),\n    0, None,\n)\n\n# 7. Verify against official validation template.\ntemplate_path = ROOT / \"task1\" / PANEL / \"validation\" / \"sample_submission_state.csv\"\nif not template_path.exists():\n    # Fall back to the unified task template, if panel-specific template isn't present.\n    template_path = ROOT / \"task1\" / \"sample_submission.csv\"\n\ntemplate = pd.read_csv(template_path)\nif \"panel\" in template.columns:\n    template = template[template[\"panel\"].eq(PANEL)].copy()\n\n# Match prediction keys to template columns.\nkey_candidates = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\nfor c in key_candidates:\n    if c not in template.columns:\n        raise ValueError(f\"Template missing expected key column: {c}\")\n\nmarch_keys = march[key_candidates].copy()\ntemplate_keys = template[key_candidates].copy()\nmarch_keys[\"timestamp\"] = pd.to_datetime(march_keys[\"timestamp\"], utc=True)\ntemplate_keys[\"timestamp\"] = pd.to_datetime(template_keys[\"timestamp\"], utc=True)\n\nassert not march_keys.duplicated(key_candidates).any()\nassert len(march_keys) == len(template_keys), (len(march_keys), len(template_keys))\nassert march_keys.reset_index(drop=True).equals(template_keys.reset_index(drop=True)), \\\n    \"Prediction keys/order do not match the official validation template.\"\n\nout_path = WORK / \"D12_I405_S_march_predictions_verified.csv\"\nmarch[KEYS + [\"mask_regime\", \"pred_speed\", \"pred_flow\"]].to_csv(out_path, index=False)\n\nprint(\"Validation predictions generated:\", len(march))\nprint(\"Missing speed predictions:\", march[\"pred_speed\"].isna().sum())\nprint(\"Missing flow predictions:\", march[\"pred_flow\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Template key/order verification passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:06:27.666121Z","iopub.execute_input":"2026-10-19T20:06:27.666584Z","iopub.status.idle":"2026-10-19T20:09:47.340517Z","shell.execute_reply.started":"2026-10-19T20:06:27.666554Z","shell.execute_reply":"2026-10-19T20:09:47.338739Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\n\ntemplate_path = (\n    ROOT / \"task1\" / PANEL / \"validation\" / \"sample_submission_state.csv\"\n)\ntemplate = pd.read_csv(template_path)\n\nKEYS_OUT = [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n\n# Normalize join keys.\ntemplate[\"timestamp\"] = pd.to_datetime(template[\"timestamp\"], utc=True)\nmarch[\"timestamp\"] = pd.to_datetime(march[\"timestamp\"], utc=True)\n\n# Select only the keys required by the official template.\npred_source = march[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\n).any(), \"Duplicate prediction keys found.\"\n\n# Left join from template: guarantees official row order and exact row coverage.\ntemplate[\"_row_order\"] = np.arange(len(template))\n\nresult = template.merge(\n    pred_source,\n    on=[\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"],\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n)\n\nresult = result.sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(result) == len(template)\nassert result[\"pred_speed\"].notna().all(), (\n    f\"Missing speed predictions: {result['pred_speed'].isna().sum()}\"\n)\nassert result[\"pred_flow\"].notna().all(), (\n    f\"Missing flow predictions: {result['pred_flow'].isna().sum()}\"\n)\n\n# Fill only the target columns; retain template identifiers and order.\nresult[\"speed_kmh\"] = result[\"pred_speed\"]\nresult[\"flow_vph\"] = result[\"pred_flow\"]\n\nout_path = WORK / \"D12_I405_S_march_predictions_verified.csv\"\nresult[[\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n        \"mask_regime\", \"speed_kmh\", \"flow_vph\"]].to_csv(out_path, index=False)\n\nprint(\"Rows:\", len(result))\nprint(\"Missing speed:\", result[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", result[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Official template order preserved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:12:26.897172Z","iopub.execute_input":"2026-10-19T20:12:26.897545Z","iopub.status.idle":"2026-10-19T20:12:28.778713Z","shell.execute_reply.started":"2026-10-19T20:12:26.897517Z","shell.execute_reply":"2026-10-19T20:12:28.777379Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"PANEL = \"D12_I405_S\"\n\nprivate_template_path = (\n    ROOT / \"task1\" / PANEL / \"private\" / \"sample_submission_state.csv\"\n)\n\nprint(\"Private template exists:\", private_template_path.exists())\n\nif private_template_path.exists():\n    private_template = pd.read_csv(private_template_path)\n    print(\"Expected private rows:\", len(private_template))\n    print(\"Columns:\", private_template.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:13:58.882624Z","iopub.execute_input":"2026-10-19T20:13:58.883126Z","iopub.status.idle":"2026-10-19T20:13:59.102138Z","shell.execute_reply.started":"2026-10-19T20:13:58.883097Z","shell.execute_reply":"2026-10-19T20:13:59.101001Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL = \"D12_I405_S\"\npanel_root = ROOT / \"corridors\" / PANEL\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS = [5, 15, 60, 1440]\n\n# 1. Load April masked data.\nprivate_root = panel_root / \"private\" / \"mainline_states_masked\"\napril_parts = []\n\nfor f in sorted(private_root.rglob(\"*.parquet\")):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    april_parts.append(x)\n    del x\n    gc.collect()\n\napril = pd.concat(april_parts, ignore_index=True)\ndel april_parts\ngc.collect()\n\napril[\"timestamp\"] = pd.to_datetime(april[\"timestamp\"], utc=True)\napril[\"weekday\"] = april[\"timestamp\"].dt.weekday\napril[\"minute_of_day\"] = (\n    april[\"timestamp\"].dt.hour * 60 + april[\"timestamp\"].dt.minute\n)\n\n# 2. Attach January historical baselines.\napril = april.merge(\n    profile,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\napril = april.merge(\n    link_profile, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\napril[\"base_speed\"] = april[\"base_speed\"].fillna(april[\"link_base_speed\"])\napril[\"base_flow\"] = april[\"base_flow\"].fillna(april[\"link_base_flow\"])\n\n# 3. Use observed Jan/Feb values for historical lags.\nfor lag in LAGS:\n    src = observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    april = april.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    del src\n    gc.collect()\n\n# 4. Use observed April values for lags when available.\napril_observed = april.loc[\n    april[\"is_observed\"].eq(1),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\"speed_kmh\": \"obs_speed\", \"flow_vph\": \"obs_flow\"})\n\nfor lag in LAGS:\n    src = april_observed[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"april_lag_speed_{lag}\",\n        \"obs_flow\": f\"april_lag_flow_{lag}\",\n    })\n    april = april.merge(src, on=KEYS, how=\"left\", validate=\"one_to_one\")\n    april[f\"lag_speed_{lag}\"] = april[f\"lag_speed_{lag}\"].fillna(\n        april[f\"april_lag_speed_{lag}\"]\n    )\n    april[f\"lag_flow_{lag}\"] = april[f\"lag_flow_{lag}\"].fillna(\n        april[f\"april_lag_flow_{lag}\"]\n    )\n    april.drop(\n        columns=[f\"april_lag_speed_{lag}\", f\"april_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar features and the training category mappings.\napril[\"weekday\"] = april[\"timestamp\"].dt.weekday\napril[\"minute_of_day\"] = april[\"timestamp\"].dt.hour * 60 + april[\"timestamp\"].dt.minute\napril[\"tod_sin\"] = np.sin(2 * np.pi * april[\"minute_of_day\"] / 1440)\napril[\"tod_cos\"] = np.cos(2 * np.pi * april[\"minute_of_day\"] / 1440)\napril[\"weekday_sin\"] = np.sin(2 * np.pi * april[\"weekday\"] / 7)\napril[\"weekday_cos\"] = np.cos(2 * np.pi * april[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    april[col + \"_code\"] = (\n        april[col].map(category_maps_d12s[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict the full April panel.\nX_april = april[FEATURES_D12S].replace([np.inf, -np.inf], np.nan)\napril[\"pred_speed\"] = np.clip(\n    april[\"base_speed\"].to_numpy()\n    + speed_model_d12s_final.predict(X_april),\n    0, 160,\n)\napril[\"pred_flow\"] = np.clip(\n    april[\"base_flow\"].to_numpy()\n    + flow_model_d12s_final.predict(X_april),\n    0, None,\n)\n\n# 7. Align exactly to the official private template.\nprivate_template = pd.read_csv(\n    ROOT / \"task1\" / PANEL / \"private\" / \"sample_submission_state.csv\"\n)\nprivate_template[\"timestamp\"] = pd.to_datetime(\n    private_template[\"timestamp\"], utc=True\n)\n\npred_source = april[\n    [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"pred_speed\", \"pred_flow\"]\n].copy()\n\njoin_keys = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\nassert not pred_source.duplicated(join_keys).any()\n\nprivate_template[\"_row_order\"] = np.arange(len(private_template))\nprivate_result = private_template.merge(\n    pred_source,\n    on=join_keys,\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n).sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(private_result) == 107_416\nassert private_result[\"pred_speed\"].notna().all(), (\n    f\"Missing speed predictions: {private_result['pred_speed'].isna().sum()}\"\n)\nassert private_result[\"pred_flow\"].notna().all(), (\n    f\"Missing flow predictions: {private_result['pred_flow'].isna().sum()}\"\n)\n\nprivate_result[\"speed_kmh\"] = private_result[\"pred_speed\"]\nprivate_result[\"flow_vph\"] = private_result[\"pred_flow\"]\n\nout_path = WORK / \"D12_I405_S_april_predictions_verified.csv\"\nprivate_result[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n     \"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].to_csv(out_path, index=False)\n\nprint(\"Private predictions:\", len(private_result))\nprint(\"Missing speed:\", private_result[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", private_result[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path)\nprint(\"Official private template order preserved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:14:38.579223Z","iopub.execute_input":"2026-10-19T20:14:38.579638Z","iopub.status.idle":"2026-10-19T20:15:14.247701Z","shell.execute_reply.started":"2026-10-19T20:14:38.579607Z","shell.execute_reply":"2026-10-19T20:15:14.246465Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport gc\n\nmarch_path = WORK / \"D12_I405_S_march_predictions_verified.csv\"\napril_path = WORK / \"D12_I405_S_april_predictions_verified.csv\"\ncheckpoint_path = WORK / \"D12_I405_S_predictions_checkpoint.csv\"\n\nmarch_ckpt = pd.read_csv(march_path)\napril_ckpt = pd.read_csv(april_path)\n\nmarch_ckpt[\"split\"] = \"validation\"\napril_ckpt[\"split\"] = \"private\"\n\ncheckpoint = pd.concat(\n    [march_ckpt, april_ckpt],\n    ignore_index=True\n)\n\nassert len(march_ckpt) == 93_718\nassert len(april_ckpt) == 107_416\nassert not checkpoint.duplicated(\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"split\"]\n).any()\nassert checkpoint[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n\ncheckpoint.to_csv(checkpoint_path, index=False)\n\nprint(\"Panel:\", \"D12_I405_S\")\nprint(\"Validation rows:\", len(march_ckpt))\nprint(\"Private rows:\", len(april_ckpt))\nprint(\"Checkpoint rows:\", len(checkpoint))\nprint(\"Saved:\", checkpoint_path)\n\ndel march_ckpt, april_ckpt, checkpoint\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:17:01.774973Z","iopub.execute_input":"2026-10-19T20:17:01.776361Z","iopub.status.idle":"2026-10-19T20:17:04.381941Z","shell.execute_reply.started":"2026-10-19T20:17:01.77631Z","shell.execute_reply":"2026-10-19T20:17:04.380698Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"panel_test = \"D12_I5_N\"\ntraining_i5n, regimes_i5n = load_february_training_data(panel_test)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:17:59.047792Z","iopub.execute_input":"2026-10-19T20:17:59.049046Z","iopub.status.idle":"2026-10-19T20:20:48.918974Z","shell.execute_reply.started":"2026-10-19T20:17:59.048881Z","shell.execute_reply":"2026-10-19T20:20:48.917615Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"panel_i5n = \"D12_I5_N\"\nobserved_i5n = load_observed_february_and_january(panel_i5n)\n\nfeb_features_i5n = add_observed_lags(\n    training_i5n,\n    observed_i5n\n)\n\nassert len(feb_features_i5n) == 1_588_503\nassert feb_features_i5n.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n).sum() == 0\nassert feb_features_i5n[\"mask_regime\"].notna().all()\n\nprint(\"Panel:\", panel_i5n)\nprint(\"Training rows:\", f\"{len(feb_features_i5n):,}\")\nprint(\"Missing lag values:\")\nprint(\n    feb_features_i5n[\n        [c for c in feb_features_i5n.columns if c.startswith(\"lag_\")]\n    ].isna().sum()\n)\nprint(\"Feature integrity checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:21:50.406823Z","iopub.execute_input":"2026-10-19T20:21:50.407294Z","iopub.status.idle":"2026-10-19T20:22:58.843134Z","shell.execute_reply.started":"2026-10-19T20:21:50.407264Z","shell.execute_reply":"2026-10-19T20:22:58.841842Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL_I5N = \"D12_I5_N\"\ntruth_root_i5n = ROOT / \"corridors\" / PANEL_I5N / \"train\" / \"mainline_states\"\n\njan_parts_i5n = []\n\nfor f in truth_root_i5n.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n\n    if not x.empty:\n        jan_parts_i5n.append(\n            x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del x\n    gc.collect()\n\nif not jan_parts_i5n:\n    raise ValueError(\"No January 2031 truth files found for D12_I5_N.\")\n\njan_truth_i5n = pd.concat(jan_parts_i5n, ignore_index=True)\ndel jan_parts_i5n\ngc.collect()\n\njan_truth_i5n[\"weekday\"] = jan_truth_i5n[\"timestamp\"].dt.weekday\njan_truth_i5n[\"minute_of_day\"] = (\n    jan_truth_i5n[\"timestamp\"].dt.hour * 60\n    + jan_truth_i5n[\"timestamp\"].dt.minute\n)\n\nprofile_i5n = jan_truth_i5n.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile_i5n = jan_truth_i5n.groupby(\n    \"link_id\", as_index=False\n).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\nfeb_features_i5n = feb_features_i5n.merge(\n    profile_i5n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n) if {\"weekday\", \"minute_of_day\"}.issubset(feb_features_i5n.columns) else feb_features_i5n\n\nif \"base_speed\" not in feb_features_i5n.columns:\n    feb_features_i5n[\"weekday\"] = pd.to_datetime(\n        feb_features_i5n[\"timestamp\"], utc=True\n    ).dt.weekday\n    feb_features_i5n[\"minute_of_day\"] = (\n        pd.to_datetime(feb_features_i5n[\"timestamp\"], utc=True).dt.hour * 60\n        + pd.to_datetime(feb_features_i5n[\"timestamp\"], utc=True).dt.minute\n    )\n    feb_features_i5n = feb_features_i5n.merge(\n        profile_i5n,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\nfeb_features_i5n = feb_features_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i5n[\"base_speed\"] = feb_features_i5n[\"base_speed\"].fillna(\n    feb_features_i5n[\"link_base_speed\"]\n)\nfeb_features_i5n[\"base_flow\"] = feb_features_i5n[\"base_flow\"].fillna(\n    feb_features_i5n[\"link_base_flow\"]\n)\n\nassert len(feb_features_i5n) == 1_588_503\nassert feb_features_i5n[\"base_speed\"].notna().all()\nassert feb_features_i5n[\"base_flow\"].notna().all()\n\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Rows:\", f\"{len(feb_features_i5n):,}\")\nprint(\"Baseline profile rows:\", f\"{len(profile_i5n):,}\")\nprint(\"Missing base_speed:\", feb_features_i5n[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_i5n[\"base_flow\"].isna().sum())\nprint(\"Baseline checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:24:09.398382Z","iopub.execute_input":"2026-10-19T20:24:09.39895Z","iopub.status.idle":"2026-10-19T20:24:31.028883Z","shell.execute_reply.started":"2026-10-19T20:24:09.398916Z","shell.execute_reply":"2026-10-19T20:24:31.027625Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL_I5N = \"D12_I5_N\"\ndf_i5n = feb_features_i5n.copy()\ndf_i5n[\"timestamp\"] = pd.to_datetime(df_i5n[\"timestamp\"], utc=True)\n\ndf_i5n[\"weekday\"] = df_i5n[\"timestamp\"].dt.weekday\ndf_i5n[\"minute_of_day\"] = (\n    df_i5n[\"timestamp\"].dt.hour * 60 + df_i5n[\"timestamp\"].dt.minute\n)\ndf_i5n[\"tod_sin\"] = np.sin(2 * np.pi * df_i5n[\"minute_of_day\"] / 1440)\ndf_i5n[\"tod_cos\"] = np.cos(2 * np.pi * df_i5n[\"minute_of_day\"] / 1440)\ndf_i5n[\"weekday_sin\"] = np.sin(2 * np.pi * df_i5n[\"weekday\"] / 7)\ndf_i5n[\"weekday_cos\"] = np.cos(2 * np.pi * df_i5n[\"weekday\"] / 7)\n\n# Save mappings so March/April use the same encoding.\ncategory_maps_i5n = {}\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = pd.Categorical(df_i5n[col]).categories\n    category_maps_i5n[col] = {value: code for code, value in enumerate(categories)}\n    df_i5n[col + \"_code\"] = pd.Categorical(df_i5n[col], categories=categories).codes\n\nFEATURES_I5N = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\n# Chronological holdout: last 20% of unique timestamps.\nunique_times_i5n = np.sort(df_i5n[\"timestamp\"].unique())\nval_start_i5n = unique_times_i5n[int(len(unique_times_i5n) * 0.8)]\ntrain_mask_i5n = df_i5n[\"timestamp\"] < val_start_i5n\nvalid_mask_i5n = ~train_mask_i5n\n\nX_i5n = df_i5n[FEATURES_I5N].replace([np.inf, -np.inf], np.nan)\ny_speed_i5n = df_i5n[\"target_speed\"].to_numpy(dtype=float)\ny_flow_i5n = df_i5n[\"target_flow\"].to_numpy(dtype=float)\nbase_speed_i5n = df_i5n[\"base_speed\"].to_numpy(dtype=float)\nbase_flow_i5n = df_i5n[\"base_flow\"].to_numpy(dtype=float)\n\nvalid_labels_i5n = (\n    np.isfinite(y_speed_i5n) & np.isfinite(y_flow_i5n)\n    & np.isfinite(base_speed_i5n) & np.isfinite(base_flow_i5n)\n)\ntrain_idx_i5n = np.flatnonzero(train_mask_i5n.to_numpy() & valid_labels_i5n)\nvalid_idx_i5n = np.flatnonzero(valid_mask_i5n.to_numpy() & valid_labels_i5n)\n\ndef make_model_i5n():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5n = make_model_i5n()\nflow_model_i5n = make_model_i5n()\n\nspeed_model_i5n.fit(\n    X_i5n.iloc[train_idx_i5n],\n    y_speed_i5n[train_idx_i5n] - base_speed_i5n[train_idx_i5n],\n)\nflow_model_i5n.fit(\n    X_i5n.iloc[train_idx_i5n],\n    y_flow_i5n[train_idx_i5n] - base_flow_i5n[train_idx_i5n],\n)\n\npred_speed_i5n = np.clip(\n    base_speed_i5n[valid_idx_i5n]\n    + speed_model_i5n.predict(X_i5n.iloc[valid_idx_i5n]),\n    0, 160,\n)\npred_flow_i5n = np.clip(\n    base_flow_i5n[valid_idx_i5n]\n    + flow_model_i5n.predict(X_i5n.iloc[valid_idx_i5n]),\n    0, None,\n)\n\nlinks_i5n = pd.read_csv(\n    ROOT / \"corridors\" / PANEL_I5N / \"network\" / \"links.csv\"\n)\nlane_map_i5n = links_i5n[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev_i5n = df_i5n.iloc[valid_idx_i5n][\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\nev_i5n[\"pred_speed\"] = pred_speed_i5n\nev_i5n[\"pred_flow\"] = pred_flow_i5n\nev_i5n = ev_i5n.merge(\n    lane_map_i5n, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nassert ev_i5n[\"lanes\"].notna().all() and (ev_i5n[\"lanes\"] > 0).all()\n\nspeed_rmse_i5n = np.sqrt(np.mean(\n    (ev_i5n[\"target_speed\"] - ev_i5n[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse_i5n = np.sqrt(np.mean(\n    ((ev_i5n[\"target_flow\"] - ev_i5n[\"pred_flow\"]) / ev_i5n[\"lanes\"]) ** 2\n))\n\nS_speed_i5n = max(0, 1 - speed_rmse_i5n / 25)\nS_flow_i5n = max(0, 1 - flow_lane_rmse_i5n / 600)\nS_state_i5n = 0.54 * S_speed_i5n + 0.46 * S_flow_i5n\n\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Training rows:\", f\"{len(train_idx_i5n):,}\")\nprint(\"Holdout rows:\", f\"{len(valid_idx_i5n):,}\")\nprint(f\"Speed RMSE: {speed_rmse_i5n:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse_i5n:.4f}\")\nprint(f\"S_speed: {S_speed_i5n:.6f}\")\nprint(f\"S_flow: {S_flow_i5n:.6f}\")\nprint(f\"Estimated state score: {S_state_i5n:.6f}\")\n\ndel X_i5n, links_i5n, lane_map_i5n, ev_i5n\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:25:51.725397Z","iopub.execute_input":"2026-10-19T20:25:51.726249Z","iopub.status.idle":"2026-10-19T20:26:32.932047Z","shell.execute_reply.started":"2026-10-19T20:25:51.726176Z","shell.execute_reply":"2026-10-19T20:26:32.930981Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL_I5N = \"D12_I5_N\"\n\nfinal_train_i5n = feb_features_i5n.copy()\nfinal_train_i5n[\"timestamp\"] = pd.to_datetime(\n    final_train_i5n[\"timestamp\"], utc=True\n)\n\nfinal_train_i5n[\"weekday\"] = final_train_i5n[\"timestamp\"].dt.weekday\nfinal_train_i5n[\"minute_of_day\"] = (\n    final_train_i5n[\"timestamp\"].dt.hour * 60\n    + final_train_i5n[\"timestamp\"].dt.minute\n)\nfinal_train_i5n[\"tod_sin\"] = np.sin(\n    2 * np.pi * final_train_i5n[\"minute_of_day\"] / 1440\n)\nfinal_train_i5n[\"tod_cos\"] = np.cos(\n    2 * np.pi * final_train_i5n[\"minute_of_day\"] / 1440\n)\nfinal_train_i5n[\"weekday_sin\"] = np.sin(\n    2 * np.pi * final_train_i5n[\"weekday\"] / 7\n)\nfinal_train_i5n[\"weekday_cos\"] = np.cos(\n    2 * np.pi * final_train_i5n[\"weekday\"] / 7\n)\n\n# Apply the same mappings used for evaluation.\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    final_train_i5n[col + \"_code\"] = (\n        final_train_i5n[col].map(category_maps_i5n[col]).astype(\"int16\")\n    )\n\nassert len(final_train_i5n) == 1_588_503\nassert final_train_i5n[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\ndef make_final_model_i5n():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5n_final = make_final_model_i5n()\nflow_model_i5n_final = make_final_model_i5n()\n\nspeed_model_i5n_final.fit(\n    final_train_i5n[FEATURES_I5N],\n    final_train_i5n[\"target_speed\"] - final_train_i5n[\"base_speed\"],\n)\nflow_model_i5n_final.fit(\n    final_train_i5n[FEATURES_I5N],\n    final_train_i5n[\"target_flow\"] - final_train_i5n[\"base_flow\"],\n)\n\nprint(\"Final models fitted.\")\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Training rows:\", f\"{len(final_train_i5n):,}\")\nprint(\"Features:\", len(FEATURES_I5N))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:27:33.312861Z","iopub.execute_input":"2026-10-19T20:27:33.31362Z","iopub.status.idle":"2026-10-19T20:28:14.483982Z","shell.execute_reply.started":"2026-10-19T20:27:33.31358Z","shell.execute_reply":"2026-10-19T20:28:14.482727Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\"Baseline profile:\", \"profile_i5n\" in globals())\nprint(\"Link fallback:\", \"link_profile_i5n\" in globals())\nprint(\"Observed history:\", \"observed_i5n\" in globals())\nprint(\"Category mappings:\", \"category_maps_i5n\" in globals())\nprint(\"Feature schema:\", \"FEATURES_I5N\" in globals())\nprint(\"Speed model:\", \"speed_model_i5n_final\" in globals())\nprint(\"Flow model:\", \"flow_model_i5n_final\" in globals())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:29:33.348611Z","iopub.execute_input":"2026-10-19T20:29:33.349118Z","iopub.status.idle":"2026-10-19T20:29:33.356827Z","shell.execute_reply.started":"2026-10-19T20:29:33.349087Z","shell.execute_reply":"2026-10-19T20:29:33.35557Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL_I5N = \"D12_I5_N\"\npanel_root_i5n = ROOT / \"corridors\" / PANEL_I5N\nKEYS_I5N = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS_I5N = [5, 15, 60, 1440]\n\n# 1. Load March validation data.\nval_root_i5n = panel_root_i5n / \"validation\" / \"mainline_states_masked\"\nmarch_parts_i5n = []\n\nfor f in sorted(val_root_i5n.rglob(\"*.parquet\")):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    march_parts_i5n.append(x)\n    del x\n    gc.collect()\n\nmarch_i5n = pd.concat(march_parts_i5n, ignore_index=True)\ndel march_parts_i5n\ngc.collect()\n\nmarch_i5n[\"timestamp\"] = pd.to_datetime(march_i5n[\"timestamp\"], utc=True)\nmarch_i5n[\"weekday\"] = march_i5n[\"timestamp\"].dt.weekday\nmarch_i5n[\"minute_of_day\"] = (\n    march_i5n[\"timestamp\"].dt.hour * 60 + march_i5n[\"timestamp\"].dt.minute\n)\n\n# 2. Attach January historical baseline profiles.\nmarch_i5n = march_i5n.merge(\n    profile_i5n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch_i5n = march_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nmarch_i5n[\"base_speed\"] = march_i5n[\"base_speed\"].fillna(\n    march_i5n[\"link_base_speed\"]\n)\nmarch_i5n[\"base_flow\"] = march_i5n[\"base_flow\"].fillna(\n    march_i5n[\"link_base_flow\"]\n)\n\n# 3. Add lag features from observed January/February history.\nfor lag in LAGS_I5N:\n    src = observed_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    march_i5n = march_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    del src\n    gc.collect()\n\n# 4. Add lags from observed March values for later March timestamps.\nmarch_obs_i5n = march_i5n.loc[\n    march_i5n[\"is_observed\"].eq(1),\n    KEYS_I5N + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\n\nfor lag in LAGS_I5N:\n    src = march_obs_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"march_lag_speed_{lag}\",\n        \"obs_flow\": f\"march_lag_flow_{lag}\",\n    })\n    march_i5n = march_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    march_i5n[f\"lag_speed_{lag}\"] = march_i5n[f\"lag_speed_{lag}\"].fillna(\n        march_i5n[f\"march_lag_speed_{lag}\"]\n    )\n    march_i5n[f\"lag_flow_{lag}\"] = march_i5n[f\"lag_flow_{lag}\"].fillna(\n        march_i5n[f\"march_lag_flow_{lag}\"]\n    )\n    march_i5n.drop(\n        columns=[f\"march_lag_speed_{lag}\", f\"march_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar features and saved training encodings.\nmarch_i5n[\"weekday\"] = march_i5n[\"timestamp\"].dt.weekday\nmarch_i5n[\"minute_of_day\"] = (\n    march_i5n[\"timestamp\"].dt.hour * 60 + march_i5n[\"timestamp\"].dt.minute\n)\nmarch_i5n[\"tod_sin\"] = np.sin(2 * np.pi * march_i5n[\"minute_of_day\"] / 1440)\nmarch_i5n[\"tod_cos\"] = np.cos(2 * np.pi * march_i5n[\"minute_of_day\"] / 1440)\nmarch_i5n[\"weekday_sin\"] = np.sin(2 * np.pi * march_i5n[\"weekday\"] / 7)\nmarch_i5n[\"weekday_cos\"] = np.cos(2 * np.pi * march_i5n[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    march_i5n[col + \"_code\"] = (\n        march_i5n[col].map(category_maps_i5n[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict all March rows, then select official template rows.\nX_march_i5n = march_i5n[FEATURES_I5N].replace([np.inf, -np.inf], np.nan)\n\nmarch_i5n[\"pred_speed\"] = np.clip(\n    march_i5n[\"base_speed\"].to_numpy()\n    + speed_model_i5n_final.predict(X_march_i5n),\n    0, 160,\n)\nmarch_i5n[\"pred_flow\"] = np.clip(\n    march_i5n[\"base_flow\"].to_numpy()\n    + flow_model_i5n_final.predict(X_march_i5n),\n    0, None,\n)\n\ntemplate_path_i5n = (\n    ROOT / \"task1\" / PANEL_I5N / \"validation\" / \"sample_submission_state.csv\"\n)\ntemplate_i5n = pd.read_csv(template_path_i5n)\ntemplate_i5n[\"timestamp\"] = pd.to_datetime(\n    template_i5n[\"timestamp\"], utc=True\n)\n\njoin_keys_i5n = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\npred_source_i5n = march_i5n[\n    join_keys_i5n + [\"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source_i5n.duplicated(join_keys_i5n).any()\n\ntemplate_i5n[\"_row_order\"] = np.arange(len(template_i5n))\nresult_i5n = template_i5n.merge(\n    pred_source_i5n,\n    on=join_keys_i5n,\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n).sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(result_i5n) == len(template_i5n)\nassert result_i5n[\"pred_speed\"].notna().all(), (\n    f\"Missing speed: {result_i5n['pred_speed'].isna().sum()}\"\n)\nassert result_i5n[\"pred_flow\"].notna().all(), (\n    f\"Missing flow: {result_i5n['pred_flow'].isna().sum()}\"\n)\n\nresult_i5n[\"speed_kmh\"] = result_i5n[\"pred_speed\"]\nresult_i5n[\"flow_vph\"] = result_i5n[\"pred_flow\"]\n\nout_path_i5n = WORK / \"D12_I5_N_march_predictions_verified.csv\"\nresult_i5n[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n     \"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].to_csv(out_path_i5n, index=False)\n\nprint(\"March predictions:\", f\"{len(result_i5n):,}\")\nprint(\"Missing speed:\", result_i5n[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", result_i5n[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path_i5n)\nprint(\"Official validation template order preserved.\")\n\ndel X_march_i5n\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:30:43.017829Z","iopub.execute_input":"2026-10-19T20:30:43.018297Z","iopub.status.idle":"2026-10-19T20:32:39.549753Z","shell.execute_reply.started":"2026-10-19T20:30:43.018266Z","shell.execute_reply":"2026-10-19T20:32:39.548044Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"PANEL_I5N = \"D12_I5_N\"\n\nprivate_template_path_i5n = (\n    ROOT / \"task1\" / PANEL_I5N / \"private\" / \"sample_submission_state.csv\"\n)\n\nassert private_template_path_i5n.exists()\n\nprivate_template_i5n = pd.read_csv(private_template_path_i5n)\n\nprint(\"Panel:\", PANEL_I5N)\nprint(\"Expected private rows:\", f\"{len(private_template_i5n):,}\")\nprint(\"Columns:\", private_template_i5n.columns.tolist())\nprint(\"April data directory exists:\",\n      (ROOT / \"corridors\" / PANEL_I5N / \"private\" / \"mainline_states_masked\").exists())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:33:36.139433Z","iopub.execute_input":"2026-10-19T20:33:36.139915Z","iopub.status.idle":"2026-10-19T20:33:36.815402Z","shell.execute_reply.started":"2026-10-19T20:33:36.139863Z","shell.execute_reply":"2026-10-19T20:33:36.812978Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL_I5N = \"D12_I5_N\"\npanel_root_i5n = ROOT / \"corridors\" / PANEL_I5N\nKEYS_I5N = [\"timestamp\", \"station_id\", \"link_id\"]\nLAGS_I5N = [5, 15, 60, 1440]\n\n# 1. Load April masked data.\napril_root_i5n = panel_root_i5n / \"private\" / \"mainline_states_masked\"\napril_parts_i5n = []\n\nfor f in sorted(april_root_i5n.rglob(\"*.parquet\")):\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    april_parts_i5n.append(x)\n    del x\n    gc.collect()\n\napril_i5n = pd.concat(april_parts_i5n, ignore_index=True)\ndel april_parts_i5n\ngc.collect()\n\napril_i5n[\"timestamp\"] = pd.to_datetime(april_i5n[\"timestamp\"], utc=True)\napril_i5n[\"weekday\"] = april_i5n[\"timestamp\"].dt.weekday\napril_i5n[\"minute_of_day\"] = (\n    april_i5n[\"timestamp\"].dt.hour * 60 + april_i5n[\"timestamp\"].dt.minute\n)\n\n# 2. Attach January baseline profiles.\napril_i5n = april_i5n.merge(\n    profile_i5n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\napril_i5n = april_i5n.merge(\n    link_profile_i5n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\napril_i5n[\"base_speed\"] = april_i5n[\"base_speed\"].fillna(\n    april_i5n[\"link_base_speed\"]\n)\napril_i5n[\"base_flow\"] = april_i5n[\"base_flow\"].fillna(\n    april_i5n[\"link_base_flow\"]\n)\n\n# 3. Lag features from observed January/February history.\nfor lag in LAGS_I5N:\n    src = observed_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n    april_i5n = april_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    del src\n    gc.collect()\n\n# 4. Lags from observed April values.\napril_obs_i5n = april_i5n.loc[\n    april_i5n[\"is_observed\"].eq(1),\n    KEYS_I5N + [\"speed_kmh\", \"flow_vph\"]\n].rename(columns={\n    \"speed_kmh\": \"obs_speed\",\n    \"flow_vph\": \"obs_flow\",\n})\n\nfor lag in LAGS_I5N:\n    src = april_obs_i5n[KEYS_I5N + [\"obs_speed\", \"obs_flow\"]].copy()\n    src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    src = src.rename(columns={\n        \"obs_speed\": f\"april_lag_speed_{lag}\",\n        \"obs_flow\": f\"april_lag_flow_{lag}\",\n    })\n    april_i5n = april_i5n.merge(\n        src, on=KEYS_I5N, how=\"left\", validate=\"one_to_one\"\n    )\n    april_i5n[f\"lag_speed_{lag}\"] = april_i5n[f\"lag_speed_{lag}\"].fillna(\n        april_i5n[f\"april_lag_speed_{lag}\"]\n    )\n    april_i5n[f\"lag_flow_{lag}\"] = april_i5n[f\"lag_flow_{lag}\"].fillna(\n        april_i5n[f\"april_lag_flow_{lag}\"]\n    )\n    april_i5n.drop(\n        columns=[f\"april_lag_speed_{lag}\", f\"april_lag_flow_{lag}\"],\n        inplace=True,\n    )\n    del src\n    gc.collect()\n\n# 5. Calendar and category features.\napril_i5n[\"weekday\"] = april_i5n[\"timestamp\"].dt.weekday\napril_i5n[\"minute_of_day\"] = (\n    april_i5n[\"timestamp\"].dt.hour * 60 + april_i5n[\"timestamp\"].dt.minute\n)\napril_i5n[\"tod_sin\"] = np.sin(2 * np.pi * april_i5n[\"minute_of_day\"] / 1440)\napril_i5n[\"tod_cos\"] = np.cos(2 * np.pi * april_i5n[\"minute_of_day\"] / 1440)\napril_i5n[\"weekday_sin\"] = np.sin(2 * np.pi * april_i5n[\"weekday\"] / 7)\napril_i5n[\"weekday_cos\"] = np.cos(2 * np.pi * april_i5n[\"weekday\"] / 7)\n\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    april_i5n[col + \"_code\"] = (\n        april_i5n[col].map(category_maps_i5n[col]).fillna(-1).astype(\"int16\")\n    )\n\n# 6. Predict.\nX_april_i5n = april_i5n[FEATURES_I5N].replace([np.inf, -np.inf], np.nan)\napril_i5n[\"pred_speed\"] = np.clip(\n    april_i5n[\"base_speed\"].to_numpy()\n    + speed_model_i5n_final.predict(X_april_i5n),\n    0, 160,\n)\napril_i5n[\"pred_flow\"] = np.clip(\n    april_i5n[\"base_flow\"].to_numpy()\n    + flow_model_i5n_final.predict(X_april_i5n),\n    0, None,\n)\n\n# 7. Align to official private template.\ntemplate_path_i5n = (\n    ROOT / \"task1\" / PANEL_I5N / \"private\" / \"sample_submission_state.csv\"\n)\ntemplate_i5n = pd.read_csv(template_path_i5n)\ntemplate_i5n[\"timestamp\"] = pd.to_datetime(\n    template_i5n[\"timestamp\"], utc=True\n)\n\njoin_keys_i5n = [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\"]\npred_source_i5n = april_i5n[\n    join_keys_i5n + [\"pred_speed\", \"pred_flow\"]\n].copy()\n\nassert not pred_source_i5n.duplicated(join_keys_i5n).any()\n\ntemplate_i5n[\"_row_order\"] = np.arange(len(template_i5n))\nresult_april_i5n = template_i5n.merge(\n    pred_source_i5n,\n    on=join_keys_i5n,\n    how=\"left\",\n    validate=\"one_to_one\",\n    sort=False,\n).sort_values(\"_row_order\").reset_index(drop=True)\n\nassert len(result_april_i5n) == 543_092\nassert result_april_i5n[\"pred_speed\"].notna().all(), (\n    f\"Missing speed: {result_april_i5n['pred_speed'].isna().sum()}\"\n)\nassert result_april_i5n[\"pred_flow\"].notna().all(), (\n    f\"Missing flow: {result_april_i5n['pred_flow'].isna().sum()}\"\n)\n\nresult_april_i5n[\"speed_kmh\"] = result_april_i5n[\"pred_speed\"]\nresult_april_i5n[\"flow_vph\"] = result_april_i5n[\"pred_flow\"]\n\nout_path_i5n = WORK / \"D12_I5_N_april_predictions_verified.csv\"\nresult_april_i5n[\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\",\n     \"mask_regime\", \"speed_kmh\", \"flow_vph\"]\n].to_csv(out_path_i5n, index=False)\n\nprint(\"Private predictions:\", f\"{len(result_april_i5n):,}\")\nprint(\"Missing speed:\", result_april_i5n[\"speed_kmh\"].isna().sum())\nprint(\"Missing flow:\", result_april_i5n[\"flow_vph\"].isna().sum())\nprint(\"Saved:\", out_path_i5n)\nprint(\"Official private template order preserved.\")\n\ndel X_april_i5n\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:35:59.873084Z","iopub.execute_input":"2026-10-19T20:35:59.873794Z","iopub.status.idle":"2026-10-19T20:37:53.009425Z","shell.execute_reply.started":"2026-10-19T20:35:59.873751Z","shell.execute_reply":"2026-10-19T20:37:53.008405Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport gc\n\nmarch_path_i5n = WORK / \"D12_I5_N_march_predictions_verified.csv\"\napril_path_i5n = WORK / \"D12_I5_N_april_predictions_verified.csv\"\ncheckpoint_path_i5n = WORK / \"D12_I5_N_predictions_checkpoint.csv\"\n\nmarch_ckpt_i5n = pd.read_csv(march_path_i5n)\napril_ckpt_i5n = pd.read_csv(april_path_i5n)\n\nmarch_ckpt_i5n[\"split\"] = \"validation\"\napril_ckpt_i5n[\"split\"] = \"private\"\n\ncheckpoint_i5n = pd.concat(\n    [march_ckpt_i5n, april_ckpt_i5n],\n    ignore_index=True,\n)\n\nassert len(march_ckpt_i5n) == 588_468\nassert len(april_ckpt_i5n) == 543_092\nassert checkpoint_i5n[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\nassert not checkpoint_i5n.duplicated(\n    [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"mask_regime\", \"split\"]\n).any()\n\ncheckpoint_i5n.to_csv(checkpoint_path_i5n, index=False)\n\nprint(\"Panel: D12_I5_N\")\nprint(\"Validation rows:\", f\"{len(march_ckpt_i5n):,}\")\nprint(\"Private rows:\", f\"{len(april_ckpt_i5n):,}\")\nprint(\"Checkpoint rows:\", f\"{len(checkpoint_i5n):,}\")\nprint(\"Saved:\", checkpoint_path_i5n)\n\ndel march_ckpt_i5n, april_ckpt_i5n, checkpoint_i5n\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:39:01.310768Z","iopub.execute_input":"2026-10-19T20:39:01.311917Z","iopub.status.idle":"2026-10-19T20:39:13.295455Z","shell.execute_reply.started":"2026-10-19T20:39:01.311854Z","shell.execute_reply":"2026-10-19T20:39:13.293955Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"panel_test = \"D12_I5_S\"\ntraining_i5s, regimes_i5s = load_february_training_data(panel_test)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:40:25.041245Z","iopub.execute_input":"2026-10-19T20:40:25.042326Z","iopub.status.idle":"2026-10-19T20:43:05.045732Z","shell.execute_reply.started":"2026-10-19T20:40:25.042286Z","shell.execute_reply":"2026-10-19T20:43:05.044397Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"panel_i5s = \"D12_I5_S\"\nobserved_i5s = load_observed_february_and_january(panel_i5s)\n\nfeb_features_i5s = add_observed_lags(\n    training_i5s,\n    observed_i5s\n)\n\nassert len(feb_features_i5s) == 616_266\nassert feb_features_i5s.duplicated(\n    [\"timestamp\", \"station_id\", \"link_id\"]\n).sum() == 0\nassert feb_features_i5s[\"mask_regime\"].notna().all()\n\nprint(\"Panel:\", panel_i5s)\nprint(\"Training rows:\", f\"{len(feb_features_i5s):,}\")\nprint(\"Missing lag values:\")\nprint(\n    feb_features_i5s[\n        [c for c in feb_features_i5s.columns if c.startswith(\"lag_\")]\n    ].isna().sum()\n)\nprint(\"Feature integrity checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:45:16.757226Z","iopub.execute_input":"2026-10-19T20:45:16.757961Z","iopub.status.idle":"2026-10-19T20:46:03.320353Z","shell.execute_reply.started":"2026-10-19T20:45:16.757916Z","shell.execute_reply":"2026-10-19T20:46:03.31861Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\n\nPANEL_I5S = \"D12_I5_S\"\ntruth_root_i5s = ROOT / \"corridors\" / PANEL_I5S / \"train\" / \"mainline_states\"\n\njan_parts_i5s = []\n\nfor f in truth_root_i5s.rglob(\"*.parquet\"):\n    if \"year_month=2031-01\" not in str(f):\n        continue\n\n    x = pd.read_parquet(f)\n    x[\"timestamp\"] = pd.to_datetime(x[\"timestamp\"], utc=True)\n    x = x[\n        (x[\"timestamp\"] >= pd.Timestamp(\"2031-01-01\", tz=\"UTC\")) &\n        (x[\"timestamp\"] < pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n    ]\n\n    if not x.empty:\n        jan_parts_i5s.append(\n            x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del x\n    gc.collect()\n\nif not jan_parts_i5s:\n    raise ValueError(\"No January 2031 truth files found for D12_I5_S.\")\n\njan_truth_i5s = pd.concat(jan_parts_i5s, ignore_index=True)\ndel jan_parts_i5s\ngc.collect()\n\njan_truth_i5s[\"weekday\"] = jan_truth_i5s[\"timestamp\"].dt.weekday\njan_truth_i5s[\"minute_of_day\"] = (\n    jan_truth_i5s[\"timestamp\"].dt.hour * 60\n    + jan_truth_i5s[\"timestamp\"].dt.minute\n)\n\nprofile_i5s = jan_truth_i5s.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile_i5s = jan_truth_i5s.groupby(\n    \"link_id\", as_index=False\n).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\nfeb_features_i5s[\"timestamp\"] = pd.to_datetime(\n    feb_features_i5s[\"timestamp\"], utc=True\n)\nfeb_features_i5s[\"weekday\"] = feb_features_i5s[\"timestamp\"].dt.weekday\nfeb_features_i5s[\"minute_of_day\"] = (\n    feb_features_i5s[\"timestamp\"].dt.hour * 60\n    + feb_features_i5s[\"timestamp\"].dt.minute\n)\n\nfeb_features_i5s = feb_features_i5s.merge(\n    profile_i5s,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nfeb_features_i5s = feb_features_i5s.merge(\n    link_profile_i5s,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i5s[\"base_speed\"] = feb_features_i5s[\"base_speed\"].fillna(\n    feb_features_i5s[\"link_base_speed\"]\n)\nfeb_features_i5s[\"base_flow\"] = feb_features_i5s[\"base_flow\"].fillna(\n    feb_features_i5s[\"link_base_flow\"]\n)\n\nassert len(feb_features_i5s) == 616_266\nassert feb_features_i5s[\"base_speed\"].notna().all()\nassert feb_features_i5s[\"base_flow\"].notna().all()\n\nprint(\"Panel:\", PANEL_I5S)\nprint(\"Rows:\", f\"{len(feb_features_i5s):,}\")\nprint(\"Baseline profile rows:\", f\"{len(profile_i5s):,}\")\nprint(\"Missing base_speed:\", feb_features_i5s[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_i5s[\"base_flow\"].isna().sum())\nprint(\"Baseline checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:46:36.325854Z","iopub.execute_input":"2026-10-19T20:46:36.326337Z","iopub.status.idle":"2026-10-19T20:46:54.648086Z","shell.execute_reply.started":"2026-10-19T20:46:36.326307Z","shell.execute_reply":"2026-10-19T20:46:54.646627Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL_I5S = \"D12_I5_S\"\ndf_i5s = feb_features_i5s.copy()\ndf_i5s[\"timestamp\"] = pd.to_datetime(df_i5s[\"timestamp\"], utc=True)\n\n# Calendar features\ndf_i5s[\"weekday\"] = df_i5s[\"timestamp\"].dt.weekday\ndf_i5s[\"minute_of_day\"] = (\n    df_i5s[\"timestamp\"].dt.hour * 60 + df_i5s[\"timestamp\"].dt.minute\n)\ndf_i5s[\"tod_sin\"] = np.sin(2 * np.pi * df_i5s[\"minute_of_day\"] / 1440)\ndf_i5s[\"tod_cos\"] = np.cos(2 * np.pi * df_i5s[\"minute_of_day\"] / 1440)\ndf_i5s[\"weekday_sin\"] = np.sin(2 * np.pi * df_i5s[\"weekday\"] / 7)\ndf_i5s[\"weekday_cos\"] = np.cos(2 * np.pi * df_i5s[\"weekday\"] / 7)\n\n# Store mappings for consistent inference encodings.\ncategory_maps_i5s = {}\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = pd.Categorical(df_i5s[col]).categories\n    category_maps_i5s[col] = {\n        value: code for code, value in enumerate(categories)\n    }\n    df_i5s[col + \"_code\"] = pd.Categorical(\n        df_i5s[col], categories=categories\n    ).codes\n\nFEATURES_I5S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\n# Chronological holdout: final 20% of unique timestamps.\nunique_times_i5s = np.sort(df_i5s[\"timestamp\"].unique())\nval_start_i5s = unique_times_i5s[int(len(unique_times_i5s) * 0.8)]\ntrain_mask_i5s = df_i5s[\"timestamp\"] < val_start_i5s\nvalid_mask_i5s = ~train_mask_i5s\n\nX_i5s = df_i5s[FEATURES_I5S].replace([np.inf, -np.inf], np.nan)\ny_speed_i5s = df_i5s[\"target_speed\"].to_numpy(dtype=float)\ny_flow_i5s = df_i5s[\"target_flow\"].to_numpy(dtype=float)\nbase_speed_i5s = df_i5s[\"base_speed\"].to_numpy(dtype=float)\nbase_flow_i5s = df_i5s[\"base_flow\"].to_numpy(dtype=float)\n\nvalid_labels_i5s = (\n    np.isfinite(y_speed_i5s) & np.isfinite(y_flow_i5s)\n    & np.isfinite(base_speed_i5s) & np.isfinite(base_flow_i5s)\n)\ntrain_idx_i5s = np.flatnonzero(train_mask_i5s.to_numpy() & valid_labels_i5s)\nvalid_idx_i5s = np.flatnonzero(valid_mask_i5s.to_numpy() & valid_labels_i5s)\n\ndef make_model_i5s():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5s = make_model_i5s()\nflow_model_i5s = make_model_i5s()\n\nspeed_model_i5s.fit(\n    X_i5s.iloc[train_idx_i5s],\n    y_speed_i5s[train_idx_i5s] - base_speed_i5s[train_idx_i5s],\n)\nflow_model_i5s.fit(\n    X_i5s.iloc[train_idx_i5s],\n    y_flow_i5s[train_idx_i5s] - base_flow_i5s[train_idx_i5s],\n)\n\npred_speed_i5s = np.clip(\n    base_speed_i5s[valid_idx_i5s]\n    + speed_model_i5s.predict(X_i5s.iloc[valid_idx_i5s]),\n    0, 160,\n)\npred_flow_i5s = np.clip(\n    base_flow_i5s[valid_idx_i5s]\n    + flow_model_i5s.predict(X_i5s.iloc[valid_idx_i5s]),\n    0, None,\n)\n\nlinks_i5s = pd.read_csv(\n    ROOT / \"corridors\" / PANEL_I5S / \"network\" / \"links.csv\"\n)\nlane_map_i5s = links_i5s[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev_i5s = df_i5s.iloc[valid_idx_i5s][\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\nev_i5s[\"pred_speed\"] = pred_speed_i5s\nev_i5s[\"pred_flow\"] = pred_flow_i5s\nev_i5s = ev_i5s.merge(\n    lane_map_i5s, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nassert ev_i5s[\"lanes\"].notna().all() and (ev_i5s[\"lanes\"] > 0).all()\n\nspeed_rmse_i5s = np.sqrt(np.mean(\n    (ev_i5s[\"target_speed\"] - ev_i5s[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse_i5s = np.sqrt(np.mean(\n    ((ev_i5s[\"target_flow\"] - ev_i5s[\"pred_flow\"]) / ev_i5s[\"lanes\"]) ** 2\n))\n\nS_speed_i5s = max(0, 1 - speed_rmse_i5s / 25)\nS_flow_i5s = max(0, 1 - flow_lane_rmse_i5s / 600)\nS_state_i5s = 0.54 * S_speed_i5s + 0.46 * S_flow_i5s\n\nprint(\"Panel:\", PANEL_I5S)\nprint(\"Training rows:\", f\"{len(train_idx_i5s):,}\")\nprint(\"Holdout rows:\", f\"{len(valid_idx_i5s):,}\")\nprint(f\"Speed RMSE: {speed_rmse_i5s:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse_i5s:.4f}\")\nprint(f\"S_speed: {S_speed_i5s:.6f}\")\nprint(f\"S_flow: {S_flow_i5s:.6f}\")\nprint(f\"Estimated state score: {S_state_i5s:.6f}\")\n\ndel X_i5s, links_i5s, lane_map_i5s, ev_i5s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:47:31.475208Z","iopub.execute_input":"2026-10-19T20:47:31.475647Z","iopub.status.idle":"2026-10-19T20:47:48.845469Z","shell.execute_reply.started":"2026-10-19T20:47:31.475617Z","shell.execute_reply":"2026-10-19T20:47:48.844495Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport json\nimport gc\nimport shutil\nimport zipfile\nfrom pathlib import Path\nfrom datetime import datetime, timezone\n\nimport joblib\n\nRESUME_DIR = WORK / \"trafficflow_resume\"\nARTIFACT_DIR = RESUME_DIR / \"artifacts\"\nPRED_DIR = RESUME_DIR / \"predictions\"\n\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\nPRED_DIR.mkdir(parents=True, exist_ok=True)\n\n# 1. Save model artifacts and feature/category mappings.\nartifacts = {\n    \"D12_I405_S\": {\n        \"speed_model\": speed_model_d12s_final,\n        \"flow_model\": flow_model_d12s_final,\n        \"features\": FEATURES_D12S,\n        \"category_maps\": category_maps_d12s,\n    },\n    \"D12_I5_N\": {\n        \"speed_model\": speed_model_i5n_final,\n        \"flow_model\": flow_model_i5n_final,\n        \"features\": FEATURES_I5N,\n        \"category_maps\": category_maps_i5n,\n    },\n    \"D12_I5_S_holdout\": {\n        \"speed_model\": speed_model_i5s,\n        \"flow_model\": flow_model_i5s,\n        \"features\": FEATURES_I5S,\n        \"category_maps\": category_maps_i5s,\n    },\n}\n\njoblib.dump(artifacts, ARTIFACT_DIR / \"models_and_features.joblib\", compress=3)\n\n# 2. Save verified completed-panel checkpoints.\nprediction_files = [\n    WORK / \"D12_I405_S_predictions_checkpoint.csv\",\n    WORK / \"D12_I5_N_predictions_checkpoint.csv\",\n    WORK / \"task1_predictions_checkpoint.csv\",\n]\n\nsaved_predictions = []\nfor src in prediction_files:\n    if src.exists():\n        dst = PRED_DIR / src.name\n        shutil.copy2(src, dst)\n        saved_predictions.append({\n            \"filename\": src.name,\n            \"bytes\": dst.stat().st_size,\n        })\n\n# 3. Save current evaluation metrics and exact resume position.\nmanifest = {\n    \"saved_at_utc\": datetime.now(timezone.utc).isoformat(),\n    \"project\": \"IEEE Traffic Flow Bench - Task 1 State Reconstruction\",\n    \"status\": \"IN_PROGRESS\",\n    \"completed_panels\": [\"D12_I405_S\", \"D12_I5_N\"],\n    \"current_panel\": \"D12_I5_S\",\n    \"current_panel_status\": \"HOLDOUT_EVALUATED\",\n    \"next_action\": (\n        \"Rebuild D12_I5_S features if the kernel was reset; \"\n        \"fit final models on all 616266 eligible February rows; \"\n        \"generate and verify March and April predictions; \"\n        \"checkpoint the panel.\"\n    ),\n    \"metrics\": {\n        \"D12_I405_S\": {\n            \"holdout_score\": 0.849279,\n            \"speed_rmse\": 3.7532,\n            \"flow_rmse_per_lane\": 90.8497,\n        },\n        \"D12_I5_N\": {\n            \"holdout_score\": 0.811974,\n            \"speed_rmse\": 5.4136,\n            \"flow_rmse_per_lane\": 92.7291,\n        },\n        \"D12_I5_S\": {\n            \"holdout_score\": 0.811614,\n            \"speed_rmse\": 5.8641,\n            \"flow_rmse_per_lane\": 80.5069,\n            \"training_rows\": 493380,\n            \"holdout_rows\": 122886,\n            \"eligible_labels\": 616266,\n        },\n    },\n    \"saved_prediction_checkpoints\": saved_predictions,\n    \"completed_panels_count\": 2,\n    \"total_panels\": 10,\n    \"final_submission_created\": False,\n}\n\nwith open(RESUME_DIR / \"manifest.json\", \"w\") as f:\n    json.dump(manifest, f, indent=2)\n\n# 4. Include a human-readable resume note.\nresume_note = \"\"\"IEEE Traffic Flow Bench — Resume Notes\n\nCurrent state:\n- D12_I405_S: validation/private predictions checkpointed.\n- D12_I5_N: validation/private predictions checkpointed.\n- D12_I5_S: February training and chronological holdout evaluation complete.\n- Next: fit D12_I5_S final models on all eligible February rows, then generate\n  March validation and April private predictions.\n- 10 panels total; do not create the final submission until all panels are verified.\n\nOn resume:\n1. Restore this package and the original Kaggle competition input.\n2. Read manifest.json.\n3. Load artifacts/models_and_features.joblib if reusing saved models.\n4. Verify checkpoint CSVs before processing the next panel.\n5. Rebuild dataframes and observed lag history from source parquet files if needed.\n6. Preserve official template order and untouched non-state task rows.\n7. Build the unified submission only after all required predictions are covered.\n\nImportant:\nSaving to /kaggle/working alone is not a guarantee against session loss.\nDownload the ZIP or save a Kaggle notebook version/output before closing.\n\"\"\"\n(RESUME_DIR / \"RESUME.txt\").write_text(resume_note)\n\n# 5. Build a portable ZIP package.\nzip_path = WORK / \"trafficflow_resume_package.zip\"\nwith zipfile.ZipFile(zip_path, \"w\", compression=zipfile.ZIP_DEFLATED) as zf:\n    for path in RESUME_DIR.rglob(\"*\"):\n        if path.is_file():\n            zf.write(path, path.relative_to(WORK))\n\n# 6. Verify package and required files.\nassert (RESUME_DIR / \"manifest.json\").exists()\nassert (ARTIFACT_DIR / \"models_and_features.joblib\").exists()\nassert (RESUME_DIR / \"RESUME.txt\").exists()\nassert zipfile.is_zipfile(zip_path)\n\nwith zipfile.ZipFile(zip_path, \"r\") as zf:\n    bad_member = zf.testzip()\n    assert bad_member is None, f\"ZIP verification failed: {bad_member}\"\n\nprint(\"CHECKPOINT PACKAGE CREATED AND VERIFIED\")\nprint(\"Resume folder:\", RESUME_DIR)\nprint(\"ZIP package:\", zip_path)\nprint(\"ZIP size (MiB):\", round(zip_path.stat().st_size / (1024**2), 2))\nprint(\"Saved prediction checkpoints:\", len(saved_predictions))\nprint(\"Completed panels: 2 / 10\")\nprint(\"Next panel: D12_I5_S — final training and predictions\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:50:39.067274Z","iopub.execute_input":"2026-10-19T20:50:39.067816Z","iopub.status.idle":"2026-10-19T20:50:50.049472Z","shell.execute_reply.started":"2026-10-19T20:50:39.067782Z","shell.execute_reply":"2026-10-19T20:50:50.048177Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from pathlib import Path\n\nROOT_INPUT = Path(\"/kaggle/input/datasets/krupaalhn/trafficflow-resume-package\")\n\nprint(\"Dataset mounted:\", ROOT_INPUT.exists())\n\nif ROOT_INPUT.exists():\n    for p in ROOT_INPUT.rglob(\"*\"):\n        if p.is_file():\n            print(f\"{p}  ({p.stat().st_size / (1024**2):.2f} MiB)\")\nelse:\n    print(\"Check the dataset path under /kaggle/input:\")\n    for p in Path(\"/kaggle/input\").iterdir():\n        print(p)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T16:52:35.512031Z","iopub.execute_input":"2026-10-21T16:52:35.51257Z","iopub.status.idle":"2026-10-21T16:52:36.417829Z","shell.execute_reply.started":"2026-10-21T16:52:35.512537Z","shell.execute_reply":"2026-10-21T16:52:36.416635Z"}},"outputs":[{"name":"stdout","text":"Dataset mounted: True\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/RESUME.txt  (0.00 MiB)\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/manifest.json  (0.00 MiB)\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/artifacts/models_and_features.joblib  (1.52 MiB)\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/predictions/D12_I405_S_predictions_checkpoint.csv  (22.29 MiB)\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/predictions/D12_I5_N_predictions_checkpoint.csv  (119.12 MiB)\n/kaggle/input/datasets/krupaalhn/trafficflow-resume-package/trafficflow_resume/predictions/task1_predictions_checkpoint.csv  (69.01 MiB)\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"from pathlib import Path\nimport json\nimport pandas as pd\nimport joblib\n\nRESUME_DIR = ROOT_INPUT / \"trafficflow_resume\"\n\n# 1. Read progress manifest\nmanifest = json.loads((RESUME_DIR / \"manifest.json\").read_text())\n\nprint(\"Completed panels:\", manifest[\"completed_panels\"])\nprint(\"Current panel:\", manifest[\"current_panel\"])\nprint(\"Current status:\", manifest[\"current_panel_status\"])\nprint(\"Final submission created:\", manifest[\"final_submission_created\"])\n\n# 2. Inspect every prediction checkpoint\nfor path in sorted((RESUME_DIR / \"predictions\").glob(\"*.csv\")):\n    df = pd.read_csv(path)\n    print(f\"\\n--- {path.name} ---\")\n    print(\"Rows:\", len(df))\n    print(\"Columns:\", df.columns.tolist())\n\n    if \"panel\" in df.columns:\n        print(\"Panel counts:\")\n        print(df[\"panel\"].value_counts(dropna=False).to_string())\n\n    if \"split\" in df.columns:\n        print(\"Split counts:\")\n        print(df[\"split\"].value_counts(dropna=False).to_string())\n\n    keys = [c for c in [\"panel\", \"timestamp\", \"station_id\", \"link_id\", \"split\"]\n            if c in df.columns]\n    if keys:\n        print(\"Duplicate full keys:\", int(df.duplicated(keys).sum()))\n\n# 3. Inspect saved models and feature mappings\nartifact_path = RESUME_DIR / \"artifacts\" / \"models_and_features.joblib\"\nartifacts = joblib.load(artifact_path)\n\nprint(\"\\nSaved artifact groups:\", list(artifacts.keys()))\nfor name, obj in artifacts.items():\n    print(name, \"->\", list(obj.keys()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T16:53:30.93952Z","iopub.execute_input":"2026-10-21T16:53:30.940064Z","iopub.status.idle":"2026-10-21T16:53:41.138518Z","shell.execute_reply.started":"2026-10-21T16:53:30.940031Z","shell.execute_reply":"2026-10-21T16:53:41.137357Z"}},"outputs":[{"name":"stdout","text":"Completed panels: ['D12_I405_S', 'D12_I5_N']\nCurrent panel: D12_I5_S\nCurrent status: HOLDOUT_EVALUATED\nFinal submission created: False\n\n--- D12_I405_S_predictions_checkpoint.csv ---\nRows: 201134\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nPanel counts:\npanel\nD12_I405_S    201134\nSplit counts:\nsplit\nprivate       107416\nvalidation     93718\nDuplicate full keys: 0\n\n--- D12_I5_N_predictions_checkpoint.csv ---\nRows: 1131560\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split']\nPanel counts:\npanel\nD12_I5_N    1131560\nSplit counts:\nsplit\nvalidation    588468\nprivate       543092\nDuplicate full keys: 0\n\n--- task1_predictions_checkpoint.csv ---\nRows: 515542\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph', 'split', '_timestamp_utc']\nPanel counts:\npanel\nD7_I405_S    515542\nSplit counts:\nsplit\nvalidation    271939\nprivate       243603\nDuplicate full keys: 0\n\nSaved artifact groups: ['D12_I405_S', 'D12_I5_N', 'D12_I5_S_holdout']\nD12_I405_S -> ['speed_model', 'flow_model', 'features', 'category_maps']\nD12_I5_N -> ['speed_model', 'flow_model', 'features', 'category_maps']\nD12_I5_S_holdout -> ['speed_model', 'flow_model', 'features', 'category_maps']\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\nRESUME_DIR = ROOT_INPUT / \"trafficflow_resume\"\npred_path = RESUME_DIR / \"predictions\" / \"task1_predictions_checkpoint.csv\"\npred = pd.read_csv(pred_path)\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ndef verify_panel(panel_name, panel_pred):\n    results = []\n\n    for split in [\"validation\", \"private\"]:\n        template_path = (\n            ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n        )\n        template = pd.read_csv(template_path)\n\n        actual = panel_pred.loc[panel_pred[\"split\"] == split].copy()\n\n        template_keys = template[KEYS].copy()\n        pred_keys = actual[KEYS].copy()\n\n        for df in [template_keys, pred_keys]:\n            df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n        template_set = set(map(tuple, template_keys.to_numpy()))\n        pred_set = set(map(tuple, pred_keys.to_numpy()))\n\n        missing = len(template_set - pred_set)\n        extra = len(pred_set - template_set)\n\n        ok = (\n            missing == 0\n            and extra == 0\n            and not template_keys.duplicated().any()\n            and not pred_keys.duplicated().any()\n            and actual[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n        )\n\n        results.append({\n            \"panel\": panel_name,\n            \"split\": split,\n            \"template_rows\": len(template),\n            \"prediction_rows\": len(actual),\n            \"missing_keys\": missing,\n            \"extra_keys\": extra,\n            \"predictions_complete\": bool(ok),\n        })\n\n    return pd.DataFrame(results)\n\nverification = verify_panel(\"D7_I405_S\", pred)\nprint(verification.to_string(index=False))\n\nassert verification[\"predictions_complete\"].all(), (\n    \"Do not count D7_I405_S as complete until the key mismatch is fixed.\"\n)\nprint(\"\\nD7_I405_S verification passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T16:54:09.763021Z","iopub.execute_input":"2026-10-21T16:54:09.763957Z","iopub.status.idle":"2026-10-21T16:54:17.197334Z","shell.execute_reply.started":"2026-10-21T16:54:09.763922Z","shell.execute_reply":"2026-10-21T16:54:17.196435Z"}},"outputs":[{"name":"stdout","text":"    panel      split  template_rows  prediction_rows  missing_keys  extra_keys  predictions_complete\nD7_I405_S validation         271939           271939             0           0                  True\nD7_I405_S    private         243603           243603             0           0                  True\n\nD7_I405_S verification passed.\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"import json\nfrom pathlib import Path\nimport shutil\n\n# Read the original manifest from the read-only dataset\nsource_manifest = RESUME_DIR / \"manifest.json\"\n\n# Write the working copy to a writable location\nWORK = Path(\"/kaggle/working\")\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nLOCAL_RESUME_DIR.mkdir(parents=True, exist_ok=True)\n\nmanifest = json.loads(source_manifest.read_text())\n\ncompleted = set(manifest.get(\"completed_panels\", []))\ncompleted.add(\"D7_I405_S\")\n\nmanifest[\"completed_panels\"] = sorted(completed)\nmanifest[\"verified_extra_panels\"] = [\"D7_I405_S\"]\nmanifest[\"completed_panels_count\"] = len(completed)\n\nlocal_manifest = LOCAL_RESUME_DIR / \"manifest.json\"\nlocal_manifest.write_text(json.dumps(manifest, indent=2))\n\nprint(\"Updated manifest saved to:\", local_manifest)\nprint(\"Verified panels:\", manifest[\"completed_panels\"])\nprint(\"Count:\", len(completed), \"/ 10\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:02:07.095497Z","iopub.execute_input":"2026-10-21T17:02:07.096356Z","iopub.status.idle":"2026-10-21T17:02:07.107287Z","shell.execute_reply.started":"2026-10-21T17:02:07.096311Z","shell.execute_reply":"2026-10-21T17:02:07.106293Z"}},"outputs":[{"name":"stdout","text":"Updated manifest saved to: /kaggle/working/trafficflow_resume/manifest.json\nVerified panels: ['D12_I405_S', 'D12_I5_N', 'D7_I405_S']\nCount: 3 / 10\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"from pathlib import Path\n\nROOT = Path(\n    \"/kaggle/input/competitions/\"\n    \"2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\n\npanel = \"D12_I5_S\"\npanel_root = ROOT / \"corridors\" / panel\n\nprint(\"Competition root exists:\", ROOT.exists())\nprint(\"Panel directory exists:\", panel_root.exists())\n\nfor rel in [\n    \"train/mainline_states\",\n    \"train/mainline_states_masked\",\n    \"validation/mainline_states_masked\",\n    \"private/mainline_states_masked\",\n    \"network/links.csv\",\n]:\n    path = panel_root / rel\n    print(f\"\\n{rel}: {path.exists()}\")\n\n    if path.exists() and path.is_dir():\n        files = list(path.rglob(\"*.parquet\"))\n        print(\"Parquet files:\", len(files))\n        if files:\n            print(\"Example:\", files[0].relative_to(panel_root))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:02:36.125569Z","iopub.execute_input":"2026-10-21T17:02:36.125953Z","iopub.status.idle":"2026-10-21T17:02:37.265641Z","shell.execute_reply.started":"2026-10-21T17:02:36.125924Z","shell.execute_reply":"2026-10-21T17:02:37.264679Z"}},"outputs":[{"name":"stdout","text":"Competition root exists: True\nPanel directory exists: True\n\ntrain/mainline_states: True\nParquet files: 273\nExample: train/mainline_states/year_month=2031-02/synthetic_mainline_2031_02_08.parquet\n\ntrain/mainline_states_masked: True\nParquet files: 273\nExample: train/mainline_states_masked/mask_regime=R1/synthetic_mainline_2030_08_02.parquet\n\nvalidation/mainline_states_masked: True\nParquet files: 31\nExample: validation/mainline_states_masked/mask_regime=R1/synthetic_mainline_2031_03_02.parquet\n\nprivate/mainline_states_masked: True\nParquet files: 30\nExample: private/mainline_states_masked/mask_regime=R1/synthetic_mainline_2031_04_30.parquet\n\nnetwork/links.csv: True\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_root = ROOT / \"corridors\" / \"D12_I5_S\"\n\ntruth_dir = panel_root / \"train\" / \"mainline_states\"\nmasked_dir = panel_root / \"train\" / \"mainline_states_masked\"\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n# Find February 2031 truth files\ntruth_files = sorted(\n    truth_dir.glob(\"year_month=2031-02/*.parquet\")\n)\n\n# Masked files are partitioned by regime, so filter filenames by February\nmasked_files = sorted(\n    p for p in masked_dir.rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\nprint(\"February truth files:\", len(truth_files))\nprint(\"February masked files:\", len(masked_files))\n\nassert truth_files, \"No February truth files found.\"\nassert masked_files, \"No February masked files found.\"\n\n# Inspect schema before selecting columns\ntruth_sample = pd.read_parquet(truth_files[0])\nmasked_sample = pd.read_parquet(masked_files[0])\n\nprint(\"\\nTruth columns:\", truth_sample.columns.tolist())\nprint(\"Masked columns:\", masked_sample.columns.tolist())\n\nprint(\"\\nTruth sample shape:\", truth_sample.shape)\nprint(\"Masked sample shape:\", masked_sample.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:03:25.990352Z","iopub.execute_input":"2026-10-21T17:03:25.991372Z","iopub.status.idle":"2026-10-21T17:03:26.386321Z","shell.execute_reply.started":"2026-10-21T17:03:25.991338Z","shell.execute_reply":"2026-10-21T17:03:26.385468Z"}},"outputs":[{"name":"stdout","text":"February truth files: 28\nFebruary masked files: 28\n\nTruth columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\nMasked columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing', 'mask_regime']\n\nTruth sample shape: (28800, 16)\nMasked sample shape: (28800, 17)\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ntruth_files = sorted(\n    (panel_root / \"train\" / \"mainline_states\").glob(\n        \"year_month=2031-02/*.parquet\"\n    )\n)\n\nmasked_files = sorted(\n    p for p in (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\n# Load February truth labels\ntruth = pd.concat(\n    [pd.read_parquet(p) for p in truth_files],\n    ignore_index=True\n)\n\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\n\ntraining_i5s = truth.loc[\n    (truth[\"is_score_eligible\"] == 1)\n    & (truth[\"timestamp\"] >= \"2031-02-01\")\n    & (truth[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].copy()\n\n# Load all February masked rows to recover regimes, including hidden labels\nmasked = pd.concat(\n    [pd.read_parquet(p) for p in masked_files],\n    ignore_index=True\n)\n\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n\nregimes_i5s = masked.loc[\n    (masked[\"timestamp\"] >= \"2031-02-01\")\n    & (masked[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"mask_regime\"]\n].copy()\n\nassert not training_i5s.duplicated(KEYS).any(), \"Duplicate training keys\"\nassert not regimes_i5s.duplicated(KEYS).any(), \"Duplicate regime keys\"\n\ntraining_i5s = training_i5s.merge(\n    regimes_i5s, on=KEYS, how=\"left\", validate=\"one_to_one\"\n)\n\nassert training_i5s[\"mask_regime\"].notna().all(), \"Missing regime assignments\"\n\nprint(\"Eligible February labels:\", len(training_i5s))\nprint(\"\\nRegime counts:\")\nprint(training_i5s[\"mask_regime\"].value_counts().sort_index())\nprint(\"\\nDuplicate training keys:\", training_i5s.duplicated(KEYS).sum())\nprint(\"Missing regimes:\", training_i5s[\"mask_regime\"].isna().sum())\nprint(\"Missing target values:\",\n      training_i5s[[\"speed_kmh\", \"flow_vph\"]].isna().sum().to_dict())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:03:56.775611Z","iopub.execute_input":"2026-10-21T17:03:56.776669Z","iopub.status.idle":"2026-10-21T17:04:00.490022Z","shell.execute_reply.started":"2026-10-21T17:03:56.776637Z","shell.execute_reply":"2026-10-21T17:04:00.488629Z"}},"outputs":[{"name":"stdout","text":"Eligible February labels: 616266\n\nRegime counts:\nmask_regime\nR1    198105\nR2    197914\nR3    220247\nName: count, dtype: int64\n\nDuplicate training keys: 0\nMissing regimes: 0\nMissing target values: {'speed_kmh': 0, 'flow_vph': 0}\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\npanel_root = ROOT / \"corridors\" / \"D12_I5_S\"\nmasked_root = panel_root / \"train\" / \"mainline_states_masked\"\ntruth_root = panel_root / \"train\" / \"mainline_states\"\n\n# Load observed-only January and February masked rows for lag features.\nhistory_files = sorted(\n    p for p in masked_root.rglob(\"*.parquet\")\n    if (\"2031_01_\" in p.name or \"2031_02_\" in p.name)\n)\n\nhistory_parts = []\nfor p in history_files:\n    part = pd.read_parquet(p)\n    part[\"timestamp\"] = pd.to_datetime(part[\"timestamp\"], utc=True)\n    part = part.loc[part[\"is_observed\"] == 1,\n                    KEYS + [\"speed_kmh\", \"flow_vph\"]].copy()\n    part = part.rename(columns={\n        \"speed_kmh\": \"obs_speed\",\n        \"flow_vph\": \"obs_flow\",\n    })\n    history_parts.append(part)\n\nobserved_i5s = pd.concat(history_parts, ignore_index=True)\nobserved_i5s = observed_i5s.drop_duplicates(KEYS)\n\nprint(\"Observed history rows:\", len(observed_i5s))\nprint(\"Observed history date range:\",\n      observed_i5s[\"timestamp\"].min(),\n      \"to\", observed_i5s[\"timestamp\"].max())\n\n# Build January baseline from January truth.\njan_files = sorted(truth_root.glob(\"year_month=2031-01/*.parquet\"))\njan_parts = []\n\nfor p in jan_files:\n    part = pd.read_parquet(p)\n    part[\"timestamp\"] = pd.to_datetime(part[\"timestamp\"], utc=True)\n    jan_parts.append(part)\n\njan = pd.concat(jan_parts, ignore_index=True)\njan = jan.loc[\n    (jan[\"timestamp\"] >= \"2031-01-01\")\n    & (jan[\"timestamp\"] < \"2031-02-01\")\n].copy()\n\njan[\"weekday\"] = jan[\"timestamp\"].dt.dayofweek\njan[\"minute_of_day\"] = jan[\"timestamp\"].dt.hour * 60 + jan[\"timestamp\"].dt.minute\n\nprofile_i5s = (\n    jan.groupby([\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False)\n       .agg(base_speed=(\"speed_kmh\", \"median\"),\n            base_flow=(\"flow_vph\", \"median\"))\n)\n\nlink_profile_i5s = (\n    jan.groupby(\"link_id\", as_index=False)\n       .agg(link_base_speed=(\"speed_kmh\", \"median\"),\n            link_base_flow=(\"flow_vph\", \"median\"))\n)\n\nprint(\"January baseline profile rows:\", len(profile_i5s))\nprint(\"Link fallback rows:\", len(link_profile_i5s))\nprint(\"Links in baseline:\", jan[\"link_id\"].nunique())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:04:59.018793Z","iopub.execute_input":"2026-10-21T17:04:59.019293Z","iopub.status.idle":"2026-10-21T17:05:03.605832Z","shell.execute_reply.started":"2026-10-21T17:04:59.019262Z","shell.execute_reply":"2026-10-21T17:05:03.60498Z"}},"outputs":[{"name":"stdout","text":"Observed history rows: 1417280\nObserved history date range: 2031-01-01 00:00:00+00:00 to 2031-02-28 23:55:00+00:00\nJanuary baseline profile rows: 201600\nLink fallback rows: 100\nLinks in baseline: 100\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n# Prepare target rows and calendar features.\nfeb_features_i5s = training_i5s.copy()\nfeb_features_i5s[\"timestamp\"] = pd.to_datetime(\n    feb_features_i5s[\"timestamp\"], utc=True\n)\n\nfeb_features_i5s[\"weekday\"] = feb_features_i5s[\"timestamp\"].dt.dayofweek\nfeb_features_i5s[\"minute_of_day\"] = (\n    feb_features_i5s[\"timestamp\"].dt.hour * 60\n    + feb_features_i5s[\"timestamp\"].dt.minute\n)\n\n# Attach January baseline.\nfeb_features_i5s = feb_features_i5s.merge(\n    profile_i5s,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfeb_features_i5s = feb_features_i5s.merge(\n    link_profile_i5s,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\"\n)\n\nfeb_features_i5s[\"base_speed\"] = feb_features_i5s[\"base_speed\"].fillna(\n    feb_features_i5s[\"link_base_speed\"]\n)\nfeb_features_i5s[\"base_flow\"] = feb_features_i5s[\"base_flow\"].fillna(\n    feb_features_i5s[\"link_base_flow\"]\n)\n\nfeb_features_i5s.drop(\n    columns=[\"link_base_speed\", \"link_base_flow\"], inplace=True\n)\n\n# Add observed-only lags: 5, 15, 60, and 1440 minutes.\nobserved_i5s[\"timestamp\"] = pd.to_datetime(\n    observed_i5s[\"timestamp\"], utc=True\n)\n\nfor lag in [5, 15, 60, 1440]:\n    source = observed_i5s[\n        [\"timestamp\", \"station_id\", \"link_id\", \"obs_speed\", \"obs_flow\"]\n    ].copy()\n\n    # Shift observed source timestamps forward to the target time.\n    source[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    source = source.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n\n    feb_features_i5s = feb_features_i5s.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\"\n    )\n\n# Cyclical calendar features.\nfeb_features_i5s[\"tod_sin\"] = np.sin(\n    2 * np.pi * feb_features_i5s[\"minute_of_day\"] / 1440\n)\nfeb_features_i5s[\"tod_cos\"] = np.cos(\n    2 * np.pi * feb_features_i5s[\"minute_of_day\"] / 1440\n)\nfeb_features_i5s[\"weekday_sin\"] = np.sin(\n    2 * np.pi * feb_features_i5s[\"weekday\"] / 7\n)\nfeb_features_i5s[\"weekday_cos\"] = np.cos(\n    2 * np.pi * feb_features_i5s[\"weekday\"] / 7\n)\n\n# Stable categorical mappings for station, link, and regime.\ncategory_maps_i5s = {\n    \"station_id\": {\n        value: idx for idx, value in enumerate(\n            sorted(feb_features_i5s[\"station_id\"].astype(str).unique())\n        )\n    },\n    \"link_id\": {\n        value: idx for idx, value in enumerate(\n            sorted(feb_features_i5s[\"link_id\"].astype(str).unique())\n        )\n    },\n    \"mask_regime\": {\"R1\": 0, \"R2\": 1, \"R3\": 2},\n}\n\nfeb_features_i5s[\"station_id_code\"] = (\n    feb_features_i5s[\"station_id\"].astype(str)\n    .map(category_maps_i5s[\"station_id\"]).fillna(-1).astype(int)\n)\nfeb_features_i5s[\"link_id_code\"] = (\n    feb_features_i5s[\"link_id\"].astype(str)\n    .map(category_maps_i5s[\"link_id\"]).fillna(-1).astype(int)\n)\nfeb_features_i5s[\"mask_regime_code\"] = (\n    feb_features_i5s[\"mask_regime\"]\n    .map(category_maps_i5s[\"mask_regime\"]).fillna(-1).astype(int)\n)\n\nFEATURES_I5S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nassert len(FEATURES_I5S) == 19\nassert feb_features_i5s[\"base_speed\"].notna().all()\nassert feb_features_i5s[\"base_flow\"].notna().all()\nassert len(feb_features_i5s) == 616266\n\nprint(\"Feature matrix rows:\", len(feb_features_i5s))\nprint(\"Feature count:\", len(FEATURES_I5S))\nprint(\"Missing baseline values:\",\n      feb_features_i5s[[\"base_speed\", \"base_flow\"]].isna().sum().to_dict())\nprint(\"Missing lag values:\")\nprint(feb_features_i5s[\n    [c for c in FEATURES_I5S if c.startswith(\"lag_\")]\n].isna().sum().to_dict())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:05:52.040174Z","iopub.execute_input":"2026-10-21T17:05:52.040672Z","iopub.status.idle":"2026-10-21T17:05:58.125765Z","shell.execute_reply.started":"2026-10-21T17:05:52.040641Z","shell.execute_reply":"2026-10-21T17:05:58.124689Z"}},"outputs":[{"name":"stdout","text":"Feature matrix rows: 616266\nFeature count: 19\nMissing baseline values: {'base_speed': 0, 'base_flow': 0}\nMissing lag values:\n{'lag_speed_5': 248394, 'lag_flow_5': 248394, 'lag_speed_15': 252650, 'lag_flow_15': 252650, 'lag_speed_60': 261344, 'lag_flow_60': 261344, 'lag_speed_1440': 256337, 'lag_flow_1440': 256337}\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"import joblib\nimport numpy as np\nfrom pathlib import Path\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nWORK = Path(\"/kaggle/working\")\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nARTIFACT_DIR = LOCAL_RESUME_DIR / \"artifacts\"\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n\nX_i5s = feb_features_i5s[FEATURES_I5S].copy()\ny_speed_i5s = (\n    feb_features_i5s[\"speed_kmh\"] - feb_features_i5s[\"base_speed\"]\n)\ny_flow_i5s = (\n    feb_features_i5s[\"flow_vph\"] - feb_features_i5s[\"base_flow\"]\n)\n\nmodel_params_i5s = dict(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\nspeed_model_i5s_final = HistGradientBoostingRegressor(**model_params_i5s)\nflow_model_i5s_final = HistGradientBoostingRegressor(**model_params_i5s)\n\nprint(\"Training final speed model...\")\nspeed_model_i5s_final.fit(X_i5s, y_speed_i5s)\n\nprint(\"Training final flow model...\")\nflow_model_i5s_final.fit(X_i5s, y_flow_i5s)\n\n# Save a separate, resumable artifact for D12_I5_S.\ni5s_artifact = {\n    \"speed_model\": speed_model_i5s_final,\n    \"flow_model\": flow_model_i5s_final,\n    \"features\": FEATURES_I5S,\n    \"category_maps\": category_maps_i5s,\n    \"model_params\": model_params_i5s,\n    \"baseline_profile\": profile_i5s,\n    \"link_profile\": link_profile_i5s,\n}\n\nmodel_path_i5s = ARTIFACT_DIR / \"D12_I5_S_final.joblib\"\njoblib.dump(i5s_artifact, model_path_i5s, compress=3)\n\n# Verify saved model can be loaded.\ncheck_i5s = joblib.load(model_path_i5s)\nassert check_i5s[\"features\"] == FEATURES_I5S\nassert len(check_i5s[\"features\"]) == 19\n\nprint(\"\\nFinal models trained and saved.\")\nprint(\"Artifact:\", model_path_i5s)\nprint(\"Artifact size (MiB):\", round(model_path_i5s.stat().st_size / (1024**2), 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:07:12.239508Z","iopub.execute_input":"2026-10-21T17:07:12.240013Z","iopub.status.idle":"2026-10-21T17:07:26.398538Z","shell.execute_reply.started":"2026-10-21T17:07:12.239979Z","shell.execute_reply":"2026-10-21T17:07:26.397685Z"}},"outputs":[{"name":"stdout","text":"Training final speed model...\nTraining final flow model...\n\nFinal models trained and saved.\nArtifact: /kaggle/working/trafficflow_resume/artifacts/D12_I5_S_final.joblib\nArtifact size (MiB): 3.15\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\npanel_name = \"D12_I5_S\"\n\nfor split in [\"validation\", \"private\"]:\n    template_path = (\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n    template = pd.read_csv(template_path)\n\n    print(f\"\\n{split.upper()}\")\n    print(\"Rows:\", len(template))\n    print(\"Columns:\", template.columns.tolist())\n    print(\"Timestamp range:\",\n          template[\"timestamp\"].min(),\n          \"to\", template[\"timestamp\"].max())\n    print(\"Duplicate keys:\",\n          template.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:08:49.315766Z","iopub.execute_input":"2026-10-21T17:08:49.316303Z","iopub.status.idle":"2026-10-21T17:08:50.013341Z","shell.execute_reply.started":"2026-10-21T17:08:49.316266Z","shell.execute_reply":"2026-10-21T17:08:50.012296Z"}},"outputs":[{"name":"stdout","text":"\nVALIDATION\nRows: 219222\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\nTimestamp range: 2031-03-01T00:00:00Z to 2031-03-31T23:55:00Z\nDuplicate keys: 0\n\nPRIVATE\nRows: 204957\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\nTimestamp range: 2031-04-01T00:00:00Z to 2031-04-30T23:55:00Z\nDuplicate keys: 0\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nfrom pathlib import Path\n\npanel_name = \"D12_I5_S\"\npanel_root = ROOT / \"corridors\" / panel_name\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\n# Use the trained model artifact, mappings, and baseline profiles.\nartifact = joblib.load(\n    Path(\"/kaggle/working/trafficflow_resume/artifacts/D12_I5_S_final.joblib\")\n)\nspeed_model_i5s_final = artifact[\"speed_model\"]\nflow_model_i5s_final = artifact[\"flow_model\"]\nFEATURES_I5S = artifact[\"features\"]\ncategory_maps_i5s = artifact[\"category_maps\"]\nprofile_i5s = artifact[\"baseline_profile\"]\nlink_profile_i5s = artifact[\"link_profile\"]\n\ndef load_observed_split(split):\n    root = panel_root / split / \"mainline_states_masked\"\n    files = sorted(root.rglob(\"*.parquet\"))\n    parts = []\n\n    for path in files:\n        df = pd.read_parquet(path)\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df = df.loc[df[\"is_observed\"] == 1,\n                    KEYS + [\"speed_kmh\", \"flow_vph\"]].copy()\n        df = df.rename(columns={\n            \"speed_kmh\": \"obs_speed\",\n            \"flow_vph\": \"obs_flow\",\n        })\n        parts.append(df)\n\n    if not parts:\n        return pd.DataFrame(\n            columns=KEYS + [\"obs_speed\", \"obs_flow\"]\n        )\n\n    return pd.concat(parts, ignore_index=True).drop_duplicates(KEYS)\n\ndef make_inference_features(template, observed_history):\n    df = template[[\"panel\"] + KEYS + [\"mask_regime\"]].copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n\n    df[\"weekday\"] = df[\"timestamp\"].dt.dayofweek\n    df[\"minute_of_day\"] = (\n        df[\"timestamp\"].dt.hour * 60 + df[\"timestamp\"].dt.minute\n    )\n\n    df = df.merge(\n        profile_i5s,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    df = df.merge(\n        link_profile_i5s,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    df[\"base_speed\"] = df[\"base_speed\"].fillna(df[\"link_base_speed\"])\n    df[\"base_flow\"] = df[\"base_flow\"].fillna(df[\"link_base_flow\"])\n    df.drop(columns=[\"link_base_speed\", \"link_base_flow\"], inplace=True)\n\n    history = observed_history.copy()\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n\n    for lag in [5, 15, 60, 1440]:\n        source = history[\n            KEYS + [\"obs_speed\", \"obs_flow\"]\n        ].copy()\n        source[\"timestamp\"] += pd.Timedelta(minutes=lag)\n        source = source.rename(columns={\n            \"obs_speed\": f\"lag_speed_{lag}\",\n            \"obs_flow\": f\"lag_flow_{lag}\",\n        })\n        df = df.merge(\n            source, on=KEYS, how=\"left\", validate=\"one_to_one\"\n        )\n\n    df[\"tod_sin\"] = np.sin(2 * np.pi * df[\"minute_of_day\"] / 1440)\n    df[\"tod_cos\"] = np.cos(2 * np.pi * df[\"minute_of_day\"] / 1440)\n    df[\"weekday_sin\"] = np.sin(2 * np.pi * df[\"weekday\"] / 7)\n    df[\"weekday_cos\"] = np.cos(2 * np.pi * df[\"weekday\"] / 7)\n\n    df[\"station_id_code\"] = (\n        df[\"station_id\"].astype(str)\n        .map(category_maps_i5s[\"station_id\"]).fillna(-1).astype(int)\n    )\n    df[\"link_id_code\"] = (\n        df[\"link_id\"].astype(str)\n        .map(category_maps_i5s[\"link_id\"]).fillna(-1).astype(int)\n    )\n    df[\"mask_regime_code\"] = (\n        df[\"mask_regime\"]\n        .map(category_maps_i5s[\"mask_regime\"]).fillna(-1).astype(int)\n    )\n\n    assert df[[\"base_speed\", \"base_flow\"]].notna().all().all()\n    return df\n\ndef predict_and_verify(split, observed_history):\n    template_path = (\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n    template = pd.read_csv(template_path)\n    features = make_inference_features(template, observed_history)\n\n    X = features[FEATURES_I5S]\n    pred_speed = (\n        features[\"base_speed\"].to_numpy()\n        + speed_model_i5s_final.predict(X)\n    )\n    pred_flow = (\n        features[\"base_flow\"].to_numpy()\n        + flow_model_i5s_final.predict(X)\n    )\n\n    out = template.copy()\n    out[\"speed_kmh\"] = np.clip(pred_speed, 0, 160)\n    out[\"flow_vph\"] = np.clip(pred_flow, 0, None)\n\n    # Exact key coverage, duplicate, and prediction checks.\n    template_keys = template[KEYS].copy()\n    output_keys = out[KEYS].copy()\n    for frame in [template_keys, output_keys]:\n        frame[\"timestamp\"] = pd.to_datetime(frame[\"timestamp\"], utc=True)\n\n    assert len(out) == len(template)\n    assert not output_keys.duplicated().any()\n    assert set(map(tuple, template_keys.to_numpy())) == set(\n        map(tuple, output_keys.to_numpy())\n    )\n    assert out[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n    assert np.isfinite(out[[\"speed_kmh\", \"flow_vph\"]].to_numpy()).all()\n\n    output_path = Path(\"/kaggle/working\") / (\n        f\"{panel_name}_{'march' if split == 'validation' else 'april'}\"\n        \"_predictions_verified.csv\"\n    )\n    out.to_csv(output_path, index=False)\n\n    print(\n        f\"{split}: {len(out):,} rows | \"\n        f\"speed [{out['speed_kmh'].min():.2f}, {out['speed_kmh'].max():.2f}] | \"\n        f\"flow [{out['flow_vph'].min():.2f}, {out['flow_vph'].max():.2f}]\"\n    )\n    print(\"Saved:\", output_path)\n    return out\n\n# Load observed March values first.\nobserved_march_i5s = load_observed_split(\"validation\")\n\n# March predictions use observed Jan/Feb history.\nmarch_i5s = pd.read_csv(\n    ROOT / \"task1\" / panel_name / \"validation\" / \"sample_submission_state.csv\"\n)\nmarch_i5s[\"timestamp\"] = pd.to_datetime(march_i5s[\"timestamp\"], utc=True)\n\nhistory_march_i5s = observed_i5s.copy()\nhistory_march_i5s[\"timestamp\"] = pd.to_datetime(\n    history_march_i5s[\"timestamp\"], utc=True\n)\nhistory_march_i5s = history_march_i5s[\n    [\"timestamp\", \"station_id\", \"link_id\", \"obs_speed\", \"obs_flow\"]\n]\n\nmarch_pred_i5s = predict_and_verify(\"validation\", history_march_i5s)\n\n# April uses observed Jan/Feb history plus genuinely observed March values.\nobserved_march_i5s[\"timestamp\"] = pd.to_datetime(\n    observed_march_i5s[\"timestamp\"], utc=True\n)\nhistory_april_i5s = pd.concat(\n    [history_march_i5s, observed_march_i5s],\n    ignore_index=True,\n).drop_duplicates(KEYS, keep=\"last\")\n\napril_pred_i5s = predict_and_verify(\"private\", history_april_i5s)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:09:30.720625Z","iopub.execute_input":"2026-10-21T17:09:30.721182Z","iopub.status.idle":"2026-10-21T17:09:59.854472Z","shell.execute_reply.started":"2026-10-21T17:09:30.721147Z","shell.execute_reply":"2026-10-21T17:09:59.853536Z"}},"outputs":[{"name":"stdout","text":"validation: 219,222 rows | speed [11.00, 121.83] | flow [496.05, 9185.79]\nSaved: /kaggle/working/D12_I5_S_march_predictions_verified.csv\nprivate: 204,957 rows | speed [11.00, 122.14] | flow [496.05, 9368.92]\nSaved: /kaggle/working/D12_I5_S_april_predictions_verified.csv\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"import json\nimport shutil\nimport zipfile\nfrom pathlib import Path\n\nimport pandas as pd\n\nWORK = Path(\"/kaggle/working\")\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nPRED_DIR = LOCAL_RESUME_DIR / \"predictions\"\nARTIFACT_DIR = LOCAL_RESUME_DIR / \"artifacts\"\n\nPRED_DIR.mkdir(parents=True, exist_ok=True)\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n\npanel_name = \"D12_I5_S\"\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nmarch_path = WORK / \"D12_I5_S_march_predictions_verified.csv\"\napril_path = WORK / \"D12_I5_S_april_predictions_verified.csv\"\n\nmarch = pd.read_csv(march_path)\napril = pd.read_csv(april_path)\n\n# Reverify each split against its official template.\nfor split, pred in [(\"validation\", march), (\"private\", april)]:\n    template_path = (\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n    template = pd.read_csv(template_path)\n\n    assert len(pred) == len(template), f\"{split}: row-count mismatch\"\n\n    pred_keys = pred[KEYS].copy()\n    template_keys = template[KEYS].copy()\n\n    pred_keys[\"timestamp\"] = pd.to_datetime(pred_keys[\"timestamp\"], utc=True)\n    template_keys[\"timestamp\"] = pd.to_datetime(\n        template_keys[\"timestamp\"], utc=True\n    )\n\n    assert not pred_keys.duplicated().any(), f\"{split}: duplicate prediction keys\"\n    assert not template_keys.duplicated().any(), f\"{split}: duplicate template keys\"\n    assert set(map(tuple, pred_keys.to_numpy())) == set(\n        map(tuple, template_keys.to_numpy())\n    ), f\"{split}: template coverage mismatch\"\n\n    assert pred[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n    assert pred[[\"speed_kmh\", \"flow_vph\"]].apply(\n        lambda col: col.map(lambda x: pd.notna(x) and abs(x) != float(\"inf\"))\n    ).all().all()\n\n    pred[\"split\"] = split\n\n# Combine predictions in a single checkpoint.\ncombined = pd.concat([march, april], ignore_index=True)\n\nassert len(combined) == 424179\nassert not combined.duplicated([\"split\"] + KEYS).any()\nassert combined[\"split\"].value_counts().to_dict() == {\n    \"validation\": 219222,\n    \"private\": 204957,\n}\n\ncombined_path = PRED_DIR / \"D12_I5_S_predictions_checkpoint.csv\"\ncombined.to_csv(combined_path, index=False)\n\n# Preserve the original verified checkpoints from the mounted dataset.\nsource_pred_dir = RESUME_DIR / \"predictions\"\nfor filename in [\n    \"D12_I405_S_predictions_checkpoint.csv\",\n    \"D12_I5_N_predictions_checkpoint.csv\",\n    \"task1_predictions_checkpoint.csv\",\n]:\n    src = source_pred_dir / filename\n    dst = PRED_DIR / filename\n    if src.exists():\n        shutil.copy2(src, dst)\n\n# Preserve saved model artifacts from the original package.\nsource_artifacts = RESUME_DIR / \"artifacts\"\nfor src in source_artifacts.glob(\"*\"):\n    if src.is_file():\n        shutil.copy2(src, ARTIFACT_DIR / src.name)\n\n# Add final D12_I5_S artifact.\nfinal_model_path = ARTIFACT_DIR / \"D12_I5_S_final.joblib\"\nassert final_model_path.exists(), \"Final D12_I5_S model artifact missing\"\n\n# Update the writable manifest.\nmanifest_path = LOCAL_RESUME_DIR / \"manifest.json\"\nif manifest_path.exists():\n    manifest = json.loads(manifest_path.read_text())\nelse:\n    manifest = json.loads((RESUME_DIR / \"manifest.json\").read_text())\n\ncompleted = set(manifest.get(\"completed_panels\", []))\ncompleted.update([\"D12_I405_S\", \"D12_I5_N\", \"D7_I405_S\", \"D12_I5_S\"])\n\nmanifest.update({\n    \"completed_panels\": sorted(completed),\n    \"completed_panels_count\": len(completed),\n    \"current_panel\": \"D12_I5_S\",\n    \"current_panel_status\": \"PREDICTIONS_CHECKPOINTED\",\n    \"final_submission_created\": False,\n    \"next_action\": (\n        \"Proceed to the next uncompleted panel. Verify its training labels, \"\n        \"build observed-only lags and January baseline, evaluate, train final \"\n        \"models, generate March/April predictions, and checkpoint.\"\n    ),\n})\n\nmanifest_path.write_text(json.dumps(manifest, indent=2))\n\n# Rebuild the portable resume package.\nzip_path = WORK / \"trafficflow_resume_package.zip\"\nwith zipfile.ZipFile(\n    zip_path, \"w\", compression=zipfile.ZIP_DEFLATED\n) as zf:\n    for path in LOCAL_RESUME_DIR.rglob(\"*\"):\n        if path.is_file():\n            zf.write(path, path.relative_to(WORK))\n\nwith zipfile.ZipFile(zip_path, \"r\") as zf:\n    assert zf.testzip() is None\n\nprint(\"D12_I5_S checkpoint saved and verified.\")\nprint(\"March rows:\", len(march))\nprint(\"April rows:\", len(april))\nprint(\"Combined rows:\", len(combined))\nprint(\"Completed panels:\", manifest[\"completed_panels\"])\nprint(\"Panel count:\", len(completed), \"/ 10\")\nprint(\"Resume ZIP:\", zip_path)\nprint(\"ZIP size (MiB):\", round(zip_path.stat().st_size / (1024**2), 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:11:12.818572Z","iopub.execute_input":"2026-10-21T17:11:12.818934Z","iopub.status.idle":"2026-10-21T17:11:30.786646Z","shell.execute_reply.started":"2026-10-21T17:11:12.818904Z","shell.execute_reply":"2026-10-21T17:11:30.785641Z"}},"outputs":[{"name":"stdout","text":"D12_I5_S checkpoint saved and verified.\nMarch rows: 219222\nApril rows: 204957\nCombined rows: 424179\nCompleted panels: ['D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I405_S']\nPanel count: 4 / 10\nResume ZIP: /kaggle/working/trafficflow_resume_package.zip\nZIP size (MiB): 57.01\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_name = \"D12_I405_N\"\npanel_root = ROOT / \"corridors\" / panel_name\n\nprint(\"Panel directory exists:\", panel_root.exists())\n\nfor rel in [\n    \"train/mainline_states\",\n    \"train/mainline_states_masked\",\n    \"validation/mainline_states_masked\",\n    \"private/mainline_states_masked\",\n    \"network/links.csv\",\n]:\n    path = panel_root / rel\n    print(f\"{rel}: {path.exists()}\")\n\ntruth_files = sorted(\n    (panel_root / \"train\" / \"mainline_states\")\n    .glob(\"year_month=2031-02/*.parquet\")\n)\nmasked_files = sorted(\n    p for p in (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\nprint(\"\\nFebruary truth files:\", len(truth_files))\nprint(\"February masked files:\", len(masked_files))\n\nif truth_files:\n    sample = pd.read_parquet(truth_files[0])\n    print(\"Truth columns:\", sample.columns.tolist())\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:12:28.361767Z","iopub.execute_input":"2026-10-21T17:12:28.362408Z","iopub.status.idle":"2026-10-21T17:12:28.445801Z","shell.execute_reply.started":"2026-10-21T17:12:28.362366Z","shell.execute_reply":"2026-10-21T17:12:28.444887Z"}},"outputs":[{"name":"stdout","text":"Panel directory exists: True\ntrain/mainline_states: True\ntrain/mainline_states_masked: True\nvalidation/mainline_states_masked: True\nprivate/mainline_states_masked: True\nnetwork/links.csv: True\n\nFebruary truth files: 28\nFebruary masked files: 28\nTruth columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"import pandas as pd\nfrom pathlib import Path\n\npanel_name = \"D12_I405_N\"\npanel_root = ROOT / \"corridors\" / panel_name\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ntruth_files = sorted(\n    (panel_root / \"train\" / \"mainline_states\")\n    .glob(\"year_month=2031-02/*.parquet\")\n)\nmasked_files = sorted(\n    p for p in (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\ntruth = pd.concat(\n    [pd.read_parquet(p) for p in truth_files],\n    ignore_index=True\n)\nmasked = pd.concat(\n    [pd.read_parquet(p) for p in masked_files],\n    ignore_index=True\n)\n\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n\ntraining_i405n = truth.loc[\n    (truth[\"is_score_eligible\"] == 1)\n    & (truth[\"timestamp\"] >= \"2031-02-01\")\n    & (truth[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].copy()\n\nregimes_i405n = masked.loc[\n    (masked[\"timestamp\"] >= \"2031-02-01\")\n    & (masked[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"mask_regime\"]\n].copy()\n\nassert not training_i405n.duplicated(KEYS).any()\nassert not regimes_i405n.duplicated(KEYS).any()\n\ntraining_i405n = training_i405n.merge(\n    regimes_i405n,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nassert training_i405n[\"mask_regime\"].notna().all()\nassert training_i405n[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n\nprint(\"Eligible February labels:\", len(training_i405n))\nprint(\"\\nRegime counts:\")\nprint(training_i405n[\"mask_regime\"].value_counts().sort_index())\nprint(\"\\nDuplicate keys:\", training_i405n.duplicated(KEYS).sum())\nprint(\"Missing regimes:\", training_i405n[\"mask_regime\"].isna().sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:12:58.606027Z","iopub.execute_input":"2026-10-21T17:12:58.607306Z","iopub.status.idle":"2026-10-21T17:13:02.464173Z","shell.execute_reply.started":"2026-10-21T17:12:58.607265Z","shell.execute_reply":"2026-10-21T17:13:02.462968Z"}},"outputs":[{"name":"stdout","text":"Eligible February labels: 549076\n\nRegime counts:\nmask_regime\nR1     78550\nR2    234987\nR3    235539\nName: count, dtype: int64\n\nDuplicate keys: 0\nMissing regimes: 0\n","output_type":"stream"}],"execution_count":19},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\npanel_name = \"D12_I405_N\"\npanel_root = ROOT / \"corridors\" / panel_name\nmasked_root = panel_root / \"train\" / \"mainline_states_masked\"\ntruth_root = panel_root / \"train\" / \"mainline_states\"\n\n# Load observed-only history from January and February.\nhistory_files = sorted(\n    p for p in masked_root.rglob(\"*.parquet\")\n    if (\"2031_01_\" in p.name or \"2031_02_\" in p.name)\n)\n\nhistory_parts = []\nfor p in history_files:\n    part = pd.read_parquet(p)\n    part[\"timestamp\"] = pd.to_datetime(part[\"timestamp\"], utc=True)\n    part = part.loc[\n        part[\"is_observed\"] == 1,\n        KEYS + [\"speed_kmh\", \"flow_vph\"]\n    ].copy()\n    part = part.rename(columns={\n        \"speed_kmh\": \"obs_speed\",\n        \"flow_vph\": \"obs_flow\",\n    })\n    history_parts.append(part)\n\nobserved_i405n = pd.concat(history_parts, ignore_index=True)\nobserved_i405n = observed_i405n.drop_duplicates(KEYS)\n\nprint(\"Observed history rows:\", len(observed_i405n))\nprint(\"Date range:\",\n      observed_i405n[\"timestamp\"].min(),\n      \"to\", observed_i405n[\"timestamp\"].max())\n\n# January truth baseline.\njan_files = sorted(truth_root.glob(\"year_month=2031-01/*.parquet\"))\njan_parts = []\n\nfor p in jan_files:\n    part = pd.read_parquet(p)\n    part[\"timestamp\"] = pd.to_datetime(part[\"timestamp\"], utc=True)\n    jan_parts.append(part)\n\njan_i405n = pd.concat(jan_parts, ignore_index=True)\njan_i405n = jan_i405n.loc[\n    (jan_i405n[\"timestamp\"] >= \"2031-01-01\")\n    & (jan_i405n[\"timestamp\"] < \"2031-02-01\")\n].copy()\n\njan_i405n[\"weekday\"] = jan_i405n[\"timestamp\"].dt.dayofweek\njan_i405n[\"minute_of_day\"] = (\n    jan_i405n[\"timestamp\"].dt.hour * 60\n    + jan_i405n[\"timestamp\"].dt.minute\n)\n\nprofile_i405n = (\n    jan_i405n.groupby(\n        [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n    )\n    .agg(\n        base_speed=(\"speed_kmh\", \"median\"),\n        base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\nlink_profile_i405n = (\n    jan_i405n.groupby(\"link_id\", as_index=False)\n    .agg(\n        link_base_speed=(\"speed_kmh\", \"median\"),\n        link_base_flow=(\"flow_vph\", \"median\"),\n    )\n)\n\nprint(\"January profile rows:\", len(profile_i405n))\nprint(\"Link fallback rows:\", len(link_profile_i405n))\nprint(\"Links in January baseline:\", jan_i405n[\"link_id\"].nunique())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:13:44.411149Z","iopub.execute_input":"2026-10-21T17:13:44.411983Z","iopub.status.idle":"2026-10-21T17:13:48.958164Z","shell.execute_reply.started":"2026-10-21T17:13:44.411936Z","shell.execute_reply":"2026-10-21T17:13:48.957323Z"}},"outputs":[{"name":"stdout","text":"Observed history rows: 1263091\nDate range: 2031-01-01 00:00:00+00:00 to 2031-02-28 23:55:00+00:00\nJanuary profile rows: 179424\nLink fallback rows: 89\nLinks in January baseline: 89\n","output_type":"stream"}],"execution_count":20},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nfeb_features_i405n = training_i405n.copy()\nfeb_features_i405n[\"timestamp\"] = pd.to_datetime(\n    feb_features_i405n[\"timestamp\"], utc=True\n)\n\nfeb_features_i405n[\"weekday\"] = feb_features_i405n[\"timestamp\"].dt.dayofweek\nfeb_features_i405n[\"minute_of_day\"] = (\n    feb_features_i405n[\"timestamp\"].dt.hour * 60\n    + feb_features_i405n[\"timestamp\"].dt.minute\n)\n\nfeb_features_i405n = feb_features_i405n.merge(\n    profile_i405n,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i405n = feb_features_i405n.merge(\n    link_profile_i405n,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i405n[\"base_speed\"] = feb_features_i405n[\"base_speed\"].fillna(\n    feb_features_i405n[\"link_base_speed\"]\n)\nfeb_features_i405n[\"base_flow\"] = feb_features_i405n[\"base_flow\"].fillna(\n    feb_features_i405n[\"link_base_flow\"]\n)\nfeb_features_i405n.drop(\n    columns=[\"link_base_speed\", \"link_base_flow\"], inplace=True\n)\n\n# Observed-only lag features.\nobserved_i405n[\"timestamp\"] = pd.to_datetime(\n    observed_i405n[\"timestamp\"], utc=True\n)\n\nfor lag in [5, 15, 60, 1440]:\n    source = observed_i405n[\n        KEYS + [\"obs_speed\", \"obs_flow\"]\n    ].copy()\n    source[\"timestamp\"] += pd.Timedelta(minutes=lag)\n    source = source.rename(columns={\n        \"obs_speed\": f\"lag_speed_{lag}\",\n        \"obs_flow\": f\"lag_flow_{lag}\",\n    })\n\n    feb_features_i405n = feb_features_i405n.merge(\n        source,\n        on=KEYS,\n        how=\"left\",\n        validate=\"one_to_one\",\n    )\n\n# Cyclical calendar features.\nfeb_features_i405n[\"tod_sin\"] = np.sin(\n    2 * np.pi * feb_features_i405n[\"minute_of_day\"] / 1440\n)\nfeb_features_i405n[\"tod_cos\"] = np.cos(\n    2 * np.pi * feb_features_i405n[\"minute_of_day\"] / 1440\n)\nfeb_features_i405n[\"weekday_sin\"] = np.sin(\n    2 * np.pi * feb_features_i405n[\"weekday\"] / 7\n)\nfeb_features_i405n[\"weekday_cos\"] = np.cos(\n    2 * np.pi * feb_features_i405n[\"weekday\"] / 7\n)\n\ncategory_maps_i405n = {\n    \"station_id\": {\n        value: idx for idx, value in enumerate(\n            sorted(feb_features_i405n[\"station_id\"].astype(str).unique())\n        )\n    },\n    \"link_id\": {\n        value: idx for idx, value in enumerate(\n            sorted(feb_features_i405n[\"link_id\"].astype(str).unique())\n        )\n    },\n    \"mask_regime\": {\"R1\": 0, \"R2\": 1, \"R3\": 2},\n}\n\nfeb_features_i405n[\"station_id_code\"] = (\n    feb_features_i405n[\"station_id\"].astype(str)\n    .map(category_maps_i405n[\"station_id\"]).fillna(-1).astype(int)\n)\nfeb_features_i405n[\"link_id_code\"] = (\n    feb_features_i405n[\"link_id\"].astype(str)\n    .map(category_maps_i405n[\"link_id\"]).fillna(-1).astype(int)\n)\nfeb_features_i405n[\"mask_regime_code\"] = (\n    feb_features_i405n[\"mask_regime\"]\n    .map(category_maps_i405n[\"mask_regime\"]).fillna(-1).astype(int)\n)\n\nFEATURES_I405N = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nassert len(feb_features_i405n) == 549076\nassert len(FEATURES_I405N) == 19\nassert feb_features_i405n[[\"base_speed\", \"base_flow\"]].notna().all().all()\n\nprint(\"Feature matrix rows:\", len(feb_features_i405n))\nprint(\"Feature count:\", len(FEATURES_I405N))\nprint(\"Missing baseline values:\",\n      feb_features_i405n[[\"base_speed\", \"base_flow\"]].isna().sum().to_dict())\nprint(\"Missing lag values:\")\nprint(feb_features_i405n[\n    [c for c in FEATURES_I405N if c.startswith(\"lag_\")]\n].isna().sum().to_dict())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:14:31.231818Z","iopub.execute_input":"2026-10-21T17:14:31.232543Z","iopub.status.idle":"2026-10-21T17:14:36.989563Z","shell.execute_reply.started":"2026-10-21T17:14:31.232501Z","shell.execute_reply":"2026-10-21T17:14:36.988144Z"}},"outputs":[{"name":"stdout","text":"Feature matrix rows: 549076\nFeature count: 19\nMissing baseline values: {'base_speed': 0, 'base_flow': 0}\nMissing lag values:\n{'lag_speed_5': 236198, 'lag_flow_5': 236198, 'lag_speed_15': 239024, 'lag_flow_15': 239024, 'lag_speed_60': 246089, 'lag_flow_60': 246089, 'lag_speed_1440': 242015, 'lag_flow_1440': 242015}\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"import numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\n\ndf = feb_features_i405n.sort_values(\"timestamp\").reset_index(drop=True)\n\n# Split chronologically: last 20% of unique timestamps for holdout.\nunique_times = np.sort(df[\"timestamp\"].unique())\ncutoff = unique_times[int(len(unique_times) * 0.8)]\n\ntrain_mask = df[\"timestamp\"] < cutoff\nholdout_mask = df[\"timestamp\"] >= cutoff\n\ntrain_df = df.loc[train_mask].copy()\nholdout_df = df.loc[holdout_mask].copy()\n\nX_train = train_df[FEATURES_I405N]\nX_holdout = holdout_df[FEATURES_I405N]\n\nspeed_model_i405n_eval = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\nflow_model_i405n_eval = HistGradientBoostingRegressor(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\nspeed_model_i405n_eval.fit(\n    X_train,\n    train_df[\"speed_kmh\"] - train_df[\"base_speed\"]\n)\nflow_model_i405n_eval.fit(\n    X_train,\n    train_df[\"flow_vph\"] - train_df[\"base_flow\"]\n)\n\npred_speed = np.clip(\n    holdout_df[\"base_speed\"].to_numpy()\n    + speed_model_i405n_eval.predict(X_holdout),\n    0, 160\n)\npred_flow = np.clip(\n    holdout_df[\"base_flow\"].to_numpy()\n    + flow_model_i405n_eval.predict(X_holdout),\n    0, None\n)\n\nspeed_rmse = np.sqrt(mean_squared_error(\n    holdout_df[\"speed_kmh\"], pred_speed\n))\nflow_rmse_lane = np.sqrt(np.mean(\n    ((holdout_df[\"flow_vph\"].to_numpy() - pred_flow)\n     / holdout_df[\"link_id\"].map(\n         pd.Series(\n             pd.read_csv(panel_root / \"network\" / \"links.csv\")\n               .set_index(\"link_id\")[\"lanes\"]\n         )\n     ).to_numpy()) ** 2\n))\n\nS_speed = max(0, 1 - speed_rmse / 25)\nS_flow = max(0, 1 - flow_rmse_lane / 600)\nS_state = 0.54 * S_speed + 0.46 * S_flow\n\nprint(\"Panel:\", \"D12_I405_N\")\nprint(\"Training rows:\", len(train_df))\nprint(\"Holdout rows:\", len(holdout_df))\nprint(f\"Speed RMSE: {speed_rmse:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_rmse_lane:.4f}\")\nprint(f\"S_speed: {S_speed:.6f}\")\nprint(f\"S_flow: {S_flow:.6f}\")\nprint(f\"Estimated state score: {S_state:.6f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:15:18.052578Z","iopub.execute_input":"2026-10-21T17:15:18.053215Z","iopub.status.idle":"2026-10-21T17:15:30.80317Z","shell.execute_reply.started":"2026-10-21T17:15:18.053176Z","shell.execute_reply":"2026-10-21T17:15:30.802386Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I405_N\nTraining rows: 439514\nHoldout rows: 109562\nSpeed RMSE: 3.7543 km/h\nFlow RMSE per lane: 75.0684\nS_speed: 0.849830\nS_flow: 0.874886\nEstimated state score: 0.861356\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"import joblib\nfrom pathlib import Path\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nWORK = Path(\"/kaggle/working\")\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nARTIFACT_DIR = LOCAL_RESUME_DIR / \"artifacts\"\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n\nX = feb_features_i405n[FEATURES_I405N]\n\nspeed_model_i405n_final = HistGradientBoostingRegressor(\n    learning_rate=0.06, max_iter=150, max_leaf_nodes=31,\n    l2_regularization=5.0, early_stopping=True,\n    validation_fraction=0.1, n_iter_no_change=15, random_state=42\n)\nflow_model_i405n_final = HistGradientBoostingRegressor(\n    learning_rate=0.06, max_iter=150, max_leaf_nodes=31,\n    l2_regularization=5.0, early_stopping=True,\n    validation_fraction=0.1, n_iter_no_change=15, random_state=42\n)\n\nprint(\"Training final speed model...\")\nspeed_model_i405n_final.fit(\n    X, feb_features_i405n[\"speed_kmh\"] - feb_features_i405n[\"base_speed\"]\n)\n\nprint(\"Training final flow model...\")\nflow_model_i405n_final.fit(\n    X, feb_features_i405n[\"flow_vph\"] - feb_features_i405n[\"base_flow\"]\n)\n\nartifact = {\n    \"speed_model\": speed_model_i405n_final,\n    \"flow_model\": flow_model_i405n_final,\n    \"features\": FEATURES_I405N,\n    \"category_maps\": category_maps_i405n,\n    \"model_params\": {\n        \"learning_rate\": 0.06,\n        \"max_iter\": 150,\n        \"max_leaf_nodes\": 31,\n        \"l2_regularization\": 5.0,\n        \"early_stopping\": True,\n        \"validation_fraction\": 0.1,\n        \"n_iter_no_change\": 15,\n        \"random_state\": 42,\n    },\n    \"baseline_profile\": profile_i405n,\n    \"link_profile\": link_profile_i405n,\n}\n\nartifact_path = ARTIFACT_DIR / \"D12_I405_N_final.joblib\"\njoblib.dump(artifact, artifact_path, compress=3)\n\ncheck = joblib.load(artifact_path)\nassert check[\"features\"] == FEATURES_I405N\n\nprint(\"Final models saved:\", artifact_path)\nprint(\"Artifact size (MiB):\", round(artifact_path.stat().st_size / (1024**2), 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:16:32.823864Z","iopub.execute_input":"2026-10-21T17:16:32.824642Z","iopub.status.idle":"2026-10-21T17:16:45.479272Z","shell.execute_reply.started":"2026-10-21T17:16:32.824606Z","shell.execute_reply":"2026-10-21T17:16:45.478365Z"}},"outputs":[{"name":"stdout","text":"Training final speed model...\nTraining final flow model...\nFinal models saved: /kaggle/working/trafficflow_resume/artifacts/D12_I405_N_final.joblib\nArtifact size (MiB): 3.0\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"import joblib\nimport pandas as pd\nfrom pathlib import Path\n\npanel_name = \"D12_I405_N\"\npanel_root = ROOT / \"corridors\" / panel_name\n\nartifact_path = Path(\n    \"/kaggle/working/trafficflow_resume/artifacts/D12_I405_N_final.joblib\"\n)\nartifact = joblib.load(artifact_path)\n\nspeed_model_i405n_final = artifact[\"speed_model\"]\nflow_model_i405n_final = artifact[\"flow_model\"]\nFEATURES_I405N = artifact[\"features\"]\ncategory_maps_i405n = artifact[\"category_maps\"]\nprofile_i405n = artifact[\"baseline_profile\"]\nlink_profile_i405n = artifact[\"link_profile\"]\n\nfor split in [\"validation\", \"private\"]:\n    template_path = (\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n    template = pd.read_csv(template_path)\n\n    print(f\"\\n{split.upper()}\")\n    print(\"Rows:\", len(template))\n    print(\"Columns:\", template.columns.tolist())\n    print(\"Duplicate keys:\",\n          template.duplicated([\"timestamp\", \"station_id\", \"link_id\"]).sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:17:52.80049Z","iopub.execute_input":"2026-10-21T17:17:52.801052Z","iopub.status.idle":"2026-10-21T17:17:53.720877Z","shell.execute_reply.started":"2026-10-21T17:17:52.801014Z","shell.execute_reply":"2026-10-21T17:17:53.719582Z"}},"outputs":[{"name":"stdout","text":"\nVALIDATION\nRows: 203337\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\nDuplicate keys: 0\n\nPRIVATE\nRows: 192164\nColumns: ['panel', 'timestamp', 'station_id', 'link_id', 'mask_regime', 'speed_kmh', 'flow_vph']\nDuplicate keys: 0\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nfrom pathlib import Path\n\npanel_name = \"D12_I405_N\"\npanel_root = ROOT / \"corridors\" / panel_name\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ndef load_observed_split_i405n(split):\n    root = panel_root / split / \"mainline_states_masked\"\n    parts = []\n\n    for path in sorted(root.rglob(\"*.parquet\")):\n        df = pd.read_parquet(path)\n        df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n        df = df.loc[\n            df[\"is_observed\"] == 1,\n            KEYS + [\"speed_kmh\", \"flow_vph\"]\n        ].copy()\n        df = df.rename(columns={\n            \"speed_kmh\": \"obs_speed\",\n            \"flow_vph\": \"obs_flow\",\n        })\n        parts.append(df)\n\n    if not parts:\n        return pd.DataFrame(columns=KEYS + [\"obs_speed\", \"obs_flow\"])\n\n    return pd.concat(parts, ignore_index=True).drop_duplicates(KEYS)\n\ndef make_features_i405n(template, observed_history):\n    df = template[[\"panel\"] + KEYS + [\"mask_regime\"]].copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"weekday\"] = df[\"timestamp\"].dt.dayofweek\n    df[\"minute_of_day\"] = (\n        df[\"timestamp\"].dt.hour * 60 + df[\"timestamp\"].dt.minute\n    )\n\n    df = df.merge(\n        profile_i405n,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    df = df.merge(\n        link_profile_i405n,\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n    df[\"base_speed\"] = df[\"base_speed\"].fillna(df[\"link_base_speed\"])\n    df[\"base_flow\"] = df[\"base_flow\"].fillna(df[\"link_base_flow\"])\n    df.drop(columns=[\"link_base_speed\", \"link_base_flow\"], inplace=True)\n\n    history = observed_history.copy()\n    history[\"timestamp\"] = pd.to_datetime(history[\"timestamp\"], utc=True)\n\n    for lag in [5, 15, 60, 1440]:\n        source = history[KEYS + [\"obs_speed\", \"obs_flow\"]].copy()\n        source[\"timestamp\"] += pd.Timedelta(minutes=lag)\n        source = source.rename(columns={\n            \"obs_speed\": f\"lag_speed_{lag}\",\n            \"obs_flow\": f\"lag_flow_{lag}\",\n        })\n        df = df.merge(\n            source, on=KEYS, how=\"left\", validate=\"one_to_one\"\n        )\n\n    df[\"tod_sin\"] = np.sin(2 * np.pi * df[\"minute_of_day\"] / 1440)\n    df[\"tod_cos\"] = np.cos(2 * np.pi * df[\"minute_of_day\"] / 1440)\n    df[\"weekday_sin\"] = np.sin(2 * np.pi * df[\"weekday\"] / 7)\n    df[\"weekday_cos\"] = np.cos(2 * np.pi * df[\"weekday\"] / 7)\n\n    df[\"station_id_code\"] = (\n        df[\"station_id\"].astype(str)\n        .map(category_maps_i405n[\"station_id\"]).fillna(-1).astype(int)\n    )\n    df[\"link_id_code\"] = (\n        df[\"link_id\"].astype(str)\n        .map(category_maps_i405n[\"link_id\"]).fillna(-1).astype(int)\n    )\n    df[\"mask_regime_code\"] = (\n        df[\"mask_regime\"]\n        .map(category_maps_i405n[\"mask_regime\"]).fillna(-1).astype(int)\n    )\n\n    assert df[[\"base_speed\", \"base_flow\"]].notna().all().all()\n    return df\n\n# January-February observed history, already rebuilt earlier.\nhistory_janfeb_i405n = observed_i405n[\n    KEYS + [\"obs_speed\", \"obs_flow\"]\n].copy()\n\ndef predict_split_i405n(split, observed_history):\n    template_path = (\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n    template = pd.read_csv(template_path)\n\n    features = make_features_i405n(template, observed_history)\n    X = features[FEATURES_I405N]\n\n    speed = np.clip(\n        features[\"base_speed\"].to_numpy()\n        + speed_model_i405n_final.predict(X),\n        0, 160,\n    )\n    flow = np.clip(\n        features[\"base_flow\"].to_numpy()\n        + flow_model_i405n_final.predict(X),\n        0, None,\n    )\n\n    out = template.copy()\n    out[\"speed_kmh\"] = speed\n    out[\"flow_vph\"] = flow\n\n    template_keys = template[KEYS].copy()\n    pred_keys = out[KEYS].copy()\n    template_keys[\"timestamp\"] = pd.to_datetime(\n        template_keys[\"timestamp\"], utc=True\n    )\n    pred_keys[\"timestamp\"] = pd.to_datetime(\n        pred_keys[\"timestamp\"], utc=True\n    )\n\n    assert len(out) == len(template)\n    assert not pred_keys.duplicated().any()\n    assert set(map(tuple, template_keys.to_numpy())) == set(\n        map(tuple, pred_keys.to_numpy())\n    )\n    assert out[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n    assert np.isfinite(out[[\"speed_kmh\", \"flow_vph\"]].to_numpy()).all()\n\n    out[\"split\"] = split\n    filename = (\n        f\"{panel_name}_{'march' if split == 'validation' else 'april'}\"\n        \"_predictions_verified.csv\"\n    )\n    output_path = Path(\"/kaggle/working\") / filename\n    out.to_csv(output_path, index=False)\n\n    print(\n        f\"{split}: {len(out):,} rows | \"\n        f\"speed [{out['speed_kmh'].min():.2f}, {out['speed_kmh'].max():.2f}] | \"\n        f\"flow [{out['flow_vph'].min():.2f}, {out['flow_vph'].max():.2f}]\"\n    )\n    print(\"Saved:\", output_path)\n    return out\n\nmarch_pred_i405n = predict_split_i405n(\n    \"validation\", history_janfeb_i405n\n)\n\n# For April, also include observed March values, not hidden March targets.\nobserved_march_i405n = load_observed_split_i405n(\"validation\")\nhistory_april_i405n = pd.concat(\n    [history_janfeb_i405n, observed_march_i405n],\n    ignore_index=True,\n).drop_duplicates(KEYS, keep=\"last\")\n\napril_pred_i405n = predict_split_i405n(\n    \"private\", history_april_i405n\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:18:30.888709Z","iopub.execute_input":"2026-10-21T17:18:30.889578Z","iopub.status.idle":"2026-10-21T17:18:57.077703Z","shell.execute_reply.started":"2026-10-21T17:18:30.889536Z","shell.execute_reply":"2026-10-21T17:18:57.076699Z"}},"outputs":[{"name":"stdout","text":"validation: 203,337 rows | speed [5.90, 129.37] | flow [321.96, 7522.49]\nSaved: /kaggle/working/D12_I405_N_march_predictions_verified.csv\nprivate: 192,164 rows | speed [8.73, 126.80] | flow [296.07, 7580.51]\nSaved: /kaggle/working/D12_I405_N_april_predictions_verified.csv\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"import json\nimport shutil\nimport zipfile\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\n\nWORK = Path(\"/kaggle/working\")\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nPRED_DIR = LOCAL_RESUME_DIR / \"predictions\"\nARTIFACT_DIR = LOCAL_RESUME_DIR / \"artifacts\"\n\nPRED_DIR.mkdir(parents=True, exist_ok=True)\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n\npanel_name = \"D12_I405_N\"\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\nmarch_path = WORK / \"D12_I405_N_march_predictions_verified.csv\"\napril_path = WORK / \"D12_I405_N_april_predictions_verified.csv\"\n\nmarch = pd.read_csv(march_path)\napril = pd.read_csv(april_path)\n\n# Verify each split against its official template.\nfor split, pred in [(\"validation\", march), (\"private\", april)]:\n    template = pd.read_csv(\n        ROOT / \"task1\" / panel_name / split / \"sample_submission_state.csv\"\n    )\n\n    assert len(pred) == len(template), f\"{split}: row-count mismatch\"\n\n    pk = pred[KEYS].copy()\n    tk = template[KEYS].copy()\n    pk[\"timestamp\"] = pd.to_datetime(pk[\"timestamp\"], utc=True)\n    tk[\"timestamp\"] = pd.to_datetime(tk[\"timestamp\"], utc=True)\n\n    assert not pk.duplicated().any(), f\"{split}: duplicate prediction keys\"\n    assert not tk.duplicated().any(), f\"{split}: duplicate template keys\"\n    assert set(map(tuple, pk.to_numpy())) == set(map(tuple, tk.to_numpy()))\n    assert pred[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n    assert np.isfinite(pred[[\"speed_kmh\", \"flow_vph\"]].to_numpy()).all()\n\n    pred[\"split\"] = split\n\ncombined = pd.concat([march, april], ignore_index=True)\nassert len(combined) == 395501\nassert combined[\"split\"].value_counts().to_dict() == {\n    \"validation\": 203337,\n    \"private\": 192164,\n}\n\ncombined_path = PRED_DIR / \"D12_I405_N_predictions_checkpoint.csv\"\ncombined.to_csv(combined_path, index=False)\n\n# Preserve prior checkpoints from the mounted resume dataset.\nsource_pred_dir = RESUME_DIR / \"predictions\"\nfor filename in [\n    \"D12_I405_S_predictions_checkpoint.csv\",\n    \"D12_I5_N_predictions_checkpoint.csv\",\n    \"D12_I5_S_predictions_checkpoint.csv\",\n    \"task1_predictions_checkpoint.csv\",\n]:\n    src = source_pred_dir / filename\n    if src.exists():\n        shutil.copy2(src, PRED_DIR / filename)\n\n# Preserve prior artifacts, then retain the new final model.\nfor src in (RESUME_DIR / \"artifacts\").glob(\"*\"):\n    if src.is_file():\n        shutil.copy2(src, ARTIFACT_DIR / src.name)\n\nnew_model = WORK / \"trafficflow_resume\" / \"artifacts\" / \"D12_I405_N_final.joblib\"\nassert new_model.exists(), \"D12_I405_N final model artifact missing\"\n\n# Update writable manifest.\nmanifest_path = LOCAL_RESUME_DIR / \"manifest.json\"\nif manifest_path.exists():\n    manifest = json.loads(manifest_path.read_text())\nelse:\n    manifest = json.loads((RESUME_DIR / \"manifest.json\").read_text())\n\ncompleted = set(manifest.get(\"completed_panels\", []))\ncompleted.update([\n    \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I405_S\", \"D12_I405_N\",\n])\n\nmanifest.update({\n    \"completed_panels\": sorted(completed),\n    \"completed_panels_count\": len(completed),\n    \"current_panel\": \"D12_I405_N\",\n    \"current_panel_status\": \"PREDICTIONS_CHECKPOINTED\",\n    \"final_submission_created\": False,\n    \"next_action\": (\n        \"Proceed to the next uncompleted panel. Verify February labels, \"\n        \"build observed-only lag features and January baseline, evaluate a \"\n        \"chronological holdout, train final models, generate March/April \"\n        \"predictions, and checkpoint.\"\n    ),\n})\nmanifest_path.write_text(json.dumps(manifest, indent=2))\n\n# Rebuild and verify portable resume ZIP.\nzip_path = WORK / \"trafficflow_resume_package.zip\"\nwith zipfile.ZipFile(\n    zip_path, \"w\", compression=zipfile.ZIP_DEFLATED\n) as zf:\n    for path in LOCAL_RESUME_DIR.rglob(\"*\"):\n        if path.is_file():\n            zf.write(path, path.relative_to(WORK))\n\nwith zipfile.ZipFile(zip_path, \"r\") as zf:\n    assert zf.testzip() is None\n\nprint(\"D12_I405_N checkpoint saved and verified.\")\nprint(\"March rows:\", len(march))\nprint(\"April rows:\", len(april))\nprint(\"Combined rows:\", len(combined))\nprint(\"Completed panels:\", sorted(completed))\nprint(\"Panel count:\", len(completed), \"/ 10\")\nprint(\"Resume ZIP:\", zip_path)\nprint(\"ZIP size (MiB):\", round(zip_path.stat().st_size / (1024**2), 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:26:05.97452Z","iopub.execute_input":"2026-10-21T17:26:05.975159Z","iopub.status.idle":"2026-10-21T17:26:26.059527Z","shell.execute_reply.started":"2026-10-21T17:26:05.975071Z","shell.execute_reply":"2026-10-21T17:26:26.058462Z"}},"outputs":[{"name":"stdout","text":"D12_I405_N checkpoint saved and verified.\nMarch rows: 203337\nApril rows: 192164\nCombined rows: 395501\nCompleted panels: ['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I405_S']\nPanel count: 5 / 10\nResume ZIP: /kaggle/working/trafficflow_resume_package.zip\nZIP size (MiB): 68.94\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"from pathlib import Path\nimport pandas as pd\n\npanel_name = \"D7_I10_E\"\npanel_root = ROOT / \"corridors\" / panel_name\n\nprint(\"Panel directory exists:\", panel_root.exists())\n\nfor rel in [\n    \"train/mainline_states\",\n    \"train/mainline_states_masked\",\n    \"validation/mainline_states_masked\",\n    \"private/mainline_states_masked\",\n    \"network/links.csv\",\n]:\n    path = panel_root / rel\n    print(f\"{rel}: {path.exists()}\")\n\ntruth_files = sorted(\n    (panel_root / \"train\" / \"mainline_states\")\n    .glob(\"year_month=2031-02/*.parquet\")\n)\nmasked_files = sorted(\n    p for p in (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\nprint(\"\\nFebruary truth files:\", len(truth_files))\nprint(\"February masked files:\", len(masked_files))\n\nif truth_files:\n    sample = pd.read_parquet(truth_files[0])\n    print(\"Truth columns:\", sample.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:29:26.227935Z","iopub.execute_input":"2026-10-21T17:29:26.228881Z","iopub.status.idle":"2026-10-21T17:29:26.450025Z","shell.execute_reply.started":"2026-10-21T17:29:26.22883Z","shell.execute_reply":"2026-10-21T17:29:26.448981Z"}},"outputs":[{"name":"stdout","text":"Panel directory exists: True\ntrain/mainline_states: True\ntrain/mainline_states_masked: True\nvalidation/mainline_states_masked: True\nprivate/mainline_states_masked: True\nnetwork/links.csv: True\n\nFebruary truth files: 28\nFebruary masked files: 28\nTruth columns: ['corridor_id', 'date', 'timestamp', 'station_id', 'link_id', 'milepost', 'direction', 'speed_kmh', 'flow_vph', 'occupancy', 'density_occ_linear_vehpkm', 'pct_observed', 'is_observed', 'is_imputed', 'is_score_eligible', 'is_missing']\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"import pandas as pd\n\npanel_name = \"D7_I10_E\"\npanel_root = ROOT / \"corridors\" / panel_name\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\n\ntruth_files = sorted(\n    (panel_root / \"train\" / \"mainline_states\")\n    .glob(\"year_month=2031-02/*.parquet\")\n)\nmasked_files = sorted(\n    p for p in (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    if \"2031_02_\" in p.name\n)\n\ntruth = pd.concat(\n    [pd.read_parquet(p) for p in truth_files],\n    ignore_index=True\n)\nmasked = pd.concat(\n    [pd.read_parquet(p) for p in masked_files],\n    ignore_index=True\n)\n\ntruth[\"timestamp\"] = pd.to_datetime(truth[\"timestamp\"], utc=True)\nmasked[\"timestamp\"] = pd.to_datetime(masked[\"timestamp\"], utc=True)\n\ntraining_i10e = truth.loc[\n    (truth[\"is_score_eligible\"] == 1)\n    & (truth[\"timestamp\"] >= \"2031-02-01\")\n    & (truth[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"speed_kmh\", \"flow_vph\"]\n].copy()\n\nregimes_i10e = masked.loc[\n    (masked[\"timestamp\"] >= \"2031-02-01\")\n    & (masked[\"timestamp\"] < \"2031-03-01\"),\n    KEYS + [\"mask_regime\"]\n].copy()\n\nassert not training_i10e.duplicated(KEYS).any()\nassert not regimes_i10e.duplicated(KEYS).any()\n\ntraining_i10e = training_i10e.merge(\n    regimes_i10e,\n    on=KEYS,\n    how=\"left\",\n    validate=\"one_to_one\"\n)\n\nassert training_i10e[\"mask_regime\"].notna().all()\nassert training_i10e[[\"speed_kmh\", \"flow_vph\"]].notna().all().all()\n\nprint(\"Eligible February labels:\", len(training_i10e))\nprint(\"\\nRegime counts:\")\nprint(training_i10e[\"mask_regime\"].value_counts().sort_index())\nprint(\"\\nDuplicate keys:\", training_i10e.duplicated(KEYS).sum())\nprint(\"Missing regimes:\", training_i10e[\"mask_regime\"].isna().sum())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:32:53.864143Z","iopub.execute_input":"2026-10-21T17:32:53.86535Z","iopub.status.idle":"2026-10-21T17:33:00.180292Z","shell.execute_reply.started":"2026-10-21T17:32:53.865301Z","shell.execute_reply":"2026-10-21T17:33:00.179203Z"}},"outputs":[{"name":"stdout","text":"Eligible February labels: 899458\n\nRegime counts:\nmask_regime\nR1    224529\nR2    289446\nR3    385483\nName: count, dtype: int64\n\nDuplicate keys: 0\nMissing regimes: 0\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"\n# ================================================================\n# IEEE TRAFFIC FLOW BENCH — TASK 1 AUTOMATED PIPELINE\n# Resume existing checkpoints, process remaining panels,\n# validate official templates, and build submission.csv\n# ================================================================\n\nimport json\nimport shutil\nimport zipfile\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport joblib\n\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.metrics import mean_squared_error\n\nwarnings.filterwarnings(\"ignore\")\n\n# --------------------------- PATHS -------------------------------\n\nROOT = Path(\n    \"/kaggle/input/competitions/2026-ieee-big-data-traffic-flow-bench/kaggle_public\"\n)\nWORK = Path(\"/kaggle/working\")\n\nRESUME_INPUT = (\n    Path(\"/kaggle/input/datasets/krupaalhn/trafficflow-resume-package\")\n    / \"trafficflow_resume\"\n)\n\nLOCAL_RESUME_DIR = WORK / \"trafficflow_resume\"\nPRED_DIR = LOCAL_RESUME_DIR / \"predictions\"\nARTIFACT_DIR = LOCAL_RESUME_DIR / \"artifacts\"\nZIP_PATH = WORK / \"trafficflow_resume_package.zip\"\nMANIFEST_PATH = LOCAL_RESUME_DIR / \"manifest.json\"\n\nfor d in (LOCAL_RESUME_DIR, PRED_DIR, ARTIFACT_DIR):\n    d.mkdir(parents=True, exist_ok=True)\n\nPANELS = [\n    \"D12_I405_N\", \"D12_I405_S\", \"D12_I5_N\", \"D12_I5_S\",\n    \"D7_I10_E\", \"D7_I10_W\", \"D7_I210_E\", \"D7_I210_W\",\n    \"D7_I405_N\", \"D7_I405_S\",\n]\n\n# These five panels were verified before the current run.\nPREVIOUSLY_COMPLETED = {\n    \"D12_I405_N\", \"D12_I405_S\", \"D12_I5_N\",\n    \"D12_I5_S\", \"D7_I405_S\",\n}\n\nKEYS = [\"timestamp\", \"station_id\", \"link_id\"]\nTARGETS = [\"speed_kmh\", \"flow_vph\"]\n\nFEATURES = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\",\n    \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\nMODEL_PARAMS = dict(\n    learning_rate=0.06,\n    max_iter=150,\n    max_leaf_nodes=31,\n    l2_regularization=5.0,\n    early_stopping=True,\n    validation_fraction=0.1,\n    n_iter_no_change=15,\n    random_state=42,\n)\n\ndef checkpoint_path(panel):\n    name = (\n        \"task1_predictions_checkpoint.csv\"\n        if panel == \"D7_I405_S\"\n        else f\"{panel}_predictions_checkpoint.csv\"\n    )\n    return PRED_DIR / name\n\ndef find_source_checkpoint(panel):\n    name = checkpoint_path(panel).name\n    for p in (\n        RESUME_INPUT / \"predictions\" / name,\n        RESUME_INPUT / name,\n    ):\n        if p.exists():\n            return p\n    return None\n\n# Recover old checkpoints only when the local copy is absent.\nfor panel in PREVIOUSLY_COMPLETED:\n    dst = checkpoint_path(panel)\n    src = find_source_checkpoint(panel)\n    if not dst.exists() and src is not None:\n        shutil.copy2(src, dst)\n        print(\"Recovered:\", panel)\n\nif MANIFEST_PATH.exists():\n    with open(MANIFEST_PATH, \"r\") as f:\n        manifest = json.load(f)\nelse:\n    manifest = {\"completed_panels\": [], \"metrics\": {}}\n\nmanifest.setdefault(\"completed_panels\", [])\nmanifest.setdefault(\"metrics\", {})\n\n# Only skip a previous panel if its checkpoint is present.\ncompleted = {\n    p for p in PREVIOUSLY_COMPLETED if checkpoint_path(p).exists()\n}\nprint(\"Existing checkpointed panels:\", sorted(completed))\nprint(\"Panels to process:\", [p for p in PANELS if p not in completed])\n\n# --------------------------- HELPERS ----------------------------\n\ndef read_parquets(paths):\n    paths = list(paths)\n    if not paths:\n        raise FileNotFoundError(\"No parquet files found.\")\n    return pd.concat([pd.read_parquet(p) for p in paths], ignore_index=True)\n\ndef normalize_keys(df):\n    df = df.copy()\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df[\"station_id\"] = df[\"station_id\"].astype(str)\n    df[\"link_id\"] = df[\"link_id\"].astype(str)\n    return df\n\ndef add_calendar(df):\n    df = df.copy()\n    df[\"weekday\"] = df[\"timestamp\"].dt.dayofweek.astype(\"int16\")\n    df[\"minute_of_day\"] = (\n        df[\"timestamp\"].dt.hour * 60 + df[\"timestamp\"].dt.minute\n    ).astype(\"int16\")\n    m = df[\"minute_of_day\"].astype(float)\n    w = df[\"weekday\"].astype(float)\n    df[\"tod_sin\"] = np.sin(2 * np.pi * m / 1440)\n    df[\"tod_cos\"] = np.cos(2 * np.pi * m / 1440)\n    df[\"weekday_sin\"] = np.sin(2 * np.pi * w / 7)\n    df[\"weekday_cos\"] = np.cos(2 * np.pi * w / 7)\n    return df\n\ndef observed_history(masked, start, end):\n    masked = normalize_keys(masked)\n    mask = (\n        (masked[\"timestamp\"] >= pd.Timestamp(start, tz=\"UTC\"))\n        & (masked[\"timestamp\"] < pd.Timestamp(end, tz=\"UTC\"))\n        & (masked[\"is_observed\"] == 1)\n        & masked[\"speed_kmh\"].notna()\n        & masked[\"flow_vph\"].notna()\n    )\n    out = masked.loc[mask, KEYS + TARGETS].copy()\n    if out.duplicated(KEYS).any():\n        out = out.drop_duplicates(KEYS, keep=\"last\")\n    return out\n\ndef add_lags(frame, history):\n    out = frame.copy()\n    for lag in (5, 15, 60, 1440):\n        src = history[KEYS + TARGETS].copy()\n        src[\"timestamp\"] += pd.Timedelta(minutes=lag)\n        src = src.rename(columns={\n            \"speed_kmh\": f\"lag_speed_{lag}\",\n            \"flow_vph\": f\"lag_flow_{lag}\",\n        })\n        out = out.merge(\n            src, on=KEYS, how=\"left\", validate=\"many_to_one\"\n        )\n    return out\n\ndef build_features(\n    frame, history, baseline, link_profile,\n    station_map, link_map, regime_map\n):\n    frame = normalize_keys(frame)\n    frame = add_calendar(frame)\n\n    frame = frame.merge(\n        baseline,\n        on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    frame = frame.merge(\n        link_profile.rename(columns={\n            \"base_speed\": \"fallback_speed\",\n            \"base_flow\": \"fallback_flow\",\n        }),\n        on=\"link_id\",\n        how=\"left\",\n        validate=\"many_to_one\",\n    )\n\n    frame[\"base_speed\"] = frame[\"base_speed\"].fillna(\n        frame[\"fallback_speed\"]\n    ).fillna(60.0)\n    frame[\"base_flow\"] = frame[\"base_flow\"].fillna(\n        frame[\"fallback_flow\"]\n    ).fillna(1000.0)\n    frame = frame.drop(columns=[\"fallback_speed\", \"fallback_flow\"])\n\n    frame = add_lags(frame, history)\n\n    for lag in (5, 15, 60, 1440):\n        frame[f\"lag_speed_{lag}\"] = frame[f\"lag_speed_{lag}\"].fillna(\n            frame[\"base_speed\"]\n        )\n        frame[f\"lag_flow_{lag}\"] = frame[f\"lag_flow_{lag}\"].fillna(\n            frame[\"base_flow\"]\n        )\n\n    frame[\"station_id_code\"] = (\n        frame[\"station_id\"].map(station_map).fillna(-1)\n    )\n    frame[\"link_id_code\"] = frame[\"link_id\"].map(link_map).fillna(-1)\n    frame[\"mask_regime_code\"] = (\n        frame[\"mask_regime\"].map(regime_map).fillna(-1)\n    )\n\n    for col in FEATURES:\n        frame[col] = pd.to_numeric(frame[col], errors=\"coerce\")\n        frame[col] = frame[col].replace([np.inf, -np.inf], np.nan)\n    frame[FEATURES] = frame[FEATURES].fillna(0.0)\n    return frame\n\ndef load_template(panel, split):\n    p = ROOT / \"task1\" / panel / split / \"sample_submission_state.csv\"\n    if not p.exists():\n        raise FileNotFoundError(f\"Missing template: {p}\")\n    return normalize_keys(pd.read_csv(p))\n\ndef verify_predictions(template, pred, panel, split):\n    if template.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}/{split}: duplicate template keys\")\n    if pred.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}/{split}: duplicate prediction keys\")\n\n    expected = pd.MultiIndex.from_frame(template[KEYS])\n    actual = pd.MultiIndex.from_frame(pred[KEYS])\n    missing = expected.difference(actual)\n    extra = actual.difference(expected)\n\n    if len(missing) or len(extra) or len(expected) != len(actual):\n        raise ValueError(\n            f\"{panel}/{split}: key mismatch \"\n            f\"(missing={len(missing)}, extra={len(extra)})\"\n        )\n\n    vals = pred[TARGETS].to_numpy(dtype=float)\n    if not np.isfinite(vals).all():\n        raise ValueError(f\"{panel}/{split}: non-finite predictions\")\n\ndef refresh_zip():\n    with zipfile.ZipFile(ZIP_PATH, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for p in LOCAL_RESUME_DIR.rglob(\"*\"):\n            if p.is_file():\n                zf.write(p, arcname=str(p.relative_to(WORK)))\n    with zipfile.ZipFile(ZIP_PATH, \"r\") as zf:\n        bad = zf.testzip()\n        if bad is not None:\n            raise IOError(f\"Resume ZIP corrupt: {bad}\")\n    print(f\"Resume ZIP refreshed ({ZIP_PATH.stat().st_size / 1024**2:.1f} MiB)\")\n\n# ----------------------- PROCESS ONE PANEL ----------------------\n\ndef process_panel(panel):\n    print(\"\\n\" + \"=\" * 65)\n    print(\"PROCESSING:\", panel)\n    print(\"=\" * 65)\n\n    panel_root = ROOT / \"corridors\" / panel\n\n    truth_files = sorted(\n        (panel_root / \"train\" / \"mainline_states\")\n        .glob(\"year_month=2031-02/*.parquet\")\n    )\n    truth = normalize_keys(read_parquets(truth_files))\n    truth = truth[\n        (truth[\"timestamp\"] >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (truth[\"timestamp\"] < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n        & (truth[\"is_score_eligible\"] == 1)\n    ][KEYS + TARGETS].copy()\n\n    masked_files = sorted(\n        (panel_root / \"train\" / \"mainline_states_masked\").rglob(\"*.parquet\")\n    )\n    masked_all = normalize_keys(read_parquets(masked_files))\n    feb_mask = masked_all[\n        (masked_all[\"timestamp\"] >= pd.Timestamp(\"2031-02-01\", tz=\"UTC\"))\n        & (masked_all[\"timestamp\"] < pd.Timestamp(\"2031-03-01\", tz=\"UTC\"))\n    ][KEYS + [\"mask_regime\"]].copy()\n\n    if feb_mask.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate regime keys\")\n\n    train = truth.merge(\n        feb_mask, on=KEYS, how=\"left\", validate=\"one_to_one\"\n    )\n    if train[\"mask_regime\"].isna().any():\n        raise ValueError(f\"{panel}: missing training regimes\")\n    if train[TARGETS].isna().any().any():\n        raise ValueError(f\"{panel}: missing training targets\")\n    if train.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate training keys\")\n\n    print(\"Eligible February labels:\", len(train))\n    print(\"Regime counts:\", train[\"mask_regime\"].value_counts().to_dict())\n\n    jan_files = sorted(\n        (panel_root / \"train\" / \"mainline_states\")\n        .glob(\"year_month=2031-01/*.parquet\")\n    )\n    jan = normalize_keys(read_parquets(jan_files))\n    jan = jan[\n        (jan[\"is_observed\"] == 1)\n        & jan[\"speed_kmh\"].notna()\n        & jan[\"flow_vph\"].notna()\n    ].copy()\n    jan = add_calendar(jan)\n\n    baseline = (\n        jan.groupby([\"link_id\", \"weekday\", \"minute_of_day\"], observed=True)\n        .agg(base_speed=(\"speed_kmh\", \"median\"),\n             base_flow=(\"flow_vph\", \"median\"))\n        .reset_index()\n    )\n    link_profile = (\n        jan.groupby(\"link_id\", observed=True)\n        .agg(base_speed=(\"speed_kmh\", \"median\"),\n             base_flow=(\"flow_vph\", \"median\"))\n        .reset_index()\n    )\n\n    history = observed_history(masked_all, \"2031-01-01\", \"2031-03-01\")\n\n    links = pd.read_csv(panel_root / \"network\" / \"links.csv\")\n    links[\"link_id\"] = links[\"link_id\"].astype(str)\n    if \"lanes\" not in links.columns:\n        raise ValueError(f\"{panel}: lanes missing from links.csv\")\n\n    train[\"lanes\"] = train[\"link_id\"].map(links.set_index(\"link_id\")[\"lanes\"])\n    if train[\"lanes\"].isna().any() or (train[\"lanes\"] <= 0).any():\n        raise ValueError(f\"{panel}: invalid lane counts\")\n\n    station_map = {\n        v: i for i, v in enumerate(sorted(train[\"station_id\"].unique()))\n    }\n    link_map = {\n        v: i for i, v in enumerate(sorted(train[\"link_id\"].unique()))\n    }\n    regime_map = {\"R1\": 0, \"R2\": 1, \"R3\": 2}\n\n    train_feat = build_features(\n        train, history, baseline, link_profile,\n        station_map, link_map, regime_map\n    )\n\n    timestamps = np.sort(train_feat[\"timestamp\"].unique())\n    cutoff = timestamps[int(len(timestamps) * 0.80)]\n    tr_idx = train_feat[\"timestamp\"] < cutoff\n    va_idx = ~tr_idx\n    if not tr_idx.any() or not va_idx.any():\n        raise ValueError(f\"{panel}: invalid holdout split\")\n\n    metrics = {}\n    for target, base_col in (\n        (\"speed_kmh\", \"base_speed\"),\n        (\"flow_vph\", \"base_flow\"),\n    ):\n        model = HistGradientBoostingRegressor(**MODEL_PARAMS)\n        model.fit(\n            train_feat.loc[tr_idx, FEATURES],\n            train_feat.loc[tr_idx, target].to_numpy()\n            - train_feat.loc[tr_idx, base_col].to_numpy(),\n        )\n        pred = (\n            train_feat.loc[va_idx, base_col].to_numpy()\n            + model.predict(train_feat.loc[va_idx, FEATURES])\n        )\n\n        if target == \"speed_kmh\":\n            pred = np.clip(pred, 0, 160)\n            metrics[\"speed_rmse\"] = float(np.sqrt(mean_squared_error(\n                train_feat.loc[va_idx, target], pred\n            )))\n        else:\n            pred = np.clip(pred, 0, None)\n            lanes = train_feat.loc[va_idx, \"lanes\"].to_numpy()\n            y = train_feat.loc[va_idx, target].to_numpy()\n            metrics[\"flow_rmse_per_lane\"] = float(\n                np.sqrt(np.mean(((y - pred) / lanes) ** 2))\n            )\n\n    metrics[\"S_speed\"] = max(0.0, 1.0 - metrics[\"speed_rmse\"] / 25)\n    metrics[\"S_flow\"] = max(\n        0.0, 1.0 - metrics[\"flow_rmse_per_lane\"] / 600\n    )\n    metrics[\"S_state\"] = (\n        0.54 * metrics[\"S_speed\"] + 0.46 * metrics[\"S_flow\"]\n    )\n    print(\"Chronological holdout metrics:\", metrics)\n\n    # Fit final residual models on all eligible February labels.\n    final_models = {}\n    for target, base_col in (\n        (\"speed_kmh\", \"base_speed\"),\n        (\"flow_vph\", \"base_flow\"),\n    ):\n        model = HistGradientBoostingRegressor(**MODEL_PARAMS)\n        model.fit(\n            train_feat[FEATURES],\n            train_feat[target].to_numpy() - train_feat[base_col].to_numpy(),\n        )\n        final_models[target] = model\n\n    artifact = {\n        \"speed_model\": final_models[\"speed_kmh\"],\n        \"flow_model\": final_models[\"flow_vph\"],\n        \"features\": FEATURES,\n        \"category_maps\": {\n            \"station\": station_map,\n            \"link\": link_map,\n            \"regime\": regime_map,\n        },\n        \"model_params\": MODEL_PARAMS,\n        \"baseline_profile\": baseline,\n        \"link_profile\": link_profile,\n        \"metrics\": metrics,\n    }\n    joblib.dump(artifact, ARTIFACT_DIR / f\"{panel}_final.joblib\")\n\n    # March observed measurements are used as lag history for April only.\n    val_dir = panel_root / \"validation\" / \"mainline_states_masked\"\n    val_files = sorted(val_dir.rglob(\"*.parquet\"))\n    val_masked = normalize_keys(read_parquets(val_files))\n    march_history = observed_history(\n        val_masked, \"2031-03-01\", \"2031-04-01\"\n    )\n\n    split_preds = {}\n\n    for split in (\"validation\", \"private\"):\n        template = load_template(panel, split)\n\n        split_files = sorted(\n            (panel_root / split / \"mainline_states_masked\").rglob(\"*.parquet\")\n        )\n        split_mask = normalize_keys(read_parquets(split_files))\n        regime_cols = split_mask[KEYS + [\"mask_regime\"]].drop_duplicates(KEYS)\n\n        if regime_cols.duplicated(KEYS).any():\n            raise ValueError(f\"{panel}/{split}: duplicate regime keys\")\n\n        # FIX: drop any pre-existing regime column before merging.\n        target_frame = template.drop(\n            columns=[\"mask_regime\"], errors=\"ignore\"\n        ).merge(\n            regime_cols,\n            on=KEYS,\n            how=\"left\",\n            validate=\"one_to_one\",\n        )\n\n        if \"mask_regime\" not in target_frame.columns:\n            raise ValueError(f\"{panel}/{split}: regime column missing\")\n        if target_frame[\"mask_regime\"].isna().any():\n            raise ValueError(f\"{panel}/{split}: missing target regimes\")\n\n        inference_history = history\n        if split == \"private\":\n            inference_history = pd.concat(\n                [history, march_history], ignore_index=True\n            ).drop_duplicates(KEYS, keep=\"last\")\n\n        feat = build_features(\n            target_frame, inference_history, baseline, link_profile,\n            station_map, link_map, regime_map\n        )\n\n        speed = (\n            feat[\"base_speed\"].to_numpy()\n            + final_models[\"speed_kmh\"].predict(feat[FEATURES])\n        )\n        flow = (\n            feat[\"base_flow\"].to_numpy()\n            + final_models[\"flow_vph\"].predict(feat[FEATURES])\n        )\n\n        pred = template[KEYS].copy()\n        pred[\"speed_kmh\"] = np.clip(speed, 0, 160)\n        pred[\"flow_vph\"] = np.clip(flow, 0, None)\n\n        verify_predictions(template, pred, panel, split)\n\n        pred.to_csv(\n            WORK / f\"{panel}_{split}_predictions_verified.csv\",\n            index=False,\n        )\n        split_preds[split] = pred\n\n        print(\n            f\"{split}: {len(pred):,} rows verified | \"\n            f\"speed {pred.speed_kmh.min():.2f}–{pred.speed_kmh.max():.2f} | \"\n            f\"flow {pred.flow_vph.min():.2f}–{pred.flow_vph.max():.2f}\"\n        )\n\n    combined = pd.concat(\n        [split_preds[\"validation\"], split_preds[\"private\"]],\n        ignore_index=True,\n    )\n    if combined.duplicated(KEYS).any():\n        raise ValueError(f\"{panel}: duplicate keys across splits\")\n\n    combined.to_csv(checkpoint_path(panel), index=False)\n\n    # Verify saved checkpoint before marking the panel complete.\n    saved = pd.read_csv(checkpoint_path(panel))\n    if len(saved) != len(combined) or saved[TARGETS].isna().any().any():\n        raise ValueError(f\"{panel}: saved checkpoint failed verification\")\n\n    manifest[\"metrics\"][panel] = metrics\n    manifest[\"completed_panels\"] = sorted(\n        set(manifest[\"completed_panels\"]) | {panel}\n    )\n    manifest[\"current_panel\"] = panel\n    manifest[\"status\"] = \"PREDICTIONS_CHECKPOINTED\"\n    manifest[\"final_submission_created\"] = False\n    with open(MANIFEST_PATH, \"w\") as f:\n        json.dump(manifest, f, indent=2)\n\n    refresh_zip()\n    print(\"CHECKPOINT SAVED:\", panel, f\"{len(combined):,} rows\")\n\n# ---------------------- PROCESS REMAINING -----------------------\n\nfor panel in PANELS:\n    if panel in completed:\n        print(\"\\nSkipping existing verified checkpoint:\", panel)\n        continue\n\n    try:\n        process_panel(panel)\n    except Exception as e:\n        manifest[\"status\"] = \"PAUSED_ERROR\"\n        manifest[\"current_panel\"] = panel\n        manifest[\"last_error\"] = repr(e)\n        with open(MANIFEST_PATH, \"w\") as f:\n            json.dump(manifest, f, indent=2)\n        refresh_zip()\n        raise RuntimeError(\n            f\"Stopped at {panel}. Earlier checkpoints are preserved. \"\n            \"Fix the error and rerun this cell.\"\n        ) from e\n\n# ---------------------- FINAL SUBMISSION -----------------------\n\nprint(\"\\nValidating all panel checkpoints...\")\npanel_frames = []\ntemplate_frames = []\n\nfor panel in PANELS:\n    cp = checkpoint_path(panel)\n    if not cp.exists():\n        raise FileNotFoundError(f\"Missing panel checkpoint: {panel}\")\n\n    p = normalize_keys(pd.read_csv(cp))\n    if p.duplicated(KEYS).any() or p[TARGETS].isna().any().any():\n        raise ValueError(f\"{panel}: invalid saved checkpoint\")\n\n    # Exact key coverage is rechecked against both official templates.\n    for split in (\"validation\", \"private\"):\n        template = load_template(panel, split)\n        part = p.merge(\n            template[KEYS].assign(_expected=True),\n            on=KEYS,\n            how=\"left\",\n            validate=\"one_to_one\",\n        )\n        if part[\"_expected\"].isna().any():\n            raise ValueError(f\"{panel}: unexpected keys in checkpoint\")\n\n    p[\"panel\"] = panel\n    panel_frames.append(p)\n\n    for split in (\"validation\", \"private\"):\n        t = load_template(panel, split)\n        t[\"panel\"] = panel\n        template_frames.append(t[KEYS + [\"panel\"]])\n\nall_preds = pd.concat(panel_frames, ignore_index=True)\nall_templates = pd.concat(template_frames, ignore_index=True)\n\nif all_preds.duplicated([\"panel\"] + KEYS).any():\n    raise ValueError(\"Duplicate panel-aware prediction keys\")\n\n# Confirm prediction coverage equals the full union of official templates.\npred_keys = pd.MultiIndex.from_frame(all_preds[[\"panel\"] + KEYS])\ntempl_keys = pd.MultiIndex.from_frame(all_templates[[\"panel\"] + KEYS])\nif len(pred_keys) != len(templ_keys) or set(pred_keys) != set(templ_keys):\n    raise ValueError(\n        f\"Panel template coverage mismatch: predictions={len(pred_keys)}, \"\n        f\"templates={len(templ_keys)}\"\n    )\n\nsample = pd.read_csv(ROOT / \"task1\" / \"sample_submission.csv\")\nsubmission_key = pd.read_csv(ROOT / \"task1\" / \"submission_key.csv\")\n\nrequired_cols = {\n    \"submission_id\", \"task\", \"speed_kmh\", \"flow_vph\",\n    \"queue_pred\", \"path_flow\",\n}\nif not required_cols.issubset(sample.columns):\n    raise ValueError(f\"Unexpected sample schema: {sample.columns.tolist()}\")\n\nif \"submission_id\" not in submission_key.columns:\n    raise ValueError(\"submission_key.csv lacks submission_id\")\n\nstate_keys = submission_key[\n    submission_key[\"task\"].astype(str).str.lower() == \"state\"\n].copy()\nif not set(KEYS).issubset(state_keys.columns):\n    raise ValueError(\n        \"Official submission_key lacks state keys. Columns: \"\n        + str(submission_key.columns.tolist())\n    )\n\nstate_keys = normalize_keys(state_keys)\n\n# Panel identity comes from the official panel templates.\nstate_keys = state_keys.merge(\n    all_templates,\n    on=KEYS,\n    how=\"left\",\n    validate=\"many_to_many\",\n)\n\nif state_keys[\"panel\"].isna().any():\n    raise ValueError(\n        \"Some official state submission keys do not map to a panel template.\"\n    )\n\n# Every official submission ID must resolve to exactly one prediction.\nstate_result = state_keys.merge(\n    all_preds,\n    on=[\"panel\"] + KEYS,\n    how=\"left\",\n    validate=\"many_to_one\",\n    suffixes=(\"\", \"_pred\"),\n)\n\nif state_result[\"submission_id\"].duplicated().any():\n    raise ValueError(\n        \"Submission IDs map to multiple panel templates. \"\n        \"Need inspect official submission_key schema before building final.\"\n    )\n\nif state_result[TARGETS].isna().any().any():\n    raise ValueError(\"Missing predictions for official state submission IDs\")\n\nif sample[\"submission_id\"].duplicated().any():\n    raise ValueError(\"Duplicate IDs in sample submission\")\n\nfinal = sample.merge(\n    state_result[[\"submission_id\"] + TARGETS],\n    on=\"submission_id\",\n    how=\"left\",\n    validate=\"one_to_one\",\n    suffixes=(\"\", \"_new\"),\n)\n\nstate_mask = final[\"task\"].astype(str).str.lower() == \"state\"\n\nfor col in TARGETS:\n    new_col = f\"{col}_new\"\n    if final.loc[state_mask, new_col].isna().any():\n        raise ValueError(f\"Missing state predictions in {col}\")\n    final.loc[state_mask, col] = final.loc[state_mask, new_col]\n\nfinal = final[sample.columns]\n\nif len(final) != len(sample):\n    raise ValueError(\"Final submission row count mismatch\")\nif final[\"submission_id\"].duplicated().any():\n    raise ValueError(\"Final submission contains duplicate IDs\")\nif final.loc[state_mask, TARGETS].isna().any().any():\n    raise ValueError(\"Final state rows contain missing values\")\n\nfinal_path = WORK / \"submission.csv\"\nfinal.to_csv(final_path, index=False)\n\nsaved_final = pd.read_csv(final_path)\nif len(saved_final) != len(sample):\n    raise ValueError(\"Saved submission row count mismatch\")\nif saved_final.columns.tolist() != sample.columns.tolist():\n    raise ValueError(\"Saved submission columns mismatch\")\n\nmanifest[\"completed_panels\"] = PANELS\nmanifest[\"status\"] = \"ALL_PANELS_VERIFIED\"\nmanifest[\"final_submission_created\"] = True\nmanifest[\"submission_path\"] = str(final_path)\nmanifest[\"submission_rows\"] = int(len(final))\nmanifest[\"state_rows\"] = int(state_mask.sum())\n\nwith open(MANIFEST_PATH, \"w\") as f:\n    json.dump(manifest, f, indent=2)\n\nrefresh_zip()\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"PIPELINE COMPLETE\")\nprint(\"Panels:\", len(PANELS))\nprint(\"Submission:\", final_path)\nprint(\"Rows:\", f\"{len(final):,}\")\nprint(\"State rows:\", f\"{state_mask.sum():,}\")\nprint(\"Columns:\", final.columns.tolist())\nprint(\"Resume ZIP:\", ZIP_PATH)\nprint(\"=\" * 65)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T17:41:31.842166Z","iopub.execute_input":"2026-10-21T17:41:31.84462Z","iopub.status.idle":"2026-10-21T17:58:07.122297Z","shell.execute_reply.started":"2026-10-21T17:41:31.844566Z","shell.execute_reply":"2026-10-21T17:58:07.120677Z"}},"outputs":[{"name":"stdout","text":"Existing checkpointed panels: ['D12_I405_N', 'D12_I405_S', 'D12_I5_N', 'D12_I5_S', 'D7_I405_S']\nPanels to process: ['D7_I10_E', 'D7_I10_W', 'D7_I210_E', 'D7_I210_W', 'D7_I