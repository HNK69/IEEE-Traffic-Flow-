execute_reply":"2026-10-19T15:52:20.602051Z"}},"outputs":[{"name":"stdout","text":"5-minute lag matches: 10 / 10\n15-minute lag matches: 10 / 10\n60-minute lag matches: 10 / 10\n1440-minute lag matches: 10 / 10\n","output_type":"stream"}],"execution_count":82},{"cell_type":"code","source":"# Check how much the model changes the baseline for low-speed predictions\ndiagnostic = extreme.copy()\n\ndiagnostic[\"speed_correction\"] = (\n    diagnostic[\"speed_kmh\"] - diagnostic[\"base_speed\"]\n)\n\nprint(\"Speed correction statistics:\")\ndisplay(diagnostic[\"speed_correction\"].describe())\n\nprint(\"Large downward corrections (< -30 km/h):\",\n      (diagnostic[\"speed_correction\"] < -30).sum())\n\ndisplay(\n    diagnostic.nsmallest(10, \"speed_correction\")[\n        [\"timestamp\", \"station_id\", \"link_id\", \"mask_regime\",\n         \"base_speed\", \"speed_kmh\", \"speed_correction\", \"flow_vph\"]\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T15:52:54.423417Z","iopub.execute_input":"2026-10-19T15:52:54.423842Z","iopub.status.idle":"2026-10-19T15:52:54.458143Z","shell.execute_reply.started":"2026-10-19T15:52:54.423812Z","shell.execute_reply":"2026-10-19T15:52:54.457123Z"}},"outputs":[{"name":"stdout","text":"Speed correction statistics:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"count    6376.000000\nmean      -37.286409\nstd        22.589592\nmin       -95.669003\n25%       -56.589785\n50%       -32.750004\n75%       -19.326548\nmax        12.912099\nName: speed_correction, dtype: float64"},"metadata":{}},{"name":"stdout","text":"Large downward corrections (< -30 km/h): 3473\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                     timestamp          station_id    link_id mask_regime  \\\n218  2031-04-05 16:05:00+00:00  SYN_D7_I405_S_0018  L405S-040          R1   \n5405 2031-04-28 16:10:00+00:00  SYN_D7_I405_S_0072  L405S-119          R3   \n37   