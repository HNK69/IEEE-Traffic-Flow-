\"))\n    ]\n\n    if not x.empty:\n        jan_parts_i5s.append(\n            x[[\"timestamp\", \"link_id\", \"speed_kmh\", \"flow_vph\"]].copy()\n        )\n\n    del x\n    gc.collect()\n\nif not jan_parts_i5s:\n    raise ValueError(\"No January 2031 truth files found for D12_I5_S.\")\n\njan_truth_i5s = pd.concat(jan_parts_i5s, ignore_index=True)\ndel jan_parts_i5s\ngc.collect()\n\njan_truth_i5s[\"weekday\"] = jan_truth_i5s[\"timestamp\"].dt.weekday\njan_truth_i5s[\"minute_of_day\"] = (\n    jan_truth_i5s[\"timestamp\"].dt.hour * 60\n    + jan_truth_i5s[\"timestamp\"].dt.minute\n)\n\nprofile_i5s = jan_truth_i5s.groupby(\n    [\"link_id\", \"weekday\", \"minute_of_day\"], as_index=False\n).agg(\n    base_speed=(\"speed_kmh\", \"median\"),\n    base_flow=(\"flow_vph\", \"median\"),\n)\n\nlink_profile_i5s = jan_truth_i5s.groupby(\n    \"link_id\", as_index=False\n).agg(\n    link_base_speed=(\"speed_kmh\", \"median\"),\n    link_base_flow=(\"flow_vph\", \"median\"),\n)\n\nfeb_features_i5s[\"timestamp\"] = pd.to_datetime(\n    feb_features_i5s[\"timestamp\"], utc=True\n)\nfeb_features_i5s[\"weekday\"] = feb_features_i5s[\"timestamp\"].dt.weekday\nfeb_features_i5s[\"minute_of_day\"] = (\n    feb_features_i5s[\"timestamp\"].dt.hour * 60\n    + feb_features_i5s[\"timestamp\"].dt.minute\n)\n\nfeb_features_i5s = feb_features_i5s.merge(\n    profile_i5s,\n    on=[\"link_id\", \"weekday\", \"minute_of_day\"],\n    how=\"left\",\n    validate=\"many_to_one\",\n)\nfeb_features_i5s = feb_features_i5s.merge(\n    link_profile_i5s,\n    on=\"link_id\",\n    how=\"left\",\n    validate=\"many_to_one\",\n)\n\nfeb_features_i5s[\"base_speed\"] = feb_features_i5s[\"base_speed\"].fillna(\n    feb_features_i5s[\"link_base_speed\"]\n)\nfeb_features_i5s[\"base_flow\"] = feb_features_i5s[\"base_flow\"].fillna(\n    feb_features_i5s[\"link_base_flow\"]\n)\n\nassert len(feb_features_i5s) == 616_266\nassert feb_features_i5s[\"base_speed\"].notna().all()\nassert feb_features_i5s[\"base_flow\"].notna().all()\n\nprint(\"Panel:\", PANEL_I5S)\nprint(\"Rows:\", f\"{len(feb_features_i5s):,}\")\nprint(\"Baseline profile rows:\", f\"{len(profile_i5s):,}\")\nprint(\"Missing base_speed:\", feb_features_i5s[\"base_speed\"].isna().sum())\nprint(\"Missing base_flow:\", feb_features_i5s[\"base_flow\"].isna().sum())\nprint(\"Baseline checks passed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:46:36.325854Z","iopub.execute_input":"2026-10-19T20:46:36.326337Z","iopub.status.idle":"2026-10-19T20:46:54.648086Z","shell.execute_reply.started":"2026-10-19T20:46:36.326307Z","shell.execute_reply":"2026-10-19T20:46:54.646627Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I5_S\nRows: 616,266\nBaseline profile rows: 201,600\nMissing base_speed: 0\nMissing base_flow: 0\nBaseline checks passed.\n","output_type":"stream"}],"execution_count":229},{"cell_type":"code","source":"import gc\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\nPANEL_I5S = \"D12_I5_S\"\ndf_i5s = feb_features_i5s.copy()\ndf_i5s[\"timestamp\"] = pd.to_datetime(df_i5s[\"timestamp\"], utc=True)\n\n# Calendar features\ndf_i5s[\"weekday\"] = df_i5s[\"timestamp\"].dt.weekday\ndf_i5s[\"minute_of_day\"] = (\n    df_i5s[\"timestamp\"].dt.hour * 60 + df_i5s[\"timestamp\"].dt.minute\n)\ndf_i5s[\"tod_sin\"] = np.sin(2 * np.pi * df_i5s[\"minute_of_day\"] / 1440)\ndf_i5s[\"tod_cos\"] = np.cos(2 * np.pi * df_i5s[\"minute_of_day\"] / 1440)\ndf_i5s[\"weekday_sin\"] = np.sin(2 * np.pi * df_i5s[\"weekday\"] / 7)\ndf_i5s[\"weekday_cos\"] = np.cos(2 * np.pi * df_i5s[\"weekday\"] / 7)\n\n# Store mappings for consistent inference encodings.\ncategory_maps_i5s = {}\nfor col in [\"station_id\", \"link_id\", \"mask_regime\"]:\n    categories = pd.Categorical(df_i5s[col]).categories\n    category_maps_i5s[col] = {\n        value: code for code, value in enumerate(categories)\n    }\n    df_i5s[col + \"_code\"] = pd.Categorical(\n        df_i5s[col], categories=categories\n    ).codes\n\nFEATURES_I5S = [\n    \"base_speed\", \"base_flow\",\n    \"lag_speed_5\", \"lag_flow_5\",\n    \"lag_speed_15\", \"lag_flow_15\",\n    \"lag_speed_60\", \"lag_flow_60\",\n    \"lag_speed_1440\", \"lag_flow_1440\",\n    \"weekday\", \"minute_of_day\",\n    \"tod_sin\", \"tod_cos\", \"weekday_sin\", \"weekday_cos\",\n    \"station_id_code\", \"link_id_code\", \"mask_regime_code\",\n]\n\n# Chronological holdout: final 20% of unique timestamps.\nunique_times_i5s = np.sort(df_i5s[\"timestamp\"].unique())\nval_start_i5s = unique_times_i5s[int(len(unique_times_i5s) * 0.8)]\ntrain_mask_i5s = df_i5s[\"timestamp\"] < val_start_i5s\nvalid_mask_i5s = ~train_mask_i5s\n\nX_i5s = df_i5s[FEATURES_I5S].replace([np.inf, -np.inf], np.nan)\ny_speed_i5s = df_i5s[\"target_speed\"].to_numpy(dtype=float)\ny_flow_i5s = df_i5s[\"target_flow\"].to_numpy(dtype=float)\nbase_speed_i5s = df_i5s[\"base_speed\"].to_numpy(dtype=float)\nbase_flow_i5s = df_i5s[\"base_flow\"].to_numpy(dtype=float)\n\nvalid_labels_i5s = (\n    np.isfinite(y_speed_i5s) & np.isfinite(y_flow_i5s)\n    & np.isfinite(base_speed_i5s) & np.isfinite(base_flow_i5s)\n)\ntrain_idx_i5s = np.flatnonzero(train_mask_i5s.to_numpy() & valid_labels_i5s)\nvalid_idx_i5s = np.flatnonzero(valid_mask_i5s.to_numpy() & valid_labels_i5s)\n\ndef make_model_i5s():\n    return HistGradientBoostingRegressor(\n        learning_rate=0.06,\n        max_iter=150,\n        max_leaf_nodes=31,\n        l2_regularization=5.0,\n        early_stopping=True,\n        validation_fraction=0.1,\n        n_iter_no_change=15,\n        random_state=42,\n    )\n\nspeed_model_i5s = make_model_i5s()\nflow_model_i5s = make_model_i5s()\n\nspeed_model_i5s.fit(\n    X_i5s.iloc[train_idx_i5s],\n    y_speed_i5s[train_idx_i5s] - base_speed_i5s[train_idx_i5s],\n)\nflow_model_i5s.fit(\n    X_i5s.iloc[train_idx_i5s],\n    y_flow_i5s[train_idx_i5s] - base_flow_i5s[train_idx_i5s],\n)\n\npred_speed_i5s = np.clip(\n    base_speed_i5s[valid_idx_i5s]\n    + speed_model_i5s.predict(X_i5s.iloc[valid_idx_i5s]),\n    0, 160,\n)\npred_flow_i5s = np.clip(\n    base_flow_i5s[valid_idx_i5s]\n    + flow_model_i5s.predict(X_i5s.iloc[valid_idx_i5s]),\n    0, None,\n)\n\nlinks_i5s = pd.read_csv(\n    ROOT / \"corridors\" / PANEL_I5S / \"network\" / \"links.csv\"\n)\nlane_map_i5s = links_i5s[[\"link_id\", \"lanes\"]].drop_duplicates(\"link_id\")\n\nev_i5s = df_i5s.iloc[valid_idx_i5s][\n    [\"link_id\", \"target_speed\", \"target_flow\"]\n].copy()\nev_i5s[\"pred_speed\"] = pred_speed_i5s\nev_i5s[\"pred_flow\"] = pred_flow_i5s\nev_i5s = ev_i5s.merge(\n    lane_map_i5s, on=\"link_id\", how=\"left\", validate=\"many_to_one\"\n)\nassert ev_i5s[\"lanes\"].notna().all() and (ev_i5s[\"lanes\"] > 0).all()\n\nspeed_rmse_i5s = np.sqrt(np.mean(\n    (ev_i5s[\"target_speed\"] - ev_i5s[\"pred_speed\"]) ** 2\n))\nflow_lane_rmse_i5s = np.sqrt(np.mean(\n    ((ev_i5s[\"target_flow\"] - ev_i5s[\"pred_flow\"]) / ev_i5s[\"lanes\"]) ** 2\n))\n\nS_speed_i5s = max(0, 1 - speed_rmse_i5s / 25)\nS_flow_i5s = max(0, 1 - flow_lane_rmse_i5s / 600)\nS_state_i5s = 0.54 * S_speed_i5s + 0.46 * S_flow_i5s\n\nprint(\"Panel:\", PANEL_I5S)\nprint(\"Training rows:\", f\"{len(train_idx_i5s):,}\")\nprint(\"Holdout rows:\", f\"{len(valid_idx_i5s):,}\")\nprint(f\"Speed RMSE: {speed_rmse_i5s:.4f} km/h\")\nprint(f\"Flow RMSE per lane: {flow_lane_rmse_i5s:.4f}\")\nprint(f\"S_speed: {S_speed_i5s:.6f}\")\nprint(f\"S_flow: {S_flow_i5s:.6f}\")\nprint(f\"Estimated state score: {S_state_i5s:.6f}\")\n\ndel X_i5s, links_i5s, lane_map_i5s, ev_i5s\ngc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:47:31.475208Z","iopub.execute_input":"2026-10-19T20:47:31.475647Z","iopub.status.idle":"2026-10-19T20:47:48.845469Z","shell.execute_reply.started":"2026-10-19T20:47:31.475617Z","shell.execute_reply":"2026-10-19T20:47:48.844495Z"}},"outputs":[{"name":"stdout","text":"Panel: D12_I5_S\nTraining rows: 493,380\nHoldout rows: 122,886\nSpeed RMSE: 5.8641 km/h\nFlow RMSE per lane: 80.5069\nS_speed: 0.765437\nS_flow: 0.865822\nEstimated state score: 0.811614\n","output_type":"stream"},{"execution_count":230,"output_type":"execute_result","data":{"text/plain":"48"},"metadata":{}}],"execution_count":230},{"cell_type":"code","source":"import os\nimport json\nimport gc\nimport shutil\nimport zipfile\nfrom pathlib import Path\nfrom datetime import datetime, timezone\n\nimport joblib\n\nRESUME_DIR = WORK / \"trafficflow_resume\"\nARTIFACT_DIR = RESUME_DIR / \"artifacts\"\nPRED_DIR = RESUME_DIR / \"predictions\"\n\nARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\nPRED_DIR.mkdir(parents=True, exist_ok=True)\n\n# 1. Save model artifacts and feature/category mappings.\nartifacts = {\n    \"D12_I405_S\": {\n        \"speed_model\": speed_model_d12s_final,\n        \"flow_model\": flow_model_d12s_final,\n        \"features\": FEATURES_D12S,\n        \"category_maps\": category_maps_d12s,\n    },\n    \"D12_I5_N\": {\n        \"speed_model\": speed_model_i5n_final,\n        \"flow_model\": flow_model_i5n_final,\n        \"features\": FEATURES_I5N,\n        \"category_maps\": category_maps_i5n,\n    },\n    \"D12_I5_S_holdout\": {\n        \"speed_model\": speed_model_i5s,\n        \"flow_model\": flow_model_i5s,\n        \"features\": FEATURES_I5S,\n        \"category_maps\": category_maps_i5s,\n    },\n}\n\njoblib.dump(artifacts, ARTIFACT_DIR / \"models_and_features.joblib\", compress=3)\n\n# 2. Save verified completed-panel checkpoints.\nprediction_files = [\n    WORK / \"D12_I405_S_predictions_checkpoint.csv\",\n    WORK / \"D12_I5_N_predictions_checkpoint.csv\",\n    WORK / \"task1_predictions_checkpoint.csv\",\n]\n\nsaved_predictions = []\nfor src in prediction_files:\n    if src.exists():\n        dst = PRED_DIR / src.name\n        shutil.copy2(src, dst)\n        saved_predictions.append({\n            \"filename\": src.name,\n            \"bytes\": dst.stat().st_size,\n        })\n\n# 3. Save current evaluation metrics and exact resume position.\nmanifest = {\n    \"saved_at_utc\": datetime.now(timezone.utc).isoformat(),\n    \"project\": \"IEEE Traffic Flow Bench - Task 1 State Reconstruction\",\n    \"status\": \"IN_PROGRESS\",\n    \"completed_panels\": [\"D12_I405_S\", \"D12_I5_N\"],\n    \"current_panel\": \"D12_I5_S\",\n    \"current_panel_status\": \"HOLDOUT_EVALUATED\",\n    \"next_action\": (\n        \"Rebuild D12_I5_S features if the kernel was reset; \"\n        \"fit final models on all 616266 eligible February rows; \"\n        \"generate and verify March and April predictions; \"\n        \"checkpoint the panel.\"\n    ),\n    \"metrics\": {\n        \"D12_I405_S\": {\n            \"holdout_score\": 0.849279,\n            \"speed_rmse\": 3.7532,\n            \"flow_rmse_per_lane\": 90.8497,\n        },\n        \"D12_I5_N\": {\n            \"holdout_score\": 0.811974,\n            \"speed_rmse\": 5.4136,\n            \"flow_rmse_per_lane\": 92.7291,\n        },\n        \"D12_I5_S\": {\n            \"holdout_score\": 0.811614,\n            \"speed_rmse\": 5.8641,\n            \"flow_rmse_per_lane\": 80.5069,\n            \"training_rows\": 493380,\n            \"holdout_rows\": 122886,\n            \"eligible_labels\": 616266,\n        },\n    },\n    \"saved_prediction_checkpoints\": saved_predictions,\n    \"completed_panels_count\": 2,\n    \"total_panels\": 10,\n    \"final_submission_created\": False,\n}\n\nwith open(RESUME_DIR / \"manifest.json\", \"w\") as f:\n    json.dump(manifest, f, indent=2)\n\n# 4. Include a human-readable resume note.\nresume_note = \"\"\"IEEE Traffic Flow Bench — Resume Notes\n\nCurrent state:\n- D12_I405_S: validation/private predictions checkpointed.\n- D12_I5_N: validation/private predictions checkpointed.\n- D12_I5_S: February training and chronological holdout evaluation complete.\n- Next: fit D12_I5_S final models on all eligible February rows, then generate\n  March validation and April private predictions.\n- 10 panels total; do not create the final submission until all panels are verified.\n\nOn resume:\n1. Restore this package and the original Kaggle competition input.\n2. Read manifest.json.\n3. Load artifacts/models_and_features.joblib if reusing saved models.\n4. Verify checkpoint CSVs before processing the next panel.\n5. Rebuild dataframes and observed lag history from source parquet files if needed.\n6. Preserve official template order and untouched non-state task rows.\n7. Build the unified submission only after all required predictions are covered.\n\nImportant:\nSaving to /kaggle/working alone is not a guarantee against session loss.\nDownload the ZIP or save a Kaggle notebook version/output before closing.\n\"\"\"\n(RESUME_DIR / \"RESUME.txt\").write_text(resume_note)\n\n# 5. Build a portable ZIP package.\nzip_path = WORK / \"trafficflow_resume_package.zip\"\nwith zipfile.ZipFile(zip_path, \"w\", compression=zipfile.ZIP_DEFLATED) as zf:\n    for path in RESUME_DIR.rglob(\"*\"):\n        if path.is_file():\n            zf.write(path, path.relative_to(WORK))\n\n# 6. Verify package and required files.\nassert (RESUME_DIR / \"manifest.json\").exists()\nassert (ARTIFACT_DIR / \"models_and_features.joblib\").exists()\nassert (RESUME_DIR / \"RESUME.txt\").exists()\nassert zipfile.is_zipfile(zip_path)\n\nwith zipfile.ZipFile(zip_path, \"r\") as zf:\n    bad_member = zf.testzip()\n    assert bad_member is None, f\"ZIP verification failed: {bad_member}\"\n\nprint(\"CHECKPOINT PACKAGE CREATED AND VERIFIED\")\nprint(\"Resume folder:\", RESUME_DIR)\nprint(\"ZIP package:\", zip_path)\nprint(\"ZIP size (MiB):\", round(zip_path.stat().st_size / (1024**2), 2))\nprint(\"Saved prediction checkpoints:\", len(saved_predictions))\nprint(\"Completed panels: 2 / 10\")\nprint(\"Next panel: D12_I5_S — final training and predictions\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-19T20:50:39.067274Z","iopub.execute_input":"2026-10-19T20:50:39.067816Z","iopub.status.idle":"2026-10-19T20:50:50.049472Z","shell.execute_reply.started":"2026-10-19T20:50:39.067782Z","shell.execute_reply":"2026-10-19T20:50:50.048177Z"}},"outputs":[{"name":"stdout","text":"CHECKPOINT PACKAGE CREATED AND VERIFIED\nResume folder: /kaggle/working/trafficflow_resume\nZIP package: /kaggle/working/trafficflow_resume_package.zip\nZIP size (MiB): 44.7\nSaved prediction checkpoints: 3\nCompleted panels: 2 / 10\nNext panel: D12_I5_S — final training and predictions\n","output_type":"stream"}],"execution_count":231},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}